i_file_ready_fallback:"Tiedosto on valmis",com_ui_file_processing_failed:"{0} käsittely epäonnistui",com_ui_file_processing_failed_fallback:"Tiedoston käsittely epäonnistui",com_ui_file_processing_failed_reupload:"{0} käsittely epäonnistui. Lataa tiedosto uudelleen.",com_ui_file_processing_failed_reupload_fallback:"Tiedoston käsittely epäonnistui. Lataa tiedosto uudelleen.",com_ui_file_processing:"Käsitellään...",com_ui_file_processing_failed_status:"Käsittely epäonnistui",com_ui_file_processing_failed_reupload_required:"Epäonnistui – lataa uudelleen",com_ui_file_retry:"Yritä uudelleen",com_ui_file_retry_in:"Yritä uudelleen {0}s kuluttua",com_ui_file_indexing_retrying:"Yritetään tiedoston indeksointia uudelleen...",com_ui_file_retry_wait:"Odota {0}s ennen uutta yritystä",com_ui_file_retries_exhausted_reupload:"Enimmäismäärä yrityksiä saavutettu. Lataa tiedosto uudelleen.",com_ui_assistant_file_upload_invalid_json:"Virheellinen JSON-tiedosto. Tiedoston sisältö ei vastaa odotettua muotoa."},Vv={com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Näyttää siltä, että lähetetty sisältö on merkitty moderointijärjestelmämme toimesta, koska se ei noudata yhteisön sääntöjä. Emme voi jatkaa tämän aiheen käsittelyä. Jos sinulla on muita kysymyksiä tai aiheita, joita haluat tutkia, muokkaa viestiäsi tai aloita uusi keskustelu."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Avain puuttuu. Anna avain ja yritä uudelleen."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Perus-URL puuttuu. Anna URL ja yritä uudelleen."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Virheellinen avain annettu. Anna avain ja yritä uudelleen."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Annettu avain {0} vanhentui {1}. Anna avain ja yritä uudelleen."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Olet saavuttanut kuukausittaisen käyttörajasi. Ota yhteyttä tiimin ylläpitäjään saadaksesi apua."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Olet saavuttanut lisenssisi maksimimäärän. Ota yhteyttä myyntiin osoitteessa {0} saadaksesi lisäapua."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Olet käyttänyt {0}% varatuista tokeneistasi. Ota yhteyttä {1} saadaksesi lisäapua."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Lisenssisi ei ole saatavilla. Ota yhteyttä tukeen saadaksesi lisäapua."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"IPv6-osoitteita ei tueta. Käytä IPv4-yhteyttä tai ota yhteyttä tukeen saadaksesi lisäapua."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Pyyntöäsi käsitellessä tapahtui virhe. Yritä uudelleen."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Tiedosto {0} on jo ladattu onnistuneesti"},com_files_no_results:{english:"No results.",translated:"Ei tuloksia."},com_files_filter:{english:"Search files by name",translated:"Etsi tiedostoja nimellä"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} / {1} tiedosto(a) valittu"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Valitse Assistentti"},com_sidepanel_parameters:{english:"Parameters",translated:"Parametrit"},com_ui_create_assistant:{english:"Create Assistant",translated:"Luo Assistentti"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Käyttäjällä tulee olla luontioikeudet luodakseen Assistentin"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Assistentit"},com_sidepanel_attach_files:{english:"File Manager",translated:"Tiedostojen Hallinta"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Hallitse Tiedostoja"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Suostumus"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Olet jakamassa tätä assistenttia muiden tiimin jäsenten kanssa. Ennen jakamista, tarkista alla olevat keskeiset kohdat:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Jatkamalla vahvistat, että ymmärrät ja hyväksyt nämä ehdot."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Jaetussa avustajassa ei saa olla arkaluonteisia tai luottamuksellisia tietoja."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Jaetut avustajat eivät saa käsitellä arkaluonteisia tai luottamuksellisia tietoja."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Jakaminen tarkoittaa vastuuta sisällöstä ja pääsystä."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"On suositeltavaa jakaa tietylle tiimille tai suljetulle ryhmälle, ei kaikille."},com_button_accept:{english:"Accept",translated:"Hyväksy"},com_button_decline:{english:"Decline",translated:"Hylkää"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Tietopohja"},com_assistants_file_search:{english:"File Search",translated:"Tiedostohaku"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Lisää tähän tiedostot, joista avustajasi etsii vastauksia keskustelussa."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Tuetut:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Vinkki:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Pyydä avustajaasi käyttämään 'Tiedostohakutyökalua' aina vastatessaan käyttäjille."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Vektorikauppojen liittäminen tiedostohakuun ei ole vielä tuettu. Voit liittää ne Provider Playgroundista tai liittää tiedostoja viesteihin ketjukohtaisesti."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Jotain meni pieleen tiedostojen hakemisessa vektorikaupoista."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Tietopohja"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Lataa tiedostoja avustajallesi, jotta se voi käyttää niitä kysymyksiin vastaamiseen (esim. CXNGPT-käyttöopas)."},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Klikkaa Luo tallentaaksesi avustajasi, lataa sitten tiedostosi ja klikkaa Tallenna."},com_assistants_image_vision:{english:"Image Vision",translated:"Kuvantunnistus"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Koodin tulkki"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Lisää tähän tiedostot, joita avustajasi tarvitsee analysoidakseen tai muuntaakseen dataa jokaisessa keskustelussa."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Tuetut:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Vinkit:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Pyydä avustajaasi käyttämään 'Koodin tulkkityökalua' aina vastatessaan käyttäjille."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} / {1} tiedostoa ladattu"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Seuraavat tiedostot ovat saatavilla vain Koodin tulkille:"},com_assistants_retrieval:{english:"Retrieval",translated:"Haku"},com_assistants_search_name:{english:"Search assistants by name",translated:"Etsi assistentteja nimellä"},com_assistants_tools:{english:"Tools",translated:"Työkalut"},com_assistants_actions:{english:"Actions",translated:"Toiminnot"},com_assistants_add_tools:{english:"Add Tools",translated:"Lisää Työkaluja"},com_assistants_add_actions:{english:"Add Actions",translated:"Lisää Toimintoja"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Tiedostohaku ei ole käytössä tässä mallissa. Valitse toinen malli."},com_assistants_available_actions:{english:"Available Actions",translated:"Saatavilla olevat Toiminnot"},com_assistants_running_action:{english:"Running action",translated:"Suoritetaan toimintoa"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Keskusteltu {0} kanssa"},com_assistants_completed_function:{english:"Ran {0}",translated:"Suoritettu {0}"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Käytetty Tiedostohakua"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Assistentti käytti {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:"[virhe työkalun käsittelyssä] Annetun verkkosivun sisältöä ei voitu hakea. [100]"},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:"[virhe työkalun käsittelyssä] Annetun verkkosivun sisältöä ei voitu hakea. [101]"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Assistentti lähetti tämän tiedon {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Poistaminen sallittu vain yksityisille Assistentille"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Toiminto poistettu onnistuneesti Assistentista"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Toiminto luotu tai päivitetty onnistuneesti"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Virhe toiminnon luomisessa tai päivittämisessä."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Virhe toiminnon poistamisessa."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Anna Assistenttisi hakea tietoa tai suorittaa toimintoja API:en kautta"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Nimeä assistenttisi (esim. Sähköpostin Luoja)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Anna avustajallesi tarkat, yksityiskohtaiset ohjeet sen toiminnan ohjaamiseksi (esim. Tavoite, Rooli, Toiminnot, Kohdeyleisö, Tyyli, Säännöt, Tehtävä, Malli, Esimerkki)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Kuvaile lyhyesti, mitä avustajasi voi tehdä (esim. Luo sähköposteja mallista)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Sinun on luotava avustaja ennen toimien lisäämistä."},com_assistants_update_success:{english:"Successfully updated",translated:"Päivitetty onnistuneesti"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Virhe avustajan päivittämisessä."},com_assistants_create_success:{english:"Successfully created",translated:"Luotu onnistuneesti"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Virhe avustajan luomisessa."},com_assistants_loading:{english:"Loading assistants...",translated:"Ladataan avustajia..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Anna syy PII:n käyttöönotolle."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Asetukset ja yksityisyys"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"PII-sensurointi"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"PII-sensurointi on oletuksena käytössä tämän avustajan mallikutsuissa."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"PII:n salliminen poistaa sensuroinnin tämän avustajan mallikutsuista. Olet vastuussa organisaatiosi tietopolitiikan noudattamisesta. Toiminta kirjataan ja valvotaan täysin."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Selitä syy PII:n käyttöönotolle (pakollinen)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Vähimmäispituus on {0} merkkiä."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Enimmäispituus on {0} merkkiä."},com_ui_date_today:{english:"Today",translated:"Tänään"},com_ui_date_yesterday:{english:"Yesterday",translated:"Eilen"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Edelliset 7 päivää"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"Edelliset 30 päivää"},com_ui_date_january:{english:"January",translated:"Tammikuu"},com_ui_date_february:{english:"February",translated:"Helmikuu"},com_ui_date_march:{english:"March",translated:"Maaliskuu"},com_ui_date_april:{english:"April",translated:"Huhtikuu"},com_ui_date_may:{english:"May",translated:"Toukokuu"},com_ui_date_june:{english:"June",translated:"Kesäkuu"},com_ui_date_july:{english:"July",translated:"Heinäkuu"},com_ui_date_august:{english:"August",translated:"Elokuu"},com_ui_date_september:{english:"September",translated:"Syyskuu"},com_ui_date_october:{english:"October",translated:"Lokakuu"},com_ui_date_november:{english:"November",translated:"Marraskuu"},com_ui_date_december:{english:"December",translated:"Joulukuu"},com_ui_field_required:{english:"This field is required",translated:"Tämä kenttä on pakollinen"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Virhe tiedoston lataamisessa. Tiedosto on voitu poistaa."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Tiedostotyyppi ei ole tuettu päätepisteelle:"},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Avustajan tiedostoja ei voi liittää muihin päätepisteisiin"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Tiedostokoko ylittää päätepisteen rajan:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Tiedostoa ei voi liittää. Luo tai valitse keskustelu tai yritä päivittää sivu."},com_ui_examples:{english:"Examples",translated:"Esimerkit"},com_ui_new_chat:{english:"New chat",translated:"Uusi keskustelu"},com_ui_conversations:{english:"Chats",translated:"Keskustelut"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"Aloita keskustelu..."},com_ui_new_conversation:{english:"New Chat",translated:"Uusi keskustelu"},com_ui_assistant_library:{english:"Assistant Library",translated:"Avustajakirjasto"},com_ui_kbot_assistants:{english:"Knowledge",translated:"Tieto"},com_ui_assistant_search:{english:"Search for an assistant",translated:"Etsi avustajaa"},com_ui_assistant_default_category:{english:"General",translated:"Yleinen"},com_ui_assistant_featured:{english:"Featured",translated:"Esillä"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Hakuehdot eivät täsmää yhteenkään avustajaan."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Avustajia ei löytynyt."},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"Selitä kvanttilaskenta yksinkertaisesti"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"Onko luovia ideoita 10-vuotiaan syntymäpäiville?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"Miten teen HTTP-pyynnön JavaScriptissä?"},com_ui_category_placeholder:{english:"Search a category",translated:"Etsi kategoria"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Etsi työkalu"},com_ui_capabilities:{english:"Capabilities",translated:"Ominaisuudet"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"Muistaa, mitä käyttäjä sanoi aiemmin keskustelussa"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Mahdollistaa käyttäjän antaa korjauksia"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Koulutettu kieltäytymään sopimattomista pyynnöistä"},com_ui_limitations:{english:"Limitations",translated:"Rajoitukset"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Voi toisinaan tuottaa virheellistä tietoa"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Voi toisinaan tuottaa haitallisia tai puolueellisia sisältöjä"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Rajoitettu tieto maailmasta ja tapahtumista vuoden 2021 jälkeen"},com_ui_on:{english:"On",translated:"Päällä"},com_ui_off:{english:"Off",translated:"Pois"},com_ui_yes:{english:"Yes",translated:"Kyllä"},com_ui_no:{english:"No",translated:"Ei"},com_ui_ascending:{english:"Asc",translated:"Nouseva"},com_ui_descending:{english:"Desc",translated:"Laskeva"},com_ui_show_all:{english:"Show All",translated:"Näytä kaikki"},com_ui_name:{english:"Name",translated:"Nimi"},com_ui_date:{english:"Date",translated:"Päivämäärä"},com_ui_storage:{english:"Storage",translated:"Tallennus"},com_ui_context:{english:"Context",translated:"Konteksti"},com_ui_size:{english:"Size",translated:"Koko"},com_ui_host:{english:"Host",translated:"Isäntä"},com_ui_update:{english:"Update",translated:"Päivitä"},com_ui_authentication:{english:"Authentication",translated:"Todennus"},com_ui_instructions:{english:"Instructions",translated:"Ohjeet"},com_ui_description:{english:"Description",translated:"Kuvaus"},com_ui_category:{english:"Category",translated:"Kategoria"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Määritä liiketoimintakategoria auttaaksesi suodattamaan ja järjestämään avustajia toiminnon mukaan."},com_ui_error:{english:"Error",translated:"Virhe"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Virhe yhdistettäessä palvelimeen, yritä päivittää sivu."},com_ui_select:{english:"Select",translated:"Valitse"},com_ui_select_placeholder:{english:"Select options",translated:"Valitse vaihtoehdot"},com_ui_remove:{english:"Remove",translated:"Poista"},com_ui_input:{english:"Input",translated:"Syöte"},com_ui_close:{english:"Close",translated:"Sulje"},com_ui_model:{english:"Model",translated:"Malli"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Avustajan nimen kenttä ei voi olla tyhjä. Anna kelvollinen nimi."},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Älykäs etuliite käytettiin yleisille avustajille, käytä eri nimeä."},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Kuvauskenttä ei voi olla tyhjä. Anna kelvollinen kuvaus."},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Ohjekenttä ei voi olla tyhjä. Anna kelvolliset ohjeet."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Kategoria-kenttä ei voi olla tyhjä. Valitse kategoria."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Kaksoiskappale avustajan nimestä havaittu. Valitse ainutlaatuinen nimi."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Jaettu kenttä ei voi olla tyhjä. Valitse jaettu vaihtoehto."},com_ui_shared_with:{english:"Shared With",translated:"Jaettu"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Yksityinen – Vain sinä voit käyttää ja nähdä tämän avustajan."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Jaa vain tiimin kanssa – Tämä avustaja on näkyvissä ja käytettävissä tiimisi jäsenille."},com_ui_shared_with_team:{english:"Team",translated:"Tiimi"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Valitse tiimi, johon tämä avustaja kuuluu. Vain tiimit, joiden jäsen olet, näkyvät täällä."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Tiimikenttä ei voi olla tyhjä. Valitse tiimi."},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Tämä assistentti on lukittu muokkaukselta, koska se on jaettu tiimin kanssa."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Virhe ladattaessa jaettuja linkkejä."},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Avustajan nimi sisältää loukkaavia sanoja eikä sitä voitu lähettää. Päivitä avustajan nimi."},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Kuvaus sisältää loukkaavia sanoja eikä sitä voitu lähettää. Päivitä kuvaus."},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Ohjeet sisältävät loukkaavia sanoja eikä niitä voitu lähettää. Päivitä ohjeet."},com_ui_select_search_model:{english:"Search model by name",translated:"Etsi mallia nimellä"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Etsi liitännäistä nimellä"},com_ui_use_prompt:{english:"Use prompt",translated:"Käytä kehotetta"},com_ui_prev:{english:"Prev",translated:"Edellinen"},com_ui_next:{english:"Next",translated:"Seuraava"},com_ui_stop:{english:"Stop",translated:"Pysäytä"},com_ui_upload_files:{english:"Upload files",translated:"Lataa tiedostoja"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Kehotepohjat"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Piilota kehotepohjat"},com_ui_showing:{english:"Showing",translated:"Näytetään"},com_ui_of:{english:"of",translated:"kohteesta"},com_ui_entries:{english:"Entries",translated:"Merkinnät"}