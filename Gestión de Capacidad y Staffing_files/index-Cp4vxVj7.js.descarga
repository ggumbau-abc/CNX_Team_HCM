h:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"No se recibió respuesta. Intente enviar su mensaje nuevamente. Si el problema persiste después de recargar la página y volver a intentar, por favor contacte al soporte."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Volver al chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Moderación de Barandilla"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"La moderación de barandilla está habilitada para este asistente. El contenido se verificará según las políticas de moderación."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Deshabilitar la moderación de barandilla elimina las verificaciones de moderación de contenido para este asistente. Usted es responsable de cumplir con las políticas de contenido de su organización. La actividad se registra y monitorea completamente."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Por favor, explique su justificación comercial para deshabilitar la moderación de barandilla (requerido)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Por favor, proporcione una justificación para deshabilitar la moderació