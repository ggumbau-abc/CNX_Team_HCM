stants_code_interpreter_tips_label:{english:"Tips:",translated:"טיפים"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"השתמש במתורגמן קוד כדי לקבל הסברים על קוד תכנות ולבצע פעולות תכנות."},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"הקבצים הבאים זמינים רק עבור מתורגמן קוד:"},com_assistants_retrieval:{english:"Retrieval",translated:"אחזור"},com_assistants_add_tools:{english:"Add Tools",translated:"הוסף כלים"},com_assistants_add_actions:{english:"Add Actions",translated:"הוסף פעולות"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"אופציונלי: שם הסייען"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"הוראות המערכת שהסייען משתמש בהן"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"אופציונלי: תאר את ה-סייען שלך כאן"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"עליך ליצור סייען לפני הוספת פעולות."},com_assistants_update_success:{english:"Successfully updated",translated:"עודכן בהצלחה"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"אירעה שגיאה בעדכון הסייען שלך."},com_assistants_create_success:{english:"Successfully created",translated:"נוצר בהצלחה"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"אירעה שגיאה ביצירת הסייען שלך."},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"חיפוש קבצים בשימוש"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:""}},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:""}},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"סוג קובץ לא נתמך עבור נקודת קצה:"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"חרגת ממגבלת גודל הקובץ עבור נקודת הקצה:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"לא ניתן לצרף קובץ. צור או בחר שיחה, או נסה לרענן את הדף."},com_ui_examples:{english:"Examples",translated:"דוגמאות"},com_ui_new_chat:{english:"New chat",translated:"שיחה חדשה"},com_ui_conversations:{english:"Chats",translated:"שיחות"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"התחל שיחה..."},com_ui_new_conversation:{english:"New Chat",translated:"שיחה חדשה"},com_ui_assistant_library:{english:"Assistant Library",translated:"ספריית העוזרים"},com_ui_assistant_search:{english:"Search for an assistant",translated:"חפש עוזר"},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"הסבר מחשוב קוונטי במונחים פשוטים"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"יש לך רעיונות יצירתיים ליום הולדת של ילד בן 10?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"כיצד אוכל לבצע בקשת HTTP ב-Javascript?"},com_ui_capabilities:{english:"Capabilities",translated:"יכולות"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"זוכר את מה שהמשתמש אמר קודם בשיחה"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"מאפשר למשתמש לספק תיקוני המשך"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"אומן לדחות בקשות בלתי הולמות"},com_ui_limitations:{english:"Limitations",translated:"הגבלות"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"עשוי מדי פעם ליצור מידע שגוי"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"עלול לייצר מדי פעם הוראות מזיקות או תוכן מוטה"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"ידע מוגבל על העולם והאירועים אחרי 2021"},com_ui_name:{english:"Name",translated:"שם"},com_ui_instructions:{english:"Instructions",translated:"הוראות"},com_ui_description:{english:"Description",translated:"תיאור"},com_ui_category:{english:"Category",translated:"---"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Assign a business category to help filter and organize assistants by function."},com_ui_error:{english:"Error",translated:"שגיאה"},com_ui_select:{english:"Select",translated:"בחר"},com_ui_input:{english:"Input",translated:"קלט"},com_ui_close:{english:"Close",translated:"סגור"},com_ui_model:{english:"Model",translated:"דגם"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"שם חייב להיות מוגדר"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"הקלט חייב להיות קצר מ-100 תווים ולא יכיל תווים מיוחדים"},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"תיאור חייב להיות מוגדר"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"הוראות חייבות להיות מוגדרות"},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"שדה הקטגוריה לא יכול להיות ריק. אנא בחר קטגוריה"},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"סייען עם שם זה כבר קיים. אנא בחר שם אחר."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"שותף עם חייב להיות מוגדר"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"שם ה-Assistant שלך מכיל מילים פוגעניות ולא ניתן היה לשלוח אותו. עדכן את שם ה-Assistant שלך."},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"התיאור שלך מכיל מילים פוגעניות ולא ניתן היה לשלוח אותו. אנא עדכן את התיאור שלך."},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"ההוראות שלך מכילות מילים פוגעניות ולא ניתן היה לשלוח אותן. אנא עדכן את ההוראות שלך."},com_ui_shared_with:{english:"Shared With",translated:"שותף עם"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Private – Only you can access and view this assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Share only with Team – This assistant will be visible and accessible to your team members."},com_ui_shared_with_team:{english:"Team",translated:"צוות"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"שותף עם צוות חייב להיות מוגדר"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"עוזר זה נעול לעריכה מכיוון שהוא משותף עם הצוות."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"שגיאה בהטענת קישורים משותפים"},com_ui_use_prompt:{english:"Use prompt",translated:"השתמש בהודעת"},com_ui_prev:{english:"Prev",translated:"הקודם"},com_ui_next:{english:"Next",translated:"הבא"},com_ui_stop:{english:"Stop",translated:"עצור"},com_ui_upload_files:{english:"Upload files",translated:"העלה קבצים"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"תבניות בקשה"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"הסתר תבניות הנחיות"},com_ui_showing:{english:"Showing",translated:"מציג"},com_ui_of:{english:"of",translated:"של"},com_ui_entries:{english:"Entries",translated:"ערכים"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"קובץ שהועלה בהצלחה"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"אירעה שגיאה בהעלאת הקובץ שלך"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"קובץ לא חוקי להעלאה. חייבת להיות תמונה שגודלה לא עולה על 2 MB"},com_ui_cancel:{english:"Cancel",translated:"בטל"},com_ui_save:{english:"Save",translated:"שמור"},com_user_message:{english:"You",translated:"אתה"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"העתק ללוח"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"הועתק ללוח"},com_ui_regenerate:{english:"Regenerate",translated:"לחדש"},com_ui_edit:{english:"Edit",translated:"ערוך"},com_ui_all:{english:"all",translated:"הכל"},com_ui_clear:{english:"Clear",translated:"נקה"},com_ui_import_conversation:{english:"Import",translated:"יבוא"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"ייבא שיחות מקובץ JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"השיחות יובאו בהצלחה"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"אירעה שגיאה בעת ייבוא השיחות שלך"},com_ui_confirm_action:{english:"Confirm Action",translated:"אשר פעולה"},com_ui_assistant:{english:"Assistant",translated:"סייען"},com_ui_delete:{english:"Delete",translated:"מחק"},com_ui_create:{english:"Create",translated:"צור"},com_ui_share:{english:"Share",translated:"Share"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Share link to chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"There was an error sharing the chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Your name and any messages you add after sharing stay private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been created. Manage previously shared chats at any time via Settings."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Your name, custom instructions, and any messages you add after sharing stay private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Shared link not found"},com_ui_delete_conversation:{english:"Delete chat?",translated:"למחוק את השיחה (צאט)?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"זה ימחק"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"האם אתה בטוח שאתה רוצה למחוק את הסייען הזה? אי אפשר לבטל את זה."},com_ui_rename:{english:"Rename",translated:"שם מחדש"},com_ui_more_options:{english:"More",translated:"עוד"},com_ui_upload:{english:"Upload",translated:"העלה"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"לא ניתן להתחבר עם המידע שסופק. אנא בדוק את האישורים שלך ונסה שוב."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"יותר מדי ניסיונות כניסה בזמן קצר. בבקשה נסה שוב מאוחר יותר."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"החשבון שלך נחסם באופן זמני עקב הפרות של השירות שלנו."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"הייתה שגיאת שרת פנימית. אנא המתן מספר רגעים ונסה שוב."},com_auth_sign_in:{english:"Login",translated:"כניסה"},com_endpoint_system_message:{english:"System Message",translated:"הודעת מערכת"},com_endpoint_message:{english:"Message",translated:"הודעה"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"ערוך את ההודעה שלך או צור מחדש."},com_endpoint_default_blank:{english:"default: blank",translated:"ברירת מחדל: ריק"},com_endpoint_default_false:{english:"default: false",translated:"ברירת מחדל: false"},com_endpoint_default_creative:{english:"default: creative",translated:"ברירת מחדל: יצירתי"},com_endpoint_default_empty:{english:"default: empty",translated:"ברירת מחדל: ריקה"},com_endpoint_default_with_num:{english:"default: {0}",translated:"ברירת מחדל: {0}"},com_endpoint_context:{english:"Context",translated:"הקשר"},com_endpoint_tone_style:{english:"Tone Style",translated:"סגנון טון"},com_endpoint_token_count:{english:"Token count",translated:"ספירת אסימונים"},com_endpoint_output:{english:"Output",translated:"פלט"},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"הגדר הוראות מותאמות אישית או הקשר. התעלמו אם ריק."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"עובר את הוראות הסייען. זה שימושי לשינוי ההתנהגות על בסיס ריצה."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"הגדר הוראות נוספות או הקשר על גבי ההנחיות הראשיות של ה-סייען. התעלמו אם ריק."},com_endpoint_custom_name:{english:"Custom Name",translated:"שם מותאם אישית"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"הוראות מותאמות אישית"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"הוראות נוספות"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"עקוף הוראות"},com_endpoint_temperature:{english:"Temperature",translated:"טמפרטורה"},com_endpoint_default:{english:"default",translated:"default"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"אסימוני פלט מרבי"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"ערכים גבוהים יותר = יותר אקראיים, בעוד שערכים נמוכים יותר = יותר ממוקד ודטרמיניסטי. אנו ממליצים לשנות את זה או את Top P אבל לא את שניהם."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"האסימונים המקסימליים להפיק. האורך הכולל של אסימוני קלט ואסימונים שנוצרו מוגבל על ידי אורך ההקשר של המודל."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"חלופה לדגימה עם טמפרטורה, הנקראת דגימת גרעין, שבה המודל מחשיב את תוצאות האסימונים עם מסת ההסתברות top_p. אז 0.1 אומר שרק האסימונים המהווים את מסת ההסתברות העליונה של 10% נחשבים. אנו ממליצים לשנות את זה או את הטמפרטורה אבל לא את שניהם."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"מספר בין -2.0 ל-2.0. ערכים חיוביים מענישים אסימונים חדשים בהתבסס על התדירות הקיימת שלהם בטקסט עד כה, ומקטינים את הסבירות של המודל לחזור על אותה שורה מילה במילה."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"מספר בין -2.0 ל-2.0. ערכים חיוביים מענישים אסימונים חדשים על סמך האם הם מופיעים בטקסט עד כה, ומגדילים את הסבירות של המודל לדבר על נושאים חדשים."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'ההחלטה לבקשות חזון. "נמוך" זול ומהיר יותר, "גבוה" מפורט ויקר יותר, ו"אוטומטי" יבחר אוטומטית בין השניים על סמך רזולוציית התמונה.'},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"הגדר שם מותאם אישית עבור ChatGPT"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"הגדר הוראות מותאמות אישית לכלול בהודעת המערכת. ברירת מחדל: אין"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"עונש תדירות"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"עונש נוכחות"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"השתמש בפונקציות"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"פרטי תמונה"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"השלמת דילוג"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"הגדר הוראות מותאמות אישית לכלול בהודעת המערכת. ברירת מחדל: אין"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"הגדר שם מותאם אישית, למקרה שתוכל למצוא את הקביעה המוגדרת מראש"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"האם אתה בטוח שברצונך למחוק את הקביעה המוגדרת מראש הזו?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"הגדרה מראש מיובאת!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"אירעה שגיאה בייבוא הקביעה המוגדרת מראש שלך. בבקשה נסה שוב."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"אירעה שגיאה בשמירת ההגדרה מראש שלך. בבקשה נסה שוב."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"אירעה שגיאה במחיקת הקביעה המוגדרת מראש שלך. בבקשה נסה שוב."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"איננו עוד ברירת המחדל המוגדרת מראש."},com_endpoint_preset_default_item:{english:"Default:",translated:"ברירת מחדל:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"אין ברירת מחדל פעילה."},com_endpoint_preset_title:{english:"Preset",translated:"הגדרה מראש"},com_endpoint_preset_saved:{english:"Saved!",translated:"שמור!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"הוא כעת ברירת המחדל המוגדרת מראש."},com_endpoint_preset:{english:"preset",translated:"preset"},com_endpoint_presets:{english:"presets",translated:"presets"},com_endpoint_preset_selected_title:{english:"Active!",translated:"פעיל!"},com_endpoint_preset_name:{english:"Preset Name",translated:"שם מוגדר מראש"},com_endpoint:{english:"Endpoint",translated:"נקודת קצה"},com_endpoint_examples:{english:" Presets",translated:"הגדרות קבועות מראש"},com_endpoint_export:{english:"Export",translated:"ייצוא"},com_endpoint_assistant:{english:"Assistant",translated:"סייען"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"השתמש ב-סייען פעיל"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"שמור כ-preset"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"האם אתה בטוח שאתה רוצה לנקות את כל הקביעות המוגדרות מראש? זה בלתי הפיך."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"אין עדיין הגדרות מוגדרות מראש, השתמש בלחצן ההגדרות כדי ליצור אחת"},com_endpoint_my_preset:{english:"My Preset",translated:"ההגדרה המוגדרת מראש שלי"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"מודל סוכן (מומלץ: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"מודל השלמה (מומלץ: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"אפשר שימוש בפלאגינים כפונקציות OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"אפשר דילוג על שלב ההשלמה, הסוקר את התשובה הסופית ואת השלבים שנוצרו"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"הגדר את המפתח שלך בתפריט הכותרת לצאט."},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"איך אני יכול לעזור לך היום?"},com_nav_profile_picture:{english:"Profile Picture",translated:"תמונת פרופיל"},com_nav_change_picture:{english:"Change picture",translated:"שנה תמונה"},com_show_agent_settings:{english:"Show Agent Settings",translated:"הצג הגדרות סוכן"},com_show_completion_settings:{english:"Show Completion Settings",translated:"הצג הגדרות השלמה"},com_hide_examples:{english:"Hide Examples",translated:"הסתר דוגמאות"},com_show_examples:{english:"Show Examples",translated:"הצג דוגמאות"},com_nav_export_filename:{english:"Filename",translated:"שם קובץ"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"הגדר את שם הקובץ"},com_nav_export_type:{english:"Type",translated:"סוג"},com_nav_export_conversation:{english:"Export conversation",translated:"ייצא שיחה"},com_nav_export:{english:"Export",translated:"ייצא"},com_nav_shared_links:{english:"Shared links",translated:"קישורים משותפים"},com_nav_shared_links_manage:{english:"Manage",translated:"ניהול"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"אין לך קישורים משותפים."},com_nav_shared_links_name:{english:"Name",translated:"שם"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"תאריך שיתוף"},com_nav_source_chat:{english:"View source chat",translated:"View source chat"},com_nav_my_files:{english:"File Manager",translated:"File Manager"},com_nav_admin_center:{english:"Admin Center",translated:"מרכז ניהול"},com_nav_theme:{english:"Theme",translated:"נושא"},com_nav_theme_system:{english:"System",translated:"מערכת"},com_nav_theme_dark:{english:"Dark",translated:"כהה"},com_nav_theme_light:{english:"Light",translated:"אור"},com_nav_user_name_display:{english:"Display username in messages",translated:"הצג שם משתמש בהודעות"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"נקה את כל השיחות"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"אשר נקה"},com_nav_close_sidebar:{english:"Close sidebar",translated:"סגור סרגל צד"},com_nav_open_sidebar:{english:"Open sidebar",translated:"פתח סרגל צד"},com_nav_send_message:{english:"Send message",translated:"שלח הודעה"},com_nav_log_out:{english:"Log out",translated:"צא"},com_nav_user:{english:"USER",translated:"USER"},com_nav_archived_chats:{english:"Archived chats",translated:"שיחות מארכיון"},com_nav_archived_chats_manage:{english:"Manage",translated:"ניהול"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"אין שיחות מארכיון."},com_nav_archive_name:{english:"Name",translated:"שם"},com_nav_archive_created_at:{english:"DateCreated",translated:"תאריך יצרן"},com_nav_clear_conversation:{english:"Clear conversations",translated:"נקה שיחות"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"אתה בטוח שאתה רוצה לנקות את כל השיחות? זה בלתי הפיך."},com_nav_help:{english:"Help",translated:"עזרה"},com_nav_settings:{english:"Settings",translated:"הגדרות"},com_nav_search_placeholder:{english:"Search messages",translated:"חפש הודעות"},com_nav_setting_general:{english:"General",translated:"כללי"},com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"נראה שהתוכן שנשלח סומן על ידי מערכת המודרציה שלנו כלא תואם להנחיות הקהילה שלנו. לא נוכל להמשיך בנושא זה. אם יש לך שאלות או נושאים אחרים שתרצה לחקור, ערוך את ההודעה שלך או צור שיחה חדשה."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"לא נמצא מפתח. אנא ספק מפתח ונסה שוב."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"לא נמצא כתובת בסיס. אנא ספק אחת ונסה שוב."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"מפתח לא חוקי סופק. אנא ספק מפתח ונסה שוב."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"המפתח שסופק עבור {0} פג תוקף ב-{1}. אנא ספק מפתח ונסה שוב."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"הגעת למקסימום האסימונים לרישיון שלך. אנא פנה למכירות ב-{0} לקבלת סיוע נוסף."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"השתמשת ב-{0}% מהאסימונים שהוקצו לך. אנא פנה ל-{1} לקבלת סיוע נוסף."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"הרישיון שלך אינו זמין. אנא פנה לתמיכה לקבלת סיוע נוסף."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"כתובות IPv6 אינן נתמכות. אנא השתמש בחיבור IPv4 או פנה לתמיכה לקבלת סיוע נוסף."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"אירעה שגיאה בעיבוד הבקשה שלך. אנא נסה שוב."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"הקובץ {0} כבר הועלה בהצלחה"},com_files_no_results:{english:"No results.",translated:"אין תוצאות."},com_files_filter:{english:"Search files by name",translated:"חפש קבצים לפי שם"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} מתוך {1} קובץ/ים נבחרו"},com_sidepanel_parameters:{english:"Parameters",translated:"פרמטרים"},com_ui_create_assistant:{english:"Create Assistant",translated:"צור סייען"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"המשתמש צריך הרשאות יצירה כדי ליצור סייען"},com_sidepanel_manage_files:{english:"Manage Files",translated:"נהל קבצים"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"הסכמה"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"אתה עומד לשתף את הסייען הזה עם חברי צוות אחרים. לפני שתשתף את הסייען הזה, אנא עיין בנקודות המפתח הבאות:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"בהמשך, אתה מאשר שאתה מבין ומקבל את התנאים הללו."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"הסייען המשותף לא צריך להכיל נתונים רגישים או סודיים."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"הסייענים המשותפים לא צריכים לעבד נתונים רגישים או סודיים."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"שיתוף מרמז על אחריות ואחריות על התוכן והגישה."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"מומלץ לשתף עם צוות מסוים או קבוצה סגורה במקום עם כולם."},com_button_accept:{english:"Accept",translated:"קבל"},com_button_decline:{english:"Decline",translated:"דחה"},com_assistants_capabilities:{english:"Knowledgebase",translated:"מאגר ידע"},com_assistants_file_search:{english:"File Search",translated:"חיפוש קבצים"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"הוסף כאן קבצים שהסייען שלך צריך לחפש מהם בעת מענה לשאלות בצ'אט."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"נתמך:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"טיפ:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"בקש מהסייען שלך להשתמש ב'כלי חיפוש קבצים' בכל פעם שהוא מגיב למשתמשים."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"חיבור חנויות וקטוריות לחיפוש קבצים אינו נתמך עדיין. ניתן לחבר אותם מ-Provider Playground או לצרף קבצים להודעות לחיפוש קבצים על בסיס שרשור."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"משהו השתבש בעת שליפת קבצים מהחנויות הוקטוריות."},com_assistants_image_vision:{english:"Image Vision",translated:"חזון תמונה"},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} מתוך {1} קבצים הועלו"},com_assistants_search_name:{english:"Search assistants by name",translated:"חפש סייענים לפי שם"},com_assistants_tools:{english:"Tools",translated:"כלים"},com_assistants_actions:{english:"Actions",translated:"פעולות"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"חיפוש קבצים אינו מופעל במודל זה. אנא בחר מודל אחר."},com_assistants_available_actions:{english:"Available Actions",translated:"פעולות זמינות"},com_assistants_running_action:{english:"Running action",translated:"מבצע פעולה"},com_assistants_completed_action:{english:"Talked to {0}",translated:"דיבר עם {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"הריץ {0}"},com_assistants_function_use:{english:"Assistant used {0}",translated:"הסייען השתמש ב-{0}"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"הסייען שלח מידע זה ל-{0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"מחיקה מותרת רק עם סייענים פרטיים"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"הפעולה נמחקה בהצלחה מהסייען"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"הפעולה נוצרה או עודכנה בהצלחה"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"אירעה שגיאה ביצירת או עדכון הפעולה."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"אירעה שגיאה במחיקת הפעולה."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"אפשר לסייען שלך לאחזר מידע או לבצע פעולות דרך API"},com_assistants_loading:{english:"Loading assistants...",translated:"טוען סייענים..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"אנא ספק סיבה להפעלת PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"הגדרות ופרטיות"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"הסתרת PII"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"הסתרת PII מופעלת כברירת מחדל לשיחות המודל של סייען זה."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"הפעלת PII מבטלת הסתרה לשיחות המודל של סייען זה. אתה אחראי לעמידה במדיניות הנתונים של הארגון שלך. הפעילות מתועדת ומנוטרת במלואה."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"אנא הסבר את סיבתך להפעלת PII (נדרש)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"האורך המינימלי הוא {0} תווים."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"האורך המקסימלי הוא {0} תווים."},com_ui_date_today:{english:"Today",translated:"היום"},com_ui_date_yesterday:{english:"Yesterday",translated:"אתמול"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"7 הימים הקודמים"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"30 הימים הקודמים"},com_ui_date_january:{english:"January",translated:"ינואר"},com_ui_date_february:{english:"February",translated:"פברואר"},com_ui_date_march:{english:"March",translated:"מרץ"},com_ui_date_april:{english:"April",translated:"אפריל"},com_ui_date_may:{english:"May",translated:"מאי"},com_ui_date_june:{english:"June",translated:"יוני"},com_ui_date_july:{english:"July",translated:"יולי"},com_ui_date_august:{english:"August",translated:"אוגוסט"},com_ui_date_september:{english:"September",translated:"ספטמבר"},com_ui_date_october:{english:"October",translated:"אוקטובר"},com_ui_date_november:{english:"November",translated:"נובמבר"},com_ui_date_december:{english:"December",translated:"דצמבר"},com_ui_field_required:{english:"This field is required",translated:"שדה זה נדרש"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"שגיאה בהורדת הקובץ. ייתכן שהקובץ נמחק."},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"לא ניתן לצרף קבצי סייען לנקודות קצה אחרות"},com_ui_kbot_assistants:{english:"Knowledge",translated:"ידע"},com_ui_assistant_default_category:{english:"General",translated:"כללי"},com_ui_assistant_featured:{english:"Featured",translated:"מוצג"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"אין סייענים התואמים את הקריטריונים לחיפוש."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"לא נמצאו סייענים."},com_ui_category_placeholder:{english:"Search a category",translated:"חפש קטגוריה"},com_ui_tool_placeholder:{english:"Search a tool",translated:"חפש כלי"},com_ui_on:{english:"On",translated:"פועל"},com_ui_off:{english:"Off",translated:"כבוי"},com_ui_yes:{english:"Yes",translated:"כן"},com_ui_no:{english:"No",translated:"לא"},com_ui_ascending:{english:"Asc",translated:"עולה"},com_ui_descending:{english:"Desc",translated:"יורד"},com_ui_show_all:{english:"Show All",translated:"הצג הכל"},com_ui_date:{english:"Date",translated:"תאריך"},com_ui_storage:{english:"Storage",translated:"אחסון"},com_ui_context:{english:"Context",translated:"הקשר"},com_ui_size:{english:"Size",translated:"גודל"},com_ui_host:{english:"Host",translated:"מארח"},com_ui_update:{english:"Update",translated:"עדכון"},com_ui_authentication:{english:"Authentication",translated:"אימות"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"שגיאה בחיבור לשרת, נסה לרענן את הדף."},com_ui_select_placeholder:{english:"Select options",translated:"בחר אפשרויות"},com_ui_remove:{english:"Remove",translated:"הסר"},com_ui_select_search_model:{english:"Search model by name",translated:"חפש מודל לפי שם"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"חפש תוסף לפי שם"},com_ui_none_selected:{english:"None selected",translated:"לא נבחר דבר"},com_ui_thinking:{english:"Thinking",translated:"חושב"},com_ui_analyzing_request:{english:"Understanding your question",translated:"מנתח את הבקשה שלך"},com_ui_processing:{english:"Putting it together",translated:"מעבד"},com_ui_working_on_it:{english:"Almost ready",translated:"עובד על זה"},com_ui_read_aloud:{english:"Read aloud",translated:"קריאה בקול"},com_ui_copied:{english:"Copied!",translated:"הועתק!"},com_ui_copy_code:{english:"Copy code",translated:"העתק קוד"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"ציין נקודת קצה, סייען או תבנית כדי לעבור אליהם במהירות"},com_ui_nothing_found:{english:"Nothing found",translated:"לא נמצא דבר"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"עבור לשיחה"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"סוג ייבוא לא נתמך"},com_ui_avatar:{english:"Avatar",translated:"אווטאר"},com_ui_unknown:{english:"Unknown",translated:"לא ידוע"},com_ui_result:{english:"Result",translated:"תוצאה"},com_ui_image_gen:{english:"Image Gen",translated:"יצירת תמונה"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"הסייען נמחק בהצלחה"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"אירעה שגיאה במחיקת הסייען"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"זוהה קובץ כפול."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"אירעה שגיאה בהעלאת הקובץ."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"אירעה שגיאה בהעלאת הקובץ: נקודת הקצה אינה מוגדרת"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"לא ניתן להעלות קבצים ריקים."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"ניתן להעלות עד {0} קבצים בכל פעם."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"ניתן להעלות עד {0} קבצים בחלק זה."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"הגעת למגבלת ההעלאה עבור {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"לא ניתן לקבוע את סוג הקובץ עבור: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"סוג הקובץ אינו נתמך. אנא העלה פורמט קובץ נתמך."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"טעינת התמונה נכשלה"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"כרגע נתמכים רק קבצי JPEG, JPG, PNG ו-WEBP."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"גודל הקובץ חורג מ-{0} מגה-בייט."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"הגודל הכולל של הקבצים לא יכול לחרוג מ-{0} מגה-בייט."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"אירעה שגיאה באימות הקובץ."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"אירעה שגיאה בעיבוד הקובץ."},com_ui_assistants:{english:"Assistants",translated:"סייענים"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"סיוע בסטודיו"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"ידע"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"ללא קטגוריה"},com_ui_attachment:{english:"Attachment",translated:"קובץ מצורף"},com_ui_assistants_output:{english:"Assistants Output",translated:"פלט הסייענים"},com_ui_copy_link:{english:"Copy link",translated:"העתק קישור"},com_ui_update_link:{english:"Update link",translated:"עדכן קישור"},com_ui_create_link:{english:"Create link",translated:"צור קישור"},com_ui_preview:{english:"Preview",translated:"תצוגה מקדימה"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'העלאת "{0}" לוקחת יותר זמן מהצפוי. אנא המתן בזמן שהקובץ מסיים אינדוקס לשחזור.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"מדיניות פרטיות"},com_ui_terms_of_service:{english:"Terms of service",translated:"תנאי שירות"},com_ui_use_micrphone:{english:"Use microphone",translated:"השתמש במיקרופון"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"לא ניתן להסיר יותר ערכים, נדרשים לפחות {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"המספר המקסימלי המותר הוא {0}, משתמש בערכים האחרונים."},com_endpoint_messages:{english:"Messages",translated:"הודעות"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"מקסימום אסימוני הקשר"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`מספר האסימונים המקסימלי שניתן להשתמש בו להקשר. השתמש בזה לשליטה בכמה אסימונים נשלחים לכל בקשה.
  אם לא צוין, ישתמש בברירות המחדל של המערכת על בסיס גודל ההקשר של המודלים הידועים. הגדרת ערכים גבוהים יותר עשויה לגרום לשגיאות ו/או לעלות אסימונים גבוהה יותר.`},com_endpoint_stop:{english:"Stop Sequences",translated:"רצפי עצירה"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"הפרד ערכים על ידי לחיצה על `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"שדה `max_tokens` אופציונלי, המייצג את המספר המקסימלי של אסימונים שניתן לייצר בהשלמת הצ'אט.\n    \n    האורך הכולל של אסימוני הקלט והאסימונים שנוצרו מוגבל על ידי אורך ההקשר של המודלים. ייתכן שתיתקל בשגיאות אם מספר זה יעלה על מקסימום אסימוני ההקשר."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"שלח מחדש את כל הקבצים המצורפים בעבר. הערה: זה יגדיל את עלות האסימונים וייתכן שתיתקל בשגיאות עם הרבה קבצים מצורפים."},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"עד 4 רצפים שבהם ה-API יפסיק לייצר אסימונים נוספים."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"שלח קבצים מחדש"},com_endpoint_import:{english:"Import",translated:"ייבוא"},com_endpoint_export_share:{english:"Export/Share",translated:"ייצוא/שיתוף"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"אנא בחר סייען והתחל שיחה חדשה"},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"אנא בחר סייען"},com_nav_text_to_speech:{english:"Text to Speech",translated:"טקסט לדיבור"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"הפעל אוטומטית הודעה אחרונה"},com_nav_speech_to_text:{english:"Speech to Text",translated:"דיבור לטקסט"},com_nav_user_guide:{english:"User Guide",translated:"מדריך למשתמש"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"שלח טקסט אוטומטית (לאחר 3 שניות)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"שגיאה בהפעלת שמע: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"שגיאה בעיבוד שמע: {0}"},com_nav_engine:{english:"Engine",translated:"מנוע"},com_nav_browser:{english:"Browser",translated:"דפדפן"},com_nav_external:{english:"External",translated:"חיצוני"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"מחק אחסון מטמון"},com_nav_voice_select:{english:"Voice",translated:"קול"},com_nav_setting_speech:{english:"Speech",translated:"דיבור"},com_nav_language:{english:"Language",translated:"שפה"},com_nav_lang_auto:{english:"Auto detect",translated:"זיהוי אוטומטי"},com_page_not_found:{english:"Page not found",translated:"הדף לא נמצא"},com_something_went_wrong_error:{english:"Something went wrong",translated:"משהו השתבש"},com_unauthorized_access:{english:"Unauthorized access",translated:"גישה לא מורשית"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"גישה לא מורשית. הגישה מוגבלת לדומיינים מסוימים."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"חשבונך נחסם זמנית עקב הפרות של השירות שלנו"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"הגישה לאפליקציה מחוץ לרשת מוגבלת!"},com_support_ticket_text:{english:"Support Ticket",translated:"כרטיס תמיכה"},com_help_dialog_Header:{english:"Need assistance?",translated:"זקוק לעזרה?"},com_help_dialog_text_1_1:{english:"Click",translated:"לחץ"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"להוראות מפורטות"},com_help_dialog_text_here:{english:"here",translated:"כאן"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"לבעיות, מלא"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"לבעיות, פנה ל"},com_help_dialog_text_ticket:{english:"ticket",translated:"כרטיס"},com_help_dialog_text_3:{english:"Find the steps",translated:"מצא את השלבים"},com_status_ind_none:{english:"Operational",translated:"פעיל"},com_status_ind_minor:{english:"Minor Issues",translated:"בעיות קלות"},com_status_ind_major:{english:"Major Issues",translated:"בעיות חמורות"},com_status_ind_critical:{english:"Critical",translated:"קריטי"},com_status_ind_error:{english:"Error Fetching",translated:"שגיאה באחזור"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"שים לב שכאשר אתה עוזב צ'אט או מתחיל צ'אט חדש, תאבד את היסטוריית השיחה שלך."},com_forbidden_access:{english:"Forbidden access",translated:"גישה אסורה"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"מדיניות שימוש מקובלת"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"מדיניות פרטיות"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"הסכם מנוי"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"לפני השימוש ב-iX Hello, ניתן לעיין ב-"},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:'על ידי הרשמה ו/או כניסה, אתה מסכים לתנאים הנ"ל.'},com_login_page_and:{english:"and ",translated:"ו"},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"אין סייענים מוצמדים"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"סייענים מוצמדים"},com_ui_loading:{english:"Loading...",translated:"טוען..."},com_ui_unpin:{english:"Unpin",translated:"בטל הצמדה"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"הסייען הוסר מההצמדה בהצלחה"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"שגיאה בהסרת הסייען מההצמדה"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"הסייען הוצמד בהצלחה"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"שגיאה בהצמדה/הסרת הצמדה של הסייען"},com_ui_pin:{english:"Pin",translated:"הצמד"},come_create_assistant:{english:"Create Assistant",translated:"צור סייען"},come_edit_assistant:{english:"Edit Assistant",translated:"ערוך סייען"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"האם אתה בטוח שברצונך להמשיך? פעולה זו תגרום לאובדן כל השינויים שנעשו בסייען שאתה עורך או יוצר כעת. פעולה זו אינה ניתנת לביטול."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"סייען עם מזהה {0} לא נמצא."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"הדפדפן אינו תומך בזיהוי דיבור"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"הרשאת מיקרופון לא ניתנה"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"שגיאה בהתחלת הקלטה: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder אינו מקליט"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder אינו נתמך בדפדפן זה"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"ההודעה שלך מכילה מידע אישי ולא נשלחה. נא להסיר כל מידע אישי."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"נכשל שינוי שם השיחה"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"נותרו לך {0} מהאסימונים שהוקצו."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello עלול לעשות טעויות. נא לבדוק את כל התוצרים לאיכות ודיוק. כל הקלטים נרשמים לצורך ציות."},com_ui_assistant_group_by:{english:"Group by",translated:"קבץ לפי"},com_ui_assistant_category:{english:"Category",translated:"קטגוריה"},com_ui_assistant_team:{english:"Team",translated:"צוות"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"הנדסה"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"מודיעין"},com_ui_assistant_marketing:{english:"Marketing",translated:"שיווק"},com_ui_assistant_operations:{english:"Operations",translated:"תפעול"},com_ui_assistant_sales:{english:"Sales",translated:"מכירות"},com_ui_assistant_strategy:{english:"Strategy",translated:"אסטרטגיה"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"סיוע סטודיו"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"העלה תמונת אווטאר (PNG או JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"חפש באינטרנט"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"גלוש באתר"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"צור תמונות"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"חשב מתמטיקה"},com_ui_assistant_tools_default:{english:"Running tool",translated:"כלי ברירת מחדל"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"העלאת הקובץ לוקחת יותר זמן מהצפוי. נסה שוב."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"שגיאה בנעיצת הסייען"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"אירעה שגיאה במחיקת הקישור המשותף"},com_ui_dan:{english:"DAN",translated:"דן"},com_ui_dan_template:{english:"DAN Template",translated:"תבנית דן"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"אין תבנית ברירת מחדל פעילה."},com_ui_drag_drop_title:{english:"Add anything",translated:"הוסף כל דבר"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"גרור כל קובץ לכאן כדי להוסיף לשיחה"},com_ui_analyzing:{english:"Analyzing",translated:"מנתח"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"סיים ניתוח"},com_ui_warning:{english:"Warning",translated:"אזהרה"},com_ui_proceed:{english:"Proceed",translated:"המשך"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"קבצים שהועלו לסייען משמשים למטרות שיחה בלבד. משתמשים יכולים לגשת לתוכן הקבצים על ידי שאלת שאלות רלוונטיות, אך הורדה ישירה של הקבצים אינה מותרת."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"הגדר שם מותאם אישית לתבנית זו"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"הגדר קלט לדוגמה. הדוגמה תתעלם אם ריקה."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"הגדר פלט לדוגמה. הדוגמה תתעלם אם ריקה."},com_nav_export_select_type:{english:"Select a file type",translated:"בחר סוג קובץ"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"צילום מסך (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"טקסט (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"לא התקבלה תגובה. אנא נסה לשלוח את ההודעה שוב. אם הבעיה נמשכת לאחר טעינת הדף מחדש וניסיון נוסף, אנא פנה לתמיכה."},com_ui_back_to_chat:{english:"Back to Chat",translated:"חזרה לצ'אט"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"מתינות Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"מתינות Guardrail מופעלת עבור סייען זה. התוכן ייבדק מול מדיניות המתינות."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"ביטול מתינות Guardrail מסיר בדיקות מתינות תוכן עבור סייען זה. אתה אחראי לעמידה במדיניות התוכן של הארגון שלך. הפעילות מתועדת ומנוטרת במלואה."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"נא להסביר את ההצדקה העסקית שלך לביטול מתינות Guardrail (נדרש)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"נא לספק הצדקה לביטול מתינות Guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"אפשר למשתמשים להחליף מודל בצ'אט"},com_ui_feedback_good:{english:"Good response",translated:"תגובה טובה"},com_ui_feedback_bad:{english:"Poor response",translated:"תגובה גרועה"},com_ui_feedback_comments:{english:"Comments",translated:"הערות"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"הערות (אופציונלי)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"ספר לנו עוד על החוויה שלך..."},com_ui_feedback_submit:{english:"Submit",translated:"שלח"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"לא הצלחנו לשלוח את המשוב שלך"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"לא נכון"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"לא רלוונטי"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"מיושן"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"אין מספיק פרטים"},com_ui_feedback_reason_other:{english:"Other",translated:"אחר"},com_ui_model_recommended:{english:"Recommended",translated:"מומלץ"},com_ui_model_legacy:{english:"Legacy — please update",translated:"ישן — נא לעדכן"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"מודל זה אינו נתמך יותר. אנא בחר מודל עדכני."},com_nav_setting_memory:{english:"Memory",translated:"זיכרון"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"נהל את העובדות האישיות שהעוזר זוכר בשיחות שלך."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"הוסף זיכרון חדש…"},com_nav_memory_add_button:{english:"Add memory",translated:"הוסף זיכרון"},com_nav_memory_category:{english:"Category",translated:"קטגוריה"},com_nav_memory_category_preference:{english:"Preference",translated:"העדפה"},com_nav_memory_category_identity:{english:"Identity",translated:"זהות"},com_nav_memory_category_context:{english:"Context",translated:"הקשר"},com_nav_memory_category_project:{english:"Project",translated:"פרויקט"},com_nav_memory_empty_title:{english:"No memories yet",translated:"אין זיכרונות עדיין"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"הזיכרונות שתשמור יופיעו כאן ויעזרו להתאים אישית שיחות עתידיות."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"לא ניתן לטעון זיכרונות. אנא נסה שוב."},com_nav_memory_retry:{english:"Retry",translated:"נסה שוב"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"לא ניתן להוסיף זיכרון. אנא נסה שוב."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"לא ניתן לעדכן זיכרון. אנא נסה שוב."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"לא ניתן למחוק זיכרון. אנא נסה שוב."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"למחוק את הזיכרון הזה?"},com_nav_memory_delete_button:{english:"Delete",translated:"מחק"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"ערוך זיכרון"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"מחק זיכרון"},com_nav_memory_save:{english:"Save",translated:"שמור"},com_nav_memory_cancel:{english:"Cancel",translated:"בטל"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"נשמר ב-{0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — מודל החשיבה העדכני ביותר של GPT-5 עם בינה מתקדמת."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — גרסה קומפקטית וחסכונית של GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — דגם הדור האחרון של GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus האחרון — אינטליגנציה מתקדמת לסוכני קוד ותהליכי עבודה ארגוניים."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus האחרון — אינטליגנציה מתקדמת לסוכני קוד ותהליכי עבודה ארגוניים."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet משופר עם יכולות ניתוח והוראות מתקדמות."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"המודל החזק ביותר של Anthropic למשימות מורכבות ורב-שלביות."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"אינטליגנציה מאוזנת ומהירה למגוון רחב של משימות."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"המודל המהיר והקומפקטי ביותר של Claude — אידיאלי למשימות בעלות תפוקה גבוהה."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — יכולות ניתוח ורב-מודליות משופרות."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"המודל המוביל של OpenAI מהדור הבא."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 קל משקל — יעיל ומהיר למשימות יומיומיות."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — שיפור בהוראות וניתוח."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 קומפקטי — מהיר וזול למשימות פשוטות."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"המודל המתקדם ביותר של GPT-4, מותאם למהירות ועלות."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o קל משקל — מהיר וזול למשימות פשוטות."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (תצוגה מקדימה) — מודל Gemini המוכשר ביותר עם הקשר של 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (תצוגה מקדימה) — מהיר ויעיל עם הקשר של 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — מודל קל ובעל זמן תגובה נמוך עם הקשר של 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"מודל עוזר מותאם לקול פנימי."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto בוחר את המודל הטוב ביותר לבקשה שלך על בסיס קיבולת וביצועים."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"בקרוב"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"העדפות ניתוב אוטומטי"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"כוונן כיצד הנתב האוטומטי מאזן בין פשרות בעת בחירת מודל לכל תור. המשקלים מנורמלים — האיזון היחסי הוא מה שחשוב."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"עלות"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"העדף מודלים זולים יותר עם עלות טוקנים נמוכה יותר."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"דיוק"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"העדף מודלים חזקים יותר להסקה מורכבת."},com_assistants_auto_weight_speed:{english:"Speed",translated:"מהירות"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"העדף מודלים מהירים יותר עם זמן השהיה נמוך יותר."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"איפוס לברירות המחדל"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"תם הזמן להעלאת הקובץ. נסה שוב בעוד כמה דקות."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"משהו השתבש. הנה הודעת השגיאה הספציפית שנתקלנו בה: אירעה שגיאה בעת עיבוד הבקשה שלך. הסייען אינו זמין עוד. נא לפנות למנהל המערכת."},com_ui_code:{english:"Code",translated:"קוד"},com_ui_assistant_share:{english:"Share",translated:"שיתוף"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"הקישור הועתק"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"אין לך גישה לסייען הזה"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"ההעתקה של הקישור ללוח נכשלה"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"תצוגה מקדימה לא זמינה — יצירת התוכן לא הושלמה."},com_ui_view_code:{english:"View code",translated:"הצג קוד"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"תצוגה מקדימה אינה זמינה — התוכן אינו תקין."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"מספר טלפון"},com_assistants_pii_entity_email:{english:"Email Address",translated:"כתובת אימייל"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"כרטיס אשראי"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"מספר תעודת זהות"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"ההעלאה נמשכת יותר מהצפוי - מנסה שוב ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"בעיית חיבור - מנסה שוב ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"ההעלאה נכשלה - אנא בדוק את החיבור שלך ונסה שוב"},com_assistants_memory_enabled:{english:"Memory",translated:"זיכרון"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"הזיכרון מופעל עבור סייען זה. הסייען יכול לשמור ולזכור עובדות בין שיחות."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"הזיכרון מושבת עבור סייען זה. לא יישמרו ולא ייזכרו עובדות בין שיחות."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"נא להסביר את ההצדקה העסקית שלך להשבתת הזיכרון (חובה)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"נא לספק הצדקה להשבתת הזיכרון."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"הזיכרון מושבת עבור הצוות שלך. ניתן לצפות בזיכרונות קיימים ולמחוק אותם, אך לא ניתן להוסיף או לערוך חדשים."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"מריץ את הקוד שלך"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"מחפש במאגר הידע"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"מעבד קול"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"שומר לזיכרון"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"מסיר מהזיכרון"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"סיים לחפש באינטרנט"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"סיים לעיין בדף האינטרנט"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"התמונה נוצרה"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"סיים לחשב"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"סיים להריץ את הקוד שלך"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"סיים לחפש במאגר הידע"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"סיים לעבד קלט קולי"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"נשמר בזיכרון"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"הוסר מהזיכרון"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"הסתיים: {0}"},com_ui_still_working:{english:"still working...",translated:"עדיין עובד..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} מוכן"},com_ui_file_ready_fallback:{english:"File is ready",translated:"הקובץ מוכן"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"לא ניתן היה לעבד את {0}"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"לא ניתן היה לעבד את הקובץ"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"לא ניתן היה לעבד את {0}. אנא העלה מחדש את הקובץ."},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"לא ניתן היה לעבד את הקובץ. אנא העלה מחדש את הקובץ."},com_ui_file_processing:{english:"Processing...",translated:"מעבד..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"העיבוד נכשל"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"נכשל - נדרשת העלאה מחדש"},com_ui_file_retry:{english:"Retry",translated:"נסה שוב"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"נסה שוב בעוד {0}ש׳"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"מנסה שוב לאנדקס את הקובץ..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"אנא המתן {0}ש׳ לפני ניסיון חוזר"},com_ui_file_retries_exhausted_reupload:{english:"Maximum retries reached. Please re-upload the file.",translated:"הגעת למספר הניסיונות המרבי. אנא העלה את הקובץ מחדש."},com_ui_assistant_file_upload_invalid_json:{english:"Invalid JSON file. File content does not match the expected format.",translated:"קובץ JSON לא תקין. תוכן הקובץ אינו תואם את הפורמט הצפוי."}},ik=Object.freeze(Object.defineProperty({__proto__:null,comparisons:sk,default:nk},Symbol.toStringTag,{value:"Module"})),ok={com_error_moderation:"ऐसा लगता है कि प्रस्तुत सामग्री को हमारे मॉडरेशन सिस्टम द्वारा हमारे समुदाय दिशानिर्देशों के साथ संरेखित नहीं होने के कारण चिह्नित किया गया है। हम इस विशेष विषय के साथ आगे नहीं बढ़ सकते। यदि आपके पास कोई अन्य प्रश्न या विषय हैं जिन्हें आप एक्सप्लोर करना चाहते हैं, तो कृपया अपना संदेश संपादित करें, या एक नई बातचीत शुरू करें।",com_error_no_user_key:"कोई कुंजी नहीं मिली। कृपया एक कुंजी प्रदान करें और पुनः प्रयास करें।",com_error_no_base_url:"कोई बेस URL नहीं मिला। कृपया एक प्रदान करें और पुनः प्रयास करें।",com_error_invalid_user_key:"अमान्य कुंजी प्रदान की गई। कृपया एक कुंजी प्रदान करें और पुनः प्रयास करें।",com_error_expired_user_key:"{0} के लिए प्रदान की गई कुंजी {1} पर समाप्त हो गई। कृपया एक कुंजी प्रदान करें और पुनः प्रयास करें।",com_error_token_balance_exceeded:"आपने अपनी मासिक उपयोग सीमा को पार कर लिया है। सहायता के लिए कृपया टीम एडमिन से संपर्क करें।",com_error_token_balance_exceeded_license:"आपने अपनी लाइसेंस के लिए अधिकतम टोकन का उपयोग कर लिया है। आगे की सहायता के लिए कृपया {0} पर बिक्री से संपर्क करें।",com_error_token_balance_percent_used:"आपने अपने आवंटित टोकन का {0}% उपयोग कर लिया है। आगे की सहायता के लिए कृपया {1} से संपर्क करें।",com_error_license_expired:"आपका लाइसेंस उपलब्ध नहीं है। आगे की सहायता के लिए कृपया समर्थन से संपर्क करें।",com_restricted_invalid_ip_format:"IPv6 पतों का समर्थन नहीं है। कृपया IPv4 कनेक्शन का उपयोग करें या आगे की सहायता के लिए समर्थन से संपर्क करें।",com_error_tool_run:"आपके अनुरोध को संसाधित करते समय एक त्रुटि हुई। कृपया पुनः प्रयास करें।",com_files_upload_duplicate_success:"फ़ाइल {0} पहले ही सफलतापूर्वक अपलोड की जा चुकी है",com_files_no_results:"कोई परिणाम नहीं।",com_files_filter:"नाम से फ़ाइलें खोजें",com_files_number_selected:"{0} में से {1} फ़ाइल(एँ) चयनित",com_sidepanel_select_assistant:"सहायक चुनें",com_sidepanel_parameters:"पैरामीटर",com_ui_create_assistant:"सहायक बनाएं",com_ui_create_assistant_permission_needed:"सहायक बनाने के लिए उपयोगकर्ता को बनाने की अनुमति की आवश्यकता है",com_sidepanel_assistant_builder:"सहायक",com_sidepanel_attach_files:"फ़ाइल प्रबंधक",com_sidepanel_manage_files:"फ़ाइलें प्रबंधित करें",com_assistants_shared_with_consent_title:"सहमति",com_assistants_shared_with_consent_description_1:"आप इस सहायक को अन्य टीम सदस्यों के साथ साझा करने वाले हैं। इस सहायक को साझा करने से पहले, कृपया नीचे दिए गए मुख्य बिंदुओं की समीक्षा करें:",com_assistants_shared_with_consent_description_2:"आगे बढ़कर, आप पुष्टि करते हैं कि आप इन शर्तों को समझते हैं और स्वीकार करते हैं।",com_assistants_shared_with_consent_bullet_1:"साझा सहायक में संवेदनशील या गोपनीय डेटा नहीं होना चाहिए।",com_assistants_shared_with_consent_bullet_2:"साझा सहायक को संवेदनशील या गोपनीय डेटा संसाधित नहीं करना चाहिए।",com_assistants_shared_with_consent_bullet_3:"साझा करना सामग्री और पहुंच के लिए जवाबदेही और जिम्मेदारी को दर्शाता है।",com_assistants_shared_with_consent_bullet_4:"सभी के बजाय किसी विशेष टीम या बंद समूह के साथ साझा करने की सिफारिश की जाती है।",com_button_accept:"स्वीकार करें",com_button_decline:"अस्वीकार करें",com_assistants_capabilities:"ज्ञानकोश",com_assistants_file_search:"फाइल खोज",com_assistants_file_search_description:"यहाँ उन फाइलों को जोड़ें जिन्हें आपके सहायक को चैट में प्रश्नों का उत्तर देते समय खोजने की आवश्यकता है।",com_assistants_file_search_supported_label:"समर्थित:",com_assistants_file_search_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",com_assistants_file_search_tips_label:"सुझाव:",com_assistants_file_search_tips:"अपने सहायक को हर बार उपयोगकर्ताओं को जवाब देते समय 'फाइल खोज उपकरण' का उपयोग करने के लिए कहें।",com_assistants_file_search_info:"फाइल खोज के लिए वेक्टर स्टोर संलग्न करना अभी समर्थित नहीं है। आप उन्हें प्रोवाइडर प्लेग्राउंड से संलग्न कर सकते हैं या थ्रेड आधार पर फाइल खोज के लिए संदेशों में फाइलें संलग्न कर सकते हैं।",com_assistants_file_search_fetch_error:"वेक्टर स्टोर से फाइलें प्राप्त करते समय कुछ गलत हो गया।",com_assistants_knowledge:"ज्ञानकोश",com_assistants_knowledge_info:"अपने सहायक को फाइलें अपलोड करें, ताकि वह उनका उपयोग प्रश्नों के उत्तर देने के लिए कर सके (जैसे CXNGPT उपयोगकर्ता गाइड)।",com_assistants_knowledge_disabled:"अपने सहायक को सहेजने के लिए बनाएं पर क्लिक करें, फिर अपनी फाइलें अपलोड करें, और सहेजें पर क्लिक करें।",com_assistants_image_vision:"छवि दृष्टि",com_assistants_code_interpreter:"कोड इंटरप्रेटर",com_assistants_code_interpreter_description:"यहाँ उन फाइलों को जोड़ें जिन्हें आपके सहायक को हर चैट के लिए डेटा का विश्लेषण या रूपांतरण करने के लिए उपयोग करने की आवश्यकता है।",com_assistants_code_interpreter_supported_label:"समर्थित:",com_assistants_code_interpreter_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",com_assistants_code_interpreter_tips_label:"सुझाव:",com_assistants_code_interpreter_tips:"अपने सहायक को हर बार उपयोगकर्ताओं को जवाब देते समय 'कोड इंटरप्रेटर उपकरण' का उपयोग करने के लिए कहें।",com_assistants_code_interpreter_files_counter:"{0} में से {1} फाइलें अपलोड की गईं",com_assistants_code_interpreter_files:"निम्नलिखित फाइलें केवल कोड इंटरप्रेटर के लिए उपलब्ध हैं:",com_assistants_retrieval:"पुनः प्राप्ति",com_assistants_search_name:"नाम से सहायक खोजें",com_assistants_tools:"उपकरण",com_assistants_actions:"क्रियाएँ",com_assistants_add_tools:"उपकरण जोड़ें",com_assistants_add_actions:"क्रियाएँ जोड़ें",com_assistants_non_retrieval_model:"इस मॉडल पर फाइल खोज सक्षम नहीं है। कृपया अन्य मॉडल चुनें।",com_assistants_available_actions:"उपलब्ध क्रियाएँ",com_assistants_running_action:"क्रिया चल रही है",com_assistants_completed_action:"{0} से बात की",com_assistants_completed_function:"{0} चलाया",com_assistants_completed_with_file_search:"फाइल खोज का उपयोग किया",com_assistants_function_use:"सहा