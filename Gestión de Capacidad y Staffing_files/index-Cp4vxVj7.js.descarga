ion_file_type_error:{english:"Unsupported import type",translated:"نوع الملف غير مدعوم للاستيراد"},com_ui_avatar:{english:"Avatar",translated:"الصورة الرمزية"},com_ui_unknown:{english:"Unknown",translated:"غير معروف"},com_ui_result:{english:"Result",translated:"النتيجة"},com_ui_image_gen:{english:"Image Gen",translated:"توليد الصور"},com_ui_assistant:{english:"Assistant",translated:"المساعد"},com_ui_assistants:{english:"Assistants",translated:"المساعدون"},com_ui_attachment:{english:"Attachment",translated:"مرفق"},com_ui_assistants_output:{english:"Assistants Output",translated:"إخراج المساعدين"},com_ui_create:{english:"Create",translated:"إنشاء"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"هل أنت متأكد من رغبتك في حذف هذا المساعد؟ لا يمكن التراجع عن هذا الإجراء."},com_ui_preview:{english:"Preview",translated:"معاينة"},com_ui_upload:{english:"Upload",translated:"تحميل"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'تحميل "{0}" يستغرق وقتًا أطول من المتوقع. يرجى الانتظار حتى ينتهي فهرسة الملف للاسترجاع.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"سياسة الخصوصية"},com_ui_terms_of_service:{english:"Terms of service",translated:"شروط الخدمة"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"لا يمكن إزالة المزيد من القيم، الحد الأدنى المطلوب هو {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"الحد الأقصى المسموح به هو {0}، باستخدام أحدث القيم."},com_endpoint_message:{english:"Message",translated:"رسالة"},com_endpoint_messages:{english:"Messages",translated:"رسائل"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"عدّل رسالتك أو أعد إنشاءها."},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"الحد الأقصى لرموز السياق"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:"الحد الأقصى لعدد الرموز التي يمكن استخدامها للسياق. استخدم هذا للتحكم في عدد الرموز المرسلة لكل طلب. إذا لم يتم تحديده، سيتم استخدام الإعدادات الافتراضية للنظام بناءً على حجم سياق نماذج معروفة. قد يؤدي تعيين قيم أعلى إلى حدوث أخطاء و/أو تكلفة رموز أعلى."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"يتجاوز التعليمات الخاصة بالمساعد. هذا مفيد لتعديل السلوك على أساس كل مرة."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"ضع تعليمات أو سياق إضافي فوق التعليمات الرئيسية للمساعد. يتم تجاهله إذا كان فارغًا."},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"التعليمات الإضافية"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"تعليمات التجاوز"},com_endpoint_stop:{english:"Stop Sequences",translated:"توقف التسلسلات"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"اضغط على 'Enter' لفصل القيم"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"حقل `max_tokens` الاختياري، يمثل الحد الأقصى لعدد الرموز التي يمكن توليدها في إكمال المحادثة.\n\nإجمالي طول رموز الإدخال والرموز المولدة محدود بطول سياق النموذج. قد تواجه أخطاء إذا تجاوز هذا العدد الحد الأقصى لرموز السياق."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"إعادة إرسال جميع الملفات المرفقة مسبقًا. ملاحظة: سيؤدي هذا إلى زيادة تكلفة الرموز وقد تواجه أخطاء مع العديد من المرفقات."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'دقة الطلبات للرؤية. "منخفضة" أرخص وأسرع، "عالية" أكثر تفصيلاً وتكلفة، و"تلقائي" سيختار تلقائيًا بين الاثنين بناءً على دقة الصورة.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"حتى 4 تسلسلات حيث ستتوقف الواجهة البرمجية عن توليد المزيد من الرموز."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"إعادة إرسال الملفات"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"تفاصيل الصورة"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"هل أنت متأكد من أنك تريد حذف هذا الإعداد المسبق؟"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"تم استيراد الإعداد المسبق!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"حدث خطأ أثناء استيراد الإعداد المسبق الخاص بك. يرجى المحاولة مرة أخرى."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"حدث خطأ أثناء حفظ الإعداد المسبق الخاص بك. يرجى المحاولة مرة أخرى."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"حدث خطأ أثناء حذف الإعداد المسبق الخاص بك. يرجى المحاولة مرة أخرى."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"لم يعد الإعداد المسبق الافتراضي"},com_endpoint_preset_default_item:{english:"Default:",translated:"الافتراضي:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"لا يوجد إعداد مسبق افتراضي نشط."},com_endpoint_preset_title:{english:"Preset",translated:"إعداد مسبق"},com_endpoint_preset_saved:{english:"Saved!",translated:"تم الحفظ!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"أصبح الإعداد المسبق الافتراضي الآن."},com_endpoint_preset_selected_title:{english:"Active!",translated:"مُحدَّد!"},com_endpoint_assistant:{english:"Assistant",translated:"المساعد"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"استخدام المساعد النشط"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"يرجى تحديد مساعد من اللوحة الجانبية اليمنى"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"اضبط مفتاحك في قائمة الرأس للدردشة."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"يرجى اختيار مساعد"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"كيف يمكنني مساعدتك اليوم؟"},com_nav_profile_picture:{english:"Profile Picture",translated:"صورة الملف الشخصي"},com_nav_change_picture:{english:"Change picture",translated:"تغيير الصورة"},com_show_agent_settings:{english:"Show Agent Settings",translated:"إظهار إعدادات الوكيل"},com_show_completion_settings:{english:"Show Completion Settings",translated:"إظهار إعدادات الإكمال"},com_hide_examples:{english:"Hide Examples",translated:"إخفاء الأمثلة"},com_show_examples:{english:"Show Examples",translated:"عرض أمثلة"},com_nav_my_files:{english:"File Manager",translated:"ملفاتي"},com_nav_admin_center:{english:"Admin Center",translated:"مركز الإدارة"},com_nav_user_name_display:{english:"Display username in messages",translated:"عرض اسم المستخدم في الرسائل"},com_nav_send_message:{english:"Send message",translated:"إرسال رسالة"},com_nav_language:{english:"Language",translated:"اللغة"},com_nav_lang_auto:{english:"Auto detect",translated:"اكتشاف تلقائي"},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"لقد وصلت إلى الحد الأقصى من الرموز لرخصتك. يرجى الاتصال بالمبيعات على {0} للحصول على مزيد من المساعدة."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"لقد استخدمت {0}% من الرموز المخصصة لك. يرجى الاتصال بـ {1} للحصول على مزيد من المساعدة."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"رخصتك غير متاحة. يرجى الاتصال بالدعم للحصول على مزيد من المساعدة."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"عناوين IPv6 غير مدعومة. يرجى استخدام اتصال IPv4 أو الاتصال بالدعم للحصول على مزيد من المساعدة."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"حدث خطأ أثناء معالجة طلبك. يرجى المحاولة مرة أخرى."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"تم تحميل الملف {0} بنجاح بالفعل"},com_ui_create_assistant:{english:"Create Assistant",translated:"إنشاء مساعد"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"يحتاج المستخدم إلى أذونات الإنشاء لإنشاء مساعد"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"الموافقة"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"أنت على وشك مشاركة هذا المساعد مع أعضاء الفريق الآخرين. قبل المشاركة، يرجى مراجعة النقاط الأساسية أدناه:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"بالمتابعة، تؤكد أنك تفهم وتقبل هذه الشروط."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"يجب ألا يحتوي المساعد المشترك على بيانات حساسة أو سرية."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"يجب ألا يعالج المساعدون المشتركون البيانات الحساسة أو السرية."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"المشاركة تعني المسؤولية والمحاسبة عن المحتوى والوصول."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"يوصى بالمشاركة مع فريق محدد أو مجموعة مغلقة بدلاً من الجميع."},com_button_accept:{english:"Accept",translated:"قبول"},com_button_decline:{english:"Decline",translated:"رفض"},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"حدث خطأ عند جلب الملفات من متاجر المتجهات."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} من {1} ملفات تم تحميلها"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"الحذف مسموح به فقط مع المساعدين الخاصين"},com_assistants_loading:{english:"Loading assistants...",translated:"جارٍ تحميل المساعدين..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"يرجى تقديم سبب لتمكين إخفاء المعلومات الشخصية."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"الإعدادات والخصوصية"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"إخفاء المعلومات الشخصية"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"إخفاء المعلومات الشخصية مفعل افتراضيًا لمكالمات نموذج هذا المساعد."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"السماح بمعلومات التعريف الشخصية يعطل التحرير لمكالمات نموذج هذا المساعد. أنت مسؤول عن الامتثال لسياسات بيانات مؤسستك. يتم تسجيل النشاط بالكامل ومراقبته."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"يرجى توضيح سبب تمكين معلومات التعريف الشخصية (مطلوب)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"الحد الأدنى للطول هو {0} حرف."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"الحد الأقصى للطول هو {0} حرف."},com_ui_kbot_assistants:{english:"Knowledge",translated:"المعرفة"},com_ui_assistant_default_category:{english:"General",translated:"عام"},com_ui_assistant_featured:{english:"Featured",translated:"مميز"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"لا يوجد مساعدين يطابقون معايير البحث."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"لم يتم العثور على مساعدين."},com_ui_category_placeholder:{english:"Search a category",translated:"ابحث عن فئة"},com_ui_tool_placeholder:{english:"Search a tool",translated:"ابحث عن أداة"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"خطأ في الاتصال بالخادم، حاول تحديث الصفحة."},com_ui_select_placeholder:{english:"Select options",translated:"اختر الخيارات"},com_ui_remove:{english:"Remove",translated:"إزالة"},com_ui_thinking:{english:"Thinking",translated:"يفكر"},com_ui_analyzing_request:{english:"Understanding your question",translated:"جارٍ تحليل طلبك"},com_ui_processing:{english:"Putting it together",translated:"جارٍ المعالجة"},com_ui_working_on_it:{english:"Almost ready",translated:"جارٍ العمل عليه"},com_ui_read_aloud:{english:"Read aloud",translated:"اقرأ بصوت عالٍ"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"تم اكتشاف ملف مكرر."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"حدث خطأ أثناء تحميل الملف."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"حدث خطأ أثناء تحميل الملف: نقطة النهاية غير معرفة"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"الملفات الفارغة غير مسموح بها."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"يمكنك تحميل ما يصل إلى {0} ملفات في المرة الواحدة فقط."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"يمكنك تحميل ما يصل إلى {0} ملفات في هذا القسم فقط."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"تم الوصول إلى حد التحميل لـ {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"تعذر تحديد نوع الملف لـ: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"نوع الملف غير مدعوم. يرجى تحميل تنسيق ملف مدعوم."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"فشل في تحميل الصورة"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"حاليًا، يتم دعم ملفات JPEG، JPG، PNG، وWEBP فقط."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"حجم الملف يتجاوز {0} ميغابايت."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"إجمالي حجم الملفات لا يمكن أن يتجاوز {0} ميغابايت."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"حدث خطأ أثناء التحقق من صحة الملف."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"حدث خطأ أثناء معالجة الملف."},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"مساعدة الاستوديو"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"المعرفة"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"غير مصنف"},com_ui_use_micrphone:{english:"Use microphone",translated:"استخدم الميكروفون"},com_endpoint_export_share:{english:"Export/Share",translated:"تصدير/مشاركة"},com_nav_text_to_speech:{english:"Text to Speech",translated:"تحويل النص إلى كلام"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"تشغيل تلقائي للرسالة الأخيرة"},com_nav_speech_to_text:{english:"Speech to Text",translated:"تحويل الكلام إلى نص"},com_nav_user_guide:{english:"User Guide",translated:"دليل المستخدم"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"إرسال النص تلقائيًا (بعد 3 ثوان)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"خطأ في تشغيل الصوت: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"خطأ في معالجة الصوت: {0}"},com_nav_engine:{english:"Engine",translated:"المحرك"},com_nav_browser:{english:"Browser",translated:"المتصفح"},com_nav_external:{english:"External",translated:"خارجي"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"حذف تخزين الذاكرة المؤقتة"},com_nav_voice_select:{english:"Voice",translated:"الصوت"},com_nav_setting_speech:{english:"Speech",translated:"الكلام"},com_page_not_found:{english:"Page not found",translated:"الصفحة غير موجودة"},com_something_went_wrong_error:{english:"Something went wrong",translated:"حدث خطأ ما"},com_unauthorized_access:{english:"Unauthorized access",translated:"وصول غير مصرح به"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"وصول غير مصرح به. الوصول مقيد بمجالات محددة."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"تم حظر حسابك مؤقتًا بسبب انتهاكات لخدماتنا"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"تم تقييد وصولك للتطبيق خارج الشبكة!"},com_support_ticket_text:{english:"Support Ticket",translated:"تذكرة دعم"},com_help_dialog_Header:{english:"Need assistance?",translated:"هل تحتاج إلى مساعدة؟"},com_help_dialog_text_1_1:{english:"Click",translated:"انقر"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"للحصول على تعليمات مفصلة"},com_help_dialog_text_here:{english:"here",translated:"هنا"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"للمشاكل، املأ"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"للمشاكل، اتصل بـ"},com_help_dialog_text_ticket:{english:"ticket",translated:"تذكرة"},com_help_dialog_text_3:{english:"Find the steps",translated:"اعثر على الخطوات"},com_status_ind_none:{english:"Operational",translated:"تشغيل"},com_status_ind_minor:{english:"Minor Issues",translated:"مشاكل بسيطة"},com_status_ind_major:{english:"Major Issues",translated:"مشاكل كبيرة"},com_status_ind_critical:{english:"Critical",translated:"حرج"},com_status_ind_error:{english:"Error Fetching",translated:"خطأ في الجلب"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"يرجى ملاحظة أنه عند مغادرة الدردشة أو بدء دردشة جديدة، ستفقد سجل المحادثة."},com_forbidden_access:{english:"Forbidden access",translated:"وصول محظور"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"سياسة الاستخدام المقبول"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"سياسة الخصوصية"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"اتفاقية الاشتراك"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"قبل استخدام iX Hello، يمكنك مراجعة "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"بالتسجيل و/أو الدخول، فإنك توافق على الشروط المذكورة أعلاه."},com_login_page_and:{english:"and ",translated:"و"},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"لا يوجد مساعدين مثبتين"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"المساعدين المثبتين"},com_ui_loading:{english:"Loading...",translated:"جارٍ التحميل..."},com_ui_unpin:{english:"Unpin",translated:"إلغاء التثبيت"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"تم إلغاء تثبيت المساعد بنجاح"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"خطأ في إلغاء تثبيت المساعد"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"تم تثبيت المساعد بنجاح"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"خطأ في تثبيت/إلغاء تثبيت المساعد"},com_ui_pin:{english:"Pin",translated:"تثبيت"},come_create_assistant:{english:"Create Assistant",translated:"إنشاء مساعد"},come_edit_assistant:{english:"Edit Assistant",translated:"تحرير مساعد"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"هل أنت متأكد أنك تريد المتابعة؟ سيؤدي ذلك إلى فقدان أي تغييرات تم إجراؤها على المساعد الذي تقوم بتحريره أو إنشائه حاليًا. لا يمكن التراجع عن هذا الإجراء."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"لم يتم العثور على مساعد بالمعرف {0}."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"المتصفح لا يدعم التعرف على الكلام"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"لم يتم منح إذن الميكروفون"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"خطأ في بدء التسجيل: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder لا يسجل"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder غير مدعوم في هذا المتصفح"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"تحتوي رسالتك على معلومات شخصية ولا يمكن إرسالها. يرجى إزالة أي معلومات شخصية."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"فشل في إعادة تسمية المحادثة"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"لديك {0} من الرموز المخصصة المتبقية."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"قد يرتكب iX Hello أخطاء. يرجى مراجعة جميع المخرجات للجودة والدقة. يتم تسجيل جميع المدخلات للامتثال."},com_ui_assistant_group_by:{english:"Group by",translated:"تجميع حسب"},com_ui_assistant_category:{english:"Category",translated:"الفئة"},com_ui_assistant_team:{english:"Team",translated:"الفريق"},com_ui_assistant_CX:{english:"CX",translated:"تجربة العملاء"},com_ui_assistant_engineering:{english:"Engineering",translated:"الهندسة"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"الذكاء"},com_ui_assistant_marketing:{english:"Marketing",translated:"التسويق"},com_ui_assistant_operations:{english:"Operations",translated:"العمليات"},com_ui_assistant_sales:{english:"Sales",translated:"المبيعات"},com_ui_assistant_strategy:{english:"Strategy",translated:"الاستراتيجية"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"مساعدي الاستوديو"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"قم بتحميل صورة رمزية (PNG أو JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"البحث عبر الإنترنت"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"تصفح الموقع"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"إنشاء صور"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"حساب الرياضيات"},com_ui_assistant_tools_default:{english:"Running tool",translated:"الأداة الافتراضية"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"تحميل الملف يستغرق وقتًا أطول من المتوقع. يرجى المحاولة مرة أخرى."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"خطأ في تثبيت المساعد"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"حدث خطأ أثناء حذف الرابط المشترك"},com_ui_dan:{english:"DAN",translated:"دان"},com_ui_dan_template:{english:"DAN Template",translated:"قالب دان"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"لا يوجد إعداد افتراضي نشط."},com_ui_drag_drop_title:{english:"Add anything",translated:"أضف أي شيء"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"أسقط أي ملف هنا لإضافته إلى المحادثة"},com_ui_analyzing:{english:"Analyzing",translated:"جارٍ التحليل"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"اكتمل التحليل"},com_ui_warning:{english:"Warning",translated:"تحذير"},com_ui_proceed:{english:"Proceed",translated:"المتابعة"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"الملفات المرفوعة إلى المساعد تُستخدم لأغراض المحادثة فقط. يمكن للمستخدمين الوصول إلى محتوى هذه الملفات بطرح أسئلة ذات صلة، لكن لا يُسمح بتنزيل الملفات مباشرة."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"تعيين اسم مخصص لهذا الإعداد"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"تعيين إدخال مثال. يتم تجاهل المثال إذا كان فارغًا."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"تعيين مخرج مثال. يتم تجاهل المثال إذا كان فارغًا."},com_nav_export_select_type:{english:"Select a file type",translated:"اختر نوع الملف"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"لقطة شاشة (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"نص (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"ماركداون (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"جيسون (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"سي إس في (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"لم يتم تلقي أي استجابة. يرجى محاولة إرسال رسالتك مرة أخرى. إذا استمرت المشكلة بعد إعادة تحميل الصفحة والمحاولة مرة أخرى، يرجى الاتصال بالدعم."},com_ui_back_to_chat:{english:"Back to Chat",translated:"العودة إلى الدردشة"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"إشراف الحماية"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"تم تفعيل إشراف الحماية لهذا المساعد. سيتم فحص المحتوى وفقًا لسياسات الإشراف."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"تعطيل إشراف الحماية يزيل فحوصات الإشراف على المحتوى لهذا المساعد. أنت مسؤول عن الامتثال لسياسات المحتوى في مؤسستك. يتم تسجيل النشاط بالكامل ومراقبته."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"يرجى توضيح مبرر عملك لتعطيل إشراف الحماية (مطلوب)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"يرجى تقديم مبرر لتعطيل إشراف الحماية."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"السماح للمستخدمين بتغيير النموذج في الدردشة"},com_ui_feedback_good:{english:"Good response",translated:"استجابة جيدة"},com_ui_feedback_bad:{english:"Poor response",translated:"استجابة سيئة"},com_ui_feedback_comments:{english:"Comments",translated:"تعليقات"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"تعليقات (اختياري)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"أخبرنا المزيد عن تجربتك..."},com_ui_feedback_submit:{english:"Submit",translated:"إرسال"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"تعذّر إرسال تعليقاتك"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"غير صحيح"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"غير ذي صلة"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"قديم"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"تفاصيل غير كافية"},com_ui_feedback_reason_other:{english:"Other",translated:"أخرى"},com_ui_model_recommended:{english:"Recommended",translated:"موصى به"},com_ui_model_legacy:{english:"Legacy — please update",translated:"قديم - يرجى التحديث"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"هذا النموذج لم يعد مدعومًا. يرجى اختيار نموذج حالي."},com_nav_setting_memory:{english:"Memory",translated:"الذاكرة"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"إدارة الحقائق الشخصية التي يتذكرها المساعد عبر محادثاتك."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"أضف ذاكرة جديدة..."},com_nav_memory_add_button:{english:"Add memory",translated:"أضف ذاكرة"},com_nav_memory_category:{english:"Category",translated:"الفئة"},com_nav_memory_category_preference:{english:"Preference",translated:"التفضيل"},com_nav_memory_category_identity:{english:"Identity",translated:"الهوية"},com_nav_memory_category_context:{english:"Context",translated:"السياق"},com_nav_memory_category_project:{english:"Project",translated:"المشروع"},com_nav_memory_empty_title:{english:"No memories yet",translated:"لا توجد ذكريات بعد"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"الذكريات التي تحفظها ستظهر هنا وتساعد في تخصيص المحادثات المستقبلية."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"تعذر تحميل الذكريات. يرجى المحاولة مرة أخرى."},com_nav_memory_retry:{english:"Retry",translated:"أعد المحاولة"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"تعذر إضافة الذاكرة. يرجى المحاولة مرة أخرى."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"تعذر تحديث الذاكرة. يرجى المحاولة مرة أخرى."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"تعذر حذف الذاكرة. يرجى المحاولة مرة أخرى."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"حذف هذه الذاكرة؟"},com_nav_memory_delete_button:{english:"Delete",translated:"حذف"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"تحرير الذاكرة"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"حذف الذاكرة"},com_nav_memory_save:{english:"Save",translated:"حفظ"},com_nav_memory_cancel:{english:"Cancel",translated:"إلغاء"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"تم الحفظ في {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — أحدث نموذج تفكير GPT-5 بذكاء متقدم."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — نسخة مضغوطة وفعالة من حيث التكلفة من GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — أحدث نموذج من الجيل الخامس لـ GPT."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"أحدث Opus — ذكاء متقدم لوكلاء البرمجة وتدفقات العمل المؤسسية."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"أحدث Opus — ذكاء متقدم لوكلاء البرمجة وتدفقات العمل المؤسسية."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet محسّن مع تحسين في الاستدلال واتباع التعليمات."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"أقوى نموذج من Anthropic للمهام المعقدة متعددة الخطوات."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"ذكاء وسرعة متوازنة لمجموعة واسعة من المهام."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"أسرع وأصغر نموذج Claude — مثالي للمهام ذات الإنتاجية العالية."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — تحسين في الاستدلال والقدرات متعددة الوسائط."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"نموذج الجيل التالي الرائد من OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 خفيف الوزن — فعال وسريع للمهام اليومية."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — تحسين في اتباع التعليمات والاستدلال."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 مضغوط — أسرع وأرخص للمهام الأبسط."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"أكثر نماذج GPT-4 قدرة، محسن للسرعة والتكلفة."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o خفيف الوزن — أسرع وأرخص للمهام الأبسط."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (معاينة) — أقوى نموذج Gemini مع سياق بمليون رمز."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (معاينة) — سريع وفعّال مع سياق بمليون رمز."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — نموذج خفيف وذو زمن استجابة منخفض مع سياق بمليون رمز."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"نموذج مساعد داخلي محسن للصوت."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"يختار Auto أفضل نموذج لطلبك بناءً على السعة والأداء."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"قريبًا"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"تفضيلات التوجيه التلقائي"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"اضبط كيفية موازنة الموجّه التلقائي بين المفاضلات عند اختيار نموذج لكل دور. يتم تطبيع الأوزان — المهم هو التوازن النسبي."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"التكلفة"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"فضّل النماذج الأرخص ذات تكلفة الرموز الأقل."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"الدقة"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"فضّل النماذج الأقوى للمنطق المعقد."},com_assistants_auto_weight_speed:{english:"Speed",translated:"السرعة"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"فضّل النماذج الأسرع والأقل زمن استجابة."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"إعادة التعيين إلى الإعدادات الافتراضية"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"انتهت مهلة تحميل الملف. يرجى المحاولة مرة أخرى بعد بضع دقائق."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"حدث خطأ ما. إليك رسالة الخطأ المحددة التي واجهناها: حدث خطأ أثناء معالجة طلبك. المساعد لم يعد متاحًا. يُرجى التواصل مع المسؤول."},com_ui_code:{english:"Code",translated:"الرمز"},com_ui_assistant_share:{english:"Share",translated:"مشاركة"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"تم نسخ الرابط"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"ليس لديك حق الوصول إلى هذا المساعد"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"فشل نسخ الرابط إلى الحافظة"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"المعاينة غير متاحة - لم يكتمل إنشاء المحتوى."},com_ui_view_code:{english:"View code",translated:"عرض الكود"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"المعاينة غير متاحة — المحتوى غير صالح."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"رقم الهاتف"},com_assistants_pii_entity_email:{english:"Email Address",translated:"عنوان البريد الإلكتروني"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"بطاقة الائتمان"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"رقم الضمان الاجتماعي"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"يستغرق الرفع وقتًا أطول من المتوقع - جارٍ إعادة المحاولة ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"مشكلة في الاتصال - جارٍ إعادة المحاولة ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"فشل الرفع - يُرجى التحقق من اتصالك والمحاولة مرة أخرى"},com_assistants_memory_enabled:{english:"Memory",translated:"الذاكرة"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"الذاكرة مفعّلة لهذا المساعد. يمكن للمساعد تخزين الحقائق واسترجاعها عبر المحادثات."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"الذاكرة معطّلة لهذا المساعد. لن يتم تخزين أي حقائق أو استرجاعها عبر المحادثات."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"يرجى توضيح مبررك التجاري لتعطيل الذاكرة (مطلوب)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"يرجى تقديم مبرر لتعطيل الذاكرة."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"الذاكرة معطّلة لفريقك. يمكنك عرض الذكريات الحالية وحذفها، ولكن لا يمكنك إضافة أو تعديل ذكريات جديدة."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"جارٍ تشغيل التعليمات البرمجية"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"جارٍ البحث في قاعدة المعرفة"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"جارٍ معالجة الصوت"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"جارٍ الحفظ في الذاكرة"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"جارٍ الإزالة من الذاكرة"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"اكتمل البحث على الويب"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"اكتملت مراجعة صفحة الويب"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"تم إنشاء الصورة"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"اكتمل الحساب"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"اكتمل تشغيل التعليمات البرمجية"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"اكتمل البحث في قاعدة المعرفة"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"اكتملت معالجة الإدخال الصوتي"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"تم الحفظ في الذاكرة"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"تمت الإزالة من الذاكرة"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"اكتمل: {0}"},com_ui_still_working:{english:"still working...",translated:"لا يزال يعمل..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} جاهز"},com_ui_file_ready_fallback:{english:"File is ready",