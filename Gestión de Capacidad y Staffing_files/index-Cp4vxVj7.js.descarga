ssistant_file_upload_total_size_limit:"Celková velikost souborů nesmí přesáhnout {0} MB.",com_ui_assistant_file_validation_error:"Při ověřování souboru došlo k chybě.",com_ui_assistant_file_processing_error:"Při zpracování souboru došlo k chybě.",com_ui_assistants:"Asistenti",com_ui_assistants_category_ix_customer:"Studio Asistence",com_ui_assistants_category_kbot:"Znalosti",com_ui_assistants_uncategorized:"Nezařazeno",com_ui_attachment:"Příloha",com_ui_assistants_output:"Výstup asistentů",com_ui_delete:"Smazat",com_ui_create:"Vytvořit",com_ui_share:"Sdílet",com_ui_copy_link:"Kopírovat odkaz",com_ui_update_link:"Aktualizovat odkaz",com_ui_create_link:"Vytvořit odkaz",com_ui_share_link_to_chat:"Sdílet odkaz do chatu",com_ui_share_error:"Při sdílení odkazu na chat došlo k chybě",com_ui_share_create_message:"Vaše jméno a zprávy přidané po sdílení zůstanou soukromé.",com_ui_share_created_message:"Veřejný odkaz na váš chat byl vytvořen. Sdílené chaty můžete kdykoli spravovat v Nastavení.",com_ui_share_update_message:"Vaše jméno, vlastní pokyny a zprávy přidané po sdílení zůstanou soukromé.",com_ui_share_updated_message:"Veřejný odkaz na váš chat byl aktualizován. Sdílené chaty můžete kdykoli spravovat v Nastavení.",com_ui_shared_link_not_found:"Sdílený odkaz nebyl nalezen",com_ui_delete_conversation:"Smazat chat?",com_ui_delete_conversation_confirm:"Tímto bude smazáno",com_ui_delete_assistant_confirm:"Opravdu chcete smazat tohoto asistenta? Toto nelze vrátit zpět.",com_ui_rename:"Přejmenovat",com_ui_more_options:"Více",com_ui_preview:"Náhled",com_ui_upload:"Nahrát",com_ui_upload_delay:'Nahrávání "{0}" trvá déle, než se očekávalo. Počkejte prosím, než se soubor dokončí indexování pro načtení.',com_ui_privacy_policy:"Zásady ochrany osobních údajů",com_ui_terms_of_service:"Podmínky služby",com_ui_use_micrphone:"Použít mikrofon",com_ui_min_tags:"Nelze odstranit více hodnot, je vyžadováno minimálně {0}.",com_ui_max_tags:"Maximální povolený počet je {0}, používají se nejnovější hodnoty.",com_auth_error_login:"Nelze se přihlásit s poskytnutými údaji. Zkontrolujte prosím své přihlašovací údaje a zkuste to znovu.",com_auth_error_login_rl:"Překročili jste počet povolených pokusů o přihlášení. Zkuste to prosím znovu za 15 minut.",com_auth_error_login_ban:"Váš účet byl dočasně zablokován kvůli porušení našich podmínek.",com_auth_error_login_server:"Došlo k interní chybě serveru. Počkejte prosím několik okamžiků a zkuste to znovu.",com_auth_sign_in:"Přihlásit se",com_endpoint_system_message:"Systémová zpráva",com_endpoint_message:"Zpráva",com_endpoint_messages:"Zprávy",com_endpoint_message_not_appendable:"Upravte svou zprávu nebo regenerujte.",com_endpoint_default_blank:"výchozí: prázdné",com_endpoint_default_false:"výchozí: nepravda",com_endpoint_default_creative:"výchozí: kreativní",com_endpoint_default_empty:"výchozí: prázdné",com_endpoint_default_with_num:"výchozí: {0}",com_endpoint_context:"Kontext",com_endpoint_tone_style:"Styl tónu",com_endpoint_token_count:"Počet tokenů",com_endpoint_output:"Výstup",com_endpoint_context_tokens:"Maximální počet kontextových tokenů",com_endpoint_context_info:`Maximální počet tokenů, které lze použít pro kontext. Použijte to pro kontrolu, kolik tokenů je odesláno na požadavek.
  Pokud není uvedeno, použijí se systémové výchozí hodnoty na základě známých velikostí kontextu modelů. Nastavení vyšších hodnot může vést k chybám a/nebo vyšším nákladům na tokeny.`,com_endpoint_prompt_prefix_placeholder:"Nastavte vlastní pokyny nebo kontext. Ignorováno, pokud je prázdné.",com_endpoint_instructions_assistants_placeholder:"Přepisuje pokyny asistenta. Užitečné pro úpravu chování při každém spuštění.",com_endpoint_prompt_prefix_assistants_placeholder:"Nastavte další pokyny nebo kontext nad hlavní pokyny asistenta. Ignorováno, pokud je prázdné.",com_endpoint_custom_name:"Vlastní název",com_endpoint_prompt_prefix:"Vlastní pokyny",com_endpoint_prompt_prefix_assistants:"Další pokyny",com_endpoint_instructions_assistants:"Přepsat pokyny",com_endpoint_temperature:"Teplota",com_endpoint_default:"výchozí",com_endpoint_top_p:"Top P",com_endpoint_top_k:"Top K",com_endpoint_max_output_tokens:"Maximální počet výstupních tokenů",com_endpoint_stop:"Stop sekvence",com_endpoint_stop_placeholder:"Oddělte hodnoty stisknutím `Enter`",com_endpoint_openai_max_tokens:"Volitelné pole `max_tokens`, představující maximální počet tokenů, které mohou být vygenerovány v dokončení chatu.\n\nCelková délka vstupních a generovaných tokenů je omezena délkou kontextu modelu. Můžete narazit na chyby, pokud toto číslo překročí maximální počet kontextových tokenů.",com_endpoint_openai_temp:"Vyšší hodnoty = více náhodné, nižší hodnoty = více zaměřené a deterministické. Doporučujeme měnit toto nebo Top P, ale ne obojí.",com_endpoint_openai_max:"Maximální počet tokenů k vygenerování. Celková délka vstupních a generovaných tokenů je omezena délkou kontextu modelu.",com_endpoint_openai_topp:"Alternativa k vzorkování s teplotou, nazývaná nucleus sampling, kde model zvažuje výsledky tokenů s top_p pravděpodobnostní masou. Takže 0.1 znamená, že se zvažují pouze tokeny tvořící top 10% pravděpodobnostní masy. Doporučujeme měnit toto nebo teplotu, ale ne obojí.",com_endpoint_openai_freq:"Číslo mezi 0 a 2.0. Pozitivní hodnoty penalizují nové tokeny na základě jejich stávající frekvence v textu, čímž snižují pravděpodobnost modelu opakovat stejnou větu doslovně.",com_endpoint_openai_pres:"Číslo mezi 0 a 2.0. Pozitivní hodnoty penalizují nové tokeny na základě toho, zda se objevují v textu, čímž zvyšují pravděpodobnost modelu hovořit o nových tématech.",com_endpoint_openai_resend_files:"Znovu odeslat všechny dříve připojené soubory. Poznámka: to zvýší náklady na tokeny a můžete narazit na chyby s mnoha přílohami.",com_endpoint_openai_detail:'Rozlišení pro Vision požadavky. "Nízké" je levnější a rychlejší, "Vysoké" je podrobnější a dražší, a "Auto" automaticky vybere mezi těmito dvěma na základě rozlišení obrázku.',com_endpoint_openai_stop:"Až 4 sekvence, kde API přestane generovat další tokeny.",com_endpoint_openai_custom_name_placeholder:"Nastavte vlastní název pro iXHello",com_endpoint_openai_prompt_prefix_placeholder:"Nastavte vlastní pokyny k zahrnutí do systémové zprávy. Výchozí: žádné",com_endpoint_frequency_penalty:"Penalizace frekvence",com_endpoint_presence_penalty:"Postih za přítomnost",com_endpoint_plug_use_functions:"Použít funkce",com_endpoint_plug_resend_files:"Znovu odeslat soubory",com_endpoint_plug_image_detail:"Detail obrázku",com_endpoint_plug_skip_completion:"Přeskočit dokončení",com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:"Nastavit vlastní instrukce pro zahrnutí do systémové zprávy. Výchozí: žádné",com_endpoint_import:"Importovat",com_endpoint_set_custom_name:"Nastavit vlastní název, pokud můžete tento přednastavení najít",com_endpoint_preset_delete_confirm:"Opravdu chcete smazat toto přednastavení?",com_endpoint_preset_import:"Přednastavení importováno!",com_endpoint_preset_import_error:"Při importu vašeho přednastavení došlo k chybě. Zkuste to prosím znovu.",com_endpoint_preset_save_error:"Při ukládání vašeho přednastavení došlo k chybě. Zkuste to prosím znovu.",com_endpoint_preset_delete_error:"Při mazání vašeho přednastavení došlo k chybě. Zkuste to prosím znovu.",com_endpoint_preset_default_removed:"již není výchozím přednastavením.",com_endpoint_preset_default_item:"Výchozí:",com_endpoint_preset_default_none:"Žádné aktivní výchozí přednastavení.",com_endpoint_preset_title:"Přednastavení",com_endpoint_preset_saved:"Uloženo!",com_endpoint_preset_default:"je nyní výchozím přednastavením.",com_endpoint_preset:"přednastavení",com_endpoint_presets:"přednastavení",com_endpoint_preset_selected_title:"Aktivní!",com_endpoint_preset_name:"Název přednastavení",com_endpoint:"Koncový bod",com_endpoint_examples:"Přednastavení",com_endpoint_export:"Exportovat",com_endpoint_export_share:"Exportovat/Sdílet",com_endpoint_assistant:"Asistent",com_endpoint_use_active_assistant:"Použít aktivního asistenta",com_endpoint_save_as_preset:"Uložit jako přednastavení",com_endpoint_presets_clear_warning:"Opravdu chcete vymazat všechna přednastavení? Toto je nevratné.",com_endpoint_no_presets:"Žádná přednastavení, použijte tlačítko nastavení k vytvoření",com_endpoint_my_preset:"Moje přednastavení",com_endpoint_agent_model:"Model agenta (Doporučeno: GPT-3.5)",com_endpoint_completion_model:"Model dokončení (Doporučeno: GPT-4)",com_endpoint_func_hover:"Povolit použití pluginů jako funkcí OpenAI",com_endpoint_skip_hover:"Povolit přeskočení kroku dokončení, který kontroluje konečnou odpověď a generované kroky",com_endpoint_assistant_placeholder:"Vyberte asistenta a začněte nový chat",com_endpoint_config_placeholder:"Nastavte svůj klíč v nabídce Hlavička pro chat.",com_nav_welcome_assistant:"Vyberte asistenta",com_nav_welcome_message:"Vítejte v iXHello",com_nav_text_to_speech:"Text na řeč",com_nav_automatic_playback:"Automatické přehrávání poslední zprávy",com_nav_speech_to_text:"Řeč na text",com_nav_profile_picture:"Profilový obrázek",com_nav_change_picture:"Změnit obrázek",com_show_agent_settings:"Zobrazit nastavení agenta",com_show_completion_settings:"Zobrazit nastavení dokončení",com_hide_examples:"Skrýt přík