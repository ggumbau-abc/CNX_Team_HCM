:{english:"Search messages",translated:"বার্তা অনুসন্ধান করুন"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"স্বয়ংক্রিয় পাঠান (৩ সেকেন্ড পরে)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"অডিও চালানোর ত্রুটি: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"অডিও প্রক্রিয়াকরণের ত্রুটি: {0}"},com_nav_engine:{english:"Engine",translated:"ইঞ্জিন"},com_nav_browser:{english:"Browser",translated:"ব্রাউজার"},com_nav_external:{english:"External",translated:"বাহ্যিক"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"ক্যাশ স্টোরেজ মুছুন"},com_nav_voice_select:{english:"Voice",translated:"ভয়েস"},com_nav_setting_general:{english:"General",translated:"সাধারণ"},com_nav_setting_speech:{english:"Speech",translated:"বক্তব্য"},com_nav_language:{english:"Language",translated:"ভাষা"},com_nav_lang_auto:{english:"Auto detect",translated:"স্বয়ংক্রিয় সনাক্তকরণ"},com_page_not_found:{english:"Page not found",translated:"পৃষ্ঠা পাওয়া যায়নি"},com_something_went_wrong_error:{english:"Something went wrong",translated:"কিছু ভুল হয়েছে"},com_unauthorized_access:{english:"Unauthorized access",translated:"অননুমোদিত প্রবেশ"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"অননুমোদিত প্রবেশ। প্রবেশাধিকার নির্দিষ্ট ডোমেইনে সীমাবদ্ধ।"},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"আমাদের সেবার লঙ্ঘনের কারণে আপনার অ্যাকাউন্ট সাময়িকভাবে নিষিদ্ধ করা হয়েছে"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"আপনি নেটওয়ার্কের বাইরে অ্যাপ অ্যাক্সেস করতে সীমাবদ্ধ!"},com_support_ticket_text:{english:"Support Ticket",translated:"সহায়তা টিকিট"},com_help_dialog_Header:{english:"Need assistance?",translated:"সহায়তা প্রয়োজন?"},com_help_dialog_text_1_1:{english:"Click",translated:"ক্লিক করুন"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"বিস্তারিত নির্দেশনার জন্য"},com_help_dialog_text_here:{english:"here",translated:"এখানে"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"সমস্যার জন্য, একটি পূরণ করুন"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"সমস্যার জন্য, যোগাযোগ করুন"},com_help_dialog_text_ticket:{english:"ticket",translated:"টিকিট"},com_help_dialog_text_3:{english:"Find the steps",translated:"ধাপগুলি খুঁজুন"},com_status_ind_none:{english:"Operational",translated:"সক্রিয়"},com_status_ind_minor:{english:"Minor Issues",translated:"ছোটখাটো সমস্যা"},com_status_ind_major:{english:"Major Issues",translated:"বড় সমস্যা"},com_status_ind_critical:{english:"Critical",translated:"গুরুতর"},com_status_ind_error:{english:"Error Fetching",translated:"ত্রুটি লোড হচ্ছে"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"দয়া করে মনে রাখবেন, আপনি চ্যাট ছেড়ে গেলে বা নতুন চ্যাট শুরু করলে আপনার কথোপকথনের ইতিহাস হারাবেন।"},com_forbidden_access:{english:"Forbidden access",translated:"প্রবেশ নিষিদ্ধ"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"গ্রহণযোগ্য ব্যবহার নীতি"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"গোপনীয়তা নীতি"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"সাবস্ক্রিপশন চুক্তি"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"iX Hello ব্যবহারের আগে, আপনি Concentrix এর পর্যালোচনা করতে পারেন "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"সাইন আপ এবং/অথবা প্রবেশ করে, আপনি উপরের শর্তাবলীতে সম্মত হন।"},com_login_page_and:{english:"and ",translated:"এবং "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"কোন পিন করা সহকারী নেই"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"পিন করা সহকারী"},com_ui_loading:{english:"Loading...",translated:"লোড হচ্ছে..."},com_ui_unpin:{english:"Unpin",translated:"আনপিন"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"সহকারী সফলভাবে আনপিন হয়েছে"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"সহকারী আনপিন করতে ত্রুটি"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"সহকারী সফলভাবে পিন হয়েছে"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"সহকারী পিন/আনপিন করতে ত্রুটি"},com_ui_pin:{english:"Pin",translated:"পিন"},come_create_assistant:{english:"Create Assistant",translated:"সহকারী তৈরি করুন"},come_edit_assistant:{english:"Edit Assistant",translated:"সহকারী সম্পাদনা করুন"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"আপনি কি নিশ্চিত যে আপনি এগিয়ে যেতে চান? এটি বর্তমানে আপনি যে সহকারী সম্পাদনা বা তৈরি করছেন তার যেকোন পরিবর্তন হারানোর কারণ হবে। এই কার্যটি পূর্বাবস্থায় ফেরানো যাবে না।"},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"আইডি {0} সহ সহকারী পাওয়া যায়নি।"},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"ব্রাউজার SpeechRecognition সমর্থন করে না"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"মাইক্রোফোনের অনুমতি দেওয়া হয়নি"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"রেকর্ডিং শুরু করতে ত্রুটি: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder রেকর্ড করছে না"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"এই ব্রাউজারে MediaRecorder সমর্থিত নয়"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"আপনার বার্তায় ব্যক্তিগত তথ্য রয়েছে এবং পাঠানো যায়নি। অনুগ্রহ করে ব্যক্তিগত তথ্য সরান।"},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"কথোপকথনের নাম পরিবর্তন ব্যর্থ হয়েছে"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"আপনার বরাদ্দকৃত টোকেনের {0} অবশিষ্ট আছে।"},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello ভুল করতে পারে। গুণমান এবং নির্ভুলতার জন্য সমস্ত আউটপুট পর্যালোচনা করুন। সমস্ত ইনপুট সম্মতির জন্য লগ করা হয়।"},com_ui_assistant_group_by:{english:"Group by",translated:"গ্রুপ দ্বারা"},com_ui_assistant_category:{english:"Category",translated:"বিভাগ"},com_ui_assistant_team:{english:"Team",translated:"দল"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"ইঞ্জিনিয়ারিং"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"বুদ্ধিমত্তা"},com_ui_assistant_marketing:{english:"Marketing",translated:"মার্কেটিং"},com_ui_assistant_operations:{english:"Operations",translated:"অপারেশনস"},com_ui_assistant_sales:{english:"Sales",translated:"বিক্রয়"},com_ui_assistant_strategy:{english:"Strategy",translated:"কৌশল"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"স্টুডিও সহায়তা"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"একটি অবতার চিত্র আপলোড করুন (PNG বা JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"অনলাইনে অনুসন্ধান"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"ওয়েবসাইট ব্রাউজ করুন"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"চিত্র তৈরি করুন"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"গণিত হিসাব করুন"},com_ui_assistant_tools_default:{english:"Running tool",translated:"ডিফল্ট টুল"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"ফাইল আপলোডের সময় বেশি লাগছে। দয়া করে আবার চেষ্টা করুন।"},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"সহকারী পিন করার সময় ত্রুটি"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"শেয়ার করা লিঙ্ক মুছে ফেলার সময় ত্রুটি হয়েছে"},com_ui_dan:{english:"DAN",translated:"ড্যান"},com_ui_dan_template:{english:"DAN Template",translated:"ড্যান টেমপ্লেট"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"কোনও ডিফল্ট প্রিসেট সক্রিয় নয়।"},com_ui_drag_drop_title:{english:"Add anything",translated:"কিছু যোগ করুন"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"আলোচনায় যোগ করতে এখানে যেকোনো ফাইল ফেলে দিন"},com_ui_analyzing:{english:"Analyzing",translated:"বিশ্লেষণ করা হচ্ছে"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"বিশ্লেষণ শেষ হয়েছে"},com_ui_warning:{english:"Warning",translated:"সতর্কতা"},com_ui_proceed:{english:"Proceed",translated:"অগ্রসর হন"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"সহকারীতে আপলোড করা ফাইলগুলি শুধুমাত্র কথোপকথনের উদ্দেশ্যে ব্যবহৃত হয়। ব্যবহারকারীরা প্রাসঙ্গিক প্রশ্ন জিজ্ঞাসা করে এই ফাইলগুলির বিষয়বস্তু অ্যাক্সেস করতে পারেন, তবে ফাইলগুলির সরাসরি ডাউনলোড অনুমোদিত নয়।"},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"এই প্রিসেটের জন্য একটি কাস্টম নাম সেট করুন"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"উদাহরণ ইনপুট সেট করুন। উদাহরণ ফাঁকা থাকলে উপেক্ষা করা হয়।"},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"উদাহরণ আউটপুট সেট করুন। উদাহরণ ফাঁকা থাকলে উপেক্ষা করা হয়।"},com_nav_export_select_type:{english:"Select a file type",translated:"একটি ফাইল টাইপ নির্বাচন করুন"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"স্ক্রিনশট (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"টেক্সট (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"মার্কডাউন (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"জেসন (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"সিএসভি (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"কোনও প্রতিক্রিয়া পাওয়া যায়নি। দয়া করে আপনার বার্তাটি আবার পাঠানোর চেষ্টা করুন। পৃষ্ঠাটি পুনরায় লোড করার পরেও যদি সমস্যা থাকে এবং পুনরায় চেষ্টা করার পরেও সমস্যা থাকে, তবে দয়া করে সহায়তার সাথে যোগাযোগ করুন।"},com_ui_back_to_chat:{english:"Back to Chat",translated:"চ্যাটে ফিরে যান"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"গার্ডরেল মডারেশন"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"এই সহকারীর জন্য গার্ডরেল মডারেশন সক্রিয় করা হয়েছে। বিষয়বস্তু মডারেশন নীতির সাথে মিলিয়ে পরীক্ষা করা হবে।"},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"গার্ডরেল মডারেশন নিষ্ক্রিয় করলে এই সহকারীর জন্য বিষয়বস্তু মডারেশন পরীক্ষা সরিয়ে দেয়। আপনার প্রতিষ্ঠানের বিষয়বস্তু নীতির সাথে সম্মতি নিশ্চিত করার দায়িত্ব আপনার। কার্যকলাপ সম্পূর্ণরূপে লগ এবং পর্যবেক্ষণ করা হয়।"},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"গার্ডরেল মডারেশন নিষ্ক্রিয় করার জন্য আপনার ব্যবসায়িক যুক্তি ব্যাখ্যা করুন (প্রয়োজনীয়)।"},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"গার্ডরেল মডারেশন নিষ্ক্রিয় করার জন্য একটি যুক্তি প্রদান করুন।"},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"ব্যবহারকারীদের চ্যাটে মডেল পরিবর্তন করার অনুমতি দিন"},com_ui_feedback_good:{english:"Good response",translated:"ভালো সাড়া"},com_ui_feedback_bad:{english:"Poor response",translated:"খারাপ সাড়া"},com_ui_feedback_comments:{english:"Comments",translated:"মন্তব্য"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"মন্তব্য (ঐচ্ছিক)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"আপনার অভিজ্ঞতা সম্পর্কে আরও বলুন..."},com_ui_feedback_submit:{english:"Submit",translated:"জমা দিন"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"আপনার মতামত পাঠাতে পারিনি"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"ভুল"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"প্রাসঙ্গিক নয়"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"পুরানো"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"পর্যাপ্ত বিবরণ নেই"},com_ui_feedback_reason_other:{english:"Other",translated:"অন্যান্য"},com_ui_model_recommended:{english:"Recommended",translated:"প্রস্তাবিত"},com_ui_model_legacy:{english:"Legacy — please update",translated:"লিগ্যাসি — অনুগ্রহ করে আপডেট করুন"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"এই মডেলটি আর সমর্থিত নয়। অনুগ্রহ করে একটি বর্তমান মডেল নির্বাচন করুন।"},com_nav_setting_memory:{english:"Memory",translated:"মেমরি"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"আপনার কথোপকথনের মধ্যে সহকারী যে ব্যক্তিগত তথ্য মনে রাখে তা পরিচালনা করুন।"},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"নতুন মেমরি যোগ করুন…"},com_nav_memory_add_button:{english:"Add memory",translated:"মেমরি যোগ করুন"},com_nav_memory_category:{english:"Category",translated:"বিভাগ"},com_nav_memory_category_preference:{english:"Preference",translated:"পছন্দ"},com_nav_memory_category_identity:{english:"Identity",translated:"পরিচয়"},com_nav_memory_category_context:{english:"Context",translated:"প্রসঙ্গ"},com_nav_memory_category_project:{english:"Project",translated:"প্রকল্প"},com_nav_memory_empty_title:{english:"No memories yet",translated:"এখনও কোনো মেমরি নেই"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"আপনি যে মেমরি সংরক্ষণ করবেন তা এখানে প্রদর্শিত হবে এবং ভবিষ্যতের কথোপকথন ব্যক্তিগতকরণে সহায়তা করবে।"},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"মেমরি লোড করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"},com_nav_memory_retry:{english:"Retry",translated:"পুনরায় চেষ্টা করুন"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"মেমরি যোগ করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"মেমরি আপডেট করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"মেমরি মুছে ফেলা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"এই মেমরি মুছে ফেলবেন?"},com_nav_memory_delete_button:{english:"Delete",translated:"মুছে ফেলুন"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"মেমরি সম্পাদনা করুন"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"মেমরি মুছে ফেলুন"},com_nav_memory_save:{english:"Save",translated:"সংরক্ষণ করুন"},com_nav_memory_cancel:{english:"Cancel",translated:"বাতিল করুন"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"সংরক্ষিত {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — সীমান্ত বুদ্ধিমত্তা সহ সর্বশেষ GPT-5 চিন্তাভাবনা মডেল।"},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 মিনি — কমপ্যাক্ট এবং খরচ-সাশ্রয়ী GPT-5.4 ভ্যারিয়েন্ট।"},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — সর্বশেষ GPT-5 প্রজন্মের মডেল।"},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"সর্বশেষ Opus — কোডিং এজেন্ট এবং এন্টারপ্রাইজ ওয়ার্কফ্লো জন্য অগ্রণী বুদ্ধিমত্তা।"},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"সর্বশেষ Opus — কোডিং এজেন্ট এবং এন্টারপ্রাইজ ওয়ার্কফ্লো জন্য অগ্রণী বুদ্ধিমত্তা।"},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"উন্নত Sonnet উন্নত যুক্তি এবং নির্দেশনা অনুসরণ সহ।"},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Anthropic এর সবচেয়ে শক্তিশালী মডেল জটিল, বহু-ধাপের কাজের জন্য।"},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"বিস্তৃত কাজের জন্য ভারসাম্যপূর্ণ বুদ্ধিমত্তা এবং গতি।"},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"দ্রুততম এবং সবচেয়ে কমপ্যাক্ট Claude মডেল — উচ্চ-থ্রুপুট কাজের জন্য আদর্শ।"},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — উন্নত যুক্তি এবং মাল্টিমোডাল ক্ষমতা।"},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"OpenAI এর ফ্ল্যাগশিপ পরবর্তী প্রজন্মের মডেল।"},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"হালকা GPT-5 — দৈনন্দিন কাজের জন্য দক্ষ এবং দ্রুত।"},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — উন্নত নির্দেশনা অনুসরণ এবং যুক্তি।"},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"কমপ্যাক্ট GPT-4.1 — সহজ কাজের জন্য দ্রুত এবং সস্তা।"},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"সবচেয়ে সক্ষম GPT-4 মডেল, গতি এবং খরচের জন্য অপ্টিমাইজড।"},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"হালকা GPT-4o — সহজ কাজের জন্য দ্রুত এবং সস্তা।"},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (প্রিভিউ) — 1M প্রসঙ্গ সহ সবচেয়ে সক্ষম Gemini মডেল।"},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (প্রিভিউ) — 1M প্রসঙ্গ সহ দ্রুত ও দক্ষ।"},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — 1M প্রসঙ্গ সহ হালকা, কম-লেটেন্সি মডেল।"},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"অভ্যন্তরীণ ভয়েস-অপ্টিমাইজড সহকারী মডেল।"},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto ধারণক্ষমতা এবং কার্যক্ষমতার উপর ভিত্তি করে আপনার অনুরোধের জন্য সেরা মডেলটি নির্বাচন করে।"},com_ui_model_coming_soon:{english:"Coming Soon",translated:"শীঘ্রই আসছে"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"অটো রাউটিং পছন্দসমূহ"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"প্রতিটি টার্নে মডেল নির্বাচন করার সময় অটো রাউটার কীভাবে বিভিন্ন সমঝোতার মধ্যে ভারসাম্য রাখবে তা সমন্বয় করুন। ওজনগুলো স্বাভাবিকীকৃত — আপেক্ষিক ভারসাম্যই গুরুত্বপূর্ণ।"},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"খরচ"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"কম টোকেন খরচের সাশ্রয়ী মডেলকে অগ্রাধিকার দিন।"},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"নির্ভুলতা"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"জটিল যুক্তির জন্য শক্তিশালী মডেলকে অগ্রাধিকার দিন।"},com_assistants_auto_weight_speed:{english:"Speed",translated:"গতি"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"দ্রুত, কম-বিলম্বিত মডেলকে অগ্রাধিকার দিন।"},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"ডিফল্টে রিসেট করুন"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"ফাইল আপলোডের সময়সীমা শেষ হয়েছে। কয়েক মিনিট পরে আবার চেষ্টা করুন।"},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"কিছু ভুল হয়েছে। আমরা যে নির্দিষ্ট ত্রুটি বার্তাটি পেয়েছি তা হলো: আপনার অনুরোধ প্রক্রিয়া করার সময় একটি ত্রুটি ঘটেছে। সহকারীটি আর উপলব্ধ নেই। অনুগ্রহ করে অ্যাডমিনের সাথে যোগাযোগ করুন।"},com_ui_code:{english:"Code",translated:"কোড"},com_ui_assistant_share:{english:"Share",translated:"শেয়ার"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"লিংক কপি হয়েছে"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"এই সহকারীতে আপনার অ্যাক্সেস নেই"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"ক্লিপবোর্ডে লিংক কপি করতে ব্যর্থ হয়েছে"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"প্রিভিউ উপলব্ধ নয় — বিষয়বস্তু তৈরি সম্পন্ন হয়নি।"},com_ui_view_code:{english:"View code",translated:"কোড দেখুন"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"প্রিভিউ উপলব্ধ নয় — বিষয়বস্তু অকার্যকর।"},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"ফোন নম্বর"},com_assistants_pii_entity_email:{english:"Email Address",translated:"ইমেইল ঠিকানা"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"ক্রেডিট কার্ড"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"এসএসএন"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"আপলোড প্রত্যাশার চেয়ে বেশি সময় নিচ্ছে - পুনরায় চেষ্টা করা হচ্ছে ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"সংযোগ সমস্যা - পুনরায় চেষ্টা করা হচ্ছে ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"আপলোড ব্যর্থ হয়েছে - অনুগ্রহ করে আপনার সংযোগ পরীক্ষা করে আবার চেষ্টা করুন"},com_assistants_memory_enabled:{english:"Memory",translated:"মেমরি"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"এই সহকারীর জন্য মেমরি চালু আছে। সহকারী কথোপকথন জুড়ে তথ্য সংরক্ষণ ও মনে করতে পারে।"},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"এই সহকারীর জন্য মেমরি বন্ধ আছে। কথোপকথন জুড়ে কোনো তথ্য সংরক্ষণ বা মনে করা হবে না।"},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"মেমরি বন্ধ করার জন্য আপনার ব্যবসায়িক কারণ ব্যাখ্যা করুন (প্রয়োজনীয়)।"},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"মেমরি বন্ধ করার জন্য একটি কারণ দিন।"},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"আপনার টিমের জন্য মেমরি বন্ধ আছে। আপনি বিদ্যমান মেমরি দেখতে ও মুছতে পারবেন, কিন্তু নতুন মেমরি যোগ বা সম্পাদনা করতে পারবেন না।"},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"আপনার কোড চালানো হচ্ছে"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"জ্ঞানভান্ডারে অনুসন্ধান করা হচ্ছে"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"ভয়েস প্রক্রিয়াকরণ করা হচ্ছে"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"মেমরিতে সংরক্ষণ করা হচ্ছে"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"মেমরি থেকে সরানো হচ্ছে"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"ওয়েবে অনুসন্ধান সম্পন্ন হয়েছে"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"ওয়েবপেজ পর্যালোচনা সম্পন্ন হয়েছে"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"ছবি তৈরি হয়েছে"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"গণনা সম্পন্ন হয়েছে"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"আপনার কোড চালানো সম্পন্ন হয়েছে"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"জ্ঞানভান্ডারে অনুসন্ধান সম্পন্ন হয়েছে"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"ভয়েস ইনপুট প্রক্রিয়াকরণ সম্পন্ন হয়েছে"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"মেমরিতে সংরক্ষিত হয়েছে"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"মেমরি থেকে সরানো হয়েছে"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"সম্পন্ন হয়েছে: {0}"},com_ui_still_working:{english:"still working...",translated:"এখনও কাজ করছে..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} প্রস্তুত"},com_ui_file_ready_fallback:{english:"File is ready",translated:"ফাইল প্রস্তুত"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"{0} প্রক্রিয়া করা যায়নি"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"ফাইল প্রক্রিয়া করা যায়নি"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"{0} প্রক্রিয়া করা যায়নি। অনুগ্রহ করে ফাইলটি পুনরায় আপলোড করুন।"},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"ফাইল প্রক্রিয়া করা যায়নি। অনুগ্রহ করে ফাইলটি পুনরায় আপলোড করুন।"},com_ui_file_processing:{english:"Processing...",translated:"প্রক্রিয়াকরণ হচ্ছে..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"প্রক্রিয়াকরণ ব্যর্থ হয়েছে"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"ব্যর্থ - পুনরায় আপলোড প্রয়োজন"},com_ui_file_retry:{english:"Retry",translated:"পুনরায় চেষ্টা করুন"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"{0}সে পরে পুনরায় চেষ্টা করুন"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"ফাইল ইনডেক্সিং পুনরায় চেষ্টা করা হচ্ছে..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"পুনরায় চেষ্টা করার আগে অনুগ্রহ করে {0}সে অপেক্ষা করুন"},com_ui_file_retries_exhausted_reupload:{english:"Maximum retries reached. Please re-upload the file.",translated:"সর্বোচ্চ পুনরায় চেষ্টার সীমা পৌঁছেছে। অনুগ্রহ করে ফাইলটি পুনরায় আপলোড করুন।"},com_ui_assistant_file_upload_invalid_json:{english:"Invalid JSON file. File content does not match the expected format.",translated:"অবৈধ JSON ফাইল। ফাইলের বিষয়বস্তু প্রত্যাশিত বিন্যাসের সাথে মেলে না।"}},xv=Object.freeze(Object.defineProperty({__proto__:null,comparisons:wv,default:bv},Symbol.toStringTag,{value:"Module"})),Pv={com_error_moderation:"Zdá se, že obsah byl označen naším moderátorským systémem za nesoulad s komunitními pravidly. Nemůžeme pokračovat s tímto tématem. Pokud máte jiné otázky nebo témata, upravte svou zprávu nebo vytvořte novou konverzaci.",com_error_no_user_key:"Klíč nebyl nalezen. Poskytněte klíč a zkuste to znovu.",com_error_no_base_url:"Základní URL nebylo nalezeno. Poskytněte ho a zkuste to znovu.",com_error_invalid_user_key:"Poskytnut neplatný klíč. Poskytněte klíč a zkuste to znovu.",com_error_expired_user_key:"Poskytnutý klíč pro {0} vypršel {1}. Poskytněte klíč a zkuste to znovu.",com_error_token_balance_exceeded:"Dosáhli jste měsíčního limitu používání. Kontaktujte administrátora týmu pro pomoc.",com_error_token_balance_exceeded_license:"Dosáhli jste maximálního počtu tokenů pro vaši licenci. Kontaktujte prodej na {0} pro další pomoc.",com_error_token_balance_percent_used:"Použili jste {0}% přidělených tokenů. Kontaktujte {1} pro další pomoc.",com_error_license_expired:"Vaše licence není dostupná. Kontaktujte podporu pro další pomoc.",com_restricted_invalid_ip_format:"IPv6 adresy nejsou podporovány. Použijte připojení IPv4 nebo kontaktujte podporu pro další pomoc.",com_error_tool_run:"Při zpracování vaší žádosti došlo k chybě. Zkuste to znovu.",com_files_upload_duplicate_success:"Soubor {0} byl již úspěšně nahrán",com_files_no_results:"Žádné výsledky.",com_files_filter:"Hledat soubory podle názvu",com_files_number_selected:"{0} z {1} souboru(ů) vybráno",com_sidepanel_select_assistant:"Vyberte asistenta",com_sidepanel_parameters:"Parametry",com_ui_create_assistant:"Vytvořit asistenta",com_ui_create_assistant_permission_needed:"Uživatel potřebuje oprávnění k vytvoření asistenta",com_sidepanel_assistant_builder:"Asistenti",com_sidepanel_attach_files:"Správce souborů",com_sidepanel_manage_files:"Spravovat soubory",com_assistants_shared_with_consent_title:"Souhlas",com_assistants_shared_with_consent_description_1:"Chystáte se sdílet tohoto asistenta s ostatními členy týmu. Před sdílením asistenta si prosím přečtěte klíčové body níže:",com_assistants_shared_with_consent_description_2:"Pokračováním potvrzujete, že rozumíte a přijímáte tyto podmínky.",com_assistants_shared_with_consent_bullet_1:"Sdílený asistent by neměl obsahovat citlivá nebo důvěrná data.",com_assistants_shared_with_consent_bullet_2:"Sdílení asistentů nesmí zpracovávat citlivá nebo důvěrná data.",com_assistants_shared_with_consent_bullet_3:"Sdílení znamená odpovědnost za obsah a přístup.",com_assistants_shared_with_consent_bullet_4:"Doporučuje se sdílet s konkrétním týmem nebo uzavřenou skupinou místo s každým.",com_button_accept:"Přijmout",com_button_decline:"Odmítnout",com_assistants_capabilities:"Znalostní báze",com_assistants_file_search:"Vyhledávání souborů",com_assistants_file_search_description:"Přidejte sem soubory, které váš asistent potřebuje pro vyhledávání při odpovídání na otázky v chatu.",com_assistants_file_search_supported_label:"Podporováno:",com_assistants_file_search_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",com_assistants_file_search_tips_label:"Tip:",com_assistants_file_search_tips:"Požádejte svého asistenta, aby použil 'Nástroj pro vyhledávání souborů' při každé odpovědi uživatelům.",com_assistants_file_search_info:"Připojení vektorových úložišť pro vyhledávání souborů zatím není podporováno. Můžete je připojit z Provider Playground nebo připojit soubory k zprávám pro vyhledávání souborů na základě vlákna.",com_assistants_file_search_fetch_error:"Při načítání souborů z vektorových úložišť došlo k chybě.",com_assistants_knowledge:"Znalostní báze",com