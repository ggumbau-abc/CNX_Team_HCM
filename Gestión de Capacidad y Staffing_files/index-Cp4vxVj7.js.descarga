ror:{english:"There was an error uploading your file",translated:"Er was een fout bij het uploaden van uw bestand"},com_ui_thinking:{english:"Thinking",translated:"Denken"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Uw verzoek analyseren"},com_ui_processing:{english:"Putting it together",translated:"Verwerken"},com_ui_working_on_it:{english:"Almost ready",translated:"Bezig"},com_user_message:{english:"You",translated:"U"},com_ui_read_aloud:{english:"Read aloud",translated:"Lees voor"},com_ui_copied:{english:"Copied!",translated:"Gekopieerd!"},com_ui_copy_code:{english:"Copy code",translated:"Kopieer code"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Noem een endpoint, assistent of preset om er snel naar over te schakelen"},com_ui_nothing_found:{english:"Nothing found",translated:"Niets gevonden"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Ga naar gesprek"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Niet-ondersteund importtype"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Onbekend"},com_ui_result:{english:"Result",translated:"Resultaat"},com_ui_image_gen:{english:"Image Gen",translated:"Afbeelding Gen"},com_ui_assistant:{english:"Assistant",translated:"Assistent"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Assistent succesvol verwijderd"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Er is een fout opgetreden bij het verwijderen van de assistent"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Dubbel bestand gedetecteerd."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Er is een fout opgetreden bij het uploaden van het bestand."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Er is een fout opgetreden bij het uploaden van het bestand: Endpoint is niet gedefinieerd"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Lege bestanden zijn niet toegestaan."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"U kunt slechts {0} bestanden tegelijk uploaden."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"U kunt slechts {0} bestanden in deze sectie uploaden."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"De uploadlimiet is bereikt voor {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Kan bestandstype niet bepalen voor: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Bestandstype niet ondersteund. Upload een ondersteund bestandsformaat."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Afbeelding laden mislukt"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Momenteel worden alleen JPEG-, JPG-, PNG- en WEBP-bestanden ondersteund."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Bestandsgrootte overschrijdt {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"De totale grootte van de bestanden mag niet meer dan {0} MB zijn."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Er is een fout opgetreden bij het valideren van het bestand."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Er is een fout opgetreden bij het verwerken van het bestand."},com_ui_assistants:{english:"Assistants",translated:"Assistenten"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Studio Assistentie"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Kennis"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Niet-gecategoriseerd"},com_ui_attachment:{english:"Attachment",translated:"Bijlage"},com_ui_assistants_output:{english:"Assistants Output",translated:"Uitvoer Assistenten"},com_ui_create:{english:"Create",translated:"Creëer"},com_ui_copy_link:{english:"Copy link",translated:"Kopieer link"},com_ui_update_link:{english:"Update link",translated:"Werk link bij"},com_ui_create_link:{english:"Create link",translated:"Creëer link"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Weet u zeker dat u deze Assistent wilt verwijderen? Dit kan niet ongedaan worden gemaakt."},com_ui_preview:{english:"Preview",translated:"Voorbeeld"},com_ui_upload:{english:"Upload",translated:"Upload"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Het uploaden van "{0}" duurt langer dan verwacht. Wacht alstublieft terwijl het bestand wordt geïndexeerd voor ophalen.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Privacybeleid"},com_ui_terms_of_service:{english:"Terms of service",translated:"Servicevoorwaarden"},com_ui_use_micrphone:{english:"Use microphone",translated:"Gebruik microfoon"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Kan niet meer waarden verwijderen, minimaal {0} zijn vereist."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Maximaal toegestaan aantal is {0}, gebruik de nieuwste waarden."},com_endpoint_message:{english:"Message",translated:"Bericht"},com_endpoint_messages:{english:"Messages",translated:"Berichten"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Bewerk uw bericht of Genereer opnieuw."},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Max context tokens"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Het maximale aantal tokens dat voor context kan worden gebruikt. Gebruik dit om te bepalen hoeveel tokens per verzoek worden verzonden.
  Indien niet gespecificeerd, worden systeemstandaarden gebruikt op basis van de contextgrootte van bekende modellen. Hogere waarden kunnen fouten en/of hogere tokenkosten veroorzaken.`},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Overschrijft de instructies van de assistent. Handig voor het aanpassen van gedrag per uitvoering."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Stel extra instructies of context in bovenop de hoofd-instructies van de assistent. Genegeerd als leeg."},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Extra instructies"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Instructies overschrijven"},com_endpoint_stop:{english:"Stop Sequences",translated:"Stopreeksen"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Waarden scheiden door `Enter` te drukken"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Optioneel `max_tokens` veld, dat het maximale aantal tokens vertegenwoordigt dat in de chat kan worden gegenereerd.\n    \n    De totale lengte van invoertokens en gegenereerde tokens is beperkt door de contextlengte van de modellen. U kunt fouten ervaren als dit aantal de max context tokens overschrijdt."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Stuur alle eerder bijgevoegde bestanden opnieuw. Let op: dit verhoogt de tokenkosten en u kunt fouten ervaren bij veel bijlagen."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'De resolutie voor Vision-verzoeken. "Laag" is goedkoper en sneller, "Hoog" is gedetailleerder en duurder, en "Auto" kiest automatisch tussen de twee op basis van de beeldresolutie.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Tot 4 reeksen waar de API stopt met het genereren van verdere tokens."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Bestanden opnieuw verzenden"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Beelddetail"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Weet u zeker dat u deze preset wilt verwijderen?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Preset geïmporteerd!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Er is een fout opgetreden bij het importeren van uw preset. Probeer het opnieuw."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Er is een fout opgetreden bij het opslaan van uw preset. Probeer het opnieuw."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Er is een fout opgetreden bij het verwijderen van uw preset. Probeer het opnieuw."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"is niet langer de standaard preset."},com_endpoint_preset_default_item:{english:"Default:",translated:"Standaard:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Geen standaard preset actief."},com_endpoint_preset_title:{english:"Preset",translated:"Preset"},com_endpoint_preset_saved:{english:"Saved!",translated:"Opgeslagen!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"is nu de standaard preset."},com_endpoint_preset_selected_title:{english:"Active!",translated:"Actief!"},com_endpoint_export_share:{english:"Export/Share",translated:"Exporteren/Delen"},com_endpoint_assistant:{english:"Assistant",translated:"Assistent"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Gebruik Actieve Assistent"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Selecteer een Assistent en start een nieuw gesprek"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Stel uw Sleutel in het Kopmenu in om te chatten."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Selecteer een Assistent"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Welkom bij iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Tekst naar Spraak"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Automatisch Laatste Bericht Afspelen"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Spraak naar Tekst"},com_nav_profile_picture:{english:"Profile Picture",translated:"Profielfoto"},com_nav_change_picture:{english:"Change picture",translated:"Foto wijzigen"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Agentinstellingen Weergeven"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Voltooiingsinstellingen Weergeven"},com_hide_examples:{english:"Hide Examples",translated:"Voorbeelden Verbergen"},com_show_examples:{english:"Show Examples",translated:"Voorbeelden Weergeven"},com_nav_user_name_display:{english:"Display username in messages",translated:"Gebruikersnaam weergeven in berichten"},com_nav_user_guide:{english:"User Guide",translated:"Gebruikershandleiding"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Automatisch tekst verzenden (na 3 sec)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Fout bij afspelen audio: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Fout bij verwerken audio: {0}"},com_nav_engine:{english:"Engine",translated:"Motor"},com_nav_browser:{english:"Browser",translated:"Browser"},com_nav_external:{english:"External",translated:"Extern"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Verwijder cache-opslag"},com_nav_voice_select:{english:"Voice",translated:"Stem"},com_nav_setting_speech:{english:"Speech",translated:"Spraak"},com_nav_language:{english:"Language",translated:"Taal"},com_nav_lang_auto:{english:"Auto detect",translated:"Automatisch detecteren"},com_page_not_found:{english:"Page not found",translated:"Pagina niet gevonden"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Er is iets misgegaan"},com_unauthorized_access:{english:"Unauthorized access",translated:"Ongeautoriseerde toegang"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Ongeautoriseerde toegang. Toegang is beperkt tot specifieke domeinen."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Uw account is tijdelijk geblokkeerd vanwege schendingen van onze service"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"U heeft beperkte toegang tot de app buiten het netwerk!"},com_support_ticket_text:{english:"Support Ticket",translated:"Ondersteuningsticket"},com_help_dialog_Header:{english:"Need assistance?",translated:"Hulp nodig?"},com_help_dialog_text_1_1:{english:"Click",translated:"Klik"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"voor gedetailleerde instructies"},com_help_dialog_text_here:{english:"here",translated:"hier"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Voor problemen, vul een"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Voor problemen, neem contact op met"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Vind de stappen"},com_status_ind_none:{english:"Operational",translated:"Operationeel"},com_status_ind_minor:{english:"Minor Issues",translated:"Kleine problemen"},com_status_ind_major:{english:"Major Issues",translated:"Grote problemen"},com_status_ind_critical:{english:"Critical",translated:"Kritiek"},com_status_ind_error:{english:"Error Fetching",translated:"Fout bij ophalen"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Let op dat wanneer u een chat verlaat of een nieuwe chat start, u uw gespreksgeschiedenis verliest."},com_forbidden_access:{english:"Forbidden access",translated:"Verboden toegang"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Aanvaardbaar gebruiksbeleid"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Privacybeleid"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Abonnementsvoorwaarden"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Voordat u iX Hello gebruikt, kunt u Concentrix's bekijken "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Door in te schrijven en/of in te loggen, ga je akkoord met de bovenstaande voorwaarden."},com_login_page_and:{english:"and ",translated:"en "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Geen vastgezette assistenten"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Vastgezette assistenten"},com_ui_loading:{english:"Loading...",translated:"Laden..."},com_ui_unpin:{english:"Unpin",translated:"Losmaken"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Assistent succesvol losgemaakt"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Fout bij losmaken assistent"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Assistent succesvol vastgezet"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Fout bij vastzetten/losmaken assistent"},com_ui_pin:{english:"Pin",translated:"Vastzetten"},come_create_assistant:{english:"Create Assistant",translated:"Assistent maken"},come_edit_assistant:{english:"Edit Assistant",translated:"Assistent bewerken"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Weet je zeker dat je wilt doorgaan? Dit zal resulteren in het verlies van alle wijzigingen die je hebt gemaakt aan de assistent die je momenteel aan het bewerken of maken bent. Deze actie kan niet ongedaan worden gemaakt."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Assistent met id {0} is niet gevonden."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Browser ondersteunt SpeechRecognition niet"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Microfoon toestemming niet verleend"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Fout bij starten opname: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder neemt niet op"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder wordt niet ondersteund in deze browser"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Je bericht bevat persoonlijke informatie en kon niet worden verzonden. Verwijder persoonlijke informatie."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Hernoemen van gesprek mislukt"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Je hebt nog {0} van je toegewezen tokens over."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello kan fouten maken. Controleer alle outputs op kwaliteit en nauwkeurigheid. Alle inputs worden gelogd voor naleving."},com_ui_assistant_group_by:{english:"Group by",translated:"Groeperen op"},com_ui_assistant_category:{english:"Category",translated:"Categorie"},com_ui_assistant_team:{english:"Team",translated:"Team"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Engineering"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Intelligentie"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Operaties"},com_ui_assistant_sales:{english:"Sales",translated:"Verkoop"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategie"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Studio Assistenten"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Upload een avatar afbeelding (PNG of JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Zoek Online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Blader Website"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Genereer Afbeeldingen"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Bereken Wiskunde"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Standaard Hulpmiddel"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Het uploaden van het bestand duurt langer dan verwacht. Probeer het opnieuw."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Fout bij vastpinnen van assistent"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Er is een fout opgetreden bij het verwijderen van de gedeelde link"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"DAN Sjabloon"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Geen standaard preset actief."},com_ui_drag_drop_title:{english:"Add anything",translated:"Voeg iets toe"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Sleep een bestand hierheen om het aan het gesprek toe te voegen"},com_ui_analyzing:{english:"Analyzing",translated:"Analyseren"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Analyse voltooid"},com_ui_warning:{english:"Warning",translated:"Waarschuwing"},com_ui_proceed:{english:"Proceed",translated:"Doorgaan"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Bestanden geüpload naar de assistent worden alleen voor conversatiedoeleinden gebruikt. Gebruikers kunnen toegang krijgen tot de inhoud van deze bestanden door relevante vragen te stellen, maar directe download van de bestanden is niet toegestaan."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Stel een aangepaste naam in voor deze preset"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Stel voorbeeldinvoer in. Voorbeeld wordt genegeerd als het leeg is."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Stel voorbeelduitvoer in. Voorbeeld wordt genegeerd als het leeg is."},com_nav_export_select_type:{english:"Select a file type",translated:"Selecteer een bestandstype"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"screenshot (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"tekst (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Geen reactie ontvangen. Probeer uw bericht opnieuw te verzenden. Als het probleem aanhoudt na het herladen van de pagina en opnieuw proberen, neem dan contact op met de ondersteuning."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Terug naar chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Guardrail Moderatie"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Guardrail moderatie is ingeschakeld voor deze assistent. Inhoud wordt gecontroleerd op moderatiebeleid."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Het uitschakelen van guardrail moderatie verwijdert inhoudsmoderatiecontroles voor deze assistent. U bent verantwoordelijk voor naleving van de inhoudsbeleid van uw organisatie. Activiteit wordt volledig gelogd en gemonitord."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Geef uw zakelijke rechtvaardiging voor het uitschakelen van guardrail moderatie (verplicht)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Geef een rechtvaardiging voor het uitschakelen van guardrail moderatie."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Sta gebruikers toe om model te wijzigen in chat"},com_ui_feedback_good:{english:"Good response",translated:"Goed antwoord"},com_ui_feedback_bad:{english:"Poor response",translated:"Slecht antwoord"},com_ui_feedback_comments:{english:"Comments",translated:"Opmerkingen"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Opmerkingen (optioneel)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Vertel ons meer over uw ervaring..."},com_ui_feedback_submit:{english:"Submit",translated:"Verzenden"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"We konden uw feedback niet verzenden"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Onjuist"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Niet relevant"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Verouderd"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Niet genoeg details"},com_ui_feedback_reason_other:{english:"Other",translated:"Overig"},com_ui_model_recommended:{english:"Recommended",translated:"Aanbevolen"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Verouderd — update a.u.b."},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Dit model wordt niet langer ondersteund. Selecteer een actueel model."},com_nav_setting_memory:{english:"Memory",translated:"Geheugen"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Beheer de persoonlijke feiten die de assistent onthoudt in uw gesprekken."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Voeg een nieuw geheugen toe…"},com_nav_memory_add_button:{english:"Add memory",translated:"Geheugen toevoegen"},com_nav_memory_category:{english:"Category",translated:"Categorie"},com_nav_memory_category_preference:{english:"Preference",translated:"Voorkeur"},com_nav_memory_category_identity:{english:"Identity",translated:"Identiteit"},com_nav_memory_category_context:{english:"Context",translated:"Context"},com_nav_memory_category_project:{english:"Project",translated:"Project"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Nog geen herinneringen"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Herinneringen die u opslaat, verschijnen hier en helpen toekomstige gesprekken te personaliseren."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Kon herinneringen niet laden. Probeer het opnieuw."},com_nav_memory_retry:{english:"Retry",translated:"Opnieuw proberen"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Kon geheugen niet toevoegen. Probeer het opnieuw."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Kon geheugen niet bijwerken. Probeer het opnieuw."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Kon geheugen niet verwijderen. Probeer het opnieuw."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Dit geheugen verwijderen?"},com_nav_memory_delete_button:{english:"Delete",translated:"Verwijderen"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Geheugen bewerken"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Geheugen verwijderen"},com_nav_memory_save:{english:"Save",translated:"Opslaan"},com_nav_memory_cancel:{english:"Cancel",translated:"Annuleren"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Opgeslagen {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — nieuwste GPT-5-denkmodel met geavanceerde intelligentie."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — compacte en kostenefficiënte GPT-5.4 variant."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — nieuwste GPT-5 generatie model."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Nieuwste Opus — grensverleggende intelligentie voor codeeragenten en bedrijfsprocessen."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Nieuwste Opus — grensverleggende intelligentie voor codeeragenten en bedrijfsprocessen."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Verbeterde Sonnet met verbeterd redeneren en instructievolging."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Anthropic's krachtigste model voor complexe, meerstaps taken."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Gebalanceerde intelligentie en snelheid voor een breed scala aan taken."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Snelste en meest compacte Claude model — ideaal voor taken met hoge doorvoer."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — verbeterde redenering en multimodale mogelijkheden."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"OpenAI's vlaggenschip van de volgende generatie model."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"Lichtgewicht GPT-5 — efficiënt en snel voor dagelijkse taken."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — verbeterde instructievolging en redenering."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"Compacte GPT-4.1 — sneller en goedkoper voor eenvoudigere taken."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Meest capabele GPT-4 model, geoptimaliseerd voor snelheid en kosten."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"Lichtgewicht GPT-4o — sneller en goedkoper voor eenvoudigere taken."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Preview) — meest capabele Gemini-model met 1M context."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Preview) — snel en efficiënt met 1M context."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — lichtgewichtmodel met lage latentie en 1M context."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Interne stem-geoptimaliseerde assistent model."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto selecteert het beste model voor uw verzoek op basis van capaciteit en prestaties."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Binnenkort beschikbaar"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Voorkeuren voor automatisch routeren"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Stem af hoe de Auto-router afwegingen in balans brengt bij het kiezen van een model voor elke beurt. Wegingen worden genormaliseerd — de relatieve balans is wat telt."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Kosten"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Geef de voorkeur aan goedkopere modellen met lagere tokenkosten."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Nauwkeurigheid"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Geef de voorkeur aan sterkere modellen voor complexe redenering."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Snelheid"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Geef de voorkeur aan snellere modellen met lagere latentie."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Standaardwaarden herstellen"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Time-out bij uploaden van bestand. Probeer het over een paar minuten opnieuw."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Er is iets misgegaan. Hier is de specifieke foutmelding die we hebben ontvangen: Er is een fout opgetreden tijdens het verwerken van je verzoek. De assistent is niet langer beschikbaar. Neem contact op met de beheerder."},com_ui_code:{english:"Code",translated:"Code"},com_ui_assistant_share:{english:"Share",translated:"Delen"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Link gekopieerd"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Je hebt geen toegang tot deze assistent"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Kopiëren van link naar klembord mislukt"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Preview niet beschikbaar — inhoudsgeneratie niet voltooid."},com_ui_view_code:{english:"View code",translated:"Code bekijken"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Voorbeeld niet beschikbaar — inhoud is ongeldig."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Telefoonnummer"},com_assistants_pii_entity_email:{english:"Email Address",translated:"E-mailadres"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Creditcard"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"BSN"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Upload duurt langer dan verwacht - opnieuw proberen ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Verbindingsprobleem - opnieuw proberen ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Upload mislukt - controleer je verbinding en probeer het opnieuw"},com_assistants_memory_enabled:{english:"Memory",translated:"Geheugen"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Geheugen is ingeschakeld voor deze assistent. De assistent kan feiten opslaan en oproepen tussen gesprekken."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Geheugen is uitgeschakeld voor deze assistent. Er worden geen feiten opgeslagen of opgeroepen tussen gesprekken."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Licht uw zakelijke rechtvaardiging voor het uitschakelen van geheugen toe (verplicht)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Geef een rechtvaardiging voor het uitschakelen van geheugen."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Geheugen is uitgeschakeld voor uw team. U kunt bestaande herinneringen bekijken en verwijderen, maar geen nieuwe toevoegen of bewerken."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Uw code uitvoeren"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"De kennisbank doorzoeken"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Spraak verwerken"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"Opslaan in geheugen"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"Verwijderen uit geheugen"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Zoeken op het web voltooid"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Beoordelen van de