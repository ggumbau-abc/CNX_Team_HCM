eral",translated:"ทั่วไป"},com_nav_setting_speech:{english:"Speech",translated:"เสียงพูด"},com_nav_language:{english:"Language",translated:"ภาษา"},com_nav_lang_auto:{english:"Auto detect",translated:"ตรวจจับอัตโนมัติ"},com_page_not_found:{english:"Page not found",translated:"ไม่พบหน้า"},com_something_went_wrong_error:{english:"Something went wrong",translated:"เกิดข้อผิดพลาด"},com_unauthorized_access:{english:"Unauthorized access",translated:"การเข้าถึงไม่ได้รับอนุญาต"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"การเข้าถึงไม่ได้รับอนุญาต เข้าถึงได้เฉพาะโดเมนที่กำหนด"},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"บัญชีของคุณถูกระงับชั่วคราวเนื่องจากละเมิดบริการของเรา"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"คุณถูกจำกัดการเข้าถึงแอปนอกเครือข่าย!"},com_support_ticket_text:{english:"Support Ticket",translated:"ตั๋วสนับสนุน"},com_help_dialog_Header:{english:"Need assistance?",translated:"ต้องการความช่วยเหลือ?"},com_help_dialog_text_1_1:{english:"Click",translated:"คลิก"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"สำหรับคำแนะนำโดยละเอียด"},com_help_dialog_text_here:{english:"here",translated:"ที่นี่"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"หากมีปัญหา โปรดกรอก"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"หากมีปัญหา โปรดติดต่อ"},com_help_dialog_text_ticket:{english:"ticket",translated:"ตั๋ว"},com_help_dialog_text_3:{english:"Find the steps",translated:"ค้นหาขั้นตอน"},com_status_ind_none:{english:"Operational",translated:"ปกติ"},com_status_ind_minor:{english:"Minor Issues",translated:"ปัญหาเล็กน้อย"},com_status_ind_major:{english:"Major Issues",translated:"ปัญหาสำคัญ"},com_status_ind_critical:{english:"Critical",translated:"วิกฤติ"},com_status_ind_error:{english:"Error Fetching",translated:"ข้อผิดพลาดในการดึงข้อมูล"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"โปรดทราบว่าเมื่อคุณออกจากการสนทนาหรือเริ่มการสนทนาใหม่ คุณจะสูญเสียประวัติการสนทนา"},com_forbidden_access:{english:"Forbidden access",translated:"การเข้าถึงถูกห้าม"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"นโยบายการใช้งานที่ยอมรับได้"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"นโยบายความเป็นส่วนตัว"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"ข้อตกลงการสมัครสมาชิก"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"ก่อนใช้ iX Hello คุณสามารถตรวจสอบ "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"โดยการสมัครและ/หรือเข้าสู่ระบบ คุณยอมรับเงื่อนไขข้างต้น"},com_login_page_and:{english:"and ",translated:"และ "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"ไม่มีผู้ช่วยที่ปักหมุด"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"ผู้ช่วยที่ปักหมุด"},com_ui_loading:{english:"Loading...",translated:"กำลังโหลด..."},com_ui_unpin:{english:"Unpin",translated:"เลิกปักหมุด"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"เลิกปักหมุดผู้ช่วยสำเร็จ"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"เกิดข้อผิดพลาดในการยกเลิกปักหมุดผู้ช่วย"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"ปักหมุดผู้ช่วยสำเร็จ"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"เกิดข้อผิดพลาดในการปักหมุด/ยกเลิกปักหมุดผู้ช่วย"},com_ui_pin:{english:"Pin",translated:"ปักหมุด"},come_create_assistant:{english:"Create Assistant",translated:"สร้างผู้ช่วย"},come_edit_assistant:{english:"Edit Assistant",translated:"แก้ไขผู้ช่วย"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"คุณแน่ใจหรือไม่ว่าต้องการดำเนินการต่อ? การดำเนินการนี้จะทำให้การเปลี่ยนแปลงใดๆ ที่ทำกับผู้ช่วยที่คุณกำลังแก้ไขหรือสร้างสูญหาย การกระทำนี้ไม่สามารถย้อนกลับได้"},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"ไม่พบผู้ช่วยที่มีรหัส {0}"},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"เบราว์เซอร์ไม่รองรับการรู้จำเสียง"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"ไม่ได้รับอนุญาตให้ใช้ไมโครโฟน"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"เกิดข้อผิดพลาดในการเริ่มบันทึก: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder ไม่ได้บันทึก"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"เบราว์เซอร์นี้ไม่รองรับ MediaRecorder"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"ข้อความของคุณมีข้อมูลส่วนตัวและไม่สามารถส่งได้ กรุณาลบข้อมูลส่วนตัวออก"},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"เปลี่ยนชื่อการสนทนาไม่สำเร็จ"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"คุณมีโทเค็นที่จัดสรรไว้เหลือ {0}"},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello อาจมีข้อผิดพลาด กรุณาตรวจสอบผลลัพธ์ทั้งหมดเพื่อคุณภาพและความถูกต้อง ข้อมูลที่ป้อนทั้งหมดจะถูกบันทึกเพื่อการปฏิบัติตามกฎระเบียบ"},com_ui_assistant_group_by:{english:"Group by",translated:"จัดกลุ่มตาม"},com_ui_assistant_category:{english:"Category",translated:"หมวดหมู่"},com_ui_assistant_team:{english:"Team",translated:"ทีม"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"วิศวกรรม"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"ปัญญา"},com_ui_assistant_marketing:{english:"Marketing",translated:"การตลาด"},com_ui_assistant_operations:{english:"Operations",translated:"การดำเนินงาน"},com_ui_assistant_sales:{english:"Sales",translated:"การขาย"},com_ui_assistant_strategy:{english:"Strategy",translated:"กลยุทธ์"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"ผู้ช่วยสตูดิโอ"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"อัปโหลดภาพอวาตาร์ (PNG หรือ JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"ค้นหาออนไลน์"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"เรียกดูเว็บไซต์"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"สร้างภาพ"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"คำนวณคณิตศาสตร์"},com_ui_assistant_tools_default:{english:"Running tool",translated:"เครื่องมือเริ่มต้น"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"การอัปโหลดไฟล์ใช้เวลานานกว่าที่คาดไว้ กรุณาลองอีกครั้ง"},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"เกิดข้อผิดพลาดในการปักหมุดผู้ช่วย"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"เกิดข้อผิดพลาดในการลบลิงก์ที่แชร์"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"แม่แบบ DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"ไม่มีการตั้งค่าล่วงหน้าเริ่มต้น"},com_ui_drag_drop_title:{english:"Add anything",translated:"เพิ่มสิ่งใดก็ได้"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"วางไฟล์ใด ๆ ที่นี่เพื่อเพิ่มในการสนทนา"},com_ui_analyzing:{english:"Analyzing",translated:"กำลังวิเคราะห์"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"วิเคราะห์เสร็จสิ้น"},com_ui_warning:{english:"Warning",translated:"คำเตือน"},com_ui_proceed:{english:"Proceed",translated:"ดำเนินการต่อ"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"ไฟล์ที่อัปโหลดไปยังผู้ช่วยใช้เพื่อการสนทนาเท่านั้น ผู้ใช้สามารถเข้าถึงเนื้อหาของไฟล์เหล่านี้โดยการถามคำถามที่เกี่ยวข้อง แต่ไม่สามารถดาวน์โหลดไฟล์โดยตรงได้"},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"ตั้งชื่อกำหนดเองสำหรับการตั้งค่านี้"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"ตั้งค่าตัวอย่างอินพุต ตัวอย่างจะถูกละเว้นหากว่างเปล่า"},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"ตั้งค่าตัวอย่างเอาต์พุต ตัวอย่างจะถูกละเว้นหากว่างเปล่า"},com_nav_export_select_type:{english:"Select a file type",translated:"เลือกประเภทไฟล์"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"ภาพหน้าจอ (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"ข้อความ (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"มาร์กดาวน์ (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"ไม่ได้รับการตอบกลับ กรุณาลองส่งข้อความของคุณอีกครั้ง หากปัญหายังคงอยู่หลังจากโหลดหน้าใหม่และลองใหม่ กรุณาติดต่อฝ่ายสนับสนุน"},com_ui_back_to_chat:{english:"Back to Chat",translated:"กลับไปที่แชท"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"การควบคุม Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"เปิดใช้งานการควบคุม Guardrail สำหรับผู้ช่วยนี้แล้ว เนื้อหาจะถูกตรวจสอบตามนโยบายการควบคุม"},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"การปิดการควบคุม Guardrail จะยกเลิกการตรวจสอบเนื้อหาสำหรับผู้ช่วยนี้ คุณมีหน้าที่รับผิดชอบในการปฏิบัติตามนโยบายเนื้อหาขององค์กร กิจกรรมจะถูกบันทึกและตรวจสอบอย่างเต็มที่"},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"โปรดอธิบายเหตุผลทางธุรกิจของคุณในการปิดการควบคุม Guardrail (จำเป็น)"},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"โปรดให้เหตุผลในการปิดการควบคุม Guardrail"},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"อนุญาตให้ผู้ใช้เปลี่ยนโมเดลในการแชท"},com_ui_feedback_good:{english:"Good response",translated:"คำตอบที่ดี"},com_ui_feedback_bad:{english:"Poor response",translated:"คำตอบที่ไม่ดี"},com_ui_feedback_comments:{english:"Comments",translated:"ความคิดเห็น"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"ความคิดเห็น (ไม่บังคับ)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"บอกเราเพิ่มเติมเกี่ยวกับประสบการณ์ของคุณ..."},com_ui_feedback_submit:{english:"Submit",translated:"ส่ง"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"เราไม่สามารถส่งความคิดเห็นของคุณได้"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"ไม่ถูกต้อง"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"ไม่เกี่ยวข้อง"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"ล้าสมัย"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"รายละเอียดไม่เพียงพอ"},com_ui_feedback_reason_other:{english:"Other",translated:"อื่นๆ"},com_ui_model_recommended:{english:"Recommended",translated:"แนะนำ"},com_ui_model_legacy:{english:"Legacy — please update",translated:"รุ่นเก่า — โปรดอัปเดต"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"โมเดลนี้ไม่รองรับแล้ว โปรดเลือกโมเดลปัจจุบัน"},com_nav_setting_memory:{english:"Memory",translated:"หน่วยความจำ"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"จัดการข้อเท็จจริงส่วนตัวที่ผู้ช่วยจำได้จากการสนทนาของคุณ"},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"เพิ่มหน่วยความจำใหม่…"},com_nav_memory_add_button:{english:"Add memory",translated:"เพิ่มหน่วยความจำ"},com_nav_memory_category:{english:"Category",translated:"หมวดหมู่"},com_nav_memory_category_preference:{english:"Preference",translated:"ความชอบ"},com_nav_memory_category_identity:{english:"Identity",translated:"อัตลักษณ์"},com_nav_memory_category_context:{english:"Context",translated:"บริบท"},com_nav_memory_category_project:{english:"Project",translated:"โครงการ"},com_nav_memory_empty_title:{english:"No memories yet",translated:"ยังไม่มีหน่วยความจำ"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"หน่วยความจำที่คุณบันทึกจะปรากฏที่นี่และช่วยปรับแต่งการสนทนาในอนาคต"},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"ไม่สามารถโหลดหน่วยความจำได้ กรุณาลองใหม่"},com_nav_memory_retry:{english:"Retry",translated:"ลองใหม่"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"ไม่สามารถเพิ่มหน่วยความจำได้ กรุณาลองใหม่"},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"ไม่สามารถอัปเดตหน่วยความจำได้ กรุณาลองใหม่"},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"ไม่สามารถลบหน่วยความจำได้ กรุณาลองใหม่"},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"ลบหน่วยความจำนี้?"},com_nav_memory_delete_button:{english:"Delete",translated:"ลบ"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"แก้ไขหน่วยความจำ"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"ลบหน่วยความจำ"},com_nav_memory_save:{english:"Save",translated:"บันทึก"},com_nav_memory_cancel:{english:"Cancel",translated:"ยกเลิก"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"บันทึกเมื่อ {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — โมเดลการคิดล่าสุดของ GPT-5 พร้อมปัญญาประดิษฐ์ขั้นแนวหน้า"},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — รุ่นย่อและคุ้มค่าของ GPT-5.4"},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — รุ่นล่าสุดของ GPT-5"},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus ล่าสุด — ปัญญาล้ำหน้าสำหรับเอเจนต์การเขียนโค้ดและเวิร์กโฟลว์องค์กร"},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus ล่าสุด — ปัญญาล้ำหน้าสำหรับเอเจนต์การเขียนโค้ดและเวิร์กโฟลว์องค์กร"},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet ที่ปรับปรุงใหม่พร้อมการให้เหตุผลและการปฏิบัติตามคำสั่งที่ดีขึ้น"},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"รุ่นที่ทรงพลังที่สุดของ Anthropic สำหรับงานซับซ้อนหลายขั้นตอน"},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"ปัญญาที่สมดุลและรวดเร็วสำหรับงานหลากหลาย"},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Claude รุ่นที่เร็วและเล็กที่สุด — เหมาะสำหรับงานที่ต้องการความเร็วสูง"},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — การให้เหตุผลและความสามารถมัลติโหมดที่ปรับปรุง"},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"รุ่นเรือธงรุ่นใหม่ของ OpenAI"},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 น้ำหนักเบา — มีประสิทธิภาพและรวดเร็วสำหรับงานประจำวัน"},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — การปฏิบัติตามคำสั่งและการให้เหตุผลที่ดีขึ้น"},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 ขนาดย่อ — เร็วและถูกกว่าสำหรับงานที่ง่ายขึ้น"},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"GPT-4 รุ่นที่มีความสามารถสูงสุด ปรับให้เหมาะสมสำหรับความเร็วและค่าใช้จ่าย"},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o น้ำหนักเบา — เร็วและถูกกว่าสำหรับงานที่ง่ายขึ้น"},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (ตัวอย่าง) — โมเดล Gemini ที่มีความสามารถสูงสุดพร้อมบริบท 1M"},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (ตัวอย่าง) — รวดเร็วและมีประสิทธิภาพพร้อมบริบท 1M"},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — โมเดลน้ำหนักเบาและเวลาตอบสนองต่ำพร้อมบริบท 1M"},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"รุ่นผู้ช่วยที่ปรับให้เหมาะสมสำหรับเสียงภายใน"},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto เลือกโมเดลที่ดีที่สุดสำหรับคำขอของคุณตามความจุและประสิทธิภาพ"},com_ui_model_coming_soon:{english:"Coming Soon",translated:"เร็วๆ นี้"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"การตั้งค่าการกำหนดเส้นทางอัตโนมัติ"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"ปรับวิธีที่ตัวกำหนดเส้นทางอัตโนมัติถ่วงดุลปัจจัยต่าง ๆ เมื่อเลือกโมเดลสำหรับแต่ละรอบ ค่าน้ำหนักจะถูกปรับให้เป็นมาตรฐาน — สิ่งสำคัญคือสัดส่วนระหว่างกัน"},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"ค่าใช้จ่าย"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"ให้ความสำคัญกับโมเดลที่มีต้นทุนโทเค็นต่ำกว่า"},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"ความแม่นยำ"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"ให้ความสำคัญกับโมเดลที่มีประสิทธิภาพสูงกว่าสำหรับการให้เหตุผลที่ซับซ้อน"},com_assistants_auto_weight_speed:{english:"Speed",translated:"ความเร็ว"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"ให้ความสำคัญกับโมเดลที่เร็วกว่าและมีความหน่วงต่ำ"},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"รีเซ็ตเป็นค่าเริ่มต้น"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"การอัปโหลดไฟล์หมดเวลา กรุณาลองอีกครั้งในอีกไม่กี่นาที"},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"เกิดข้อผิดพลาดบางอย่าง นี่คือข้อความข้อผิดพลาดที่เราพบ: เกิดข้อผิดพลาดขณะประมวลผลคำขอของคุณ ผู้ช่วยนี้ไม่พร้อมใช้งานอีกต่อไป โปรดติดต่อผู้ดูแลระบบ"},com_ui_code:{english:"Code",translated:"โค้ด"},com_ui_assistant_share:{english:"Share",translated:"แชร์"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"คัดลอกลิงก์แล้ว"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"คุณไม่มีสิทธิ์เข้าถึงผู้ช่วยนี้"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"คัดลอกลิงก์ไปยังคลิปบอร์ดไม่สำเร็จ"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"ดูตัวอย่างไม่ได้ — การสร้างเนื้อหาไม่เสร็จสมบูรณ์"},com_ui_view_code:{english:"View code",translated:"ดูโค้ด"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"ไม่สามารถแสดงตัวอย่างได้ — เนื้อหาไม่ถูกต้อง"},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"หมายเลขโทรศัพท์"},com_assistants_pii_entity_email:{english:"Email Address",translated:"ที่อยู่อีเมล"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"บัตรเครดิต"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"หมายเลขประกันสังคม"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"การอัปโหลดใช้เวลานานกว่าที่คาดไว้ - กำลังลองอีกครั้ง ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"ปัญหาการเชื่อมต่อ - กำลังลองอีกครั้ง ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"อัปโหลดไม่สำเร็จ - โปรดตรวจสอบการเชื่อมต่อและลองอีกครั้ง"},com_assistants_memory_enabled:{english:"Memory",translated:"หน่วยความจำ"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"เปิดใช้งานหน่วยความจำสำหรับผู้ช่วยนี้แล้ว ผู้ช่วยสามารถจัดเก็บและเรียกคืนข้อเท็จจริงข้ามการสนทนาได้"},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"ปิดใช้งานหน่วยความจำสำหรับผู้ช่วยนี้แล้ว จะไม่มีการจัดเก็บหรือเรียกคืนข้อเท็จจริงข้ามการสนทนา"},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"โปรดอธิบายเหตุผลทางธุรกิจของคุณในการปิดใช้งานหน่วยความจำ (จำเป็น)"},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"โปรดระบุเหตุผลในการปิดใช้งานหน่วยความจำ"},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"หน่วยความจำถูกปิดใช้งานสำหรับทีมของคุณ คุณสามารถดูและลบหน่วยความจำที่มีอยู่ได้ แต่ไม่สามารถเพิ่มหรือแก้ไขรายการใหม่ได้"},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"กำลังรันโค้ดของคุณ"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"กำลังค้นหาฐานความรู้"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"กำลังประมวลผลเสียง"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"กำลังบันทึกลงหน่วยความจำ"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"กำลังลบออกจากหน่วยความจำ"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"ค้นหาเว็บเสร็จแล้ว"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"ตรวจสอบหน้าเว็บเสร็จแล้ว"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"สร้างรูปภาพแล้ว"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"คำนวณเสร็จแล้ว"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"รันโค้ดของคุณเสร็จแล้ว"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"ค้นหาฐานความรู้เสร็จแล้ว"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"ประมวลผลเสียงเสร็จแล้ว"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"บันทึกลงหน่วยความจำแล้ว"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"ลบออกจากหน่วยความจำแล้ว"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"เสร็จสิ้น: {0}"},com_ui_still_working:{english:"still working...",translated:"ยังทำงานอยู่..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} พร้อมแล้ว"},com_ui_file_ready_fallback:{english:"File is ready",translated:"ไฟล์พร้อมแล้ว"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"ไม่สามารถประมวลผล {0} ได้"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"ไม่สามารถประมวลผลไฟล์ได้"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"ไม่สามารถประมวลผล {0} ได้ กรุณาอัปโหลดไฟล์อีกครั้ง"},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"ไม่สามารถประมวลผลไฟล์ได้ กรุณาอัปโหลดไฟล์อีกครั้ง"},com_ui_file_processing:{english:"Processing...",translated:"กำลังประมวลผล..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"การประมวลผลล้มเหลว"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"ล้มเหลว - ต้องอัปโหลดใหม่"},com_ui_file_retry:{english:"Retry",translated:"ลองอีกครั้ง"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"ลองอีกครั้งใน {0} วินาที"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"กำลังลองจัดทำดัชนีไฟล์อีกครั้ง..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"โปรดรอ {0} วินาทีก่อนลองอีกครั้ง"},com_ui_file_retries_exhausted_reupload:{english:"Maximum retries reached. Please re-upload the file.",translated:"ลองครบจำนวนสูงสุดแล้ว โปรดอัปโหลดไฟล์ใหม่"},com_ui_assistant_file_upload_invalid_json:{english:"Invalid JSON file. File content does not match the expected format.",translated:"ไฟล์ JSON ไม่ถูกต้อง เนื้อหาไฟล์ไม่ตรงกับรูปแบบที่คาดไว้"}},db=Object.freeze(Object.defineProperty({__proto__:null,comparisons:cb,default:lb},Symbol.toStringTag,{value:"Module"})),mb={com_error_moderation:"Mukhang ang nilalaman na isinumite ay na-flag ng aming sistema ng moderation dahil hindi ito naaayon sa aming mga alituntunin ng komunidad. Hindi namin maipagpatuloy ang partikular na paksang ito. Kung mayroon kang iba pang tanong o paksang nais talakayin, pakiedit ang iyong mensahe, o lumikha ng bagong usapan.",com_error_no_user_key:"Walang natagpuang susi. Mangyaring magbigay ng susi at subukang muli.",com_error_no_base_url:"Walang natagpuang base URL. Mangyaring magbigay ng isa at subukang muli.",com_error_invalid_user_key:"Hindi wastong susi ang ibinigay. Mangyaring magbigay ng susi at subukang muli.",com_error_expired_user_key:"Ang ibinigay na susi para sa {0} ay nag-expire noong {1}. Mangyaring magbigay ng susi at subukang muli.",com_error_token_balance_exceeded:"Naabot mo na ang iyong buwanang limitasyon sa paggamit. Mangyaring makipag-ugnayan sa admin ng team para sa tulong.",com_error_token_balance_exceeded_license:"Naabot mo na ang maximum na mga token para sa iyong lisensya. Mangyaring makipag-ugnayan sa sales sa {0} para sa karagdagang tulong.",com_error_token_balance_percent_used:"Nagamit mo na ang {0}% ng iyong nakalaang mga token. Mangyaring makipag-ugnayan sa {1} para sa karagdagang tulong.",com_error_license_expired:"Hindi available ang iyong Lisensya. Mangyaring makipag-ugnayan sa support para sa karagdagang tulong.",com_restricted_invalid_ip_format:"Hindi sinusuportahan ang mga IPv6 address. Mangyaring gumamit ng koneksyon sa IPv4 o makipag-ugnayan sa support para sa karagdagang tulong.",com_error_tool_run:"Nagkaroon ng error habang pinoproseso ang iyong kahilingan. Mangyaring subukang muli.",com_files_upload_duplicate_success:"Ang file {0} ay na-upload na nang matagumpay",com_files_no_results:"Walang resulta.",com_files_filter:"Maghanap ng mga file ayon sa pangalan",com_files_number_selected:"{0} ng {1} file(s) ang napili",com_sidepanel_select_assistant:"Pumili ng Assistant",com_sidepanel_parameters:"Mga Parameter",com_ui_create_assistant:"Lumikha ng Assistant",com_ui_create_assistant_permission_needed:"Kailangan ng user ng pahintulot sa paglikha upang makalikha ng Assistant",com_sidepanel_assistant_builder:"Mga Assistant",com_sidepanel_attach_files:"Tagapamahala ng File",com_sidepanel_manage_files:"Pamahalaan ang mga File",com_assistants_shared_with_consent_title:"Pahintulot",com_assistants_shared_with_consent_description_1:"Ikaw ay magbabahagi ng assistant na ito sa ibang miyembro ng team. Bago ibahagi ang assistant na ito, pakisuri ang mga pangunahing punto sa ibaba:",com_assistants_shared_with_consent_description_2:"Sa pagpapatuloy, kinukumpirma mo na nauunawaan at tinatanggap mo ang mga tuntuning ito.",com_assistants_shared_with_consent_bullet_1:"Ang ibinahaging assistant ay hindi dapat maglaman ng sensitibo o kumpidensyal na data.",com_assistants_shared_with_consent_bullet_2:"Ang ibinahaging assistant ay hindi dapat magproseso ng sensitibo o kumpidensyal na data.",com_assistants_shared_with_consent_bullet_3:"Ang pagbabahagi ay nagpapahiwatig ng pananagutan at responsibilidad para sa nilalaman at pag-access.",com_assistants_shared_with_consent_bullet_4:"Inirerekomenda na magbahagi sa isang tiyak na team o saradong grupo sa halip na sa lahat.",com_button_accept:"Tanggapin",com_button_decline:"Tanggihan",com_assistants_capabilities:"Kaalaman",com_assistants_file_search:"Paghahanap ng File",com_assistants_file_search_description:"Idagdag dito ang mga file na kailangan ng iyong assistant para maghanap kapag sumasagot sa mga tanong sa chat.",com_assistants_file_search_supported_label:"Suportado:",com_assistants_file_search_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",com_assistants_file_search_tips_label:"Tip:",com_assistants_file_search_tips:"Sabihin sa iyong assistant na gamitin ang 'File Search Tool' tuwing ito ay tumutugon sa mga gumagamit.",com_assistants_file_search_info:"Ang pag-attach ng vector stores para sa Paghahanap ng File ay hindi pa suportado. Maaari mong i-attach ang mga ito mula sa Provider Playground o mag-attach ng mga file sa mga mensahe para sa paghahanap ng file sa bawat thread.",com_assistants_file_search_fetch_error:"May nangyaring mali sa pagkuha ng mga file mula sa vector stores.",com_assistants_knowledge:"Kaalaman",com_assistants_knowledge_info:"Mag-upload ng mga file sa iyong assistant, upang magamit ito sa pagsagot sa mga tanong (hal. CXNGPT User Guide)",com_assistants_knowledge_disabled:"I-click ang Lumikha para i-save ang iyong Assistant, pagkatapos ay i-upload ang iyong mga file, at i-click ang I-save.",com_assistants_image_vision:"Pananaw ng Imahe",com_assistants_code_interpreter:"Tagasalin ng Kodigo",com_assistants_code_interpreter_description:"Idagdag dito ang mga file na kailangan ng iyong assistant para gamitin sa pagsusuri o pagbabago ng data para sa bawat chat.",com_assistants_code_interpreter_supported_label:"Suportado:",com_assistants_code_interpreter_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",com_assistants_code_interpreter_tips_label:"Mga Tip:",com_assistants_code_interpreter_tips:"Sabihin sa iyong assistant na gamitin ang 'Code Interpreter Tool' tu