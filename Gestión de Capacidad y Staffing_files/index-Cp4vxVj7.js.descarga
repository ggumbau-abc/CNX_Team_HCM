l_coming_soon:"În curând",com_assistants_owners:"Owners",com_assistants_owner_added:"Owner added successfully",com_assistants_owner_removed:"Owner removed successfully",com_assistants_owner_last_owner_error:"Cannot remove the last owner of an assistant",com_assistants_owner_email_placeholder:"Add owner by email",com_ui_add:"Add",com_ui_you:"you",com_assistants_add_owners:"Add owners",com_assistants_owner_search_placeholder:"Search by name or email (min. 3 characters)",com_assistants_owner_search_hint:"Type at least 3 characters to search",com_assistants_owner_no_results:"No users found",com_assistants_owner_discard_warning:"Unsaved changes will be discarded. Are you sure?",com_assistants_owners_saved:"Owners updated successfully",com_assistants_save_owners:"Save owners",com_assistants_pending_additions:"Pending additions",com_ui_saving:"Saving...",com_ui_discard:"Discard",com_ui_keep_editing:"Keep editing",com_ui_undo:"Undo",com_assistants_auto_weight_title:"Preferințe de rutare automată",com_assistants_auto_weight_description:"Ajustați modul în care routerul Auto echilibrează compromisurile la selectarea unui model pentru fiecare tură. Ponderile sunt normalizate — contează echilibrul relativ.",com_assistants_auto_weight_cost:"Cost",com_assistants_auto_weight_cost_helper:"Favorizează modelele mai ieftine, cu cost mai mic per token.",com_assistants_auto_weight_accuracy:"Acuratețe",com_assistants_auto_weight_accuracy_helper:"Favorizează modelele mai puternice pentru raționamente complexe.",com_assistants_auto_weight_speed:"Viteză",com_assistants_auto_weight_speed_helper:"Favorizează modelele mai rapide, cu latență mai mică.",com_assistants_auto_weight_reset:"Resetează la valorile implicite",com_ui_assistant_file_upload_timeout_error:"Încărcarea fișierului a expirat. Vă rugăm să încercați din nou peste câteva minute.",com_error_assistant_not_available:"Ceva nu a mers bine. Iată mesajul de eroare specific întâlnit: A apărut o eroare la procesarea cererii tale. Asistentul nu mai este disponibil. Te rugăm să contactezi administratorul.",com_ui_code:"Cod",com_ui_assistant_share:"Partajează",com_ui_assistant_share_link_copied:"Link copiat",com_ui_assistant_no_access:"Nu aveți acces la acest asistent",com_ui_copy_to_clipboard_error:"Nu s-a putut copia linkul în clipboard",com_ui_preview_incomplete:"Previzualizare indisponibilă — generarea conținutului nu a fost finalizată.",com_ui_view_code:"Vezi codul",com_ui_preview_invalid:"Previzualizare indisponibilă — conținut invalid.",com_ui_assistant_file_upload_timeout_retrying:"Încărcarea durează mai mult decât era de așteptat - se reîncearcă ({0}/{1})...",com_ui_assistant_file_upload_connection_retrying:"Problemă de conexiune - se reîncearcă ({0}/{1})...",com_ui_assistant_file_upload_connection_failed:"Încărcarea a eșuat - vă rugăm să verificați conexiunea și să încercați din nou",com_ui_assistant_tools_codeexecutor:"Rulez codul dvs.",com_ui_assistant_tools_rag_query:"Caut în baza de cunoștințe",com_ui_assistant_tools_voiceworx:"Procesez vocea",com_ui_assistant_tools_memory_store:"Salvez în memorie",com_ui_assistant_tools_memory_delete:"Elimin din memorie",com_ui_assistant_tools_completed_search_online:"Căutarea pe web s-a încheiat",com_ui_assistant_tools_completed_browse_website:"Revizuirea paginii web s-a încheiat",com_ui_assistant_tools_completed_generate_image:"Imagine generată",com_ui_assistant_tools_completed_calculate_math:"Calculul s-a încheiat",com_ui_assistant_tools_completed_codeexecutor:"Rularea codului dvs. s-a încheiat",com_ui_assistant_tools_completed_rag_query:"Căutarea în baza de cunoștințe s-a încheiat",com_ui_assistant_tools_completed_voiceworx:"Procesarea intrării vocale s-a încheiat",com_ui_assistant_tools_completed_memory_store:"Salvat în memorie",com_ui_assistant_tools_completed_memory_delete:"Eliminat din memorie",com_ui_assistant_tools_completed_fallback:"Încheiat: {0}",com_ui_still_working:"încă lucrez...",com_assistants_pii_entity_phone:"Număr de telefon",com_assistants_pii_entity_email:"Adresă de email",com_assistants_pii_entity_credit_card:"Card de credit",com_assistants_pii_entity_ssn:"CNP",com_assistants_memory_enabled:"Memorie",com_assistants_memory_enabled_info:"Memoria este activată pentru acest asistent. Asistentul poate stoca și reaminti informații între conversații.",com_assistants_memory_disabled_info:"Memoria este dezactivată pentru acest asistent. Nu vor fi stocate sau reamintite informații între conversații.",com_assistants_memory_enabled_off_reason_placeholder:"Vă rugăm să explicați justificarea de business pentru dezactivarea memoriei (obligatoriu).",com_assistants_memory_enabled_reason_required:"Vă rugăm să furnizați o justificare pentru dezactivarea memoriei.",com_nav_memory_team_disabled:"Memoria este dezactivată pentru echipa dvs. Puteți vizualiza și șterge amintirile existente, dar nu puteți adăuga sau edita altele noi.",com_ui_file_processing:"Se procesează...",com_ui_file_processing_failed_status:"Procesarea a eșuat",com_ui_file_processing_failed_reupload_required:"Eșuat - reîncărcare necesară",com_ui_file_retry:"Reîncercați",com_ui_file_retry_in:"Reîncercați în {0}s",com_ui_file_ready:"{0} este gata",com_ui_file_ready_fallback:"Fișierul este gata",com_ui_file_processing_failed:"{0} nu a putut fi procesat",com_ui_file_processing_failed_fallback:"Fișierul nu a putut fi procesat",com_ui_file_processing_failed_reupload:"{0} nu a putut fi procesat. Vă rugăm să reîncărcați fișierul.",com_ui_file_processing_failed_reupload_fallback:"Fișierul nu a putut fi procesat. Vă rugăm să reîncărcați fișierul.",com_ui_file_indexing_retrying:"Se reîncearcă indexarea fișierului...",com_ui_file_retry_wait:"Vă rugăm să așteptați {0}s înainte de a reîncerca",com_ui_file_retries_exhausted_reupload:"Numărul maxim de reîncercări a fost atins. Vă rugăm să reîncărcați fișierul.",com_ui_assistant_file_upload_invalid_json:"Fișier JSON invalid. Conținutul fișierului nu corespunde formatului așteptat."},Vk={com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Se pare că conținutul trimis a fost marcat de sistemul nostru de moderare pentru că nu respectă ghidurile comunității noastre. Nu putem continua cu acest subiect specific. Dacă aveți alte întrebări sau subiecte pe care doriți să le explorați, vă rugăm să editați mesajul sau să creați o nouă conversație."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Cheie lipsă. Vă rugăm să furnizați o cheie și să încercați din nou."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"URL de bază lipsă. Vă rugăm să furnizați unul și să încercați din nou."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Cheie invalidă furnizată. Vă rugăm să furnizați o cheie și să încercați din nou."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Cheia furnizată pentru {0} a expirat la {1}. Vă rugăm să furnizați o cheie și să încercați din nou."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Ați atins limita de utilizare lunară. Vă rugăm să contactați administratorul echipei pentru asistență."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Ați atins numărul maxim de tokenuri pentru licența dvs. Vă rugăm să contactați vânzările la {0} pentru asistență suplimentară."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Ați utilizat {0}% din tokenurile alocate. Vă rugăm să contactați {1} pentru asistență suplimentară."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Licența dvs. nu este disponibilă. Vă rugăm să contactați suportul pentru asistență suplimentară."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Adresele IPv6 nu sunt suportate. Vă rugăm să utilizați o conexiune IPv4 sau să contactați suportul pentru asistență suplimentară."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"A apărut o eroare la procesarea cererii dvs. Vă rugăm să încercați din nou."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Fișierul {0} a fost deja încărcat cu succes"},com_files_no_results:{english:"No results.",translated:"Niciun rezultat."},com_files_filter:{english:"Search files by name",translated:"Căutați fișiere după nume"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} din {1} fișier(e) selectat(e)"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Selectați un Asistent"},com_sidepanel_parameters:{english:"Parameters",translated:"Parametri"},com_ui_create_assistant:{english:"Create Assistant",translated:"Creați Asistent"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Utilizatorul are nevoie de permisiuni de creare pentru a crea un Asistent"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Asistenți"},com_sidepanel_attach_files:{english:"File Manager",translated:"Manager Fișiere"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Gestionați Fișierele"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Consimțământ"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Sunteți pe cale să partajați acest asistent cu alți membri ai echipei. Înainte de a partaja acest asistent, vă rugăm să revizuiți punctele cheie de mai jos:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Prin continuare, confirmați că înțelegeți și acceptați acești termeni."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Asistentul partajat nu trebuie să conțină date sensibile sau confidențiale."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Asistenții partajați nu trebuie să proceseze date sensibile sau confidențiale."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Partajarea implică responsabilitate și răspundere pentru conținut și acces."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Se recomandă partajarea cu un anumit grup sau echipă închisă, nu cu toată lumea."},com_button_accept:{english:"Accept",translated:"Acceptă"},com_button_decline:{english:"Decline",translated:"Refuză"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Bază de cunoștințe"},com_assistants_file_search:{english:"File Search",translated:"Căutare fișiere"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Adaugă aici fișierele pe care dorești ca asistentul să le caute când răspunde la întrebări în chat."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Suportate:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Sfat:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Roagă asistentul să folosească 'Instrumentul de Căutare Fișiere' de fiecare dată când răspunde utilizatorilor."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Atașarea magazinelor vectoriale pentru Căutare Fișiere nu este încă suportată. Poți să le atașezi din Provider Playground sau să atașezi fișiere la mesaje pentru căutare pe baza firului de discuție."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Ceva nu a mers bine la preluarea fișierelor din magazinele vectoriale."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Bază de cunoștințe"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Încarcă fișiere în asistentul tău, astfel încât să le poată folosi pentru a răspunde la întrebări (ex. Ghidul Utilizatorului CXNGPT)"},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Apasă Creează pentru a salva Asistentul, apoi încarcă fișierele tale și apasă Salvează."},com_assistants_image_vision:{english:"Image Vision",translated:"Viziune Imagine"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Interpret de Cod"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Adaugă aici fișierele pe care dorești ca asistentul să le folosească pentru a analiza sau transforma datele pentru fiecare chat."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Suportate:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Sfaturi:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Roagă asistentul să folosească 'Instrumentul de Interpretare Cod' de fiecare dată când răspunde utilizatorilor."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} din {1} fișiere încărcate"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Următoarele fișiere sunt disponibile doar pentru Interpretul de Cod:"},com_assistants_retrieval:{english:"Retrieval",translated:"Recuperare"},com_assistants_search_name:{english:"Search assistants by name",translated:"Caută asistenți după nume"},com_assistants_tools:{english:"Tools",translated:"Unelte"},com_assistants_actions:{english:"Actions",translated:"Acțiuni"},com_assistants_add_tools:{english:"Add Tools",translated:"Adaugă Unelte"},com_assistants_add_actions:{english:"Add Actions",translated:"Adaugă Acțiuni"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Căutarea fișierelor nu este activată pe acest model. Vă rugăm să selectați alt model."},com_assistants_available_actions:{english:"Available Actions",translated:"Acțiuni Disponibile"},com_assistants_running_action:{english:"Running action",translated:"Acțiune în desfășurare"},com_assistants_completed_action:{english:"Talked to {0}",translated:"A vorbit cu {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"A rulat {0}"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"A folosit Căutarea de Fișiere"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Asistentul a folosit {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:"[eroare procesare unealtă] Nu s-a putut prelua conținutul site-ului dat. [100]"},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:"[eroare procesare unealtă] Nu s-a putut prelua conținutul site-ului dat. [101]"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Asistentul a trimis aceste informații către {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Ștergerea este permisă doar pentru Asistenții privați"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Acțiunea a fost ștearsă cu succes din Asistent"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Acțiunea a fost creată sau actualizată cu succes"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"A apărut o eroare la crearea sau actualizarea acțiunii."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"A apărut o eroare la ștergerea acțiunii."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Permiteți Asistentului să recupereze informații sau să ia acțiuni prin API-uri"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Denumește-ți asistentul (ex. Generator de Emailuri)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Oferiți asistentului dvs. instrucțiuni specifice, detaliate și cuprinzătoare pentru a-i ghida comportamentul (ex. Scop, Rol, Acțiuni, Public, Stil, Reguli, Sarcină, Șablon, Exemplu)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Descrieți concis ce poate face asistentul dvs. (ex. Generați emailuri din șablon)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Trebuie să creați un asistent înainte de a adăuga acțiuni."},com_assistants_update_success:{english:"Successfully updated",translated:"Actualizat cu succes"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"A apărut o eroare la actualizarea asistentului dvs."},com_assistants_create_success:{english:"Successfully created",translated:"Creat cu succes"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"A apărut o eroare la crearea asistentului dvs."},com_assistants_loading:{english:"Loading assistants...",translated:"Se încarcă asistenții..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Vă rugăm să oferiți un motiv pentru activarea PII."}