e"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Attribuez une catégorie d'affaires pour aider à filtrer et organiser les assistants par fonction."},com_ui_error:{english:"Error",translated:"Erreur"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Erreur de connexion au serveur, essayez de rafraîchir la page."},com_ui_select:{english:"Select",translated:"Sélectionner"},com_ui_select_placeholder:{english:"Select options",translated:"Sélectionner des options"},com_ui_remove:{english:"Remove",translated:"Supprimer"},com_ui_input:{english:"Input",translated:"Entrée"},com_ui_close:{english:"Close",translated:"Fermer"},com_ui_model:{english:"Model",translated:"Modèle"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Le champ du nom de l'assistant ne peut pas être vide. Veuillez entrer un nom valide."},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Préfixe intelligent utilisé pour les assistants généraux, veuillez utiliser un autre nom."},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Le champ de description ne peut pas être vide. Veuillez entrer une description valide."},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Le champ des instructions ne peut pas être vide. Veuillez entrer des instructions valides."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Le champ de catégorie ne peut pas être vide. Veuillez sélectionner une catégorie."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Un nom d'assistant en double a été détecté. Veuillez choisir un nom unique."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Le champ partagé avec ne peut pas être vide. Veuillez sélectionner une option de partage."},com_ui_shared_with:{english:"Shared With",translated:"Partagé avec"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Privé – Seul vous pouvez accéder et voir cet assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Partager uniquement avec l'équipe – Cet assistant sera visible et accessible pour les membres de votre équipe."},com_ui_shared_with_team:{english:"Team",translated:"Équipe"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Sélectionnez l'équipe à laquelle cet assistant appartient. Seules les équipes dont vous êtes membre apparaîtront ici."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Le champ de l'équipe ne peut pas être vide. Veuillez sélectionner une équipe."},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Cet assistant est verrouillé pour la modification car il est partagé avec l'équipe."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Erreur lors du chargement des liens partagés."},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Le nom de votre Assistant contient des mots offensants et n'a pas pu être envoyé. Veuillez mettre à jour le nom de votre Assistant."},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Votre description contient des mots offensants et n'a pas pu être envoyée. Veuillez mettre à jour votre description."},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Vos instructions contiennent des mots offensants et n'ont pas pu être envoyées. Veuillez mettre à jour vos instructions."},com_ui_select_search_model:{english:"Search model by name",translated:"Rechercher un modèle par nom"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Rechercher un plugin par nom"},com_ui_use_prompt:{english:"Use prompt",translated:"Utiliser l'invite"},com_ui_prev:{english:"Prev",translated:"Précédent"},com_ui_next:{english:"Next",translated:"Suivant"},com_ui_stop:{english:"Stop",translated:"Arrêter"},com_ui_upload_files:{english:"Upload files",translated:"Téléverser des fichiers"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Modèles d'invite"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Masquer les modèles d'invite"},com_ui_showing:{english:"Showing",translated:"Affichage"},com_ui_of:{english:"of",translated:"de"},com_ui_entries:{english:"Entries",translated:"Entrées"},com_ui_none_selected:{english:"None selected",translated:"Aucune sélectionnée"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Fichier téléversé avec succès"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Erreur lors du téléversement de votre fichier"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Fichier invalide pour le téléversement. Doit être une image ne dépassant pas 2 Mo"},com_ui_thinking:{english:"Thinking",translated:"Réflexion"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Analyse de votre demande"},co