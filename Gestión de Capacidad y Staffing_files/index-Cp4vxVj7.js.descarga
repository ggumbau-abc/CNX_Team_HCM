ry_team_disabled:"Память отключена для вашей команды. Вы можете просматривать и удалять существующие воспоминания, но не можете добавлять или редактировать новые.",com_ui_file_ready:"{0} готов",com_ui_file_ready_fallback:"Файл готов",com_ui_file_processing_failed:"Не удалось обработать {0}",com_ui_file_processing_failed_fallback:"Не удалось обработать файл",com_ui_file_processing_failed_reupload:"Не удалось обработать {0}. Пожалуйста, загрузите файл повторно.",com_ui_file_processing_failed_reupload_fallback:"Не удалось обработать файл. Пожалуйста, загрузите файл повторно.",com_ui_file_processing:"Обработка...",com_ui_file_processing_failed_status:"Обработка не удалась",com_ui_file_processing_failed_reupload_required:"Сбой — требуется повторная загрузка",com_ui_file_retry:"Повторить",com_ui_file_retry_in:"Повтор через {0}с",com_ui_file_indexing_retrying:"Повторная попытка индексации файла...",com_ui_file_retry_wait:"Подождите {0}с перед повтором",com_ui_file_retries_exhausted_reupload:"Достигнуто максимальное число попыток. Пожалуйста, загрузите файл повторно.",com_ui_assistant_file_upload_invalid_json:"Недопустимый JSON-файл. Содержимое файла не соответствует ожидаемому формату."},Wk={com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Выбрать Ассистента"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Ассистенты"},com_sidepanel_attach_files:{english:"File Manager",translated:"Прикрепить файлы"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Управление файлами"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Интерпретатор кода"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Интерпретатор кода позволяет вам взаимодействовать с кодом в вашем разговоре."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Поддерживаемые языки:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Советы:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:""},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Следующие файлы доступны только для Интерпретатора кода:"},com_ui_examples:{english:"Examples",translated:"Примеры"},com_ui_new_chat:{english:"New chat",translated:"Создать чат"},com_ui_conversations:{english:"Chats",translated:"Беседы"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"Начать беседу..."},com_ui_new_conversation:{english:"New Chat",translated:"Создать разговор"},com_ui_assistant_library:{english:"Assistant Library",translated:"Библиотека помощников"},com_ui_assistant_search:{english:"Search for an assistant",translated:"Искать помощника"},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"Объясни квантовые вычисления простыми словами"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"У тебя есть креативные идеи для дня рождения 10-летнего ребенка?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"Как мне сделать HTTP-запрос в JavaScript?"},com_ui_capabilities:{english:"Capabilities",translated:"Возможности"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"Запоминает, что пользователь говорил ранее в разговоре"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Позволяет пользователю вносить корректировки после ответа"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Обучен отклонять неподходящие запросы"},com_ui_limitations:{english:"Limitations",translated:"Ограничения"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Иногда может генерировать некорректную информацию"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Иногда может создавать вредные инструкции или предвзятое содержимое"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Ограниченные знания о мире и событиях после 2021 года"},com_ui_input:{english:"Input",translated:"Ввод"},com_ui_close:{english:"Close",translated:"Закрыть"},com_ui_model:{english:"Model",translated:"Модель"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Имя не может быть пустым"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Имя не может содержать умные префиксы"},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Описание не может быть пустым"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Инструкции не могут быть пустыми"},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Поле категории не может быть пустым. Пожалуйста, выберите категорию"},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Ассистент с таким именем уже существует"},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Пожалуйста, укажите, с кем вы хотите поделиться"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Имя не может содержать ненормативную лексику"},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Описание не может содержать ненормативную лексику"},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Инструкции не могут содержать ненормативную лексику"},com_ui_shared_with:{english:"Shared With",translated:"Поделиться с"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Private – Only you can access and view this assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Share only with Team – This assistant will be visible and accessible to your team members."},com_ui_shared_with_team:{english:"Team",translated:"Поделиться с командой"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Пожалуйста, укажите, с какой командой вы хотите поделиться"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Этот ассистент заблокирован для редактирования, так как он является общим для команды."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Ошибка