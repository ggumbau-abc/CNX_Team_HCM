_upload_error:{english:"An error occurred while uploading the file.",translated:"Fel vid uppladdning av fil."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Fel vid uppladdning av fil: Endpoint är odefinierad"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Tomma filer är inte tillåtna."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Du kan bara ladda upp upp till {0} filer åt gången."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Du kan bara ladda upp upp till {0} filer i denna sektion."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Uppladdningsgränsen har nåtts för {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Kan inte fastställa filtyp för: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Filtypen stöds inte. Vänligen ladda upp ett format som stöds."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Kunde inte ladda bilden"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"För närvarande stöds endast JPEG, JPG, PNG och WEBP filer."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Filstorleken överstiger {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Den totala filstorleken får inte överstiga {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Ett fel uppstod vid validering av filen."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Ett fel uppstod vid bearbetning av filen."},com_ui_assistants:{english:"Assistants",translated:"Assistenter"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Studioassistans"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Kunskap"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Okategoriserad"},com_ui_attachment:{english:"Attachment",translated:"Bilaga"},com_ui_assistants_output:{english:"Assistants Output",translated:"Assistenters utdata"},com_ui_create:{english:"Create",translated:"Skapa"},com_ui_copy_link:{english:"Copy link",translated:"Kopiera länk"},com_ui_update_link:{english:"Update link",translated:"Uppdatera länk"},com_ui_create_link:{english:"Create link",translated:"Skapa länk"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Är du säker på att du vill radera denna assistent? Detta kan inte ångras."},com_ui_preview:{english:"Preview",translated:"Förhandsgranska"},com_ui_upload:{english:"Upload",translated:"Ladda upp"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Uppladdning av "{0}" tar längre tid än väntat. Vänligen vänta medan filen indexeras för hämtning.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Integritetspolicy"},com_ui_terms_of_service:{english:"Terms of service",translated:"Användarvillkor"},com_ui_use_micrphone:{english:"Use microphone",translated:"Använd mikrofon"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Kan inte ta bort fler värden, minst {0} krävs."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Maximalt antal tillåtna är {0}, använder senaste värden."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Ditt konto har tillfälligt blivit avstängt på grund av överträdelser av vår tjänst."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Ett internt serverfel uppstod. Vänta några ögonblick och försök igen."},com_endpoint_message:{english:"Message",translated:"Meddelande"},com_endpoint_messages:{english:"Messages",translated:"Meddelanden"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Redigera ditt meddelande eller återskapa."},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Max kontexttoken"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Maximalt antal token som kan användas för kontext. Använd detta för att kontrollera hur många token som skickas per förfrågan.
  Om ej angivet, används systemets standardvärden baserat på kända modellers kontextstorlek. Högre värden kan orsaka fel och/eller högre tokenkostnad.`},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Åsidosätter assistentens instruktioner. Användbart för att ändra beteendet per körning."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Ange ytterligare instruktioner eller kontext utöver assistentens huvudinstruktioner. Ignoreras om tomt."},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Ytterligare instruktioner"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Åsidosätt instruktioner"},com_endpoint_stop:{english:"Stop Sequences",translated:"Stoppa sekvenser"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Separera värden med `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Valfritt `max_tokens`-fält, som representerar det maximala antalet token som kan genereras i chattkompletteringen.\n    \n    Den totala längden på inmatningstoken och genererade token begränsas av modellens kontextlängd. Du kan uppleva fel om detta antal överskrider max kontexttoken."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Skicka om alla tidigare bifogade filer. Obs: detta ökar tokenkostnaden och du kan uppleva fel med många bilagor."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Upplösningen för Vision-förfrågningar. "Låg" är billigare och snabbare, "Hög" är mer detaljerad och dyr, och "Auto" väljer automatiskt mellan de två baserat på bildens upplösning.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Upp till 4 sekvenser där API:et slutar generera fler token."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Skicka om filer"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Bilddetalj"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Är du säker på att du vill radera denna förinställning?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Förinställning importerad!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Det uppstod ett fel vid import av din förinställning. Försök igen."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Det uppstod ett fel vid sparande av din förinställning. Försök igen."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Det uppstod ett fel vid radering av din förinställning. Försök igen."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"är inte längre standardförinställning."},com_endpoint_preset_default_item:{english:"Default:",translated:"Standard:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Ingen standardförinställning aktiv."},com_endpoint_preset_title:{english:"Preset",translated:"Förinställning"},com_endpoint_preset_saved:{english:"Saved!",translated:"Sparad!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"är nu standardförinställningen."},com_endpoint_preset_selected_title:{english:"Active!",translated:"Aktiv!"},com_endpoint_export_share:{english:"Export/Share",translated:"Exportera/Dela"},com_endpoint_assistant:{english:"Assistant",translated:"Assistent"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Använd Aktiv Assistent"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Vänligen välj en Assistent och starta en ny chatt"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Ange din Nyckel i Huvudmenyn för att chatta."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Vänligen Välj en Assistent"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Välkommen till iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Text till Tal"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Autospelning av Senaste Meddelande"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Tal till Text"},com_nav_profile_picture:{english:"Profile Picture",translated:"Profilbild"},com_nav_change_picture:{english:"Change picture",translated:"Byt bild"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Visa Agentinställningar"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Visa Slutförandeinställningar"},com_hide_examples:{english:"Hide Examples",translated:"Dölj Exempel"},com_show_examples:{english:"Show Examples",translated:"Visa Exempel"},com_nav_user_name_display:{english:"Display username in messages",translated:"Visa användarnamn i meddelanden"},com_nav_user_guide:{english:"User Guide",translated:"Användarguide"},com_nav_auto_send_text:{english:"