"Model",translated:"Model"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Naam is verplicht"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Slimme voorvoegsels zijn niet toegestaan in de naam"},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Beschrijving is verplicht"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Instructies zijn verplicht"},com_ui_category:{english:"Category",translated:"Category"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Assign a business category to help filter and organize assistants by function."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Het categorievak mag niet leeg zijn. Selecteer een categorie"},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Assistent met dezelfde naam bestaat al"},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Gedeeld met is verplicht"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Naam bevat ongepaste inhoud"},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Beschrijving bevat ongepaste inhoud"},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Instructies bevatten ongepaste inhoud"},com_ui_shared_with:{english:"Shared With",translated:"Gedeeld met"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Private – Only you can access and view this assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Share only with Team – This assistant will be visible and accessible to your team members."},com_ui_shared_with_team:{english:"Team",translated:"Team"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Team is verplicht"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Deze assistent is vergrendeld voor bewerking omdat deze gedeeld is met het team."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Fout bij het laden van gedeelde links."},com_ui_use_prompt:{english:"Use prompt",translated:"Gebruik prompt"},com_ui_prev:{english:"Prev",translated:"Vorige"},com_ui_next:{english:"Next",translated:"Volgende"},com_ui_stop:{english:"Stop",translated:"Stop"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Prompt-sjablonen"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Prompt-sjablonen verbergen"},com_ui_showing:{english:"Showing",translated:"Tonen"},com_ui_of:{english:"of",translated:"van"},com_ui_entries:{english:"Entries",translated:"Items"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Bestand succesvol geüpload"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Ongeldig bestand voor uploaden"},com_ui_cancel:{english:"Cancel",translated:"Annuleren"},com_ui_save:{english:"Save",translated:"Opslaan"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Kopiëren naar klembord"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Gekopieerd naar klembord"},com_ui_regenerate:{english:"Regenerate",translated:"Opnieuw genereren"},com_ui_edit:{english:"Edit",translated:"Bewerken"},com_ui_all:{english:"all",translated:"alle"},com_ui_clear:{english:"Clear",translated:"Wissen"},com_ui_import_conversation:{english:"Import",translated:"Importeren"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Gesprekken importeren vanuit een JSON-bestand"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Gesprekken succesvol geïmporteerd"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Er is een fout opgetreden bij het importeren van je gesprekken"},com_ui_confirm_action:{english:"Confirm Action",translated:"Bevestig actie"},com_ui_share:{english:"Share",translated:"Share"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Share link to chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"There was an error sharing the chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Your name and any messages you add after sharing stay private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been created. Manage previously shared chats at any time via Settings."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Your name, custom instructions, and any messages you add after sharing stay private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Shared link not found"},com_ui_delete:{english:"Delete",translated:"Verwijderen"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Chat verwijderen?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Hiermee wordt"},com_ui_rename:{english:"Rename",translated:"Hernoemen"},com_ui_more_options:{english:"More",translated:"Meer"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Gebruikte bestandszoekopdracht"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Kan niet inloggen met de verstrekte informatie. Controleer uw referenties en probeer het opnieuw."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Te veel inlogpogingen in een korte tijd. Probeer het later nog eens."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Uw account is tijdelijk verbannen vanwege schendingen van onze service."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Er was een interne serverfout. Wacht een paar momenten en probeer het opnieuw."},com_auth_sign_in:{english:"Login",translated:"Inloggen"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:""}},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:""}},com_endpoint_system_message:{english:"System Message",translated:"Systeembericht"},com_endpoint_default_blank:{english:"default: blank",translated:"standaard: leeg"},com_endpoint_default_false:{english:"default: false",translated:"standaard: onwaar"},com_endpoint_default_creative:{english:"default: creative",translated:"standaard: creatief"},com_endpoint_default_empty:{english:"default: empty",translated:"standaard: leeg"},com_endpoint_default_with_num:{english:"default: {0}",translated:"standaard: {0}"},com_endpoint_context:{english:"Context",translated:"Context"},com_endpoint_tone_style:{english:"Tone Style",translated:"Toonstijl"},com_endpoint_token_count:{english:"Token count",translated:"Aantal tokens"},com_endpoint_output:{english:"Output",translated:"Uitvoer"},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Stel aangepaste instructies of context in. Wordt genegeerd indien leeg."},com_endpoint_custom_name:{english:"Custom Name",translated:"Aangepaste naam"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Prompt-voorvoegsel"},com_endpoint_temperature:{english:"Temperature",translated:"Temperatuur"},com_endpoint_default:{english:"default",translated:"standaard"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Max. uitvoertokens"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Hogere waarden = meer willekeurig, terwijl lagere waarden = meer gericht en deterministisch. We raden aan dit of Top P te wijzigen, maar niet beide."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Het max. aantal tokens dat kan worden gegenereerd. De totale lengte van invoer-tokens en gegenereerde tokens is beperkt door de contextlengte van het model."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Een alternatief voor sampling met temperatuur, genaamd nucleus sampling, waarbij het model de resultaten van de tokens met de top_p waarschijnlijkheidsmassa in overweging neemt. Dus 0,1 betekent dat alleen de tokens die de bovenste 10% waarschijnlijkheidsmassa omvatten, in overweging worden genomen. We raden aan dit of temperatuur te wijzigen, maar niet beide."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Getal tussen -2,0 en 2,0. Positieve waarden straffen nieuwe tokens op basis van hun bestaande frequentie in de tekst tot nu toe, waardoor de kans dat het model dezelfde regel letterlijk herhaalt, afneemt."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Getal tussen -2,0 en 2,0. Positieve waarden straffen nieuwe tokens op basis van of ze al voorkomen in de tekst tot nu toe, waardoor de kans dat het model over nieuwe onderwerpen praat toeneemt."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Stel een aangepaste naam in voor ChatGPT"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Stel aangepaste instructies in om op te nemen in Systeembericht. Standaard: geen"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Frequentiestraf"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Aanwezigheidsstraf"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Gebruik functies inschakelen"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Voltooiing overslaan"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Stel aangepaste instructies in om op te nemen in Systeembericht. Standaard: geen"},com_endpoint_import:{english:"Import",translated:"Importeren"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Stel een aangepaste naam in, voor het geval je deze voorinstelling kunt vinden"},com_endpoint_preset:{english:"preset",translated:"voorinstelling"},com_endpoint_presets:{english:"presets",translated:"voorinstellingen"},com_endpoint_preset_name:{english:"Preset Name",translated:"Naam voorinstelling"},com_endpoint:{english:"Endpoint",translated:"Eindpunt"},com_endpoint_examples:{english:" Presets",translated:" Voorinstellingen"},com_endpoint_export:{english:"Export",translated:"Exporteren"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Opslaan als voorinstelling"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Weet u zeker dat u alle voorinstellingen wilt wissen? Dit is onomkeerbaar."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Nog geen voorinstellingen, gebruik de instellingenknop om er een te maken"},com_endpoint_my_preset:{english:"My Preset",translated:"Mijn voorinstelling"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Agentmodel (Aanbevolen: GPT-3,5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Voltooiingsmodel (Aanbevolen: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Schakel het gebruik van plug-ins als OpenAI-functies in"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Schakel het overslaan van de voltooiingsstap in, die het definitieve antwoord en gegenereerde stappen beoordeelt"},com_nav_export_filename:{english:"Filename",translated:"Bestandsnaam"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Stel de bestandsnaam in"},com_nav_export_type:{english:"Type",translated:"Type"},com_nav_export_conversation:{english:"Export conversation",translated:"Conversatie exporteren"},com_nav_export:{english:"Export",translated:"Exporteren"},com_nav_shared_links:{english:"Shared links",translated:"Gedeelde links"},com_nav_shared_links_manage:{english:"Manage",translated:"Beheren"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"U hebt geen gedeeld links."},com_nav_shared_links_name:{english:"Name",translated:"Naam"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Datum gedeeld"},com_nav_source_chat:{english:"View source chat",translated:"View source chat"},com_nav_my_files:{english:"File Manager",translated:"File Manager"},com_nav_admin_center:{english:"Admin Center",translated:"Beheerscentrum"},com_nav_theme:{english:"Theme",translated:"Thema"},com_nav_theme_system:{english:"System",translated:"Systeem"},com_nav_theme_dark:{english:"Dark",translated:"Donker"},com_nav_theme_light:{english:"Light",translated:"Licht"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Alle chats wissen"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Wissen bevestigen"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Zijbalk sluiten"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Zijbalk openen"},com_nav_send_message:{english:"Send message",translated:"Bericht verzenden"},com_nav_log_out:{english:"Log out",translated:"Uitloggen"},com_nav_user:{english:"USER",translated:"GEBRUIKER"},com_nav_archived_chats:{english:"Archived chats",translated:"Gearchiveerde chats"},com_nav_archived_chats_manage:{english:"Manage",translated:"Beheren"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Geen gearchiveerde chats"},com_nav_archive_name:{english:"Name",translated:"Naam"},com_nav_archive_created_at:{english:"DateCreated",translated:"Gemaakt op"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Conversaties wissen"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Weet u zeker dat u alle conversaties wilt wissen? Dit is onomkeerbaar."},com_nav_help:{english:"Help",translated:"Hulp"},com_nav_settings:{english:"Settings",translated:"Instellingen"},com_nav_search_placeholder:{english:"Search messages",translated:"Berichten doorzoeken"},com_nav_setting_general:{english:"General",translated:"Algemeen"},com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Het lijkt erop dat de ingediende inhoud door ons moderatiesysteem is gemarkeerd omdat deze niet overeenkomt met onze gemeenschapsrichtlijnen. We kunnen niet doorgaan met dit specifieke onderwerp. Als je andere vragen of onderwerpen hebt die je wilt verkennen, bewerk dan je bericht of start een nieuw gesprek."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Geen sleutel gevonden. Geef een sleutel op en probeer het opnieuw."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Geen basis-URL gevonden. Geef er een op en probeer het opnieuw."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Ongeldige sleutel opgegeven. Geef een sleutel op en probeer het opnieuw."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Opgegeven sleutel voor {0} is verlopen op {1}. Geef een sleutel op en probeer het opnieuw."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Je hebt het maximale aantal tokens voor je licentie bereikt. Neem contact op met sales via {0} voor verdere hulp."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Je hebt {0}% van je toegewezen tokens gebruikt. Neem contact op met {1} voor verdere hulp."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Je licentie is niet beschikbaar. Neem contact op met support voor verdere hulp."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"IPv6-adressen worden niet ondersteund. Gebruik een IPv4-verbinding of neem contact op met support voor verdere hulp."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Er is een fout opgetreden bij het verwerken van je verzoek. Probeer het opnieuw."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Bestand {0} is al succesvol geüpload"},com_files_no_results:{english:"No results.",translated:"Geen resultaten."},com_files_filter:{english:"Search files by name",translated:"Zoek bestanden op naam"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} van {1} bestand(en) geselecteerd"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Selecteer een Assistent"},com_sidepanel_parameters:{english:"Parameters",translated:"Parameters"},com_ui_create_assistant:{english:"Create Assistant",translated:"Assistent maken"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Gebruiker heeft toestemming nodig om een Assistent te maken"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Assistenten"},com_sidepanel_attach_files:{english:"File Manager",translated:"Bestandsbeheer"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Beheer Bestanden"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Toestemming"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Je staat op het punt deze assistent te delen met andere teamleden. Voordat je deze assistent deelt, bekijk de onderstaande kernpunten:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Door verder te gaan, bevestig je dat je deze voorwaarden begrijpt en accepteert."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Gedeelde assistent mag geen gevoelige of vertrouwelijke gegevens bevatten."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Gedeelde assistenten mogen geen gevoelige of vertrouwelijke gegevens verwerken."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Delen impliceert verantwoordelijkheid voor de inhoud en toegang."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Het is aanbevolen om te delen met een specifiek team of gesloten groep in plaats van iedereen."},com_button_accept:{english:"Accept",translated:"Accepteren"},com_button_decline:{english:"Decline",translated:"Weigeren"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Kennisbank"},com_assistants_file_search:{english:"File Search",translated:"Bestand Zoeken"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Voeg hier bestanden toe die uw assistent moet doorzoeken bij het beantwoorden van vragen in de chat."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Ondersteund:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Tip:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Vraag uw assistent om de 'Bestand Zoeken Tool' te gebruiken bij elke reactie."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Het koppelen van vectoropslag voor Bestand Zoeken wordt nog niet ondersteund. U kunt ze koppelen vanuit de Provider Playground of bestanden aan berichten toevoegen voor zoekopdrachten op threadbasis."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Er ging iets mis bij het ophalen van bestanden uit de vectoropslag."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Kennisbank"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Upload bestanden naar uw assistent, zodat deze ze kan gebruiken om vragen te beantwoorden (bijv. CXNGPT Gebruikershandleiding)"},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Klik op Maken om uw Assistent op te slaan, upload vervolgens uw bestanden en klik op Opslaan."},com_assistants_image_vision:{english:"Image Vision",translated:"Beeldherkenning"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Code Interpreter"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Voeg hier bestanden toe die uw assistent moet gebruiken om gegevens te analyseren of te transformeren voor elke chat."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Ondersteund:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Tips:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Vraag uw assistent om de 'Code Interpreter Tool' te gebruiken bij elke reactie."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} van {1} bestanden geüpload"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"De volgende bestanden zijn alleen beschikbaar voor Code Interpreter:"},com_assistants_retrieval:{english:"Retrieval",translated:"Ophalen"},com_assistants_search_name:{english:"Search assistants by name",translated:"Zoek assistenten op naam"},com_assistants_tools:{english:"Tools",translated:"Hulpmiddelen"},com_assistants_actions:{english:"Actions",translated:"Acties"},com_assistants_add_tools:{english:"Add Tools",translated:"Hulpmiddelen toevoegen"},com_assistants_add_actions:{english:"Add Actions",translated:"Acties toevoegen"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Bestand zoeken is niet ingeschakeld voor dit model. Selecteer een ander model."},com_assistants_available_actions:{english:"Available Actions",translated:"Beschikbare acties"},com_assistants_running_action:{english:"Running action",translated:"Actie uitvoeren"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Gesproken met {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"Uitgevoerd {0}"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Assistent gebruikte {0}"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Assistent stuurde deze info naar {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Verwijderen alleen toegestaan bij privé-assistenten"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Actie succesvol verwijderd van assistent"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Actie succesvol aangemaakt of bijgewerkt"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Er is een fout opgetreden bij het aanmaken of bijwerken van de actie."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Er is een fout opgetreden bij het verwijderen van de actie."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Laat uw assistent informatie ophalen of acties uitvoeren via API's"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Geef uw assistent een naam (bijv. E-mailgenerator)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Geef uw assistent specifieke, gedetailleerde richtlijnen om zijn gedrag te sturen (bijv. Doel, Rol, Acties, Publiek, Stijl, Regels, Taak, Sjabloon, Voorbeeld)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Beschrijf kort wat uw assistent kan doen (bijv. E-mails genereren vanuit sjabloon)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"U moet een assistent maken voordat u acties kunt toevoegen."},com_assistants_update_success:{english:"Successfully updated",translated:"Succesvol bijgewerkt"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Er is een fout opgetreden bij het bijwerken van uw assistent."},com_assistants_create_success:{english:"Successfully created",translated:"Succesvol aangemaakt"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Er is een fout opgetreden bij het aanmaken van uw assistent."},com_assistants_loading:{english:"Loading assistants...",translated:"Assistenten laden..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Geef een reden op voor het inschakelen van PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Instellingen & Privacy"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"PII Redactie"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"PII-redactie is standaard ingeschakeld voor de modeloproepen van deze assistent."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Het toestaan van PII schakelt redactie uit voor de modeloproepen van deze assistent. U bent verantwoordelijk voor naleving van de gegevensbeleid van uw organisatie. Activiteit wordt volledig gelogd en gemonitord."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Leg uw reden uit voor het inschakelen van PII (verplicht)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Minimale lengte is {0} tekens."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Maximale lengte is {0} tekens."},com_ui_date_today:{english:"Today",translated:"Vandaag"},com_ui_date_yesterday:{english:"Yesterday",translated:"Gisteren"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Vorige 7 dagen"},com