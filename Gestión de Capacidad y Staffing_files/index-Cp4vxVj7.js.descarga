-clear"},com_ui_import_conversation:{english:"Import",translated:"I-import"},com_ui_nothing_found:{english:"Nothing found",translated:"Walang nahanap"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Pumunta sa usapan"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"I-import ang mga usapan mula sa JSON file"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Matagumpay na na-import ang mga usapan"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Nagkaroon ng error sa pag-import ng iyong mga usapan"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Hindi suportadong uri ng import"},com_ui_confirm_action:{english:"Confirm Action",translated:"Kumpirmahin ang Aksyon"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Hindi Kilala"},com_ui_result:{english:"Result",translated:"Resulta"},com_ui_image_gen:{english:"Image Gen",translated:"Paglikha ng Imahe"},com_ui_assistant:{english:"Assistant",translated:"Katulong"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Matagumpay na natanggal ang katulong"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Nagkaroon ng error sa pagtanggal ng katulong"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Natukoy ang dobleng file."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Nagkaroon ng error sa pag-upload ng file."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Nagkaroon ng error sa pag-upload ng file: Hindi natukoy ang endpoint"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Hindi pinapayagan ang walang laman na mga file."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Maaari ka lamang mag-upload ng hanggang {0} file sa isang pagkakataon."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Maaari ka lamang mag-upload ng hanggang {0} file sa seksyong ito."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Naabot na ang limitasyon ng pag-upload para sa {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Hindi matukoy ang uri ng file para sa: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Hindi suportado ang uri ng file. Mangyaring mag-upload ng suportadong format ng file."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Nabigo ang pag-load ng imahe"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Sa kasalukuyan, tanging mga JPEG, JPG, PNG, at WEBP file lamang ang suportado."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Lumampas ang laki ng file sa {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Ang kabuuang laki ng mga file ay hindi maaaring lumampas sa {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Nagkaroon ng error sa pag-validate ng file."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Nagkaroon ng error sa pagproseso ng file."},com_ui_assistants:{english:"Assistants",translated:"Mga Katulong"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Tulong sa Studio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Kaalaman"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Hindi Nakategorya"},com_ui_attachment:{english:"Attachment",translated:"Kalakip"},com_ui_assistants_output:{english:"Assistants Output",translated:"Output ng Mga Katulong"},com_ui_delete:{english:"Delete",translated:"Tanggalin"},com_ui_create:{english:"Create",translated:"Gumawa"},com_ui_share:{english:"Share",translated:"Ibahagi"},com_ui_copy_link:{english:"Copy link",translated:"Kopyahin ang link"},com_ui_update_link:{english:"Update link",translated:"I-update ang link"},com_ui_create_link:{english:"Create link",translated:"Gumawa ng link"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Ibahagi ang link sa chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"Nagkaroon ng error sa pagbabahagi ng chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Ang iyong pangalan at anumang mensahe na idinagdag mo pagkatapos magbahagi ay mananatiling pribado."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"Nagawa na ang pampublikong link sa iyong chat. Pamahalaan ang mga dating ibinahaging chat anumang oras sa pamamagitan ng Mga Setting."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Ang iyong pangalan, mga custom na tagubilin, at anumang mensahe na idinagdag mo pagkatapos magbahagi ay mananatiling pribado."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"Na-update na ang pampublikong link sa iyong chat. Pamahalaan ang mga dating ibinahaging chat anumang oras sa pamamagitan ng Mga Setting."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Hindi makita ang ibinahaging link"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Tanggalin ang chat?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Tatanggalin ito"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Sigurado ka bang gusto mong tanggalin ang Katulong na ito? Hindi na ito maibabalik."},com_ui_rename:{english:"Rename",translated:"Palitan ng pangalan"},com_ui_more_options:{english:"More",translated:"Higit pa"},com_ui_preview:{english:"Preview",translated:"I-preview"},com_ui_upload:{english:"Upload",translated:"I-upload"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Ang pag-upload ng "{0}" ay mas matagal kaysa inaasahan. Mangyaring maghintay habang natatapos ang pag-index ng file para sa pagkuha.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Patakaran sa Privacy"},com_ui_terms_of_service:{english:"Terms of service",translated:"Mga tuntunin ng serbisyo"},com_ui_use_micrphone:{english:"Use microphone",translated:"Gamitin ang mikropono"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Hindi maalis ang higit pang halaga, kinakailangan ang minimum na {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Pinakamataas na bilang na pinapayagan ay {0}, gamit ang pinakabagong mga halaga."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Hindi makapag-login gamit ang ibinigay na impormasyon. Paki-check ang iyong mga kredensyal at subukang muli."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Naabot mo na ang bilang ng pinapayagang pagtatangka sa pag-login. Subukang muli sa loob ng 15 minuto."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Ang iyong account ay pansamantalang na-ban dahil sa mga paglabag sa aming serbisyo."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Nagkaroon ng panloob na error sa server. Paki-antay ng ilang sandali at subukang muli."},com_auth_sign_in:{english:"Login",translated:"Mag-login"},com_endpoint_system_message:{english:"System Message",translated:"Mensahe ng Sistema"},com_endpoint_message:{english:"Message",translated:"Mensahe"},com_endpoint_messages:{english:"Messages",translated:"Mga Mensahe"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"I-edit ang iyong mensahe o I-regenerate."},com_endpoint_default_blank:{english:"default: blank",translated:"default: blangko"},com_endpoint_default_false:{english:"default: false",translated:"default: mali"},com_endpoint_default_creative:{english:"default: creative",translated:"default: malikhaing"},com_endpoint_default_empty:{english:"default: empty",translated:"default: walang laman"},com_endpoint_default_with_num:{english:"default: {0}",translated:"default: {0}"},com_endpoint_context:{english:"Context",translated:"Konteksto"},com_endpoint_tone_style:{english:"Tone Style",translated:"Estilo ng Tono"},com_endpoint_token_count:{english:"Token count",translated:"Bilang ng Token"},com_endpoint_output:{english:"Output",translated:"Output"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Pinakamataas na Konteksto ng Token"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Ang pinakamataas na bilang ng mga token na maaaring gamitin para sa konteksto. Gamitin ito para kontrolin kung ilang token ang ipapadala kada kahilingan.
  Kung hindi tinukoy, gagamitin ang default ng sistema batay sa kilalang laki ng konteksto ng mga modelo. Ang pag-set ng mas mataas na halaga ay maaaring magresulta sa mga error at/o mas mataas na gastos sa token.`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Itakda ang mga custom na tagubilin o konteksto. Hindi papansinin kung walang laman."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Pinapalitan ang mga tagubilin ng assistant. Kapaki-pakinabang ito para baguhin ang kilos sa bawat takbo."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Mag-set ng karagdagang tagubilin o konteksto sa ibabaw ng pangunahing tagubilin ng Assistant. Hindi pinapansin kung walang laman."},com_endpoint_custom_name:{english:"Custom Name",translated:"Pasadyang Pangalan"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Pasadyang Tagubilin"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Karagdagang Tagubilin"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Palitan ang Tagubilin"},com_endpoint_temperature:{english:"Temperature",translated:"Temperatura"},com_endpoint_default:{english:"default",translated:"default"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Max Output Tokens"},com_endpoint_stop:{english:"Stop Sequences",translated:"Itigil ang Mga Serye"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Paghiwalayin ang mga halaga sa pamamagitan ng pagpindot sa `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Opsyonal na `max_tokens` na field, na kumakatawan sa maximum na bilang ng mga token na maaaring mabuo sa chat completion.\n\nAng kabuuang haba ng input tokens at generated tokens ay limitado ng haba ng konteksto ng mga modelo. Maaaring makaranas ka ng mga error kung ang bilang na ito ay lumampas sa max context tokens."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Mas mataas na halaga = mas random, habang mas mababang halaga = mas nakatuon at deterministiko. Inirerekomenda naming baguhin ito o Top P ngunit hindi pareho."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Ang max na tokens na bubuuin. Ang kabuuang haba ng input tokens at generated tokens ay limitado ng haba ng konteksto ng modelo."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Isang alternatibo sa sampling na may temperatura, tinatawag na nucleus sampling, kung saan isinaalang-alang ng modelo ang mga resulta ng mga token na may top_p probability mass. Kaya't ang 0.1 ay nangangahulugang tanging ang mga token na bumubuo sa top 10% probability mass ang isasaalang-alang. Inirerekomenda naming baguhin ito o temperatura ngunit hindi pareho."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Numero sa pagitan ng 0 at 2.0. Ang mga positibong halaga ay nagpaparusa sa mga bagong token batay sa kanilang umiiral na dalas sa teksto sa ngayon, na binabawasan ang posibilidad ng modelo na ulitin ang parehong linya nang literal."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Numero sa pagitan ng 0 at 2.0. Ang mga positibong halaga ay nagpaparusa sa mga bagong token batay sa kung sila ay lumilitaw sa teksto sa ngayon, na nagpapataas ng posibilidad ng modelo na pag-usapan ang mga bagong paksa."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Ipadala muli ang lahat ng dating nakalakip na mga file. Tandaan: tataas nito ang gastos sa token at maaaring makaranas ka ng mga error sa maraming attachment."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Ang resolusyon para sa mga kahilingan sa Vision. Ang "Low" ay mas mura at mas mabilis, ang "High" ay mas detalyado at mas mahal, at ang "Auto" ay awtomatikong pipili sa pagitan ng dalawa batay sa resolusyon ng imahe.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Hanggang sa 4 na serye kung saan titigil ang API sa pagbuo ng karagdagang mga token."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Mag-set ng pasadyang pangalan para sa iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Mag-set ng pasadyang tagubilin para isama sa System Message. Default: wala"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Parusa sa Dalas"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Parusa sa Presensya"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Gamitin ang Mga Function"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Ipadala Muli ang Mga File"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Detalye ng Larawan"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Laktawan ang Pagkumpleto"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Itakda ang mga pasadyang tagubilin para isama sa Mensahe ng Sistema. Default: wala"},com_endpoint_import:{english:"Import",translated:"I-import"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Magtakda ng pasadyang pangalan, kung sakaling mahanap mo ang preset na ito"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Sigurado ka bang gusto mong tanggalin ang preset na ito?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Preset Na-import!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Nagkaroon ng error sa pag-import ng iyong preset. Pakisubukang muli."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Nagkaroon ng error sa pag-save ng iyong preset. Pakisubukang muli."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Nagkaroon ng error sa pagtanggal ng iyong preset. Pakisubukang muli."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"hindi na ang default na preset."},com_endpoint_preset_default_item:{english:"Default:",translated:"Default:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Walang aktibong default na preset."},com_endpoint_preset_title:{english:"Preset",translated:"Preset"},com_endpoint_preset_saved:{english:"Saved!",translated:"Nai-save!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"ay ngayon ang default na preset."},com_endpoint_preset:{english:"preset",translated:"preset"},com_endpoint_presets:{english:"presets",translated:"mga preset"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Aktibo!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Pangalan ng Preset"},com_endpoint:{english:"Endpoint",translated:"Endpoint"},com_endpoint_examples:{english:" Presets",translated:" Mga Preset"},com_endpoint_export:{english:"Export",translated:"I-export"},com_endpoint_export_share:{english:"Export/Share",translated:"I-export/Ibahagi"},com_endpoint_assistant:{english:"Assistant",translated:"Katulong"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Gamitin ang Aktibong Katulong"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"I-save Bilang Preset"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Sigurado ka bang nais mong burahin ang lahat ng presets? Hindi na ito maibabalik."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Wala pang presets, gamitin ang pindutan ng mga setting upang lumikha ng isa"},com_endpoint_my_preset:{english:"My Preset",translated:"Aking Preset"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Modelo ng Ahente (Inirerekomenda: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Modelo ng Pagkumpleto (Inirerekomenda: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Paganahin ang paggamit ng Plugins bilang OpenAI Functions"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Paganahin ang pag-skip sa hakbang ng pagkumpleto, na nire-review ang huling sagot at mga nabuong hakbang"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Mangyaring pumili ng Katulong at magsimula ng bagong chat"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Itakda ang iyong Key sa Header menu upang makipag-chat."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Mangyaring Pumili ng Katulong"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Maligayang Pagdating sa iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Teksto sa Boses"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Awtomatikong I-play ang Pinakabagong Mensahe"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Boses sa Teksto"},com_nav_profile_picture:{english:"Profile Picture",translated:"Larawan ng Profile"},com_nav_change_picture:{english:"Change picture",translated:"Palitan ang larawan"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Ipakita ang Mga Setting ng Ahente"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Ipakita ang Mga Setting ng Pagkumpleto"},com_hide_examples:{english:"Hide Examples",translated:"Itago ang mga Halimbawa"},com_show_examples:{english:"Show Examples",translated:"Ipakita ang mga Halimbawa"},com_nav_export_filename:{english: