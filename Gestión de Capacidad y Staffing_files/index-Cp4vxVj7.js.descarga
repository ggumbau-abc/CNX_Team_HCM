sh:"Edit memory",translated:"Editar memória"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Excluir memória"},com_nav_memory_save:{english:"Save",translated:"Salvar"},com_nav_memory_cancel:{english:"Cancel",translated:"Cancelar"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Salvo {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — mais recente modelo de raciocínio GPT-5 com inteligência de ponta."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — variante compacta e econômica do GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — modelo mais recente da geração GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Último Opus — inteligência de ponta para agentes de codificação e fluxos de trabalho empresariais."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Último Opus — inteligência de ponta para agentes de codificação e fluxos de trabalho empresariais."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet aprimorado com melhor raciocínio e seguimento de instruções."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Modelo mais poderoso da Anthropic para tarefas complexas e de múltiplas etapas."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Inteligência e velocidade equilibradas para uma ampla gama de tarefas."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Modelo Claude mais rápido e compacto — ideal para tarefas de alta demanda."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — raciocínio aprimorado e capacidades multimodais."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Modelo carro-chefe de próxima geração da OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 leve — eficiente e rápido para tarefas diárias."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — melhor seguimento de instruções e raciocínio."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 compacto — mais rápido e barato para tarefas simples."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Modelo GPT-4 mais capaz, otimizado para velocidade e custo."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o leve — mais rápido e barato para tarefas simples."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Pré-visualização) — modelo Gemini mais capaz com contexto de 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Pré-visualização) — rápido e eficiente com contexto de 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — modelo leve e de baixa latência com contexto de 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Modelo assistente otimizado para voz interna."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"O Auto seleciona o melhor modelo para sua solicitação com base na capacidade e no desempenho."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Em breve"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Preferências de roteamento automático"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Ajuste como o roteador automático equilibra os critérios ao selecionar um modelo para cada turno. Os pesos são normalizados — o equilíbrio relativo é o que importa."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Custo"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Priorize modelos mais baratos com menor custo por token."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Precisão"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Priorize modelos mais robustos para raciocínio complexo."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Velocidade"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Priorize modelos mais rápidos, com menor latência."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Restaurar padrões"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"O tempo de envio do arquivo expirou. Tente novamente em alguns minutos."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Algo deu errado. Aqui está a mensagem de erro específica que encontramos: Ocorreu um erro ao processar sua solicitação. O assistente não está mais disponível. Entre em contato com o administrador."},com_ui_code:{english:"Code",translated:"Código"},com_ui_assistant_share:{english:"Share",translated:"Compartilhar"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Link copiado"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Você não tem acesso a este assistente"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Falha ao copiar o link para a área 