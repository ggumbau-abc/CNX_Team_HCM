as."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Não foi possível carregar memórias. Por favor, tente novamente."},com_nav_memory_retry:{english:"Retry",translated:"Tentar novamente"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Não foi possível adicionar memória. Por favor, tente novamente."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Não foi possível atualizar memória. Por favor, tente novamente."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Não foi possível excluir memória. Por favor, tente novamente."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Excluir esta memória?"},com_nav_memory_delete_button:{english:"Delete",translated:"Excluir"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Editar memória"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Excluir memória"},com_nav_memory_save:{english:"Save",translated:"Salvar"},com_nav_memory_cancel:{english:"Cancel",translated:"Cancelar"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Salvo em {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — modelo de raciocínio GPT-5 mais recente com inteligência de ponta."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — variante compacta e económica do GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — modelo da última geração GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Último Opus — inteligência de ponta para agentes de codificação e fluxos de trabalho empresariais."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Último Opus — inteligência de ponta para agentes de codificação e fluxos de trabalho empresariais."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet melhorado com raciocínio e seguimento de instruções aprimorados."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Modelo mais poderoso da Anthropic para tarefas complexas e de múltiplas etapas."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Inteligência e velocidade equilibradas para uma ampla gama de tarefas."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Modelo Claude mais rápido e compacto — ideal para tarefas de alto rendimento."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — capacidades de raciocínio e multimodal melhoradas."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Modelo de próxima geração principal da OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 leve — eficiente e rápido para tarefas diárias."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — melhor seguimento de instruções e raciocínio."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 compacto — mais rápido e económico para tarefas simples."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Modelo GPT-4 mais capaz, otimizado para velocidade e custo."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o leve — mais rápido e económico para tarefas simples."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Pré-visualização) — modelo Gemini mais capaz com contexto de 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Pré-visualização) — rápido e eficiente com contexto de 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — modelo leve e de baixa latência com contexto de 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Modelo interno otimizado para assistente de voz."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"O Auto seleciona o melhor modelo para o seu pedido com base na capacidade e no desempenho."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Brevemente"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Preferências de encaminhamento automático"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Ajuste como o encaminhador Automático equilibra os compromissos ao selecionar um modelo para cada turno. Os pesos são normalizados — o equilíbrio relativo é o que importa."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Custo"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Favorece modelos mais baratos com menor custo por token."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Precisão"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Favorece modelos mais robustos para raciocínio complexo."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Velocidade"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Favorece modelos mais rápidos, com menor latência."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Repor predefinições"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Tempo limite do carregamento do ficheiro excedido. Por favor, tente novamente dentro de alguns minutos."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Algo correu mal. Eis a mensagem de erro específica que encontrámos: Ocorreu um erro ao processar o seu pedido. O assistente já não está disponível. Contacte o administrador."},com_ui_code:{english:"Code",translated:"Código"},com_ui_assistant_share:{english:"Share",translated:"Partilhar"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Link copiado"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Não tem acesso a este assistente"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Falha ao copiar a ligação para a área de transferência"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Pré-visualização indisponível — geração de conteúdo não foi concluída."},com_ui_view_code:{english:"View code",translated:"Ver código"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Pré-visualização indisponível — conteúdo inválido."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Número de Telefone"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Endereço de Email"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Cartão de Crédito"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"NIF"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"O carregamento está a demorar mais do que o esperado - a tentar novamente ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Problema de ligação - a tentar novamente ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Falha no carregamento - por favor, verifique a sua ligação e tente novamente"},com_assistants_memory_enabled:{english:"Memory",translated:"Memória"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"A memória está ativada para este assistente. O assistente pode armazenar e recordar factos entre conversas."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"A memória está desativada para este assistente. Não serão armazenados nem recordados factos entre conversas."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Explique a justificação empresarial para desativar a memória (obrigatório)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Forneça uma justificação para desativar a memória."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"A memória está desativada para a sua equipa. Pode ver e eliminar memórias existentes, mas não pode adicionar nem editar novas."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"A executar o seu código"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"A pesquisar na base de conhecimento"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"A processar voz"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"A guardar na memória"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"A remover da memória"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Pesquisa na web concluída"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Revisão da página web concluída"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"Imagem gerada"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Cálculo concluído"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"Execução do seu código concluída"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"Pesquisa na base de conhecimento concluída"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"Processamento de entrada de voz concluído"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"Guardado na memória"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"Removido da memória"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"Concluído: {0}"},com_ui_still_working:{english:"still working...",translated:"ainda a trabalhar..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} está pronto"},com_ui_file_ready_fallback:{english:"File is ready",translated:"O ficheiro está pronto"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"{0} não pôde ser processado"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"O ficheiro não pôde ser processado"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"{0} não pôde ser processado. Carregue novamente o ficheiro."},com_ui_file_processing_failed_reu