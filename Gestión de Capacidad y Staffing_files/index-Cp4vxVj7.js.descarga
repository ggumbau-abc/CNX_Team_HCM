s:{english:"Settings",translated:"Tetapan"},com_nav_search_placeholder:{english:"Search messages",translated:"Cari mesej"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Hantar teks automatik (selepas 3 saat)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Ralat memainkan audio: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Ralat memproses audio: {0}"},com_nav_engine:{english:"Engine",translated:"Enjin"},com_nav_browser:{english:"Browser",translated:"Pelayar"},com_nav_external:{english:"External",translated:"Luaran"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Padam storan cache"},com_nav_voice_select:{english:"Voice",translated:"Suara"},com_nav_setting_general:{english:"General",translated:"Umum"},com_nav_setting_speech:{english:"Speech",translated:"Ucapan"},com_nav_language:{english:"Language",translated:"Bahasa"},com_nav_lang_auto:{english:"Auto detect",translated:"Pengesanan automatik"},com_page_not_found:{english:"Page not found",translated:"Halaman tidak dijumpai"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Ada masalah"},com_unauthorized_access:{english:"Unauthorized access",translated:"Akses tidak dibenarkan"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Akses tidak dibenarkan. Akses terhad kepada domain tertentu."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Akaun anda telah digantung sementara kerana melanggar perkhidmatan kami"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Anda dihadkan untuk mengakses aplikasi di luar rangkaian!"},com_support_ticket_text:{english:"Support Ticket",translated:"Tiket Sokongan"},com_help_dialog_Header:{english:"Need assistance?",translated:"Perlu bantuan?"},com_help_dialog_text_1_1:{english:"Click",translated:"Klik"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"untuk arahan terperinci"},com_help_dialog_text_here:{english:"here",translated:"di sini"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Untuk isu, isi"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Untuk isu, hubungi"},com_help_dialog_text_ticket:{english:"ticket",translated:"tiket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Cari langkah"},com_status_ind_none:{english:"Operational",translated:"Beroperasi"},com_status_ind_minor:{english:"Minor Issues",translated:"Isu Kecil"},com_status_ind_major:{english:"Major Issues",translated:"Isu Besar"},com_status_ind_critical:{english:"Critical",translated:"Kritikal"},com_status_ind_error:{english:"Error Fetching",translated:"Ralat Memuatkan"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Sila ambil perhatian bahawa apabila anda meninggalkan sembang atau memulakan sembang baru, anda akan kehilangan sejarah perbualan anda."},com_forbidden_access:{english:"Forbidden access",translated:"Akses dilarang"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Polisi Penggunaan Boleh Diterima"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Polisi Privasi"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Perjanjian Langganan"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Sebelum menggunakan iX Hello, anda boleh menyemak "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Dengan mendaftar dan/atau memasuki, anda bersetuju dengan terma di atas."},com_login_page_and:{english:"and ",translated:"dan "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Tiada pembantu yang dipin"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Pembantu yang dipin"},com_ui_loading:{english:"Loading...",translated:"Memuatkan..."},com_ui_unpin:{english:"Unpin",translated:"Nyahpin"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Pembantu berjaya dinyahpin"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Ralat membuka pin pembantu"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Pembantu berjaya dipin"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Ralat memin/membuka pin pembantu"},com_ui_pin:{english:"Pin",translated:"Pin"},come_create_assistant:{english:"Create Assistant",translated:"Cipta Pembantu"},come_edit_assistant:{english:"Edit Assistant",translated:"Edit Pembantu"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Adakah anda pasti mahu meneruskan? Ini akan menyebabkan kehilangan sebarang perubahan yang dibuat pada Pembantu yang sedang anda edit atau cipta. Tindakan ini tidak boleh dibatalkan."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Pembantu dengan id {0} tidak ditemui."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Pelayar tidak menyokong SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Kebenaran mikrofon tidak diberikan"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Ralat memulakan rakaman: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder tidak merakam"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder tidak disokong dalam pelayar ini"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Mesej anda mengandungi maklumat peribadi dan tidak dapat dihantar. Sila keluarkan sebarang maklumat peribadi."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Gagal menamakan semula perbualan"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Anda mempunyai {0} token yang diperuntukkan masih tinggal."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello boleh membuat kesilapan. Sila semak semua output untuk kualiti dan ketepatan. Semua input direkodkan untuk pematuhan."},com_ui_assistant_group_by:{english:"Group by",translated:"Kumpul mengikut"},com_ui_assistant_category:{english:"Category",translated:"Kategori"},com_ui_assistant_team:{english:"Team",translated:"Pasukan"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Kejuruteraan"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Kecerdasan"},com_ui_assistant_marketing:{english:"Marketing",translated:"Pemasaran"},com_ui_assistant_operations:{english:"Operations",translated:"Operasi"},com_ui_assistant_sales:{english:"Sales",translated:"Jualan"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategi"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Pembantu Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Muat naik imej avatar (PNG atau JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Cari Dalam Talian"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Layari Laman Web"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Jana Imej"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Kira Matematik"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Alat Lalai"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Muat naik fail mengambil masa lebih lama daripada jangkaan. Sila cuba lagi."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Ralat menyemat pembantu"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Terdapat ralat memadam pautan yang dikongsi"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Templat DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Tiada pratetap lalai aktif."},com_ui_drag_drop_title:{english:"Add anything",translated:"Tambah apa sahaja"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Letakkan sebarang fail di sini untuk menambahkannya ke dalam perbualan"},com_ui_analyzing:{english:"Analyzing",translated:"Menganalisis"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Selesai menganalisis"},com_ui_warning:{english:"Warning",translated:"Amaran"},com_ui_proceed:{english:"Proceed",translated:"Teruskan"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Fail yang dimuat naik ke pembantu hanya digunakan untuk tujuan perbualan. Pengguna boleh mengakses kandungan fail ini dengan bertanya soalan yang berkaitan, tetapi muat turun langsung fail tidak dibenarkan."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Tetapkan nama tersuai untuk pratetap ini"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Tetapkan input contoh. Contoh diabaikan jika kosong."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Tetapkan output contoh. Contoh diabaikan jika kosong."},com_nav_export_select_type:{english:"Select a file type",translated:"Pilih jenis fail"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"tangkapan skrin (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"teks (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Tiada respons diterima. Sila cuba hantar mesej anda sekali lagi. Jika masalah berterusan selepas memuat semula halaman dan mencuba semula, sila hubungi sokongan."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Kembali ke Sembang"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Pengawalan Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Pengawalan guardrail diaktifkan untuk pembantu ini. Kandungan akan diperiksa mengikut dasar pemoderatan."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Mematikan pengawalan guardrail menghapuskan pemeriksaan pemoderatan kandungan untuk pembantu ini. Anda bertanggungjawab untuk mematuhi dasar kandungan organisasi anda. Aktiviti direkod dan dipantau sepenuhnya."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Sila jelaskan justifikasi perniagaan anda untuk mematikan pengawalan guardrail (diperlukan)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Sila berikan justifikasi untuk mematikan pengawalan guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Benarkan pengguna menukar model dalam sembang"},com_ui_feedback_good:{english:"Good response",translated:"Respons yang baik"},com_ui_feedback_bad:{english:"Poor response",translated:"Respons yang buruk"},com_ui_feedback_comments:{english:"Comments",translated:"Ulasan"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Ulasan (pilihan)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Ceritakan lebih lanjut tentang pengalaman anda..."},com_ui_feedback_submit:{english:"Submit",translated:"Hantar"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Kami tidak dapat menghantar maklum balas anda"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Tidak tepat"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Tidak relevan"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Lapuk"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Tidak cukup butiran"},com_ui_feedback_reason_other:{english:"Other",translated:"Lain-lain"},com_ui_model_recommended:{english:"Recommended",translated:"Disyorkan"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Lama — sila kemas kini"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Model ini tidak lagi disokong. Sila pilih model semasa."},com_nav_setting_memory:{english:"Memory",translated:"Memori"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Urus fakta peribadi yang diingati pembantu dalam perbualan anda."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Tambah memori baharu…"},com_nav_memory_add_button:{english:"Add memory",translated:"Tambah memori"},com_nav_memory_category:{english:"Category",translated:"Kategori"},com_nav_memory_category_preference:{english:"Preference",translated:"Keutamaan"},com_nav_memory_category_identity:{english:"Identity",translated:"Identiti"},com_nav_memory_category_context:{english:"Context",translated:"Konteks"},com_nav_memory_category_project:{english:"Project",translated:"Projek"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Tiada memori lagi"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Memori yang anda simpan akan muncul di sini dan membantu memperibadikan perbualan masa depan."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Tidak dapat memuatkan memori. Sila cuba lagi."},com_nav_memory_retry:{english:"Retry",translated:"Cuba semula"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Tidak dapat menambah memori. Sila cuba lagi."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Tidak dapat mengemas kini memori. Sila cuba lagi."},com_nav_memory_delete_error:{english:"Could not delete memory.