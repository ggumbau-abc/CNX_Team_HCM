,translated:"Предпросмотр"},com_ui_upload:{english:"Upload",translated:"Загрузить"},com_ui_share:{english:"Share",translated:"Share"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Share link to chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"There was an error sharing the chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Your name and any messages you add after sharing stay private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been created. Manage previously shared chats at any time via Settings."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Your name, custom instructions, and any messages you add after sharing stay private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Shared link not found"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Удалить чат?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Будет удален следующий чат: "},com_ui_rename:{english:"Rename",translated:"Переименовать"},com_ui_more_options:{english:"More",translated:"Еще"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Не удалось войти с предоставленной информацией. Пожалуйста, проверьте ваши учетные данные и попробуйте снова."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Слишком много попыток входа в систему за короткий промежуток времени. Пожалуйста, повторите попытку позже."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Ваша учетная запись была временно заблокирована в связи с нарушениями нашего сервиса."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Произошла внутренняя ошибка сервера. Пожалуйста, подождите несколько минут и повторите попытку."},com_auth_sign_in:{english:"Login",translated:"Войти"},com_endpoint_system_message:{english:"System Message",translated:"Системное сообщение"},com_endpoint_message:{english:"Message",translated:"Сообщение"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Отредактируйте свое сообщение или перегенерируйте."},com_endpoint_default_blank:{english:"default: blank",translated:"по умолчанию: пусто"},com_endpoint_default_false:{english:"default: false",translated:"по умолчанию: false"},com_endpoint_default_creative:{english:"default: creative",translated:"по умолчанию: креативный"},com_endpoint_default_empty:{english:"default: empty",translated:"по умолчанию: пусто"},com_endpoint_default_with_num:{english:"default: {0}",translated:"по умолчанию: {0}"},com_endpoint_context:{english:"Context",translated:"Контекст"},com_endpoint_tone_style:{english:"Tone Style",translated:"Стиль тона"},com_endpoint_token_count:{english:"Token count",translated:"Количество токенов"},com_endpoint_output:{english:"Output",translated:"Вывод"},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Задайте пользовательские инструкции или контекст. Игнорируется, если пусто."},com_endpoint_custom_name:{english:"Custom Name",translated:"Кастомное имя"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Префикс промта"},com_endpoint_temperature:{english:"Temperature",translated:"Температура"},com_endpoint_default:{english:"default",translated:"по умолчанию"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Максимальное количество выводимых токенов"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Более высокие значения = более случайные результаты, более низкие значения = более фокусированные и детерминированные результаты. Мы рекомендуем изменять это или Top P, но не оба значения одновременно."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Максимальное количество генерируемых токенов. Общая длина входных токенов и сгенерированных токенов ограничена длиной контекста модели."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Альтернатива выбору с использованием температуры, называемая выбором по ядру, при которой модель учитывает результаты токенов с наибольшей вероятностью top_p. Таким образом, значение 0,1 означает, что рассматриваются только токены, составляющие верхние 10% вероятностной массы. Мы рекомендуем изменять это или температуру, но не оба значения одновременно."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе их частоты в тексте до сих пор, уменьшая вероятность модели повторить ту же строку дословно."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе того, появляются ли они в тексте до сих пор, увеличивая вероятность модели говорить о новых темах."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Задайте кастомное имя для ChatGPT"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Задайте кастомные промты для включения в системное сообщение. По умолчанию: нет"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Штраф за частоту"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Штраф за присутствие"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Использовать функции"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Пропустить завершение"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Задайте кастомные инструкции для включения в системное сообщение. По умолчанию: нет"},com_endpoint_import:{english:"Import",translated:"Импорт"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Задайте кастомное имя на случай, если вы сможете найти эту предустановку :)"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Вы уверены, что хотите удалить этот пресет?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Пресет Импортирован!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Произошла ошибка при импорте вашего пресета. Пожалуйста, попробуйте еще раз."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Произошла ошибка при сохранении вашего пресета. Пожалуйста, попробуйте еще раз."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Произошла ошибка при удалении вашего пресета. Пожалуйста, попробуйте еще раз."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"больше не пресет по умолчанию."},com_endpoint_preset_default_item:{english:"Default:",translated:"По умолчанию:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Активных пресетов по умолчанию нет."},com_endpoint_preset_title:{english:"Preset",translated:"Пресет"},com_endpoint_preset_saved:{english:"Saved!",translated:"Сохранено!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"теперь пресет По умолчаанию."},com_endpoint_preset:{english:"preset",translated:"пресет"},com_endpoint_presets:{english:"presets",translated:"пресеты"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Активирован!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Имя пресета"},com_endpoint:{english:"Endpoint",translated:"Эндпоинт"},com_endpoint_examples:{english:" Presets",translated:"Примеры"},com_endpoint_export:{english:"Export",translated:"Экспорт"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Сохранить как Пресет"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Вы уверены, что хотите удалить все пресеты? Это действие необратимо и восстановление невозможно."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Пока нет пресетов, используйте кнопку настроек чтобы создать его"},com_endpoint_my_preset:{english:"My Preset",translated:"Мой Пресет"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Модель агента (Рекомендуется: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Модель завершения (Рекомендуется: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Включить использование плагинов как функции OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Пропустить этап завершения, который проверяет окончательный ответ и сгенерированные шаги"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Укажите ваш ключ к API в меню сверху для начала разговора."},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Чем я могу помочь вам сегодня?"},com_nav_export_filename:{english:"Filename",translated:"Имя файла"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Задайте имя файла"},com_nav_export_type:{english:"Type",translated:"Тип"},com_nav_export_conversation:{english:"Export conversation",translated:"Экспортировать разговор"},com_nav_export:{english:"Export",translated:"Экспорт"},com_nav_shared_links:{english:"Shared links",translated:"Связываемые ссылки"},com_nav_shared_links_manage:{english:"Manage",translated:"Управление"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"У вас нет связываемых ссылок."},com_nav_shared_links_name:{english:"Name",translated:"Naam"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Datum gedeeld"},com_nav_my_files:{english:"File Manager",translated:"Мои файлы"},com_nav_admin_center:{english:"Admin Center",translated:"Административный центр"},com_nav_theme:{english:"Theme",translated:"Тема"},com_nav_theme_system:{english:"System",translated:"Системная"},com_nav_theme_dark:{english:"Dark",translated:"Темная"},com_nav_theme_light:{english:"Light",translated:"Светлая"},com_nav_user_name_display:{english:"Display username in messages",translated:"Отображать имя пользователя в сообщениях"},com_nav_language:{english:"Language",translated:"Локализация"},com_nav_profile_picture:{english:"Profile Picture",translated:"Изображение профиля"},com_nav_change_picture:{english:"Change picture",translated:"Изменить изображение"},com_nav_lang_auto:{english:"Auto detect",translated:"Автоопределение"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Удалить все чаты"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Подтвердить удаление"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Закрыть боковую панель"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Открыть боковую панель"},com_nav_send_message:{english:"Send message",translated:"Отправить сообщение"},com_nav_log_out:{english:"Log out",translated:"Выйти"},com_nav_user:{english:"USER",translated:"ПОЛЬЗОВАТЕЛЬ"},com_nav_archived_chats:{english:"Archived chats",translated:"Архивированные чаты"},com_nav_archived_chats_manage:{english:"Manage",translated:"Управление"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"У вас нет архивированных разговоров."},com_nav_archive_name:{english:"Name",translated:"Имя"},com_nav_archive_created_at:{english:"DateCreated",translated:"Дата создания"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Удалить разговоры"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Вы уверены, что хотите удалить все разговоры? Это действие нельзя отменить."},com_nav_help:{english:"Help",translated:"Помощь"},com_nav_settings:{english:"Settings",translated:"Настройки"},com_nav_search_placeholder:{english:"Search messages",translated:"Поиск сообщений"},com_nav_setting_general:{english:"General",translated:"Общие"},com_assistants_knowledge:{english:"Knowledgebase",translated:"База знаний"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Если вы загрузите файлы в раздел Знания, разговоры с вашим ассистентом могут включать содержимое файлов."},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Ассистент должен быть сохранён, и Интерпретатор кода (Code Interpreter) или Поиск (Retrieval) должны быть включены и сохранены перед загрузкой файлов к Базе Знаний."},com_assistants_retrieval:{english:"Retrieval",translated:"Поиск (Retrieval)"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Необязательно: имя ассистента"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Системные инструкции, которые использует ассистент"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Необязательно: описание вашего ассистента"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Вам нужно сохранить ассистента, прежде чем добавлять Actions."},com_assistants_update_success:{english:"Successfully updated",translated:"Успешно обновлено"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Произошла ошибка при обновлении вашего ассистента."},com_assistants_create_success:{english:"Successfully created",translated:"Успешно сохранено"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Произошла ошибка при сохранении вашего ассистента."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Неподдерживаемый тип файла для этого режима:"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Превышен лимит размера файла для этого режима:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Невозможно прикрепить файл. Создайте новый или выберите разговор, или попробуйте обновить страницу."},com_ui_name:{english:"Name",translated:"Имя"},com_ui_instructions:{english:"Instructions",translated:"Инструкции"},com_ui_description:{english:"Description",translated:"Описание"},com_ui_category:{english:"Category",translated:"---"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Assign a business category to help filter and organize assistants by function."},com_ui_error:{english:"Error",translated:"Ошибка"},com_ui_select:{english:"Select",translated:"Выбрать"},com_ui_upload_files:{english:"Upload files",translated:"Загрузить файлы"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Произошла ошибка при загрузке вашего файла"},com_user_message:{english:"You",translated:"Вы"},com_assistants_file_search:{english:"File Search",translated:"Поиск файлов"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Поиск файлов в сообщениях"},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Поддерживаемые форматы:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Советы по поиску:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Используйте ключевые слова, чтобы найти файлы в сообщениях."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Прикрепление векторных хранилищ для Поиска по файлам пока не поддерживается. Вы можете прикрепить их из Песочницы провайдера или прикрепить файлы к сообщениям для поиска по файлам в отдельных диалогах."},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Поиск по файлам недоступен для этой модели. Пожалуйста, выберите другую модель."},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Невозможно прикрепить файлы ассистента к другим режимам"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Ассистент успешно удален"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Произошла ошибка при удалении ассистента"},com_ui_copied:{english:"Copied!",translated:"Скопировано"},com_ui_copy_code:{english:"Copy code",translated:"Копировать код"},com_ui_copy_link:{english:"Copy link",translated:"Копировать ссылку"},com_ui_update_link:{english:"Update link",translated:"Обновить ссылку"},com_ui_create_link:{english:"Create link",translated:"Создать ссылку"},com_nav_source_chat:{english:"View source chat",translated:"Просмотреть исходный чат"},com_ui_date_today:{english:"Today",translated:"Сегодня"},com_ui_date_yesterday:{english:"Yesterday",translated:"Вчера"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Предыдущие 7 дней"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"За последние 30 дней"},com_ui_date_january:{english:"January",translated:"Январь"},com_ui_date_february:{english:"February",translated:"Февраль"},com_ui_date_march:{english:"March",translated:"Март"},com_ui_date_april:{english:"April",translated:"Апрель"},com_ui_date_may:{english:"May",translated:"Май"},com_ui_date_june:{english:"June",translated:"Июнь"},com_ui_date_july:{english:"July",translated:"Июль"},com_ui_date_august:{english:"August",translated:"Август"},com_ui_date_september:{english:"September",translated:"Сентябрь"},com_ui_date_october:{english:"October",translated:"Октябрь"},com_ui_date_november:{english:"November",translated:"Ноябрь"},com_ui_date_december:{english:"December",translated:"Декабрь"},com_ui_nothing_found:{english:"Nothing found",translated:"Ничего не найдено"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Перейти к беседе"},com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"К сожалению, отправленный вами контент был помечен нашей системой модерации как не соответствующий правилам сообщества. Мы не можем продолжить обсуждение этой конкретной темы. Если у вас есть другие вопросы или темы, которые вы хотели бы обсудить, пожалуйста, отредактируйте сообщение или начните новый диалог."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Ключ не найден. Пожалуйста, укажите ключ и повторите попытку."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Базовый URL не найден. Пожалуйста, укажите его и повторите попытку."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Предоставлен некорректный ключ. Пожалуйста, укажите действительный ключ и повторите попытку."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Предоставленный ключ для {0} истек {1}. Пожалуйста, укажите новый ключ и повторите попытку."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Вы достигли месячного лимита использования. Пожалуйста, свяжитесь с администратором команды для получения помощи."},com_files_no_results:{english:"No results.",translated:"Нет результатов"},com_files_filter:{english:"Search files by name",translated:"Искать файлы по имени"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"Выбрано {0} из {1} файл(а/ов)"},com_sidepanel_parameters:{english:"Parameters",translated:"Параметры"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Возможности"},com_assistants_image_vision:{english:"Image Vision",translated:"Анализ изображений"},com_assistants_search_name:{english:"Search assistants by name",translated:"Поиск ассистентов по имени"},com_assistants_tools:{english:"Tools",translated:"Инструменты"},com_assistants_actions:{english:"Actions",translated:"Действия"},com_assistants_add_tools:{english:"Add Tools",translated:"Добавить инструменты"},com_assistants_add_actions:{english:"Add Actions",translated:"Добавить действия"},com_assistants_available_actions:{english:"Available Actions",translated:"Доступные действия"},com_assistants_running_action:{english:"Running action",translated:"Выполняется действие"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Общался с {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"Выполнено: {0}"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Поиск использованных файлов"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Ассистент использовал {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:""}},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:""}},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Ассистент отправил эту информацию {0}"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Действие успешно удалено из ассистента"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Действие успешно создано или обновлено"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Произошла ошибка при создании или обновлении действия."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Произошла ошибка при удалении действия."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Позвольте вашему ассистенту получать информацию или выполнять действия через API"},com_ui_field_required:{english:"This field is required",translated:"Это поле обязательно для заполнения"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Ошибка загрузки файла. Возможно, файл был удален."},com_ui_on:{english:"On",translated:"Вкл."},com_ui_off:{english:"Off",translated:"Выкл."},com_ui_yes:{english:"Yes",translated:"Да"},com_ui_no:{english:"No",translated:"Нет"},com_ui_ascending:{english:"Asc",translated:"По возрастанию"},com_ui_descending:{english:"Desc",translated:"По убыванию"},com_ui_show_all:{english:"Show All",translated:"Показать все"},com_ui_date:{english:"Date",translated:"Дата"},com_ui_storage:{english:"Storage",translated:"Хранилище"},com_ui_context:{english:"Context",translated:"Контекст"},com_ui_size:{english:"Size",translated:"Размер"},com_ui_host:{english:"Host",translated:"Хост"},com_ui_update:{english:"Update",translated:"Обновить"},com_ui_authentication:{english:"Authentication",translated:"Аутентификация"},com_ui_select_search_model:{english:"Search model by name",translated:"Поиск модели по названию"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Поиск плагина по названию"},com_ui_none_selected:{english:"None selected",translated:"Ничего не выбрано"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Упомянуть конечную точку, помощника или предустановку для быстрого переключения"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Неподдерживаемый тип импорта"},com_ui_avatar:{english:"Avatar",translated:"Аватар"},com_ui_unknown:{english:"Unknown",translated:"Неизвестно"},com_ui_result:{english:"Result",translated:"Результат"},com_ui_image_gen:{english:"Image Gen",translated:"Генератор изображений"},com_ui_assistant:{english:"Assistant",translated:"Помощник"},com_ui_assistants:{english:"Assistants",translated:"Ассистенты"},com_ui_attachment:{english:"Attachment",translated:"Вложение"},com_ui_assistants_output:{english:"Assistants Output",translated:"Вывод ассистентов"},com_ui_create:{english:"Create",translated:"Создать"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Вы действительно хотите удалить этого ассистента? Это действие необратимо."},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Загрузка "{0}" занимает больше времени, чем ожидалось. Пожалуйста, подождите, пока файл полностью проиндексируется для доступа.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Политика конфиденциальности"},com_ui_terms_of_service:{english:"Terms of service",translated:"Условия использования"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Нельзя удалить больше значений, требуется минимум {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Максимально допустимое количество - {0}, используются последние значения."},com_endpoint_messages:{english:"Messages",translated:"Сообщения"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Максимальное количество контекстных токенов"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:"Максимальное количество токенов, которое может быть использовано для контекста. Используется для контроля количества токенов, отправляемых за один запрос. Если не указано, будут использованы системные значения по умолчанию, основанные на известном размере контекста моделей. Установка более высоких значений может привести к ошибкам и/или более высокой стоимости токенов."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Переопределяет инструкции для ассистента. Это полезно для изменения поведения для отдельного запуска."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Задайте дополнительные инструкции или контекст сверху основных инструкций ассистента. Игнорируется, если пусто."},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Дополнительные инструкции"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Инструкции для ассистентов"},com_endpoint_stop:{english:"Stop Sequences",translated:"Стоп-последовательности"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Разделяйте значения нажатием `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Необязательное поле `max_tokens`, задающее максимальное количество токенов, которое может быть сгенерировано в ответе чата. Общая длина входных токенов и сгенерированных токенов ограничена длиной контекста модели. Вы можете получить ошибку, если это число превысит максимальную длину контекста."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Повторно отправить все ранее прикрепленные файлы. Примечание: это увеличит расход токенов, и при большом количестве вложений могут возникнуть ошибки."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Разрешение для запросов Vision. "Низкое" - дешевле и быстрее, "Высокое" - более детализировано и дорогое, а "Авто" автоматически выберет один из двух вариантов в зависимости от разрешения изображения.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"До 4 последовательностей, после которых API прекратит генерировать дальнейшие токены."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Повторить отправку файлов"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Детали изображения"},com_endpoint_assistant:{english:"Assistant",translated:"Ассистент"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Использовать активного ассистента"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Выберите Ассистента в правой боковой панели"},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Выберите ассистента"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Настройки агента"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Показать настройки завершения"},com_hide_examples:{english:"Hide Examples",translated:"Скрыть примеры"},com_show_examples:{english:"Show Examples",translated:"Показать примеры"},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Вы достигли максимального количества токенов для вашей лицензии. Пожалуйста, свяжитесь с отделом продаж по адресу {0} для дальнейшей помощи."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Вы использовали {0}% от выделенных токенов. Пожалуйста, свяжитесь с {1} для дальнейшей помощи."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Ваша лицензия недоступна. Пожалуйста, свяжитесь с поддержкой для дальнейшей помощи."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Адреса IPv6 не поддерживаются. Пожалуйста, используйте соединение IPv4 или свяжитесь с поддержкой для дальнейшей помощи."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Произошла ошибка при обработке вашего запроса. Пожалуйста, попробуйте еще раз."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Файл {0} уже был успешно загружен"},com_ui_create_assistant:{english:"Create Assistant",translated:"Создать Ассистента"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Пользователю нужны права на создание, чтобы создать Ассистента"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Согласие"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Вы собираетесь поделиться этим ассистентом с другими членами команды. Перед тем как поделиться, пожалуйста, ознакомьтесь с ключевыми моментами ниже:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Продолжая, вы подтверждаете, что понимаете и принимаете эти условия."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Общий ассистент не должен содержать конфиденциальные данные."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Общие ассистенты не должны обрабатывать конфиденциальные данные."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Общий доступ подразумевает ответственность за содержание и доступ."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Рекомендуется делиться с конкретной командой или закрытой группой, а не со всеми."},com_button_accept:{english:"Accept",translated:"Принять"},com_button_decline:{english:"Decline",translated:"Отклонить"},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Произошла ошибка при получении файлов из векторных хранилищ."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} из {1} файлов загружено"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Удаление разрешено только для приватных Ассистентов"},com_assistants_loading:{english:"Loading assistants...",translated:"Загрузка ассистентов..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Пожалуйста, укажите причину для включения PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Настройки и Конфиденциальность"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Редакция PII"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"Редакция PII включена по умолчанию для вызовов модели этого ассистента."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Разрешение PII отключает редактирование для вызовов модели этого помощника. Вы несете ответственность за соблюдение политик данных вашей организации. Деятельность полностью логируется и отслеживается."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Пожалуйста, объясните причину включения PII (обязательно)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Минимальная длина - {0} символов."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Максимальная длина - {0} символов."},com_ui_kbot_assistants:{english:"Knowledge",translated:"Знания"},com_ui_assistant_default_category:{english:"General",translated:"Общее"},com_ui_assistant_featured:{english:"Featured",translated:"Рекомендуемые"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Нет помощников, соответствующих критериям поиска."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Помощники не найдены."},com_ui_category_placeholder:{english:"Search a category",translated:"Поиск категории"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Поиск инструмента"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Ошибка подключения к серверу, попробуйте обновить страницу."},com_ui_select_placeholder:{english:"Select options",translated:"Выберите параметры"},com_ui_remove:{english:"Remove",translated:"Удалить"},com_ui_thinking:{english:"Thinking",translated:"Думаю"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Анализ вашего запроса"},com_ui_processing:{english:"Putting it together",translated:"Обработка"},com_ui_working_on_it:{english:"Almost ready",translated:"Работаем над этим"},com_ui_read_aloud:{english:"Read aloud",translated:"Читать вслух"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Обнаружен дубликат файла."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Произошла ошибка при загрузке файла."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Произошла ошибка при загрузке файла: конечная точка не определена"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Пустые файлы не допускаются."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Вы можете загрузить не более {0} файлов за раз."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Вы можете загрузить не более {0} файлов в этом разделе."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Достигнут лимит загрузки для {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Не удалось определить тип файла для: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Тип файла не поддерживается. Загрузите файл в поддерживаемом формате."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Не удалось загрузить изображение"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"В настоящее время поддерживаются только файлы JPEG, JPG, PNG и WEBP."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Размер файла превышает {0} МБ."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Общий размер файлов не может превышать {0} МБ."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Произошла ошибка при проверке файла."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Произошла ошибка при обработке файла."},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Помощь в студии"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Знания"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Без категории"},com_ui_use_micrphone:{english:"Use microphone",translated:"Использовать микрофон"},com_endpoint_export_share:{english:"Export/Share",translated:"Экспорт/Поделиться"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Текст в речь"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Автовоспроизведение последнего сообщения"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Речь в текст"},com_nav_user_guide:{english:"User Guide",translated:"Руководство пользователя"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Автоотправка текста (через 3 сек)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Ошибка воспроизведения аудио: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Ошибка обработки аудио: {0}"},com_nav_engine:{english:"Engine",translated:"Движок"},com_nav_browser:{english:"Browser",translated:"Браузер"},com_nav_external:{english:"External",translated:"Внешний"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Удалить хранилище кеша"},com_nav_voice_select:{english:"Voice",translated:"Голос"},com_nav_setting_speech:{english:"Speech",translated:"Речь"},com_page_not_found:{english:"Page not found",translated:"Страница не найдена"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Что-то пошло не так"},com_unauthorized_access:{english:"Unauthorized access",translated:"Несанкционированный доступ"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Несанкционированный доступ. Доступ ограничен для определенных доменов."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Ваш аккаунт временно заблокирован за нарушение наших условий"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Вы ограничены в доступе к приложению вне сети!"},com_support_ticket_text:{english:"Support Ticket",translated:"Тикет поддержки"},com_help_dialog_Header:{english:"Need assistance?",translated:"Нужна помощь?"},com_help_dialog_text_1_1:{english:"Click",translated:"Нажмите"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"для подробных инструкций"},com_help_dialog_text_here:{english:"here",translated:"здесь"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Для проблем заполните"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Для проблем свяжитесь с"},com_help_dialog_text_ticket:{english:"ticket",translated:"тикет"},com_help_dialog_text_3:{english:"Find the steps",translated:"Найдите шаги"},com_status_ind_none:{english:"Operational",translated:"Работает"},com_status_ind_minor:{english:"Minor Issues",translated:"Незначительные проблемы"},com_status_ind_major:{english:"Major Issues",translated:"Серьезные проблемы"},com_status_ind_critical:{english:"Critical",translated:"Критично"},com_status_ind_error:{english:"Error Fetching",translated:"Ошибка получения"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Обратите внимание, что при выходе из чата или начале нового чата вы потеряете историю переписки."},com_forbidden_access:{english:"Forbidden access",translated:"Запрещенный доступ"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Политика допустимого использования"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Политика конфиденциальности"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Соглашение о подписке"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Перед использованием iX Hello вы можете ознакомиться с "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Регистрируясь и/или входя, вы соглашаетесь с вышеуказанными условиями."},com_login_page_and:{english:"and ",translated:"и "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Нет закрепленных помощников"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Закрепленные помощники"},com_ui_loading:{english:"Loading...",translated:"Загрузка..."},com_ui_unpin:{english:"Unpin",translated:"Открепить"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Помощник успешно откреплен"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Ошибка открепления помощника"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Помощник успешно закреплен"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Ошибка закрепления/открепления помощника"},com_ui_pin:{english:"Pin",translated:"Закрепить"},come_create_assistant:{english:"Create Assistant",translated:"Создать помощника"},come_edit_assistant:{english:"Edit Assistant",translated:"Редактировать помощника"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Вы уверены, что хотите продолжить? Это приведет к потере всех изменений в помощнике, который вы редактируете или создаете. Это действие нельзя отменить."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Помощник с id {0} не найден."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Браузер не поддерживает SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Разрешение на использование микрофона не предоставлено"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Ошибка при запуске записи: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder не записывает"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder не поддерживается в этом браузере"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Ваше сообщение содержит личную информацию и не может быть отправлено. Пожалуйста, удалите любую личную информацию."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Не удалось переименовать разговор"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"У вас осталось {0} из выделенных токенов."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello может допускать ошибки. Пожалуйста, проверяйте все результаты на качество и точность. Все вводы записываются для соблюдения требований."},com_ui_assistant_group_by:{english:"Group by",translated:"Группировать по"},com_ui_assistant_category:{english:"Category",translated:"Категория"},com_ui_assistant_team:{english:"Team",translated:"Команда"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Инженерия"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Интеллект"},com_ui_assistant_marketing:{english:"Marketing",translated:"Маркетинг"},com_ui_assistant_operations:{english:"Operations",translated:"Операции"},com_ui_assistant_sales:{english:"Sales",translated:"Продажи"},com_ui_assistant_strategy:{english:"Strategy",translated:"Стратегия"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Помощники студии"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Загрузите изображение аватара (PNG или JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Поиск в интернете"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Просмотр сайта"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Создание изображений"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Вычисление математики"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Инструмент по умолчанию"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Загрузка файла занимает больше времени, чем ожидалось. Пожалуйста, попробуйте снова."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Ошибка закрепления помощника"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Ошибка при удалении общей ссылки"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Шаблон DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Нет активного предустановленного шаблона."},com_ui_drag_drop_title:{english:"Add anything",translated:"Добавить что угодно"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Перетащите любой файл сюда, чтобы добавить его в беседу"},com_ui_analyzing:{english:"Analyzing",translated:"Анализ..."},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Анализ завершен"},com_ui_warning:{english:"Warning",translated:"Предупреждение"},com_ui_proceed:{english:"Proceed",translated:"Продолжить"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Файлы, загруженные в помощник, используются только для разговорных целей. Пользователи могут получить доступ к содержимому этих файлов, задавая соответствующие вопросы, но прямая загрузка файлов не разрешена."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Установите собственное имя для этого шаблона"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Установите пример ввода. Пример игнорируется, если он пуст."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Установите пример вывода. Пример игнорируется, если он пуст."},com_nav_export_select_type:{english:"Select a file type",translated:"Выберите тип файла"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"скриншот (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"текст (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Ответ не получен. Пожалуйста, попробуйте отправить сообщение снова. Если проблема сохраняется после перезагрузки страницы и повторной попытки, обратитесь в службу поддержки."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Назад к чату"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Модерация ограждений"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Модерация ограждений включена для этого ассистента. Контент будет проверяться на соответствие политике модерации."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Отключение модерации ограждений убирает проверки модерации контента для этого ассистента. Вы несете ответственность за соблюдение политик контента вашей организации. Деятельность полностью регистрируется и контролируется."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Пожалуйста, объясните ваше деловое обоснование для отключения модерации ограждений (обязательно)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Пожалуйста, предоставьте обоснование для отключения модерации ограждений."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Разрешить пользователям менять модель в чате"},com_ui_feedback_good:{english:"Good response",translated:"Хороший ответ"},com_ui_feedback_bad:{english:"Poor response",translated:"Плохой ответ"},com_ui_feedback_comments:{english:"Comments",translated:"Комментарии"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Комментарии (необязательно)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Расскажите нам больше о вашем опыте..."},com_ui_feedback_submit:{english:"Submit",translated:"Отправить"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Не удалось отправить ваш отзыв"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Неверно"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Не по теме"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Устарело"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Недостаточно подробностей"},com_ui_feedback_reason_other:{english:"Other",translated:"Другое"},com_ui_model_recommended:{english:"Recommended",translated:"Рекомендуется"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Устарело — пожалуйста, обновите"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Эта модель больше не поддерживается. Пожалуйста, выберите текущую модель."},com_nav_setting_memory:{english:"Memory",translated:"Память"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Управляйте личными фактами, которые помощник запоминает в ваших разговорах."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Добавить новую память…"},com_nav_memory_add_button:{english:"Add memory",translated:"Добавить память"},com_nav_memory_category:{english:"Category",translated:"Категория"},com_nav_memory_category_preference:{english:"Preference",translated:"Предпочтение"},com_nav_memory_category_identity:{english:"Identity",translated:"Идентичность"},com_nav_memory_category_context:{english:"Context",translated:"Контекст"},com_nav_memory_category_project:{english:"Project",translated:"Проект"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Пока нет воспоминаний"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Сохраненные вами воспоминания появятся здесь и помогут персонализировать будущие разговоры."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Не удалось загрузить воспоминания. Пожалуйста, попробуйте снова."},com_nav_memory_retry:{english:"Retry",translated:"Повторить"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Не удалось добавить память. Пожалуйста, попробуйте снова."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Не удалось обновить память. Пожалуйста, попробуйте снова."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Не удалось удалить память. Пожалуйста, попробуйте снова."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Удалить эту память?"},com_nav_memory_delete_button:{english:"Delete",translated:"Удалить"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Редактировать память"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Удалить память"},com_nav_memory_save:{english:"Save",translated:"Сохранить"},com_nav_memory_cancel:{english:"Cancel",translated:"Отмена"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Сохранено {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — новейшая модель мышления GPT-5 с передовым интеллектом."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — компактный и экономичный вариант GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — последняя модель поколения GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Последний Opus — передовой интеллект для кодирования агентов и рабочих процессов."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Последний Opus — передовой интеллект для кодирования агентов и рабочих процессов."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Улучшенный Sonnet с улучшенным рассуждением и следованием инструкциям."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Самая мощная модель Anthropic для сложных многоэтапных задач."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Сбалансированный интеллект и скорость для широкого круга задач."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Самая быстрая и компактная модель Claude — идеальна для задач с высокой пропускной способностью."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — улучшенные рассуждения и мультимодальные возможности."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Флагманская модель следующего поколения от OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"Легковесный GPT-5 — эффективный и быстрый для повседневных задач."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — улучшенное следование инструкциям и рассуждения."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"Компактный GPT-4.1 — быстрее и дешевле для простых задач."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Самая мощная модель GPT-4, оптимизированная для скорости и стоимости."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"Легковесный GPT-4o — быстрее и дешевле для простых задач."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Предпросмотр) — самая мощная модель Gemini с контекстом 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Предпросмотр) — быстрая и эффективная с контекстом 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — лёгкая модель с малой задержкой и контекстом 1M."},"