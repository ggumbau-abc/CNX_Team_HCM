_preview:"תצוגה מקדימה",com_ui_upload_delay:'העלאת "{0}" לוקחת יותר זמן מהצפוי. אנא המתן בזמן שהקובץ מסיים אינדוקס לשחזור.',com_ui_privacy_policy:"מדיניות פרטיות",com_ui_terms_of_service:"תנאי שירות",com_ui_use_micrphone:"השתמש במיקרופון",com_ui_min_tags:"לא ניתן להסיר יותר ערכים, נדרשים לפחות {0}.",com_ui_max_tags:"המספר המקסימלי המותר הוא {0}, משתמש בערכים האחרונים.",com_endpoint_messages:"הודעות",com_endpoint_context_tokens:"מקסימום אסימוני הקשר",com_endpoint_context_info:`מספר האסימונים המקסימלי שניתן להשתמש בו להקשר. השתמש בזה לשליטה בכמה אסימונים נשלחים לכל בקשה.
  אם לא צוין, ישתמש בברירות המחדל של המערכת על בסיס גודל ההקשר של המודלים הידועים. הגדרת ערכים גבוהים יותר עשויה לגרום לשגיאות ו/או לעלות אסימונים גבוהה יותר.`,com_endpoint_stop:"רצפי עצירה",com_endpoint_stop_placeholder:"הפרד ערכים על ידי לחיצה על `Enter`",com_endpoint_openai_max_tokens:"שדה `max_tokens` אופציונלי, המייצג את המספר המקסימלי של אסימונים שניתן לייצר בהשלמת הצ'אט.\n    \n    האורך הכולל של אסימוני הקלט והאסימונים שנוצרו מוגבל על ידי אורך ההקשר של המודלים. ייתכן שתיתקל בשגיאות אם מספר זה יעלה על מקסימום אסימוני ההקשר.",com_endpoint_openai_resend_files:"שלח מחדש את כל הקבצים המצורפים בעבר. הערה: זה יגדיל את עלות האסימונים וייתכן שתיתקל בשגיאות עם הרבה קבצים מצורפים.",com_endpoint_openai_stop:"עד 4 רצפים שבהם ה-API יפסיק לייצר אסימונים נוספים.",com_endpoint_plug_resend_files:"שלח קבצים מחדש",com_endpoint_import:"ייבוא",com_endpoint_export_share:"ייצוא/שיתוף",com_endpoint_assistant_placeholder:"אנא בחר סייען והתחל שיחה חדשה",com_nav_welcome_assistant:"אנא בחר סייען",com_nav_text_to_speech:"טקסט לדיבור",com_nav_automatic_playback:"הפעל אוטומטית הודעה אחרונה",com_nav_speech_to_text:"דיבור לטקסט",com_nav_user_guide:"מדריך למשתמש",com_nav_auto_send_text:"שלח טקסט אוטומטית (לאחר 3 שניות)",com_nav_audio_play_error:"שגיאה בהפעלת שמע: {0}",com_nav_audio_process_error:"שגיאה בעיבוד שמע: {0}",com_nav_engine:"מנוע",com_nav_browser:"דפדפן",com_nav_external:"חיצוני",com_nav_delete_cache_storage:"מחק אחסון מטמון",com_nav_voice_select:"קול",com_nav_setting_speech:"דיבור",com_nav_language:"שפה",com_nav_lang_auto:"זיהוי אוטומטי",com_nav_lang_english:"אנגלית",com_nav_lang_chinese:"中文",com_nav_lang_german:"Deutsch",com_nav_lang_spanish:"Español",com_nav_lang_french:"Français",com_nav_lang_italian:"Italiano",com_nav_lang_polish:"Polski",com_nav_lang_brazilian_portuguese:"Português Brasileiro",com_nav_lang_russian:"Русский",com_nav_lang_japanese:"日本語",com_nav_lang_swedish:"Svenska",com_nav_lang_korean:"한국어",com_nav_lang_vietnamese:"Tiếng Việt",com_nav_lang_traditionalchinese:"