g.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — model ringan berlatensi rendah dengan konteks 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Model pembantu dioptimumkan suara dalaman."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto memilih model terbaik untuk permintaan anda berdasarkan kapasiti dan prestasi."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Akan Datang"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Keutamaan penghalaan Auto"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Laraskan cara penghala Auto mengimbangi pertukaran apabila memilih model bagi setiap giliran. Pemberat dinormalkan — keseimbangan relatif yang penting."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Kos"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Utamakan model lebih murah dengan kos token lebih rendah."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Ketepatan"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Utamakan model lebih berkuasa untuk penaakulan kompleks."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Kelajuan"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Utamakan model lebih pantas dengan kependaman lebih rendah."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Tetapkan semula kepada lalai"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Muat naik fail tamat masa. Sila cuba lagi dalam beberapa minit."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Sesuatu telah berlaku. Berikut ialah mesej ralat khusus yang kami temui: Ralat berlaku semasa memproses permintaan anda. Pembantu tidak lagi tersedia. Sila hubungi Pentadbir."},com_ui_code:{english:"Code",translated:"Kod"},com_ui_assistant_share:{english:"Share",translated:"Kongsi"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Pautan disalin"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Anda tidak mempunyai akse