rror_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Kunci yang diberikan tidak sah. Sila berikan kunci dan cuba lagi."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Kunci yang diberikan untuk {0} tamat pada {1}. Sila berikan kunci dan cuba lagi."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Anda telah mencapai had penggunaan bulanan. Sila hubungi pentadbir pasukan untuk bantuan."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Anda telah mencapai token maksimum untuk lesen anda. Sila hubungi jualan di {0} untuk bantuan lanjut."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Anda telah menggunakan {0}% daripada token yang diperuntukkan. Sila hubungi {1} untuk bantuan lanjut."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Lesen anda tidak tersedia. Sila hubungi sokongan untuk bantuan lanjut."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Alamat IPv6 tidak disokong. Sila gunakan sambungan IPv4 atau hubungi sokongan untuk bantuan lanjut."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Ralat berlaku semasa memproses permintaan anda. Sila cuba lagi."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Fail {0} telah dimuat naik dengan berjaya"},com_files_no_results:{english:"No results.",translated:"Tiada hasil."},com_files_filter:{english:"Search files by name",translated:"Cari fail mengikut nama"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} daripada {1} fail dipilih"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Pilih Pembantu"},com_sidepanel_parameters:{english:"Parameters",translated:"Parameter"},com_ui_create_assistant:{english:"Create Assistant",translated:"Cipta Pembantu"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Pengguna memerlukan kebenaran cipta untuk mencipta Pembantu"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Pembantu"},com_sidepanel_attach_files:{english:"File Manager",translated:"Pengurus Fail"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Urus Fail"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Persetujuan"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Anda akan berkongsi pembantu ini dengan ahli pasukan lain. Sebelum berkongsi pembantu ini, sila semak perkara utama di bawah:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Dengan meneruskan, anda mengesahkan bahawa anda memahami dan menerima syarat-syarat ini."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Pembantu yang dikongsi tidak boleh mengandungi data sensitif atau rahsia."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Pembantu yang dikongsi tidak boleh memproses data sensitif atau rahsia."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Perkongsian bermaksud akauntabiliti dan tanggungjawab untuk kandungan dan akses."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Disarankan untuk berkongsi dengan pasukan tertentu atau kumpulan tertutup dan bukan semua orang."},com_button_accept:{english:"Accept",translated:"Terima"},com_button_decline:{english:"Decline",translated:"Tolak"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Pangkalan Pengetahuan"},com_assistants_file_search:{english:"File Search",translated:"Carian Fail"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Tambah fail di sini untuk pembantu anda mencari semasa menjawab soalan dalam sembang."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Disokong:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Petua:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Minta pembantu anda menggunakan 'Alat Carian Fail' setiap kali ia menjawab pengguna."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Melampirkan stor vektor untuk Carian Fail belum disokong. Anda boleh melampirkannya dari Provider Playground atau melampirkan fail ke mesej untuk carian fail berdasarkan urutan."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Terdapat masalah semasa mendapatkan fail dari stor vektor."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Pangkalan Pengetahuan"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Muat naik fail kepada pembantu anda, supaya ia boleh menggunakannya untuk menjawab soalan (contohnya Panduan Pengguna CXNGPT)"},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Klik Cipta untuk menyimpan Pembantu anda, kemudian muat naik fail anda, dan klik Simpan."},com_assistants_image_vision:{english:"Image Vision",translated:"Visi Imej"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Penterjemah Kod"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Tambah fail di sini untuk pembantu anda gunakan untuk menganalisis atau mengubah data untuk setiap sembang."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Disokong:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Petua:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Minta pembantu anda menggunakan 'Alat Penterjemah Kod' setiap kali ia menjawab pengguna."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} daripada {1} fail dimuat naik"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Fail berikut hanya tersedia untuk Penafsir Kod:"},com_assistants_retrieval:{english:"Retrieval",translated:"Pengambilan"},com_assistants_search_name:{english:"Search assistants by name",translated:"Cari pembantu mengikut nama"},com_assistants_tools:{english:"Tools",translated:"Alat"},com_assistants_actions:{english:"Actions",translated:"Tindakan"},com_assistants_add_tools:{english:"Add Tools",translated:"Tambah Alat"},com_assistants_add_actions:{english:"Add Actions",translated:"Tambah Tindakan"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Carian fail tidak diaktifkan pada model ini. Sila pilih model lain."},com_assistants_available_actions:{english:"Available Actions",translated:"Tindakan Tersedia"},com_assistants_running_action:{english:"Running action",translated:"Menjalankan tindakan"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Berbual dengan {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"Menjalankan {0}"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Menggunakan Carian Fail"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Pembantu menggunakan {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:"[ralat memproses alat] Gagal mendapatkan kandungan laman web yang diberikan. [100]"},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:"[ralat memproses alat] Gagal mendapatkan kandungan laman web yang diberikan. [101]"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Pembantu menghantar info ini kepada {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Memadam hanya dibenarkan dengan Pembantu peribadi"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Berjaya memadam Tindakan daripada Pembantu"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Berjaya mencipta atau mengemas kini Tindakan"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Terdapat ralat semasa mencipta atau mengemas kini tindakan."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Terdapat ralat semasa memadam tindakan."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Biarkan Pembantu anda mendapatkan maklumat atau mengambil tindakan melalui API"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Namakan pembantu anda (contoh: Penjana Emel)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Berikan pembantu anda garis panduan yang khusus, terperinci, dan komprehensif untuk mengarahkan tingkah lakunya (cth. Matlamat, Peranan, Tindakan, Audiens, Gaya, Peraturan, Tugas, Templat, Contoh)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Terangkan secara ringkas apa yang pembantu anda boleh lakukan (cth. Hasilkan emel dari templat)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Anda perlu membuat pembantu sebelum menambah tindakan."},com_assistants_update_success:{english:"Successfully updated",translated:"Berjaya dikemas kini"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Terdapat ralat semasa mengemas kini pembantu anda."},com_assistants_create_success:{english:"Successfully created",translated:"Berjaya dicipta"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Terdapat ralat semasa mencipta pembantu anda."},com_assistants_loading:{english:"Loading assistants...",translated:"Memuatkan pembantu..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Sila berikan alasan untuk mengaktifkan PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Tetapan & Privasi"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Pemadaman PII"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"Pemadaman PII diaktifkan secara lalai untuk panggilan model pembantu ini."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Membenarkan PII mematikan pemadaman untuk panggilan model pembantu ini. Anda bertanggungjawab untuk mematuhi dasar data organisasi anda. Aktiviti dicatat dan dipantau sepenuhnya."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Sila jelaskan alasan anda untuk mengaktifkan PII (diperlukan)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Panjang minimum ialah {0} aksara."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Panjang maksimum ialah {0} aksara."},com_ui_date_today:{english:"Today",translated:"Hari ini"},com_ui_date_yesterday:{english:"Yesterday",translated:"Semalam"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"7 hari sebelumnya"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"30 hari sebelumnya"},com_ui_date_january:{english:"January",translated:"Januari"},com_ui_date_february:{english:"February",translated:"Februari"},com_ui_date_march:{english:"March",translated:"Mac"},com_ui_date_april:{english:"April",translated:"April"},com_ui_date_may:{english:"May",translated:"Mei"},com_ui_date_june:{english:"June",translated:"Jun"},com_ui_date_july:{english:"July",translated:"Jul"},com_ui_date_august:{english:"August",translated:"Ogos"},com_ui_date_september:{english:"September",translated:"Sep"},com_ui_date_october:{english:"October",translated:"Okt"},com_ui_date_november:{english:"November",translated:"Nov"},com_ui_date_december:{english:"December",translated:"Dis"},com_ui_field_required:{english:"This field is required",translated:"Medan ini diperlukan"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Ralat memuat turun fail. Fail mungkin telah dipadam."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Jenis fail tidak disokong untuk titik akhir:"},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Tidak boleh lampirkan fail Pembantu ke titik akhir lain"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Had saiz fail melebihi untuk titik akhir:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Tidak boleh lampirkan fail. Cipta atau pilih perbualan, atau cuba muat semula halaman."},com_ui_examples:{english:"Examples",translated:"Contoh"},com_ui_new_chat:{english:"New chat",translated:"Sembang baru"},com_ui_conversations:{english:"Chats",translated:"Sembang"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"Mulakan perbualan..."},com_ui_new_conversation:{english:"New Chat",translated:"Sembang Baru"},com_ui_assistant_library:{english:"Assistant Library",translated:"Perpustakaan Pembantu"},com_ui_kbot_assistants:{english:"Knowledge",translated:"Pengetahuan"},com_ui_assistant_search:{english:"Search for an assistant",translated:"Cari pembantu"},com_ui_assistant_default_category:{english:"General",translated:"Umum"},com_ui_assistant_featured:{english:"Featured",translated:"Ditampilkan"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Tiada pembantu sepadan dengan kriteria carian."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Tiada pembantu ditemui."},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"Terangkan pengkomputeran kuantum dengan mudah"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"Ada idea kreatif untuk hari jadi kanak-kanak 10 tahun?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"Bagaimana membuat permintaan HTTP dalam Javascript?"},com_ui_category_placeholder:{english:"Search a category",translated:"Cari kategori"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Cari alat"},com_ui_capabilities:{english:"Capabilities",translated:"Keupayaan"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"Ingat apa yang pengguna katakan sebelum ini dalam perbualan"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Benarkan pengguna membuat pembetulan susulan"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Dilatih untuk menolak permintaan yang tidak sesuai"},com_ui_limitations:{english:"Limitations",translated:"Keterbatasan"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Mungkin kadangkala menghasilkan maklumat yang salah"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Mungkin kadangkala menghasilkan arahan berbahaya atau kandungan berat sebelah"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Pengetahuan terhad tentang dunia dan peristiwa selepas 2021"},com_ui_on:{english:"On",translated:"Hidup"},com_ui_off:{english:"Off",translated:"Mati"},com_ui_yes:{english:"Yes",translated:"Ya"},com_ui_no:{english:"No",translated:"Tidak"},com_ui_ascending:{english:"Asc",translated:"Naik"},com_ui_descending:{english:"Desc",translated:"Turun"},com_ui_show_all:{english:"Show All",translated:"Tunjuk Semua"},com_ui_name:{english:"Name",translated:"Nama"},com_ui_date:{english:"Date",translated:"Tarikh"},com_ui_storage:{english:"Storage",translated:"Storan"},com_ui_context:{english:"Context",translated:"Konteks"},com_ui_size:{english:"Size",translated:"Saiz"},com_ui_host:{english:"Host",translated:"Hos"},com_ui_update:{english:"Update",translated:"Kemaskini"},com_ui_authentication:{english:"Authentication",translated:"Pengesahan"},com_ui_instructions:{english:"Instructions",translated:"Arahan"},com_ui_description:{english:"Description",translated:"Penerangan"},com_ui_category:{english:"Category",translated:"Kategori"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Tetapkan kategori perniagaan untuk membantu menapis dan menyusun pembantu mengikut fungsi."},com_ui_error:{english:"Error",translated:"Ralat"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Ralat menyambung ke pelayan, cuba segarkan halaman."},com_ui_select:{english:"Select",translated:"Pilih"},com_ui_select_placeholder:{english:"Select options",translated:"Pilih pilihan"},com_ui_remove:{english:"Remove",translated:"Buang"},com_ui_input:{english:"Input",translated:"Input"},com_ui_close:{english:"Close",translated:"Tutup"},com_ui_model:{english:"Model",translated:"Model"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Medan nama pembantu tidak boleh kosong. Sila masukkan nama yang sah."},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Awalan Pintar digunakan untuk Pembantu Umum, Sila gunakan nama lain."},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Medan penerangan tidak boleh kosong. Sila masukkan penerangan yang sah."},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Medan arahan tidak boleh kosong. Sila masukkan arahan yang sah."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Medan kategori tidak boleh kosong. Sila pilih kategori."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Nama pembantu yang sama telah dikesan. Sila pilih nama yang unik."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Medan dikongsi dengan tidak boleh kosong. Sila pilih pilihan dikongsi dengan."},com_ui_shared_with:{english:"Shared With",translated:"Dikongsi Dengan"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Peribadi – Hanya anda boleh mengakses dan melihat pembantu ini."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Kongsi hanya dengan Pasukan – Pembantu ini akan kelihatan dan boleh diakses oleh ahli pasukan anda."},com_ui_shared_with_team:{english:"Team",translated:"Pasukan"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Pilih pasukan pembantu ini. Hanya pasukan yang anda sertai akan muncul di sini."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Medan pasukan tidak boleh kosong. Sila pilih pasukan."},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Pembantu ini dikunci untuk penyuntingan kerana ia dikongsi dengan pasukan."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Ralat memuatkan pautan dikongsi."},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Nama Pembantu anda mengandungi kata-kata kesat dan tidak dapat dihantar. Sila kemas kini nama Pembantu anda."},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Penerangan anda mengandungi kata-kata kesat dan tidak dapat dihantar. Sila kemas kini Penerangan anda."},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Arahan anda mengandungi kata-kata kesat dan tidak dapat dihantar. Sila kemas kini Arahan anda."},com_ui_select_search_model:{english:"Search model by name",translated:"Cari model mengikut nama"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Cari plugin mengikut nama"},com_ui_use_prompt:{english:"Use prompt",translated:"Guna prompt"},com_ui_prev:{english:"Prev",translated:"Sebelum"},com_ui_next:{english:"Next",translated:"Seterusnya"},com_ui_stop:{english:"Stop",translated:"Berhenti"},com_ui_upload_files:{english:"Upload files",translated:"Muat naik fail"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Templat Prompt"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Sembunyikan Templat Prompt"},com_ui_showing:{english:"Showing",translated:"Menunjukkan"},com_ui_of:{english:"of",translated:"daripada"},com_ui_entries:{english:"Entries",translated:"Entri"},com_ui_none_selected:{english:"None selected",translated:"Tiada dipilih"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Berjaya memuat naik fail"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Terdapat ralat memuat naik fail anda"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Fail tidak sah untuk dimuat naik. Mesti imej tidak melebihi 2 MB"},com_ui_thinking:{english:"Thinking",translated:"Berfikir"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Menganalisis permintaan anda"},com_ui_processing:{english:"Putting it together",translated:"Memproses"},com_ui_working_on_it:{english:"Almost ready",translated:"Sedang diusahakan"},com_ui_cancel:{english:"Cancel",translated:"Batal"},com_ui_save:{english:"Save",translated:"Simpan"},com_user_message:{english:"You",translated:"Anda"},com_ui_read_aloud:{english:"Read aloud",translated:"Baca kuat"},com_ui_copied:{english:"Copied!",translated:"Disalin!"},com_ui_copy_code:{english:"Copy code",translated:"Salin kod"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Salin ke papan klip"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Disalin ke papan klip"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Sebut titik akhir, pembantu, atau pratetap untuk beralih dengan cepat"},com_ui_regenerate:{english:"Regenerate",translated:"Jana semula"},com_ui_edit:{english:"Edit",translated:"Edit"},com_ui_all:{english:"all",translated:"semua"},com_ui_clear:{english:"Clear",translated:"Kosongkan"},com_ui_import_conversation:{english:"Import",translated:"Import"},com_ui_nothing_found:{english:"Nothing found",translated:"Tiada ditemui"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Pergi ke perbualan"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Import perbualan dari fail JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Perbualan berjaya diimport"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Terdapat ralat semasa mengimport perbualan anda"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Jenis import tidak disokong"},com_ui_confirm_action:{english:"Confirm Action",translated:"Sahkan Tindakan"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Tidak Diketahui"},com_ui_result:{english:"Result",translated:"Keputusan"},com_ui_image_gen:{english:"Image Gen",translated:"Penjana Imej"},com_ui_assistant:{english:"Assistant",translated:"Pembantu"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Pembantu berjaya dipadam"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Terdapat ralat semasa memadam pembantu"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Fail pendua dikesan."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Ralat berlaku semasa memuat naik fail."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Ralat berlaku semasa memuat naik fail: Endpoint tidak ditakrifkan"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Fail kosong tidak dibenarkan."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Anda hanya boleh memuat naik sehingga {0} fail pada satu masa."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Anda hanya boleh memuat naik sehingga {0} fail dalam seksyen ini."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Had muat naik telah dicapai untuk {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Tidak dapat menentukan jenis fail untuk: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Jenis fail tidak disokong. Sila muat naik format fail yang disokong."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Gagal memuatkan imej"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Buat masa ini, hanya fail JPEG, JPG, PNG, dan WEBP disokong."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Saiz fail melebihi {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Jumlah saiz fail tidak boleh melebihi {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Ralat berlaku semasa mengesahkan fail."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Ralat berlaku semasa memproses fail."},com_ui_assistants:{english:"Assistants",translated:"Pembantu"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Bantuan Studio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Pengetahuan"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Tidak Dikategorikan"},com_ui_attachment:{english:"Attachment",translated:"Lampiran"},com_ui_assistants_output:{english:"Assistants Output",translated:"Output Pembantu"},com_ui_delete:{english:"Delete",translated:"Padam"},com_ui_create:{english:"Create",translated:"Cipta"},com_ui_share:{english:"Share",translated:"Kongsi"},com_ui_copy_link:{english:"Copy link",translated:"Salin pautan"},com_ui_update_link:{english:"Update link",translated:"Kemaskini pautan"},com_ui_create_link:{english:"Create link",translated:"Cipta pautan"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Kongsi pautan ke sembang"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"Terdapat ralat semasa berkongsi pautan sembang"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Nama anda dan sebarang mesej yang ditambah selepas berkongsi kekal peribadi."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"Pautan awam ke sembang anda telah dicipta. Urus sembang yang dikongsi sebelum ini pada bila-bila masa melalui Tetapan."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Nama anda, arahan tersuai, dan sebarang mesej yang ditambah selepas berkongsi kekal peribadi."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"Pautan awam ke sembang anda telah dikemaskini. Urus sembang yang dikongsi sebelum ini pada bila-bila masa melalui Tetapan."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Pautan yang dikongsi tidak ditemui"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Padam sembang?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Ini akan memadam"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Adakah anda pasti mahu memadam Pembantu ini? Ini tidak boleh dibatalkan."},com_ui_rename:{english:"Rename",translated:"Namakan semula"},com_ui_more_options:{english:"More",translated:"Lagi"},com_ui_preview:{english:"Preview",translated:"Pratonton"},com_ui_upload:{english:"Upload",translated:"Muat naik"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Memuat naik "{0}" mengambil masa lebih lama daripada yang dijangka. Sila tunggu sementara fail selesai diindeks untuk pengambilan.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Dasar privasi"},com_ui_terms_of_service:{english:"Terms of service",translated:"Terma perkhidmatan"},com_ui_use_micrphone:{english:"Use microphone",translated:"Guna mikrofon"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Tidak boleh buang lebih nilai, minimum {0} diperlukan."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Maksimum dibenarkan ialah {0}, menggunakan nilai terkini."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Tidak dapat log masuk dengan maklumat yang diberikan. Sila semak kelayakan anda dan cuba lagi."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Anda telah melebihi jumlah percubaan log masuk yang dibenarkan. Sila cuba lagi dalam 15 minit."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Akaun anda telah digantung sementara kerana melanggar perkhidmatan kami."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Terdapat ralat pelayan dalaman. Sila tunggu sebentar dan cuba lagi."},com_auth_sign_in:{english:"Login",translated:"Log masuk"},com_endpoint_system_message:{english:"System Message",translated:"Mesej Sistem"},com_endpoint_message:{english:"Message",translated:"Mesej"},com_endpoint_messages:{english:"Messages",translated:"Mesej-mesej"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Edit mesej anda atau Jana Semula."},com_endpoint_default_blank:{english:"default: blank",translated:"lalai: kosong"},com_endpoint_default_false:{english:"default: false",translated:"lalai: palsu"},com_endpoint_default_creative:{english:"default: creative",translated:"lalai: kreatif"},com_endpoint_default_empty:{english:"default: empty",translated:"lalai: kosong"},com_endpoint_default_with_num:{english:"default: {0}",translated:"lalai: {0}"},com_endpoint_context:{english:"Context",translated:"Konteks"},com_endpoint_tone_style:{english:"Tone Style",translated:"Gaya Nada"},com_endpoint_token_count:{english:"Token count",translated:"Kiraan token"},com_endpoint_output:{english:"Output",translated:"Output"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Maksimum Token Konteks"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Jumlah maksimum token yang boleh digunakan untuk konteks. Gunakan ini untuk mengawal berapa banyak token dihantar setiap permintaan.
  Jika tidak dinyatakan, akan menggunakan lalai sistem berdasarkan saiz konteks model yang diketahui. Menetapkan nilai lebih tinggi mungkin menyebabkan ralat dan/atau kos token lebih tinggi.`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Tetapkan arahan atau konteks tersuai. Diabaikan jika kosong."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Menimpa arahan pembantu. Ini berguna untuk mengubah tingkah laku berdasarkan setiap larian."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Tetapkan arahan atau konteks tambahan di atas arahan utama Pembantu. Diabaikan jika kosong."},com_endpoint_custom_name:{english:"Custom Name",translated:"Nama Tersuai"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Arahan Tersuai"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Arahan Tambahan"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Timpakan Arahan"},com_endpoint_temperature:{english:"Temperature",translated:"Suhu"},com_endpoint_default:{english:"default",translated:"lalai"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Maksimum Token Output"},com_endpoint_stop:{english:"Stop Sequences",translated:"Hentikan Urutan"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Pisahkan nilai dengan menekan `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Medan `max_tokens` pilihan, mewakili bilangan maksimum token yang boleh dijana dalam penyelesaian sembang.\n\nPanjang keseluruhan token input dan token yang dijana adalah terhad oleh panjang konteks model. Anda mungkin mengalami ralat jika nombor ini melebihi token konteks maksimum."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Nilai lebih tinggi = lebih rawak, manakala nilai lebih rendah = lebih fokus dan deterministik. Kami mengesyorkan mengubah ini atau Top P tetapi bukan kedua-duanya."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Token maksimum untuk dijana. Panjang keseluruhan token input dan token yang dijana adalah terhad oleh panjang konteks model."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Alternatif kepada pensampelan dengan suhu, dipanggil pensampelan nukleus, di mana model mempertimbangkan hasil token dengan jisim kebarangkalian top_p. Jadi 0.1 bermaksud hanya token yang merangkumi jisim kebarangkalian 10% teratas dipertimbangkan. Kami mengesyorkan mengubah ini atau suhu tetapi bukan kedua-duanya."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Nombor antara 0 dan 2.0. Nilai positif menghukum token baru berdasarkan kekerapan sedia ada mereka dalam teks setakat ini, mengurangkan kemungkinan model mengulangi baris yang sama secara verbatim."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Nombor antara 0 dan 2.0. Nilai positif menghukum token baru berdasarkan sama ada mereka muncul dalam teks setakat ini, meningkatkan kemungkinan model bercakap tentang topik baru."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Hantar semula semua fail yang dilampirkan sebelum ini. Nota: ini akan meningkatkan kos token dan anda mungkin mengalami ralat dengan banyak lampiran."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Resolusi untuk permintaan Vision. "Rendah" lebih murah dan cepat, "Tinggi" lebih terperinci dan mahal, dan "Auto" akan memilih secara automatik antara kedua-duanya berdasarkan resolusi imej.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Sehingga 4 urutan di mana API akan berhenti menjana token lanjut."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Tetapkan nama tersuai untuk iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Tetapkan arahan tersuai untuk disertakan dalam Mesej Sistem. Lalai: tiada"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Penalti Kekerapan"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Penalti Kehadiran"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Guna Fungsi"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Hantar Semula Fail"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Butiran Imej"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Langkau Penyelesaian"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Tetapkan arahan khusus untuk disertakan dalam Mesej Sistem. Lalai: tiada"},com_endpoint_import:{english:"Import",translated:"Import"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Tetapkan nama khusus, sekiranya anda boleh mencari pratetap ini"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Adakah anda pasti mahu memadam pratetap ini?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Pratetap Diimport!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Terdapat ralat semasa mengimport pratetap anda. Sila cuba lagi."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Terdapat ralat semasa menyimpan pratetap anda. Sila cuba lagi."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Terdapat ralat semasa memadam pratetap anda. Sila cuba lagi."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"bukan lagi pratetap lalai."},com_endpoint_preset_default_item:{english:"Default:",translated:"Lalai:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Tiada pratetap lalai aktif."},com_endpoint_preset_title:{english:"Preset",translated:"Pratetap"},com_endpoint_preset_saved:{english:"Saved!",translated:"Disimpan!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"kini menjadi pratetap lalai."},com_endpoint_preset:{english:"preset",translated:"pratetap"},com_endpoint_presets:{english:"presets",translated:"pratetap"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Aktif!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Nama Pratetap"},com_endpoint:{english:"Endpoint",translated:"Titik Akhir"},com_endpoint_examples:{english:" Presets",translated:"Pratetap"},com_endpoint_export:{english:"Export",translated:"Eksport"},com_endpoint_export_share:{english:"Export/Share",translated:"Eksport/Kongsi"},com_endpoint_assistant:{english:"Assistant",translated:"Pembantu"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Guna Pembantu Aktif"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Simpan Sebagai Pratetap"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Adakah anda pasti mahu mengosongkan semua pratetap? Ini tidak boleh dipulihkan."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Tiada pratetap lagi, gunakan butang tetapan untuk mencipta satu"},com_endpoint_my_preset:{english:"My Preset",translated:"Pratetap Saya"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Model Ejen (Disyorkan: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Model Penyelesaian (Disyorkan: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Aktifkan penggunaan Plugin sebagai Fungsi OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Aktifkan melangkau langkah penyelesaian, yang menyemak jawapan akhir dan langkah yang dijana"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Sila pilih Pembantu dan mulakan sembang baru"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Tetapkan Kunci anda dalam menu Header untuk sembang."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Sila Pilih Pembantu"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Selamat Datang ke iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Teks ke Ucapan"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Mainkan Mesej Terkini Secara Automatik"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Ucapan ke Teks"},com_nav_profile_picture:{english:"Profile Picture",translated:"Gambar Profil"},com_nav_change_picture:{english:"Change picture",translated:"Tukar gambar"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Tunjukkan Tetapan Ejen"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Tunjukkan Tetapan Penyelesaian"},com_hide_examples:{english:"Hide Examples",translated:"Sembunyikan Contoh"},com_show_examples:{english:"Show Examples",translated:"Tunjukkan Contoh"},com_nav_export_filename:{english:"Filename",translated:"Nama Fail"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Tetapkan nama fail"},com_nav_export_type:{english:"Type",translated:"Jenis"},com_nav_export_conversation:{english:"Export conversation",translated:"Eksport perbualan"},com_nav_export:{english:"Export",translated:"Eksport"},com_nav_shared_links:{english:"Shared links",translated:"Pautan Dikongsi"},com_nav_shared_links_manage:{english:"Manage",translated:"Urus"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Anda tiada pautan dikongsi."},com_nav_shared_links_name:{english:"Name",translated: