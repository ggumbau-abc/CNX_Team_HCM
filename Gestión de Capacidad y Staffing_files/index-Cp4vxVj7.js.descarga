_micrphone:"Brug mikrofon",com_ui_min_tags:"Kan ikke fjerne flere værdier, mindst {0} kræves.",com_ui_max_tags:"Maksimalt tilladt antal er {0}, bruger nyeste værdier.",com_auth_error_login:"Kan ikke logge ind med de angivne oplysninger. Tjek dine legitimationsoplysninger og prøv igen.",com_auth_error_login_rl:"Du har overskredet antallet af tilladte loginforsøg. Prøv igen om 15 minutter.",com_auth_error_login_ban:"Din konto er midlertidigt udelukket på grund af overtrædelser af vores service.",com_auth_error_login_server:"Der opstod en intern serverfejl. Vent et øjeblik og prøv igen.",com_auth_sign_in:"Log ind",com_endpoint_system_message:"Systemmeddelelse",com_endpoint_message:"Meddelelse",com_endpoint_messages:"Meddelelser",com_endpoint_message_not_appendable:"Rediger din meddelelse eller generer igen.",com_endpoint_default_blank:"standard: tom",com_endpoint_default_false:"standard: falsk",com_endpoint_default_creative:"standard: kreativ",com_endpoint_default_empty:"standard: tom",com_endpoint_default_with_num:"standard: {0}",com_endpoint_context:"Kontekst",com_endpoint_tone_style:"Tone Stil",com_endpoint_token_count:"Token antal",com_endpoint_output:"Output",com_endpoint_context_tokens:"Maks. Kontekst Tokens",com_endpoint_context_info:`Det maksimale antal tokens, der kan bruges til kontekst. Brug dette til at styre, hvor mange tokens der sendes pr. forespørgsel.
  Hvis ikke angivet, vil systemstandarder blive brugt baseret på kendte modellers kontekststørrelse. Indstilling af højere værdier kan resultere i fejl og/eller højere tokenomkostninger.`,com_endpoint_prompt_prefix_placeholder:"Indstil brugerdefinerede instruktioner eller kontekst. Ignoreres hvis tom.",com_endpoint_instructions_assistants_placeholder:"Tilsidesætter assistentens instruktioner. Dette er nyttigt til at ændre adfærden pr. kørsel.",com_endpoint_prompt_prefix_assistants_placeholder:"Angiv yderligere instruktioner eller kontekst oven på assistentens hovedinstruktioner. Ignoreres hvis tom.",com_endpoint_custom_name:"Brugertilpasset Navn",com_endpoint_prompt_prefix:"Brugerdefinerede Instruktioner",com_endpoint_prompt_prefix_assistants:"Yderligere Instruktioner",com_endpoint_instructions_assistants:"Tilsidesæt Instruktioner",com_endpoint_temperature:"Temperatur",com_endpoint_default:"standard",com_endpoint_top_p:"Top P",com_endpoint_top_k:"Top K",com_endpoint_max_output_tokens:"Maks Output Tokens",com_endpoint_stop:"Stop Sekvenser",com_endpoint_stop_placeholder:"Adskil værdier ved at trykke `Enter`",com_endpoint_openai_max_tokens:"Valgfrit `max_tokens` felt, der repræsenterer det maksimale antal tokens, der kan genereres i chat-komplettering.\n    \n    Den samlede længde af inputtokens og genererede tokens er begrænset af modellens kontekstdybde. Du kan opleve fejl, hvis dette tal overstiger de maksimale konteksttokens.",com_endpoint_openai_temp:"Højere værdier = mere tilfældig, mens lavere værdier = mere fokuseret og deterministisk. Vi anbefaler at ændre dette eller Top P, men ikke begge.",com_endpoint_openai_max:"Maksimalt antal tokens, der skal genereres. Den samlede længde af inputtokens og genererede tokens er begrænset af modellens kontekstdybde.",com_endpoint_openai_topp:"Et alternativ til sampling med temperatur, kaldet nucleus sampling, hvor modellen overvejer resultaterne af tokens med top_p sandsynlighedsmassen. Så 0,1 betyder, at kun tokens, der udgør de øverste 10% sandsynlighedsmassen, overvejes. Vi anbefaler at ændre dette eller temperatur, men ikke begge.",com_endpoint_openai_freq:"Tal mellem 0 og 2,0. Positive værdier straffer nye tokens baseret på deres eksisterende frekvens i teksten indtil nu, hvilket mindsker modellens sandsynlighed for at gentage den samme linje ordret.",com_endpoint_openai_pres:"Tal mellem 0 og 2,0. Positive værdier straffer nye tokens baseret på, om de optræder i teksten indtil nu, hvilket øger modellens sandsynlighed for at tale om nye emner.",com_endpoint_openai_resend_files:"Send alle tidligere vedhæftede filer igen. Bemærk: dette vil øge tokenomkostningerne, og du kan opleve fejl med mange vedhæftninger.",com_endpoint_openai_detail:'Opløsningen for Vision-anmodninger. "Lav" er billigere og hurtigere, "Høj" er mere detaljeret og dyrere, og "Auto" vælger automatisk mellem de to baseret på billedopløsningen.',com_endpoint_openai_stop:"Op til 4 sekvenser, hvor API'en stopper med at generere yderligere tokens.",com_endpoint_openai_custom_name_placeholder:"Indstil et brugerdefineret navn for iXHello",com_endpoint_openai_prompt_prefix_placeholder:"Indstil brugerdefinerede instruktioner til at inkludere i Systemmeddelelse. Standard: ingen",com_endpoint_frequency_penalty:"Frekvens Straf",com_endpoint_presence_penalty:"Tilstedeværelsesstraf",com_endpoint_plug_use_functions:"Brug funktioner",com_endpoint_plug_resend_files:"Send filer igen",com_endpoint_plug_image_detail:"Billeddetalje",com_endpoint_plug_skip_completion:"Spring over fuldførelse",com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:"Indstil brugerdefinerede instruktioner til systemmeddelelse. Standard: ingen",com_endpoint_import:"Importér",com_endpoint_set_custom_name:"Indstil et brugerdefineret navn, hvis du kan finde denne forudindstilling",com_endpoint_preset_delete_confirm:"Er du sikker på, at du vil slette denne forudindstilling?",com_endpoint_preset_import:"Forudindstilling importeret!",com_endpoint_preset