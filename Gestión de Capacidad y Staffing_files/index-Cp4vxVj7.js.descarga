ah yang sederhana",com_ui_example_10_year_old_b_day:"Ada ide kreatif untuk ulang tahun anak 10 tahun?",com_ui_example_http_in_js:"Bagaimana cara membuat permintaan HTTP dalam Javascript?",com_ui_capabilities:"Kemampuan",com_ui_capability_remember:"Mengingat apa yang pengguna katakan sebelumnya dalam percakapan",com_ui_capability_correction:"Memungkinkan pengguna untuk memberikan koreksi tindak lanjut",com_ui_capability_decline_requests:"Dilatih untuk menolak permintaan yang tidak pantas",com_ui_limitations:"Keterbatasan",com_ui_limitation_incorrect_info:"Mungkin sesekali menghasilkan informasi yang salah",com_ui_limitation_harmful_biased:"Mungkin sesekali menghasilkan instruksi yang berbahaya atau konten yang bias",com_ui_limitation_limited_2021:"Pengetahuan terbatas tentang dunia dan peristiwa setelah 2021",com_ui_input:"Masukan",com_ui_close:"Tutup",com_ui_model:"Model",com_ui_name_empty_error:"Nama tidak boleh kosong",com_ui_smart_prefix_error:"Nama tidak boleh mengandung karakter khusus atau spasi",com_ui_description_empty_error:"Deskripsi tidak boleh kosong",com_ui_instructions_empty_error:"Instruksi tidak boleh kosong",com_ui_category:"Category",com_ui_category_tooltip:"Assign a business category to help filter and organize assistants by function.",com_ui_category_empty_error:"Kolom kategori tidak boleh kosong. Silahkan pilih kategori",com_ui_duplicate_assistant_error:"Asisten dengan nama yang sama sudah ada",com_ui_shared_with_empty_error:"Dibagikan dengan tidak boleh kosong",com_ui_name_profanity_error:"Nama tidak boleh mengandung kata-kata kasar",com_ui_description_profanity_error:"Deskripsi tidak boleh mengandung kata-kata kasar",com_ui_instructions_profanity_error:"Instruksi tidak boleh mengandung kata-kata kasar",com_ui_shared_with:"Dibagikan dengan",com_ui_shared_with_tooltip_1:"Private – Only you can access and view this assistant.",com_ui_shared_with_tooltip_2:"Share only with Team – This assistant will be visible and accessible to your team members."