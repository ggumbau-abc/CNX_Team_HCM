please contact support.",translated:"Ayikho impendulo etholakele. Sicela uzame ukuthumela umlayezo wakho futhi. Uma inkinga iqhubeka ngemuva kokulayisha kabusha ikhasi nokuzama futhi, sicela uthinte ukwesekwa."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Buyela kuChat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Ukulawula Okuphakathi"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Ukulawula okuphakathi kusebenze kule assistant. Okuqukethwe kuzohlolwa ngokumelene nezinqubomgomo zokulawula."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Ukukhubaza ukulawula okuphakathi kususa ukuhlolwa kokuqukethwe kule assistant. Unesibopho sokuhambisana nezinqubomgomo zokuqukethwe zenhlangano yakho. Umsebenzi uqoshwa ngokuphelele futhi uyalandelwa."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Sicela uchaze isizathu sakho sebhizinisi sokukhubaza ukulawula okuphakathi (kuyadingeka)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Sicela unikeze isizathu sokukhubaza ukulawula okuphakathi."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Vumela abasebenzisi ukushintsha imodeli engxoxweni"},com_ui_feedback_good:{english:"Good response",translated:"Impendulo enhle"},com_ui_feedback_bad:{english:"Poor response",translated:"Impendulo embi"},com_ui_feedback_comments:{english:"Comments",translated:"Amazwana"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Amazwana (kuzikhetha)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Sitshele kabanzi ngokuhlangatshezwa kwakho..."},com_ui_feedback_submit:{english:"Submit",translated:"Thumela"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Besingakwazi ukuthumela impendulo yakho"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Akuyiqiniso"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Akuhlobene"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Sekwedlule isikhathi"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Imininingwane ayenele"},com_ui_feedback_reason_other:{english:"Other",translated:"Okunye"},com_ui_model_recommended:{english:"Recommended",translated:"Kunconyiwe"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Indabuko — sicela ubuyekeze"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Lo modeli awusekelwa. Sicela ukhethe imodeli yamanje."},com_nav_setting_memory:{english:"Memory",translated:"Inkumbulo"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Phatha amaqiniso omuntu siqu umsizi awakhumbulayo ezingxoxweni zakho."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Engeza inkumbulo entsha…"},com_nav_memory_add_button:{english:"Add memory",translated:"Engeza inkumbulo"},com_nav_memory_category:{english:"Category",translated:"Isigaba"},com_nav_memory_category_preference:{english:"Preference",translated:"Okuncanyelwayo"},com_nav_memory_category_identity:{english:"Identity",translated:"Ubunikazi"},com_nav_memory_category_context:{english:"Context",translated:"Uhlaka"},com_nav_memory_category_project:{english:"Project",translated:"Iphrojekthi"},com_n