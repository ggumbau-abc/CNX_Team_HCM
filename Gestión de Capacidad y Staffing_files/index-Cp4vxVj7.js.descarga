ection:{english:"Allows user to provide follow-up corrections",translated:"Permet à l'utilisateur de fournir des corrections de suivi"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Formé à refuser les demandes inappropriées"},com_ui_limitations:{english:"Limitations",translated:"Limitations"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Peut occasionnellement générer des informations incorrectes"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Peut occasionnellement produire des instructions nuisibles ou du contenu biaisé"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Connaissance limitée du monde et des événements après 2021"},com_ui_input:{english:"Input",translated:"Entrée"},com_ui_close:{english:"Close",translated:"Fermer"},com_ui_model:{english:"Model",translated:"Modèle"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Le nom est obligatoire"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Le préfixe intelligent doit être inférieur à 100 caractères"},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"La description est obligatoire"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Les instructions sont obligatoires"},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Le champ de catégorie ne peut pas être vide. Veuillez sélectionner une catégorie."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Un assistant avec ce nom existe déjà"},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Partagé avec est obligatoire"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:""},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:""},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:""},com_ui_shared_with:{english:"Shared With",translated:"Partagé avec"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Privé – Vous seul pouvez accéder à cet assistant et le consulter."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Partager uniquement avec l’équipe – Cet assistant sera visible et accessible pour les membres de votre équipe."},com_ui_shared_with_team:{english:"Team",translated:"Équipe"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"L'équipe est obligatoire"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Cet assistant est verrouillé pour la modification car il est partagé avec l'équipe."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Erreur de chargement des liens partagés."},com_ui_use_prompt:{english:"Use prompt",translated:"Utiliser le prompt"},com_ui_prev:{english:"Prev",translated:"Précédent"},com_ui_next:{english:"Next",translated:"Suivant"},com_ui_stop:{english:"Stop",translated:"Arrêt "},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Modèles de prompt"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Masquer les modèles de prompt"},com_ui_showing:{english:"Showing",translated:"Affichage"},com_ui_of:{english:"of",translated:"des"},com_ui_entries:{english:"Entries",translated:"entrées"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Fichier téléversé avec succès"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Une erreur s'est produite lors du téléversement de votre fichier"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Fichier invalide pour le téléversement. Doit être une image ne dépassant pas 2 Mo"},com_ui_cancel:{english:"Cancel",translated:"Annuler"},com_ui_save:{english:"Save",translated:"Sauvegarder"},com_user_message:{english:"You",translated:"Vous"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Copier dans le presse-papier"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Copié dans le presse-papier"},com_ui_regenerate:{english:"Regenerate",translated:"Régénérer"},com_ui_edit:{english:"Edit",translated:"Modifier"},com_ui_all:{english:"all",translated:"tout"},com_ui_clear:{english:"Clear",translated:"Effacer"},com_ui_import_conversation:{english:"Import",translated:"Importer"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Importer des conversations à partir d’un fichier JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Conversations importées avec succès"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Une erreur s’est produite lors de l’importation de vos conversations"},com_ui_confirm_action:{english:"Confirm Action",translated:"Confirmer l'action"},com_ui_share:{english:"Share",translated:"Share"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Share link to chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"There was an error sharing the chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Your name and any messages you add after sharing stay private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been created. Manage previously shared chats at any time via Settings."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Your name, custom instructions, and any messages you add after sharing stay private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Shared link not found"},com_ui_delete:{english:"Delete",translated:"Supprimer"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Supprimer la discussions?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Cela supprimera"},com_ui_rename:{english:"Rename",translated:"Renombrar"},com_ui_more_options:{english:"More",translated:"Plus"},com_ui_preview:{english:"Preview",translated:"Aperçu"},com_ui_upload:{english:"Upload",translated:"Téléverser"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Impossible de se connecter avec les informations fournies. Veuillez vérifier vos identifiants et réessayer."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Trop de tentatives de connexion en peu de temps. Veuillez réessayer plus tard."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Votre compte a été temporairement banni en raison de violations de notre service."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Une erreur interne du serveur s'est produite. Veuillez patienter quelques instants et réessayer."},com_auth_sign_in:{english:"Login",translated:"Se connecter"},com_endpoint_system_message:{english:"System Message",translated:"Message système"},com_endpoint_message:{english:"Message",translated:"Message"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Editer votre message ou regénerer."},com_endpoint_default_blank:{english:"default: blank",translated:"par défaut : vide"},com_endpoint_default_false:{english:"default: false",translated:"par défaut : faux"},com_endpoint_default_creative:{english:"default: creative",translated:"par défaut : créatif"},com_endpoint_default_empty:{english:"default: empty",translated:"par défaut : vide"},com_endpoint_default_with_num:{english:"default: {0}",translated:"par défaut : {0}"},com_endpoint_context:{english:"Context",translated:"Contexte"},com_endpoint_tone_style:{english:"Tone Style",translated:"Style de ton"},com_endpoint_token_count:{english:"Token count",translated:"Nombre de jetons"},com_endpoint_output:{english:"Output",translated:"Sortie"},com_endpoint_custom_name:{english:"Custom Name",translated:"Nom personnalisé"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Préfixe du prompt"},com_endpoint_temperature:{english:"Temperature",translated:"Température"},com_endpoint_default:{english:"default",translated:"par défaut"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Nombre maximum de jetons en sortie"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Des valeurs plus élevées = plus aléatoires, tandis que des valeurs plus faibles = plus concentrées et déterministes. Nous vous recommandons de modifier ceci ou Top P mais pas les deux."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Le nombre maximum de jetons à générer. La longueur totale des jetons d'entrée et des jetons générés est limitée par la longueur du contexte du modèle."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Une alternative à l'échantillonnage avec température, appelée échantillonnage du noyau, où le modèle considère les résultats des jetons avec une masse de probabilité top_p. Ainsi, 0,1 signifie que seuls les jetons représentant les 10 % de masse de probabilité les plus élevés sont pris en compte. Nous vous recommandons de modifier ceci ou la température mais pas les deux."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Nombre compris entre -2,0 et 2,0. Les valeurs positives pénalisent les nouveaux jetons en fonction de leur fréquence existante dans le texte jusqu'à présent, diminuant ainsi la probabilité que le modèle répète la même ligne mot pour mot."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Nombre compris entre -2,0 et 2,0. Les valeurs positives pénalisent les nouveaux jetons en fonction du fait qu'ils apparaissent ou non dans le texte jusqu'à présent, augmentant ainsi la probabilité que le modèle parle de nouveaux sujets."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:`La résolution pour les requêtes Vision. "Low" est moins cher et plus rapide, "High" est plus détaillé et plus cher, et "Auto" choisira automatiquement entre les deux en fonction de la résolution de l'image.`},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Définir un nom personnalisé pour ChatGPT"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Définir des instructions personnalisées à inclure dans le message système. Par défaut : aucun"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Pénalité de fréquence"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Pénalité de présence"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Utiliser les fonctions"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Sauter la complétion"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Définir des instructions personnalisées à inclure dans le message système. Par défaut : aucun"},com_endpoint_import:{english:"Import",translated:"Importer"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Définir un nom personnalisé, au cas où vous trouveriez ce préréglage"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Êtes-vous sûr de vouloir supprimer ce préréglage?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Préréglage importé!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Il y a eu une erreur lors de l'importation de votre préréglage. Veuillez réessayer."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Il y a eu une erreur lors de la sauvegarde de votre préréglage. Veuillez réessayer."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Il y a eu une erreur lors de la suppression de votre préréglage. Veuillez réessayer."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"n'est plus le préréglage par défaut."},com_endpoint_preset_default_item:{english:"Default:",translated:"Par défaut :"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Aucun préréglage par défaut actif."},com_endpoint_preset_title:{english:"Preset",translated:"Préréglage"},com_endpoint_preset_saved:{english:"Saved!",translated:"Enregistré!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"est maintenant le préréglage par défaut."},com_endpoint_preset:{english:"preset",translated:"préréglage"},com_endpoint_presets:{english:"presets",translated:"préréglages"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Actif!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Nom du préréglage"},com_endpoint:{english:"Endpoint",translated:"Endpoint"},com_endpoint_examples:{english:" Presets",translated:" Exemples"},com_endpoint_export:{english:"Export",translated:"Exporter"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Enregistrer comme préréglage"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Etes-vous sûr de vouloir effacer tous les préréglages? Cette action est irréversible."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Aucun préréglage pour l'instant, utilisez le bouton paramètres pour en créer un"},com_endpoint_my_preset:{english:"My Preset",translated:"Mon préréglage"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Modèle d'agent (recommandé : GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Modèle de complétion (recommandé : GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Activer l'utilisation des plugins comme fonctions OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Activer le saut de l'étape de complétion, qui examine la réponse finale et les étapes générées"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Définissez votre clé dans le menu En-tête pour discuter."},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Comment puis-je vous aider aujourd'hui?"},com_nav_profile_picture:{english:"Profile Picture",translated:"Photo de profil"},com_nav_change_picture:{english:"Change picture",translated:"Changer de photo"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Afficher les paramètres de l'agent"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Afficher les paramètres de complétion"},com_hide_examples:{english:"Hide Examples",translated:"Masquer les exemples"},com_show_examples:{english:"Show Examples",translated:"Afficher les exemples"},com_nav_export_filename:{english:"Filename",translated:"Nom du fichier"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Définir le nom du fichier"},com_nav_export_type:{english:"Type",translated:"Type"},com_nav_export_conversation:{english:"Export conversation",translated:"Exporter la conversation"},com_nav_export:{english:"Export",translated:"Exporter"},com_nav_shared_links:{english:"Shared links",translated:"Liens partagés"},com_nav_shared_links_manage:{english:"Manage",translated:"Gerenciar"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Você não tem nenhum link compartilhado."},com_nav_shared_links_name:{english:"Name",translated:"Nome"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Data compartilhada"},com_nav_theme:{english:"Theme",translated:"Thème"},com_nav_theme_system:{english:"System",translated:"Système"},com_nav_theme_dark:{english:"Dark",translated:"Sombre"},com_nav_theme_light:{english:"Light",translated:"Clair"},com_nav_user_name_display:{english:"Display username in messages",translated:"Afficher le nom d'utilisateur dans les messages"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Effacer toutes les conversations"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Confirmer l'effacement"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Fermer la barre latérale"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Ouvrir la barre latérale"},com_nav_send_message:{english:"Send message",translated:"Envoyer un message"},com_nav_log_out:{english:"Log out",translated:"Se déconnecter"},com_nav_user:{english:"USER",translated:"UTILISATEUR"},com_nav_archived_chats:{english:"Archived chats",translated:"Conversations archivées"},com_nav_archived_chats_manage:{english:"Manage",translated:"Gérer"},com_nav_archive_name:{english:"Name",translated:"Nom"},com_nav_archive_created_at:{english:"DateCreated",translated:"CréééLe"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Effacer les conversations"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Êtes-vous sûr de vouloir effacer toutes les conversations ? Ceci est irréversible."},com_nav_help:{english:"Help",translated:"Aide"},com_nav_settings:{english:"Settings",translated:"Paramètres"},com_nav_search_placeholder:{english:"Search messages",translated:"Rechercher des messages"},com_nav_setting_general:{english:"General",translated:"Général"},com_assistants_file_search:{english:"File Search",translated:"Recherche de fichiers"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Recherchez des fichiers dans les messages"},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Extensions de fichiers prises en charge"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Conseils de recherche de fichiers"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Pour rechercher des fichiers, joignez-les à vos messages. Vous pouvez également rechercher des fichiers dans les messages existants."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"L'ajout de vecteurs de stockage pour la recherche de fichiers n'est pas encore pris en charge. Vous pouvez les ajouter depuis le terrain de jeu du fournisseur ou joindre des fichiers aux messages pour une recherche de fichiers au niveau du fil de discussion."},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"La recherche de fichiers n'est pas activée pour ce modèle. Veuillez sélectionner un autre modèle."},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Impossible de joindre les fichiers de l'Assistant à d'autres points d'accès"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Assistant supprimé avec succès"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Une erreur s'est produite lors de la suppression de l'assistant."},com_ui_copied:{english:"Copied!",translated:"Copié !"},com_ui_copy_code:{english:"Copy code",translated:"Copier le code"},com_ui_copy_link:{english:"Copy link",translated:"Copier le lien"},com_ui_update_link:{english:"Update link",translated:"Mettre à jour le lien"},com_ui_create_link:{english:"Create link",translated:"Créer un lien"},com_nav_source_chat:{english:"View source chat",translated:"Afficher la conversation source"},com_ui_date_today:{english:"Today",translated:"Aujourd'hui"},com_ui_date_yesterday:{english:"Yesterday",translated:"Hier"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"7 derniers jours"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"30 derniers jours"},com_ui_date_january:{english:"January",translated:"Janvier"},com_ui_date_february:{english:"February",translated:"Février"},com_ui_date_march:{english:"March",translated:"Mars"},com_ui_date_april:{english:"April",translated:"Avril"},com_ui_date_may:{english:"May",translated:"Mai"},com_ui_date_june:{english:"June",translated:"Juin"},com_ui_date_july:{english:"July",translated:"Juillet"},com_ui_date_august:{english:"August",translated:"Août"},com_ui_date_september:{english:"September",translated:"Septembre"},com_ui_date_october:{english:"October",translated:"Octobre"},com_ui_date_november:{english:"November",translated:"Novembre"},com_ui_date_december:{english:"December",translated:"Décembre"},com_ui_nothing_found:{english:"Nothing found",translated:"Aucun résultat trouvé"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Aller à la conversation"},com_nav_my_files:{english:"File Manager",translated:"Mes fichiers"},com_nav_admin_center:{english:"Admin Center",translated:"Centre d'Administration"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Vous n'avez aucune conversation archivée."},com_nav_language:{english:"Language",translated:"Langue"},com_nav_lang_auto:{english:"Auto detect",translated:"Détection automatique"},com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Il semble que le contenu soumis ait été signalé par notre système de modération pour ne pas être conforme à nos lignes directrices communautaires. Nous ne pouvons pas procéder avec ce sujet spécifique. Si vous avez d'autres questions ou sujets que vous souhaitez explorer, veuillez modifier votre message ou créer une nouvelle conversation."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Aucune clé trouvée. Veuillez fournir une clé et réessayer."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Aucune URL de base trouvée. Veuillez en fournir une et réessayer."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Clé fournie non valide. Veuillez fournir une clé valide et réessayer."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"La clé fournie pour {0} a expiré à {1}. Veuillez fournir une clé et réessayer."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Vous avez atteint votre limite d'utilisation mensuelle. Veuillez contacter l'administrateur de l'équipe pour obtenir de l'aide."},com_files_no_results:{english:"No results.",translated:"Aucun résultat."},com_files_filter:{english:"Search files by name",translated:"Rechercher des fichiers par nom"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} sur {1} fichier(s) sélectionné(s)"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Sélectionner un assistant"},com_sidepanel_parameters:{english:"Parameters",translated:"Paramètres"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Assistants"},com_sidepanel_attach_files:{english:"File Manager",translated:"Joindre des fichiers"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Gérer les fichiers"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Capacités des assistants"},com_assistants_knowledge:{english:"Knowledgebase",translated:"Connaissances"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Si vous téléchargez des fichiers dans la section Connaissances, les conversations avec votre Assistant pourront inclure le contenu de ces fichiers."},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"L'assistant doit être créé, et l'interpréteur de code ou la récupération doivent être activés et enregistrés avant de pouvoir importer des fichiers en tant que connaissances."},com_assistants_image_vision:{english:"Image Vision",translated:"Vision d'image"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Interpréteur de code"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Exécutez du code dans votre conversation"},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Langages de programmation pris en charge"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Conseils pour l'interpréteur de code"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:'Pour exécuter du code, utilisez le préfixe "!" suivi de votre code.'},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Les fichiers suivants sont disponibles uniquement pour l'interpréteur de code :"},com_assistants_retrieval:{english:"Retrieval",translated:"Récupération"},com_assistants_search_name:{english:"Search assistants by name",translated:"Rechercher des assistants par nom"},com_assistants_tools:{english:"Tools",translated:"Outils"},com_assistants_actions:{english:"Actions",translated:"Actions"},com_assistants_add_tools:{english:"Add Tools",translated:"Ajouter des outils"},com_assistants_add_actions:{english:"Add Actions",translated:"Ajouter des actions"},com_assistants_available_actions:{english:"Available Actions",translated:"Actions disponibles"},com_assistants_running_action:{english:"Running action",translated:"Action en cours"},com_assistants_completed_action:{english:"Talked to {0}",translated:"A parlé à {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"A exécuté {0}"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Recherche de fichiers utilisés"},com_assistants_function_use:{english:"Assistant used {0}",translated:"L'assistant a utilisé {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:""}},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:""}},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"L'assistant a envoyé ces informations à {0}"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Action supprimée avec succès de l'Assistant"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Action créée ou mise à jour avec succès"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Une erreur s'est produite lors de la création ou de la mise à jour de l'action."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Une erreur s'est produite lors de la suppression de l'action."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Permettez à votre Assistant de récupérer des informations ou d'effectuer des actions via des API"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Nom de l'assistant (facultatif)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Les instructions système que l'assistant utilise"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Décrivez votre assistant ici (facultatif)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Vous devez créer un assistant avant d'ajouter des actions."},com_assistants_update_success:{english:"Successfully updated",translated:"Mise à jour réussie"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Une erreur s'est produite lors de la mise à jour de votre assistant."},com_assistants_create_success:{english:"Successfully created",translated:"Création réussie"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Une erreur s'est produite lors de la création de votre assistant."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Veuillez fournir une justification pour l’activation des données personnelles (PII)."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Paramètres et confidentialité"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Suppression des données personnelles"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"La suppression des données personnelles est activée par défaut pour les appels du modèle de cet assistant."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"L'autorisation des données personnelles désactive leur suppression pour les appels du modèle de cet assistant. Vous êtes responsable du respect des politiques de données de votre organisation. L’activité est entièrement enregistrée et surveillée."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Veuillez expliquer la raison pour laquelle vous activez les données personnelles"},com_ui_field_required:{english:"This field is required",translated:"Ce champ est obligatoire"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Erreur lors du téléchargement du fichier. Le fichier a peut-être été supprimé."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Type de fichier non pris en charge pour ce point d'accès :"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Limite de taille de fichier dépassée pour le point de terminaison :"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Impossible de joindre le fichier. Créez ou sélectionnez une conversation, ou essayez d'actualiser la page."},com_ui_on:{english:"On",translated:"Activé"},com_ui_off:{english:"Off",translated:"Désactivé"},com_ui_yes:{english:"Yes",translated:"Oui"},com_ui_no:{english:"No",translated:"Non"},com_ui_ascending:{english:"Asc",translated:"Croissant"},com_ui_descending:{english:"Desc",translated:"Décroissant"},com_ui_show_all:{english:"Show All",translated:"Tout afficher"},com_ui_name:{english:"Name",translated:"Nom"},com_ui_date:{english:"Date",translated:"Date"},com_ui_storage:{english:"Storage",translated:"Stockage"},com_ui_context:{english:"Context",translated:"Contexte"},com_ui_size:{english:"Size",translated:"Taille"},com_ui_host:{english:"Host",translated:"Hôte"},com_ui_update:{english:"Update",translated:"Mettre à jour"},com_ui_authentication:{english:"Authentication",translated:"Authentification"},com_ui_instructions:{english:"Instructions",translated:"Instructions"},com_ui_description:{english:"Description",translated:"Description"},com_ui_category:{english:"Category",translated:"Catégorie"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Attribuez une catégorie métier pour faciliter le filtrage et l’organisation des assistants par fonction."},com_ui_error:{english:"Error",translated:"Erreur"},com_ui_select:{english:"Select",translated:"Sélectionner"},com_ui_select_search_model:{english:"Search model by name",translated:"Rechercher un modèle par nom"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Rechercher un plugin par nom"},com_ui_upload_files:{english:"Upload files",translated:"Téléverser des fichiers"},com_ui_none_selected:{english:"None selected",translated:"Aucune sélection"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Mentionnez un point de terminaison, un assistant ou un préréglage pour basculer rapidement vers celui-ci"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Type de fichier non pris en charge pour l'importation"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Inconnu"},com_ui_result:{english:"Result",translated:"Résultat"},com_ui_image_gen:{english:"Image Gen",translated:"Génération d'image"},com_ui_assistant:{english:"Assistant",translated:"Assistant"},com_ui_assistants:{english:"Assistants",translated:"Assistants virtuels"},com_ui_attachment:{english:"Attachment",translated:"Pièce jointe"},com_ui_assistants_output:{english:"Assistants Output",translated:"Sortie des assistants"},com_ui_create:{english:"Create",translated:"Créer"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Êtes-vous sûr de vouloir supprimer cet Assistant ? Cette action est irréversible."},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Le téléversement de "{0}" prend plus de temps que prévu. Veuillez patienter pendant que le fichier termine son indexation pour la récupération.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Politique de confidentialité"},com_ui_terms_of_service:{english:"Terms of service",translated:"Conditions d'utilisation"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Impossible de supprimer plus de valeurs, un minimum de {0} est requis."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Le nombre maximum autorisé est {0}, en utilisant les dernières valeurs."},com_endpoint_messages:{english:"Messages",translated:"Messages"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Jetons de contexte maximum"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:"Le nombre maximum de jetons qui peuvent être utilisés pour le contexte. Utilisez ceci pour contrôler le nombre de jetons envoyés par requête. Si non spécifié, les valeurs par défaut du système seront utilisées en fonction de la taille de contexte connue des modèles. Définir des valeurs plus élevées peut entraîner des erreurs et/ou un coût en jetons plus élevé."},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Définir des instructions ou un contexte personnalisé. Ignoré si vide."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Remplace les instructions de l'assistant. Cela est utile pour modifier le comportement au cas par cas."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Définir des instructions ou un contexte supplémentaire en plus des instructions principales de l'Assistant. Ignoré si vide."},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Instructions supplémentaires pour les assistants"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Instructions de remplacement"},com_endpoint_stop:{english:"Stop Sequences",translated:"Séquences d'arrêt"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Séparez les valeurs en appuyant sur `Entrée`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Champ `max_tokens` optionnel, représentant le nombre maximum de jetons pouvant être générés dans la complétion de conversation. La longueur totale des jetons d'entrée et des jetons générés est limitée par la longueur du contexte du modèle. Vous pouvez rencontrer des erreurs si ce nombre dépasse le maximum de jetons de contexte."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Renvoyer tous les fichiers précédemment joints. Remarque : cela augmentera le coût en jetons et vous pourriez rencontrer des erreurs avec de nombreuses pièces jointes."},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Jusqu'à 4 séquences où l'API cessera de générer d'autres jetons."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Renvoyer les fichiers"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Détail de l'image"},com_endpoint_assistant:{english:"Assistant",translated:"Assistant de point de terminaison"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Utiliser l'assistant actif"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Veuillez sélectionner un assistant dans le panneau latéral droit"},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Veuillez sélectionner un assistant"},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello peut commettre des erreurs. Veuillez vérifier tous les résultats afin d’en garantir la qualité et l’exactitude. Toutes les données saisies sont enregistrées à des fins de conformité."},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Aucun assistants épinglés"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Assistants épinglés"},com_ui_create_assistant:{english:"Create Assistant",translated:"Créer un assistant"},com_ui_assistant_group_by:{english:"Group by",translated:"Regrouper par"},com_ui_assistant_category:{english:"Category",translated:"Catégorie"},com_ui_assistant_team:{english:"Team",translated:"Équipe"},com_ui_assistant_featured:{english:"Featured",translated:"En vedette"},com_ui_assistant_CX:{english:"CX",translated:"Expérience client"},com_ui_assistant_engineering:{english:"Engineering",translated:"Ingénierie"},com_ui_assistant_default_category:{english:"General",translated:"Général"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Renseignement"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Opérations"},com_ui_assistant_sales:{english:"Sales",translated:"Ventes"},com_ui_assistant_strategy:{english:"Strategy",translated:"Stratégie"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Assistants Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Téléverser une image d’avatar (PNG ou JPG, < 2 Mo)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Recherche Web"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Parcourir Site"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Générer Images"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Calculer"},com_help_dialog_Header:{english:"Need assistance?",translated:"Besoin d’aide ?"},com_nav_user_guide:{english:"User Guide",translated:"Guide de l’utilisateur"},com_help_dialog_text_1_1:{english:"Click",translated:"Cliquez"},com_help_dialog_text_here:{english:"here",translated:"ici"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"pour consulter les instructions détaillées"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"En cas de problème, veuillez soumettre un"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket SolveNow"},com_help_dialog_text_3:{english:"Find the steps",translated:"Consultez les étapes"},com_support_ticket_text:{english:"Support Ticket",translated:"Ticket de support"},com_nav_setting_speech:{english:"Speech",translated:"Voix"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Voix en texte"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Envoi auto (3 s)"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Texte en voix"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Lecture auto"},com_nav_voice_select:{english:"Voice",translated:"Voix"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Outil par défaut"},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Vous avez atteint le nombre maximal de jetons pour votre licence. Veuillez contacter les ventes à {0} pour plus d'assistance."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Vous avez utilisé {0}% de vos jetons alloués. Veuillez contacter {1} pour plus d'assistance."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Votre licence n'est pas disponible. Veuillez contacter le support pour plus d'assistance."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Les adresses IPv6 ne sont pas prises en charge. Veuillez utiliser une connexion IPv4 ou contacter le support pour plus d'assistance."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Une erreur s'est produite lors du traitement de votre demande. Veuillez réessayer."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Le fichier {0} a déjà été téléversé avec succès"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"L'utilisateur doit avoir des permissions de création pour créer un Assistant"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Consentement"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Vous êtes sur le point de partager cet assistant avec d'autres membres de l'équipe. Avant de partager cet assistant, veuillez examiner les points clés ci-dessous :"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"En continuant, vous confirmez que vous comprenez et acceptez ces conditions."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"L'assistant partagé ne doit pas contenir de données sensibles ou confidentielles."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Les assistants partagés ne doivent pas traiter de données sensibles ou confidentielles."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Le partage implique la responsabilité du contenu et de l'accès."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Il est recommandé de partager avec une équipe spécifique ou un groupe fermé plutôt qu'avec tout le monde."},com_button_accept:{english:"Accept",translated:"Accepter"},com_button_decline:{english:"Decline",translated:"Refuser"},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Un problème est survenu lors de la récupération des fichiers des magasins de vecteurs."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} sur {1} fichiers téléversés"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Suppression autorisée uniquement pour les Assistants privés"},com_assistants_loading:{english:"Loading assistants...",translated:"Chargement des assistants..."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"La longueur minimale est de {0} caractères."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"La longueur maximale est de {0} caractères."},com_ui_kbot_assistants:{english:"Knowledge",translated:"Connaissance"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Aucun assistant ne correspond aux critères de recherche."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Aucun assistant trouvé."},com_ui_category_placeholder:{english:"Search a category",translated:"Rechercher une catégorie"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Rechercher un outil"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Erreur de connexion au serveur, essayez de rafraîchir la page."},com_ui_select_placeholder:{english:"Select options",translated:"Sélectionner des options"},com_ui_remove:{english:"Remove",translated:"Supprimer"},com_ui_thinking:{english:"Thinking",translated:"Réflexion"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Analyse de votre demande"},com_ui_processing:{english:"Putting it together",translated:"Traitement"},com_ui_working_on_it:{english:"Almost ready",translated:"En cours"},com_ui_read_aloud:{english:"Read aloud",translated:"Lire à haute voix"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Fichier en double détecté."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Une erreur s'est produite lors du téléversement du fichier."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Une erreur s'est produite lors du téléversement du fichier : Point de terminaison non défini"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Les fichiers vides ne sont pas autorisés."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Vous pouvez téléverser jusqu'à {0} fichiers à la fois."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Vous pouvez téléverser jusqu'à {0} fichiers dans cette section."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"La limite de téléversement a été atteinte pour {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Impossible de déterminer le type de fichier pour : {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Type de fichier non pris en charge. Veuillez télécharger un format de fichier pris en charge."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Échec du chargement de l'image"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Actuellement, seuls les fichiers JPEG, JPG, PNG et WEBP sont pris en charge."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"La taille du fichier dépasse {0} Mo."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"La taille totale des fichiers ne peut pas dépasser {0} Mo."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Une erreur s'est produite lors de la validation du fichier."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Une erreur s'est produite lors du traitement du fichier."},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Assistance Studio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Connaissance"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Non catégorisé"},com_ui_use_micrphone:{english:"Use microphone",translated:"Utiliser le microphone"},com_endpoint_export_share:{english:"Export/Share",translated:"Exporter/Partager"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Erreur de lecture audio : {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Erreur de traitement audio : {0}"},com_nav_engine:{english:"Engine",translated:"Moteur"},com_nav_browser:{english:"Browser",translated:"Navigateur"},com_nav_external:{english:"External",translated:"Externe"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Supprimer le stockage cache"},com_page_not_found:{english:"Page not found",translated:"Page non trouvée"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Quelque chose s'est mal passé"},com_unauthorized_access:{english:"Unauthorized access",translated:"Accès non autorisé"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Accès non autorisé. Accès restreint à certains domaines."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Votre compte a été temporairement banni en raison de violations de notre service"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Vous êtes restreint à accéder à l'application en dehors du réseau !"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Pour les problèmes, contactez"},com_status_ind_none:{english:"Operational",translated:"Opérationnel"},com_status_ind_minor:{english:"Minor Issues",translated:"Problèmes mineurs"},com_status_ind_major:{english:"Major Issues",translated:"Problèmes majeurs"},com_status_ind_critical:{english:"Critical",translated:"Critique"},com_status_ind_error:{english:"Error Fetching",translated:"Erreur de récupération"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Veuillez noter qu'en quittant un chat ou en démarrant un nouveau chat, vous perdrez votre historique de conversation."},com_forbidden_access:{english:"Forbidden access",translated:"Accès interdit"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Politique d'utilisation acceptable"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Politique de confidentialité"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Contrat d'abonnement"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Avant d'utiliser iX Hello, vous pouvez consulter les "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"En vous inscrivant et/ou en entrant, vous acceptez les conditions ci-dessus."},com_login_page_and:{english:"and ",translated:"et "},com_ui_loading:{english:"Loading...",translated:"Chargement..."},com_ui_unpin:{english:"Unpin",translated:"Détacher"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Assistant détaché avec succès"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Erreur lors du détachement de l'assistant"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Assistant épinglé avec succès"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Erreur lors de l'épinglage/détachement de l'assistant"},com_ui_pin:{english:"Pin",translated:"Épingler"},come_create_assistant:{english:"Create Assistant",translated:"Créer Assistant"},come_edit_assistant:{english:"Edit Assistant",translated:"Modifier Assistant"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Êtes-vous sûr de vouloir continuer ? Cela entraînera la perte de toutes les modifications apportées à l'assistant que vous êtes en train de modifier ou de créer. Cette action est irréversible."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Assistant avec l'identifiant {0} introuvable."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Le navigateur ne supporte pas la reconnaissance vocale"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Permission du microphone non accordée"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Erreur lors du démarrage de l'enregistrement : {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder n'enregistre pas"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder n'est pas supporté dans ce navigateur"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Votre message contient des informations personnelles et n'a pas pu être envoyé. Veuillez supprimer toute information personnelle."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Échec du renommage de la conversation"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Il vous reste {0} de vos jetons alloués."},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Le téléchargement du fichier prend plus de temps que prévu. Veuillez réessayer."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Erreur lors de l'épinglage de l'assistant"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Une erreur s'est produite lors de la suppression du lien partagé"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Modèle DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Aucun préréglage par défaut actif."},com_ui_drag_drop_title:{english:"Add anything",translated:"Ajouter n'importe quoi"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Déposez n'importe quel fichier ici pour l'ajouter à la conversation"},com_ui_analyzing:{english:"Analyzing",translated:"Analyse en cours"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Analyse terminée"},com_ui_warning:{english:"Warning",translated:"Avertissement"},com_ui_proceed:{english:"Proceed",translated:"Continuer"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Les fichiers téléchargés vers l'assistant sont utilisés uniquement à des fins de conversation. Les utilisateurs peuvent accéder au contenu de ces fichiers en posant des questions pertinentes, mais le téléchargement direct des fichiers n'est pas autorisé."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Définir un nom personnalisé pour ce préréglage"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Définir un exemple d'entrée. L'exemple est ignoré s'il est vide."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Définir un exemple de sortie. L'exemple est ignoré s'il est vide."},com_nav_export_select_type:{english:"Select a file type",translated:"Sélectionnez un type de fichier"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"capture d'écran (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"texte (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Aucune réponse reçue. Veuillez réessayer d'envoyer votre message. Si le problème persiste après avoir rechargé la page et réessayé, veuillez contacter le support."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Retour au chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Modération Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"La modération guardrail est activée pour cet assistant. Le contenu sera vérifié selon les politiques de modération."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Désactiver la modération guardrail supprime les vérifications de modération de contenu pour cet assistant. Vous êtes responsable de respecter les politiques de contenu de votre organisation. L'activité est entièrement enregistrée et surveillée."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Veuillez expliquer votre justification commerciale pour désactiver la modération guardrail (obligatoire)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Veuillez fournir une justification pour désactiver la modération guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Permettre aux utilisateurs de changer de modèle dans le chat"},com_ui_feedback_good:{english:"Good response",translated:"Bonne réponse"},com_ui_feedback_bad:{english:"Poor response",translated:"Mauvaise réponse"},com_ui_feedback_comments:{english:"Comments",translated:"Commentaires"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Commentaires (facultatif)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Dites-nous en plus sur votre expérience..."},com_ui_feedback_submit:{english:"Submit",translated:"Envoyer"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Nous n'avons pas pu envoyer vos commentaires"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Incorrect"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Non pertinent"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Obsolète"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Pas assez de détails"},com_ui_feedback_reason_other:{english:"Other",translated:"Autre"},com_ui_model_recommended:{english:"Recommended",translated:"Recommandé"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Ancien — veuillez mettre à jour"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Ce modèle n'est plus pris en charge. Veuillez sélectionner un modèle actuel."},com_nav_setting_memory:{english:"Memory",translated:"Mémoire"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Gérer les faits personnels que l'assistant retient à travers vos conversations."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Ajouter une nouvelle mémoire…"},com_nav_memory_add_button:{english:"Add memory",translated:"Ajouter mémoire"},com_nav_memory_category:{english:"Category",translated:"Catégorie"},com_nav_memory_category_preference:{english:"Preference",translated:"Préférence"},com_nav_memory_category_identity:{english:"Identity",translated:"Identité"},com_nav_memory_category_context:{english:"Context",translated:"Contexte"},com_nav_memory_category_project:{english:"Project",translated:"Projet"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Aucune mémoire pour l'instant"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Les mémoires que vous enregistrez apparaîtront ici et aideront à personnaliser les futures conversations."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Impossible de charger les mémoires. Veuillez réessayer."},com_nav_memory_retry:{english:"Retry",translated:"Réessayer"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Impossible d'ajouter la mémoire. Veuillez réessayer."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Impossible de mettre à jour la mémoire. Veuillez réessayer."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Impossible de supprimer la mémoire. Veuillez réessayer."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Supprimer cette mémoire ?"},com_nav_memory_delete_button:{english:"Delete",translated:"Supprimer"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Modifier mémoire"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Supprimer mémoire"},com_nav_memory_save:{english:"Save",translated:"Enregistrer"},com_nav_memory_cancel:{english:"Cancel",translated:"Annuler"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Enregistré {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — dernier modèle de raisonnement GPT-5 avec intelligence de pointe."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — variante compacte et économique de GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — dernier modèle de la génération GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Dernier Opus — intelligence de pointe pour les agents de codage et les flux de travail d'entreprise."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Dernier Opus — intelligence de pointe pour les agents de codage et les flux de travail d'entreprise."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet amélioré avec un meilleur raisonnement et suivi des instructions."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Modèle le plus puissant d'Anthropic pour les tâches complexes et multi-étapes."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Intelligence et rapidité équilibrées pour une large gamme de tâches."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Modèle Claude le plus rapide et compact — idéal pour les tâches à haut débit."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — raisonnement amélioré et capacités multimodales."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Modèle phare de nouvelle génération d'OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 léger — efficace et rapide pour les tâches quotidiennes."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — suivi des instructions et raisonnement améliorés."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 compact — plus rapide et moins cher pour les tâches simples."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Modèle GPT-4 le plus performant, optimisé pour la vitesse et le coût."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o léger — plus rapide et moins cher pour les tâches simples."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Aperçu) — modèle Gemini le plus performant avec 1M de contexte."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Aperçu) — rapide et efficace avec 1M de contexte."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — modèle léger à faible latence avec 1M de contexte."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Modèle assistant optimisé pour la voix interne."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto sélectionne le meilleur modèle pour votre demande selon la capacité et les performances."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Bientôt disponible"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Préférences de routage automatique"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Ajustez la façon dont le routeur Auto équilibre les compromis lors de la sélection d’un modèle à chaque tour. Les pondérations sont normalisées — c’est l’équilibre relatif qui compte."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Coût"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Privilégier les modèles moins chers avec un coût par jeton plus faible."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Précision"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Privilégier les modèles plus performants pour les raisonnements complexes."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Vitesse"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Privilégier les modèles plus rapides, avec une latence plus faible."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Réinitialiser par défaut"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Le téléversement du fichier a expiré. Veuillez réessayer dans quelques minutes."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Une erreur s'est produite. Voici le message d'erreur spécifique que nous avons rencontré : Une erreur s'est produite lors du traitement de votre demande. L'assistant n'est plus disponible. Veuillez contacter l'administrateur."},com_ui_code:{english:"Code",translated:"Code"},com_ui_assistant_share:{english:"Share",translated:"Partager"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Lien copié"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Vous n'avez pas accès à cet assistant"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Échec de la copie du lien dans le presse-papiers"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Aperçu non disponible — la génération de contenu n'est pas terminée."},com_ui_view_code:{english:"View code",translated:"Voir le code"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Aperçu non disponible — contenu invalide."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Numéro de téléphone"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Adresse e-mail"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"