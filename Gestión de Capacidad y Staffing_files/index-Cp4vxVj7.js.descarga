nglish:"here",translated:"यहाँ"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"समस्याओं के लिए, एक"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"समस्याओं के लिए, संपर्क करें"},com_help_dialog_text_ticket:{english:"ticket",translated:"टिकट"},com_help_dialog_text_3:{english:"Find the steps",translated:"चरण खोजें"},com_status_ind_none:{english:"Operational",translated:"संचालित"},com_status_ind_minor:{english:"Minor Issues",translated:"छोटी समस्याएँ"},com_status_ind_major:{english:"Major Issues",translated:"बड़ी समस्याएँ"},com_status_ind_critical:{english:"Critical",translated:"गंभीर"},com_status_ind_error:{english:"Error Fetching",translated:"त्रुटि प्राप्ति"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"कृपया ध्यान दें कि जब आप चैट छोड़ते हैं या नई चैट शुरू करते हैं, तो आप अपनी वार्तालाप इतिहास खो देंगे।"},com_forbidden_access:{english:"Forbidden access",translated:"प्रतिबंधित पहुंच"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"स्वीकार्य उपयोग नीति"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"गोपनीयता नीति"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"सदस्यता समझौता"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"iX Hello का उपयोग करने से पहले, आप Concentrix की समीक्षा कर सकते हैं "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"साइन अप और/या प्रवेश करके, आप उपरोक्त शर्तों से सहमत होते हैं।"},com_login_page_and:{english:"and ",translated:"और "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"कोई पिन किए गए सहायक नहीं"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"पिन किए गए सहायक"},com_ui_loading:{english:"Loading...",translated:"लोड हो रहा है..."},com_ui_unpin:{english:"Unpin",translated:"अनपिन"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"सहायक सफलतापूर्वक अनपिन किया गया"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"सहायक को अनपिन करने में त्रुटि"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"सहायक सफलतापूर्वक पिन किया गया"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"सहायक को पिन/अनपिन करने में त्रुटि"},com_ui_pin:{english:"Pin",translated:"पिन"},come_create_assistant:{english:"Create Assistant",translated:"सहायक बनाएं"},come_edit_assistant:{english:"Edit Assistant",translated:"सहायक संपादित करें"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"क्या आप वाकई आगे बढ़ना चाहते हैं? इससे आपके द्वारा वर्तमान में संपादित या बनाए जा रहे सहायक में किए गए किसी भी परिवर्तन का नुकसान होगा। यह क्रिया पूर्ववत नहीं की जा सकती।"},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"आईडी {0} के साथ सहायक नहीं मिला।"},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"ब्राउज़र SpeechRecognition का समर्थन नहीं करता"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"माइक्रोफ़ोन की अनुमति नहीं दी गई"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"रिकॉर्डिंग शुरू करने में त्रुटि: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder रिकॉर्डिंग नहीं कर रहा है"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"इस ब्राउज़र में MediaRecorder समर्थित नहीं है"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"आपके संदेश में व्यक्तिगत जानकारी है और इसे भेजा नहीं जा सका। कृपया कोई भी व्यक्तिगत जानकारी हटा दें।"},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"वार्तालाप का नाम बदलने में विफल"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"आपके पास आवंटित टोकन में से {0} शेष हैं।"},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello गलतियाँ कर सकता है। कृपया सभी आउटपुट की गुणवत्ता और सटीकता की समीक्षा करें। सभी इनपुट अनुपालन के लिए लॉग किए जाते हैं।"},com_ui_assistant_group_by:{english:"Group by",translated:"समूहित करें"},com_ui_assistant_category:{english:"Category",translated:"श्रेणी"},com_ui_assistant_team:{english:"Team",translated:"टीम"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"इंजीनियरिंग"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"इंटेलिजेंस"},com_ui_assistant_marketing:{english:"Marketing",translated:"मार्केटिंग"},com_ui_assistant_operations:{english:"Operations",translated:"ऑपरेशंस"},com_ui_assistant_sales:{english:"Sales",translated:"बिक्री"},com_ui_assistant_strategy:{english:"Strategy",translated:"रणनीति"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"स्टूडियो सहायक"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"अवतार छवि अपलोड करें (PNG या JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"ऑनलाइन खोजें"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"वेबसाइट ब्राउज़ करें"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"छवियाँ बनाएं"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"गणित की गणना करें"},com_ui_assistant_tools_default:{english:"Running tool",translated:"डिफ़ॉल्ट उपकरण"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"फ़ाइल अपलोड अपेक्षा से अधिक समय ले रहा है। कृपया पुनः प्रयास करें।"},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"सहायक को पिन करने में त्रुटि"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"साझा लिंक को हटाने में त्रुटि हुई"},com_ui_dan:{english:"DAN",translated:"डैन"},com_ui_dan_template:{english:"DAN Template",translated:"डैन टेम्पलेट"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"कोई डिफ़ॉल्ट प्रीसेट सक्रिय नहीं है।"},com_ui_drag_drop_title:{english:"Add anything",translated:"कुछ भी जोड़ें"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"किसी भी फ़ाइल को यहां छोड़ें ताकि इसे वार्तालाप में जोड़ा जा सके"},com_ui_analyzing:{english:"Analyzing",translated:"विश्लेषण कर रहा है"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"विश्लेषण समाप्त"},com_ui_warning:{english:"Warning",translated:"चेतावनी"},com_ui_proceed:{english:"Proceed",translated:"आगे बढ़ें"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"सहायक को अपलोड की गई फाइलें केवल वार्तालाप उद्देश्यों के लिए उपयोग की जाती हैं। उपयोगकर्ता इन फाइलों की सामग्री को प्रासंगिक प्रश्न पूछकर एक्सेस कर सकते हैं, लेकिन फाइलों का सीधा डाउनलोड अनुमति नहीं है।"},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"इस प्रीसेट के लिए एक कस्टम नाम सेट करें"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"उदाहरण इनपुट सेट करें। यदि खाली है तो उदाहरण को अनदेखा किया जाता है।"},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"उदाहरण आउटपुट सेट करें। यदि खाली है तो उदाहरण को अनदेखा किया जाता है।"},com_nav_export_select_type:{english:"Select a file type",translated:"एक फ़ाइल प्रकार चुनें"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"स्क्रीनशॉट (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"पाठ (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"मार्कडाउन (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"कोई प्रतिक्रिया प्राप्त नहीं हुई। कृपया अपना संदेश फिर से भेजने का प्रयास करें। यदि पृष्ठ को पुनः लोड करने और पुनः प्रयास करने के बाद समस्या बनी रहती है, तो कृपया समर्थन से संपर्क करें।"},com_ui_back_to_chat:{english:"Back to Chat",translated:"चैट पर वापस जाएं"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"गार्डरेल मॉडरेशन"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"इस सहायक के लिए गार्डरेल मॉडरेशन सक्षम है। सामग्री को मॉडरेशन नीतियों के अनुसार जांचा जाएगा।"},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"गार्डरेल मॉडरेशन को अक्षम करने से इस सहायक के लिए सामग्री मॉडरेशन जांच हटा दी जाती है। आपको अपनी संगठन की सामग्री नीतियों का पालन करना होगा। गतिविधि पूरी तरह से लॉग और मॉनिटर की जाती है।"},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"गार्डरेल मॉडरेशन को अक्षम करने के लिए अपना व्यावसायिक औचित्य बताएं (आवश्यक)।"},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"कृपया गार्डरेल मॉडरेशन को अक्षम करने के लिए एक औचित्य प्रदान करें।"},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"उपयोगकर्ताओं को चैट में मॉडल बदलने की अनुमति दें"},com_ui_feedback_good:{english:"Good response",translated:"अच्छा जवाब"},com_ui_feedback_bad:{english:"Poor response",translated:"खराब जवाब"},com_ui_feedback_comments:{english:"Comments",translated:"टिप्पणियाँ"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"टिप्पणियाँ (वैकल्पिक)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"अपने अनुभव के बारे में अधिक बताएं..."},com_ui_feedback_submit:{english:"Submit",translated:"सबमिट करें"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"हम आपकी प्रतिक्रिया नहीं भेज सके"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"गलत"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"प्रासंगिक नहीं"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"पुराना"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"पर्याप्त विवरण नहीं"},com_ui_feedback_reason_other:{english:"Other",translated:"अन्य"},com_ui_model_recommended:{english:"Recommended",translated:"अनुशंसित"},com_ui_model_legacy:{english:"Legacy — please update",translated:"विरासत — कृपया अपडेट करें"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"यह मॉडल अब समर्थित नहीं है। कृपया एक वर्तमान मॉडल चुनें।"},com_nav_setting_memory:{english:"Memory",translated:"मेमोरी"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"उन व्यक्तिगत तथ्यों का प्रबंधन करें जिन्हें सहायक आपकी बातचीत के दौरान याद रखता है।"},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"नई मेमोरी जोड़ें…"},com_nav_memory_add_button:{english:"Add memory",translated:"मेमोरी जोड़ें"},com_nav_memory_category:{english:"Category",translated:"श्रेणी"},com_nav_memory_category_preference:{english:"Preference",translated:"प्राथमिकता"},com_nav_memory_category_identity:{english:"Identity",translated:"पहचान"},com_nav_memory_category_context:{english:"Context",translated:"संदर्भ"},com_nav_memory_category_project:{english:"Project",translated:"परियोजना"},com_nav_memory_empty_title:{english:"No memories yet",translated:"अभी तक कोई मेमोरी नहीं"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"आपके द्वारा सहेजी गई मेमोरी यहाँ दिखाई देगी और भविष्य की बातचीत को व्यक्तिगत बनाने में मदद करेगी।"},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"मेमोरी लोड नहीं हो सकी। कृपया पुनः प्रयास करें।"},com_nav_memory_retry:{english:"Retry",translated:"पुनः प्रयास करें"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"मेमोरी जोड़ नहीं सके। कृपया पुनः प्रयास करें।"},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"मेमोरी अपडेट नहीं कर सके। कृपया पुनः प्रयास करें।"},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"मेमोरी हटा नहीं सके। कृपया पुनः प्रयास करें।"},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"इस मेमोरी को हटाएं?"},com_nav_memory_delete_button:{english:"Delete",translated:"हटाएं"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"मेमोरी संपादित करें"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"मेमोरी हटाएं"},com_nav_memory_save:{english:"Save",translated:"सहेजें"},com_nav_memory_cancel:{english:"Cancel",translated:"रद्द करें"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"सहेजा गया {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — अग्रणी बुद्धिमत्ता के साथ नवीनतम GPT-5 थिंकिंग मॉडल।"},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — कॉम्पैक्ट और लागत-प्रभावी GPT-5.4 संस्करण।"},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — नवीनतम GPT-5 पीढ़ी का मॉडल।"},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"नवीनतम Opus — कोडिंग एजेंट्स और एंटरप्राइज वर्कफ़्लोज़ के लिए अग्रणी बुद्धिमत्ता।"},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"नवीनतम Opus — कोडिंग एजेंट्स और एंटरप्राइज वर्कफ़्लोज़ के लिए अग्रणी बुद्धिमत्ता।"},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"बेहतर तर्क और निर्देश पालन के साथ उन्नत Sonnet।"},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"जटिल, बहु-चरणीय कार्यों के लिए Anthropic का सबसे शक्तिशाली मॉडल।"},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"विविध कार्यों के लिए संतुलित बुद्धिमत्ता और गति।"},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"सबसे तेज़ और कॉम्पैक्ट Claude मॉडल — उच्च-थ्रूपुट कार्यों के लिए आदर्श।"},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — उन्नत तर्क और मल्टीमॉडल क्षमताएँ।"},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"OpenAI का प्रमुख अगली पीढ़ी का मॉडल।"},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"लाइटवेट GPT-5 — रोज़मर्रा के कार्यों के लिए प्रभावी और तेज़।"},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — बेहतर निर्देश पालन और तर्क।"},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"कॉम्पैक्ट GPT-4.1 — सरल कार्यों के लिए तेज़ और सस्ता।"},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"सबसे सक्षम GPT-4 मॉडल, गति और लागत के लिए अनुकूलित।"},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"लाइटवेट GPT-4o — सरल कार्यों के लिए तेज़ और सस्ता।"},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (प्रीव्यू) — 1M संदर्भ के साथ सबसे सक्षम Gemini मॉडल।"},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (प्रीव्यू) — 1M संदर्भ के साथ तेज़ और कुशल।"},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — 1M संदर्भ के साथ हल्का, कम-विलंबता मॉडल।"},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"आंतरिक वॉयस-ऑप्टिमाइज़्ड सहायक मॉडल।"},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto आपके अनुरोध के लिए क्षमता और प्रदर्शन के आधार पर सर्वश्रेष्ठ मॉडल का चयन करता है।"},com_ui_model_coming_soon:{english:"Coming Soon",translated:"जल्द आ रहा है"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"ऑटो रूटिंग प्राथमिकताएँ"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"हर टर्न के लिए मॉडल चुनते समय ऑटो राउटर संतुलन कैसे बनाए, इसे समायोजित करें। वेट सामान्यीकृत होते हैं — सापेक्ष संतुलन ही महत्वपूर्ण है।"},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"लागत"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"कम टोकन लागत वाले सस्ते मॉडलों को प्राथमिकता दें।"},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"सटीकता"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"जटिल तर्क के लिए अधिक सक्षम मॉडलों को प्राथमिकता दें।"},com_assistants_auto_weight_speed:{english:"Speed",translated:"गति"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"तेज़, कम विलंबता वाले मॉडलों को प्राथमिकता दें।"},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"डिफ़ॉल्ट पर रीसेट करें"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"फ़ाइल अपलोड का समय समाप्त हो गया। कृपया कुछ मिनटों में फिर से प्रयास करें।"},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"कुछ गलत हो गया। हमें यह विशिष्ट त्रुटि संदेश मिला: आपके अनुरोध को संसाधित करते समय एक त्रुटि हुई। सहायक अब उपलब्ध नहीं है। कृपया व्यवस्थापक से संपर्क करें।"},com_ui_code:{english:"Code",translated:"कोड"},com_ui_assistant_share:{english:"Share",translated:"साझा करें"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"लिंक कॉपी किया गया"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"आपके पास इस सहायक तक पहुंच नहीं है"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"लिंक को क्लिपबोर्ड पर कॉपी नहीं किया जा सका"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"पूर्वावलोकन उपलब्ध नहीं है — सामग्री निर्माण पूरा नहीं हुआ।"},com_ui_view_code:{english:"View code",translated:"कोड देखें"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"पूर्वावलोकन उपलब्ध नहीं है — सामग्री अमान्य है।"},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"फोन नंबर"},com_assistants_pii_entity_email:{english:"Email Address",translated:"ईमेल पता"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"क्रेडिट कार्ड"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"एसएसएन"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"अपलोड अपेक्षा से अधिक समय ले रहा है - पुनः प्रयास हो रहा है ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"कनेक्शन समस्या - पुनः प्रयास हो रहा है ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"अपलोड विफल हुआ - कृपया अपना कनेक्शन जांचें और फिर से प्रयास करें"},com_assistants_memory_enabled:{english:"Memory",translated:"मेमोरी"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"इस सहायक के लिए मेमोरी सक्षम है। सहायक बातचीतों के बीच तथ्यों को संग्रहीत और याद कर सकता है।"},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"इस सहायक के लिए मेमोरी अक्षम है। बातचीतों के बीच कोई तथ्य संग्रहीत या याद नहीं किया जाएगा।"},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"कृपया मेमोरी अक्षम करने के लिए अपना व्यावसायिक औचित्य बताएं (आवश्यक)।"},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"कृपया मेमोरी अक्षम करने का औचित्य प्रदान करें।"},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"आपकी टीम के लिए मेमोरी अक्षम है। आप मौजूदा मेमोरी देख और हटा सकते हैं, लेकिन नई मेमोरी जोड़ या संपादित नहीं कर सकते।"},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"आपका कोड चलाया जा रहा है"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"ज्ञान आधार में खोज की जा रही है"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"आवाज़ संसाधित की जा रही है"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"मेमोरी में सहेजा जा रहा है"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"मेमोरी से हटाया जा रहा है"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"वेब खोज पूरी हुई"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"वेबपेज की समीक्षा पूरी हुई"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"छवि बनाई गई"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"गणना पूरी हुई"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"आपका कोड चलाना पूरा हुआ"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"ज्ञान आधार में खोज पूरी हुई"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"आवाज़ इनपुट संसाधित करना पूरा हुआ"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"मेमोरी में सहेजा गया"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"मेमोरी से हटाया गया"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"पूर्ण: {0}"},com_ui_still_working:{english:"still working...",translated:"अभी भी काम कर रहा है..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} तैयार है"},com_ui_file_ready_fallback:{english:"File is ready",translated:"फ़ाइल तैयार है"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"{0} को संसाधित नहीं किया जा सका"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"फ़ाइल को संसाधित नहीं किया जा सका"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"{0} को संसाधित नहीं किया जा सका। कृपया फ़ाइल फिर से अपलोड करें।"},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"फ़ाइल को संसाधित नहीं किया जा सका। कृपया फ़ाइल फिर से अपलोड करें।"},com_ui_file_processing:{english:"Processing...",translated:"प्रोसेस हो रहा है..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"प्रोसेसिंग विफल हुई"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"विफल - फिर से अपलोड करना आवश्यक है"},com_ui_file_retry:{english:"Retry",translated:"पुनः प्रयास करें"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"{0}s में पुनः प्रयास करें"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"फ़ाइल इंडेक्सिंग का पुनः प्रयास हो रहा है..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"पुनः प्रयास करने से पहले कृपया {0}s प्रतीक्षा करें"},com_ui_file_retries_exhausted_reupload:{english:"Maximum retries reached. Please re-upload the file.",translated:"अधिकतम पुनः प्रयास पूरे हो गए। कृपया फ़ाइल को फिर से अपलोड करें।"},com_ui_assistant_file_upload_invalid_json:{english:"Invalid JSON file. File content does not match the expected format.",translated:"अमान्य JSON फ़ाइल। फ़ाइल सामग्री अपेक्षित प्रारूप से मेल नहीं खाती।"}},_k=Object.freeze(Object.defineProperty({__proto__:null,comparisons:rk,default:ok},Symbol.toStringTag,{value:"Module"})),lk={com_error_moderation:"Úgy tűnik, hogy a beküldött tartalmat a moderációs rendszerünk jelölte meg, mert nem felel meg a közösségi irányelveinknek. Ezzel a konkrét témával nem tudunk továbbhaladni. Ha bármilyen más kérdése vagy témája van, amelyet szeretne felfedezni, kérjük, szerkessze az üzenetét, vagy hozzon létre egy új beszélgetést.",com_error_no_user_key:"Nem található kulcs. Kérjük, adjon meg egy kulcsot, és próbálja újra.",com_error_no_base_url:"Nem található alap URL. Kérjük, adjon meg egyet, és próbálja újra.",com_error_invalid_user_key:"Érvénytelen kulcs. Kérjük, adjon meg egy kulcsot, és próbálja újra.",com_error_expired_user_key:"A(z) {0} kulcs lejárt {1}-kor. Kérjük, adjon meg egy kulcsot, és próbálja újra.",com_error_token_balance_exceeded:"Elérte a havi használati korlátot. Kérjük, lépjen kapcsolatba a csapat adminisztrátorával segítségért.",com_error_token_balance_exceeded_license:"Elérte a licenc maximális tokenjeit. Kérjük, lépjen kapcsolatba az értékesítéssel a {0} címen további segítségért.",com_error_token_balance_percent_used:"A rendelkezésre álló tokenek {0}%-át használta fel. Kérjük, lépjen kapcsolatba a(z) {1} címmel további segítségért.",com_error_license_expired:"A licenc nem elérhető. Kérjük, lépjen kapcsolatba a támogatással további segítségért.",com_restricted_invalid_ip_format:"Az IPv6 címek nem támogatottak. Kérjük, használjon IPv4 kapcsolatot, vagy lépjen kapcsolatba a támogatással további segítségért.",com_error_tool_run:"Hiba történt a kérés feldolgozása közben. Kérjük, próbálja újra.",com_files_upload_duplicate_success:"A(z) {0} fájl már sikeresen feltöltve",com_files_no_results:"Nincs találat.",com_files_filter:"Fájlok keresése név alapján",com_files_number_selected:"{0} a(z) {1} fájlból kiválasztva",com_sidepanel_select_assistant:"Asszisztens kiválasztása",com_sidepanel_parameters:"Paraméterek",com_ui_create_assistant:"Asszisztens létrehozása",com_ui_create_assistant_permission_needed:"A felhasználónak létr