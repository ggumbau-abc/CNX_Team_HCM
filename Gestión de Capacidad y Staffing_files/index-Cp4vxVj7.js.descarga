lete:"Eltávolítva a memóriából",com_ui_assistant_tools_completed_fallback:"Befejezve: {0}",com_ui_still_working:"még dolgozom...",com_assistants_pii_entity_phone:"Telefonszám",com_assistants_pii_entity_email:"Email cím",com_assistants_pii_entity_credit_card:"Hitelkártya",com_assistants_pii_entity_ssn:"TAJ szám",com_assistants_memory_enabled:"Memória",com_assistants_memory_enabled_info:"A memória engedélyezve van ennél az asszisztensnél. Az asszisztens tényeket tárolhat és idézhet fel a beszélgetések között.",com_assistants_memory_disabled_info:"A memória le van tiltva ennél az asszisztensnél. A beszélgetések között nem lesznek tárolva vagy felidézve tények.",com_assistants_memory_enabled_off_reason_placeholder:"Kérjük, indokolja meg üzleti szempontból a memória letiltását (kötelező).",com_assistants_memory_enabled_reason_required:"Kérjük, adjon meg indoklást a memória letiltásához.",com_nav_memory_team_disabled:"A memória le van tiltva a csapatánál. A meglévő emlékeket megtekintheti és törölheti, de újakat nem adhat hozzá és nem szerkeszthet.",com_ui_file_ready:"{0} kész",com_ui_file_ready_fallback:"A fájl kész",com_ui_file_processing_failed:"{0} feldolgozása nem sikerült",com_ui_file_processing_failed_fallback:"A fájl feldolgozása nem sikerült",com_ui_file_processing_failed_reupload:"{0} feldolgozása nem sikerült. Kérjük, töltse fel újra a fájlt.",com_ui_file_processing_failed_reupload_fallback:"A fájl feldolgozása nem sikerült. Kérjük, töltse fel újra a fájlt.",com_ui_file_processing:"Feldolgozás...",com_ui_file_processing_failed_status:"A feldolgozás sikertelen",com_ui_file_processing_failed_reupload_required:"Sikertelen - újrafeltöltés szükséges",com_ui_file_retry:"Újrapróbálás",com_ui_file_retry_in:"Újrapróbálás {0} mp múlva",com_ui_file_indexing_retrying:"Fájlindexelés újrapróbálása...",com_ui_file_retry_wait:"Kérjük, várjon {0} mp-et az újrapróbálás előtt",com_ui_file_retries_exhausted_reupload:"Elérte a maximális próbálkozások számát. Kérjük, töltse fel újra a fájlt.",com_ui_assistant_file_upload_invalid_json:"Érvénytelen JSON fájl. A fájl tartalma nem felel meg a várt formátumnak."},ck={com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Úgy tűnik, hogy a beküldött tartalmat a moderációs rendszerünk jelölte meg, mert nem felel meg a közösségi irányelveinknek. Ezzel a konkrét témával nem tudunk továbbhaladni. Ha bármilyen más kérdése vagy témája van, amelyet szeretne felfedezni, kérjük, szerkessze az üzenetét, vagy hozzon létre egy új beszélgetést."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Nem található kulcs. Kérjük, adjon meg egy kulcsot, és próbálja újra."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Nem található alap URL. Kérjük, adjon meg egyet, és próbálja újra."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Érvénytelen kulcs. Kérjük, adjon meg egy kulcsot, és próbálja újra."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"A(z) {0} kulcs lejárt {1}-kor. Kérjük, adjon meg egy kulcsot, és próbálja újra."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Elérte a havi használati korlátot. Kérjük, lépjen kapcsolatba a csapat adminisztrátorával segítségért."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Elérte a licenc maximális tokenjeit. Kérjük, lépjen kapcsolatba az értékesítéssel a {0} címen további segítségért."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"A rendelkezésre álló tokenek {0}%-át használta fel. Kérjük, lépjen kapcsolatba a(z) {1} címmel további segítségért."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"A licenc nem elérhető. Kérjük, lépjen kapcsolatba a támogatással további segítségért."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Az IPv6 címek nem támogatottak. Kérjük, használjon IPv4 kapcsolatot, vagy lépjen kapcsolatba a támogatással további segítségért."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Hiba történt a kérés feldolgozása közben. Kérjük, próbálja újra."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"A(z) {0} fájl már sikeresen feltöltve"},com_files_no_results:{english:"No results.",translated:"Nincs találat."},com_files_filter:{english:"Search files by name",translated:"Fájlok keresése név alapján"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} a(z) {1} fájlból kiválasztva"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Asszisztens kiválasztása"},com_sidepanel_parameters:{english:"Parameters",translated:"Paraméterek"},com_ui_create_assistant:{english:"Create Assistant",translated:"Asszisztens létrehozása"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"A felhasználónak létrehozási jogosultságra van szüksége az Asszisztens létrehozásához"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Asszisztensek"},com_sidepanel_attach_files:{english:"File Manager",translated:"Fájlkezelő"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Fájlok kezelése"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Hozzájárulás"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Ön éppen megosztja ezt az asszisztenst más csapattagokkal. A megosztás előtt kérjük, tekintse át az alábbi kulcspontokat:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"A folytatással megerősíti, hogy megértette és elfogadja ezeket a feltételeket."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Megosztott asszisztens nem tartalmazhat érzékeny vagy bizalmas adatokat."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Megosztott asszisztensek nem dolgozhatnak fel érzékeny vagy bizalmas adatokat."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"A megosztás felelősséget és elszámoltathatóságot jelent a tartalomért és a hozzáférésért."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Ajánlott egy konkrét csapattal vagy zárt csoporttal megosztani, nem mindenkivel."},com_button_accept:{english:"Accept",translated:"Elfogad"},com_button_decline:{english:"Decline",translated:"Elutasít"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Tudásbázis"},com_assistants_file_search:{english:"File Search",translated:"Fájlkeresés"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Adjon hozzá fájlokat, amelyeket az asszisztensnek keresnie kell, amikor kérdésekre válaszol a csevegésben."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Támogatott:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Tipp:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Kérje meg az asszisztenst, hogy minden válasznál használja a 'Fájlkereső eszközt'."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Vektortárolók csatolása a fájlkereséshez még nem támogatott. Csatolhatja őket a Szolgáltató Játszótéren, vagy fájlokat csatolhat üzenetekhez szál alapú kereséshez."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Hiba történt a fájlok vektortárolókból való lekérésekor."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Tudásbázis"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Töltsön fel fájlokat az asszisztenséhez, hogy azokat felhasználhassa kérdések megválaszolásához (pl. CXNGPT Felhasználói Útmutató)."},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Kattintson a Létrehozás gombra az asszisztens mentéséhez, majd töltse fel fájljait, és kattintson a Mentés gombra."},com_assistants_image_vision:{english:"Image Vision",translated:"Képlátás"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Kódértelmező"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Adjon hozzá fájlokat, amelyeket az asszisztensnek használnia kell az adatok elemzéséhez vagy átalakításához minden csevegés során."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Támogatott:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Tippek:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Kérje meg az asszisztenst, hogy minden válasznál használja a 'Kódértelmező eszközt'."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} a(z) {1} fájlból feltöltve"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"A következő fájlok csak a Kódértelmező számára elérhetők:"},com_assistants_retrieval:{english:"Retrieval",translated:"Lekérdezés"},com_assistants_search_name:{english:"Search assistants by name",translated:"Keresés asszisztensek között név alapján"},com_assistants_tools:{english:"Tools",translated:"Eszközök"},com_assistants_actions:{english:"Actions",translated:"Műveletek"},com_assistants_add_tools:{english:"Add Tools",translated:"Eszközök hozzáadása"},com_assistants_add_actions:{english:"Add Actions",translated:"Műveletek hozzáadása"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"A fájlkeresés nincs engedélyezve ezen a modellen. Kérjük, válasszon másik modellt."},com_assistants_available_actions:{english:"Available Actions",translated:"Elérhető műveletek"},com_assistants_running_action:{english:"Running action",translated:"Művelet futtatása"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Beszélt {0}-val"},com_assistants_completed_function:{english:"Ran {0}",translated:"{0} futtatva"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Fájlkeresés használva"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Az asszisztens használta: {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:"[eszköz feldolgozási hiba] Nem sikerült lekérni a megadott weboldal tartalmát. [100]"},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:"[eszköz feldolgozási hiba] Nem sikerült lekérni a megadott weboldal tartalmát. [101]"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Az asszisztens ezt az információt küldte: {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Törlés csak privát asszisztensekkel engedélyezett"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"A művelet sikeresen törölve az asszisztensből"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"A művelet sikeresen létrehozva vagy frissítve"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Hiba történt a művelet létrehozása vagy frissítése során."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Hiba történt a művelet törlése során."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Hagyja, hogy az asszisztense információkat kérjen le vagy műveleteket hajtson végre API-kon keresztül"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Nevezze el az asszisztenst (pl. Email Generátor)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Adjon meg asszisztensének konkrét, részletes, átfogó útmutatásokat a viselkedés irányításához (pl. Cél, Szerep, Tevékenységek, Közönség, Stílus, Szabályok, Feladat, Sablon, Példa)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Röviden írja le, mit tud az asszisztense (pl. E-mailek generálása sablonból)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Létre kell hoznia egy asszisztenst, mielőtt hozzáadhatna tevékenységeket."},com_assistants_update_success:{english:"Successfully updated",translated:"Sikeres frissítés"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Hiba történt az asszisztens frissítésekor."},com_assistants_create_success:{english:"Successfully created",translated:"Sikeres létrehozás"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Hiba történt az asszisztens létrehozásakor."},com_assistants_loading:{english:"Loading assistants...",translated:"Asszisztensek betöltése..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Kérjük, adjon meg indokot a PII engedélyezésére."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Beállítások és Adatvédelem"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"PII Törlés"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"A PII törlés alapértelmezetten engedélyezett ennél az asszisztens modellhívásainál."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"A PII engedélyezése letiltja a törlést ennél az asszisztens modellhívásainál. Ön felelős a szervezete adatvédelmi szabályainak betartásáért. Az aktivitás teljes mértékben naplózott és ellenőrzött."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Kérjük, magyarázza el a PII engedélyezésének okát (kötelező)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"A minimális hossz {0} karakter."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"A maximális hossz {0} karakter."},com_ui_date_today:{english:"Today",translated:"Ma"},com_ui_date_yesterday:{english:"Yesterday",translated:"Tegnap"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Előző 7 nap"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"Előző 30 nap"},com_ui_date_january:{english:"January",translated:"Január"},com_ui_date_february:{english:"February",translated:"Február"},com_ui_date_march:{english:"March",translated:"Március"},com_ui_date_april:{english:"April",translated:"Április"},com_ui_date_may:{english:"May",translated:"Május"},com_ui_date_june:{english:"June",translated:"Június"},com_ui_date_july:{english:"July",translated:"Július"},com