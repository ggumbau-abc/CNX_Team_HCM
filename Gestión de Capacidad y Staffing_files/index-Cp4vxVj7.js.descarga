pa yang pengguna katakan sebelumnya dalam percakapan"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Memungkinkan pengguna untuk memberikan koreksi tindak lanjut"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Dilatih untuk menolak permintaan yang tidak pantas"},com_ui_limitations:{english:"Limitations",translated:"Keterbatasan"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Mungkin sesekali menghasilkan informasi yang salah"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Mungkin sesekali menghasilkan instruksi yang berbahaya atau konten yang bias"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Pengetahuan terbatas tentang dunia dan peristiwa setelah 2021"},com_ui_input:{english:"Input",translated:"Masukan"},com_ui_close:{english:"Close",translated:"Tutup"},com_ui_model:{english:"Model",translated:"Model"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Nama tidak boleh kosong"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Nama tidak boleh mengandung karakter khusus atau spasi"},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Deskripsi tidak boleh kosong"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Instruksi tidak boleh kosong"},com_ui_category:{english:"Category",translated:"Category"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Assign a business category to help filter and organize assistants by function."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Kolom kategori tidak boleh kosong. Silahkan pilih kategori"},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Asisten dengan nama yang sama sudah ada"},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Dibagikan dengan tidak boleh kosong"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Nama tidak boleh mengandung kata-kata kasar"},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Deskripsi tidak boleh mengandung kata-kata kasar"},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Instruksi tidak boleh mengandung kata-kata kasar"},com_ui_shared_with:{english:"Shared With",translated:"Dibagikan dengan"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Private – Only you can access and view this assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Share only with Team – This assistant will be visible and accessible to your team members."},com_ui_shared_with_team:{english:"Team",translated:"Dibagikan dengan tim"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Tim tidak boleh kosong"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Asisten ini dikunci untuk pengeditan karena dibagikan dengan tim."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Kesalahan memuat tautan yang dibagikan."},com_ui_use_prompt:{english:"Use prompt",translated:"Gunakan petunjuk"},com_ui_prev:{english:"Prev",translated:"Sebelumnya"},com_ui_next:{english:"Next",translated:"Berikutnya"},com_ui_stop:{english:"Stop",translated:"Berhenti"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Template Petunjuk"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Sembunyikan Template Petunjuk"},com_ui_showing:{english:"Showing",translated:"Menampilkan"},com_ui_of:{english:"of",translated:"dari"},com_ui_entries:{english:"Entries",translated:"Entri"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Berhasil mengunggah file"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Ada kesalahan saat mengunggah file Anda"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"File tidak valid untuk diunggah. Harus berupa gambar yang tidak melebihi 2 MB"},com_ui_cancel:{english:"Cancel",translated:"Batal"},com_ui_save:{english:"Save",translated:"Simpan"},com_user_message:{english:"You",translated:"Kamu"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Salin ke papan klip"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Disalin ke papan klip"},com_ui_regenerate:{english:"Regenerate",translated:"Regenerasi"},com_ui_edit:{english:"Edit",translated:"Edit"},com_ui_all:{english:"all",translated:"semua"},com_ui_clear:{english:"Clear",translated:"Bersihkan"},com_ui_import_conversation:{english:"Import",translated:"Impor"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Impor percakapan dari file JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Percakapan berhasil diimpor"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Terjadi kesalahan saat mengimpor percakapan Anda"},com_ui_confirm_action:{english:"Confirm Action",translated:"Konfirmasi Aksi"},com_ui_share:{english:"Share",translated:"Share"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Share link to chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"There was an error sharing the chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Your name and any messages you add after sharing stay private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been created. Manage previously shared chats at any time via Settings."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Your name, custom instructions, and any messages you add after sharing stay private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Shared link not found"},com_ui_delete:{english:"Delete",translated:"Hapus"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Hapus chat?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Ini akan menghapus"},com_ui_rename:{english:"Rename",translated:"Renombrar"},com_ui_more_options:{english:"More",translated:"Lebih"},com_ui_preview:{english:"Preview",translated:"Pratinjau"},com_ui_upload:{english:"Upload",translated:"Unggah"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Pencarian file yang digunakan"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Tidak dapat masuk dengan informasi yang diberikan. Silakan periksa kredensial Anda dan coba lagi."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Terlalu banyak upaya masuk dalam waktu singkat. Silakan coba lagi nanti."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Akun Anda telah dilarang sementara karena pelanggaran layanan kami."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Ada kesalahan server internal. Harap tunggu beberapa saat dan coba lagi."},com_auth_sign_in:{english:"Login",translated:"Masuk"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:""}},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:""}},com_endpoint_system_message:{english:"System Message",translated:"Pesan Sistem"},com_endpoint_message:{english:"Message",translated:"Pesan"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Edit pesan Anda atau Regenerasi."},com_endpoint_default_blank:{english:"default: blank",translated:"default: kosong"},com_endpoint_default_false:{english:"default: false",translated:"default: salah"},com_endpoint_default_creative:{english:"default: creative",translated:"default: kreatif"},com_endpoint_default_empty:{english:"default: empty",translated:"default: kosong"},com_endpoint_default_with_num:{english:"default: {0}",translated:"default: {0}"},com_endpoint_context:{english:"Context",translated:"Konteks"},com_endpoint_tone_style:{english:"Tone Style",translated:"Gaya Nada"},com_endpoint_token_count:{english:"Token count",translated:"Jumlah Token"},com_endpoint_output:{english:"Output",translated:"Output"},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Tetapkan instruksi kustom atau konteks. Diabaikan jika kosong."},com_endpoint_custom_name:{english:"Custom Name",translated:"Nama Kustom"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Awalan Prompt"},com_endpoint_temperature:{english:"Temperature",translated:"Temperatur"},com_endpoint_default:{english:"default",translated:"default"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Token Output Maks"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Nilai yang lebih tinggi = lebih acak, sedangkan nilai yang lebih rendah = lebih fokus dan deterministik. Kami merekomendasikan untuk mengubah ini atau Top P tetapi tidak keduanya."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Token maksimum yang akan dihasilkan. Panjang total token masukan dan token yang dihasilkan dibatasi oleh panjang konteks model."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Sebuah alternatif untuk pengambilan sampel dengan suhu, disebut pengambilan sampel inti, di mana model mempertimbangkan hasil dari token dengan massa probabilitas top_p. Jadi 0,1 berarti hanya token yang mencakup 10% massa probabilitas teratas yang dipertimbangkan. Kami merekomendasikan untuk mengubah ini atau suhu tetapi tidak keduanya."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Angka antara -2,0 dan 2,0. Nilai positif menghukum token baru berdasarkan frekuensi mereka yang ada dalam teks sejauh ini, mengurangi kemungkinan model untuk mengulangi baris yang sama secara harfiah."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Angka antara -2,0 dan 2,0. Nilai positif menghukum token baru berdasarkan apakah mereka muncul dalam teks sejauh ini, meningkatkan kemungkinan model untuk berbicara tentang topik baru."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Resolusi untuk permintaan Vision. "Rendah" lebih murah dan lebih cepat, "Tinggi" lebih detail dan mahal, dan "Otomatis" akan secara otomatis memilih antara keduanya berdasarkan resolusi gambar.'},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Tetapkan nama kustom untuk ChatGPT"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Tetapkan instruksi kustom untuk dimasukkan dalam Pesan Sistem. Default: tidak ada"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Penalti Frekuensi"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Penalti Kehadiran"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Gunakan Fungsi"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Rincian Gambar"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Lewati Penyelesaian"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Tetapkan instruksi kustom untuk dimasukkan dalam Pesan Sistem. Default: tidak ada"},com_endpoint_import:{english:"Import",translated:"Impor"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Tetapkan nama kustom, jika Anda dapat menemukan preset ini"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Anda yakin ingin menghapus preset ini?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Preset Diimpor!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Ada kesalahan saat mengimpor preset Anda. Silakan coba lagi."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Ada kesalahan saat menyimpan preset Anda. Silakan coba lagi."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Ada kesalahan saat menghapus preset Anda. Silakan coba lagi."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"tidak lagi menjadi preset default."},com_endpoint_preset_default_item:{english:"Default:",translated:"Default:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Tidak ada preset default yang aktif."},com_endpoint_preset_title:{english:"Preset",translated:"Preset"},com_endpoint_preset_saved:{english:"Saved!",translated:"Tersimpan!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"sekarang menjadi preset default."},com_endpoint_preset:{english:"preset",translated:"preset"},com_endpoint_presets:{english:"presets",translated:"presets"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Aktif!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Nama Preset"},com_endpoint:{english:"Endpoint",translated:"Endpoint"},com_endpoint_examples:{english:" Presets",translated:" Preset"},com_endpoint_export:{english:"Export",translated:"Ekspor"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Simpan Sebagai Preset"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Anda yakin ingin menghapus semua preset? Ini tidak dapat dibatalkan."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Belum ada preset, gunakan tombol pengaturan untuk membuat satu"},com_endpoint_my_preset:{english:"My Preset",translated:"Preset Saya"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Model Agen (Direkomendasikan: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Model Penyelesaian (Direkomendasikan: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Aktifkan penggunaan Plugin sebagai Fungsi OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Aktifkan langkah penyelesaian yang dilewati, yang meninjau jawaban akhir dan langkah yang dihasilkan"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Atur Kunci Anda di menu Header untuk mengobrol."},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Bagaimana saya bisa membantu Anda hari ini?"},com_nav_profile_picture:{english:"Profile Picture",translated:"Foto Profil"},com_nav_change_picture:{english:"Change picture",translated:"Ubah foto"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Tampilkan Pengaturan Agen"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Tampilkan Pengaturan Penyelesaian"},com_hide_examples:{english:"Hide Examples",translated:"Sembunyikan Contoh"},com_show_examples:{english:"Show Examples",translated:"Tampilkan Contoh"},com_nav_export_filename:{english:"Filename",translated:"Nama File"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Atur nama file"},com_nav_export_type:{english:"Type",translated:"Tipe"},com_nav_export_conversation:{english:"Export conversation",translated:"Ekspor percakapan"},com_nav_export:{english:"Export",translated:"Ekspor"},com_nav_shared_links:{english:"Shared links",translated:"Link berbagi"},com_nav_shared_links_manage:{english:"Manage",translated:"Pengeluaran"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Anda tidak memiliki link berbagi."},com_nav_shared_links_name:{english:"Name",translated:"Nama"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Tanggal berbagi"},com_nav_source_chat:{english:"View source chat",translated:"View source chat"},com_nav_my_files:{english:"File Manager",translated:"File Manager"},com_nav_admin_center:{english:"Admin Center",translated:"Pusat Administrasi"},com_nav_theme:{english:"Theme",translated:"Tema"},com_nav_theme_system:{english:"System",translated:"Sistem"},com_nav_theme_dark:{english:"Dark",translated:"Gelap"},com_nav_theme_light:{english:"Light",translated:"Terang"},com_nav_user_name_display:{english:"Display username in messages",translated:"Tampilkan nama pengguna dalam pesan"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Hapus semua obrolan"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Konfirmasi Hapus"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Tutup sidebar"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Buka sidebar"},com_nav_send_message:{english:"Send message",translated:"Kirim pesan"},com_nav_log_out:{english:"Log out",translated:"Keluar"},com_nav_user:{english:"USER",translated:"PENGGUNA"},com_nav_archived_chats:{english:"Archived chats",translated:"Percakapan Arsip"},com_nav_archived_chats_manage:{english:"Manage",translated:"Pengelolaan"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Tidak ada percakapan yang diarsipkan."},com_nav_archive_name:{english:"Name",translated:"Nama"},com_nav_archive_created_at:{english:"DateCreated",translated:"TanggalDibuat"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Hapus percakapan"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Anda yakin ingin menghapus semua percakapan? Ini tidak dapat dibatalkan."},com_nav_help:{english:"Help",translated:"Bantuan"},com_nav_settings:{english:"Settings",translated:"Pengaturan"},com_nav_search_placeholder:{english:"Search messages",translated:"Cari pesan"},com_nav_setting_general:{english:"General",translated:"Umum"},com_nav_language:{english:"Language",translated:"Bahasa"},com_nav_lang_auto:{english:"Auto detect",translated:"Deteksi otomatis"},com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Tampaknya konten yang dikirim telah ditandai oleh sistem moderasi kami karena tidak sesuai dengan pedoman komunitas kami. Kami tidak dapat melanjutkan dengan topik ini. Jika Anda memiliki pertanyaan atau topik lain yang ingin dijelajahi, silakan edit pesan Anda, atau buat percakapan baru."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Tidak ada kunci ditemukan. Harap berikan kunci dan coba lagi."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Tidak ada URL dasar ditemukan. Harap berikan satu dan coba lagi."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Kunci yang diberikan tidak valid. Harap berikan kunci dan coba lagi."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Kunci yang diberikan untuk {0} kedaluwarsa pada {1}. Harap berikan kunci dan coba lagi."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Anda telah mencapai maksimum token untuk lisensi Anda. Harap hubungi penjualan di {0} untuk bantuan lebih lanjut."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Anda telah menggunakan {0}% dari token yang dialokasikan. Harap hubungi {1} untuk bantuan lebih lanjut."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Lisensi Anda tidak tersedia. Harap hubungi dukungan untuk bantuan lebih lanjut."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Alamat IPv6 tidak didukung. Harap gunakan koneksi IPv4 atau hubungi dukungan untuk bantuan lebih lanjut."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Terjadi kesalahan saat memproses permintaan Anda. Harap coba lagi."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"File {0} sudah berhasil diunggah"},com_files_no_results:{english:"No results.",translated:"Tidak ada hasil."},com_files_filter:{english:"Search files by name",translated:"Cari file berdasarkan nama"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} dari {1} file dipilih"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Pilih Asisten"},com_sidepanel_parameters:{english:"Parameters",translated:"Parameter"},com_ui_create_assistant:{english:"Create Assistant",translated:"Buat Asisten"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Pengguna memerlukan izin untuk membuat Asisten"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Asisten"},com_sidepanel_attach_files:{english:"File Manager",translated:"Pengelola File"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Kelola File"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Persetujuan"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Anda akan membagikan asisten ini dengan anggota tim lainnya. Sebelum membagikan asisten ini, harap tinjau poin-poin penting di bawah ini:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Dengan melanjutkan, Anda mengonfirmasi bahwa Anda memahami dan menerima syarat-syarat ini."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Asisten yang dibagikan tidak boleh mengandung data sensitif atau rahasia."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Asisten yang dibagikan tidak boleh memproses data sensitif atau rahasia."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Berbagi berarti bertanggung jawab atas konten dan akses."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Disarankan untuk berbagi dengan tim tertentu atau grup tertutup, bukan semua orang."},com_button_accept:{english:"Accept",translated:"Terima"},com_button_decline:{english:"Decline",translated:"Tolak"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Basis Pengetahuan"},com_assistants_file_search:{english:"File Search",translated:"Pencarian File"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Tambahkan file di sini yang perlu dicari asisten Anda saat menjawab pertanyaan di chat."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Didukung:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Tip:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Minta asisten Anda menggunakan 'Alat Pencarian File' setiap kali merespons pengguna."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Melampirkan penyimpanan vektor untuk Pencarian File belum didukung. Anda dapat melampirkannya dari Provider Playground atau melampirkan file ke pesan untuk pencarian file berdasarkan thread."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Terjadi kesalahan saat mengambil file dari penyimpanan vektor."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Basis Pengetahuan"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Unggah file ke asisten Anda, agar dapat menggunakannya untuk menjawab pertanyaan (mis. Panduan Pengguna CXNGPT)"},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Klik Buat untuk menyimpan Asisten Anda, lalu unggah file Anda, dan klik Simpan."},com_assistants_image_vision:{english:"Image Vision",translated:"Visi Gambar"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Penerjemah Kode"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Tambahkan file di sini yang perlu digunakan asisten Anda untuk menganalisis atau mengubah data untuk setiap chat."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Didukung:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Tips:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Minta asisten Anda menggunakan 'Alat Penerjemah Kode' setiap kali merespons pengguna."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} dari {1} file diunggah"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"File berikut hanya tersedia untuk Code Interpreter:"},com_assistants_retrieval:{english:"Retrieval",translated:"Pengambilan"},com_assistants_search_name:{english:"Search assistants by name",translated:"Cari asisten berdasarkan nama"},com_assistants_tools:{english:"Tools",translated:"Alat"},com_assistants_actions:{english:"Actions",translated:"Tindakan"},com_assistants_add_tools:{english:"Add Tools",translated:"Tambah Alat"},com_assistants_add_actions:{english:"Add Actions",translated:"Tambah Tindakan"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Pencarian file tidak diaktifkan pada model ini. Silakan pilih model lain."},com_assistants_available_actions:{english:"Available Actions",translated:"Tindakan Tersedia"},com_assistants_running_action:{english:"Running action",translated:"Menjalankan tindakan"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Berbicara dengan {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"Menjalankan {0}"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Asisten menggunakan {0}"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Asisten mengirim info ini ke {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Penghapusan hanya diizinkan dengan Asisten pribadi"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Berhasil menghapus Tindakan dari Asisten"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Berhasil membuat atau memperbarui Tindakan"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Terjadi kesalahan saat membuat atau memperbarui tindakan."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Terjadi kesalahan saat menghapus tindakan."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Biarkan Asisten Anda mengambil informasi atau melakukan tindakan melalui API"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Beri nama asisten Anda (mis. Pembuat Email)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Berikan panduan spesifik, rinci, dan komprehensif kepada asisten Anda untuk mengarahkan perilakunya (mis. Tujuan, Peran, Tindakan, Audiens, Gaya, Aturan, Tugas, Template, Contoh)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Jelaskan secara singkat apa yang dapat dilakukan asisten Anda (mis. Menghasilkan email dari template)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Anda perlu membuat asisten sebelum menambahkan tindakan."},com_assistants_update_success:{english:"Successfully updated",translated:"Berhasil diperbarui"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Terjadi kesalahan saat memperbarui asisten Anda."},com_assistants_create_success:{english:"Successfully created",translated:"Berhasil dibuat"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Terjadi kesalahan saat membuat asisten Anda."},com_assistants_loading:{english:"Loading assistants...",translated:"Memuat asisten..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Harap berikan alasan untuk mengaktifkan PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Pengaturan & Privasi"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Redaksi PII"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"Redaksi PII diaktifkan secara default untuk panggilan model asisten ini."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Mengizinkan PII menonaktifkan redaksi untuk panggilan model asisten ini. Anda bertanggung jawab untuk mematuhi kebijakan data organisasi Anda. Aktivitas sepenuhnya dicatat dan dipantau."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Harap jelaskan alasan Anda mengaktifkan PII (wajib)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Panjang minimum adalah {0} karakter."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Panjang maksimum adalah {0} karakter."},com_ui_date_today:{english:"Today",translated:"Hari ini"},com_ui_date_yesterday:{english:"Yesterday",translated:"Kemarin"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"7 hari sebelumnya"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"30 hari sebelumnya"},com_ui_date_january:{english:"January",translated:"Januari"},com_ui_date_february:{english:"February",translated:"Februari"},com_ui_date_march:{english:"March",translated:"Maret"},com_ui_date_april:{english:"April",translated:"April"},com_ui_date_may:{english:"May",translated:"Mei"},com_ui_date_june:{english:"June",translated:"Juni"},com_ui_date_july:{english:"July",translated:"Juli"},com_ui_date_august:{english:"August",translated:"Agustus"},com_ui_date_september:{english:"September",translated:"September"},com_ui_date_october:{english:"October",translated:"Oktober"},com_ui_date_november:{english:"November",translated:"November"},com_ui_date_december:{english:"December",translated:"Desember"},com_ui_field_required:{english:"This field is required",translated:"Kolom ini wajib diisi"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Kesalahan mengunduh file. File mungkin telah dihapus."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Jenis file tidak didukung untuk endpoint:"},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Tidak dapat melampirkan file Asisten ke endpoint lain"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Batas ukuran file terlampaui untuk endpoint:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Tidak dapat melampirkan file. Buat atau pilih percakapan, atau coba segarkan halaman."},com_ui_kbot_assistants:{english:"Knowledge",translated:"Pengetahuan"},com_ui_assistant_default_category:{english:"General",translated:"Umum"},com_ui_assistant_featured:{english:"Featured",translated:"Unggulan"},co