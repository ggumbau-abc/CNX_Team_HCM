g:{english:"Explain quantum computing in simple terms",translated:"Ipaliwanag ang quantum computing sa simpleng paraan"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"Mayroon ka bang malikhaing ideya para sa kaarawan ng 10 taong gulang?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"Paano ako makakagawa ng HTTP request sa Javascript?"},com_ui_category_placeholder:{english:"Search a category",translated:"Maghanap ng kategorya"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Maghanap ng tool"},com_ui_capabilities:{english:"Capabilities",translated:"Mga Kakayahan"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"Naaalala ang sinabi ng user sa naunang pag-uusap"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Pinapayagan ang user na magbigay ng mga susunod na pagwawasto"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Sinanay na tanggihan ang hindi angkop na mga kahilingan"},com_ui_limitations:{english:"Limitations",translated:"Mga Limitasyon"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Paminsan-minsan ay maaaring makabuo ng maling impormasyon"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Paminsan-minsan ay maaaring makabuo ng mapanganib na mga tagubilin o may kinikilingang nilalaman"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Limitado ang kaalaman sa mundo at mga kaganapan pagkatapos ng 2021"},com_ui_on:{english:"On",translated:"Bukas"},com_ui_off:{english:"Off",translated:"Patay"},com_ui_yes:{english:"Yes",translated:"Oo"},com_ui_no:{english:"No",translated:"Hindi"},com_ui_ascending:{english:"Asc",translated:"Pataas"},com_ui_descending:{english:"Desc",translated:"Pababa"},com_ui_show_all:{english:"Show All",translated:"Ipakita Lahat"},com_ui_name:{english:"Name",translated:"Pangalan"},com_ui_date:{english:"Date",translated:"Petsa"},com_ui_storage:{english:"Storage",translated:"Imbakan"},com_ui_context:{english:"Context",translated:"Konteksto"},com_ui_size:{english:"Size",translated:"Laki"},com_ui_host:{english:"Host",translated:"Host"},com_ui_update:{english:"Update",translated:"I-update"},com_ui_authentication:{english:"Authentication",translated:"Pagpapatunay"},com_ui_instructions:{english:"Instructions",translated:"Mga Tagubilin"},com_ui_description:{english:"Description",translated:"Paglalarawan"},com_ui_category:{english:"Category",translated:"Kategorya"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Magtalaga ng kategorya ng negosyo para makatulong sa pag-filter at pag-organisa ng mga assistant ayon sa tungkulin."},com_ui_error:{english:"Error",translated:"Error"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Error sa pagkonekta sa server, subukang i-refresh ang pahina."},com_ui_select:{english:"Select",translated:"Piliin"},com_ui_select_placeholder:{english:"Select options",translated:"Piliin ang mga opsyon"},com_ui_remove:{english:"Remove",translated:"Alisin"},com_ui_input:{english:"Input",translated:"Input"},com_ui_close:{english:"Close",translated:"Isara"},com_ui_model:{english:"Model",translated:"Modelo"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Hindi maaaring walang laman ang field ng pangalan ng assistant. Mangyaring maglagay ng wastong pangalan."},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Ginamit ang Smart Prefix para sa mga General Assistant, mangyaring gu