lated:"Non hai link condivisi."},com_nav_shared_links_name:{english:"Name",translated:"Nome"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Data condivisione"},com_nav_my_files:{english:"File Manager",translated:"I miei file"},com_nav_admin_center:{english:"Admin Center",translated:"Centro di Amministrazione"},com_nav_theme:{english:"Theme",translated:"Tema"},com_nav_theme_system:{english:"System",translated:"Sistema"},com_nav_theme_dark:{english:"Dark",translated:"Scuro"},com_nav_theme_light:{english:"Light",translated:"Chiaro"},com_nav_user_name_display:{english:"Display username in messages",translated:"Mostra nome utente nei messaggi"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Cancella tutte le chat"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Conferma cancellazione"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Chiudi barra laterale"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Apri barra laterale"},com_nav_send_message:{english:"Send message",translated:"Invia messaggio"},com_nav_log_out:{english:"Log out",translated:"Disconnetti"},com_nav_user:{english:"USER",translated:"UTENTE"},com_nav_archived_chats:{english:"Archived chats",translated:"Chat archiviate"},com_nav_archived_chats_manage:{english:"Manage",translated:"Gestisci"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Non hai chat archiviate."},com_nav_archive_name:{english:"Name",translated:"Nome"},com_nav_archive_created_at:{english:"DateCreated",translated:"DateCreated"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Cancella conversazioni"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Sei sicuro di voler cancellare tutte le conversazioni? Questa azione è irreversibile."},com_nav_help:{english:"Help",translated:"Guida"},com_nav_settings:{english:"Settings",translated:"Impostazioni"},com_nav_search_placeholder:{english:"Search messages",translated:"Cerca messaggi"},com_nav_setting_general:{english:"General",translated:"Generali"},com_nav_setting_speech:{english:"Speech",translated:"Voce"},com_assistants_file_search:{english:"File Search",translated:"Ricerca File"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Ricerca file nei messaggi"},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Estensioni supportate:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Suggerimenti:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Allega file ai messaggi per la ricerca file su base di thread."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"L'aggiunta di archivi vettoriali per la Ricerca File non è ancora supportata. Puoi aggiungerli dal Provider Playground o allegare file ai messaggi per la ricerca file su base di thread."},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"La ricerca di file non è abilitata su questo modello. Seleziona un altro modello."},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Non è possibile allegare file dell'Assistente ad altri endpoint"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Assistente eliminato con successo"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Si è verificato un errore durante l'eliminazione dell'assistente"},com_ui_copied:{english:"Copied!",translated:"Copiato!"},com_ui_copy_code:{english:"Copy code",translated:"Copia codice"},com_ui_copy_link:{english:"Copy link",translated:"Copia link"},com_ui_update_link:{english:"Update link",translated:"Aggiorna link"},com_ui_create_link:{english:"Create link",translated:"Crea link"},com_nav_source_chat:{english:"View source chat",translated:"Visualizza chat sorgente"},com_ui_date_today:{english:"Today",translated:"Oggi"},com_ui_date_yesterday:{english:"Yesterday",translated:"Ieri"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Ultimi 7 giorni"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"Ultimi 30 giorni"},com_ui_date_january:{english:"January",translated:"Gennaio"},com_ui_date_february:{english:"February",translated:"Febbraio"},com_ui_date_march:{english:"March",translated:"Marzo"},com_ui_date_april:{english:"April",translated:"Aprile"},com_ui_date_may:{english:"May",translated:"Maggio"},com_ui_date_june:{english:"June",translated:"Giugno"},com_ui_date_july:{english:"July",translated:"Luglio"},com_ui_date_august:{english:"August",translated:"Agosto"},com_ui_date_september:{english:"September",translated:"Settembre"},com_ui_date_october:{english:"October",translated:"Ottobre"},com_ui_date_november:{english:"November",translated:"Novembre"},com_ui_date_december:{english:"December",translated:"Dicembre"},com_ui_nothing_found:{english:"Nothing found",translated:"Non è stato trovato nulla"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Vai alla conversazione"},com_user_message:{english:"You",translated:"Mostra nome utente nei messaggi"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Menziona un endpoint, assistente o preset per passare rapidamente ad esso"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Token di Contesto Massimi"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:"Il numero massimo di token che possono essere utilizzati per il contesto. Usalo per controllare quanti token vengono inviati per richiesta. Se non specificato, verranno utilizzate le impostazioni di sistema predefinite in base alle dimensioni del contesto dei modelli noti. Impostare valori più alti potrebbe causare errori e/o costi di token più elevati."},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Campo `max_tokens` opzionale, che rappresenta il numero massimo di token che possono essere generati nel completamento della chat.\n\nLa lunghezza totale dei token di input e dei token generati è limitata dalla lunghezza del contesto del modello. Potresti riscontrare errori se questo numero supera il massimo dei token di contesto."},com_nav_language:{english:"Language",translated:"Lingua"},com_nav_lang_auto:{english:"Auto detect",translated:"Rileva automaticamente"},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Hai raggiunto il massimo dei token per la tua licenza. Contatta le vendite a {0} per ulteriore assistenza."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Hai utilizzato il {0}% dei tuoi token assegnati. Contatta {1} per ulteriore assistenza."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"La tua licenza non è disponibile. Contatta il supporto per ulteriore assistenza."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Gli indirizzi IPv6 non sono supportati. Utilizza una connessione IPv4 o contatta il supporto per ulteriore assistenza."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Si è verificato un errore durante l'elaborazione della tua richiesta. Riprova."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Il file {0} è già stato caricato con successo"},com_ui_create_assistant:{english:"Create Assistant",translated:"Crea Assistente"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"L'utente necessita di permessi di creazione per creare un Assistente"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Consenso"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Stai per condividere questo assistente con altri membri del team. Prima di condividerlo, rivedi i punti chiave seguenti:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Procedendo, confermi di comprendere e accettare questi termini."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"L'assistente condiviso non deve contenere dati sensibili o riservati."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Gli assistenti condivisi non devono elaborare dati sensibili o riservati."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"La condivisione implica responsabilità per il contenuto e l'accesso."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Si consiglia di condividere con un team specifico o gruppo chiuso anziché con tutti."},com_button_accept:{english:"Accept",translated:"Accetta"},com_button_decline:{english:"Decline",translated:"Rifiuta"},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Si è verificato un problema durante il recupero dei file dagli archivi vettoriali."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} di {1} file caricati"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Eliminazione consentita solo con Assistenti privati"},com_assistants_loading:{english:"Loading assistants...",translated:"Caricamento assistenti..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Fornisci una ragione per abilitare la redazione PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Impostazioni e Privacy"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Redazione PII"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"La redazione PII è abilitata per le chiamate modello di questo assistente per impostazione predefinita."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Consentire PII disabilita la redazione per le chiamate modello di questo assistente. Sei responsabile del rispetto delle politiche sui dati della tua organizzazione. L'attività è completamente registrata e monitorata."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Spiega il motivo per abilitare PII (obbligatorio)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"La lunghezza minima è di {0} caratteri."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"La lunghezza massima è di {0} caratteri."},com_ui_kbot_assistants:{english:"Knowledge",translated:"Conoscenza"},com_ui_assistant_default_category:{english:"General",translated:"Generale"},com_ui_assistant_featured:{english:"Featured",translated:"In evidenza"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Nessun assistente corrisponde ai criteri di ricerca."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Nessun assistente trovato."},com_ui_category_placeholder:{english:"Search a category",translated:"Cerca una categoria"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Cerca uno strumento"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Errore di connessione al server, prova a ricaricare la pagina."},com_ui_select_placeholder:{english:"Select options",translated:"Seleziona opzioni"},com_ui_remove:{english:"Remove",translated:"Rimuovi"},com_ui_thinking:{english:"Thinking",translated:"Sto pensando"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Analizzando la tua richiesta"},com_ui_processing:{english:"Putting it together",translated:"Elaborazione"},com_ui_working_on_it:{english:"Almost ready",translated:"Ci sto lavorando"},com_ui_read_aloud:{english:"Read aloud",translated:"Leggi ad alta voce"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"File duplicato rilevato."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Si è verificato un errore durante il caricamento del file."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Errore durante il caricamento del file: Endpoint non definito"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"File vuoti non sono consentiti."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Puoi caricare solo fino a {0} file alla volta."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Puoi caricare solo fino a {0} file in questa sezione."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Il limite di caricamento è stato raggiunto per {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Impossibile determinare il tipo di file per: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Tipo di file non supportato. Carica un formato di file supportato."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Caricamento immagine fallito"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Attualmente, sono supportati solo file JPEG, JPG, PNG e WEBP."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"La dimensione del file supera {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"La dimensione totale dei file non può superare {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Si è verificato un errore durante la convalida del file."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Si è verificato un errore durante l'elaborazione del file."},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Assistenza Studio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Conoscenza"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Non categorizzato"},com_ui_use_micrphone:{english:"Use microphone",translated:"Usa microfono"},com_endpoint_export_share:{english:"Export/Share",translated:"Esporta/Condividi"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Da Testo a Voce"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Riproduzione Automatica Ultimo Messaggio"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Da Voce a Testo"},com_nav_user_guide:{english:"User Guide",translated:"Guida Utente"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Invio automatico testo (dopo 3 sec)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Errore nella riproduzione audio: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Errore nell'elaborazione audio: {0}"},com_nav_engine:{english:"Engine",translated:"Motore"},com_nav_browser:{english:"Browser",translated:"Browser"},com_nav_external:{english:"External",translated:"Esterno"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Elimina cache"},com_nav_voice_select:{english:"Voice",translated:"Voce"},com_page_not_found:{english:"Page not found",translated:"Pagina non trovata"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Qualcosa è andato storto"},com_unauthorized_access:{english:"Unauthorized access",translated:"Accesso non autorizzato"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Accesso non autorizzato. L'accesso è limitato a domini specifici."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Il tuo account è stato temporaneamente sospeso a causa di violazioni del nostro servizio"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Sei limitato ad accedere all'app al di fuori della rete!"},com_support_ticket_text:{english:"Support Ticket",translated:"Ticket di supporto"},com_help_dialog_Header:{english:"Need assistance?",translated:"Hai bisogno di assistenza?"},com_help_dialog_text_1_1:{english:"Click",translated:"Clicca"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"per istruzioni dettagliate"},com_help_dialog_text_here:{english:"here",translated:"qui"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Per problemi, compila un"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Per problemi, contatta"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Trova i passaggi"},com_status_ind_none:{english:"Operational",translated:"Operativo"},com_status_ind_minor:{english:"Minor Issues",translated:"Problemi minori"},com_status_ind_major:{english:"Major Issues",translated:"Problemi maggiori"},com_status_ind_critical:{english:"Critical",translated:"Critico"},com_status_ind_error:{english:"Error Fetching",translated:"Errore di recupero"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Nota che quando lasci una chat o inizi una nuova chat, perderai la cronologia della conversazione."},com_forbidden_access:{english:"Forbidden access",translated:"Accesso vietato"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Politica di uso accettabile"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Politica sulla privacy"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Accordo di Sottoscrizione"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Prima di usare iX Hello, puoi rivedere il "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Iscrivendoti e/o accedendo, accetti i termini sopra indicati."},com_login_page_and:{english:"and ",translated:"e "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Nessun assistente fissato"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Assistenti fissati"},com_ui_loading:{english:"Loading...",translated:"Caricamento..."},com_ui_unpin:{english:"Unpin",translated:"Rimuovi"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Assistente rimosso con successo"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Errore nella rimozione dell'assistente"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Assistente fissato con successo"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Errore nel fissare/rimuovere l'assistente"},com_ui_pin:{english:"Pin",translated:"Fissa"},come_create_assistant:{english:"Create Assistant",translated:"Crea Assistente"},come_edit_assistant:{english:"Edit Assistant",translated:"Modifica Assistente"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Sei sicuro di voler procedere? Questo comporterà la perdita di eventuali modifiche apportate all'Assistente che stai attualmente modificando o creando. Questa azione non può essere annullata."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Assistente con id {0} non trovato."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Il browser non supporta il riconoscimento vocale"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Permesso per il microfono non concesso"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Errore nell'avvio della registrazione: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder non sta registrando"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder non è supportato in questo browser"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Il tuo messaggio contiene informazioni personali e non può essere inviato. Rimuovi eventuali informazioni personali."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Rinominazione della conversazione fallita"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Hai {0} dei tuoi token assegnati rimanenti."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello può commettere errori. Verifica tutti i risultati per qualità e accuratezza. Tutti gli input sono registrati per conformità."},com_ui_assistant_group_by:{english:"Group by",translated:"Raggruppa per"},com_ui_assistant_category:{english:"Category",translated:"Categoria"},com_ui_assistant_team:{english:"Team",translated:"Squadra"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Ingegneria"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Intelligenza"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Operazioni"},com_ui_assistant_sales:{english:"Sales",translated:"Vendite"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategia"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Assistenti Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Carica un'immagine avatar (PNG o JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Cerca Online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Naviga Sito"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Genera Immagini"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Calcola Matematica"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Strumento Predefinito"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Il caricamento del file sta impiegando più tempo del previsto. Riprova."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Errore nel fissare l'assistente"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Si è verificato un errore durante l'eliminazione del link condiviso"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Modello DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated: