_ui_assistant_tools_codeexecutor:"Spouštění vašeho kódu",com_ui_assistant_tools_rag_query:"Prohledávání znalostní báze",com_ui_assistant_tools_voiceworx:"Zpracování hlasu",com_ui_assistant_tools_memory_store:"Ukládání do paměti",com_ui_assistant_tools_memory_delete:"Odstraňování z paměti",com_ui_assistant_tools_completed_search_online:"Vyhledávání na webu dokončeno",com_ui_assistant_tools_completed_browse_website:"Kontrola webové stránky dokončena",com_ui_assistant_tools_completed_generate_image:"Obrázek vygenerován",com_ui_assistant_tools_completed_calculate_math:"Výpočet dokončen",com_ui_assistant_tools_completed_codeexecutor:"Spouštění vašeho kódu dokončeno",com_ui_assistant_tools_completed_rag_query:"Prohledávání znalostní báze dokončeno",com_ui_assistant_tools_completed_voiceworx:"Zpracování hlasového vstupu dokončeno",com_ui_assistant_tools_completed_memory_store:"Uloženo do paměti",com_ui_assistant_tools_completed_memory_delete:"Odstraněno z paměti",com_ui_assistant_tools_completed_fallback:"Dokončeno: {0}",com_ui_still_working:"stále pracuje...",com_assistants_pii_entity_phone:"Telefonní číslo",com_assistants_pii_entity_email:"E-mailová adresa",com_assistants_pii_entity_credit_card:"Kreditní karta",com_assistants_pii_entity_ssn:"Rodné číslo",com_assistants_memory_enabled:"Paměť",com_assistants_memory_enabled_info:"Paměť je pro tohoto asistenta zapnutá. Asistent může ukládat a vybavovat si fakta napříč konverzacemi.",com_assistants_memory_disabled_info:"Paměť je pro tohoto asistenta vypnutá. Žádná fakta se nebudou ukládat ani vybavovat napříč konverzacemi.",com_assistants_memory_enabled_off_reason_placeholder:"Uveďte prosím obchodní důvod pro vypnutí paměti (povinné).",com_assistants_memory_enabled_reason_required:"Uveďte prosím důvod pro vypnutí paměti.",com_nav_memory_team_disabled:"Paměť je pro váš tým vypnutá. Můžete zobrazit a smazat existující vzpomínky, ale nemůžete přidávat ani upravovat nové.",com_ui_file_ready:"{0} je připraven",com_ui_file_ready_fallback:"Soubor je připraven",com_ui_file_processing_failed:"{0} se nepodařilo zpracovat",com_ui_file_processing_failed_fallback:"Soubor se nepodařilo zpracovat",com_ui_file_processing_failed_reupload:"{0} se nepodařilo zpracovat. Nahrajte soubor znovu.",com_ui_file_processing_failed_reupload_fallback:"Soubor se nepodařilo zpracovat. Nahrajte soubor znovu.",com_ui_file_processing:"Zpracování...",com_ui_file_processing_failed_status:"Zpracování selhalo",com_ui_file_processing_failed_reupload_required:"Selhalo – je nutné soubor znovu nahrát",com_ui_file_retry:"Zkusit znovu",com_ui_file_retry_in:"Zkusit znovu za {0}s",com_ui_file_indexing_retrying:"Opakuje se indexace souboru...",com_ui_file_retry_wait:"Před dalším pokusem počkejte {0}s",com_ui_file_retries_exhausted_reupload:"Byl dosažen maximální počet pokusů. Nahrajte soubor znovu.",com_ui_assistant_file_upload_invalid_json:"Neplatný soubor JSON. Obsah souboru neodpovídá očekávanému formátu."},zv={com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Zdá se, že obsah byl označen naším moderátorským systémem za nesoulad s komunitními pravidly. Nemůžeme pokračovat s tímto tématem. Pokud máte jiné otázky nebo témata, upravte svou zprávu nebo vytvořte novou konverzaci."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Klíč nebyl nalezen. Poskytněte klíč a zkuste to znovu."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Základní URL nebylo nalezeno. Poskytněte ho a zkuste to znovu."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Poskytnut neplatný klíč. Poskytněte klíč a zkuste to znovu."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Poskytnutý klíč pro {0} vypršel {1}. Poskytněte klíč a zkuste to znovu."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Dosáhli jste měsíčního limitu používání. Kontaktujte administrátora týmu pro pomoc."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Dosáhli jste maximálního počtu tokenů pro vaši licenci. Kontaktujte prodej na {0} pro další pomoc."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Použili jste {0}% přidělených tokenů. Kontaktujte {1} pro další pomoc."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Vaše licence není dostupná. Kontaktujte podporu pro další pomoc."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"IPv6 adresy nejsou podporovány. Použijte připojení IPv4 nebo kontaktujte podporu pro další pomoc."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Při zpracování vaší žádosti došlo k chybě. Zkuste to znovu."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Soubor {0} byl již úspěšně nahrán"},com_files_no_results:{english:"No results.",translated:"Žádné výsledky."},com_files_filter:{english:"Search files by name",translated:"Hledat soubory podle názvu"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} z {1} souboru(ů) vybráno"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Vyberte asistenta"},com_sidepanel_parameters:{english:"Parameters",translated:"Parametry"},com_ui_create_assistant:{english:"Create Assistant",translated:"Vytvořit asistenta"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Uživatel potřebuje oprávnění k vytvoření asistenta"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Asistenti"},com_sidepanel_attach_files:{english:"File Manager",translated:"Správce souborů"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Spravovat soubory"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Souhlas"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Chystáte se sdílet tohoto asistenta s ostatními členy týmu. Před sdílením asistenta si prosím přečtěte klíčové body níže:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Pokračováním potvrzujete, že rozumíte a přijímáte tyto podmínky."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Sdílený asistent by neměl obsahovat citlivá nebo důvěrná data."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Sdílení asistentů nesmí zpracovávat citlivá nebo důvěrná data."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Sdílení znamená odpovědnost za obsah a přístup."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Doporučuje se sdílet s konkrétním týmem nebo uzavřenou skupinou místo s každým."},com_button_accept:{english:"Accept",translated:"Přijmout"},com_button_decline:{english:"Decline",translated:"Odmítnout"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Znalostní báze"},com_assistants_file_search:{english:"File Search",translated:"Vyhledávání souborů"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Přidejte sem soubory, které váš asistent potřebuje pro vyhledávání při odpovídání na otázky v chatu."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Podporováno:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Tip:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Požádejte svého asistenta, aby použil 'Nástroj pro vyhledávání souborů' při každé odpovědi uživatelům."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Připojení vektorových úložišť pro vyhledávání souborů zatím není podporováno. Můžete je připojit z Provider Playground nebo připojit soubory k zprávám pro vyhledávání souborů na základě vlákna."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Při načítání souborů z vektorových úložišť došlo k chybě."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Znalostní báze"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Nahrajte soubory do svého asistenta, aby je mohl použít k odpovídání na otázky (např. CXNGPT Uživatelská příručka)."},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Klikněte na Vytvořit pro uložení asistenta, poté nahrajte soubory a klikněte na Uložit."},com_assistants_image_vision:{english:"Image Vision",translated:"Vize obrazu"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Interpret kódu"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Přidejte sem soubory, které váš asistent potřebuje pro analýzu nebo transformaci dat pro každý chat."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Podporováno:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Tipy:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Požádejte svého asistenta, aby použil 'Nástroj pro interpretaci kódu' při každé odpovědi uživatelům."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} z {1} souborů nahráno"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Následující soubory jsou dostupné pouze pro Code Interpreter:"},com_assistants_retrieval:{english:"Retrieval",translated:"Vyhledávání"},com_assistants_search_name:{english:"Search assistants by name",translated:"Hledat asistenty podle jména"},com_assistants_tools:{english:"Tools",translated:"Nástroje"},com_assistants_actions:{english:"Actions",translated:"Akce"},com_assistants_add_tools:{english:"Add Tools",translated:"Přidat nástroje"},com_assistants_add_actions:{english:"Add Actions",translated:"Přidat akce"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Vyhledávání souborů není na tomto modelu povoleno. Vyberte jiný model."},com_assistants_available_actions:{english:"Available Actions",translated:"Dostupné akce"},com_assistants_running_action:{english:"Running action",translated:"Probíhá akce"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Mluvil s {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"Spuštěno {0}"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Použito vyhledávání souborů"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Asistent použil {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:"[chyba při zpracování nástroje] Nepodařilo se načíst obsah dané webové stránky. [100]"},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:"[chyba při zpracování nástroje] Nepodařilo se načíst obsah dané webové stránky. [101]"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Asistent poslal tuto informaci {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Mazání je povoleno pouze u soukromých asistentů"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Akce úspěšně odstraněna z asistenta"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Akce úspěšně vytvořena nebo aktualizována"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Při vytváření nebo aktualizaci akce došlo k chybě."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Při mazání akce došlo k chybě."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Umožněte svému asistentovi získávat informace nebo provádět akce prostřednictvím API"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Pojmenujte svého asistenta (např. Generátor e-mailů)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Poskytněte asistentovi konkrétní, podrobné a komplexní pokyny k řízení jeho chování (tj. Cíl, Role, Akce, Publikum, Styl, Pravidla, Úkol, Šablona, Příklad)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Stručně popište, co váš asistent umí (tj. Generovat e-maily ze šablony)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Než přidáte akce, musíte vytvořit asistenta."},com_assistants_update_success:{english:"Successfully updated",translated:"Úspěšně aktualizováno"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Při aktualizaci asistenta došlo k chybě."},com_assistants_create_success:{english:"Successfully created",translated:"Úspěšně vytvořeno"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Při vytváření asistenta došlo k chybě."},com_assistants_loading:{english:"Loading assistants...",translated:"Načítání asistentů..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Uveďte důvod pro povolení PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Nastavení a soukromí"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Redakce PII"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"Redakce PII je pro volání modelu tohoto asistenta ve výchozím nastavení povolena."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Povolení PII zakáže redakci pro volání modelu tohoto asistenta. Jste zodpovědní za dodržování datových politik vaší organizace. Aktivita je plně zaznamenávána a monitorována."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Vysvětlete prosím svůj důvod pro povolení PII (povinné)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Minimální délka je {0} znaků."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Maximální délka je {0} znaků."},com_ui_date_today:{english:"Today",translated:"Dnes"},com_ui_date_yesterday:{english:"Yesterday",translated:"Včera"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Předchozích 7 dní"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"Předchozích 30 dní"},com_ui_date_january:{english:"January",translated:"Leden"},com_ui_date_february:{english:"February",translated:"Únor"},com_ui_date_march:{english:"March",translated:"Březen"},com_ui_date_april: