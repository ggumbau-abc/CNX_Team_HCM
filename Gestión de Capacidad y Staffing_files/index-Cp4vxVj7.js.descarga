ght_cost:{english:"Cost / token usage",translated:"Стоимость"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Отдавать предпочтение более дешёвым моделям с меньшей стоимостью токенов."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Точность"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Отдавать предпочтение более мощным моделям для сложных рассуждений."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Скорость"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Отдавать предпочтение более быстрым моделям с меньшей задержкой."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Сбросить по умолчанию"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Время загрузки файла истекло. Повторите попытку через несколько минут."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Что-то пошло не так. Вот конкретное сообщение об ошибке, с которым мы столкнулись: Произошла ошибка при обработке вашего запроса. Ассистент больше недоступен. Пожалуйста, свяжитесь с администратором."},com_ui_code:{english:"Code",translated:"Код"},com_ui_assistant_share:{english:"Share",translated:"Поделиться"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Ссылка скопирована"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"У вас нет доступа к этому ассистенту"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Не удалось скопировать ссылку в буфер о