anslated:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — latest GPT-5 generation model."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Latest Opus — frontier intelligence for coding agents and enterprise workflows."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Latest Opus — frontier intelligence for coding agents and enterprise workflows."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Enhanced Sonnet with improved reasoning and instruction following."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Anthropic's most powerful model for complex, multi-step tasks."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Balanced intelligence and speed for a wide range of tasks."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Fastest and most compact Claude model — ideal for high-throughput tasks."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — enhanced reasoning and multimodal capabilities."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"OpenAI's flagship next-generation model."},"modelConfig.gpt5Mini.description":{english:"Lightweight