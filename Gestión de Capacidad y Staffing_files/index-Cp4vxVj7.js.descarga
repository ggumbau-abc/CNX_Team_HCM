lish:"Off",translated:"بند"},com_ui_yes:{english:"Yes",translated:"ہاں"},com_ui_no:{english:"No",translated:"نہیں"},com_ui_ascending:{english:"Asc",translated:"ترتیب وار"},com_ui_descending:{english:"Desc",translated:"الٹ ترتیب"},com_ui_show_all:{english:"Show All",translated:"سب دکھائیں"},com_ui_name:{english:"Name",translated:"نام"},com_ui_date:{english:"Date",translated:"تاریخ"},com_ui_storage:{english:"Storage",translated:"ذخیرہ"},com_ui_context:{english:"Context",translated:"سیاق و سباق"},com_ui_size:{english:"Size",translated:"سائز"},com_ui_host:{english:"Host",translated:"میزبان"},com_ui_update:{english:"Update",translated:"تازہ کاری"},com_ui_authentication:{english:"Authentication",translated:"تصدیق"},com_ui_instructions:{english:"Instructions",translated:"ہدایات"},com_ui_description:{english:"Description",translated:"تفصیل"},com_ui_category:{english:"Category",translated:"زمرہ"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"کاروباری زمرہ تفویض کریں تاکہ معاونین کو فنکشن کے لحاظ سے فلٹر اور منظم کیا جا سکے۔"},com_ui_error:{english:"Error",translated:"خرابی"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"سرور سے کنکشن میں خرابی، صفحہ کو تازہ کریں۔"},com_ui_select:{english:"Select",translated:"منتخب کریں"},com_ui_select_placeholder:{english:"Select options",translated:"اختیارات منتخب کریں"},com_ui_remove:{english:"Remove",translated:"ہٹائیں"},com_ui_input:{english:"Input",translated:"ان پٹ"},com_ui_close:{english:"Close",translated:"بند کریں"},com_ui_model:{english:"Model",translated:"ماڈل"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"معاون کا نام خالی نہیں ہو سکتا۔ براہ کرم درست نام درج کریں۔"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"جنرل معاونین کے لیے سمارٹ پری فکس استعمال کیا گیا، براہ کرم مختلف نام استعمال کریں۔"},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"تفصیل کا خانہ خالی نہیں ہو سکتا۔ براہ کرم درست تفصیل درج کریں۔"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"ہدایات کا خانہ خالی نہیں ہو سکتا۔ براہ کرم درست ہدایات درج کریں۔"},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"زمرہ کا خانہ خالی نہیں ہو سکتا۔ براہ کرم ایک زمرہ منتخب کریں۔"},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"ایک نقل معاون نام کا پتہ چلا ہے۔ براہ کرم منفرد نام منتخب کریں۔"},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"شیئرڈ ود کا خانہ خالی نہیں ہو سکتا۔ براہ کرم شیئرڈ ود کا آپشن منتخب کریں۔"},com_ui_shared_with:{english:"Shared With",translated:"شیئرڈ ود"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"نجی – صرف آپ اس معاون تک رسائی اور دیکھ سکتے ہیں۔"},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"صرف ٹیم کے ساتھ شیئر کریں – یہ معاون آپ کی ٹیم کے اراکین کے لیے مرئی اور قابل رسائی ہوگا۔"},com_ui_shared_with_team:{english:"Team",translated:"ٹیم"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"اسسٹنٹ جس ٹیم کا حصہ ہے اسے منتخب کریں۔ صرف وہی ٹیمیں یہاں نظر آئیں گی جن کے آپ رکن ہیں۔"},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"ٹیم کا خانہ خالی نہیں ہو سکتا۔ براہ کرم ایک ٹیم منتخب کریں۔"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"یہ معاون ترمیم کے لیے مقفل ہے کیونکہ یہ ٹیم کے ساتھ مشترک ہے۔"},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"شیئر کردہ لنکس لوڈ کرنے میں خرابی۔"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"آپ کے اسسٹنٹ کے نام میں غیر مناسب الفاظ ہیں اور اسے بھیجا نہیں جا سکا۔ براہ کرم اپنے اسسٹنٹ کا نام اپ ڈیٹ کریں۔"},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"آپ کی تفصیل میں غیر مناسب الفاظ ہیں اور اسے بھیجا نہیں جا سکا۔ براہ کرم اپنی تفصیل اپ ڈیٹ کریں۔"},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"آپ کی ہدایات میں غیر مناسب الفاظ ہیں اور انہیں بھیجا نہیں جا سکا۔ براہ کرم اپنی ہدایات اپ ڈیٹ کریں۔"},com_ui_select_search_model:{english:"Search model by name",translated:"ماڈل کو نام سے تلاش کریں"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"پلگ ان کو نام سے تلاش کریں"},com_ui_use_prompt:{english:"Use prompt",translated:"پرومپٹ استعمال کریں"},com_ui_prev:{english:"Prev",translated:"پچھلا"},com_ui_next:{english:"Next",translated:"اگلا"},com_ui_stop:{english:"Stop",translated:"روکیں"},com_ui_upload_files:{english:"Upload files",translated:"فائلیں اپ لوڈ کریں"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"پرومپٹ ٹیمپلیٹس"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"پرومپٹ ٹیمپلیٹس چھپائیں"},com_ui_showing:{english:"Showing",translated:"دکھا رہا ہے"},com_ui_of:{english:"of",translated:"کا"},com_ui_entries:{english:"Entries",translated:"اندراجات"},com_ui_none_selected:{english:"None selected",translated:"کوئی منتخب نہیں"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"فائل کامیابی سے اپ لوڈ ہو گئی"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"آپ کی فائل اپ لوڈ کرنے میں خرابی ہوئی"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"اپ لوڈ کے لئے نامناسب فائل۔ تصویر ہونی چاہیے جو 2 ایم بی سے زیادہ نہ ہو"},com_ui_thinking:{english:"Thinking",translated:"سوچ رہا ہے"},com_ui_analyzing_request:{english:"Understanding your question",translated:"آپ کی درخواست کا تجزیہ کر رہا ہے"},com_ui_processing:{english:"Putting it together",translated:"پروسیسنگ"},com_ui_working_on_it:{english:"Almost ready",translated:"کام جاری ہے"},com_ui_cancel:{english:"Cancel",translated:"منسوخ"},com_ui_save:{english:"Save",translated:"محفوظ کریں"},com_user_message:{english:"You",translated:"آپ"},com_ui_read_aloud:{english:"Read aloud",translated:"اونچی آواز میں پڑھیں"},com_ui_copied:{english:"Copied!",translated:"کاپی ہو گیا!"},com_ui_copy_code:{english:"Copy code",translated:"کوڈ کاپی کریں"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"کلپ بورڈ پر کاپی کریں"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"کلپ بورڈ پر کاپی ہو گیا"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"کسی اینڈ پوائنٹ، اسسٹنٹ، یا پریسیٹ کا ذکر کریں تاکہ جلدی سے اس پر سوئچ کریں"},com_ui_regenerate:{english:"Regenerate",translated:"دوبارہ بنائیں"},com_ui_edit:{english:"Edit",translated:"ترمیم"},com_ui_all:{english:"all",translated:"سب"},com_ui_clear:{english:"Clear",translated:"صاف کریں"},com_ui_import_conversation:{english:"Import",translated:"درآمد کریں"},com_ui_nothing_found:{english:"Nothing found",translated:"کچھ نہیں ملا"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"گفتگو پر جائیں"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"گفتگو کو JSON فائل سے درآمد کریں"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"گفتگو کامیابی سے درآمد ہو گئی"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"آپ کی گفتگو درآمد کرنے میں ایک خرابی ہوئی"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"غیر معاون درآمد قسم"},com_ui_confirm_action:{english:"Confirm Action",translated:"عمل کی تصدیق کریں"},com_ui_avatar:{english:"Avatar",translated:"اوتار"},com_ui_unknown:{english:"Unknown",translated:"نامعلوم"},com_ui_result:{english:"Result",translated:"نتیجہ"},com_ui_image_gen:{english:"Image Gen",translated:"تصویر جن"},com_ui_assistant:{english:"Assistant",translated:"معاون"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"معاون کامیابی سے حذف ہو گیا"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"معاون کو حذف کرنے میں خرابی ہوئی"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"نقل فائل کا پتہ چلا۔"},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"فائل اپ لوڈ کرتے وقت خرابی ہوئی۔"},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"فائل اپ لوڈ کرتے وقت خرابی ہوئی: اختتامی نقطہ غیر متعین ہے"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"خالی فائلیں اجازت نہیں ہیں۔"},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"آپ ایک وقت میں صرف {0} فائلیں اپ لوڈ کر سکتے ہیں۔"},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"آپ اس سیکشن میں صرف {0} فائلیں اپ لوڈ کر سکتے ہیں۔"},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"{0} کے لئے اپ لوڈ کی حد پوری ہو چکی ہے"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"فائل کی قسم کا تعین نہیں ہو سکا: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"فائل کی قسم معاون نہیں ہے۔ براہ کرم معاون فائل فارمیٹ اپ لوڈ کریں۔"},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"تصویر لوڈ کرنے میں ناکام"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"فی الحال، صرف JPEG، JPG، PNG، اور WEBP فائلیں معاون ہیں۔"},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"فائل کا سائز {0} MB سے زیادہ ہے۔"},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"فائلوں کا کل سائز {0} MB سے زیادہ نہیں ہو سکتا۔"},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"فائل کی تصدیق کرتے وقت خرابی ہوئی۔"},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"فائل کو پروسیس کرتے وقت خرابی ہوئی۔"},com_ui_assistants:{english:"Assistants",translated:"معاونین"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"اسٹوڈیو معاونت"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"علم"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"غیر درجہ بند"},com_ui_attachment:{english:"Attachment",translated:"منسلک"},com_ui_assistants_output:{english:"Assistants Output",translated:"اسسٹنٹس کا نتیجہ"},com_ui_delete:{english:"Delete",translated:"حذف کریں"},com_ui_create:{english:"Create",translated:"بنائیں"},com_ui_share:{english:"Share",translated:"شیئر کریں"},com_ui_copy_link:{english:"Copy link",translated:"لنک کاپی کریں"},com_ui_update_link:{english:"Update link",translated:"لنک اپڈیٹ کریں"},com_ui_create_link:{english:"Create link",translated:"لنک بنائیں"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"چیٹ میں لنک شیئر کریں"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"چیٹ لنک شیئر کرنے میں خرابی ہوئی"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"آپ کا نام اور کوئی بھی پیغامات جو آپ شیئر کرنے کے بعد شامل کریں گے، نجی رہیں گے۔"},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"آپ کی چیٹ کا ایک عوامی لنک بنایا گیا ہے۔ کسی بھی وقت سیٹنگز کے ذریعے پہلے سے شیئر کی گئی چیٹس کا انتظام کریں۔"},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"آپ کا نام، حسب ضرورت ہدایات، اور کوئی بھی پیغامات جو آپ شیئر کرنے کے بعد شامل کریں گے، نجی رہیں گے۔"},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"آپ کی چیٹ کا عوامی لنک اپڈیٹ کیا گیا ہے۔ کسی بھی وقت سیٹنگز کے ذریعے پہلے سے شیئر کی گئی چیٹس کا انتظام کریں۔"},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"شیئر کیا گیا لنک نہیں ملا"},com_ui_delete_conversation:{english:"Delete chat?",translated:"چیٹ حذف کریں؟"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"یہ حذف کر دے گا"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"کیا آپ واقعی اس اسسٹنٹ کو حذف کرنا چاہتے ہیں؟ یہ عمل واپس نہیں ہو سکتا۔"},com_ui_rename:{english:"Rename",translated:"نام تبدیل کریں"},com_ui_more_options:{english:"More",translated:"مزید"},com_ui_preview:{english:"Preview",translated:"پیش نظارہ"},com_ui_upload:{english:"Upload",translated:"اپ لوڈ کریں"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'"{0}" اپ لوڈ کرنے میں توقع سے زیادہ وقت لگ رہا ہے۔ براہ کرم انتظار کریں جب تک فائل بازیافت کے لئے انڈیکسنگ مکمل نہیں ہو جاتی۔'},com_ui_privacy_policy:{english:"Privacy policy",translated:"رازداری کی پالیسی"},com_ui_terms_of_service:{english:"Terms of service",translated:"خدمات کی شرائط"},com_ui_use_micrphone:{english:"Use microphone",translated:"مائیکروفون استعمال کریں"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"مزید قدریں نہیں ہٹا سکتے، کم از کم {0} درکار ہیں۔"},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"زیادہ سے زیادہ تعداد {0} ہے، تازہ ترین قدریں استعمال کریں۔"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"دی گئی معلومات کے ساتھ لاگ ان نہیں ہو سکا۔ براہ کرم اپنے اسناد چیک کریں اور دوبارہ کوشش کریں۔"},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"آپ نے لاگ ان کی اجازت شدہ کوششوں کی تعداد سے تجاوز کر لیا ہے۔ براہ کرم 15 منٹ بعد دوبارہ کوشش کریں۔"},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"آپ کا اکاؤنٹ ہماری سروس کی خلاف ورزیوں کی وجہ سے عارضی طور پر معطل کر دیا گیا ہے۔"},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"اندرونی سرور کی خرابی ہوئی۔ براہ کرم کچھ دیر انتظار کریں اور دوبارہ کوشش کریں۔"},com_auth_sign_in:{english:"Login",translated:"لاگ ان"},com_endpoint_system_message:{english:"System Message",translated:"سسٹم پیغام"},com_endpoint_message:{english:"Message",translated:"پیغام"},com_endpoint_messages:{english:"Messages",translated:"پیغامات"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"اپنا پیغام ترمیم کریں یا دوبارہ بنائیں۔"},com_endpoint_default_blank:{english:"default: blank",translated:"ڈیفالٹ: خالی"},com_endpoint_default_false:{english:"default: false",translated:"ڈیفالٹ: غلط"},com_endpoint_default_creative:{english:"default: creative",translated:"ڈیفالٹ: تخلیقی"},com_endpoint_default_empty:{english:"default: empty",translated:"ڈیفالٹ: خالی"},com_endpoint_default_with_num:{english:"default: {0}",translated:"ڈیفالٹ: {0}"},com_endpoint_context:{english:"Context",translated:"سیاق و سباق"},com_endpoint_tone_style:{english:"Tone Style",translated:"لہجہ کا انداز"},com_endpoint_token_count:{english:"Token count",translated:"ٹوکن کی تعداد"},com_endpoint_output:{english:"Output",translated:"نتیجہ"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"زیادہ سے زیادہ سیاق و سباق کے ٹوکن"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`سیاق و سباق کے لیے استعمال ہونے والے ٹوکن کی زیادہ سے زیادہ تعداد۔ اس کا استعمال اس بات کے کنٹرول کے لیے کریں کہ فی درخواست کتنے ٹوکن بھیجے جائیں۔
  اگر وضاحت نہ کی جائے تو معلوم ماڈلز کے سیاق و سباق کے سائز کی بنیاد پر سسٹم ڈیفالٹس استعمال ہوں گے۔ زیادہ قیمتیں مقرر کرنے سے غلطیاں اور/یا زیادہ ٹوکن لاگت ہو سکتی ہے۔`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"حسب ضرورت ہدایات یا سیاق و سباق مرتب کریں۔ اگر خالی ہو تو نظرانداز کیا جائے گا۔"},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"اسسٹنٹ کی ہدایات کو اوور رائڈ کرتا ہے۔ یہ ہر رن کی بنیاد پر رویہ میں تبدیلی کے لیے مفید ہے۔"},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"اسسٹنٹ کی بنیادی ہدایات کے اوپر اضافی ہدایات یا سیاق و سباق مرتب کریں۔ اگر خالی ہو تو نظر انداز کیا جائے گا۔"},com_endpoint_custom_name:{english:"Custom Name",translated:"حسب ضرورت نام"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"حسب ضرورت ہدایات"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"اضافی ہدایات"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"اوور رائڈ ہدایات"},com_endpoint_temperature:{english:"Temperature",translated:"درجہ حرارت"},com_endpoint_default:{english:"default",translated:"پہلے سے طے شدہ"},com_endpoint_top_p:{english:"Top P",translated:"ٹاپ P"},com_endpoint_top_k:{english:"Top K",translated:"ٹاپ K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"زیادہ سے زیادہ آؤٹ پٹ ٹوکن"},com_endpoint_stop:{english:"Stop Sequences",translated:"روکنے کی ترتیب"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"`Enter` دباکر اقدار کو الگ کریں"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"اختیاری `max_tokens` فیلڈ، جو چیٹ مکمل کرنے میں پیدا ہونے والے زیادہ سے زیادہ ٹوکن کی نمائندگی کرتا ہے۔\n\nان پٹ ٹوکن اور پیدا شدہ ٹوکن کی کل لمبائی ماڈل کے سیاق و سباق کی لمبائی سے محدود ہے۔ اگر یہ تعداد زیادہ سے زیادہ سیاق و سباق کے ٹوکن سے تجاوز کر جائے تو آپ کو غلطیاں پیش آ سکتی ہیں۔"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"زیادہ قدریں = زیادہ بے ترتیب، جبکہ کم قدریں = زیادہ مرکوز اور تعیناتی۔ ہم تجویز کرتے ہیں کہ اس یا ٹاپ P کو تبدیل کریں لیکن دونوں کو نہیں۔"},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"پیدا کرنے کے لیے زیادہ سے زیادہ ٹوکن۔ ان پٹ ٹوکن اور پیدا شدہ ٹوکن کی کل لمبائی ماڈل کے سیاق و سباق کی لمبائی سے محدود ہے۔"},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"درجہ حرارت کے ساتھ سیمپلنگ کا ایک متبادل، جسے نیوکلئیس سیمپلنگ کہا جاتا ہے، جہاں ماڈل ٹوکن کے نتائج کو ٹاپ_p احتمال ماس کے ساتھ غور کرتا ہے۔ لہذا 0.1 کا مطلب ہے کہ صرف وہ ٹوکن جن میں ٹاپ 10% احتمال ماس شامل ہے، کو مدنظر رکھا جاتا ہے۔ ہم تجویز کرتے ہیں کہ اس یا درجہ حرارت کو تبدیل کریں لیکن دونوں کو نہیں۔"},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"0 اور 2.0 کے درمیان نمبر۔ مثبت قدریں موجودہ متن میں ان کی موجودہ تعدد کی بنیاد پر نئے ٹوکن کو سزا دیتی ہیں، ماڈل کی اسی لائن کو لفظی طور پر دہرانے کے امکان کو کم کرتی ہیں۔"},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"0 اور 2.0 کے درمیان نمبر۔ مثبت قدریں نئے ٹوکن کو سزا دیتی ہیں کہ آیا وہ اب تک کے متن میں ظاہر ہوتے ہیں، نئے موضوعات کے بارے میں بات کرنے کے ماڈل کے امکان کو بڑھاتی ہیں۔"},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"پہلے سے منسلک تمام فائلیں دوبارہ بھیجیں۔ نوٹ: اس سے ٹوکن کی لاگت میں اضافہ ہوگا اور آپ کو بہت سے منسلکات کے ساتھ غلطیاں پیش آ سکتی ہیں۔"},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'ویژن درخواستوں کے لیے ریزولوشن۔ "کم" سستا اور تیز ہے، "زیادہ" زیادہ تفصیلی اور مہنگا ہے، اور "آٹو" خود بخود تصویر کی ریزولوشن کی بنیاد پر دونوں میں سے انتخاب کرے گا۔'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"4 تک ترتیب جہاں API مزید ٹوکن پیدا کرنا بند کر دے گا۔"},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"iXHello کے لیے حسب ضرورت نام مرتب کریں"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"سسٹم پیغام میں شامل کرنے کے لیے حسب ضرورت ہدایات مرتب کریں۔ پہلے سے طے شدہ: کوئی نہیں"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"تعدد کی سزا"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"موجودگی کی سزا"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"فنکشنز استعمال کریں"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"فائلیں دوبارہ بھیجیں"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"تصویر کی تفصیل"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"مکمل ہونے کو چھوڑیں"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"سسٹم پیغام میں شامل کرنے کے لئے حسب ضرورت ہدایات سیٹ کریں۔ ڈیفالٹ: کوئی نہیں"},com_endpoint_import:{english:"Import",translated:"درآمد کریں"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"حسب ضرورت نام سیٹ کریں، تاکہ آپ اس پریسیٹ کو تلاش کر سکیں"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"کیا آپ واقعی اس پریسیٹ کو حذف کرنا چاہتے ہیں؟"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"پریسیٹ درآمد ہو گیا!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"آپ کے پریسیٹ کو درآمد کرنے میں خرابی ہوئی۔ براہ کرم دوبارہ کوشش کریں۔"},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"آپ کے پریسیٹ کو محفوظ کرنے میں خرابی ہوئی۔ براہ کرم دوبارہ کوشش کریں۔"},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"آپ کے پریسیٹ کو حذف کرنے میں خرابی ہوئی۔ براہ کرم دوبارہ کوشش کریں۔"},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"اب ڈیفالٹ پریسیٹ نہیں ہے۔"},com_endpoint_preset_default_item:{english:"Default:",translated:"ڈیفالٹ:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"کوئی ڈیفالٹ پریسیٹ فعال نہیں ہے۔"},com_endpoint_preset_title:{english:"Preset",translated:"پریسیٹ"},com_endpoint_preset_saved:{english:"Saved!",translated:"محفوظ ہو گیا!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"اب ڈیفالٹ پریسیٹ ہے۔"},com_endpoint_preset:{english:"preset",translated:"پریسیٹ"},com_endpoint_presets:{english:"presets",translated:"پریسیٹس"},com_endpoint_preset_selected_title:{english:"Active!",translated:"فعال!"},com_endpoint_preset_name:{english:"Preset Name",translated:"پریسیٹ کا نام"},com_endpoint:{english:"Endpoint",translated:"اینڈ پوائنٹ"},com_endpoint_examples:{english:" Presets",translated:"پریسیٹس"},com_endpoint_export:{english:"Export",translated:"برآمد کریں"},com_endpoint_export_share:{english:"Export/Share",translated:"برآمد/شیئر"},com_endpoint_assistant:{english:"Assistant",translated:"معاون"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"فعال معاون استعمال کریں"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"پری سیٹ کے طور پر محفوظ کریں"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"کیا آپ واقعی تمام پری سیٹس کو صاف کرنا چاہتے ہیں؟ یہ ناقابل واپسی ہے۔"},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"ابھی تک کوئی پری سیٹ نہیں، ایک بنانے کے لیے سیٹنگز بٹن استعمال کریں"},com_endpoint_my_preset:{english:"My Preset",translated:"میرا پری سیٹ"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"ایجنٹ ماڈل (تجویز کردہ: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"تکمیل ماڈل (تجویز کردہ: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"پلاگ انز کو OpenAI فنکشنز کے طور پر استعمال کرنے کی اجازت دیں"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"تکمیل کے مرحلے کو چھوڑنے کی اجازت دیں، جو حتمی جواب اور تیار کردہ مراحل کا جائزہ لیتا ہے"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"براہ کرم ایک معاون منتخب کریں اور نئی چیٹ شروع کریں"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"چیٹ کے لیے ہیڈر مینو میں اپنی کلید سیٹ کریں۔"},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"براہ کرم ایک معاون منتخب کریں"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"iXHello میں خوش آمدید"},com_nav_text_to_speech:{english:"Text to Speech",translated:"متن سے تقریر"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"تازہ ترین پیغام خودکار چلائیں"},com_nav_speech_to_text:{english:"Speech to Text",translated:"تقریر سے متن"},com_nav_profile_picture:{english:"Profile Picture",translated:"پروفائل تصویر"},com_nav_change_picture:{english:"Change picture",translated:"تصویر تبدیل کریں"},com_show_agent_settings:{english:"Show Agent Settings",translated:"ایجنٹ کی ترتیبات دکھائیں"},com_show_completion_settings:{english:"Show Completion Settings",translated:"تکمیل کی ترتیبات دکھائیں"},com_hide_examples:{english:"Hide Examples",translated:"مثالیں چھپائیں"},com_show_examples:{english:"Show Examples",translated:"مثالیں دکھائیں"},com_nav_export_filename:{english:"Filename",translated:"فائل کا نام"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"فائل کا نام مقرر کریں"},com_nav_export_type:{english:"Type",translated:"قسم"},com_nav_export_conversation:{english:"Export conversation",translated:"بات چیت برآمد کریں"},com_nav_export:{english:"Export",translated:"برآمد کریں"},com_nav_shared_links:{english:"Shared links",translated:"مشترکہ روابط"},com_nav_shared_links_manage:{english:"Manage",translated:"انتظام کریں"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"آپ کے پاس کوئی مشترکہ روابط نہیں ہیں۔"},com_nav_shared_links_name:{english:"Name",translated:"نام"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"تاریخ اشتراک"},com_nav_source_chat:{english:"View source chat",translated:"ماخذ چیٹ دیکھیں"},com_nav_my_files:{english:"File Manager",translated:"فائل مینیجر"},com_nav_admin_center:{english:"Admin Center",translated:"ایڈمن سینٹر"},com_nav_theme:{english:"Theme",translated:"تھیم"},com_nav_theme_system:{english:"System",translated:"سسٹم"},com_nav_theme_dark:{english:"Dark",translated:"تاریک"},com_nav_theme_light:{english:"Light",translated:"روشن"},com_nav_user_name_display:{english:"Display username in messages",translated:"پیغامات میں صارف نام دکھائیں"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"تمام چیٹس صاف کریں"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"تصفیہ کی تصدیق کریں"},com_nav_close_sidebar:{english:"Close sidebar",translated:"سائڈبار بند کریں"},com_nav_open_sidebar:{english:"Open sidebar",translated:"سائڈبار کھولیں"},com_nav_send_message:{english:"Send message",translated:"پیغام بھیجیں"},com_nav_log_out:{english:"Log out",translated:"لاگ آؤٹ"},com_nav_user:{english:"USER",translated:"صارف"},com_nav_archived_chats:{english:"Archived chats",translated:"محفوظ شدہ چیٹس"},com_nav_archived_chats_manage:{english:"Manage",translated:"انتظام کریں"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"آپ کے پاس کوئی محفوظ شدہ گفتگو نہیں ہے۔"},com_nav_archive_name:{english:"Name",translated:"نام"},com_nav_archive_created_at:{english:"DateCreated",translated:"تاریخ تخلیق"},com_nav_clear_conversation:{english:"Clear conversations",translated:"گفتگو صاف کریں"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"کیا آپ واقعی تمام گفتگو صاف کرنا چاہتے ہیں؟ یہ ناقابل واپسی ہے۔"},com_nav_help:{english:"Help",translated:"مدد"},com_nav_user_guide:{english:"User Guide",translated:"صارف گائیڈ"},com_nav_settings:{english:"Settings",translated:"ترتیبات"},com_nav_search_placeholder:{english:"Search messages",translated:"پیغامات تلاش کریں"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"خودکار بھیجیں (3 سیکنڈ بعد)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"آڈیو چلانے میں خرابی: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"آڈیو پروسیس کرنے میں خرابی: {0}"},com_nav_engine:{english:"Engine",translated:"انجن"},com_nav_browser:{english:"Browser",translated:"براؤزر"},com_nav_external:{english:"External",translated:"بیرونی"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"کیچ اسٹوریج حذف کریں"},com_nav_voice_select:{english:"Voice",translated:"آواز"},com_nav_setting_general:{english:"General",translated:"عام"},com_nav_setting_speech:{english:"Speech",translated:"تقریر"},com_nav_language:{english:"Language",translated:"زبان"},com_nav_lang_auto:{english:"Auto detect",translated:"خودکار شناخت"},com_page_not_found:{english:"Page not found",translated:"صفحہ نہیں ملا"},com_something_went_wrong_error:{english:"Something went wrong",translated:"کچھ غلط ہو گیا"},com_unauthorized_access:{english:"Unauthorized access",translated:"غیر مجاز رسائی"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"غیر مجاز رسائی۔ رسائی مخصوص ڈومینز تک محدود ہے۔"},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"آپ کا اکاؤنٹ ہماری سروس کی خلاف ورزیوں کی وجہ سے عارضی طور پر معطل کر دیا گیا ہے"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"آپ کو نیٹ ورک کے باہر ایپ تک رسائی کی اجازت نہیں ہے!"},com_support_ticket_text:{english:"Support Ticket",translated:"سپورٹ ٹکٹ"},com_help_dialog_Header:{english:"Need assistance?",translated:"مدد کی ضرورت ہے؟"},com_help_dialog_text_1_1:{english:"Click",translated:"کلک کریں"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"تفصیلی ہدایات کے لیے"},com_help_dialog_text_here:{english:"here",translated:"یہاں"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"مسائل کے لیے، ایک"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"مسائل کے لیے، رابطہ کریں"},com_help_dialog_text_ticket:{english:"ticket",translated:"ٹکٹ"},com_help_dialog_text_3:{english:"Find the steps",translated:"مراحل دیکھیں"},com_status_ind_none:{english:"Operational",translated:"عملیاتی"},com_status_ind_minor:{english:"Minor Issues",translated:"معمولی مسائل"},com_status_ind_major:{english:"Major Issues",translated:"بڑے مسائل"},com_status_ind_critical:{english:"Critical",translated:"تنقیدی"},com_status_ind_error:{english:"Error Fetching",translated:"حصول میں خرابی"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"براہ کرم نوٹ کریں کہ جب آپ چیٹ چھوڑتے ہیں یا نئی چیٹ شروع کرتے ہیں، تو آپ اپنی گفتگو کی تاریخ کھو دیں گے۔"},com_forbidden_access:{english:"Forbidden access",translated:"رسائی ممنوع"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"قابل قبول استعمال کی پالیسی"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"رازداری کی پالیسی"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"سبسکرپشن معاہدہ"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"iX Hello استعمال کرنے سے پہلے، آپ Concentrix کی "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"سائن اپ کرنے اور/یا داخل ہونے سے، آپ اوپر دی گئی شرائط سے اتفاق کرتے ہیں۔"},com_login_page_and:{english:"and ",translated:"اور "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"کوئی پن کیے گئے معاون نہیں"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"پن کیے گئے معاون"},com_ui_loading:{english:"Loading...",translated:"لوڈ ہو رہا ہے..."},com_ui_unpin:{english:"Unpin",translated:"ان پن"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"معاون کامیابی سے ان پن ہو گیا"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"اسسٹنٹ کو ان پن کرنے میں خرابی"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"اسسٹنٹ کامیابی سے پن ہو گیا"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"اسسٹنٹ کو پن/ان پن کرنے میں خرابی"},com_ui_pin:{english:"Pin",translated:"پن"},come_create_assistant:{english:"Create Assistant",translated:"اسسٹنٹ بنائیں"},come_edit_assistant:{english:"Edit Assistant",translated:"اسسٹنٹ میں ترمیم کریں"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"کیا آپ واقعی آگے بڑھنا چاہتے ہیں؟ اس سے آپ کے موجودہ اسسٹنٹ میں کی گئی تبدیلیاں ضائع ہو جائیں گی۔ یہ عمل واپس نہیں کیا جا سکتا۔"},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"آئی ڈی {0} کے ساتھ اسسٹنٹ نہیں ملا۔"},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"براؤزر SpeechRecognition کی حمایت نہیں کرتا"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"مائیکروفون کی اجازت نہیں دی گئی"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"ریکارڈنگ شروع کرنے میں خرابی: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder ریکارڈنگ نہیں کر رہا"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder اس براؤزر میں سپورٹ نہیں کرتا"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"آپ کے پیغام میں ذاتی معلومات شامل ہیں اور اسے بھیجا نہیں جا سکا۔ براہ کرم کوئی ذاتی معلومات ہٹا دیں۔"},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"گفتگو کا نام تبدیل کرنے میں ناکامی"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"آپ کے پاس مختص کردہ ٹوکنز میں سے {0} باقی ہیں۔"},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello غلطیاں کر سکتا ہے۔ براہ کرم تمام نتائج کو معیار اور درستگی کے لیے چیک کریں۔ تمام ان پٹ کو تعمیل کے لیے لاگ کیا جاتا ہے۔"},com_ui_assistant_group_by:{english:"Group by",translated:"گروپ کریں"},com_ui_assistant_category:{english:"Category",translated:"زمرہ"},com_ui_assistant_team:{english:"Team",translated:"ٹیم"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"انجینئرنگ"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"انٹیلیجنس"},com_ui_assistant_marketing:{english:"Marketing",translated:"مارکیٹنگ"},com_ui_assistant_operations:{english:"Operations",translated:"آپریشنز"},com_ui_assistant_sales:{english:"Sales",translated:"فروخت"},com_ui_assistant_strategy:{english:"Strategy",translated:"حکمت عملی"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"اسٹوڈیو معاونین"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"ایک اوتار تصویر اپ لوڈ کریں (PNG یا JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"آن لائن تلاش کریں"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"ویب سائٹ براؤز کریں"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"تصاویر بنائیں"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"ریاضی کا حساب لگائیں"},com_ui_assistant_tools_default:{english:"Running tool",translated:"ڈیفالٹ ٹول"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"فائل اپ لوڈ کرنے میں توقع سے زیادہ وقت لگ رہا ہے۔ براہ کرم دوبارہ کوشش کریں۔"},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"اسسٹنٹ کو پن کرنے میں خرابی"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"مشترکہ لنک کو حذف کرنے میں خرابی ہوئی"},com_ui_dan:{english:"DAN",translated:"ڈین"},com_ui_dan_template:{english:"DAN Template",translated:"ڈین ٹیمپلیٹ"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"کوئی ڈیفالٹ پریسیٹ فعال نہیں ہے۔"},com_ui_drag_drop_title:{english:"Add anything",translated:"کچھ بھی شامل کریں"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"کسی بھی فائل کو یہاں چھوڑیں تاکہ اسے گفتگو میں شامل کیا جا سکے"},com_ui_analyzing:{english:"Analyzing",translated:"تجزیہ کر رہا ہے"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"تجزیہ مکمل ہوا"},com_ui_warning:{english:"Warning",translated:"انتباہ"},com_ui_proceed:{english:"Proceed",translated:"آگے بڑھیں"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"اسسٹنٹ پر اپ لوڈ کی گئی فائلیں صرف گفتگو کے مقاصد کے لیے استعمال ہوتی ہیں۔ صارفین ان فائلوں کے مواد تک متعلقہ سوالات پوچھ کر رسائی حاصل کر سکتے ہیں، لیکن فائلوں کا براہ راست ڈاؤن لوڈ کی اجازت نہیں ہے۔"},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"اس پریسیٹ کے لیے ایک حسب ضرورت نام مقرر کریں"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"مثال ان پٹ مقرر کریں۔ اگر خالی ہو تو مثال نظر انداز کی جاتی ہے۔"},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"مثال آؤٹ پٹ مقرر کریں۔ اگر خالی ہو تو مثال نظر انداز کی جاتی ہے۔"},com_nav_export_select_type:{english:"Select a file type",translated:"فائل کی قسم منتخب کریں"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"اسکرین شاٹ (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"متن (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"مارک ڈاؤن (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"کوئی جواب موصول نہیں ہوا۔ براہ کرم اپنا پیغام دوبارہ بھیجنے کی کوشش کریں۔ اگر صفحہ دوبارہ لوڈ کرنے اور دوبارہ کوشش کرنے کے بعد مسئلہ برقرار رہتا ہے تو براہ کرم معاونت سے رابطہ کریں۔"},com_ui_back_to_chat:{english:"Back to Chat",translated:"چیٹ پر واپس جائیں"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"گارڈریل اعتدال"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"اس معاون کے لئے گارڈریل اعتدال فعال ہے۔ مواد کو اعتدال کی پالیسیوں کے خلاف چیک کیا جائے گا۔"},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"گارڈریل اعتدال کو غیر فعال کرنے سے اس معاون کے لئے مواد کی اعتدال کی جانچ ہٹا دی جاتی ہے۔ آپ اپنی تنظیم کی مواد کی پالیسیوں کی تعمیل کے ذمہ دار ہیں۔ سرگرمی مکمل طور پر لاگ اور مانیٹر کی جاتی ہے۔"},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"براہ کرم گارڈریل اعتدال کو غیر فعال کرنے کے لئے اپنے کاروباری جواز کی وضاحت کریں (ضروری)۔"},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"براہ کرم گارڈریل اعتدال کو غیر فعال کرنے کے لئے ایک جواز فراہم کریں۔"},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"صارفین کو چیٹ میں ماڈل تبدیل کرنے کی اجازت دیں"},com_ui_feedback_good:{english:"Good response",translated:"اچھا جواب"},com_ui_feedback_bad:{english:"Poor response",translated:"خراب جواب"},com_ui_feedback_comments:{english:"Comments",translated:"تبصرے"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"تبصرے (اختیاری)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"اپنے تجربے کے بارے میں ہمیں مزید بتائیں..."},com_ui_feedback_submit:{english:"Submit",translated:"جمع کرائیں"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"ہم آپ کی رائے نہیں بھیج سکے"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"غلط"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"متعلقہ نہیں"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"پرانا"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"کافی تفصیل نہیں"},com_ui_feedback_reason_other:{english:"Other",translated:"دیگر"},com_ui_model_recommended:{english:"Recommended",translated:"تجویز کردہ"},com_ui_model_legacy:{english:"Legacy — please update",translated:"پرانا — براہ کرم اپ ڈیٹ کریں"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"یہ ماڈل اب سپورٹ نہیں کیا جاتا۔ براہ کرم موجودہ ماڈل منتخب کریں۔"},com_nav_setting_memory:{english:"Memory",translated:"یادداشت"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"ذاتی حقائق کا انتظام کریں جو اسسٹنٹ آپ کی بات چیت میں یاد رکھتا ہے۔"},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"نئی یادداشت شامل کریں…"},com_nav_memory_add_button:{english:"Add memory",translated:"یادداشت شامل کریں"},com_nav_memory_category:{english:"Category",translated:"زمرہ"},com_nav_memory_category_preference:{english:"Preference",translated:"ترجیح"},com_nav_memory_category_identity:{english:"Identity",translated:"شناخت"},com_nav_memory_category_context:{english:"Context",translated:"سیاق و سباق"},com_nav_memory_category_project:{english:"Project",translated:"پروجیکٹ"},com_nav_memory_empty_title:{english:"No memories yet",translated:"ابھی تک کوئی یادداشت نہیں"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"آپ کی محفوظ کردہ یادداشتیں یہاں ظاہر ہوں گی اور آئندہ کی بات چیت کو ذاتی بنائیں گی۔"},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"یادداشتیں لوڈ نہیں ہو سکیں۔ براہ کرم دوبارہ کوشش کریں۔"},com_nav_memory_retry:{english:"Retry",translated:"دوبارہ کوشش کریں"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"یادداشت شامل نہیں ہو سکی۔ براہ کرم دوبارہ کوشش کریں۔"},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"یادداشت اپڈیٹ نہیں ہو سکی۔ براہ کرم دوبارہ کوشش کریں۔"},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"یادداشت حذف نہیں ہو سکی۔ براہ کرم دوبارہ کوشش کریں۔"},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"اس یادداشت کو حذف کریں؟"},com_nav_memory_delete_button:{english:"Delete",translated:"حذف کریں"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"یادداشت میں ترمیم کریں"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"یادداشت حذف کریں"},com_nav_memory_save:{english:"Save",translated:"محفوظ کریں"},com_nav_memory_cancel:{english:"Cancel",translated:"منسوخ کریں"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"محفوظ شدہ {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — سرحدی ذہانت کے ساتھ تازہ ترین GPT-5 سوچنے کا ماڈل۔"},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — کمپیکٹ اور کم لاگت والا GPT-5.4 ویرینٹ۔"},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — جدید ترین GPT-5 جنریشن ماڈل۔"},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"جدید ترین اوپس — کوڈنگ ایجنٹس اور انٹرپرائز ورک فلو کے لئے جدید انٹیلیجنس۔"},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"جدید ترین اوپس — کوڈنگ ایجنٹس اور انٹرپرائز ورک فلو کے لئے جدید انٹیلیجنس۔"},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"بہتر سونٹ، بہتر استدلال اور ہدایات کی پیروی کے ساتھ۔"},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"پیچیدہ، کثیر مرحلہ جات کے کاموں کے لئے اینتھروپک کا سب سے طاقتور ماڈل۔"},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"وسیع رینج کے کاموں کے لئے متوازن انٹیلیجنس اور رفتار۔"},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"تیز ترین اور سب سے کمپیکٹ کلاڈ ماڈل — زیادہ تھروپوٹ والے کاموں کے لئے مثالی۔"},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — بہتر استدلال اور ملٹی موڈل صلاحیتیں۔"},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"اوپن اے آئی کا فلیگ شپ اگلی نسل کا ماڈل۔"},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"ہلکا پھلکا GPT-5 — روزمرہ کے کاموں کے لئے مؤثر اور تیز۔"},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"اوپن اے آئی GPT-4.1 — بہتر ہدایات کی پیروی اور استدلال۔"},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"کمپیکٹ GPT-4.1 — سادہ کاموں کے لئے تیز اور سستا۔"},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"سب سے قابل GPT-4 ماڈل، رفتار اور لاگت کے لئے بہتر۔"},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"ہلکا پھلکا GPT-4o — سادہ کاموں کے لئے تیز اور سستا۔"},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (پیش نظارہ) — 1M سیاق و سباق کے ساتھ سب سے قابل Gemini ماڈل۔"},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (پیش نظارہ) — 1M سیاق و سباق کے ساتھ تیز اور موثر۔"},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — 1M سیاق و سباق کے ساتھ ہلکا، کم تاخیر والا ماڈل۔"},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"اندرونی آواز کے لئے بہتر اسسٹنٹ ماڈل۔"},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto صلاحیت اور کارکردگی کی بنیاد پر آپ کی درخواست کے لیے بہترین ماڈل منتخب کرتا ہے۔"},com_ui_model_coming_soon:{english:"Coming Soon",translated:"جلد آ رہا ہے"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"خودکار روٹنگ کی ترجیحات"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"ہر ٹرن کے لیے ماڈل منتخب کرتے وقت آٹو روٹر کس طرح مختلف پہلوؤں میں توازن رکھے، اسے ترتیب دیں۔ وزن نارملائز کیے جاتے ہیں — اصل اہمیت نسبتی توازن کی ہے۔"},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"لاگت"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"کم ٹوکن لاگت والے سستے ماڈلز کو ترجیح دیں۔"},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"درستگی"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"پیچیدہ استدلال کے لیے زیادہ مضبوط ماڈلز کو ترجیح دیں۔"},com_assistants_auto_weight_speed:{english:"Speed",translated:"رفتار"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"تیز، کم تاخیر والے ماڈلز کو ترجیح دیں۔"},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"ڈیفالٹس پر ری سیٹ کریں"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"فائل اپ لوڈ کا وقت ختم ہو گیا۔ براہِ کرم چند منٹ بعد دوبارہ کوشش کریں۔"},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"کچھ غلط ہو گیا۔ ہمیں یہ مخصوص خرابی کا پیغام ملا: آپ کی درخواست پر کارروائی کے دوران ایک خرابی پیش آئی۔ اسسٹنٹ اب دستیاب نہیں ہے۔ براہ کرم ایڈمن سے رابطہ کریں۔"},com_ui_code:{english:"Code",translated:"کوڈ"},com_ui_assistant_share:{english:"Share",translated:"شیئر کریں"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"لنک کاپی ہو گیا"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"آپ کو اس اسسٹنٹ تک رسائی حاصل نہیں ہے"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"لنک کلپ بورڈ پر کاپی نہیں ہو سکا"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"پیش نظارہ دستیاب نہیں ہے — مواد کی تخلیق مکمل نہیں ہوئی۔"},com_ui_view_code:{english:"View code",translated:"کوڈ دیکھیں"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"پیش نظارہ دستیاب نہیں ہے — مواد غیر درست ہے۔"},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"فون نمبر"},com_assistants_pii_entity_email:{english:"Email Address",translated:"ای میل پتہ"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"کریڈٹ کارڈ"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"ایس ایس این"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"اپ لوڈ توقع سے زیادہ وقت لے رہا ہے - دوبارہ کوشش ہو رہی ہے ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"کنکشن کا مسئلہ - دوبارہ کوشش ہو رہی ہے ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"اپ لوڈ ناکام ہو گیا - براہ کرم اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں"},com_assistants_memory_enabled:{english:"Memory",translated:"یادداشت"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"اس اسسٹنٹ کے لیے یادداشت فعال ہے۔ اسسٹنٹ گفتگوؤں کے درمیان حقائق محفوظ اور یاد کر سکتا ہے۔"},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"اس اسسٹنٹ کے لیے یادداشت غیر فعال ہے۔ گفتگوؤں کے درمیان کوئی حقائق محفوظ یا یاد نہیں کیے جائیں گے۔"},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"براہ کرم یادداشت غیر فعال کرنے کی اپنی کاروباری وجہ بیان کریں (ضروری ہے)۔"},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"براہ کرم یادداشت غیر فعال کرنے کی وجہ فراہم کریں۔"},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"آپ کی ٹیم کے لیے یادداشت غیر فعال ہے۔ آپ موجودہ یادداشتیں دیکھ اور حذف کر سکتے ہیں، لیکن نئی یادداشتیں شامل یا ترمیم نہیں کر سکتے۔"},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"آپ کا کوڈ چلایا جا رہا ہے"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"علمی ذخیرے میں تلاش کی جا رہی ہے"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"آواز پر کارروائی کی جا رہی ہے"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"میموری میں محفوظ کیا جا رہا ہے"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"میموری سے ہٹایا جا رہا ہے"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"ویب تلاش مکمل ہو گئی"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"ویب صفحے کا جائزہ مکمل ہو گیا"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"تصویر تیار ہو گئی"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"حساب مکمل ہو گیا"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"آپ کا کوڈ چلانا مکمل ہو گیا"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"علمی ذخیرے میں تلاش مکمل ہو گئی"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"آواز کے ان پٹ پر کارروائی مکمل ہو گئی"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"میموری میں محفوظ کر دیا گیا"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"میموری سے ہٹا دیا گیا"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"مکمل: {0}"},com_ui_still_working:{english:"still working...",translated:"ابھی کام جاری ہے..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} تیار ہے"},com_ui_file_ready_fallback:{english:"File is ready",translated:"فائل تیار ہے"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"{0} پر کارروائی نہیں ہو سکی"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"فائل پر کارروائی نہیں ہو سکی"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"{0} پر کارروائی نہیں ہو سکی۔ براہ کرم فائل دوبارہ اپ لوڈ کریں۔"},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"فائل پر کارروائی نہیں ہو سکی۔ براہ کرم فائل دوبارہ اپ لوڈ کریں۔"},com_ui_file_processing:{english:"Processing...",translated:"پروسیسنگ..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"پروسیسنگ ناکام"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"ناکام - دوبارہ اپ لوڈ درکار ہے"},com_ui_file_retry:{english:"Retry",translated:"دوبارہ کوشش کریں"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"{0}s میں دوبارہ کوشش کریں"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"فائل انڈیکسنگ دوبارہ کی جا رہی ہے..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"براہ کرم دوبارہ کوشش سے پہلے {0}s انتظار کریں"},com_ui_file_retries_exhausted_reupload:{english:"Maximum retries reached. Please re-upload the file.",translated:"زیادہ سے زیادہ کوششیں مکمل ہو گئیں۔ براہ کرم فائل دوبارہ اپ لوڈ کریں۔"},com_ui_assistant_file_upload_invalid_json:{english:"Invalid JSON file. File content does not match the expected format.",translated:"غلط JSON فائل۔ فائل کا مواد متوقع فارمیٹ سے مطابقت نہیں رکھتا۔"}},xb=Object.freeze(Ob