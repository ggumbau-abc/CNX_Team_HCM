ype not supported. Please upload a supported file format.",translated:"Tipo de ficheiro não suportado. Por favor, carregue um formato de ficheiro suportado."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Falha ao carregar imagem"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Atualmente, apenas ficheiros JPEG, JPG, PNG e WEBP são suportados."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"O tamanho do ficheiro excede {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"O tamanho total dos ficheiros não pode exceder {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Ocorreu um erro ao validar o ficheiro."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Ocorreu um erro ao processar o ficheiro."},com_ui_assistants:{english:"Assistants",translated:"Assistentes"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Assistência de Estúdio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Conhecimento"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Sem categoria"},com_ui_attachment:{english:"Attachment",translated:"Anexo"},com_ui_assistants_output:{english:"Assistants Output",translated:"Saída dos Assistentes"},com_ui_delete:{english:"Delete",translated:"Eliminar"},com_ui_create:{english:"Create",translated:"Criar"},com_ui_share:{english:"Share",translated:"Partilhar"},com_ui_copy_link:{english:"Copy link",translated:"Copiar link"},com_ui_update_link:{english:"Update link",translated:"Atualizar link"},com_ui_create_link:{english:"Create link",translated:"Criar link"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Partilhar link no chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"Ocorreu um erro ao partilhar o link do chat"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"O seu nome e quaisquer mensagens adicionadas após a partilha permanecem privadas."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"Foi criado um link público para o seu chat. Gerencie chats partilhados anteriormente a qualquer momento através das Definições."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"O seu nome, instruções personalizadas e quaisquer mensagens adicionadas após a partilha permanecem privadas."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"O link público para o seu chat foi atualizado. Gerencie chats partilhados anteriormente a qualquer momento através das Definições."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Link partilhado não encontrado"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Eliminar chat?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Isto irá eliminar"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Tem a certeza de que deseja eliminar este Assistente? Esta ação não pode ser desfeita."},com_ui_rename:{english:"Rename",translated:"Renomear"},com_ui_more_options:{english:"More",translated:"Mais"},com_ui_preview:{english:"Preview",translated:"Pré-visualizar"},com_ui_upload:{english:"Upload",translated:"Carregar"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'O carregamento de "{0}" está a demorar mais tempo do que o previsto. Aguarde enquanto o ficheiro termina de ser indexado para recuperação.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Política de privacidade"},com_ui_terms_of_service:{english:"Terms of service",translated:"Termos de serviço"},com_ui_use_micrphone:{english:"Use microphone",translated:"Usar microfone"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Não é possível remover mais valores, é necessário um mínimo de {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"O número máximo permitido é {0}, utilizando os valores mais recentes."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Não foi possível iniciar sessão com as informações fornecidas. Verifique suas credenciais e tente novamente."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Excedeu o número de tentativas de login permitidas. Tente novamente em 15 minutos."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Sua conta foi temporariamente banida devido a violações do nosso serviço."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Ocorreu um erro interno no servidor. Aguarde alguns momentos e tente novamente."},com_auth_sign_in:{english:"Login",translated:"Iniciar sessão"},com_endpoint_system_message:{english:"System Message",translated:"Mensagem do Sistema"},com_endpoint_message:{english:"Message",translated:"Mensagem"},com_endpoint_messages:{english:"Messages",translated:"Mensagens"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Edite sua mensagem ou Regenere."},com_endpoint_default_blank:{english:"default: blank",translated:"padrão: vazio"},com_endpoint_default_false:{english:"default: false",translated:"padrão: falso"},com_endpoint_default_creative:{english:"default: creative",translated:"padrão: criativo"},com_endpoint_default_empty:{english:"default: empty",translated:"padrão: vazio"},com_endpoint_default_with_num:{english:"default: {0}",translated:"padrão: {0}"},com_endpoint_context:{english:"Context",translated:"Contexto"},com_endpoint_tone_style:{english:"Tone Style",translated:"Estilo de Tom"},com_endpoint_token_count:{english:"Token count",translated:"Contagem de tokens"},com_endpoint_output:{english:"Output",translated:"Saída"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Máx. de Tokens de Contexto"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`O número máximo de tokens que podem ser usados para contexto. Use isto para controlar quantos tokens são enviados por solicitação.
  Se não especificado, usará os padrões do sistema com base no tamanho de contexto dos modelos conhecidos. Definir valores mais altos pode resultar em erros e/ou custo de tokens mais alto.`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Defina instruções ou contexto personalizados. Ignorado se vazio."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Substitui as instruções do assistente. Útil para modificar o comportamento em cada execução."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Defina instruções ou contexto adicionais além das instruções principais do Assistente. Ignorado se vazio."},com_endpoint_custom_name:{english:"Custom Name",translated:"Nome Personalizado"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Instruções Personalizadas"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Instruções Adicionais"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Substituir Instruções"},com_endpoint_temperature:{english:"Temperature",translated:"Temperatura"},com_endpoint_default:{english:"default",translated:"padrão"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Máx. de Tokens de Saída"},com_endpoint_stop:{english:"Stop Sequences",translated:"Sequências de Paragem"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Separe os valores pressionando `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Campo opcional `max_tokens`, representando o número máximo de tokens que podem ser gerados na conclusão do chat.\n\nO comprimento total dos tokens de entrada e gerados é limitado pelo comprimento de contexto dos modelos. Pode ocorrer erros se este número exceder os tokens de contexto máximo."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Valores mais altos = mais aleatório, valores mais baixos = mais focado e determinístico. Recomendamos alterar isto ou Top P, mas não ambos."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"O máximo de tokens a gerar. O comprimento total dos tokens de entrada e gerados é limitado pelo comprimento de contexto do modelo."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Uma alternativa à amostragem com temperatura, chamada amostragem de núcleo, onde o modelo considera os resultados dos tokens com massa de probabilidade top_p. Assim, 0.1 significa que apenas os tokens que compõem os 10% superiores da massa de probabilidade são considerados. Recomendamos alterar isto ou a temperatura, mas não ambos."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Número entre 0 e 2.0. Valores positivos penalizam novos tokens com base na sua frequência existente no texto até agora, diminuindo a probabilidade do modelo repetir a mesma linha literalmente."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Número entre 0 e 2.0. Valores positivos penalizam novos tokens com base na sua presença no texto até agora, aumentando a probabilidade do modelo falar sobre novos tópicos."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Reenviar todos os ficheiros anexados anteriormente. Nota: isto aumentará o custo de tokens e pode ocorrer erros com muitos anexos."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'A resolução para pedidos de Visão. "Baixa" é mais barata e rápida, "Alta" é mais detalhada e cara, e "Auto" escolherá automaticamente entre as duas com base na resolução da imagem.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Até 4 sequências onde a API irá parar de gerar mais tokens."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Defina um nome personalizado para iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Defina instruções personalizadas para incluir na Mensagem do Sistema. Padrão: nenhum"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Penalização de Frequência"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Penalização de Presença"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Usar Funções"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Reenviar Ficheiros"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Detalhe da Imagem"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Pular Conclusão"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Definir instruções personalizadas para incluir na Mensagem do Sistema. Padrão: nenhuma"},com_endpoint_import:{english:"Import",translated:"Importar"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Definir um nome personalizado, caso encontre este predefinido"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Tem a certeza de que deseja eliminar este predefinido?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Predefinido Importado!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Ocorreu um erro ao importar o seu predefinido. Por favor, tente novamente."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Ocorreu um erro ao guardar o seu predefinido. Por favor, tente novamente."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Ocorreu um erro ao eliminar o seu predefinido. Por favor, tente novamente."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"já não é o predefinido padrão."},com_endpoint_preset_default_item:{english:"Default:",translated:"Padrão:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Nenhum predefinido padrão ativo."},com_endpoint_preset_title:{english:"Preset",translated:"Predefinido"},com_endpoint_preset_saved:{english:"Saved!",translated:"Guardado!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"é agora o predefinido padrão."},com_endpoint_preset:{english:"preset",translated:"predefinido"},com_endpoint_presets:{english:"presets",translated:"predefinidos"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Ativo!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Nome do Predefinido"},com_endpoint:{english:"Endpoint",translated:"Endpoint"},com_endpoint_examples:{english:" Presets",translated:" Predefinidos"},com_endpoint_export:{english:"Export",translated:"Exportar"},com_endpoint_export_share:{english:"Export/Share",translated:"Exportar/Partilhar"},com_endpoint_assistant:{english:"Assistant",translated:"Assistente"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Usar Assistente Ativo"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Guardar como Predefinição"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Tem a certeza de que deseja limpar todas as predefinições? Isto é irreversível."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Ainda não há predefinições, use o botão de configurações para criar uma"},com_endpoint_my_preset:{english:"My Preset",translated:"Minha Predefinição"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Modelo de Agente (Recomendado: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Modelo de Conclusão (Recomendado: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Ativar uso de Plugins como Funções OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Ativar pular a etapa de conclusão, que revisa a resposta final e os passos gerados"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Por favor, selecione um Assistente e inicie um novo chat"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Defina a sua Chave no menu Cabeçalho para conversar."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Por favor, selecione um Assistente"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Bem-vindo ao iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Texto para Fala"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Reprodução Automática da Última Mensagem"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Fala para Texto"},com_nav_profile_picture:{english:"Profile Picture",translated:"Foto de Perfil"},com_nav_change_picture:{english:"Change picture",translated:"Alterar foto"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Mostrar Configurações do Agente"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Mostrar Configurações de Conclusão"},com_hide_examples:{english:"Hide Examples",translated:"Ocultar Exemplos"},com_show_examples:{english:"Show Examples",translated:"Mostrar Exemplos"},com_nav_export_filename:{english:"Filename",translated:"Nome do ficheiro"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Definir o nome do ficheiro"},com_nav_export_type:{english:"Type",translated:"Tipo"},com_nav_export_conversation:{english:"Export conversation",translated:"Exportar conversa"},com_nav_export:{english:"Export",translated:"Exportar"},com_nav_shared_links:{english:"Shared links",translated:"Links partilhados"},com_nav_shared_links_manage:{english:"Manage",translated:"Gerir"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Não tem links partilhados."},com_nav_shared_links_name:{english:"Name",translated:"Nome"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Data de partilha"},com_nav_source_chat:{english:"View source chat",translated:"Ver chat de origem"},com_nav_my_files:{english:"File Manager",translated:"Gestor de Ficheiros"},com_nav_admin_center:{english:"Admin Center",translated:"Centro de Administração"},com_nav_theme:{english:"Theme",translated:"Tema"},com_nav_theme_system:{english:"System",translated:"Sistema"},com_nav_theme_dark:{english:"Dark",translated:"Escuro"},com_nav_theme_light:{english:"Light",translated:"Claro"},com_nav_user_name_display:{english:"Display username in messages",translated:"Mostrar nome de utilizador nas mensagens"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Limpar todos os chats"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Confirmar Limpeza"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Fechar barra lateral"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Abrir barra lateral"},com_nav_send_message:{english:"Send message",translated:"Enviar mensagem"},com_nav_log_out:{english:"Log out",translated:"Terminar sessão"},com_nav_user:{english:"USER",translated:"UTILIZADOR"},com_nav_archived_chats:{english:"Archived chats",translated:"Conversas arquivadas"},com_nav_archived_chats_manage:{english:"Manage",translated:"Gerir"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Não tem conversas arquivadas."},com_nav_archive_name:{english:"Name",translated:"Nome"},com_nav_archive_created_at:{english:"DateCreated",translated:"Data de criação"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Limpar conversas"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Tem a certeza de que deseja limpar todas as conversas? Isto é irreversível."},com_nav_help:{english:"Help",translated:"Ajuda"},com_nav_user_guide:{english:"User Guide",translated:"Guia do Utilizador"},com_nav_settings:{english:"Settings",translated:"Definições"},com_nav_search_placeholder:{english:"Search messages",translated:"Procurar mensagens"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Enviar texto automaticamente (após 3 seg)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Erro ao reproduzir áudio: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Erro ao processar áudio: {0}"},com_nav_engine:{english:"Engine",translated:"Motor"},com_nav_browser:{english:"Browser",translated:"Navegador"},com_nav_external:{english:"External",translated:"Externo"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Eliminar armazenamento de cache"},com_nav_voice_select:{english:"Voice",translated:"Voz"},com_nav_setting_general:{english:"General",translated:"Geral"},com_nav_setting_speech:{english:"Speech",translated:"Fala"},com_nav_language:{english:"Language",translated:"Idioma"},com_nav_lang_auto:{english:"Auto detect",translated:"Deteção automática"},com_page_not_found:{english:"Page not found",translated:"Página não encontrada"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Algo correu mal"},com_unauthorized_access:{english:"Unauthorized access",translated:"Acesso não autorizado"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Acesso não autorizado. O acesso está restrito a domínios específicos."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Sua conta foi temporariamente suspensa devido a violações do nosso serviço"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Você está restrito a acessar o aplicativo fora da rede!"},com_support_ticket_text:{english:"Support Ticket",translated:"Ticket de Suporte"},com_help_dialog_Header:{english:"Need assistance?",translated:"Precisa de ajuda?"},com_help_dialog_text_1_1:{english:"Click",translated:"Clique"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"para instruções detalhadas"},com_help_dialog_text_here:{english:"here",translated:"aqui"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Para problemas, preencha um"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Para problemas, contate"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Encontre os passos"},com_status_ind_none:{english:"Operational",translated:"Operacional"},com_status_ind_minor:{english:"Minor Issues",translated:"Problemas Menores"},com_status_ind_major:{english:"Major Issues",translated:"Problemas Maiores"},com_status_ind_critical:{english:"Critical",translated:"Crítico"},com_status_ind_error:{english:"Error Fetching",translated:"Erro ao Buscar"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Por favor, note que ao sair de um chat ou iniciar um novo, você perderá o histórico de conversas."},com_forbidden_access:{english:"Forbidden access",translated:"Acesso proibido"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Política de Uso Aceitável"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Política de Privacidade"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Contrato de Assinatura"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Antes de usar o iX Hello, você pode revisar a "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Ao se inscrever e/ou entrar, você concorda com os termos acima."},com_login_page_and:{english:"and ",translated:"e "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Sem assistentes fixados"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Assistentes fixados"},com_ui_loading:{english:"Loading...",translated:"A carregar..."},com_ui_unpin:{english:"Unpin",translated:"Desafixar"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Assistente desafixado com sucesso"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Erro ao desafixar assistente"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Assistente fixado com sucesso"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Erro ao fixar/desafixar assistente"},com_ui_pin:{english:"Pin",translated:"Fixar"},come_create_assistant:{english:"Create Assistant",translated:"Criar Assistente"},come_edit_assistant:{english:"Edit Assistant",translated:"Editar Assistente"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Tem a certeza de que deseja continuar? Isto resultará na perda de quaisquer alterações feitas ao Assistente que está a editar ou criar. Esta ação não pode ser desfeita."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Assistente com id {0} não foi encontrado."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"O navegador não suporta Reconhecimento de Fala"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Permissão de microfone não concedida"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Erro ao iniciar gravação: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder não está a gravar"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder não é suportado neste navegador"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"A sua mensagem contém informações pessoais e não pôde ser enviada. Por favor, remova qualquer informação pessoal."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Falha ao renomear conversa"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Tem {0} dos seus tokens alocados restantes."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello pode cometer erros. Por favor, reveja todas as saídas para qualidade e precisão. Todas as entradas são registadas para conformidade."},com_ui_assistant_group_by:{english:"Group by",translated:"Agrupar por"},com_ui_assistant_category:{english:"Category",translated:"Categoria"},com_ui_assistant_team:{english:"Team",translated:"Equipa"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Engenharia"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Inteligência"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Operações"},com_ui_assistant_sales:{english:"Sales",translated:"Vendas"},com_ui_assistant_strategy:{english:"Strategy",translated:"Estratégia"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Assistentes de Estúdio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Carregar uma imagem de avatar (PNG ou JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Pesquisar Online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Navegar no Site"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Gerar Imagens"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Calcular Matemática"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Ferramenta Padrão"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"O carregamento do ficheiro está a demorar mais do que o esperado. Por favor, tente novamente."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Erro ao fixar assistente"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Ocorreu um erro ao eliminar o link partilhado"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Modelo DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Nenhum predefinido ativo."},com_ui_drag_drop_title:{english:"Add anything",translated:"Adicionar qualquer coisa"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Solte qualquer ficheiro aqui para adicioná-lo à conversa"},com_ui_analyzing:{english:"Analyzing",translated:"A analisar"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Análise concluída"},com_ui_warning:{english:"Warning",translated:"Aviso"},com_ui_proceed:{english:"Proceed",translated:"Prosseguir"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Os ficheiros carregados para o assistente são usados apenas para fins de conversação. Os utilizadores podem aceder ao conteúdo destes ficheiros fazendo perguntas relevantes, mas o download direto dos ficheiros não é permitido."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Defina um nome personalizado para este predefinido"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Defina um exemplo de entrada. O exemplo é ignorado se estiver vazio."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Defina um exemplo de saída. O exemplo é ignorado se estiver vazio."},com_nav_export_select_type:{english:"Select a file type",translated:"Selecione um tipo de ficheiro"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"captura de ecrã (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"texto (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Não foi recebida resposta. Tente enviar a sua mensagem novamente. Se o problema persistir após recarregar a página e tentar novamente, contacte o suporte."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Voltar ao Chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Moderação de Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"A moderação de guardrail está ativada para este assistente. O conteúdo será verificado de acordo com as políticas de moderação."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Desativar a moderação de guardrail remove as verificações de moderação de conteúdo para este assistente. Você é responsável por cumprir as políticas de conteúdo da sua organização. A atividade é totalmente registada e monitorizada."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Por favor, explique a sua justificativa comercial para desativar a moderação de guardrail (obrigatório)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Por favor, forneça uma justificativa para desativar a moderação de guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Permitir que os utilizadores mudem de modelo no chat"},com_ui_feedback_good:{english:"Good response",translated:"Boa resposta"},com_ui_feedback_bad:{english:"Poor response",translated:"Resposta fraca"},com_ui_feedback_comments:{english:"Comments",translated:"Comentários"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Comentários (opcional)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Diga-nos mais sobre a sua experiência..."},com_ui_feedback_submit:{english:"Submit",translated:"Enviar"},com_ui_feedback_error:{en