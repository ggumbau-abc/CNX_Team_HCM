:"Tiền tố",com_endpoint_temperature:"Nhiệt độ",com_endpoint_default:"mặc định",com_endpoint_top_p:"Top P",com_endpoint_top_k:"Top K",com_endpoint_max_output_tokens:"Số mã thông báo tối đa",com_endpoint_openai_temp:"Giá trị cao = ngẫu nhiên hơn, trong khi giá trị thấp = tập trung và xác định hơn. Chúng tôi khuyến nghị thay đổi giá trị này hoặc Top P nhưng không phải cả hai.",com_endpoint_openai_max:"Số mã thông báo tối đa để tạo. Tổng chiều dài của mã thông báo đầu vào và mã thông báo đã tạo bị giới hạn bởi độ dài ngữ cảnh của mô hình.",com_endpoint_openai_topp:"Một phương pháp thay thế cho việc lấy mẫu nhiệt độ, được gọi là lấy mẫu ranh giới, nơi mô hình xem xét kết quả của các mã thông báo với khối lượng xác suất top_p. Vì vậy, giá trị 0.1 có nghĩa là chỉ các mã thông báo bao gồm 10% khối lượng xác suất top_p được xem xét. Chúng tôi khuyến nghị thay đổi giá trị này hoặc nhiệt độ nhưng không phải cả hai.",com_endpoint_openai_freq:"Số từ giữa -2.0 và 2.0. Giá trị dương trừu tượng hóa các mã thông báo mới dựa trên tần suất hiện có của chúng trong văn bản, làm giảm khả năng mô hình lặp lại cùng một dòng văn hoàn toàn.",com_endpoint_openai_pres:"Số từ giữa -2.0 và 2.0. Giá trị dương trừu tượng hóa mã thông báo mới dựa trên việc chúng có xuất hiện trong văn bản, làm tăng khả năng của mô hình để nói về các chủ đề mới.",com_endpoint_openai_custom_name_placeholder:"Đặt tên tùy chỉnh cho ChatGPT",com_endpoint_openai_prompt_prefix_placeholder:"Đặt hướng dẫn tùy chỉnh để bao gồm vào Thông điệp hệ thống. Mặc định: không có",com_endpoint_frequency_penalty:"Hình phạt tần suất",com_endpoint_presence_penalty:"Hình phạt hiện diện",com_endpoint_plug_use_functions:"Sử dụng chức năng",com_endpoint_plug_skip_completion:"Bỏ qua hoàn thành",com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:"Đặt hướng dẫn tùy chỉnh để bao gồm trong Thông điệp hệ thống. Mặc định: không có",com_endpoint_import:"Nhập",com_endpoint_set_custom_name:"Đặt tên tùy chỉnh, nếu bạn có thể tìm thấy cài đặt này",com_endpoint_preset:"đặt sẵn",com_endpoint_presets:"đặt sẵn",com_endpoint_preset_name:"Tên đặt sẵn",com_endpoint:"Điểm kết thúc",com_endpoint_examples:" Đặt sẵn",com_endpoint_save:"Lưu",com_endpoint_export:"Xuất",com_endpoint_save_as_preset:"Lưu dưới dạng đặt sẵn",com_endpoint_presets_clear_warning:"Bạn có chắc chắn muốn xóa tất cả các đặt sẵn? Hành động này không thể hoàn tác.",com_endpoint_no_presets:"Chưa có đặt sẵn",com_endpoint_my_preset:"Đặt sẵn của tôi",com_endpoint_agent_model:"Mô hình Đặc trưng (Đề xuất: GPT-3.5)",com_endpoint_completion_model:"Mô hình Hoàn thành (Đề xuất: GPT-4)",com_endpoint_func_hover:"Cho phép sử dụng Plugin như các chức năng OpenAI",com_endpoint_skip_hover:"Cho phép bỏ qua bước hoàn thành, kiểm tra câu trả lời cuối cùng và các bước đã tạo",com_nav_export_filename:"Tên tệp",com_nav_export_filename_placeholder:"Đặt tên cho tệp",com_nav_export_type:"Loại",com_nav_export_conversation:"Xuất cuộc trò chuyện",com_nav_export:"Xuất",com_nav_shared_links:"Liên kết được chia sẻ",com_nav_shared_links_manage:"Quản l",com_nav_shared_links_empty:"Bạn không có link được chia sẻ.",com_nav_shared_links_name:"Tên",com_nav_shared_links_date_shared:"Ngày chia sẻ",com_nav_source_chat:"View source chat",com_nav_my_files:"File Manager",com_nav_admin_center:"Trung tâm quản trị",com_nav_theme:"Chủ đề",com_nav_theme_system:"Hệ thống",com_nav_theme_dark:"Tối",com_nav_theme_light:"Sáng",com_nav_clear_all_chats:"Xóa tất cả cuộc trò chuyện",com_nav_confirm_clear:"Xác nhận xóa",com_nav_close_sidebar:"Đóng thanh bên",com_nav_open_sidebar:"Mở thanh bên",com_nav_send_message:"Gửi tin nhắn",com_nav_log_out:"Đăng xuất",com_nav_user:"NGƯỜI DÙNG",com_nav_clear_conversation:"Xóa cuộc trò chuyện",com_nav_clear_conversation_confirm_message:"Bạn có chắc chắn muốn xóa tất cả cuộc trò chuyện? Hành động này không thể hoàn tác.",com_nav_help:"Trợ giúp",com_nav_settings:"Cài đặt",com_nav_search_placeholder:"Tìm kiếm tin nhắn",com_nav_setting_general:"Chung",com_error_moderation:"Nội dung gửi đã bị hệ thống kiểm duyệt gắn cờ vì không phù hợp với hướng dẫn cộng đồng của chúng tôi. Chúng tôi không thể tiếp tục với chủ đề này. Nếu bạn có câu hỏi hoặc chủ đề khác muốn khám phá, vui lòng chỉnh sửa tin nhắn của bạn hoặc tạo cuộc trò chuyện mới.",com_error_no_user_key:"Không tìm thấy khóa. Vui lòng cung cấp khóa và thử lại.",com_error_no_base_url:"Không tìm thấy URL cơ bản. Vui lòng cung cấp và thử lại.",com_error_invalid_user_key:"Khóa không hợp lệ. Vui lòng cung cấp khóa và thử lại.",com_error_expired_user_key:"Khóa cung cấp cho {0} đã hết hạn vào {1}. Vui lòng cung cấp khóa và thử lại.",com_error_token_balance_exceeded_license:"Bạn đã đạt đến số lượng token tối đa cho giấy phép của mình. Vui lòng liên hệ bộ phận bán hàng tại {0} để được hỗ trợ thêm.",com_error_token_balance_percent_used:"Bạn đã sử dụng {0}% số token được cấp. Vui lòng liên hệ {1} để được hỗ trợ thêm.",com_error_license_expired:"Giấy phép của bạn không khả dụng. Vui lòng liên hệ hỗ trợ để được hỗ trợ thêm.",com_restricted_invalid_ip_format:"Địa chỉ IPv6 không được hỗ trợ. Vui lòng sử dụng kết nối IPv4 hoặc liên hệ hỗ trợ để được hỗ trợ thêm.",com_error_tool_run:"Đã xảy ra lỗi khi xử lý yêu cầu của bạn. Vui lòng thử lại.",com_files_upload_duplicate_success:"Tệp {0} đã được tải lên thành công trước đó",com_files_no_results:"Không có kết quả.",com_files_filter:"Tìm kiếm tệp theo tên",com_files_number_selected:"{0} trong số {1} tệp đã chọn",com_sidepanel_select_assistant:"Chọn Trợ lý",com_sidepanel_parameters:"Tham số",com_ui_create_assistant:"Tạo Trợ lý",com_ui_create_assistant_permission_needed:"Người dùng cần quyền tạo để tạo Trợ lý",com_sidepanel_assistant_builder:"Trợ lý",com_sidepanel_attach_files:"Quản lý Tệp",com_sidepanel_manage_files:"Quản lý Tệp",com_assistants_shared_with_consent_title:"Đồng ý",com_assistants_shared_with_consent_description_1:"Bạn sắp chia sẻ trợ lý này với các thành viên khác trong nhóm. Trước khi chia sẻ trợ lý này, vui lòng xem xét các điểm chính dưới đây:",com_assistants_shared_with_consent_description_2:"Bằng cách tiếp tục, bạn xác nhận rằng bạn hiểu và chấp nhận các điều khoản này.",com_assistants_shared_with_consent_bullet_1:"Trợ lý chia sẻ không nên chứa dữ liệu nhạy cảm hoặc bí mật.",com_assistants_shared_with_consent_bullet_2:"Trợ lý chia sẻ không được xử lý dữ liệu nhạy cảm hoặc bảo mật.",com_assistants_shared_with_consent_bullet_3:"Chia sẻ đồng nghĩa với trách nhiệm và trách nhiệm đối với nội dung và quyền truy cập.",com_assistants_shared_with_consent_bullet_4:"Nên chia sẻ với một nhóm cụ thể hoặc nhóm kín thay vì mọi người.",com_button_accept:"Chấp nhận",com_button_decline:"Từ chối",com_assistants_capabilities:"Cơ sở kiến thức",com_assistants_file_search:"Tìm kiếm Tệp",com_assistants_file_search_description:"Thêm các tệp bạn cần trợ lý tìm kiếm khi trả lời câu hỏi trong trò chuyện.",com_assistants_file_search_supported_label:"Hỗ trợ:",com_assistants_file_search_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",com_assistants_file_search_tips_label:"Mẹo:",com_assistants_file_search_tips:"Yêu cầu trợ lý sử dụng 'Công cụ Tìm kiếm Tệp' mỗi khi trả lời người dùng.",com_assistants_file_search_info:"Đính kèm kho lưu trữ vector cho Tìm kiếm Tệp chưa được hỗ trợ. Bạn có thể đính kèm từ Provider Playground hoặc đính kèm tệp vào tin nhắn cho tìm kiếm tệp theo từng luồng.",com_assistants_file_search_fetch_error:"Có lỗi xảy ra khi lấy tệp từ kho lưu trữ vector.",com_assistants_knowledge:"Cơ sở kiến thức",com_assistants_knowledge_info:"Tải lên tệp cho trợ lý của bạn để nó có thể sử dụng chúng để trả lời câu hỏi (ví dụ: Hướng dẫn Sử dụng CXNGPT)",com_assistants_knowledge_disabled:"Nhấp Tạo để lưu Trợ lý của bạn, sau đó tải lên tệp của bạn và nhấp Lưu.",com_assistants_image_vision:"Nhận diện Hình ảnh",com_assistants_code_interpreter:"Trình thông dịch Mã",com_assistants_code_interpreter_description:"Thêm các tệp bạn cần trợ lý sử dụng để phân tích hoặc chuyển đổi dữ liệu c