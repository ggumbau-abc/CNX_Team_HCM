m_ui_none_selected:{english:"None selected",translated:"Tidak ada yang dipilih"},com_ui_thinking:{english:"Thinking",translated:"Berpikir"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Menganalisis permintaan Anda"},com_ui_processing:{english:"Putting it together",translated:"Memproses"},com_ui_working_on_it:{english:"Almost ready",translated:"Sedang mengerjakannya"},com_ui_read_aloud:{english:"Read aloud",translated:"Baca keras"},com_ui_copied:{english:"Copied!",translated:"Tersalin!"},com_ui_copy_code:{english:"Copy code",translated:"Salin kode"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Sebutkan endpoint, asisten, atau preset untuk beralih cepat"},com_ui_nothing_found:{english:"Nothing found",translated:"Tidak ada yang ditemukan"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Pergi ke percakapan"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Jenis impor tidak didukung"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Tidak diketahui"},com_ui_result:{english:"Result",translated:"Hasil"},com_ui_image_gen:{english:"Image Gen",translated:"Pembuatan Gambar"},com_ui_assistant:{english:"Assistant",translated:"Asisten"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Berhasil menghapus asisten"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Terjadi kesalahan saat menghapus asisten"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"File duplikat terdeteksi."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Terjadi kesalahan saat mengunggah file."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Terjadi kesalahan saat mengunggah file: Endpoint tidak ditentukan"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"File kosong tidak diperbolehkan."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Anda hanya dapat mengunggah hingga {0} file sekaligus."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Anda hanya dapat mengunggah hingga {0} file di bagian ini."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Batas unggahan telah tercapai untuk {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Tidak dapat menentukan jenis file untuk: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Jenis file tidak didukung. Harap unggah format file yang didukung."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Gagal memuat gambar"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Saat ini, hanya file JPEG, JPG, PNG, dan WEBP yang didukung."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Ukuran file melebihi {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Ukuran total file tidak boleh melebihi {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Terjadi kesalahan saat memvalidasi file."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Terjadi kesalahan saat memproses file."},com_ui_assistants:{english:"Assistants",translated:"Asisten"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Bantuan Studio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Pengetahuan"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Tidak Dikategorikan"},com_ui_attachment:{english:"Attachment",translated:"Lampiran"},com_ui_assistants_output:{english:"Assistants Output",translated:"Output Asisten"},com_ui_create:{english:"Create",translated:"Buat"},com_ui_copy_link:{english:"Copy link",translated:"Salin tautan"},com_ui_update_link:{english:"Update link",translated:"Perbarui tautan"},com_ui_create_link:{english:"Create link",translated:"Buat tautan"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Anda yakin ingin menghapus Asisten ini? Ini tidak dapat dibatalkan."},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Mengunggah "{0}" memakan waktu lebih lama dari yang diharapkan. Harap tunggu sementara file selesai diindeks untuk pengambilan.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Kebijakan privasi"},com_ui_terms_of_service:{english:"Terms of service",translated:"Ketentuan layanan"},com_ui_use_micrphone:{english:"Use microphone",translated:"Gunakan mikrofon"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Tidak dapat menghapus lebih banyak nilai, minimal {0} diperlukan."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Jumlah maksimum yang diizinkan adalah {0}, menggunakan nilai terbaru."},com_endpoint_messages:{english:"Messages",translated:"Pesan"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Maks Token Konteks"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Jumlah maksimum token yang dapat digunakan untuk konteks. Gunakan ini untuk mengontrol berapa banyak token yang dikirim per permintaan.
  Jika tidak ditentukan, akan menggunakan default sistem berdasarkan ukuran konteks model yang diketahui. Menetapkan nilai lebih tinggi dapat mengakibatkan kesalahan dan/atau biaya token lebih tinggi.`},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Menimpa instruksi asisten. Ini berguna untuk memodifikasi perilaku berdasarkan per-run."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Setel instruksi tambahan atau konteks di atas instruksi utama Asisten. Diabaikan jika kosong."},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Instruksi Tambahan"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Instruksi Override"},com_endpoint_stop:{english:"Stop Sequences",translated:"Hentikan Urutan"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Pisahkan nilai dengan menekan `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Kolom opsional `max_tokens`, mewakili jumlah maksimum token yang dapat dihasilkan dalam penyelesaian obrolan.\n\nPanjang total token input dan token yang dihasilkan dibatasi oleh panjang konteks model. Anda mungkin mengalami kesalahan jika angka ini melebihi token konteks maksimum."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Kirim ulang semua file yang sebelumnya dilampirkan. Catatan: ini akan meningkatkan biaya token dan Anda mungkin mengalami kesalahan dengan banyak lampiran."},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Hingga 4 urutan di mana API akan berhenti menghasilkan token lebih lanjut."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Kirim Ulang File"},com_endpoint_export_share:{english:"Export/Share",translated:"Ekspor/Bagikan"},com_endpoint_assistant:{english:"Assistant",translated:"Asisten"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Gunakan Asisten Aktif"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Silakan pilih Asisten dan mulai obrolan baru"},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Silakan Pilih Asisten"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Teks ke Suara"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Putar Otomatis Pesan Terbaru"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Suara ke Teks"},com_nav_user_guide:{english:"User Guide",translated:"Panduan Pengguna"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Kirim teks otomatis (setelah 3 detik)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Kesalahan memutar audio: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Kesalahan memproses audio: {0}"},com_nav_engine:{english:"Engine",translated:"Mesin"},com_nav_browser:{english:"Browser",translated:"Peramban"},com_nav_external:{english:"External",translated:"Eksternal"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Hapus penyimpanan cache"},com_nav_voice_select:{english:"Voice",translated:"Suara"},com_nav_setting_speech:{english:"Speech",translated:"Suara"},com_page_not_found:{english:"Page not found",translated:"Halaman tidak ditemukan"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Terjadi kesalahan"},com_unauthorized_access:{english:"Unauthorized access",translated:"Akses tidak sah"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Akses tidak sah. Akses dibatasi untuk domain tertentu."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Akun Anda telah diblokir sementara karena pelanggaran layanan kami"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Anda dibatasi untuk mengakses aplikasi di luar jaringan!"},com_support_ticket_text:{english:"Support Ticket",translated:"Tiket Dukungan"},com_help_dialog_Header:{english:"Need assistance?",translated:"Butuh bantuan?"},com_help_dialog_text_1_1:{english:"Click",translated:"Klik"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"untuk instruksi lengkap"},com_help_dialog_text_here:{english:"here",translated:"di sini"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Untuk masalah, isi"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Untuk masalah, hubungi"},com_help_dialog_text_ticket:{english:"ticket",translated:"tiket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Temukan langkah-langkah"},com_status_ind_none:{english:"Operational",translated:"Beroperasi"},com_status_ind_minor:{english:"Minor Issues",translated:"Masalah Kecil"},com_status_ind_major:{english:"Major Issues",translated:"Masalah Besar"},com_status_ind_critical:{english:"Critical",translated:"Kritis"},com_status_ind_error:{english:"Error Fetching",translated:"Kesalahan Pengambilan"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Harap dicatat bahwa ketika Anda meninggalkan obrolan atau memulai obrolan baru, Anda akan kehilangan riwayat percakapan Anda."},com_forbidden_access:{english:"Forbidden access",translated:"Akses dilarang"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Kebijakan Penggunaan yang Dapat Diterima"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Kebijakan Privasi"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Perjanjian Langganan"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Sebelum menggunakan iX Hello, Anda dapat meninjau "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Dengan mendaftar dan/atau masuk, Anda setuju dengan syarat di atas."},com_login_page_and:{english:"and ",translated:"dan "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Tidak ada asisten yang dipin"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Asisten yang dipin"},com_ui_loading:{english:"Loading...",translated:"Memuat..."},com_ui_unpin:{english:"Unpin",translated:"Lepas pin"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Asisten berhasil dilepas pin"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Kesalahan melepas pin asisten"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Asisten berhasil dipin"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Kesalahan mem-pin/melepas pin asisten"},com_ui_pin:{english:"Pin",translated:"Pin"},come_create_assistant:{english:"Create Assistant",translated:"Buat Asisten"},come_edit_assistant:{english:"Edit Assistant",translated:"Edit Asisten"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Anda yakin ingin melanjutkan? Ini akan mengakibatkan hilangnya perubahan yang telah dibuat pada Asisten yang sedang Anda edit atau buat. Tindakan ini tidak dapat dibatalkan."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Asisten dengan id {0} tidak ditemukan."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Peramban tidak mendukung SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Izin mikrofon tidak diberikan"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Kesalahan memulai perekaman: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder tidak merekam"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder tidak didukung di peramban ini"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Pesan Anda mengandung informasi pribadi dan tidak dapat dikirim. Harap hapus informasi pribadi."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Gagal mengganti nama percakapan"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Anda memiliki {0} token yang tersisa."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello dapat membuat kesalahan. Harap tinjau semua keluaran untuk kualitas dan akurasi. Semua masukan dicatat untuk kepatuhan."},com_ui_assistant_group_by:{english:"Group by",translated:"Kelompokkan berdasarkan"},com_ui_assistant_category:{english:"Category",translated:"Kategori"},com_ui_assistant_team:{english:"Team",translated:"Tim"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Teknik"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Intelijen"},com_ui_assistant_marketing:{english:"Marketing",translated:"Pemasaran"},com_ui_assistant_operations:{english:"Operations",translated:"Operasi"},com_ui_assistant_sales:{english:"Sales",translated:"Penjualan"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategi"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Asisten Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Unggah gambar avatar (PNG atau JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Cari Online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Jelajahi Situs Web"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Hasilkan Gambar"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Hitung Matematika"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Alat Default"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Unggahan file memakan waktu lebih lama dari yang diharapkan. Silakan coba lagi."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Kesalahan saat menyematkan asisten"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Terjadi kesalahan saat menghapus tautan yang dibagikan"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Template DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Tidak ada preset default yang aktif."},com_ui_drag_drop_title:{english:"Add anything",translated:"Tambahkan apa saja"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Jatuhkan file apa pun di sini untuk menambahkannya ke percakapan"},com_ui_analyzing:{english:"Analyzing",translated:"Menganalisis"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Selesai menganalisis"},com_ui_warning:{english:"Warning",translated:"Peringatan"},com_ui_proceed:{english:"Proceed",translated:"Lanjutkan"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"File yang diunggah ke asisten hanya digunakan untuk tujuan percakapan. Pengguna dapat mengakses konten file ini dengan mengajukan pertanyaan yang relevan, tetapi unduhan langsung file tidak diizinkan."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Tetapkan nama khusus untuk preset ini"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Tetapkan contoh input. Contoh diabaikan jika kosong."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Tetapkan contoh output. Contoh diabaikan jika kosong."},com_nav_export_select_type:{english:"Select a file type",translated:"Pilih jenis file"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"screenshot (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"teks (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Tidak ada respons yang diterima. Silakan coba kirim pesan Anda lagi. Jika masalah berlanjut setelah memuat ulang halaman dan mencoba kembali, silakan hubungi dukungan."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Kembali ke Obrolan"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Moderasi Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Moderasi guardrail diaktifkan untuk asisten ini. Konten akan diperiksa sesuai kebijakan moderasi."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Menonaktifkan moderasi guardrail menghapus pemeriksaan moderasi konten untuk asisten ini. Anda bertanggung jawab untuk mematuhi kebijakan konten organisasi Anda. Aktivitas dicatat dan dipantau sepenuhnya."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Harap jelaskan alasan bisnis Anda untuk menonaktifkan moderasi guardrail (wajib)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Harap berikan alasan untuk menonaktifkan moderasi guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Izinkan pengguna mengganti model dalam obrolan"},com_ui_feedback_good:{english:"Good response",translated:"Respons bagus"},com_ui_feedback_bad:{english:"Poor response",translated:"Respons buruk"},com_ui_feedback_comments:{english:"Comments",translated:"Komentar"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Komentar (opsional)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Ceritakan lebih banyak tentang pengalaman Anda..."},com_ui_feedback_submit:{english:"Submit",translated:"Kirim"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Kami tidak dapat mengirim umpan balik Anda"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Tidak benar"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Tidak relevan"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Kedaluwarsa"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Tidak cukup detail"},com_ui_feedback_reason_other:{english:"Other",translated:"Lainnya"},com_ui_model_recommended:{english:"Recommended",translated:"Direkomendasikan"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Legacy — harap perbarui"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Model ini tidak lagi didukung. Silakan pilih model saat ini."},com_nav_setting_memory:{english:"Memory",translated:"Memori"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Kelola fakta pribadi yang diingat asisten dalam percakapan Anda."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Tambahkan memori baru…"},com_nav_memory_add_button:{english:"Add memory",translated:"Tambah memori"},com_nav_memory_category:{english:"Category",translated:"Kategori"},com_nav_memory_category_preference:{english:"Preference",translated:"Preferensi"},com_nav_memory_category_identity:{english:"Identity",translated:"Identitas"},com_nav_memory_category_context:{english:"Context",translated:"Konteks"},com_nav_memory_category_project:{english:"Project",translated:"Proyek"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Belum ada memori"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Memori yang Anda simpan akan muncul di sini dan membantu mempersonalisasi percakapan di masa depan."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Tidak dapat memuat memori. Silakan coba lagi."},com_nav_memory_retry:{english:"Retry",translated:"Coba lagi"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Tidak dapat menambah memori. Silakan coba lagi."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Tidak dapat memperbarui memori. Silakan coba lagi."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Tidak dapat menghapus memori. Silakan coba lagi."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Hapus memori ini?"},com_nav_memory_delete_button:{english:"Delete",translated:"Hapus"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Edit memori"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Hapus memori"},com_nav_memory_save:{english:"Save",translated:"Simpan"},com_nav_memory_cancel:{english:"Cancel",translated:"Batal"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Disimpan {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — model pemikiran GPT-5 terbaru dengan kecerdasan terdepan."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — varian GPT-5.4 yang ringkas dan hemat biaya."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — model generasi terbaru GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus terbaru — kecerdasan terdepan untuk agen pemrograman dan alur kerja perusahaan."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus terbaru — kecerdasan terdepan untuk agen pemrograman dan alur kerja perusahaan."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet yang ditingkatkan dengan penalaran dan instruksi yang lebih baik."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Model terkuat Anthropic untuk tugas kompleks dan multi-langkah."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Keseimbangan kecerdasan dan kecepatan untuk berbagai tugas."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Model Claude tercepat dan paling ringkas — ideal untuk tugas berkapasitas tinggi."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — penalaran yang ditingkatkan dan kemampuan multimodal."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Model andalan generasi berikutnya dari OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 ringan — efisien dan cepat untuk tugas sehari-hari."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — peningkatan penalaran dan instruksi."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 yang ringkas — lebih cepat dan lebih murah untuk tugas sederhana."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Model GPT-4 paling mumpuni, dioptimalkan untuk kecepatan dan biaya."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o ringan — lebih cepat dan lebih murah untuk tugas sederhana."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Pratinjau) — model Gemini paling canggih dengan konteks 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Pratinjau) — cepat dan efisien dengan konteks 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — model ringan berlatency rendah dengan konteks 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Model asisten yang dioptimalkan untuk suara internal."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto memilih model terbaik untuk permintaan Anda berdasarkan kapasitas dan kinerja."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Segera Hadir"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Preferensi perutean otomatis"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Atur bagaimana perute Otomatis menyeimbangkan trade-off saat memilih model untuk setiap giliran. Bobot dinormalisasi — yang penting adalah keseimbangan relatif."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Biaya"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Utamakan model yang lebih murah dengan biaya token lebih rendah."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Akurasi"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Utamakan model yang lebih kuat untuk penalaran kompleks."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Kecepatan"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Utamakan model yang lebih cepat dengan latensi lebih rendah."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Atur ulang ke default"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Waktu unggah file habis. Silakan coba lagi dalam beberapa menit."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Terjadi kesalahan. Berikut pesan kesalahan spesifik yang kami temui: Terjadi kesalahan saat memproses permintaan Anda. Asisten tidak lagi tersedia. Silakan hubungi Admin."},com_ui_code:{english:"Code",translated:"Kode"},com_ui_assistant_share:{english:"Share",translated:"Bagikan"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Link disalin"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Anda tidak memiliki akses ke asisten ini"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Gagal menyalin tautan ke papan klip"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Pratinjau tidak tersedia — pembuatan konten belum selesai."},com_ui_view_code:{english:"View code",translated:"Lihat kode"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Pratinjau tidak tersedia — konten tidak valid."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Nomor Telepon"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Alamat Email"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Kartu Kredit"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"SSN"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Upload memakan waktu lebih lama dari yang diharapkan - mencoba lagi ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Masalah koneksi - mencoba lagi ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Upload gagal - harap periksa koneksi Anda dan coba lagi"},com_assistants_memory_enabled:{english:"Memory",translated:"Memori"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Memori diaktifkan untuk asisten ini. Asisten dapat menyimpan dan mengingat fakta di berbagai percakapan."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Memori dinonaktifkan untuk asisten ini. Tidak ada fakta yang akan disimpan atau diingat di berbagai percakapan."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Harap jelaskan alasan bisnis Anda untuk menonaktifkan memori (wajib)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Harap berikan alasan untuk menonaktifkan memori."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Memori dinonaktifkan untuk tim Anda. Anda dapat melihat dan menghapus memori yang ada, tetapi tidak dapat menambahkan atau mengedit yang baru."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Menjalankan kode Anda"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"Mencari di basis pengetahuan"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Memproses 