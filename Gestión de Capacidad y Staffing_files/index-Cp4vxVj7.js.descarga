ix was used for General Assistants, Please use a different name.",translated:"Smart Prefix byl použit pro Obecné Asistenty, použijte jiný název."},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Pole pro popis nesmí být prázdné. Zadejte platný popis."},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Pole pro pokyny nesmí být prázdné. Zadejte platné pokyny."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Pole pro kategorii nesmí být prázdné. Vyberte kategorii."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Byl zjištěn duplicitní název asistenta. Zvolte jedinečný název."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Pole pro sdílení nesmí být prázdné. Vyberte možnost sdílení."},com_ui_shared_with:{english:"Shared With",translated:"Sdíleno s"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Soukromé – Pouze vy máte přístup a můžete tohoto asistenta zobrazit."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Sdílet pouze s týmem – Tento asistent bude viditelný a přístupný členům vašeho týmu."},com_ui_shared_with_team:{english:"Team",translated:"Tým"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Vyberte tým, ke kterému tento asistent patří. Zobrazí se pouze týmy, jejichž jste členem."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Pole tým nemůže být prázdné. Vyberte prosím tým."},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Tento asistent je uzamčen pro úpravy, protože je sdílen s týmem."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Chyba při načítání sdílených odkazů."},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Název vašeho asistenta obsahuje urážlivá slova a nemohl být odeslán. Aktualizujte prosím název asistenta."},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Váš popis obsahuje urážlivá slova a nemohl být odeslán. Aktualizujte prosím popis."},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Vaše instrukce obsahují urážlivá slova a nemohly být odeslány. Aktualizujte prosím instrukce."},com_ui_select_search_model:{english:"Search model by name",translated:"Vyhledat model podle názvu"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Vyhledat plugin podle názvu"},com_ui_use_prompt:{english:"Use prompt",translated:"Použít prompt"},com_ui_prev:{english:"Prev",translated:"Předchozí"},com_ui_next:{english:"Next",translated:"Další"},com_ui_stop:{english:"Stop",translated:"Zastavit"},com_ui_upload_files:{english:"Upload files",translated:"Nahrát soubory"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Šablony promptů"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Skrýt šablony promptů"},com_ui_showing:{english:"Showing",translated:"Zobrazeno"},com_ui_of:{english:"of",translated:"z"},com_ui_entries:{english:"Entries",translated:"Záznamy"},com_ui_none_selected:{english:"None selected",translated:"Nic není vybráno"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Soubor úspěšně nahrán"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Při nahrávání souboru došlo k chybě"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Neplatný soubor pro nahrání. Musí to být obrázek nepřesahující 2 MB"},com_ui_thinking:{english:"Thinking",translated:"Přemýšlím"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Analyzuji váš požadavek"},com_ui_processing:{english:"Putting it together",translated:"Zpracovávám"},com_ui_working_on_it:{english:"Almost ready",translated:"Pracuji na tom"},com_ui_cancel:{english:"Cancel",translated:"Zrušit"},com_ui_save:{english:"Save",translated:"Uložit"},com_user_message:{english:"You",translated:"Vy"},com_ui_read_aloud:{english:"Read aloud",translated:"Přečíst nahlas"},com_ui_copied:{english:"Copied!",translated:"Zkopírováno!"},com_ui_copy_code:{english:"Copy code",translated:"Kopírovat kód"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Kopírovat do schránky"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Zkopírováno do schránky"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Zmiňte koncový bod, asistenta nebo přednastavení pro rychlé přepnutí"},com_ui_regenerate:{english:"Regenerate",translated:"Znovu vygenerovat"},com_ui_edit:{english:"Edit",translated:"Upravit"},com_ui_all:{english:"all",translated:"vše"},com_ui_clear:{english:"Clear",translated:"Vymazat"},com_ui_import_conversation:{english:"Import",translated:"Importovat"},com_ui_nothing_found:{english:"Nothing found",translated:"Nic nenalezeno"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Přejít na konverzaci"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Importovat konverzace ze souboru JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Konverzace úspěšně importovány"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Při importu konverzací došlo k chybě"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Nepodporovaný typ importu"},com_ui_confirm_action:{english:"Confirm Action",translated:"Potvrdit akci"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Neznámý"},com_ui_result:{english:"Result",translated:"Výsledek"},com_ui_image_gen:{english:"Image Gen",translated:"Generování obrázků"},com_ui_assistant:{english:"Assistant",translated:"Asistent"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Asistent úspěšně smazán"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Při mazání asistenta došlo k chybě"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Byl zjištěn duplicitní soubor."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Při nahrávání souboru došlo k chybě."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Při nahrávání souboru došlo k chybě: Konec není definován"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Prázdné soubory nejsou povoleny."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Můžete nahrát maximálně {0} souborů najednou."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Můžete nahrát maximálně {0} souborů v této sekci."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Byl dosažen limit nahrávání pro {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Nelze určit typ souboru pro: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Typ souboru není podporován. Nahrajte prosím podporovaný formát souboru."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Nepodařilo se načíst obrázek"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Momentálně jsou podporovány pouze soubory JPEG, JPG, PNG a WEBP."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Velikost souboru přesahuje {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Celková velikost souborů nesmí přesáhnout {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Při ověřování souboru došlo k chybě."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Při zpracování souboru došlo k chybě."},com_ui_assistants:{english:"Assistants",translated:"Asistenti"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Studio Asistence"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Znalosti"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Nezařazeno"},com_ui_attachment:{english:"Attachment",translated:"Příloha"},com_ui_assistants_output:{english:"Assistants Output",translated:"Výstup asistentů"},com_ui_delete:{english:"Delete",translated:"Smazat"},com_ui_create:{english:"Create",translated:"Vytvořit"},com_ui_share:{english:"Share",translated:"Sdílet"},com_ui_copy_link:{english:"Copy link",translated:"Kopírovat odkaz"},com_ui_update_link:{english:"Update link",translated:"Aktualizovat odkaz"},com_ui_create_link:{english:"Create link",translated:"Vytvořit odkaz"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Sdílet odkaz do chatu"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"Při sdílení odkazu na chat došlo k chybě"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Vaše jméno a zprávy přidané po sdílení zůstanou soukromé."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"Veřejný odkaz na váš chat byl vytvořen. Sdílené chaty můžete kdykoli spravovat v Nastavení."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Vaše jméno, vlastní pokyny a zprávy přidané po sdílení zůstanou soukromé."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"Veřejný odkaz na váš chat byl aktualizován. Sdílené chaty můžete kdykoli spravovat v Nastavení."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Sdílený odkaz nebyl nalezen"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Smazat chat?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Tímto bude smazáno"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Opravdu chcete smazat tohoto asistenta? Toto nelze vrátit zpět."},com_ui_rename:{english:"Rename",translated:"Přejmenovat"},com_ui_more_options:{english:"More",translated:"Více"},com_ui_preview:{english:"Preview",translated:"Náhled"},com_ui_upload:{english:"Upload",translated:"Nahrát"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Nahrávání "{0}" trvá déle, než se očekávalo. Počkejte prosím, než se soubor dokončí indexování pro načtení.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Zásady ochrany osobních údajů"},com_ui_terms_of_service:{english:"Terms of service",translated:"Podmínky služby"},com_ui_use_micrphone:{english:"Use microphone",translated:"Použít mikrofon"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Nelze odstranit více hodnot, je vyžadováno minimálně {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Maximální povolený počet je {0}, používají se nejnovější hodnoty."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Nelze se přihlásit s poskytnutými údaji. Zkontrolujte prosím své přihlašovací údaje a zkuste to znovu."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Překročili jste počet povolených pokusů o přihlášení. Zkuste to prosím znovu za 15 minut."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Váš účet byl dočasně zablokován kvůli porušení našich podmínek."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Došlo k interní chybě serveru. Počkejte prosím několik okamžiků a zkuste to znovu."},com_auth_sign_in:{english:"Login",translated:"Přihlásit se"},com_endpoint_system_message:{english:"System Message",translated:"Systémová zpráva"},com_endpoint_message:{english:"Message",translated:"Zpráva"},com_endpoint_messages:{english:"Messages",translated:"Zprávy"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Upravte svou zprávu nebo regenerujte."},com_endpoint_default_blank:{english:"default: blank",translated:"výchozí: prázdné"},com_endpoint_default_false:{english:"default: false",translated:"výchozí: nepravda"},com_endpoint_default_creative:{english:"default: creative",translated:"výchozí: kreativní"},com_endpoint_default_empty:{english:"default: empty",translated:"výchozí: prázdné"},com_endpoint_default_with_num:{english:"default: {0}",translated:"výchozí: {0}"},com_endpoint_context:{english:"Context",translated:"Kontext"},com_endpoint_tone_style:{english:"Tone Style",translated:"Styl tónu"},com_endpoint_token_count:{english:"Token count",translated:"Počet tokenů"},com_endpoint_output:{english:"Output",translated:"Výstup"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Maximální počet kontextových tokenů"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Maximální počet tokenů, které lze použít pro kontext. Použijte to pro kontrolu, kolik tokenů je odesláno na požadavek.
  Pokud není uvedeno, použijí se systémové výchozí hodnoty na základě známých velikostí kontextu modelů. Nastavení vyšších hodnot může vést k chybám a/nebo vyšším nákladům na tokeny.`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Nastavte vlastní pokyny nebo kontext. Ignorováno, pokud je prázdné."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Přepisuje pokyny asistenta. Užitečné pro úpravu chování při každém spuštění."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Nastavte další pokyny nebo kontext nad hlavní pokyny asistenta. Ignorováno, pokud je prázdné."},com_endpoint_custom_name:{english:"Custom Name",translated:"Vlastní název"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Vlastní pokyny"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Další pokyny"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Přepsat pokyny"},com_endpoint_temperature:{english:"Temperature",translated:"Teplota"},com_endpoint_default:{english:"default",translated:"výchozí"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Maximální počet výstupních tokenů"},com_endpoint_stop:{english:"Stop Sequences",translated:"Stop sekvence"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Oddělte hodnoty stisknutím `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Volitelné pole `max_tokens`, představující maximální počet tokenů, které mohou být vygenerovány v dokončení chatu.\n\nCelková délka vstupních a generovaných tokenů je omezena délkou kontextu modelu. Můžete narazit na chyby, pokud toto číslo překročí maximální počet kontextových tokenů."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Vyšší hodnoty = více náhodné, nižší hodnoty = více zaměřené a deterministické. Doporučujeme měnit toto nebo Top P, ale ne obojí."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Maximální počet tokenů k vygenerování. Celková délka vstupních a generovaných tokenů je omezena délkou kontextu modelu."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Alternativa k vzorkování s teplotou, nazývaná nucleus sampling, kde model zvažuje výsledky tokenů s top_p pravděpodobnostní masou. Takže 0.1 znamená, že se zvažují pouze tokeny tvořící top 10% pravděpodobnostní masy. Doporučujeme měnit toto nebo teplotu, ale ne obojí."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Číslo mezi 0 a 2.0. Pozitivní hodnoty penalizují nové tokeny na základě jejich stávající frekvence v textu, čímž snižují pravděpodobnost modelu opakovat stejnou větu doslovně."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Číslo mezi 0 a 2.0. Pozitivní hodnoty penalizují nové tokeny na základě toho, zda se objevují v textu, čímž zvyšují pravděpodobnost modelu hovořit o nových tématech."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Znovu odeslat všechny dříve připojené soubory. Poznámka: to zvýší náklady na tokeny a můžete narazit na chyby s mnoha přílohami."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Rozlišení pro Vision požadavky. "Nízké" je levnější a rychlejší, "Vysoké" je podrobnější a dražší, a "Auto" automaticky vybere mezi těmito dvěma na základě rozlišení obrázku.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Až 4 sekvence, kde API přestane generovat další tokeny."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Nastavte vlastní název pro iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Nastavte vlastní pokyny k zahrnutí do systémové zprávy. Výchozí: žádné"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Penalizace frekvence"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Postih za přítomnost"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Použít funkce"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Znovu odeslat soubory"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Detail obrázku"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Přeskočit dokončení"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Nastavit vlastní instrukce pro zahrnutí do systémové zprávy. Výchozí: žádné"},com_endpoint_import:{english:"Import",translated:"Importovat"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Nastavit vlastní název, pokud můžete tento přednastavení najít"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Opravdu chcete smazat toto přednastavení?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Přednastavení importováno!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Při importu vašeho přednastavení došlo k chybě. Zkuste to prosím znovu."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Při ukládání vašeho přednastavení došlo k chybě. Zkuste to prosím znovu."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Při mazání vašeho přednastavení došlo k chybě. Zkuste to prosím znovu."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"již není výchozím přednastavením."},com_endpoint_preset_default_item:{english:"Default:",translated:"Výchozí:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Žádné aktivní výchozí přednastavení."},com_endpoint_preset_title:{english:"Preset",translated:"Přednastavení"},com_endpoint_preset_saved:{english:"Saved!",translated:"Uloženo!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"je nyní výchozím přednastavením."},com_endpoint_preset:{english:"preset",translated:"přednastavení"},com_endpoint_presets:{english:"presets",translated:"přednastavení"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Aktivní!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Název přednastavení"},com_endpoint:{english:"Endpoint",translated:"Koncový bod"},com_endpoint_examples:{english:" Presets",translated:"Přednastavení"},com_endpoint_export:{english:"Export",translated:"Exportovat"},com_endpoint_export_share:{english:"Export/Share",translated:"Exportovat/Sdílet"},com_endpoint_assistant:{english:"Assistant",translated:"Asistent"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Použít aktivního asistenta"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Uložit jako přednastavení"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Opravdu chcete vymazat všechna přednastavení? Toto je nevratné."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Žádná přednastavení, použijte tlačítko nastavení k vytvoření"},com_endpoint_my_preset:{english:"My Preset",translated:"Moje přednastavení"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Model agenta (Doporučeno: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Model dokončení (Doporučeno: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Povolit použití pluginů jako funkcí OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Povolit přeskočení kroku dokončení, který kontroluje konečnou odpověď a generované kroky"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Vyberte asistenta a začněte nový chat"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Nastavte svůj klíč v nabídce Hlavička pro chat."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Vyberte asistenta"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Vítejte v iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Text na řeč"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Automatické přehrávání poslední zprávy"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Řeč na text"},com_nav_profile_picture:{english:"Profile Picture",translated:"Profilový obrázek"},com_nav_change_picture:{english:"Change picture",translated:"Změnit obrázek"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Zobrazit nastavení agenta"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Zobrazit nastavení dokončení"},com_hide_examples:{english:"Hide Examples",translated:"Skrýt příklady"},com_show_examples:{english:"Show Examples",translated:"Zobrazit příklady"},com_nav_export_filename:{english:"Filename",translated:"Název souboru"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Nastavte název souboru"},com_nav_export_type:{english:"Type",translated:"Typ"},com_nav_export_conversation:{english:"Export conversation",translated:"Exportovat konverzaci"},com_nav_export:{english:"Export",translated:"Exportovat"},com_nav_shared_links:{english:"Shared links",translated:"Sdílené odkazy"},com_nav_shared_links_manage:{english:"Manage",translated:"Spravovat"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Nemáte žádné sdílené odkazy."},com_nav_shared_links_name:{english:"Name",translated:"Název"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Datum sdílení"},com_nav_source_chat:{english:"View source chat",translated:"Zobrazit zdrojový chat"},com_nav_my_files:{english:"File Manager",translated:"Správce souborů"},com_nav_admin_center:{english:"Admin Center",translated:"Centrum správy"},com_nav_theme:{english:"Theme",translated:"Téma"},com_nav_theme_system:{english:"System",translated:"Systém"},com_nav_theme_dark:{english:"Dark",translated:"Tmavé"},com_nav_theme_light:{english:"Light",translated:"Světlé"},com_nav_user_name_display:{english:"Display username in messages",translated:"Zobrazit uživatelské jméno ve zprávách"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Vymazat všechny chaty"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Potvrdit vymazání"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Zavřít postranní panel"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Otevřít postranní panel"},com_nav_send_message:{english:"Send message",translated:"Odeslat zprávu"},com_nav_log_out:{english:"Log out",translated:"Odhlásit se"},com_nav_user:{english:"USER",translated:"UŽIVATEL"},com_nav_archived_chats:{english:"Archived chats",translated:"Archivované chaty"},com_nav_archived_chats_manage:{english:"Manage",translated:"Spravovat"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Nemáte žádné archivované konverzace."},com_nav_archive_name:{english:"Name",translated:"Název"},com_nav_archive_created_at:{english:"DateCreated",translated:"Datum vytvoření"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Vymazat konverzace"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Opravdu chcete vymazat všechny konverzace? Toto je nevratné."},com_nav_help:{english:"Help",translated:"Nápověda"},com_nav_user_guide:{english:"User Guide",translated:"Uživatelská příručka"},com_nav_settings:{english:"Settings",translated:"Nastavení"},com_nav_search_placeholder:{english:"Search messages",translated:"Hledat zprávy"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Automaticky odeslat text (po 3 sek.)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Chyba při přehrávání zvuku: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Chyba při zpracování zvuku: {0}"},com_nav_engine:{english:"Engine",translated:"Stroj"},com_nav_browser:{english:"Browser",translated:"Prohlížeč"},com_nav_external:{english:"External",translated:"Externí"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Smazat úložiště cache"},com_nav_voice_select:{english:"Voice",translated:"Hlas"},com_nav_setting_general:{english:"General",translated:"Obecné"},com_nav_setting_speech:{english:"Speech",translated:"Řeč"},com_nav_language:{english:"Language",translated:"Jazyk"},com_nav_lang_auto:{english:"Auto detect",translated:"Automaticky detekovat"},com_page_not_found:{english:"Page not found",translated:"Stránka nenalezena"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Něco se pokazilo"},com_unauthorized_access:{english:"Unauthorized access",translated:"Neoprávněný přístup"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Neoprávněný přístup. Přístup je omezen na specifické domény."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Váš účet byl dočasně zablokován kvůli porušení našich služeb"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Máte omezený přístup k aplikaci mimo síť!"},com_support_ticket_text:{english:"Support Ticket",translated:"Podpora - lístek"},com_help_dialog_Header:{english:"Need assistance?",translated:"Potřebujete pomoc?"},com_help_dialog_text_1_1:{english:"Click",translated:"Klikněte"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"pro podrobné pokyny"},com_help_dialog_text_here:{english:"here",translated:"zde"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Pro problémy vyplňte"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Pro problémy kontaktujte"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Najděte kroky"},com_status_ind_none:{english:"Operational",translated:"Funguje"},com_status_ind_minor:{english:"Minor Issues",translated:"Menší problémy"},com_status_ind_major:{english:"Major Issues",translated:"Větší problémy"},com_status_ind_critical:{english:"Critical",translated:"Kritické"},com_status_ind_error:{english:"Error Fetching",translated:"Chyba načítání"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Upozorňujeme, že při opuštění chatu nebo zahájení nového chatu ztratíte historii konverzace."},com_forbidden_access:{english:"Forbidden access",translated:"Zakázaný přístup"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Zásady přijatelného užívání"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Zásady ochrany osobních údajů"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Smlouva o předplatném"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Před použitím iX Hello si můžete přečíst "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Registrací a/nebo vstupem souhlasíte s výše uvedenými podmínkami."},com_login_page_and:{english:"and ",translated:"a "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Žádní připnutí asistenti"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Připnutí asistenti"},com_ui_loading:{english:"Loading...",translated:"Načítání..."},com_ui_unpin:{english:"Unpin",translated:"Odepnout"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Asistent úspěšně odepnut"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Chyba při odepnutí asistenta"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Asistent úspěšně připnut"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Chyba při připnutí/odepnutí asistenta"},com_ui_pin:{english:"Pin",translated:"Připnout"},come_create_assistant:{english:"Create Assistant",translated:"Vytvořit asistenta"},come_edit_assistant:{english:"Edit Assistant",translated:"Upravit asistenta"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Opravdu chcete pokračovat? Tímto dojde ke ztrátě všech změn provedených na asistentovi, kterého právě upravujete nebo vytváříte. Tuto akci nelze vrátit zpět."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Asistent s ID {0} nebyl nalezen."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Prohlížeč nepodporuje rozpoznávání řeči"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Povolení pro mikrofon nebylo uděleno"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Chyba při zahájení nahrávání: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder nenahrává"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder není v tomto prohlížeči podporován"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Vaše zpráva obsahuje osobní informace a nemohla být odeslána. Odstraňte prosím veškeré osobní údaje."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Nepodařilo se přejmenovat konverzaci"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Zbývá vám {0} z přidělených tokenů."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello může udělat chyby. Prosím, zkontrolujte všechny výstupy pro kvalitu a přesnost. Všechny vstupy jsou zaznamenávány pro dodržování předpisů."},com_ui_assistant_group_by:{english:"Group by",translated:"Seskupit podle"},com_ui_assistant_category:{english:"Category",translated:"Kategorie"},com_ui_assistant_team:{english:"Team",translated:"Tým"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Inženýrství"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Inteligence"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Provoz"},com_ui_assistant_sales:{english:"Sales",translated:"Prodej"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategie"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Asistenti studia"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Nahrajte obrázek avatara (PNG nebo JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Hledat online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Procházet web"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Generovat obrázky"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Počítat matematiku"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Výchozí nástroj"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Nahrávání souboru trvá déle, než se očekávalo. Zkuste to znovu."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Chyba při připnutí asistenta"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Při mazání sdíleného odkazu došlo k chybě"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Šablona DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Žádný výchozí přednastavený není aktivní."},com_ui_drag_drop_title:{english:"Add anything",translated:"Přidejte cokoliv"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Přetáhněte jakýkoliv soubor sem pro přidání do konverzace"},com_ui_analyzing:{english:"Analyzing",translated:"Analyzuji"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Analýza dokončena"},com_ui_warning:{english:"Warning",translated:"Varování"},com_ui_proceed:{english:"Proceed",translated:"Pokračovat"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Soubory nahrané k asistentovi jsou použity pouze pro konverzační účely. Uživatelé mohou přistupovat k obsahu těchto souborů pomocí relevantních dotazů, ale přímé stažení souborů není povoleno."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Nastavte vlastní název pro tento přednastavený"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Nastavte příklad vstupu. Příklad je ignorován, pokud je prázdný."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Nastavte příklad výstupu. Příklad je ignorován, pokud je prázdný."},com_nav_export_select_type:{english:"Select a file type",translated:"Vyberte typ souboru"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"snímek obrazovky (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"text (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Nebyla přijata žádná odpověď. Zkuste prosím znovu odeslat svou zprávu. Pokud problém přetrvává i po obnovení stránky a opětovném pokusu, kontaktujte podporu."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Zpět na chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Moderace Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Moderace Guardrail je pro tohoto asistenta povolena. Obsah bude kontrolován podle moderovacích zásad."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Zakázání moderace Guardrail odstraní kontroly moderace obsahu pro tohoto asistenta. Jste odpovědní za dodržování obsahových zásad vaší organizace. Aktivita je plně zaznamenávána a monitorována."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Uveďte prosím obchodní zdůvodnění pro zakázání moderace Guardrail (povinné)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Uveďte prosím zdůvodnění pro zakázání moderace Guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Povolit uživatelům změnit model v chatu"},com_ui_feedback_good:{english:"Good response",translated:"Dobrá odpověď"},com_ui_feedback_bad:{english:"Poor response",translated:"Špatná odpověď"},com_ui_feedback_comments:{english:"Comments",translated:"Komentáře"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Komentáře (volitelné)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Řekněte nám více o svých zkušenostech..."},com_ui_feedback_submit:{english:"Submit",translated:"Odeslat"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Nepodařilo se odeslat vaši zpětnou vazbu"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Nesprávné"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Není relevantní"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Zastaralé"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Nedostatek podrobností"},com_ui_feedback_reason_other:{english:"Other",translated:"Jiné"},com_ui_model_recommended:{english:"Recommended",translated:"Doporučeno"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Zastaralé — prosím aktualizujte"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Tento model již není podporován. Vyberte aktuální model."},com_nav_setting_memory:{english:"Memory",translated:"Paměť"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Spravujte osobní údaje, které si asistent pamatuje napříč konverzacemi."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Přidat novou paměť…"},com_nav_memory_add_button:{english:"Add memory",translated:"Přidat paměť"},com_nav_memory_category:{english:"Category",translated:"Kategorie"},com_nav_memory_category_preference:{english:"Preference",translated:"Preference"},com_nav_memory_category_identity:{english:"Identity",translated:"Identita"},com_nav_memory_category_context:{english:"Context",translated:"Kontext"},com_nav_memory_category_project:{english:"Project",translated:"Projekt"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Žádné paměti zatím nejsou"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Uložené paměti se zde objeví a pomohou personalizovat budoucí konverzace."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Nepodařilo se načíst paměti. Zkuste to prosím znovu."},com_nav_memory_retry:{english:"Retry",translated:"Zkusit znovu"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Nepodařilo se přidat paměť. Zkuste to prosím znovu."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Nepodařilo se aktualizovat paměť. Zkuste to prosím znovu."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Nepodařilo se smazat paměť. Zkuste to prosím znovu."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Smazat tuto paměť?"},com_nav_memory_delete_button:{english:"Delete",translated:"Smazat"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Upravit paměť"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Smazat paměť"},com_nav_memory_save:{english:"Save",translated:"Uložit"},com_nav_memory_cancel:{english:"Cancel",translated:"Zrušit"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Uloženo {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — nejnovější myšlenkový model GPT-5 s pokročilou inteligencí."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — kompaktní a nákladově efektivní varianta GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — nejnovější model generace GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Nejnovější Opus — špičková inteligence pro kódovací agenty a podnikové pracovní postupy."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Nejnovější Opus — špičková inteligence pro kódovací agenty a podnikové pracovní postupy."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Vylepšený Sonnet s lepším uvažováním a následováním pokynů."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Nejvýkonnější model Anthropic pro složité, vícestupňové úkoly."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Vyvážená inteligence a rychlost pro širokou škálu úkolů."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Nejrychlejší a nejkompaktnější model Claude — ideální pro úkoly s vysokou propustností."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — vylepšené uvažování a multimodální schopnosti."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Vlajkový model nové generace od OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"Lehký GPT-5 — efektivní a rychlý pro každodenní úkoly."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — vylepšené následování pokynů a uvažování."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"Kompaktní GPT-4.1 — rychlejší a levnější pro jednodušší úkoly."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Nejvýkonnější model GPT-4, optimalizovaný pro rychlost a náklady."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"Lehký GPT-4o — rychlejší a levnější pro jednodušší úkoly."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Preview) — nejvýkonnější model Gemini s kontextem 1M tokenů."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Preview) — rychlý a efektivní s kontextem 1M tokenů."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — lehký model s nízkou latencí a kontextem 1M tokenů."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Interní model optimalizovaný pro hlasové asistenty."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto vybere nejlepší model pro váš požadavek na základě kapacity a výkonu."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Již brzy"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Předvolby automatického směrování"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Nastavte, jak automatický směrovač vyvažuje kompromisy při výběru modelu pro každý krok. Váhy jsou normalizované — důležitý je jejich vzájemný poměr."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Cena"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Upřednostnit levnější modely s nižší cenou tokenů."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Přesnost"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Upřednostnit výkonnější modely pro složité uvažování."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Rychlost"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Upřednostnit rychlejší modely s nižší latencí."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Obnovit výchozí nastavení"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Nahrávání souboru vypršelo. Zkuste to prosím znovu za několik minut."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Něco se pokazilo. Zde je konkrétní chybová zpráva, na kterou jsme narazili: Při zpracování vašeho požadavku došlo k chybě. Asistent již není k dispozici. Kontaktujte prosím správce."},com_ui_code:{english:"Code",translated:"Kód"},com_ui_assistant_share:{english:"Share",translated:"Sdílet"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Odkaz zkopírován"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"K tomuto asistentovi nemáte přístup"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Nepodařilo se zkopírovat odkaz do schránky"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Náhled není k dispozici — generování obsahu nebylo dokončeno."},com_ui_view_code:{english:"View code",translated:"Zobrazit kód"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Náhled není k dispozici — obsah je neplatný."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Telefonní číslo"},com_assistants_pii_entity_email:{english:"Email Address",translated:"E-mailová adresa"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Kreditní karta"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"Rodné číslo"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Nahrávání trvá déle, než se očekávalo – opakuji pokus ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Problém s připojením – opakuji pokus ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Nahrávání se nezdařilo – zkontrolujte připojení a zkuste to znovu"},com_assistants_memory_enabled:{english:"Memory",translated:"Paměť"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Paměť je pro tohoto asistenta zapnutá. Asistent může ukládat a vybavovat si fakta napříč konverzacemi."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Paměť je pro tohoto asistenta vypnutá. Žádná fakta se nebudou ukládat ani vybavovat napříč konverzacemi."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification 