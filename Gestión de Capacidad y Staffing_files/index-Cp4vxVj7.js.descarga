nown:"Nu se poate determina tipul fișierului pentru: {0}",com_ui_assistant_file_upload_unsupported_type:"Tipul de fișier nu este suportat. Vă rugăm să încărcați un format de fișier acceptat.",com_ui_assistant_image_failed_load:"Încărcarea imaginii a eșuat",com_ui_assistant_file_upload_supported_type:"În prezent, sunt acceptate doar fișiere JPEG, JPG, PNG și WEBP.",com_ui_assistant_file_upload_size_limit:"Dimensiunea fișierului depășește {0} MB.",com_ui_assistant_file_upload_total_size_limit:"Dimensiunea totală a fișierelor nu poate depăși {0} MB.",com_ui_assistant_file_validation_error:"A apărut o eroare la validarea fișierului.",com_ui_assistant_file_processing_error:"A apărut o eroare la procesarea fișierului.",com_ui_assistants:"Asistenți",com_ui_assistants_category_ix_customer:"Asistență Studio",com_ui_assistants_category_kbot:"Cunoștințe",com_ui_assistants_uncategorized:"Necategorizat",com_ui_attachment:"Atașament",com_ui_assistants_output:"Rezultatul asistenților",com_ui_delete:"Șterge",com_ui_create:"Creează",com_ui_share:"Distribuie",com_ui_copy_link:"Copiază link",com_ui_update_link:"Actualizează link",com_ui_create_link:"Creează link",com_ui_share_link_to_chat:"Distribuie link în chat",com_ui_share_error:"A apărut o eroare la partajarea linkului de chat",com_ui_share_create_message:"Numele tău și orice mesaje adăugate după partajare rămân private.",com_ui_share_created_message:"Un link public către chatul tău a fost creat. Gestionează chaturile partajate anterior oricând prin Setări.",com_ui_share_update_message:"Numele tău, instrucțiunile personalizate și orice mesaje adăugate după partajare rămân private.",com_ui_share_updated_message:"Un link public către chatul tău a fost actualizat. Gestionează chaturile partajate anterior oricând prin Setări.",com_ui_shared_link_not_found:"Linkul partajat nu a fost găsit",com_ui_delete_conversation:"Șterge chat?",com_ui_delete_conversation_confirm:"Acest lucru va șterge",com_ui_delete_assistant_confirm:"Ești sigur că vrei să ștergi acest asistent? Aceasta nu poate fi anulată.",com_ui_rename:"Redenumește",com_ui_more_options:"Mai multe",com_ui_preview:"Previzualizare",com_ui_upload:"Încarcă",com_ui_upload_delay:'Încărcarea "{0}" durează mai mult decât anticipat. Vă rugăm să așteptați în timp ce fișierul finalizează indexarea pentru recuperare.',com_ui_privacy_policy:"Politica de confidențialitate",com_ui_terms_of_service:"Termeni de serviciu",com_ui_use_micrphone:"Folosește microfonul",com_ui_min_tags:"Nu se pot elimina mai multe valori, sunt necesare minimum {0}.",com_ui_max_tags:"Numărul maxim permis este {0}, folosind ultimele valori.",com_auth_error_login:"Nu se poate conecta cu informațiile furnizate. Verificați datele de autentificare și încercați din nou.",com_auth_error_login_rl:"Ați depășit numărul de încercări de autentificare permise. Încercați din nou peste 15 minute.",com_auth_error_login_ban:"Contul dvs. a fost suspendat temporar din cauza încălcării serviciului nostru.",com_auth_error_login_server:"A apărut o eroare internă a serverului. Așteptați câteva momente și încercați din nou.",com_auth_sign_in:"Autentificare",com_endpoint_system_message:"Mesaj de sistem",com_endpoint_message:"Mesaj",com_endpoint_messages:"Mesaje",com_endpoint_message_not_appendable:"Editați mesajul sau Regenerați.",com_endpoint_default_blank:"implicit: gol",com_endpoint_default_false:"implicit: fals",com_endpoint_default_creative:"implicit: creativ",com_endpoint_default_empty:"implicit: gol",com_endpoint_default_with_num:"implicit: {0}",com_endpoint_context:"Context",com_endpoint_tone_style:"Stil tonal",com_endpoint_token_count:"Număr de tokeni",com_endpoint_output:"Rezultat",com_endpoint_context_tokens:"Maxim tokeni context",com_endpoint_context_info:"Numărul maxim de tokeni care pot fi folosiți pentru context. Folosiți acest lucru pentru a controla câți tokeni sunt trimiși per cerere. Dacă nu este specificat, se vor folosi valorile implicite ale sistemului bazate pe dimensiunea contextului modelelor cunoscute. Setarea unor valori mai mari poate duce la erori și/sau costuri mai mari de tokeni.",com_endpoint_prompt_prefix_placeholder:"Setați instrucțiuni sau context personalizat. Ignorat dacă este gol.",com_endpoint_instructions_assistants_placeholder:"Suprascrie instrucțiunile asistentului. Util pentru modificarea comportamentului pe fiecare rulare.",com_endpoint_prompt_prefix_assistants_placeholder:"Setează instrucțiuni sau context suplimentar peste instrucțiunile principale ale asistentului. Ignorat dacă este gol.",com_endpoint_custom_name:"Nume Personalizat",com_endpoint_prompt_prefix:"Instrucțiuni Personalizate",com_endpoint_prompt_prefix_assistants:"Instrucțiuni Suplimentare",com_endpoint_instructions_assistants:"Suprascrie Instrucțiunile",com_endpoint_temperature:"Temperatură",com_endpoint_default:"implicit",com_endpoint_top_p:"Top P",com_endpoint_top_k:"Top K",com_endpoint_max_output_tokens:"Maxim Tokeni de Ieșire",com_endpoint_stop:"Secvențe de Oprire",com_endpoint_stop_placeholder:"Separă valorile apăsând `Enter`",com_endpoint_openai_max_tokens:"Câmp opțional `max_tokens`, reprezentând numărul maxim de tokeni care pot fi generați în completarea chatului.\n\nLungimea totală a tokenilor de intrare și a celor generați este limitată de lungimea contextului modelului. Pot apărea erori dacă acest număr depășește numărul maxim de tokeni de context.",com_endpoint_openai_temp:"Valori mai mari = mai aleatoriu, în timp ce valori mai mici = mai concentrat și determinist. Recomandăm modificarea acestuia sau a Top P, dar nu ambele.",com_endpoint_openai_max:"Numărul maxim de tokeni de generat. Lungimea totală a tokenilor de intrare și a celor generați este limitată de lungimea contextului modelului.",com_endpoint_openai_topp:"O alternativă la eșantionarea cu temperatură, numită eșantionare de nucleu, unde modelul ia în considerare rezultatele tokenilor cu masa de probabilitate top_p. Astfel, 0.1 înseamnă că sunt luați în considerare doar tokenii care cuprind masa de probabilitate de top 10%. Recomandăm modificarea acestuia sau a temperaturii, dar nu ambele.",com_endpoint_openai_freq:"Număr între 0 și 2.0. Valorile pozitive penalizează noii tokeni pe baza frecvenței lor existente în text până acum, reducând probabilitatea modelului de a repeta aceeași linie textuală.",com_endpoint_openai_pres:"Număr între 0 și 2.0. Valorile pozitive penalizează noii tokeni pe baza apariției lor în text până acum, crescând probabilitatea modelului de a discuta despre subiecte noi.",com_endpoint_openai_resend_files:"Retrimite toate fișierele atașate anterior. Notă: aceasta va crește costul tokenilor și pot apărea erori cu multe atașamente.",com_endpoint_openai_detail:'Rezoluția pentru cererile Vision. "Low" este mai ieftin și mai rapid, "High" este mai detaliat și costisitor, iar "Auto" va alege automat între cele două în funcție de rezoluția imaginii.',com_endpoint_openai_stop:"Până la 4 secvențe unde API-ul va opri generarea de tokeni suplimentari.",com_endpoint_openai_custom_name_placeholder:"Setează un nume personalizat pentru iXHello",com_endpoint_openai_prompt_prefix_placeholder:"Setează instrucțiuni personalizate pentru a fi incluse în Mesajul Sistemului. Implicit: niciunul",com_endpoint_frequency_penalty:"Penalizare Frecvență",com_endpoint_presence_penalty:"Penalizare Prezență",com_endpoint_plug_use_functions:"Folosește Funcții",com_endpoint_plug_resend_files:"Retrimite Fișiere",com_endpoint_plug_image_detail:"Detalii Imagine",com_endpoint_plug_skip_completion:"Sari Peste Finalizare",com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:"Setează instrucțiuni personalizate pentru a include în Mesajul Sistemului. Implicit: niciuna",com_endpoint_import:"Importă",com_endpoint_set_custom_name:"Setează un nume personalizat, în caz că poți găsi acest preset",com_endpoint_preset_delete_confirm:"Ești sigur că vrei să ștergi acest preset?",com_endpoint_preset_import:"Preset Importat!",com_endpoint_preset_import_error:"A apărut o 