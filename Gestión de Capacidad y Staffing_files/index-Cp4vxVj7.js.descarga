tant_tools_completed_generate_image:"Đã tạo hình ảnh",com_ui_assistant_tools_completed_calculate_math:"Đã tính toán xong",com_ui_assistant_tools_completed_codeexecutor:"Đã chạy mã của bạn xong",com_ui_assistant_tools_completed_rag_query:"Đã tìm kiếm trong cơ sở kiến thức xong",com_ui_assistant_tools_completed_voiceworx:"Đã xử lý đầu vào giọng nói xong",com_ui_assistant_tools_completed_memory_store:"Đã lưu vào bộ nhớ",com_ui_assistant_tools_completed_memory_delete:"Đã xóa khỏi bộ nhớ",com_ui_assistant_tools_completed_fallback:"Đã hoàn tất: {0}",com_ui_still_working:"vẫn đang xử lý...",com_assistants_pii_entity_phone:"Số điện thoại",com_assistants_pii_entity_email:"Địa chỉ email",com_assistants_pii_entity_credit_card:"Thẻ tín dụng",com_assistants_pii_entity_ssn:"SSN",com_assistants_memory_enabled:"Bộ nhớ",com_assistants_memory_enabled_info:"Bộ nhớ đã được bật cho trợ lý này. Trợ lý có thể lưu trữ và ghi nhớ thông tin qua các cuộc trò chuyện.",com_assistants_memory_disabled_info:"Bộ nhớ đã được tắt cho trợ lý này. Sẽ không có thông tin nào được lưu trữ hoặc ghi nhớ qua các cuộc trò chuyện.",com_assistants_memory_enabled_off_reason_placeholder:"Vui lòng giải thích lý do nghiệp vụ của bạn khi tắt bộ nhớ (bắt buộc).",com_assistants_memory_enabled_reason_required:"Vui lòng cung cấp lý do khi tắt bộ nhớ.",com_nav_memory_team_disabled:"Bộ nhớ đã bị tắt cho nhóm của bạn. Bạn có thể xem và xóa các bộ nhớ hiện có, nhưng không thể thêm hoặc chỉnh sửa bộ nhớ mới.",com_ui_file_ready:"{0} đã sẵn sàng",com_ui_file_ready_fallback:"Tệp đã sẵn sàng",com_ui_file_processing_failed:"Không thể xử lý {0}",com_ui_file_processing_failed_fallback:"Không thể xử lý tệp",com_ui_file_processing_failed_reupload:"Không thể xử lý {0}. Vui lòng tải lại tệp.",com_ui_file_processing_failed_reupload_fallback:"Không thể xử lý tệp. Vui lòng tải lại tệp.",com_ui_file_processing:"Đang xử lý...",com_ui_file_processing_failed_status:"Xử lý thất bại",com_ui_file_processing_failed_reupload_required:"Thất bại - cần tải lên lại",com_ui_file_retry:"Thử lại",com_ui_file_retry_in:"Thử lại sau {0} giây",com_ui_file_indexing_retrying:"Đang thử lại lập chỉ mục tệp...",com_ui_file_retry_wait:"Vui lòng đợi {0} giây trước khi thử lại",com_ui_file_retries_exhausted_reupload:"Đã đạt số lần thử lại tối đa. Vui lòng tải lên lại tệp.",com_ui_assistant_file_upload_invalid_json:"Tệp JSON không hợp lệ. Nội dung tệp không khớp với định dạng mong đợi."},zb={com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Bạn đã đạt đến giới hạn sử dụng hàng tháng. Vui lòng liên hệ với quản trị viên nhóm để được hỗ trợ."},com_ui_examples:{english:"Examples",translated:"Ví dụ"},com_ui_new_chat:{english:"New chat",translated:"Trò chuyện mới"},com_ui_conversations:{english:"Chats",translated:"Cuộc trò chuyện"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"Bắt đầu cuộc trò chuyện..."},com_ui_new_conversation:{english:"New Chat",translated:"Cuộc trò chuyện mới"},com_ui_assistant_library:{english:"Assistant Library",translated:"Thư viện Trợ lý"},com_ui_assistant_search:{english:"Search for an assistant",translated:"Tìm kiếm trợ lý"},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"Giải thích máy tính lượng tử theo cách đơn giản"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"Có ý tưởng sáng tạo nào cho sinh nhật của một đứa trẻ 10 tuổi không?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"Làm thế nào để thực hiện yêu cầu HTTP trong Javascript?"},com_ui_capabilities:{english:"Capabilities",translated:"Khả năng"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"Ghi nhớ những gì người dùng nói trước đó trong cuộc trò chuyện"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Cho phép người dùng cung cấp sự sửa đổi tiếp theo"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Được đào tạo để từ chối các yêu cầu không thích hợp"},com_ui_limitations:{english:"Limitations",translated:"Hạn chế"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Có thể đôi khi tạo ra thông tin không chính xác"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Có thể đôi khi tạo ra hướng dẫn gây hại hoặc nội dung thiên vị"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Kiến thức hạn chế về thế giới và sự kiện sau năm 2021"},com_ui_input:{english:"Input",translated:"Đầu vào"},com_ui_close:{english:"Close",translated:"Đóng"},com_ui_model:{english:"Model",translated:"Mô hình"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Tên không được để trống"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:'Tên không được bắt đầu bằng "smart"'},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Mô tả không được để trống"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Hướng dẫn không được để trống"},com_ui_category:{english:"Category",translated:"Category"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Assign a business category to help filter and organize assistants by function."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Trường danh mục không được để trống. Vui lòng chọn một danh mục"},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Tên trợ lý đã tồn tại"},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Chia sẻ với không được để trống"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Tên không được chứa từ tục tĩu"},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Mô tả không được chứa từ tục tĩu"},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Hướng dẫn không được chứa từ tục tĩu"},com_ui_shared_with:{english:"Shared With",translated:"Chia sẻ với"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Private – Only you can access and view this assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Share only with Team – This assistant will be visible and accessible to your team members."},com_ui_shared_with_team:{english:"Team",translated:"Chia sẻ với nhóm"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Chia sẻ với nhóm không được để trống"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Trợ lý này bị khóa chỉnh sửa vì được chia sẻ với nhóm."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Lỗi tải liên kết chia sẻ."},com_ui_use_prompt:{english:"Use prompt",translated:"Sử dụng gợi ý"},com_ui_prev:{english:"Prev",translated:"Trước"},com_ui_next:{english:"Next",translated:"Tiếp theo"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Mẫu gợi ý"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Ẩn mẫu gợi ý"},com_ui_showing:{english:"Showing",translated:"Hiển thị"},com_ui_of:{english:"of",translated:"của"},com_ui_entries:{english:"Entries",translated:"mục"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Tải tệp thành công"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Tệp không hợp lệ để tải lên"},com_ui_cancel:{english:"Cancel",translated:"Hủy"},com_ui_save:{english:"Save",translated:"Lưu"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Sao chép vào clipboard"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Đã sao chép vào clipboard"},com_ui_regenerate:{english:"Regenerate",translated:"Tạo lại"},com_ui_edit:{english:"Edit",translated:"Sửa"},com_ui_all:{english:"all",translated:"tất cả"},com_ui_clear:{english:"Clear",translated:"Xóa"},com_ui_import_conversation:{english:"Import",translated:"Nhập khẩu"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Nhập khẩu cuộc trò chuyện từ một tệp JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Đã nhập khẩu cuộc trò chuyện thành công"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Đã xảy ra lỗi khi nhập khẩu cuộc trò chuyện của bạn"},com_ui_confirm_action:{english:"Confirm Action",translated:"Xác nhận hành động"},com_ui_share:{english:"Share",translated:"Share"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Share link to chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"There was an error sharing the chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Your name and any messages you add after sharing stay private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been created. Manage previously shared chats at any time via Settings."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Your name, custom instructions, and any messages you add after sharing stay private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Shared link not found"},com_ui_delete:{english:"Delete",translated:"Xóa"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Xóa cuộc trò chuyện?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Điều này sẽ xóa"},com_ui_rename:{english:"Rename",translated:"Đổi tên"},com_ui_more_options:{english:"More",translated:"Thêm"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Tìm kiếm tệp đã sử dụng"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Không thể đăng nhập với thông tin được cung cấp. Vui lòng kiểm tra thông tin đăng nhập và thử lại."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Quá nhiều lần đăng nhập trong một khoảng thời gian ngắn. Vui lòng thử lại sau."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Tài khoản của bạn đã bị khóa tạm thời do vi phạm dịch vụ của chúng tôi."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Đã xảy ra lỗi máy chủ nội bộ. Vui lòng đợi một vài phút và thử lại."},com_auth_sign_in:{english:"Login",translated:"Đăng nhập"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:""}},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:""}},com_endpoint_system_message:{english:"System Message",translated:"Thông điệp hệ thống"},com_endpoint_default_blank:{english:"default: blank",translated:"mặc định: trống"},com_endpoint_default_false:{english:"default: false",translated:"mặc định: sai"},com_endpoint_default_creative:{english:"default: creative",translated:"mặc định: sáng tạo"},com_endpoint_default_empty:{english:"default: empty",translated:"mặc định: trống rỗng"},com_endpoint_default_with_num:{english:"default: {0}",translated:"mặc định: {0}"},com_endpoint_context:{english:"Context",translated:"Ngữ cảnh"},com_endpoint_tone_style:{english:"Tone Style",translated:"Phong cách nét"},com_endpoint_token_count:{english:"Token count",translated:"Số mã thông báo"},com_endpoint_output:{english:"Output",translated:"Đầu ra"},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Đặt hướng dẫn hoặc ngữ cảnh tùy chỉnh. Bỏ qua nếu trống."},com_endpoint_custom_name:{english:"Custom Name",translated:"Tên tùy chỉnh"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Tiền tố"},com_endpoint_temperature:{english:"Temperature",translated:"Nhiệt độ"},com_endpoint_default:{english:"default",translated:"mặc định"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Số mã thông báo tối đa"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Giá trị cao = ngẫu nhiên hơn, trong khi giá trị thấp = tập trung và xác định hơn. Chúng tôi khuyến nghị thay đổi giá trị này hoặc Top P nhưng không phải cả hai."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Số mã thông báo tối đa để tạo. Tổng chiều dài của mã thông báo đầu vào và mã thông báo đã tạo bị giới hạn bởi độ dài ngữ cảnh của mô hình."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Một phương pháp thay thế cho việc lấy mẫu nhiệt độ, được gọi là lấy mẫu ranh giới, nơi mô hình xem xét kết quả của các mã thông báo với khối lượng xác suất top_p. Vì vậy, giá trị 0.1 có nghĩa là chỉ các mã thông báo bao gồm 10% khối lượng xác suất top_p được xem xét. Chúng tôi khuyến nghị thay đổi giá trị này hoặc nhiệt độ nhưng không phải cả hai."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Số từ giữa -2.0 và 2.0. Giá trị dương trừu tượng hóa các mã thông báo mới dựa trên tần suất hiện có của chúng trong văn bản, làm giảm khả năng mô hình lặp lại cùng một dòng văn hoàn toàn."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Số từ giữa -2.0 và 2.0. Giá trị dương trừu tượng hóa mã thông báo mới dựa trên việc chúng có xuất hiện trong văn bản, làm tăng khả năng của mô hình để nói về các chủ đề mới."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Đặt tên tùy chỉnh cho ChatGPT"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Đặt hướng dẫn tùy chỉnh để bao gồm vào Thông điệp hệ thống. Mặc định: không có"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Hình phạt tần suất"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Hình phạt hiện diện"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Sử dụng chức năng"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Bỏ qua hoàn thành"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Đặt hướng dẫn tùy chỉnh để bao gồm trong Thông điệp hệ thống. Mặc định: không có"},com_endpoint_import:{english:"Import",translated:"Nhập"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Đặt tên tùy chỉnh, nếu bạn có thể tìm thấy cài đặt này"},com_endpoint_preset:{english:"preset",translated:"đặt sẵn"},com_endpoint_presets:{english:"presets",translated:"đặt sẵn"},com_endpoint_preset_name:{english:"Preset Name",translated:"Tên đặt sẵn"},com_endpoint:{english:"Endpoint",translated:"Điểm kết thúc"},com_endpoint_examples:{english:" Presets",translated:" Đặt sẵn"},com_endpoint_export:{english:"Export",translated:"Xuất"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Lưu dưới dạng đặt sẵn"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Bạn có chắc chắn muốn xóa tất cả các đặt sẵn? Hành động này không thể hoàn tác."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Chưa có đặt sẵn"},com_endpoint_my_preset:{english:"My Preset",translated:"Đặt sẵn của tôi"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Mô hình Đặc trưng (Đề xuất: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Mô hình Hoàn thành (Đề xuất: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Cho phép sử dụng Plugin như các chức năng OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Cho phép bỏ qua bước hoàn thành, kiểm tra câu trả lời cuối cùng và các bước đã tạo"},com_nav_export_filename:{english:"Filename",translated:"Tên tệp"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Đặt tên cho tệp"},com_nav_export_type:{english:"Type",translated:"Loại"},com_nav_export_conversation:{english:"Export conversation",translated:"Xuất cuộc trò chuyện"},com_nav_export:{english:"Export",translated:"Xuất"},com_nav_shared_links:{english:"Shared links",translated:"Liên kết được chia sẻ"},com_nav_shared_links_manage:{english:"Manage",translated:"Quản l"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Bạn không có link được chia sẻ."},com_nav_shared_links_name:{english:"Name",translated:"Tên"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Ngày chia sẻ"},com_nav_source_chat:{english:"View source chat",translated:"View source chat"},com_nav_my_files:{english:"File Manager",translated:"File Manager"},com_nav_admin_center:{english:"Admin Center",translated:"Trung tâm quản trị"},com_nav_theme:{english:"Theme",translated:"Chủ đề"},com_nav_theme_system:{english:"System",translated:"Hệ thống"},com_nav_theme_dark:{english:"Dark",translated:"Tối"},com_nav_theme_light:{english:"Light",translated:"Sáng"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Xóa tất cả cuộc trò chuyện"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Xác nhận xóa"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Đóng thanh bên"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Mở thanh bên"},com_nav_send_message:{english:"Send message",translated:"Gửi tin nhắn"},com_nav_log_out:{english:"Log out",translated:"Đăng xuất"},com_nav_user:{english:"USER",translated:"NGƯỜI DÙNG"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Xóa cuộc trò chuyện"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Bạn có chắc chắn muốn xóa tất cả cuộc trò chuyện? Hành động này không thể hoàn tác."},com_nav_help:{english:"Help",translated:"Trợ giúp"},com_nav_settings:{english:"Settings",translated:"Cài đặt"},com_nav_search_placeholder:{english:"Search messages",translated:"Tìm kiếm tin nhắn"},com_nav_setting_general:{english:"General",translated:"Chung"},com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Nội dung gửi đã bị hệ thống kiểm duyệt gắn cờ vì không phù hợp với hướng dẫn cộng đồng của chúng tôi. Chúng tôi không thể tiếp tục với chủ đề này. Nếu bạn có câu hỏi hoặc chủ đề khác muốn khám phá, vui lòng chỉnh sửa tin nhắn của bạn hoặc tạo cuộc trò chuyện mới."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Không tìm thấy khóa. Vui lòng cung cấp khóa và thử lại."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Không tìm thấy URL cơ bản. Vui lòng cung cấp và thử lại."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Khóa không hợp lệ. Vui lòng cung cấp khóa và thử lại."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Khóa cung cấp cho {0} đã hết hạn vào {1}. Vui lòng cung cấp khóa và thử lại."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Bạn đã đạt đến số lượng token tối đa cho giấy phép của mình. Vui lòng liên hệ bộ phận bán hàng tại {0} để được hỗ trợ thêm."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Bạn đã sử dụng {0}% số token được cấp. Vui lòng liên hệ {1} để được hỗ trợ thêm."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Giấy phép của bạn không khả dụng. Vui lòng liên hệ hỗ trợ để được hỗ trợ thêm."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Địa chỉ IPv6 không được hỗ trợ. Vui lòng sử dụng kết nối IPv4 hoặc liên hệ hỗ trợ để được hỗ trợ thêm."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Đã xảy ra lỗi khi xử lý yêu cầu của bạn. Vui lòng thử lại."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Tệp {0} đã được tải lên thành công trước đó"},com_files_no_results:{english:"No results.",translated:"Không có kết quả."},com_files_filter:{english:"Search files by name",translated:"Tìm kiếm tệp theo tên"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} trong số {1} tệp đã chọn"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Chọn Trợ lý"},com_sidepanel_parameters:{english:"Parameters",translated:"Tham số"},com_ui_create_assistant:{english:"Create Assistant",translated:"Tạo Trợ lý"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Người dùng cần quyền tạo để tạo Trợ lý"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Trợ lý"},com_sidepanel_attach_files:{english:"File Manager",translated:"Quản lý Tệp"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Quản lý Tệp"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Đồng ý"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Bạn sắp chia sẻ trợ lý này với các thành viên khác trong nhóm. Trước khi chia sẻ trợ lý này, vui lòng xem xét các điểm chính dưới đây:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Bằng cách tiếp tục, bạn xác nhận rằng bạn hiểu và chấp nhận các điều khoản này."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Trợ lý chia sẻ không nên chứa dữ liệu nhạy cảm hoặc bí mật."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Trợ lý chia sẻ không được xử lý dữ liệu nhạy cảm hoặc bảo mật."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Chia sẻ đồng nghĩa với trách nhiệm và trách nhiệm đối với nội dung và quyền truy cập."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Nên chia sẻ với một nhóm cụ thể hoặc nhóm kín thay vì mọi người."},com_button_accept:{english:"Accept",translated:"Chấp nhận"},com_button_decline:{english:"Decline",translated:"Từ chối"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Cơ sở kiến thức"},com_assistants_file_search:{english:"File Search",translated:"Tìm kiếm Tệp"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Thêm các tệp bạn cần trợ lý tìm kiếm khi trả lời câu hỏi trong trò chuyện."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Hỗ trợ:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Mẹo:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Yêu cầu trợ lý sử dụng 'Công cụ Tìm kiếm Tệp' mỗi khi trả lời người dùng."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Đính kèm kho lưu trữ vector cho Tìm kiếm Tệp chưa được hỗ trợ. Bạn có thể đính kèm từ Provider Playground hoặc đính kèm tệp vào tin nhắn cho tìm kiếm tệp theo từng luồng."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Có lỗi xảy ra khi lấy tệp từ kho lưu trữ vector."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Cơ sở kiến thức"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Tải lên tệp cho trợ lý của bạn để nó có thể sử dụng chúng để trả lời câu hỏi (ví dụ: Hướng dẫn Sử dụng CXNGPT)"},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Nhấp Tạo để lưu Trợ lý của bạn, sau đó tải lên tệp của bạn và nhấp Lưu."},com_assistants_image_vision:{english:"Image Vision",translated:"Nhận diện Hình ảnh"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Trình thông dịch Mã"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Thêm các tệp bạn cần trợ lý sử dụng để phân tích hoặc chuyển đổi dữ liệu cho mỗi cuộc trò chuyện."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Hỗ trợ:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Mẹo:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Yêu cầu trợ lý sử dụng 'Công cụ Trình thông dịch Mã' mỗi khi trả lời người dùng."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} trong số {1} tệp đã tải lên"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Các tệp sau chỉ có sẵn cho Trình thông dịch Mã:"},com_assistants_retrieval:{english:"Retrieval",translated:"Truy xuất"},com_assistants_search_name:{english:"Search assistants by name",translated:"Tìm kiếm trợ lý theo tên"},com_assistants_tools:{english:"Tools",translated:"Công cụ"},com_assistants_actions:{english:"Actions",translated:"Hành động"},com_assistants_add_tools:{english:"Add Tools",translated:"Thêm Công cụ"},com_assistants_add_actions:{english:"Add Actions",translated:"Thêm Hành động"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Tìm kiếm tệp không được bật trên mô hình này. Vui lòng chọn mô hình khác."},com_assistants_available_actions:{english:"Available Actions",translated:"Hành động Có sẵn"},com_assistants_running_action:{english:"Running action",translated:"Đang thực hiện hành động"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Đã nói chuyện với {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"Đã chạy {0}"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Trợ lý đã sử dụng {0}"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Trợ lý đã gửi thông tin này đến {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Chỉ được xóa với Trợ lý riêng tư"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Đã xóa thành công Hành động khỏi Trợ lý"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Đã tạo hoặc cập nhật Hành động thành công"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Có lỗi khi tạo hoặc cập nhật hành động."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Có lỗi khi xóa hành động."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Cho phép Trợ lý của bạn truy xuất thông tin hoặc thực hiện hành động qua API"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Đặt tên cho trợ lý của bạn (ví dụ: Trình tạo Email)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Cung cấp cho trợ lý của bạn hướng dẫn cụ thể, chi tiết, toàn diện để chỉ đạo hành vi của nó (ví dụ: Mục tiêu, Vai trò, Hành động, Đối tượng, Phong cách, Quy tắc, Nhiệm vụ, Mẫu, Ví dụ)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Mô tả ngắn gọn những gì trợ lý của bạn có thể làm (ví dụ: Tạo email từ mẫu)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Bạn cần tạo một trợ lý trước khi thêm hành động."},com_assistants_update_success:{english:"Successfully updated",translated:"Cập nhật thành công"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Có lỗi khi cập nhật trợ lý của bạn."},com_assistants_create_success:{english:"Successfully created",translated:"Tạo thành công"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Có lỗi khi tạo trợ lý của bạn."},com_assistants_loading:{english:"Loading assistants...",translated:"Đang tải trợ lý..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Vui lòng cung cấp lý do bật PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Cài đặt & Quyền riêng tư"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Xóa thông tin cá nhân"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"Xóa thông tin cá nhân được bật mặc định cho các cuộc gọi mô hình của trợ lý này."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Cho phép PII sẽ tắt xóa thông tin cho các cuộc gọi mô hình của trợ lý này. Bạn chịu trách nhiệm tuân thủ chính sách dữ liệu của tổ chức. Hoạt động được ghi lại và giám sát đầy đủ."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Vui lòng giải thích lý do bật PII (bắt buộc)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Độ dài tối thiểu là {0} ký tự."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Độ dài tối đa là {0} ký tự."},com_ui_date_today:{english:"Today",translated:"Hôm nay"},com_ui_date_yesterday:{english:"Yesterday",translated:"Hôm qua"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"7 ngày trước"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"30 ngày trước"},com_ui_date_january:{english:"January",translated:"Tháng Một"},com_ui_date_february:{english:"February",translated:"Tháng Hai"},com_ui_date_march:{english:"March",translated:"Tháng Ba"},com_ui_date_april:{english:"April",translated:"Tháng Tư"},com_ui_date_may:{english:"May",translated:"Tháng Năm"},com_ui_date_june:{english:"June",translated:"Tháng Sáu"},com_ui_date_july:{english:"July",translated:"Tháng Bảy"},com_ui_date_august:{english:"August",translated:"Tháng Tám"},com_ui_date_september:{english:"September",translated:"Tháng Chín"},com_ui_date_october:{english:"October",translated:"Tháng Mười"},com_ui_date_november:{english:"November",translated:"Tháng Mười Một"},com_ui_date_december:{english:"December",translated:"Tháng Mười Hai"},com_ui_field_required:{english:"This field is required",translated:"Trường này là bắt buộc"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Lỗi tải xuống tệp. Tệp có thể đã bị xóa."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Loại tệp không được hỗ trợ cho điểm cuối:"},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Không thể đính kèm tệp Trợ lý vào các điểm cuối khác"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Vượt quá giới hạn kích thước tệp cho điểm cuối:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Không thể đính kèm tệp. Tạo hoặc chọn một cuộc trò chuyện, hoặc thử làm mới trang."},com_ui_kbot_assistants:{english:"Knowledge",translated:"Kiến thức"},com_ui_assistant_default_category:{english:"General",translated:"Chung"},com_ui_assistant_featured:{english:"Featured",translated:"Nổi bật"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Không có trợ lý nào phù hợp với tiêu chí tìm kiếm."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Không tìm thấy trợ lý nào."},com_ui_category_placeholder:{english:"Search a category",translated:"Tìm kiếm danh mục"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Tìm kiếm công cụ"},com_ui_on:{english:"On",translated:"Bật"},com_ui_off:{english:"Off",translated:"Tắt"},com_ui_yes:{english:"Yes",translated:"Có"},com_ui_no:{e