ion for disabling memory (required).",translated:"Пожалуйста, объясните деловое обоснование отключения памяти (обязательно)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Пожалуйста, укажите обоснование отключения памяти."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Память отключена для вашей команды. Вы можете просматривать и удалять существующие воспоминания, но не можете добавлять или редактировать новые."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Выполняю ваш код"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"Поиск в базе знаний"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Обработка голоса"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"Сохранение в память"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"Удаление из памяти"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Поиск в интернете завершен"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Просмотр веб-страницы завершен"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"Изображение создано"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Вычисление завершено"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"Выполнение вашего кода завершено"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"Поиск в базе знаний завершен"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"Обработка голосового ввода завершена"},com_ui