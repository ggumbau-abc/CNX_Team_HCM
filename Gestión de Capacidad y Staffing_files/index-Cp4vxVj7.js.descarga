steps",translated:"اعثر على الخطوات"},com_status_ind_none:{english:"Operational",translated:"تشغيل"},com_status_ind_minor:{english:"Minor Issues",translated:"مشاكل بسيطة"},com_status_ind_major:{english:"Major Issues",translated:"مشاكل كبيرة"},com_status_ind_critical:{english:"Critical",translated:"حرج"},com_status_ind_error:{english:"Error Fetching",translated:"خطأ في الجلب"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"يرجى ملاحظة أنه عند مغادرة الدردشة أو بدء دردشة جديدة، ستفقد سجل المحادثة."},com_forbidden_access:{english:"Forbidden access",translated:"الوصول ممنوع"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"سياسة الاستخدام المقبول"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"سياسة الخصوصية"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"اتفاقية الاشتراك"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"قبل استخدام iX Hello، يمكنك مراجعة "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"بالتسجيل و/أو الدخول، فإنك توافق على الشروط المذكورة أعلاه."},com_login_page_and:{english:"and ",translated:"و"},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"لا يوجد مساعدين مثبتين"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"المساعدين المثبتين"},com_ui_loading:{english:"Loading...",translated:"جارٍ التحميل..."},com_ui_unpin:{english:"Unpin",translated:"إلغاء التثبيت"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"تم إلغاء تثبيت المساعد بنجاح"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"خطأ في إزالة تثبيت المساعد"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"تم تثبيت المساعد بنجاح"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"خطأ في تثبيت/إزالة تثبيت المساعد"},com_ui_pin:{english:"Pin",translated:"تثبيت"},come_create_assistant:{english:"Create Assistant",translated:"إنشاء مساعد"},come_edit_assistant:{english:"Edit Assistant",translated:"تعديل مساعد"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"هل أنت متأكد أنك تريد المتابعة؟ سيؤدي هذا إلى فقدان أي تغييرات تم إجراؤها على المساعد الذي تقوم بتعديله أو إنشائه حاليًا. لا يمكن التراجع عن هذا الإجراء."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"لم يتم العثور على مساعد بالمعرف {0}."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"المتصفح لا يدعم التعرف على الكلام"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"لم يتم منح إذن الميكروفون"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"خطأ في بدء التسجيل: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"لم يبدأ MediaRecorder في التسجيل"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder غير مدعوم في هذا المتصفح"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"تحتوي رسالتك على معلومات شخصية ولم يتم إرسالها. يرجى إزالة أي معلومات شخصية."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"فشل في إعادة تسمية المحادثة"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"لديك {0} من الرموز المخصصة المتبقية."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello قد يرتكب أخطاء. يرجى مراجعة جميع المخرجات للجودة والدقة. يتم تسجيل جميع المدخلات للامتثال."},com_ui_assistant_group_by:{english:"Group by",translated:"تجميع حسب"},com_ui_assistant_category:{english:"Category",translated:"الفئة"},com_ui_assistant_team:{english:"Team",translated:"الفريق"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"الهندسة"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"الذكاء"},com_ui_assistant_marketing:{english:"Marketing",translated:"التسويق"},com_ui_assistant_operations:{english:"Operations",translated:"العمليات"},com_ui_assistant_sales:{english:"Sales",translated:"المبيعات"},com_ui_assistant_strategy:{english:"Strategy",translated:"الاستراتيجية"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"مساعدي الاستوديو"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"ارفع صورة رمزية (PNG أو JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"البحث عبر الإنترنت"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"تصفح الموقع"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"توليد الصور"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"حساب الرياضيات"},com_ui_assistant_tools_default:{english:"Running tool",translated:"الأداة الافتراضية"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"تحميل الملف يستغرق وقتًا أطول من المتوقع. يرجى المحاولة مرة أخرى."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"خطأ في تثبيت المساعد"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"حدث خطأ عند حذف الرابط المشترك"},com_ui_dan:{english:"DAN",translated:"دان"},com_ui_dan_template:{english:"DAN Template",translated:"قالب دان"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"لا يوجد إعداد مسبق نشط."},com_ui_drag_drop_title:{english:"Add anything",translated:"أضف أي شيء"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"أسقط أي ملف هنا لإضافته إلى المحادثة"},com_ui_analyzing:{english:"Analyzing",translated:"جارٍ التحليل"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"اكتمل التحليل"},com_ui_warning:{english:"Warning",translated:"تحذير"},com_ui_proceed:{english:"Proceed",translated:"استمر"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"الملفات المرفوعة للمساعد تستخدم لأغراض المحادثة فقط. يمكن للمستخدمين الوصول إلى محتوى هذه الملفات عبر طرح الأسئلة ذات الصلة، لكن لا يُسمح بتنزيل الملفات مباشرة."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"تعيين اسم مخصص لهذا الإعداد المسبق"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"تعيين مثال إدخال. يتم تجاهل المثال إذا كان فارغًا."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"تعيين مثال إخراج. يتم تجاهل المثال إذا كان فارغًا."},com_nav_export_select_type:{english:"Select a file type",translated:"اختر نوع الملف"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"لقطة شاشة (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"نص (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"ماركداون (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"جيسون (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"سي إس في (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"لم يتم استلام أي استجابة. يرجى محاولة إرسال رسالتك مرة أخرى. إذا استمرت المشكلة بعد إعادة تحميل الصفحة والمحاولة مرة أخرى، يرجى الاتصال بالدعم."},com_ui_back_to_chat:{english:"Back to Chat",translated:"العودة إلى الدردشة"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"إشراف الحماية"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"تم تفعيل إشراف الحماية لهذا المساعد. سيتم فحص المحتوى وفقًا لسياسات الإشراف."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"تعطيل إشراف الحماية يزيل فحوصات الإشراف على المحتوى لهذا المساعد. أنت مسؤول عن الامتثال لسياسات المحتوى في مؤسستك. يتم تسجيل ومراقبة النشاط بالكامل."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"يرجى شرح مبرر عملك لتعطيل إشراف الحماية (مطلوب)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"يرجى تقديم مبرر لتعطيل إشراف الحماية."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"السماح للمستخدمين بتغيير النموذج في الدردشة"},com_ui_feedback_good:{english:"Good response",translated:"استجابة جيدة"},com_ui_feedback_bad:{english:"Poor response",translated:"استجابة سيئة"},com_ui_feedback_comments:{english:"Comments",translated:"تعليقات"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"تعليقات (اختياري)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"أخبرنا المزيد عن تجربتك..."},com_ui_feedback_submit:{english:"Submit",translated:"إرسال"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"تعذّر إرسال تعليقاتك"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"غير صحيح"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"غير ذي صلة"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"قديم"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"تفاصيل غير كافية"},com_ui_feedback_reason_other:{english:"Other",translated:"أخرى"},com_ui_model_recommended:{english:"Recommended",translated:"موصى به"},com_ui_model_legacy:{english:"Legacy — please update",translated:"قديم — يرجى التحديث"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"هذا النموذج لم يعد مدعومًا. يرجى اختيار نموذج حالي."},com_nav_setting_memory:{english:"Memory",translated:"الذاكرة"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"إدارة الحقائق الشخصية التي يتذكرها المساعد عبر محادثاتك."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"إضافة ذاكرة جديدة..."},com_nav_memory_add_button:{english:"Add memory",translated:"إضافة ذاكرة"},com_nav_memory_category:{english:"Category",translated:"الفئة"},com_nav_memory_category_preference:{english:"Preference",translated:"التفضيل"},com_nav_memory_category_identity:{english:"Identity",translated:"الهوية"},com_nav_memory_category_context:{english:"Context",translated:"السياق"},com_nav_memory_category_project:{english:"Project",translated:"المشروع"},com_nav_memory_empty_title:{english:"No memories yet",translated:"لا توجد ذكريات بعد"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"الذكريات التي تحفظها ستظهر هنا وتساعد في تخصيص المحادثات المستقبلية."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"تعذر تحميل الذكريات. يرجى المحاولة مرة أخرى."},com_nav_memory_retry:{english:"Retry",translated:"إعادة المحاولة"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"تعذر إضافة الذاكرة. يرجى المحاولة مرة أخرى."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"تعذر تحديث الذاكرة. يرجى المحاولة مرة أخرى."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"تعذر حذف الذاكرة. يرجى المحاولة مرة أخرى."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"حذف هذه الذاكرة؟"},com_nav_memory_delete_button:{english:"Delete",translated:"حذف"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"تحرير الذاكرة"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"حذف الذاكرة"},com_nav_memory_save:{english:"Save",translated:"حفظ"},com_nav_memory_cancel:{english:"Cancel",translated:"إلغاء"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"تم الحفظ في {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — أحدث نموذج تفكير GPT-5 بذكاء متقدم."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — إصدار مضغوط وفعال من حيث التكلفة من GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — أحدث نموذج من الجيل الخامس GPT."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"أحدث Opus — ذكاء متقدم للوكلاء البرمجيين وعمليات المؤسسات."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"أحدث Opus — ذكاء متقدم للوكلاء البرمجيين وعمليات المؤسسات."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet المحسن مع تحسين في التفكير واتباع التعليمات."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"أقوى نموذج من Anthropic للمهام المعقدة متعددة الخطوات."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"توازن بين الذكاء والسرعة لمجموعة واسعة من المهام."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"أسرع وأصغر نموذج Claude — مثالي للمهام ذات الإنتاجية العالية."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — تحسين في التفكير والقدرات متعددة الوسائط."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"نموذج الجيل التالي الرائد من OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 خفيف الوزن — فعال وسريع للمهام اليومية."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — تحسين في اتباع التعليمات والتفكير."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 مضغوط — أسرع وأرخص للمهام البسيطة."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"أكثر نماذج GPT-4 قدرة، محسن للسرعة والتكلفة."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o خفيف الوزن — أسرع وأرخص للمهام البسيطة."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (معاينة) — أقوى نموذج Gemini مع سياق بمليون رمز."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (معاينة) — سريع وفعّال مع سياق بمليون رمز."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — نموذج خفيف وذو زمن استجابة منخفض مع سياق بمليون رمز."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"نموذج مساعد داخلي محسن للصوت."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"يختار Auto أفضل نموذج لطلبك بناءً على السعة والأداء."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"قريبًا"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"تفضيلات التوجيه التلقائي"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"اضبط كيفية موازنة الموجّه التلقائي بين المفاضلات عند اختيار نموذج لكل دور. يتم تطبيع الأوزان — ما يهم هو التوازن النسبي."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"التكلفة"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"فضّل النماذج الأرخص ذات تكلفة الرموز الأقل."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"الدقة"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"فضّل النماذج الأقوى للاستدلال المعقد."},com_assistants_auto_weight_speed:{english:"Speed",translated:"السرعة"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"فضّل النماذج الأسرع والأقل زمن استجابة."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"إعادة التعيين إلى الافتراضي"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"انتهت مهلة تحميل الملف. يرجى المحاولة مرة أخرى بعد بضع دقائق."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"حدث خطأ ما. هذه رسالة الخطأ المحددة التي واجهناها: حدث خطأ أثناء معالجة طلبك. المساعد لم يعد متاحًا. يُرجى التواصل مع المسؤول."},com_ui_code:{english:"Code",translated:"كود"},com_ui_assistant_share:{english:"Share",translated:"مشاركة"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"تم نسخ الرابط"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"ليس لديك صلاحية الوصول إلى هذا المساعد"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"تعذر نسخ الرابط إلى الحافظة"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"المعاينة غير متاحة - لم يكتمل توليد المحتوى."},com_ui_view_code:{english:"View code",translated:"عرض الكود"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"المعاينة غير متوفرة — المحتوى غير صالح."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"رقم الهاتف"},com_assistants_pii_entity_email:{english:"Email Address",translated:"عنوان البريد الإلكتروني"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"بطاقة الائتمان"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"رقم الضمان الاجتماعي"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"يستغرق التحميل وقتًا أطول من المتوقع - جارٍ إعادة المحاولة ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"مشكلة في الاتصال - جارٍ إعادة المحاولة ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"فشل التحميل - يرجى التحقق من اتصالك والمحاولة مرة أخرى"},com_assistants_memory_enabled:{english:"Memory",translated:"الذاكرة"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"الذاكرة مفعّلة لهذا المساعد. يمكن للمساعد تخزين الحقائق واسترجاعها عبر المحادثات."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"الذاكرة معطّلة لهذا المساعد. لن يتم تخزين أي حقائق أو استرجاعها عبر المحادثات."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"يرجى توضيح المبرر التجاري لتعطيل الذاكرة (مطلوب)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"يرجى تقديم مبرر لتعطيل الذاكرة."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"الذاكرة معطّلة لفريقك. يمكنك عرض الذكريات الحالية وحذفها، لكن لا يمكنك إضافة ذكريات جديدة أو تعديلها."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"جارٍ تشغيل الكود الخاص بك"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"جارٍ البحث في قاعدة المعرفة"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"جارٍ معالجة الصوت"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"جارٍ الحفظ في الذاكرة"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"جارٍ الإزالة من الذاكرة"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"اكتمل البحث في الويب"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"اكتملت مراجعة صفحة الويب"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"تم إنشاء الصورة"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"اكتمل الحساب"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"اكتمل تشغيل الكود الخاص بك"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"اكتمل البحث في قاعدة المعرفة"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"اكتملت معالجة الإدخال الصوتي"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"تم الحفظ في الذاكرة"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"تمت الإزالة من الذاكرة"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"اكتمل: {0}"},com_ui_still_working:{english:"still working...",translated:"لا يزال يعمل..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} جاهز"},com_ui_file_ready_fallback:{english:"File is ready",translated:"الملف جاهز"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"تعذر معالجة {0}"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"تعذر معالجة الملف"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"تعذر معالجة {0}. يرجى إعادة رفع الملف."},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"تعذر معالجة الملف. يرجى إعادة رفع الملف."},com_ui_file_processing:{english:"Processing...",translated:"جارٍ المعالجة..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"فشلت المعالجة"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"فشل - يلزم إعادة الرفع"},com_ui_file_retry:{english:"Retry",translated:"إعادة المحاولة"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"إعادة المحاولة خلال {0}ث"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"جارٍ إعادة محاولة فهرسة الملف..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"يرجى الانتظار {0}ث قبل إعادة المحاولة"},com_ui_file_retries_exhausted_reupload:{english:"Maximum retries reached. Please re-upload the file.",translated:"تم بلوغ الحد الأقصى للمحاولات. يرجى إعادة رفع الملف."},com_ui_assistant_file_upload_invalid_json:{english:"Invalid JSON file. File content does not match the expected format.",translated:"ملف JSON غير صالح. محتوى الملف لا يتطابق مع التنسيق المتوقع."}},kv=Object.freeze(Object.defineProperty({__proto__:null,comparisons:vv,default:yv},Symbol.toStringTag,{value:"Module"})),bv={com_error_moderation:"আপলোড করা বিষয়বস্তু আমাদের মডারেশন সিস্টেম দ্বারা চিহ্নিত হয়েছে যা আমাদের কমিউনিটি নির্দেশিকার সাথে সামঞ্জস্যপূর্ণ নয়। আমরা এই নির্দিষ্ট বিষয়ে এগোতে পারছি না। আপনার যদি অন্য কোনো প্রশ্ন বা বিষয় থাকে যা আপনি অন্বেষণ করতে চান, দয়া করে আপনার বার্তা সম্পাদনা করুন, অথবা একটি নতুন কথোপকথন শুরু করুন।",com_error_no_user_key:"কোনো কী পাওয়া যায়নি। দয়া করে একটি কী প্রদান করুন এবং আবার চেষ্টা করুন।",com_error_no_base_url:"কোনো বেস URL পাওয়া যায়নি। দয়া করে একটি প্রদান করুন এবং আবার চেষ্টা করুন।",com_error_invalid_user_key:"অবৈধ কী প্রদান করা হয়েছে। দয়া করে একটি কী প্রদান করুন এবং আবার চেষ্টা করুন।",com_error_expired_user_key:"{0} এর জন্য প্রদত্ত কী {1} এ মেয়াদোত্তীর্ণ হয়েছে। দয়া করে একটি কী প্রদান করুন এবং আবার চেষ্টা করুন।",com_error_token_balance_exceeded:"আপনি আপনার মাসিক ব্যবহার সীমা অতিক্রম করেছেন। সহায়তার জন্য দয়া করে টিম অ্যাডমিনের সাথে যোগাযোগ করুন।",com_error_token_balance_exceeded_license:"আপনি আপনার লাইসেন্সের জন্য সর্বাধিক টোকেন পৌঁছেছেন। আরও সহায়তার জন্য দয়া করে {0} এ বিক্রয় বিভাগে যোগাযোগ করুন।",com_error_token_balance_percent_used:"আপনি বরাদ্দকৃত টোকেনের {0}% ব্যবহার করেছেন। আরও সহায়তার জন্য দয়া করে {1} এর সাথে যোগাযোগ করুন।",com_error_license_expired:"আপনার লাইসেন্স উপলব্ধ নয়। আরও সহায়তার জন্য দয়া করে সমর্থনের সাথে যোগাযোগ করুন।",com_restricted_invalid_ip_format:"IPv6 ঠিকানা সমর্থিত নয়। দয়া করে একটি IPv4 সংযোগ ব্যবহার করুন বা আরও সহায়তার জন্য সমর্থনের সাথে যোগাযোগ করুন।",com_error_tool_run:"আপনার অনুরোধ প্রক্রিয়াকরণের সময় একটি ত্রুটি ঘটেছে। দয়া করে আবার চেষ্টা করুন।",com_files_upload_duplicate_success:"ফাইল {0} ইতিমধ্যে সফলভাবে আপলোড করা হয়েছে",com_files_no_results:"কোন ফলাফল নেই।",com_files_filter:"নামের দ্বারা ফাইল অনুসন্ধান করুন",com_files_number_selected:"{0} এর মধ্যে {1} ফাইল নির্বাচিত",com_sidepanel_select_assistant:"সহকারী নির্বাচন করুন",com_sidepanel_parameters:"প্যারামিটার",com_ui_create_assistant:"সহকারী তৈরি করুন",com_ui_create_assistant_permission_needed:"একজন ব্যবহারকারীর সহকারী তৈরি করতে তৈরি অনুমতি প্রয়োজন",com_sidepanel_assistant_builder:"সহকারীগণ",com_sidepanel_attach_files:"ফাইল ম্যানেজার",com_sidepanel_manage_files:"ফাইল পরিচালনা করুন",com_assistants_shared_with_consent_title:"সম্মতি",com_assistants_shared_with_consent_description_1:"আপনি এই সহকারীটি অন্যান্য দলের সদস্যদের সাথে শেয়ার করতে যাচ্ছেন। এই সহকারীটি শেয়ার করার আগে, দয়া করে নিচের মূল পয়েন্টগুলি পর্যালোচনা করুন:",com_assistants_shared_with_consent_description_2:"অগ্রসর হওয়ার মাধ্যমে, আপনি নিশ্চিত করেন যে আপনি এই শর্তগুলি বুঝতে এবং গ্রহণ করতে পেরেছেন।",com_assistants_shared_with_consent_bullet_1:"শেয়ার করা সহকারী সংবেদনশীল বা গোপনীয় তথ্য ধারণ করা উচিত নয়।",com_assistants_shared_with_consent_bullet_2:"শেয়ার করা সহকারী সংবেদনশীল বা গোপনীয় তথ্য প্রক্রিয়া করা উচিত নয়।",com_assistants_shared_with_consent_bullet_3:"শেয়ারিং বিষয়বস্তু এবং প্রবেশাধিকার জন্য দায়িত্ব এবং দায়িত্ব বোঝায়।",com_assistants_shared_with_consent_bullet_4:"সবাইয়ের সাথে শেয়ার করার পরিবর্তে নির্দিষ্ট দল বা বন্ধ গোষ্ঠীর সাথে শেয়ার করার সুপারিশ করা হয়।",com_button_accept:"গ্রহণ করুন",com_button_decline:"প্রত্যাখ্যান করুন",com_assistants_capabilities:"জ্ঞানভাণ্ডার",com_assistants_file_search:"ফাইল অনুসন্ধান",com_assistants_file_search_description:"যখন চ্যাটে প্রশ্নের উত্তর দেয় তখন আপনার সহকারীকে অনুসন্ধান করার জন্য এখানে ফাইল যোগ করুন।",com_assistants_file_search_supported_label:"সমর্থিত:",com_assistants_file_search_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts।",com_assistants_file_search_tips_label:"পরামর্শ:",com_assistants_file_search_tips:"প্রত্যেকবার ব্যবহারকারীদের প্রতিক্রিয়া দেওয়ার সময় আপনার সহকারীকে 'ফাইল অনুসন্ধান টুল' ব্যবহার করতে বলুন।",com_assistants_file_search_info:"ফাইল অনুসন্ধানের জন্য ভেক্টর স্টোর সংযুক্ত করা এখনও সমর্থিত নয়। আপনি সেগুলি প্রোভাইডার প্লেগ্রাউন্ড থেকে সংযুক্ত করতে পারেন বা থ্রেড ভিত্তিতে ফাইল অনুসন্ধানের জন্য বার্তাগুলিতে ফাইল সংযুক্ত করতে পারেন।",com_assistants_file_search_fetch_error:"ভেক্টর স্টোর থেকে ফাইলগুলি আনতে কিছু ভুল হয়েছে।",com_assistants_knowledge:"জ্ঞানভাণ্ডার",com_assistants_knowledge_info:"আপনার সহকারীকে ফাইল আপলোড করুন, যাতে এটি প্রশ্নের উত্তর দিতে সেগুলি ব্যবহার করতে পারে (যেমন CXNGPT ব্যবহারকারী গাইড)",com_assistants_knowledge_disabled:"আপনার সহকারী সংরক্ষণ করতে তৈরি করুন ক্লিক করুন, তারপর আপনার ফাইল আপলোড করুন, এবং সংরক্ষণ করুন ক্লিক করুন।",com_assistants_image_vision:"ইমেজ ভিশন",com_assistants_code_interpreter:"কোড ইন্টারপ্রেটার",com_assistants_code_interpreter_description:"প্রতিটি চ্যাটের জন্য ডেটা বিশ্লেষণ বা রূপান্তর করতে আপনার সহকারীকে ব্যবহার করার জন্য এখানে ফাইল যোগ করুন।",com_assistants_code_interpreter_supported_label:"সমর্থিত:",com_assistants_code_interpreter_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip।",com_assistants_code_interpreter_tips_label:"পরামর্শ:",com_assistants_code_interpreter_tips:"প্রত্যেকবার ব্যবহারকারীদের প্রতিক্রিয়া দেওয়ার সময় আপনার সহকারীকে 'কোড ইন্টারপ্রেটার টুল' ব্যবহার করতে বলুন।",com_assistants_code_interpreter_files_counter:"{0} এর মধ্যে {1} ফাইল আপলোড হয়েছে",com_assistants_code_interpreter_files:"নিম্নলিখিত ফাইলগুলি শুধুমাত্র কোড ইন্টারপ্রেটারের জন্য উপলব্ধ:",com_assistants_retrieval:"উদ্ধার",com_assistants_search_name:"নামের দ্বারা সহকারী অনুসন্ধান করুন",com_assistants_tools:"সরঞ্জাম",com_assistants_actions:"ক্রিয়াকলাপ",com_assistants_add_tools:"সরঞ্জাম যোগ করুন",com_assistants_add_actions:"ক্রিয়াকলাপ যোগ করুন",com_assistants_no