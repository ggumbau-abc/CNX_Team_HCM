n ikke legge til eller redigere nye.",com_ui_file_ready:"{0} er klar",com_ui_file_ready_fallback:"Filen er klar",com_ui_file_processing_failed:"{0} kunne ikke behandles",com_ui_file_processing_failed_fallback:"Filen kunne ikke behandles",com_ui_file_processing_failed_reupload:"{0} kunne ikke behandles. Last opp filen på nytt.",com_ui_file_processing_failed_reupload_fallback:"Filen kunne ikke behandles. Last opp filen på nytt.",com_ui_file_processing:"Behandler...",com_ui_file_processing_failed_status:"Behandling mislyktes",com_ui_file_processing_failed_reupload_required:"Mislyktes – opplasting på nytt kreves",com_ui_file_retry:"Prøv igjen",com_ui_file_retry_in:"Prøv igjen om {0}s",com_ui_file_indexing_retrying:"Prøver filindeksering på nytt...",com_ui_file_retry_wait:"Vennligst vent {0}s før du prøver igjen",com_ui_file_retries_exhausted_reupload:"Maksimalt antall forsøk nådd. Vennligst last opp filen på nytt.",com_ui_assistant_file_upload_invalid_json:"Ugyldig JSON-fil. Filinnholdet samsvarer ikke med forventet format."},Ik={com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Det ser ut til at innholdet som ble sendt inn har blitt flagget av vårt moderasjonssystem for ikke å samsvare med våre retningslinjer for fellesskapet. Vi kan ikke fortsette med dette spesifikke emnet. Hvis du har andre spørsmål eller emner du vil utforske, vennligst rediger meldingen din, eller opprett en ny samtale."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Ingen nøkkel funnet. Vennligst oppgi en nøkkel og prøv igjen."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Ingen base-URL funnet. Vennligst oppgi en og prøv igjen."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Ugyldig nøkkel oppgitt. Vennligst oppgi en nøkkel og prøv igjen."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Oppgitt nøkkel for {0} utløp {1}. Vennligst oppgi en nøkkel og prøv igjen."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"Du har nådd din månedlige bruksgrense. Vennligst kontakt teamadministratoren for hjelp."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Du har nådd maksimalt antall tokens for din lisens. Vennligst kontakt salg på {0} for videre hjelp."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Du har brukt {0}% av dine tildelte tokens. Vennligst kontakt {1} for videre hjelp."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Din lisens er ikke tilgjengelig. Vennligst kontakt support for videre hjelp."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"IPv6-adresser støttes ikke. Vennligst bruk en IPv4-tilkobling eller kontakt support for videre hjelp."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"En feil oppstod under behandlingen av forespørselen din. Vennligst prøv igjen."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Fil {0} ble allerede lastet opp."},com_files_no_results:{english:"No results.",translated:"Ingen resultater."},com_files_filter:{english:"Search files by name",translated:"Søk filer etter navn"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} av {1} fil(er) valgt"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Velg en assistent"},com_sidepanel_parameters:{english:"Parameters",translated:"Parametere"},com_ui_create_assistant:{english:"Create Assistant",translated:"Opprett assistent"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Bruker trenger opprettelsestillatelse for å opprette en assistent"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Assistenter"},com_sidepanel_attach_files:{english:"File Manager",translated:"Filbehandler"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Administrer filer"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Samtykke"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Du er i ferd med å dele denne assistenten med andre teammedlemmer. Før du deler denne assistenten, vennligst gjennomgå de viktige punktene nedenfor:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Ved å fortsette bekrefter du at du forstår og aksepterer disse vilkårene."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Delt assistent skal ikke inneholde sensitiv eller konfidensiell data."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Delte assistenter må ikke behandle sensitiv eller konfidensiell data."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Deling innebærer ansvarlighet og ansvar for innhold og tilgang."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Det anbefales å dele med et spesifikt team eller lukket gruppe i stedet for alle."},com_button_accept:{english:"Accept",translated:"Godta"},com_button_decline:{english:"Decline",translated:"Avslå"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Kunnskapsbase"},com_assistants_file_search:{english:"File Search",translated:"Filsøk"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Legg til filer her som assistenten din skal søke i når den svarer på spørsmål i chat."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Støttet:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Tips:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Be assistenten din bruke 'Filsøkverktøyet' hver gang den svarer brukere."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Vedleggsvektorer for filsøk støttes ikke ennå. Du kan legge dem til fra Provider Playground eller legge ved filer til meldinger for filsøk i en tråd."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Noe gikk galt ved henting av filer fra vektorlagrene."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Kunnskapsbase"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Last opp filer til assistenten din, slik at den kan bruke dem til å svare på spørsmål (f.eks. CXNGPT Brukerveiledning)"},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Klikk Opprett for å lagre assistenten din, last deretter opp filene dine, og klikk Lagre."},com_assistants_image_vision:{english:"Image Vision",translated:"Bildevisjon"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Kodefortolker"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Legg til filer her som assistenten din skal bruke til å analysere eller transformere data for hver chat."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Støttet:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Tips:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Be assistenten din bruke 'Kodefortolkerverktøyet' hver gang den svarer brukere."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} av {1} filer lastet opp"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Følgende filer er kun tilgjengelige for kodefortolkeren:"},com_assistants_retrieval:{english:"Retrieval",translated:"Henting"},com_assistants_search_name:{english:"Search assistants by name",translated:"Søk assistenter etter navn"},com_assistants_tools:{english:"Tools",translated:"Verktøy"},com_assistants_actions:{english:"Actions",translated:"Handlinger"},com_assistants_add_tools:{english:"Add Tools",translated:"Legg til verktøy"},com_assistants_add_actions:{english:"Add Actions",translated:"Legg til handlinger"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Filleting er ikke aktivert på denne modellen. Vennligst velg en annen modell."},com_assistants_available_actions:{english:"Available Actions",translated:"Tilgjengelige handlinger"},com_assistants_running_action:{english:"Running action",translated:"Utfører handling"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Snakket med {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"Kjørte {0}"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Brukte filsøk"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Assistent brukte {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:"[feil ved behandling av verktøy] Kunne ikke hente innholdet fra den angitte nettsiden. [100]"},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:"[feil ved behandling av verktøy] Kunne ikke hente innholdet fra den angitte nettsiden. [101]"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Assistent sendte denne infoen til {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Sletting er kun tillatt med private assistenter"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Handling ble vellykket slettet fra assistenten"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Handling ble vellykket opprettet eller oppdatert"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Det oppstod en feil ved oppretting eller oppdatering av handlingen."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Det oppstod en feil ved sletting av handlingen."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"La assistenten din hente informasjon eller utføre handlinger via API-er"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Navngi assistenten din (f.eks. E-postgenerator)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Gi assistenten din spesifikke, detaljerte, omfattende retningslinjer for å styre dens oppførsel (f.eks. Mål, Rolle, Handlinger, Publikum, Stil, Regler, Oppgave, Mal, Eksempel)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Beskriv kort hva assistenten din kan gjøre (f.eks. Generere e-poster fra mal)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Du må opprette en assistent før du legger til handlinger."},com_assistants_update_success:{english:"Successfully updated",translated:"Oppdatert vellykket"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Det oppstod en feil ved oppdatering av assistenten din."},com_assistants_create_success:{english:"Successfully created",translated:"Opprettet vellykket"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Det oppstod en feil ved oppretting av assistenten din."},com_assistants_loading:{english:"Loading assistants...",translated:"Laster assistenter..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Vennligst oppgi en grunn for å aktivere PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Innstillinger og personvern"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"PII-sensur"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"PII-sensur er aktivert for denne assistentens modellkall som standard."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Tillatelse av PII deaktiverer sensur for denne assistentens modellkall. Du er ansvarlig for å overholde organisasjonens datapolitikk. Aktivitet logges og overvåkes fullt ut."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Vennligst forklar din grunn for å aktivere PII (påkrevd)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Minimumslengde er {0} tegn."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Maksimumslengde er {0} tegn."},com_ui_date_today:{english:"Today",translated:"I dag"},com_ui_date_yesterday:{english:"Yesterday",translated:"I går"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Forrige 7 dager"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"Forrige 30 dager"},com_ui_date_january:{english:"January",translated:"Januar"},com_ui_date_february:{english:"February",translated:"Februar"},com_ui_date_march:{english:"March",translated:"Mars"},com_ui_date_april:{english:"April",translated:"April"},com_ui_date_may:{english:"May",translated:"Mai"},com_ui_date_june:{english:"June",translated:"Juni"},com_ui_date_july:{english:"July",translated:"Juli"},com_ui_date_august:{english:"August",translated:"August"},com_ui_date_september:{english:"September",translated:"September"},com_ui_date_october:{english:"October",translated:"Oktober"},com_ui_date_november:{english:"November",translated:"November"},com_ui_date_december:{english:"December",translated:"Desember"},com_ui_field_required:{english:"This field is required",translated:"Dette feltet er påkrevd"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Feil ved nedlasting av fil. Filen kan ha blitt slettet."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Ikke støttet filtype for endepunkt:"},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Kan ikke legge ved assistentfiler til andre endepunkter"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Filstørrelsesgrense overskredet for endepunkt:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Kan ikke legge ved fil. Opprett eller velg en samtale, eller prøv å oppdatere siden."},com_ui_examples:{english:"Examples",translated:"Eksempler"},com_ui_new_chat:{english:"New chat",translated:"Ny chat"},com_ui_conversations:{english:"Chats",translated:"Chatter"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"Start en samtale..."},com_ui_new_conversation:{english:"New Chat",translated:"Ny Chat"},com_ui_assistant_library:{english:"Assistant Library",translated:"Assistentbibliotek"},com_ui_kbot_assistants:{english:"Knowledge",translated:"Kunnskap"},com_ui_assistant_search:{english:"Search for an assistant",translated:"Søk etter en assistent"},com_ui_assistant_default_category:{english:"General",translated:"Generell"},com_ui_assistant_featured:{english:"Featured",translated:"Utvalgt"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Ingen assistenter samsvarer med søkekriteriene."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Ingen assistenter funnet."},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"Forklar kvanteberegning enkelt"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"Har du noen kreative ideer til en 10-årsdag?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"Hvordan gjør jeg en HTTP-forespørsel i Javascript?"},com_ui_category_placeholder:{english:"Search a category",translated:"Søk i kategori"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Søk i verktøy"},com_ui_capabilities:{english:"Capabilities",translated:"Egenskaper"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"Husker hva brukeren sa tidligere i samtalen"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Lar brukeren gi oppfølgende korrigeringer"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Trent til å avslå upassende forespørsler"},com_ui_limitations:{english:"Limitations",translated:"Begrensninger"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Kan av og til generere feil informasjon"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Kan av og til produsere skadelige instruksjoner eller partisk innhold"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Begrenset kunnskap om verden og hendelser etter 2021"},com_ui_on:{english:"On",translated:"På"},com_ui_off:{english:"Off",translated:"Av"},com_ui_yes:{english:"Yes",translated:"Ja"},com_ui_no:{english:"No",translated:"Nei"},com_ui_ascending:{english:"Asc",translated:"Stigende"},com_ui_descending:{english:"Desc",translated:"Synkende"},com_ui_show_all:{english:"Show All",translated:"Vis alle"},com_ui_name:{english:"Name",translated:"Navn"},com_ui_date:{english:"Date",translated:"Dato"},com_ui_storage:{english:"Storage",translated:"Lagring"},com_ui_context:{english:"Context",translated:"Kontekst"},com_ui_size:{english:"Size",translated:"Størrelse"},com_ui_host:{english:"Host",translated:"Vert"},com_ui_update:{english:"Update",translated:"Oppdater"},com_ui_authentication:{english:"Authentication",translated:"Autentisering"},com_ui_instructions:{english:"Instructions",translated:"Instruksjoner"},com_ui_description:{english:"Description",translated:"Beskrivelse"},com_ui_category:{english:"Category",translated:"Kategori"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Tildel en forretningskategori for å hjelpe med å filtrere og organisere assistenter etter funksjon."},com_ui_error:{english:"Error",translated:"Feil"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Feil ved tilkobling til serveren, prøv å oppdatere siden."},com_ui_select:{english:"Select",translated:"Velg"},com_ui_select_placeholder:{english:"Select options",translated:"Velg alternativer"},com_ui_remove:{english:"Remove",translated:"Fjern"},com_ui_input:{english:"Input",translated:"Inndata"},com_ui_close:{english:"Close",translated:"Lukk"},com_ui_model:{english:"Model",translated:"Modell"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Assistentnavn-feltet kan ikke være tomt. Vennligst skriv inn et gyldig navn."},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Smart Prefix ble brukt for Generelle Assistenter, vennligst bruk et annet navn."},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Beskrivelsesfeltet kan ikke være tomt. Vennligst skriv inn en gyldig beskrivelse."},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Instruksjonsfeltet kan ikke være tomt. Vennligst skriv inn gyldige instruksjoner."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Kategorifeltet kan ikke være tomt. Vennligst velg en kategori."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Et duplikat assistentnavn er oppdaget. Vennligst velg et unikt navn."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Delt med-feltet kan ikke være tomt. Vennligst velg et delt med-alternativ."},com_ui_shared_with:{english:"Shared With",translated:"Delt med"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Privat – Bare du kan få tilgang til og se denne assistenten."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Del kun med team – Denne assistenten vil være synlig og tilgjengelig for teammedlemmene dine."},com_ui_shared_with_team:{english:"Team",translated:"Team"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Velg teamet denne assistenten tilhører. Bare team du er medlem av vil vises her."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Teamfeltet kan ikke være tomt. Vennligst velg et team."},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Denne assistenten er låst for redigering fordi den er delt med teamet."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Feil ved lasting av delte lenker."},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Assistentnavnet ditt inneholder støtende ord og kunne ikke sendes. Vennligst oppdater assistentnavnet ditt."},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Beskrivelsen din inneholder støtende ord og kunne ikke sendes. Vennligst oppdater beskrivelsen din."},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Instruksjonene dine inneholder støtende ord og kunne ikke sendes. Vennligst oppdater instruksjonene dine."},com_ui_select_search_model:{english:"Search model by name",translated:"Søk modell etter navn"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Søk plugin etter navn"},com_ui_use_prompt:{english:"Use prompt",translated:"Bruk prompt"},com_ui_prev:{english:"Prev",translated:"Forrige"},com_ui_next:{english:"Next",translated:"Neste"},com_ui_stop:{english:"Stop",translated:"Stopp"},com_ui_upload_files:{english:"Upload files",translated:"Last opp filer"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Promptmaler"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Skjul promptmaler"},com_ui_showing:{english:"Showing",translated:"Viser"},com_ui_of:{english:"of",translated:"av"},com_ui_entries:{english:"Entries",translated:"Oppføringer"},com_ui_none_selected:{english:"None selected",translated:"Ingen valgt"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Fil lastet opp"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Det oppsto en feil ved opplasting av filen din"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Ugyldig fil for opplasting. Må være et bilde som ikke overstiger 2 MB"},com_ui_thinking:{english:"Thinking",translated:"Tenker"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Analyserer forespørselen din"},com_ui_processing:{english:"Putting it together",translated:"Behandler"},com_ui_working_on_it:{english:"Almost ready",translated:"Jobber med det"},com_ui_cancel:{english:"Cancel",translated:"Avbryt"},com_ui_save:{english:"Save",translated:"Lagre"},com_user_message:{english:"You",translated:"Du"},com_ui_read_aloud:{english:"Read aloud",translated:"Les høyt"},com_ui_copied:{english:"Copied!",translated:"Kopiert!"},com_ui_copy_code:{english:"Copy code",translated:"Kopier kode"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Kopier til utklippstavle"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Kopiert til utklippstavle"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Nevn en endepunkt, assistent eller forhåndsinnstilling for å bytte raskt"},com_ui_regenerate:{english:"Regenerate",translated:"Regenerer"},com_ui_edit:{english:"Edit",translated:"Rediger"},com_ui_all:{english:"all",translated:"alle"},com_ui_clear:{english:"Clear",translated:"Tøm"},com_ui_import_conversation:{english:"Import",translated:"Importer"},com_ui_nothing_found:{english:"Nothing found",translated:"Ingenting funnet"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Gå til samtale"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Importer samtaler fra en JSON-fil"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Samtaler importert"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Det oppsto en feil ved import av samtalene dine"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Ikke støttet importtype"},com_ui_confirm_action:{english:"Confirm Action",translated:"Bekreft handling"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Ukjent"},com_ui_result:{english:"Result",translated:"Resultat"},com_ui_image_gen:{english:"Image Gen",translated:"Bildegen."},com_ui_assistant:{english:"Assistant",translated:"Assistent"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Assistenten ble slettet"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Feil ved sletting av assistenten"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Duplikatfil oppdaget."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Feil ved opplasting av fil."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Feil ved opplasting av fil: Endepunkt er udefinert"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Tomme filer er ikke tillatt."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Du kan kun laste opp {0} filer om gangen."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Du kan kun laste opp {0} filer i denne seksjonen."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Opplastingsgrensen er nådd for {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Kan ikke bestemme filtype for: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Filtype støttes ikke. Vennligst last opp et støttet filformat."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Kunne ikke laste bilde"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Foreløpig støttes kun JPEG, JPG, PNG og WEBP filer."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Filstørrelsen overskrider {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Den totale størrelsen på filene kan ikke overskride {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Feil ved validering av fil."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Feil ved behandling av fil."},com_ui_assistants:{english:"Assistants",translated:"Assistenter"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Studiohjelp"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Kunnskap"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Ukategorisert"},com_ui_attachment:{english:"Attachment",translated:"Vedlegg"},com_ui_assistants_output:{english:"Assistants Output",translated:"Assistenters utdata"},com_ui_delete:{english:"Delete",translated:"Slett"},com_ui_create:{english:"Create",translated:"Opprett"},com_ui_share:{english:"Share",translated:"Del"},com_ui_copy_link:{english:"Copy link",translated:"Kopier lenke"},com_ui_update_link:{english:"Update link",translated:"Oppdater lenke"},com_ui_create_link:{english:"Create link",translated:"Opprett lenke"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Del lenke til chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"Det oppstod en feil ved deling av chat-lenken"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Navnet ditt og eventuelle meldinger du legger til etter deling forblir private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"En offentlig lenke til chatten din er opprettet. Administrer tidligere delte chatter når som helst via Innstillinger."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Navnet ditt, tilpassede instruksjoner og eventuelle meldinger du legger til etter deling forblir private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"En offentlig lenke til chatten din er oppdatert. Administrer tidligere delte chatter når som helst via Innstillinger."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Delt lenke ikke funnet"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Slett chat?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Dette vil slette"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Er du sikker på at du vil slette denne assistenten? Dette kan ikke angres."},com_ui_rename:{english:"Rename",translated:"Gi nytt navn"},com_ui_more_options:{english:"More",translated:"Mer"},com_ui_preview:{english:"Preview",translated:"Forhåndsvisning"},com_ui_upload:{english:"Upload",translated:"Last opp"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Opplasting av "{0}" tar lengre tid enn forventet. Vennligst vent mens filen ferdigstilles for henting.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Personvernregler"},com_ui_terms_of_service:{english:"Terms of service",translated:"Vilkår for bruk"},com_ui_use_micrphone:{english:"Use microphone",translated:"Bruk mikrofon"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Kan ikke fjerne flere verdier, minst {0} kreves."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Maksimalt antall er {0}, bruker siste verdier."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Kan ikke logge inn med de oppgitte opplysningene. Sjekk legitimasjonen din og prøv igjen."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Du har overskredet antall tillatte innloggingsforsøk. Prøv igjen om 15 minutter."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Kontoen din er midlertidig utestengt på grunn av brudd på våre vilkår."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Det oppsto en intern serverfeil. Vent noen øyeblikk og prøv igjen."},com_auth_sign_in:{english:"Login",translated:"Logg inn"},com_endpoint_system_message:{english:"System Message",translated:"Systemmelding"},com_endpoint_message:{english:"Message",translated:"Melding"},com_endpoint_messages:{english:"Messages",translated:"Meldinger"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Rediger meldingen din eller generer på nytt."},com_endpoint_default_blank:{english:"default: blank",translated:"standard: tom"},com_endpoint_default_false:{english:"default: false",translated:"standard: falsk"},com_endpoint_default_creative:{english:"default: creative",translated:"standard: kreativ"},com_endpoint_default_empty:{english:"default: empty",translated:"standard: tom"},com_endpoint_default_with_num:{english:"default: {0}",translated:"standard: {0}"},com_endpoint_context:{english:"Context",translated:"Kontekst"},com_endpoint_tone_style:{english:"Tone Style",translated:"Tone stil"},com_endpoint_token_count:{english:"Token count",translated:"Antall token"},com_endpoint_output:{english:"Output",translated:"Utdata"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Maks konteksttokens"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Maksimalt antall tokens som kan brukes for kontekst. Bruk dette for å kontrollere hvor mange tokens som sendes per forespørsel.
  Hvis ikke spesifisert, vil systemstandarder basert på kjente modellers kontekststørrelse brukes. Å sette høyere verdier kan resultere i feil og/eller høyere tokenkostnad.`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Sett tilpassede instruksjoner eller kontekst. Ignoreres hvis tom."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Overstyrer assistentens instruksjoner. Nyttig for å endre oppførsel per kjøring."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Sett tilleggsinstruksjoner eller kontekst oppå assistentens hovedinstruksjoner. Ignoreres hvis tom."},com_endpoint_custom_name:{english:"Custom Name",translated:"Egendefinert navn"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Egendefinerte instruksjoner"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Tilleggsinstruksjoner"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Overstyr instruksjoner"},com_endpoint_temperature:{english:"Temperature",translated:"Temperatur"},com_endpoint_default:{english:"default",translated:"standard"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Maks utgangstokens"},com_endpoint_stop:{english:"Stop Sequences",translated:"Stoppsekvenser"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Skill verdier med `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Valgfelt `max_tokens`, som representerer maksimalt antall tokens som kan genereres i chat fullføringen.\n\nDen totale lengden på inndata-tokens og genererte tokens er begrenset av modellens kontektslengde. Du kan oppleve feil hvis dette tallet overstiger maks kontekts-tokens."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Høyere verdier = mer tilfeldig, mens lavere verdier = mer fokusert og deterministisk. Vi anbefaler å endre dette eller Top P, men ikke begge."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Maks tokens å generere. Den totale lengden på inndata-tokens og genererte tokens er begrenset av modellens kontektslengde."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Et alternativ til sampling med temperatur, kalt nucleus sampling, der modellen vurderer resultatene av tokens med top_p sannsynlighetsmasse. Så 0.1 betyr at bare tokens som utgjør de øverste 10% sannsynlighetsmassen vurderes. Vi anbefaler å endre dette eller temperatur, men ikke begge."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Nummer mellom 0 og 2.0. Positive verdier straffer nye tokens basert på deres eksisterende frekvens i teksten så langt, noe som reduserer modellens sannsynlighet for å gjenta samme linje ordrett."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Nummer mellom 0 og 2.0. Positive verdier straffer nye tokens basert på om de vises i teksten så langt, noe som øker modellens sannsynlighet for å snakke om nye emner."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Send alle tidligere vedlagte filer på nytt. Merk: dette vil øke token-kostnaden, og du kan oppleve feil med mange vedlegg."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Oppløsningen for Vision-forespørsler. "Lav" er billigere og raskere, "Høy" er mer detaljert og kostbar, og "Auto" vil automatisk velge mellom de to basert på bildekvaliteten.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Opptil 4 sekvenser der API-en vil stoppe å generere flere tokens."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Sett et egendefinert navn for iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Sett egendefinerte instruksjoner for å inkludere i systemmeldingen. Standard: ingen"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Frekvensstraff"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Tilstedeværelsesstraff"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Bruk funksjoner"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Send filer på nytt"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Bildedetalj"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Hopp over fullføring"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Sett egendefinerte instruksjoner i systemmelding. Standard: ingen"},com_endpoint_import:{english:"Import",translated:"Importer"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Sett et egendefinert navn, i tilfelle du finner denne forhåndsinnstillingen"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Er du sikker på at du vil slette denne forhåndsinnstillingen?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Forhåndsinnstilling importert!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Det oppstod en feil ved import av forhåndsinnstillingen. Vennligst prøv igjen."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Det oppstod en feil ved lagring av forhåndsinnstillingen. Vennligst prøv igjen."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Det oppstod en feil ved sletting av forhåndsinnstillingen. Vennligst prøv igjen."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"er ikke lenger standard forhåndsinnstilling."},com_endpoint_preset_default_item:{english:"Default:",translated:"Standard:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Ingen standard forhåndsinnstilling aktiv."},com_endpoint_pr