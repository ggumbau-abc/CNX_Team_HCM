gorized:{english:"Uncategorized",translated:"Necategorizat"},com_ui_attachment:{english:"Attachment",translated:"Atașament"},com_ui_assistants_output:{english:"Assistants Output",translated:"Rezultatul asistenților"},com_ui_delete:{english:"Delete",translated:"Șterge"},com_ui_create:{english:"Create",translated:"Creează"},com_ui_share:{english:"Share",translated:"Distribuie"},com_ui_copy_link:{english:"Copy link",translated:"Copiază link"},com_ui_update_link:{english:"Update link",translated:"Actualizează link"},com_ui_create_link:{english:"Create link",translated:"Creează link"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Distribuie link în chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"A apărut o eroare la partajarea linkului de chat"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Numele tău și orice mesaje adăugate după partajare rămân private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"Un link public către chatul tău a fost creat. Gestionează chaturile partajate anterior oricând prin Setări."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Numele tău, instrucțiunile personalizate și orice mesaje adăugate după partajare rămân private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"Un link public către chatul tău a fost actualizat. Gestionează chaturile partajate anterior oricând prin Setări."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Linkul partajat nu a fost găsit"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Șterge chat?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Acest lucru va șterge"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Ești sigur că vrei să ștergi acest asistent? Aceasta nu poate fi anulată."},com_ui_rename:{english:"Rename",translated:"Redenumește"},com_ui_more_options:{english:"More",translated:"Mai multe"},com_ui_preview:{english:"Preview",translated:"Previzualizare"},com_ui_upload:{english:"Upload",translated:"Încarcă"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Încărcarea "{0}" durează mai mult decât anticipat. Vă rugăm să așteptați în timp ce fișierul finalizează indexarea pentru recuperare.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Politica de confidențialitate"},com_ui_terms_of_service:{english:"Terms of service",translated:"Termeni de serviciu"},com_ui_use_micrphone:{english:"Use microphone",translated:"Folosește microfonul"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Nu se pot elimina mai multe valori, sunt necesare minimum {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Numărul maxim permis este {0}, folosind ultimele valori."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Nu se poate conecta cu informațiile furnizate. Verificați datele de autentificare și încercați din nou."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Ați depășit numărul de încercări de autentificare permise. Încercați din nou peste 15 minute."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Contul dvs. a fost suspendat temporar din cauza încălcării serviciului nostru."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"A apărut o eroare internă a serverului. Așteptați câteva momente și încercați din nou."},com_auth_sign_in:{english:"Login",translated:"Autentificare"},com_endpoint_system_message:{english:"System Message",translated:"Mesaj de sistem"},com_endpoint_message:{english:"Message",translated:"Mesaj"},com_endpoint_messages:{english:"Messages",translated:"Mesaje"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Editați mesajul sau Regenerați."},com_endpoint_default_blank:{english:"default: blank",translated:"implicit: gol"},com_endpoint_default_false:{english:"default: false",translated:"implicit: fals"},com_endpoint_default_creative:{english:"default: creative",translated:"implicit: creativ"},com_endpoint_default_empty:{english:"default: empty",translated:"implicit: gol"},com_endpoint_default_with_num:{english:"default: {0}",translated:"implicit: {0}"},com_endpoint_context:{english:"Context",translated:"Context"},com_endpoint_tone_style:{english:"Tone Style",translated:"Stil tonal"},com_endpoint_token_count:{english:"Token count",translated:"Număr de tokeni"},com_endpoint_output:{english:"Output",translated:"Rezultat"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Maxim tokeni context"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:"Numărul maxim de tokeni care pot fi folosiți pentru context. Folosiți acest lucru pentru a controla câți tokeni sunt trimiși per cerere. Dacă nu este specificat, se vor folosi valorile implicite ale sistemului bazate pe dimensiunea contextului modelelor cunoscute. Setarea unor valori mai mari poate duce la erori și/sau costuri mai mari de tokeni."},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Setați instrucțiuni sau context personalizat. Ignorat dacă este gol."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Suprascrie instrucțiunile asistentului. Util pentru modificarea comportamentului pe fiecare rulare."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Setează instrucțiuni sau context suplimentar peste instrucțiunile principale ale asistentului. Ignorat dacă este gol."},com_endpoint_custom_name:{english:"Custom Name",translated:"Nume Personalizat"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Instrucțiuni Personalizate"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Instrucțiuni Suplimentare"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Suprascrie Instrucțiunile"},com_endpoint_temperature:{english:"Temperature",translated:"Temperatură"},com_endpoint_default:{english:"default",translated:"implicit"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Maxim Tokeni de Ieșire"},com_endpoint_stop:{english:"Stop Sequences",translated:"Secvențe de Oprire"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Separă valorile apăsând `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Câmp opțional `max_tokens`, reprezentând numărul maxim de tokeni care pot fi generați în completarea chatului.\n\nLungimea totală a tokenilor de intrare și a celor generați este limitată de lungimea contextului modelului. Pot apărea erori dacă acest număr depășește numărul maxim de tokeni de context."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Valori mai mari = mai aleatoriu, în timp ce valori mai mici = mai concentrat și determinist. Recomandăm modificarea acestuia sau a Top P, dar nu ambele."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Numărul maxim de tokeni de generat. Lungimea totală a tokenilor de intrare și a celor generați este limitată de lungimea contextului modelului."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"O alternativă la eșantionarea cu temperatură, numită eșantionare de nucleu, unde modelul ia în considerare rezultatele tokenilor cu masa de probabilitate top_p. Astfel, 0.1 înseamnă că sunt luați în considerare doar tokenii care cuprind masa de probabilitate de top 10%. Recomandăm modificarea acestuia sau a temperaturii, dar nu ambele."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Număr între 0 și 2.0. Valorile pozitive penalizează noii tokeni pe baza frecvenței lor existente în text până acum, reducând probabilitatea modelului de a repeta aceeași linie textuală."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Număr între 0 și 2.0. Valorile pozitive penalizează noii tokeni pe baza apariției lor în text până acum, crescând probabilitatea modelului de a discuta despre subiecte noi."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Retrimite toate fișierele atașate anterior. Notă: aceasta va crește costul tokenilor și pot apărea erori cu multe atașamente."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Rezoluția pentru cererile Vision. "Low" este mai ieftin și mai rapid, "High" este mai detaliat și costisitor, iar "Auto" va alege automat între cele două în funcție de rezoluția imaginii.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Până la 4 secvențe unde API-ul va opri generarea de tokeni suplimentari."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Setează un nume personalizat pentru iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Setează instrucțiuni personalizate pentru a fi incluse în Mesajul Sistemului. Implicit: niciunul"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Penalizare Frecvență"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Penalizare Prezență"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Folosește Funcții"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Retrimite Fișiere"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Detalii Imagine"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Sari Peste Finalizare"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Setează instrucțiuni personalizate pentru a include în Mesajul Sistemului. Implicit: niciuna"},com_endpoint_import:{english:"Import",translated:"Importă"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Setează un nume personalizat, în caz că poți găsi acest preset"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Ești sigur că vrei să ștergi acest preset?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Preset Importat!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"A apărut o eroare la importarea presetului. Te rugăm să încerci din nou."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"A apărut o eroare la salvarea presetului. Te rugăm să încerci din nou."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"A apărut o eroare la ștergerea presetului. Te rugăm să încerci din nou."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"nu mai este presetul implicit."},com_endpoint_preset_default_item:{english:"Default:",translated:"Implicit:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Niciun preset implicit activ."},com_endpoint_preset_title:{english:"Preset",translated:"Preset"},com_endpoint_preset_saved:{english:"Saved!",translated:"Salvat!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"este acum presetul implicit."},com_endpoint_preset:{english:"preset",translated:"preset"},com_endpoint_presets:{english:"presets",translated:"presete"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Activ!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Nume Preset"},com_endpoint:{english:"Endpoint",translated:"Endpoint"},com_endpoint_examples:{english:" Presets",translated:" Presete"},com_endpoint_export:{english:"Export",translated:"Exportă"},com_endpoint_export_share:{english:"Export/Share",translated:"Exportă/Distribuie"},com_endpoint_assistant:{english:"Assistant",translated:"Asistent"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Folosește Asistentul Activ"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Salvează ca Presetare"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Sigur vrei să ștergi toate presetările? Acest lucru este ireversibil."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Nicio presetare încă, folosește butonul de setări pentru a crea una"},com_endpoint_my_preset:{english:"My Preset",translated:"Presetarea Mea"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Model Agent (Recomandat: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Model Completare (Recomandat: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Activează utilizarea Pluginurilor ca Funcții OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Activează săritul peste pasul de completare, care revizuiește răspunsul final și pașii generați"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Te rog selectează un Asistent și începe un nou chat"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Setează-ți Cheia în meniul Header pentru a conversa."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Te rog selectează un Asistent"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Bine ai venit la iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Text în Vorbire"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Redare Automată Mesaj Recent"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Vorbire în Text"},com_nav_profile_picture:{english:"Profile Picture",translated:"Poză de Profil"},com_nav_change_picture:{english:"Change picture",translated:"Schimbă poza"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Afișează Setările Agentului"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Afișează Setările de Completare"},com_hide_examples:{english:"Hide Examples",translated:"Ascunde Exemplele"},com_show_examples:{english:"Show Examples",translated:"Afișează Exemplele"},com_nav_export_filename:{english:"Filename",translated:"Nume fișier"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Setează numele fișierului"},com_nav_export_type:{english:"Type",translated:"Tip"},com_nav_export_conversation:{english:"Export conversation",translated:"Exportă conversația"},com_nav_export:{english:"Export",translated:"Exportă"},com_nav_shared_links:{english:"Shared links",translated:"Linkuri partajate"},com_nav_shared_links_manage:{english:"Manage",translated:"Gestionează"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Nu aveți linkuri partajate."},com_nav_shared_links_name:{english:"Name",translated:"Nume"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Data partajării"},com_nav_source_chat:{english:"View source chat",translated:"Vezi chatul sursă"},com_nav_my_files:{english:"File Manager",translated:"Manager fișiere"},com_nav_admin_center:{english:"Admin Center",translated:"Centrul de administrare"},com_nav_theme:{english:"Theme",translated:"Temă"},com_nav_theme_system:{english:"System",translated:"Sistem"},com_nav_theme_dark:{english:"Dark",translated:"Întunecat"},com_nav_theme_light:{english:"Light",translated:"Luminos"},com_nav_user_name_display:{english:"Display username in messages",translated:"Afișează numele de utilizator în mesaje"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Șterge toate chat-urile"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Confirmă ștergerea"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Închide bara laterală"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Deschide bara laterală"},com_nav_send_message:{english:"Send message",translated:"Trimite mesaj"},com_nav_log_out:{english:"Log out",translated:"Deconectează-te"},com_nav_user:{english:"USER",translated:"UTILIZATOR"},com_nav_archived_chats:{english:"Archived chats",translated:"Conversații arhivate"},com_nav_archived_chats_manage:{english:"Manage",translated:"Gestionează"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Nu aveți conversații arhivate."},com_nav_archive_name:{english:"Name",translated:"Nume"},com_nav_archive_created_at:{english:"DateCreated",translated:"DataCreării"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Șterge conversațiile"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Sigur doriți să ștergeți toate conversațiile? Acest lucru este ireversibil."},com_nav_help:{english:"Help",translated:"Ajutor"},com_nav_user_guide:{english:"User Guide",translated:"Ghidul utilizatorului"},com_nav_settings:{english:"Settings",translated:"Setări"},com_nav_search_placeholder:{english:"Search messages",translated:"Caută mesaje"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Trimitere automată text (după 3 sec)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Eroare la redarea audio: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Eroare la procesarea audio: {0}"},com_nav_engine:{english:"Engine",translated:"Motor"},com_nav_browser:{english:"Browser",translated:"Browser"},com_nav_external:{english:"External",translated:"Extern"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Șterge memoria cache"},com_nav_voice_select:{english:"Voice",translated:"Voce"},com_nav_setting_general:{english:"General",translated:"General"},com_nav_setting_speech:{english:"Speech",translated:"Vorbire"},com_nav_language:{english:"Language",translated:"Limbă"},com_nav_lang_auto:{english:"Auto detect",translated:"Detectare automată"},com_page_not_found:{english:"Page not found",translated:"Pagină negăsită"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Ceva a mers prost"},com_unauthorized_access:{english:"Unauthorized access",translated:"Acces neautorizat"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Acces neautorizat. Accesul este restricționat la domenii specifice."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Contul tău a fost suspendat temporar din cauza încălcărilor serviciului nostru"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Accesul la aplicație este restricționat în afara rețelei!"},com_support_ticket_text:{english:"Support Ticket",translated:"Tichet de Suport"},com_help_dialog_Header:{english:"Need assistance?",translated:"Ai nevoie de asistență?"},com_help_dialog_text_1_1:{english:"Click",translated:"Apasă"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"pentru instrucțiuni detaliate"},com_help_dialog_text_here:{english:"here",translated:"aici"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Pentru probleme, completează un"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Pentru probleme, contactează"},com_help_dialog_text_ticket:{english:"ticket",translated:"tichet"},com_help_dialog_text_3:{english:"Find the steps",translated:"Găsește pașii"},com_status_ind_none:{english:"Operational",translated:"Operațional"},com_status_ind_minor:{english:"Minor Issues",translated:"Probleme Minore"},com_status_ind_major:{english:"Major Issues",translated:"Probleme Majore"},com_status_ind_critical:{english:"Critical",translated:"Critic"},com_status_ind_error:{english:"Error Fetching",translated:"Eroare la preluare"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Reține că atunci când părăsești un chat sau începi unul nou, vei pierde istoricul conversației."},com_forbidden_access:{english:"Forbidden access",translated:"Acces interzis"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Politica de utilizare acceptabilă"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Politica de confidențialitate"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Acord de abonament"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Înainte de a folosi iX Hello, poți revizui "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Prin înscriere și/sau accesare, ești de acord cu termenii de mai sus."},com_login_page_and:{english:"and ",translated:"și "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Niciun asistent fixat"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Asistenți fixați"},com_ui_loading:{english:"Loading...",translated:"Se încarcă..."},com_ui_unpin:{english:"Unpin",translated:"Anulează fixarea"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Asistentul a fost defixat cu succes"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Eroare la anularea fixării asistentului"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Asistent fixat cu succes"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Eroare la fixarea/anularea fixării asistentului"},com_ui_pin:{english:"Pin",translated:"Fixează"},come_create_assistant:{english:"Create Assistant",translated:"Creează Asistent"},come_edit_assistant:{english:"Edit Assistant",translated:"Editează Asistent"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Ești sigur că vrei să continui? Aceasta va duce la pierderea oricăror modificări făcute asistentului pe care îl editezi sau creezi în prezent. Această acțiune nu poate fi anulată."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Asistentul cu id-ul {0} nu a fost găsit."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Browserul nu suportă SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Permisiunea pentru microfon nu a fost acordată"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Eroare la pornirea înregistrării: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder nu înregistrează"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder nu este suportat în acest browser"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Mesajul tău conține informații personale și nu a putut fi trimis. Te rugăm să elimini orice informație personală."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Redenumirea conversației a eșuat"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Ai {0} din tokenurile alocate rămase."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello poate face greșeli. Te rugăm să verifici toate rezultatele pentru calitate și acuratețe. Toate intrările sunt înregistrate pentru conformitate."},com_ui_assistant_group_by:{english:"Group by",translated:"Grupează după"},com_ui_assistant_category:{english:"Category",translated:"Categorie"},com_ui_assistant_team:{english:"Team",translated:"Echipă"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Inginerie"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Inteligență"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Operațiuni"},com_ui_assistant_sales:{english:"Sales",translated:"Vânzări"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategie"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Asistenți Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Încarcă o imagine avatar (PNG sau JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Caută Online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Navighează Website"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Generează Imagini"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Calculează Matematic"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Instrument Implicit"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Încărcarea fișierului durează mai mult decât se aștepta. Vă rugăm să încercați din nou."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Eroare la fixarea asistentului"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"A apărut o eroare la ștergerea linkului partajat"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Șablon DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Niciun preset implicit activ."},com_ui_drag_drop_title:{english:"Add anything",translated:"Adaugă orice"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Trageți orice fișier aici pentru a-l adăuga la conversație"},com_ui_analyzing:{english:"Analyzing",translated:"Analizând"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Analiza finalizată"},com_ui_warning:{english:"Warning",translated:"Avertisment"},com_ui_proceed:{english:"Proceed",translated:"Continuați"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Fișierele încărcate la asistent sunt folosite doar în scopuri conversaționale. Utilizatorii pot accesa conținutul acestor fișiere prin întrebări relevante, dar descărcarea directă a fișierelor nu este permisă."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Setați un nume personalizat pentru acest preset"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Setați un exemplu de intrare. Exemplul este ignorat dacă este gol."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Setați un exemplu de ieșire. Exemplul este ignorat dacă este gol."},com_nav_export_select_type:{english:"Select a file type",translated:"Selectați un tip de fișier"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"captură de ecran (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"text (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Nu s-a primit niciun răspuns. Vă rugăm să încercați să trimiteți din nou mesajul. Dacă problema persistă după reîncărcarea paginii și reîncercare, vă rugăm să contactați suportul."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Înapoi la Chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Moderare Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Moderarea guardrail este activată pentru acest asistent. Conținutul va fi verificat conform politicilor de moderare."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Dezactivarea moderării guardrail elimină verificările de moderare a conținutului pentru acest asistent. Sunteți responsabil pentru respectarea politicilor de conținut ale organizației. Activitatea este complet înregistrată și monitorizată."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Vă rugăm să explicați justificarea dvs. de afaceri pentru dezactivarea moderării guardrail (obligatoriu)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Vă rugăm să furnizați o justificare pentru dezactivarea moderării guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Permite utilizatorilor să schimbe modelul în chat"},com_ui_feedback_good:{english:"Good response",translated:"Răspuns bun"},com_ui_feedback_bad:{english:"Poor response",translated:"Răspuns slab"},com_ui_feedback_comments:{english:"Comments",translated:"Comentarii"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Comentarii (opțional)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Spune-ne mai multe despre experiența ta..."},com_ui_feedback_submit:{english:"Submit",translated:"Trimite"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Nu am putut trimite feedback-ul tău"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Incorect"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Nu este relevant"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Depășit"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Detalii insuficiente"},com_ui_feedback_reason_other:{english:"Other",translated:"Altele"},com_ui_model_recommended:{english:"Recommended",translated:"Recomandat"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Legacy — vă rugăm să actualizați"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Acest model nu mai este acceptat. Vă rugăm să selectați un model actual."},com_nav_setting_memory:{english:"Memory",translated:"Memorie"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Gestionați informațiile personale pe care asistentul le reține în conversațiile dvs."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Adăugați o nouă memorie..."},com_nav_memory_add_button:{english:"Add memory",translated:"Adăugați memorie"},com_nav_memory_category:{english:"Category",translated:"Categorie"},com_nav_memory_category_preference:{english:"Preference",translated:"Preferință"},com_nav_memory_category_identity:{english:"Identity",translated:"Identitate"},com_nav_memory_category_context:{english:"Context",translated:"Context"},com_nav_memory_category_project:{english:"Project",translated:"Proiect"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Nicio memorie încă"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Memoriile salvate vor apărea aici și vor ajuta la personalizarea conversațiilor viitoare."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Nu s-au putut încărca memoriile. Vă rugăm să încercați din nou."},com_nav_memory_retry:{english:"Retry",translated:"Reîncercați"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Nu s-a putut adăuga memoria. Vă rugăm să încercați din nou."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Nu s-a putut actualiza memoria. Vă rugăm să încercați din nou."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Nu s-a putut șterge memoria. Vă rugăm să încercați din nou."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Ștergeți această memorie?"},com_nav_memory_delete_button:{english:"Delete",translated:"Ștergeți"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Editați memoria"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Ștergeți memoria"},com_nav_memory_save:{english:"Save",translated:"Salvați"},com_nav_memory_cancel:{english:"Cancel",translated:"Anulați"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Salvat {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — cel mai recent model de gândire GPT-5 cu inteligență de frontieră."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — variantă compactă și economică a GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — cel mai recent model din generația GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Ultimul Opus — inteligență de vârf pentru agenți de codare și fluxuri de lucru enterprise."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Ultimul Opus — inteligență de vârf pentru agenți de codare și fluxuri de lucru enterprise."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet îmbunătățit cu raționament și urmărire a instrucțiunilor mai bune."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Cel mai puternic model al Anthropic pentru sarcini complexe, multi-etape."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Inteligență și viteză echilibrate pentru o gamă largă de sarcini."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Cel mai rapid și compact model Claude — ideal pentru sarcini cu debit mare."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — raționament îmbunătățit și capabilități multimodale."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Modelul de vârf de generație următoare al OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 ușor — eficient și rapid pentru sarcini zilnice."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — urmărire a instrucțiunilor și raționament îmbunătățite."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 compact — mai rapid și mai ieftin pentru sarcini simple."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Cel mai capabil model GPT-4, optimizat pentru viteză și cost."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o ușor — mai rapid și mai ieftin pentru sarcini simple."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Previzualizare) — cel mai capabil model Gemini cu context de 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Previzualizare) — rapid și eficient cu context de 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — model ușor cu latență redusă și context de 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Model intern optimizat pentru asistență vocală."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto selectează cel mai bun model pentru cererea dvs. pe baza capacității și performanței."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"În curând"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Preferințe de rutare automată"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Ajustați modul în care routerul Auto echilibrează compromisurile la selectarea unui model pentru fiecare tură. Ponderile sunt normalizate — contează echilibrul relativ."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Cost"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Favorizează modelele mai ieftine, cu cost mai mic per token."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Acuratețe"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Favorizează modelele mai puternice pentru raționamente complexe."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Viteză"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Favorizează modelele mai rapide, cu latență mai mică."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Resetează la valorile implicite"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Încărcarea fișierului a expirat. Vă rugăm să încercați din nou peste câteva minute."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Ceva nu a mers bine. Iată mesajul de eroare specific întâlnit: A apărut o eroare la procesarea cererii tale. Asistentul nu mai este disponibil. Te rugăm să contactezi administratorul."},com_ui_code:{english:"Code",translated:"Cod"},com_ui_assistant_share:{english:"Share",translated:"Partajează"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Link copiat"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Nu aveți acces la acest asistent"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Nu s-a putut copia linkul în clipboard"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Previzualizare indisponibilă — generarea conținutului nu a fost finalizată."},com_ui_view_code:{english:"View code",translated:"Vezi codul"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Previzualizare indisponibilă — conținut invalid."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Număr de telefon"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Adresă de email"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Card de credit"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"CNP"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Încărcarea durează mai mult decât era de așteptat - se reîncearcă ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Problemă de conexiune - se reîncearcă ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Încărcarea a eșuat - vă rugăm să verificați conexiunea și să încercați din nou"},com_assistants_memory_enabled:{english:"Memory",translated:"Memorie"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Memoria este activată pentru acest asistent. Asistentul poate stoca și reaminti informații între conversații."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Memoria este dezactivată pentru acest asistent. Nu vor fi stocate sau reamintite informații între conversații."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Vă rugăm să explicați justificarea de business pentru dezactivarea memoriei (obligatoriu)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Vă rugăm să furnizați o justificare pentru dezactivarea memoriei."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Memoria este dezactivată pentru echipa dvs. Puteți vizualiza și șterge amintirile existente, dar nu puteți adăuga sau edita altele noi."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Rulez codul dvs."},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"Caut în baza de cunoștințe"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Procesez vocea"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"Salvez în memorie"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"Elimin din memorie"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Căutarea pe web s-a încheiat"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Revizuirea paginii web s-a încheiat"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"Imagine generată"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Calculul s-a încheiat"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"Rularea codului dvs. s-a încheiat"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"Căutarea în baza de cunoștințe s-a încheiat"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"Procesarea intrării vocale s-a încheiat"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"Salvat în memorie"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"Eliminat din memorie"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"Încheiat: {0}"},com_ui_still_working:{english:"still working...",translated:"încă lucrez..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} este gata"},com_ui_file_ready_fallback:{english:"File is ready",translated:"Fișierul este gata"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"{0} nu a putut 