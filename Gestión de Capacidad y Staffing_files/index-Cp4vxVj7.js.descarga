ler er ikke tilladt."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Du kan kun uploade op til {0} filer ad gangen."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Du kan kun uploade op til {0} filer i denne sektion."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Uploadgrænsen er nået for {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Kan ikke bestemme filtypen for: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Filtypen understøttes ikke. Upload venligst et understøttet filformat."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Kunne ikke indlæse billede"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Kun JPEG, JPG, PNG og WEBP filer understøttes."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Filstørrelsen overstiger {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Den samlede filstørrelse må ikke overstige {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Der opstod en fejl under filvalidering."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Der opstod en fejl under filbehandling."},com_ui_assistants:{english:"Assistants",translated:"Assistenter"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Studio Assistance"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Viden"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Ukategoriseret"},com_ui_attachment:{english:"Attachment",translated:"Vedhæftning"},com_ui_assistants_output:{english:"Assistants Output",translated:"Assistenters output"},com_ui_delete:{english:"Delete",translated:"Slet"},com_ui_create:{english:"Create",translated:"Opret"},com_ui_share:{english:"Share",translated:"Del"},com_ui_copy_link:{english:"Copy link",translated:"Kopiér link"},com_ui_update_link:{english:"Update link",translated:"Opdater link"},com_ui_create_link:{english:"Create link",translated:"Opret link"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Del link til chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"Der opstod en fejl ved deling af chatlinket"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Dit navn og eventuelle beskeder, du tilføjer efter deling, forbliver private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"Et offentligt link til din chat er blevet oprettet. Administrer tidligere delte chats til enhver tid via Indstillinger."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Dit navn, tilpassede instruktioner og eventuelle beskeder, du tilføjer efter deling, forbliver private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"Et offentligt link til din chat er blevet opdateret. Administrer tidligere delte chats til enhver tid via Indstillinger."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Delt link ikke fundet"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Slet chat?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Dette vil slette"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Er du sikker på, at du vil slette denne Assistent? Dette kan ikke fortrydes."},com_ui_rename:{english:"Rename",translated:"Omdøb"},com_ui_more_options:{english:"More",translated:"Mere"},com_ui_preview:{english:"Preview",translated:"Forhåndsvisning"},com_ui_upload:{english:"Upload",translated:"Upload"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Upload af "{0}" tager længere tid end forventet. Vent venligst, mens filen færdiggøres til hentning.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Privatlivspolitik"},com_ui_terms_of_service:{english:"Terms of service",translated:"Servicevilkår"},com_ui_use_micrphone:{english:"Use microphone",translated:"Brug mikrofon"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Kan ikke fjerne flere værdier, mindst {0} kræves."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Maksimalt tilladt antal er {0}, bruger nyeste værdier."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Kan ikke logge ind med de angivne oplysninger. Tjek dine legitimationsoplysninger og prøv igen."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Du har overskredet antallet af tilladte loginforsøg. Prøv igen om 15 minutter."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Din konto er midlertidigt udelukket på grund af overtrædelser af vores service."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Der opstod en intern serverfejl. Vent et øjeblik og prøv igen."},com_auth_sign_in:{english:"Login",translated:"Log ind"},com_endpoint_system_message:{english:"System Message",translated:"Systemmeddelelse"},com_endpoint_message:{english:"Message",translated:"Meddelelse"},com_endpoint_messages:{english:"Messages",translated:"Meddelelser"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Rediger din meddelelse eller generer igen."},com_endpoint_default_blank:{english:"default: blank",translated:"standard: tom"},com_endpoint_default_false:{english:"default: false",translated:"standard: falsk"},com_endpoint_default_creative:{english:"default: creative",translated:"standard: kreativ"},com_endpoint_default_empty:{english:"default: empty",translated:"standard: tom"},com_endpoint_default_with_num:{english:"default: {0}",translated:"standard: {0}"},com_endpoint_context:{english:"Context",translated:"Kontekst"},com_endpoint_tone_style:{english:"Tone Style",translated:"Tone Stil"},com_endpoint_token_count:{english:"Token count",translated:"Token antal"},com_endpoint_output:{english:"Output",translated:"Output"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Maks. Kontekst Tokens"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Det maksimale antal tokens, der kan bruges til kontekst. Brug dette til at styre, hvor mange tokens der sendes pr. forespørgsel.
  Hvis ikke angivet, vil systemstandarder blive brugt baseret på kendte modellers kontekststørrelse. Indstilling af højere værdier kan resultere i fejl og/eller højere tokenomkostninger.`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Indstil brugerdefinerede instruktioner eller kontekst. Ignoreres hvis tom."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Tilsidesætter assistentens instruktioner. Dette er nyttigt til at ændre adfærden pr. kørsel."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Angiv yderligere instruktioner eller kontekst oven på assistentens hovedinstruktioner. Ignoreres hvis tom."},com_endpoint_custom_name:{english:"Custom Name",translated:"Brugertilpasset Navn"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Brugerdefinerede Instruktioner"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Yderligere Instruktioner"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Tilsidesæt Instruktioner"},com_endpoint_temperature:{english:"Temperature",translated:"Temperatur"},com_endpoint_default:{english:"default",translated:"standard"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Maks Output Tokens"},com_endpoint_stop:{english:"Stop Sequences",translated:"Stop Sekvenser"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Adskil værdier ved at trykke `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Valgfrit `max_tokens` felt, der repræsenterer det maksimale antal tokens, der kan genereres i chat-komplettering.\n    \n    Den samlede længde af inputtokens og genererede tokens er begrænset af modellens kontekstdybde. Du kan opleve fejl, hvis dette tal overstiger de maksimale konteksttokens."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Højere værdier = mere tilfældig, mens lavere værdier = mere fokuseret og deterministisk. Vi anbefaler at ændre dette eller Top P, men ikke begge."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Maksimalt antal tokens, der skal genereres. Den samlede længde af inputtokens og genererede tokens er begrænset af modellens kontekstdybde."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Et alternativ til sampling med temperatur, kaldet nucleus sampling, hvor modellen overvejer resultaterne af tokens med top_p sandsynlighedsmassen. Så 0,1 betyder, at kun tokens, der udgør de øverste 10% sandsynlighedsmassen, overvejes. Vi anbefaler at ændre dette eller temperatur, men ikke begge."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Tal mellem 0 og 2,0. Positive værdier straffer nye tokens baseret på deres eksisterende frekvens i teksten indtil nu, hvilket mindsker modellens sandsynlighed for at gentage den samme linje ordret."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Tal mellem 0 og 2,0. Positive værdier straffer nye tokens baseret på, om de optræder i teksten indtil nu, hvilket øger modellens sandsynlighed for at tale om nye emner."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Send alle tidligere vedhæftede filer igen. Bemærk: dette vil øge tokenomkostningerne, og du kan opleve fejl med mange vedhæftninger."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Opløsningen for Vision-anmodninger. "Lav" er billigere og hurtigere, "Høj" er mere detaljeret og dyrere, og "Auto" vælger automatisk mellem de to baseret på billedopløsningen.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Op til 4 sekvenser, hvor API'en stopper med at generere yderligere tokens."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Indstil et brugerdefineret navn for iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Indstil brugerdefinerede instruktioner til at inkludere i Systemmeddelelse. Standard: ingen"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Frekvens Straf"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Tilstedeværelsesstraf"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Brug funktioner"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Send filer igen"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Billeddetalje"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Spring over fuldførelse"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Indstil brugerdefinerede instruktioner til systemmeddelelse. Standard: ingen"},com_endpoint_import:{english:"Import",translated:"Importér"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Indstil et brugerdefineret navn, hvis du kan finde denne forudindstilling"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Er du sikker på, at du vil slette denne forudindstilling?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Forudindstilling importeret!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Der opstod en fejl ved import af din forudindstilling. Prøv venligst igen."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Der opstod en fejl ved lagring af din forudindstilling. Prøv venligst igen."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Der opstod en fejl ved sletning af din forudindstilling. Prøv venligst igen."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"er ikke længere standardforudindstillingen."},com_endpoint_preset_default_item:{english:"Default:",translated:"Standard:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Ingen standardforudindstilling aktiv."},com_endpoint_preset_title:{english:"Preset",translated:"Forudindstilling"},com_endpoint_preset_saved:{english:"Saved!",translated:"Gemt!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"er nu standardforudindstillingen."},com_endpoint_preset:{english:"preset",translated:"forudindstilling"},com_endpoint_presets:{english:"presets",translated:"forudindstillinger"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Aktiv!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Forudindstillingsnavn"},com_endpoint:{english:"Endpoint",translated:"Endpoint"},com_endpoint_examples:{english:" Presets",translated:" Forudindstillinger"},com_endpoint_export:{english:"Export",translated:"Eksportér"},com_endpoint_export_share:{english:"Export/Share",translated:"Eksportér/Del"},com_endpoint_assistant:{english:"Assistant",translated:"Assistent"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Brug Aktiv Assistent"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Gem Som Forudindstilling"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Er du sikker på, at du vil slette alle forudindstillinger? Dette kan ikke fortrydes."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Ingen forudindstillinger endnu, brug indstillingsknappen for at oprette en"},com_endpoint_my_preset:{english:"My Preset",translated:"Min Forudindstilling"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Agentmodel (Anbefalet: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Fuldførelsesmodel (Anbefalet: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Aktivér brug af Plugins som OpenAI-funktioner"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Aktivér at springe fuldførelsestrinnet over, som gennemgår det endelige svar og genererede trin"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Vælg venligst en assistent og start en ny chat"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Indstil din nøgle i Hovedmenuen for at chatte."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Vælg venligst en assistent"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Velkommen til iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Tekst til Tale"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Autoplay Seneste Besked"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Tale til Tekst"},com_nav_profile_picture:{english:"Profile Picture",translated:"Profilbillede"},com_nav_change_picture:{english:"Change picture",translated:"Skift billede"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Vis Agentindstillinger"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Vis Fuldførelsesindstillinger"},com_hide_examples:{english:"Hide Examples",translated:"Skjul Eksempler"},com_show_examples:{english:"Show Examples",translated:"Vis Eksempler"},com_nav_export_filename:{english:"Filename",translated:"Filnavn"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Angiv filnavn"},com_nav_export_type:{english:"Type",translated:"Type"},com_nav_export_conversation:{english:"Export conversation",translated:"Eksporter samtale"},com_nav_export:{english:"Export",translated:"Eksporter"},com_nav_shared_links:{english:"Shared links",translated:"Delte links"},com_nav_shared_links_manage:{english:"Manage",translated:"Administrer"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Du har ingen delte links."},com_nav_shared_links_name:{english:"Name",translated:"Navn"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Delingsdato"},com_nav_source_chat:{english:"View source chat",translated:"Vis kildechat"},com_nav_my_files:{english:"File Manager",translated:"Filhåndtering"},com_nav_admin_center:{english:"Admin Center",translated:"Admin Center"},com_nav_theme:{english:"Theme",translated:"Tema"},com_nav_theme_system:{english:"System",translated:"System"},com_nav_theme_dark:{english:"Dark",translated:"Mørk"},com_nav_theme_light:{english:"Light",translated:"Lys"},com_nav_user_name_display:{english:"Display username in messages",translated:"Vis brugernavn i beskeder"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Ryd alle chats"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Bekræft rydning"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Luk sidebjælke"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Åbn sidebjælke"},com_nav_send_message:{english:"Send message",translated:"Send besked"},com_nav_log_out:{english:"Log out",translated:"Log ud"},com_nav_user:{english:"USER",translated:"BRUGER"},com_nav_archived_chats:{english:"Archived chats",translated:"Arkiverede chats"},com_nav_archived_chats_manage:{english:"Manage",translated:"Administrer"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Du har ingen arkiverede samtaler."},com_nav_archive_name:{english:"Name",translated:"Navn"},com_nav_archive_created_at:{english:"DateCreated",translated:"Oprettelsesdato"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Ryd samtaler"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Er du sikker på, at du vil rydde alle samtaler? Dette kan ikke fortrydes."},com_nav_help:{english:"Help",translated:"Hjælp"},com_nav_user_guide:{english:"User Guide",translated:"Brugervejledning"},com_nav_settings:{english:"Settings",translated:"Indstillinger"},com_nav_search_placeholder:{english:"Search messages",translated:"Søg i beskeder"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Send tekst automatisk (efter 3 sek)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Fejl ved afspilning af lyd: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Fejl ved behandling af lyd: {0}"},com_nav_engine:{english:"Engine",translated:"Motor"},com_nav_browser:{english:"Browser",translated:"Browser"},com_nav_external:{english:"External",translated:"Ekstern"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Slet cache-lager"},com_nav_voice_select:{english:"Voice",translated:"Stemme"},com_nav_setting_general:{english:"General",translated:"Generelt"},com_nav_setting_speech:{english:"Speech",translated:"Tale"},com_nav_language:{english:"Language",translated:"Sprog"},com_nav_lang_auto:{english:"Auto detect",translated:"Automatisk registrering"},com_page_not_found:{english:"Page not found",translated:"Side ikke fundet"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Noget gik galt"},com_unauthorized_access:{english:"Unauthorized access",translated:"Uautoriseret adgang"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Uautoriseret adgang. Adgang er begrænset til specifikke domæner."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Din konto er midlertidigt udelukket på grund af overtrædelser af vores service"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Du er begrænset til at få adgang til appen uden for netværket!"},com_support_ticket_text:{english:"Support Ticket",translated:"Supportbillet"},com_help_dialog_Header:{english:"Need assistance?",translated:"Brug for hjælp?"},com_help_dialog_text_1_1:{english:"Click",translated:"Klik"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"for detaljerede instruktioner"},com_help_dialog_text_here:{english:"here",translated:"her"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"For problemer, udfyld en"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"For problemer, kontakt"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Find trinene"},com_status_ind_none:{english:"Operational",translated:"Operationel"},com_status_ind_minor:{english:"Minor Issues",translated:"Mindre problemer"},com_status_ind_major:{english:"Major Issues",translated:"Større problemer"},com_status_ind_critical:{english:"Critical",translated:"Kritisk"},com_status_ind_error:{english:"Error Fetching",translated:"Fejl ved hentning"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Bemærk, at når du forlader en chat eller starter en ny chat, mister du din samtalehistorik."},com_forbidden_access:{english:"Forbidden access",translated:"Adgang forbudt"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Acceptabel brugspolitik"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Privatlivspolitik"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Abonnementsaftale"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Før du bruger iX Hello, kan du gennemgå Concentrix's "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Ved at tilmelde dig og/eller logge ind accepterer du de ovenstående vilkår."},com_login_page_and:{english:"and ",translated:"og "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Ingen fastgjorte assistenter"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Fastgjorte assistenter"},com_ui_loading:{english:"Loading...",translated:"Indlæser..."},com_ui_unpin:{english:"Unpin",translated:"Frigør"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Assistent frigjort med succes"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Fejl ved fjernelse af fastgørelse af assistent"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Assistent fastgjort"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Fejl ved fastgørelse/fjernelse af fastgørelse af assistent"},com_ui_pin:{english:"Pin",translated:"Fastgør"},come_create_assistant:{english:"Create Assistant",translated:"Opret Assistent"},come_edit_assistant:{english:"Edit Assistant",translated:"Rediger Assistent"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Er du sikker på, at du vil fortsætte? Dette vil medføre tab af ændringer foretaget i den assistent, du redigerer eller opretter. Denne handling kan ikke fortrydes."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Assistent med id {0} blev ikke fundet."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Browseren understøtter ikke SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Mikrofontilladelse ikke givet"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Fejl ved start af optagelse: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder optager ikke"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder understøttes ikke i denne browser"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Din besked indeholder personlige oplysninger og kunne ikke sendes. Fjern venligst personlige oplysninger."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Omdøbning af samtale mislykkedes"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Du har {0} af dine tildelte tokens tilbage."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello kan lave fejl. Gennemgå venligst alle output for kvalitet og nøjagtighed. Alle input logges for overholdelse."},com_ui_assistant_group_by:{english:"Group by",translated:"Gruppér efter"},com_ui_assistant_category:{english:"Category",translated:"Kategori"},com_ui_assistant_team:{english:"Team",translated:"Team"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Engineering"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Intelligence"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Operations"},com_ui_assistant_sales:{english:"Sales",translated:"Salg"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategi"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Studioassistenter"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Upload et avatarbillede (PNG eller JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Søg online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Gennemse hjemmeside"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Generer billeder"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Beregn matematik"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Standardværktøj"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Filoverførslen tager længere tid end forventet. Prøv venligst igen."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Fejl ved fastgørelse af assistent"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Der opstod en fejl ved sletning af det delte link"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"DAN-skabelon"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Ingen standard forudindstilling aktiv."},com_ui_drag_drop_title:{english:"Add anything",translated:"Tilføj noget"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Træk en fil her for at tilføje den til samtalen"},com_ui_analyzing:{english:"Analyzing",translated:"Analyserer"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Færdig med at analysere"},com_ui_warning:{english:"Warning",translated:"Advarsel"},com_ui_proceed:{english:"Proceed",translated:"Fortsæt"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Filer uploadet til assistenten bruges kun til samtaleformål. Brugere kan få adgang til indholdet af disse filer ved at stille relevante spørgsmål, men direkte download af filerne er ikke tilladt."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Indstil et brugerdefineret navn til denne forudindstilling"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Indstil eksempelinput. Eksempel ignoreres, hvis tomt."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Indstil eksemplarisk output. Eksempel ignoreres, hvis tomt."},com_nav_export_select_type:{english:"Select a file type",translated:"Vælg en filtype"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"skærmbillede (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"tekst (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Intet svar modtaget. Prøv venligst at sende din besked igen. Hvis problemet fortsætter efter genindlæsning af siden og forsøg igen, kontakt venligst support."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Tilbage til chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Guardrail Moderation"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Guardrail moderation er aktiveret for denne assistent. Indhold vil blive kontrolleret mod moderationspolitikker."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Deaktivering af guardrail moderation fjerner indholdskontrol for denne assistent. Du er ansvarlig for at overholde din organisations indholdspolitikker. Aktivitet logges og overvåges fuldt ud."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Forklar venligst din forretningsbegrundelse for at deaktivere guardrail moderation (påkrævet)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Angiv venligst en begrundelse for at deaktivere guardrail moderation."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Tillad brugere at skifte model i chatten"},com_ui_feedback_good:{english:"Good response",translated:"Godt svar"},com_ui_feedback_bad:{english:"Poor response",translated:"Dårligt svar"},com_ui_feedback_comments:{english:"Comments",translated:"Kommentarer"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Kommentarer (valgfrit)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Fortæl os mere om din oplevelse..."},com_ui_feedback_submit:{english:"Submit",translated:"Indsend"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Vi kunne ikke sende din feedback"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Forkert"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Ikke relevant"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Forældet"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Ikke nok detaljer"},com_ui_feedback_reason_other:{english:"Other",translated:"Andet"},com_ui_model_recommended:{english:"Recommended",translated:"Anbefalet"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Forældet — opdater venligst"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Denne model understøttes ikke længere. Vælg venligst en aktuel model."},com_nav_setting_memory:{english:"Memory",translated:"Hukommelse"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Administrer de personlige fakta, assistenten husker på tværs af dine samtaler."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Tilføj en ny hukommelse…"},com_nav_memory_add_button:{english:"Add memory",translated:"Tilføj hukommelse"},com_nav_memory_category:{english:"Category",translated:"Kategori"},com_nav_memory_category_preference:{english:"Preference",translated:"Præference"},com_nav_memory_category_identity:{english:"Identity",translated:"Identitet"},com_nav_memory_category_context:{english:"Context",translated:"Kontekst"},com_nav_memory_category_project:{english:"Project",translated:"Projekt"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Ingen hukommelser endnu"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Hukommelser, du gemmer, vil vises her og hjælpe med at personalisere fremtidige samtaler."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Kunne ikke indlæse hukommelser. Prøv igen."},com_nav_memory_retry:{english:"Retry",translated:"Prøv igen"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Kunne ikke tilføje hukommelse. Prøv igen."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Kunne ikke opdatere hukommelse. Prøv igen."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Kunne ikke slette hukommelse. Prøv igen."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Slet denne hukommelse?"},com_nav_memory_delete_button:{english:"Delete",translated:"Slet"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Rediger hukommelse"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Slet hukommelse"},com_nav_memory_save:{english:"Save",translated:"Gem"},com_nav_memory_cancel:{english:"Cancel",translated:"Annuller"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Gemt {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — seneste GPT-5-tænkemodel med avanceret intelligens."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — kompakt og omkostningseffektiv GPT-5.4 variant."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — nyeste GPT-5 generation model."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Nyeste Opus — avanceret intelligens til kodningsagenter og virksomhedsarbejdsgange."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Nyeste Opus — avanceret intelligens til kodningsagenter og virksomhedsarbejdsgange."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Forbedret Sonnet med bedre ræsonnering og instruktionsfølgning."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Anthropics mest kraftfulde model til komplekse, flertrinsopgaver."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Balanceret intelligens og hastighed til en bred vifte af opgaver."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Hurtigste og mest kompakte Claude model — ideel til høj gennemstrømning."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — forbedret ræsonnering og multimodale evner."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"OpenAIs flagskib næste-generations model."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"Letvægts GPT-5 — effektiv og hurtig til daglige opgaver."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — forbedret instruktionsfølgning og ræsonnering."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"Kompakt GPT-4.1 — hurtigere og billigere til enklere opgaver."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Mest kapable GPT-4 model, optimeret for hastighed og omkostninger."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"Letvægts GPT-4o — hurtigere og billigere til enklere opgaver."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Preview) — mest kapable Gemini-model med 1M kontekst."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Preview) — hurtig og effektiv med 1M kontekst."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — letvægtsmodel med lav latenstid og 1M kontekst."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Intern stemmeoptimeret assistentmodel."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto vælger den bedste model til din anmodning baseret på kapacitet og ydeevne."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Kommer snart"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Præferencer for automatisk routing"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Juster, hvordan den automatiske router afvejer kompromiser ved valg af model for hver tur. Vægte normaliseres — det er den relative balance, der betyder noget."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Omkostning"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Foretræk billigere modeller med lavere tokenomkostning."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Nøjagtighed"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Foretræk stærkere modeller til kompleks ræsonnering."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Hastighed"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Foretræk hurtigere modeller med lavere latenstid."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Nulstil til standard"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Filupload fik timeout. Prøv igen om et par minutter."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Noget gik galt. Her er den specifikke fejlmeddelelse, vi stødte på: Der opstod en fejl under behandlingen af din forespørgsel. Assistenten er ikke længere tilgængelig. Kontakt venligst administratoren."},com_ui_code:{english:"Code",translated:"Kode"},com_ui_assistant_share:{english:"Share",translated:"Del"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Link kopieret"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Du har ikke adgang til denne assistent"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Kunne ikke kopiere link til udklipsholderen"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Forhåndsvisning ikke tilgængelig — indholdsgenerering blev ikke fuldført."},com_ui_view_code:{english:"View code",translated:"Vis kode"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Forhåndsvisning ikke tilgængelig – indholdet er ugyldigt."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Telefonnummer"},com_assistants_pii_entity_email:{english:"Email Address",translated:"E-mailadresse"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Kreditkort"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"CPR-nummer"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Upload tager længere tid end forventet - prøver igen ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Forbindelsesproblem - prøver igen ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Upload mislykkedes - tjek din forbindelse og prøv igen"},com_assistants_memory_enabled:{english:"Memory",translated:"Hukommelse"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Hukommelse er aktiveret for denne assistent. Assistenten kan gemme og huske fakta på tværs af samtaler."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Hukommelse er deaktiveret for denne assistent. Ingen fakta gemmes eller huskes på tværs af samtaler."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Forklar venligst din forretningsmæssige begrundelse for at deaktivere hukommelse (påkrævet)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Angiv venligst en begrundelse for at deaktivere hukommelse."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Hukommelse er deaktiveret for dit team. Du kan se og slette eksisterende minder, men kan ikke tilføje eller redigere nye."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Kører din kode"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"Søger i vidensbasen"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Behandler stemme"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"Gemmer i hukommelsen"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"Fjerner fra hukommelsen"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Færdig med at søge på nettet"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Færdig med at gennemgå websiden"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"Billede genereret"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Færdig med at beregne"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running 