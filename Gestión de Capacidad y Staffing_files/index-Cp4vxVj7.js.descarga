ish:"Manage",translated:"Pamahalaan"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Wala kang naka-archive na pag-uusap."},com_nav_archive_name:{english:"Name",translated:"Pangalan"},com_nav_archive_created_at:{english:"DateCreated",translated:"Petsa ng Paglikha"},com_nav_clear_conversation:{english:"Clear conversations",translated:"I-clear ang mga pag-uusap"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Sigurado ka bang gusto mong i-clear ang lahat ng pag-uusap? Hindi na ito maibabalik."},com_nav_help:{english:"Help",translated:"Tulong"},com_nav_user_guide:{english:"User Guide",translated:"Gabay ng Gumagamit"},com_nav_settings:{english:"Settings",translated:"Mga Setting"},com_nav_search_placeholder:{english:"Search messages",translated:"Maghanap ng mga mensahe"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Awtomatikong ipadala ang teksto (pagkatapos ng 3 seg)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Error sa pag-play ng audio: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Error sa pagproseso ng audio: {0}"},com_nav_engine:{english:"Engine",translated:"Engine"},com_nav_browser:{english:"Browser",translated:"Browser"},com_nav_external:{english:"External",translated:"Panlabas"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Tanggalin ang cache storage"},com_nav_voice_select:{english:"Voice",translated:"Boses"},com_nav_setting_general:{english:"General",translated:"Pangkalahatan"},com_nav_setting_speech:{english:"Speech",translated:"Pagsasalita"},com_nav_language:{english:"Language",translated:"Wika"},com_nav_lang_auto:{english:"Auto detect",translated:"Awtomatikong tuklasin"},com_page_not_found:{english:"Page not found",translated:"Hindi makita ang pahina"},com_something_went_wrong_error:{english:"Something went wrong",translated:"May nangyaring mali"},com_unauthorized_access:{english:"Unauthorized access",translated:"Hindi awtorisadong pag-access"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Hindi awtorisadong pag-access. Ang pag-access ay limitado sa mga tiyak na domain."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Ang iyong account ay pansamantalang pinagbawalan dahil sa paglabag sa aming serbisyo"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Ikaw ay limitado sa pag-access sa app sa labas ng network!"},com_support_ticket_text:{english:"Support Ticket",translated:"Suporta Tiket"},com_help_dialog_Header:{english:"Need assistance?",translated:"Kailangan ng tulong?"},com_help_dialog_text_1_1:{english:"Click",translated:"I-click"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"para sa detalyadong instruksyon"},com_help_dialog_text_here:{english:"here",translated:"dito"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Para sa mga isyu, punan ang"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Para sa mga isyu, makipag-ugnayan sa"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Hanapin ang mga hakbang"},com_status_ind_none:{english:"Operational",translated:"Gumagana"},com_status_ind_minor:{english:"Minor Issues",translated:"Maliit na Isyu"},com_status_ind_major:{english:"Major Issues",translated:"Malaking Isyu"},com_status_ind_critical:{english:"Critical",translated:"Kritikal"},com_status_ind_error:{english:"Error Fetching",translated:"Error sa Pagkuha"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Pakitandaan na kapag umalis ka sa chat o nagsimula ng bagong chat, mawawala ang iyong kasaysayan ng pag-uusap."},com_forbidden_access:{english:"Forbidden access",translated:"Bawal na pag-access"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Patakaran sa Katanggap-tanggap na Paggamit"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Patakaran sa Pagkapribado"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Kasunduan sa Subscription"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Bago gamitin ang iX Hello, maaari mong suriin ang "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Sa pag-sign up at/o pagpasok, sumasang-ayon ka sa mga nabanggit na tuntunin."},com_login_page_and:{english:"and ",translated:"at "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Walang naka-pin na assistants"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Naka-pin na assistants"},com_ui_loading:{english:"Loading...",translated:"Naglo-load..."},com_ui_unpin:{english:"Unpin",translated:"I-unpin"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Matagumpay na na-unpin ang assistant"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Error sa pag-alis ng pagkaka-pin ng assistant"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Matagumpay na na-pin ang assistant"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Error sa pag-pin/pag-alis ng pagkaka-pin ng assistant"},com_ui_pin:{english:"Pin",translated:"I-pin"},come_create_assistant:{english:"Create Assistant",translated:"Lumikha ng Assistant"},come_edit_assistant:{english:"Edit Assistant",translated:"I-edit ang Assistant"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Sigurado ka bang nais mong magpatuloy? Mawawala ang anumang pagbabago sa Assistant na kasalukuyan mong ine-edit o nililikha. Hindi na ito maibabalik."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Hindi natagpuan ang assistant na may id na {0}."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Hindi sinusuportahan ng browser ang SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Hindi naibigay ang pahintulot sa mikropono"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Error sa pagsisimula ng pagre-record: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"Hindi nagre-record ang MediaRecorder"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"Hindi sinusuportahan ng browser na ito ang MediaRecorder"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Ang iyong mensahe ay naglalaman ng personal na impormasyon at hindi maipapadala. Pakialis ang anumang personal na impormasyon."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Nabigo ang pagpalit ng pangalan ng usapan"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Mayroon kang {0} natitirang tokens mula sa iyong alokasyon."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"Maaaring magkamali ang iX Hello. Pakisuri ang lahat ng outputs para sa kalidad at katumpakan. Ang lahat ng inputs ay naka-log para sa pagsunod."},com_ui_assistant_group_by:{english:"Group by",translated:"I-grupo ayon sa"},com_ui_assistant_category:{english:"Category",translated:"Kategorya"},com_ui_assistant_team:{english:"Team",translated:"Koponan"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Engineering"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Intelligence"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Operations"},com_ui_assistant_sales:{english:"Sales",translated:"Benta"},com_ui_assistant_strategy:{english:"Strategy",translated:"Istratehiya"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Mga Katulong sa Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Mag-upload ng larawan ng avatar (PNG o JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Maghanap Online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Mag-browse ng Website"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Lumikha ng Mga Imahe"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Kalkulahin ang Math"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Default na Tool"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Mas matagal ang pag-upload ng file kaysa inaasahan. Pakisubukang muli."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Error sa pag-pin ng assistant"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Nagkaroon ng error sa pagtanggal ng shared link"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Template ng DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Walang aktibong default preset."},com_ui_drag_drop_title:{english:"Add anything",translated:"Magdagdag ng kahit ano"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"I-drop ang anumang file dito upang idagdag ito sa pag-uusap"},com_ui_analyzing:{english:"Analyzing",translated:"Sinusuri"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Tapos na ang pagsusuri"},com_ui_warning:{english:"Warning",translated:"Babala"},com_ui_proceed:{english:"Proceed",translated:"Magpatuloy"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Ang mga file na na-upload sa assistant ay ginagamit lamang para sa layunin ng pag-uusap. Maaaring ma-access ng mga gumagamit ang nilalaman ng mga file na ito sa pamamagitan ng pagtatanong ng mga kaugnay na tanong, ngunit hindi pinapayagan ang direktang pag-download ng mga file."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Maglagay ng custom na pangalan para sa preset na ito"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Maglagay ng halimbawa ng input. Hindi papansinin ang halimbawa kung walang laman."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Maglagay ng halimbawa ng output. Hindi papansinin ang halimbawa kung walang laman."},com_nav_export_select_type:{english:"Select a file type",translated:"Pumili ng uri ng file"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"screenshot (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"text (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Walang natanggap na tugon. Pakisubukang muli ang iyong mensahe. Kung patuloy ang problema matapos i-reload ang pahina at subukang muli, mangyaring makipag-ugnayan sa suporta."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Bumalik sa Chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Moderasyon ng Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Naka-enable ang moderasyon ng guardrail para sa katulong na ito. Susuriin ang nilalaman ayon sa mga patakaran ng moderasyon."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Ang pag-disable ng moderasyon ng guardrail ay nag-aalis ng pagsusuri ng nilalaman para sa katulong na ito. Ikaw ang responsable sa pagsunod sa mga patakaran ng nilalaman ng iyong organisasyon. Ang aktibidad ay ganap na naitatala at sinusubaybayan."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Mangyaring ipaliwanag ang iyong dahilan sa negosyo para sa pag-disable ng moderasyon ng guardrail (kinakailangan)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Mangyaring magbigay ng dahilan para sa pag-disable ng moderasyon ng guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Pahintulutan ang mga gumagamit na magpalit ng modelo sa chat"},com_ui_feedback_good:{english:"Good response",translated:"Magandang tugon"},com_ui_feedback_bad:{english:"Poor response",translated:"Masamang tugon"},com_ui_feedback_comments:{english:"Comments",translated:"Mga komento"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Mga komento (opsyonal)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Sabihin sa amin ang higit pa tungkol sa iyong karanasan..."},com_ui_feedback_submit:{english:"Submit",translated:"Isumite"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Hindi namin maipadala ang iyong feedback"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Hindi tama"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Hindi kaugnay"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Lipas na"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Hindi sapat na detalye"},com_ui_feedback_reason_other:{english:"Other",translated:"Iba pa"},com_ui_model_recommended:{english:"Recommended",translated:"Inirerekomenda"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Legacy — mangyaring i-update"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Hindi na sinusuportahan ang modelong ito. Mangyaring pumili ng kasalukuyang modelo."},com_nav_setting_memory:{english:"Memory",translated:"Memorya"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Pamahalaan ang mga personal na impormasyon na naaalala ng katulong sa iyong mga pag-uusap."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Magdagdag ng bagong memorya…"},com_nav_memory_add_button:{english:"Add memory",translated:"Magdagdag ng memorya"},com_nav_memory_category:{english:"Category",translated:"Kategorya"},com_nav_memory_category_preference:{english:"Preference",translated:"Kagustuhan"},com_nav_memory_category_identity:{english:"Identity",translated:"Pagkakakilanlan"},com_nav_memory_category_context:{english:"Context",translated:"Konteksto"},com_nav_memory_category_project:{english:"Project",translated:"Proyekto"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Wala pang memorya"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Ang mga memoryang iyong ise-save ay lalabas dito at makakatulong sa pagpapersonalisa ng mga susunod na pag-uusap."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Hindi ma-load ang mga memorya. Pakisubukang muli."},com_nav_memory_retry:{english:"Retry",translated:"Subukang Muli"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Hindi maidaragdag ang memorya. Pakisubukang muli."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Hindi ma-update ang memorya. Pakisubukang muli."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Hindi ma-delete ang memorya. Pakisubukang muli."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"I-delete ang memoryang ito?"},com_nav_memory_delete_button:{english:"Delete",translated:"I-delete"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"I-edit ang memorya"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"I-delete ang memorya"},com_nav_memory_save:{english:"Save",translated:"I-save"},com_nav_memory_cancel:{english:"Cancel",translated:"Kanselahin"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Na-save {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — pinakabagong GPT-5 na modelo ng pag-iisip na may hangganan na katalinuhan."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — compact at matipid na variant ng GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — pinakabagong modelo ng henerasyon ng GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Pinakabagong Opus — nangungunang intelihensiya para sa mga coding agent at daloy ng trabaho ng enterprise."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Pinakabagong Opus — nangungunang intelihensiya para sa mga coding agent at daloy ng trabaho ng enterprise."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Pinahusay na Sonnet na may mas mahusay na pangangatwiran at pagsunod sa mga tagubilin."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Pinakamakapangyarihang modelo ng Anthropic para sa kumplikado, multi-step na mga gawain."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Balanseng intelihensiya at bilis para sa iba't ibang gawain."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Pinakamabilis at pinaka-compact na modelo ng Claude — perpekto para sa mga gawain na may mataas na throughput."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — pinahusay na pangangatwiran at multimodal na kakayahan."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Punong modelo ng OpenAI na susunod na henerasyon."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"Magaan na GPT-5 — mahusay at mabilis para sa pang-araw-araw na gawain."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — pinahusay na pagsunod sa mga tagubilin at pangangatwiran."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"Compact na GPT-4.1 — mas mabilis at mas mura para sa mas simpleng gawain."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Pinakamahusay na modelo ng GPT-4, na-optimize para sa bilis at gastos."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"Magaan na GPT-4o — mas mabilis at mas mura para sa mas simpleng gawain."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Preview) — pinaka-kayang Gemini na modelo na may 1M na konteksto."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Preview) — mabilis at mahusay na may 1M na konteksto."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — magaan na modelo na may mababang latency at 1M na konteksto."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Pangloob na modelo ng assistant na na-optimize para sa boses."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Awtomatikong pinipili ng Auto ang pinakamainam na modelo para sa iyong kahilingan batay sa kapasidad at pagganap."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Malapit na"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Mga kagustuhan sa auto routing"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Ayusin kung paano binabalanse ng Auto router ang mga trade-off kapag pumipili ng modelo sa bawat turn. Nino-normalize ang mga timbang — ang mahalaga ay ang relatibong balanse."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Gastos"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Paboran ang mas murang mga modelo na may mas mababang token cost."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Katumpakan"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Paboran ang mas mahusay na mga modelo para sa kumplikadong pangangatwiran."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Bilis"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Paboran ang mas mabilis na mga modelo na may mas mababang latency."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"I-reset sa mga default"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Nag-time out ang pag-upload ng file. Pakisubukang muli pagkalipas ng ilang minuto."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"May nangyaring mali. Narito ang partikular na mensahe ng error na aming naranasan: Nagkaroon ng error habang pinoproseso ang iyong kahilingan. Hindi na available ang assistant. Mangyaring makipag-ugnayan sa Admin."},com_ui_code:{english:"Code",translated:"Code"},com_ui_assistant_share:{english:"Share",translated:"Ibahagi"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Nakopya ang link"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Wala kang access sa assistant na ito"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Nabigong kopyahin ang link sa clipboard"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Hindi magagamit ang preview — hindi natapos ang pagbuo ng nilalaman."},com_ui_view_code:{english:"View code",translated:"Tingnan ang code"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Hindi magagamit ang preview — hindi wasto ang nilalaman."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Numero ng Telepono"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Email Address"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Credit Card"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"SSN"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Mas matagal kaysa inaasahan ang pag-upload - sinusubukang muli ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"May isyu sa koneksyon - sinusubukang muli ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Nabigo ang pag-upload - pakisuri ang iyong koneksyon at subukang muli"},com_assistants_memory_enabled:{english:"Memory",translated:"Memory"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Naka-enable ang Memory para sa assistant na ito. Maaaring mag-imbak at magbalik-gunita ang assistant ng mga katotohanan sa iba’t ibang pag-uusap."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Naka-disable ang Memory para sa assistant na ito. Walang mga katotohanang iimbakin o babalikan sa iba’t ibang pag-uusap."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Mangyaring ipaliwanag ang iyong business justification sa pag-disable ng memory (kinakailangan)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Mangyaring magbigay ng dahilan sa pag-disable ng memory."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Naka-disable ang Memory para sa iyong team. Maaari mong tingnan at burahin ang mga kasalukuyang memory, ngunit hindi ka makakadagdag o makaka-edit ng mga bago."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Pinapatakbo ang iyong code"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"Hinahanap sa knowledge base"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Pinoproseso ang boses"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"Sine-save sa memorya"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"Inaalis sa memorya"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Tapos nang maghanap sa web"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Tapos nang suriin ang webpage"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"Nabuo ang larawan"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Tapos nang magkalkula"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"Tapos nang patakbuhin ang iyong c