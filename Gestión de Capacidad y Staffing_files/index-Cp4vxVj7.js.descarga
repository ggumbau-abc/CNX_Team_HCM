ory",translated:"Añadir memoria"},com_nav_memory_category:{english:"Category",translated:"Categoría"},com_nav_memory_category_preference:{english:"Preference",translated:"Preferencia"},com_nav_memory_category_identity:{english:"Identity",translated:"Identidad"},com_nav_memory_category_context:{english:"Context",translated:"Contexto"},com_nav_memory_category_project:{english:"Project",translated:"Proyecto"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Aún no hay memorias"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Las memorias que guardes aparecerán aquí y ayudarán a personalizar futuras conversaciones."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"No se pudieron cargar las memorias. Inténtalo de nuevo."},com_nav_memory_retry:{english:"Retry",translated:"Reintentar"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"No se pudo añadir la memoria. Inténtalo de nuevo."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"No se pudo actualizar la memoria. Inténtalo de nuevo."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"No se pudo eliminar la memoria. Inténtalo de nuevo."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"¿Eliminar esta memoria?"},com_nav_memory_delete_button:{english:"Delete",translated:"Eliminar"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Editar memoria"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Eliminar memoria"},com_nav_memory_save:{english:"Save",translated:"Guardar"},com_nav_memory_cancel:{english:"Cancel",translated:"Cancelar"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Guardado {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — último modelo de razonamiento GPT-5 con inteligencia de vanguardia."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — variante compacta y rentable de GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — modelo de última generación GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Último Opus — inteligencia de vanguardia para agentes de codificación y flujos de trabajo empresariales."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Último Opus — inteligencia de vanguardia para agentes de codificación y flujos de trabajo empresariales."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet mejorado con razonamiento e instrucciones mejoradas."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Modelo más potente de Anthropic para tareas complejas y de múltiples pasos."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Inteligencia y velocidad equilibradas para una amplia gama de tareas."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Modelo Claude más rápido y compacto — ideal para tareas de alto rendimiento."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — razonamiento mejorado y capacidades multimodales."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Modelo insignia de próxima generación de OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 ligero — eficiente y rápido para tareas cotidianas."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — mejor seguimiento de instrucciones y razonamiento."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 compacto — más rápido y económico para tareas simples."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Modelo GPT-4 más capaz, optimizado para velocidad y costo."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o ligero — más rápido y económico para tareas simples."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Vista previa) — modelo Gemini más capaz con 1M de contexto."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Vista previa) — rápido y eficiente con 1M de contexto."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — modelo ligero y de baja latencia con 1M de contexto."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Modelo asistente optimizado para voz interno."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto selecciona el mejor modelo para su solicitud según la capacidad y el rendimiento."},com_ui_model_comi