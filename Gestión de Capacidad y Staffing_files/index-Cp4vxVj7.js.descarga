avor, selecione uma categoria."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Já existe um Assistente com este nome. Por favor, escolha outro."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Compartilhado com é obrigatório"},com_ui_shared_with_team:{english:"Team",translated:"Equipe"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"A equipe é obrigatória"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Este assistente está bloqueado para edição porque é compartilhado com a equipe."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Erro ao carregar links compartilhados."},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"O nome contém palavras impróprias"},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"A descrição contém palavras impróprias"},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"As instruções contêm palavras impróprias"},com_ui_shared_with:{english:"Shared With",translated:"Compartilhado com"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Private – Only you can access and view this assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Share only with Team – This assistant will be visible and accessible to your team members."},com_ui_select_search_model:{english:"Search model by name",translated:"Pesquisar modelo por nome"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Pesquisar plugin por nome"},com_ui_use_prompt:{english:"Use prompt",translated:"Usar prompt"},com_ui_prev:{english:"Prev",translated:"Ant"},com_ui_next:{english:"Next",translated:"Próx"},com_ui_stop:{english:"Stop",translated:"Parar"},com_ui_upload_files:{english:"Upload files",translated:"Carregar arquivos"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Modelos de Prompt"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Ocultar Modelos de Prompt"},com_ui_showing:{english:"Showing",translated:"Mostrando"},com_ui_of:{english:"of",translated:"de"},com_ui_entries:{english:"Entries",translated:"Entradas"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Arquivo carregado com sucesso"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Ocorreu um erro ao carregar seu arquivo"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Arquivo inválido para upload. Deve ser uma imagem não excedendo 2 MB"},com_ui_cancel:{english:"Cancel",translated:"Cancelar"},com_ui_save:{english:"Save",translated:"Salvar"},com_user_message:{english:"You",translated:"Você"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Copiar para a área de transferência"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Copiado para a área de transferência"},com_ui_regenerate:{english:"Regenerate",translated:"Regenerar"},com_ui_edit:{english:"Edit",translated:"Editar"},com_ui_all:{english:"all",translated:"todos"},com_ui_clear:{english:"Clear",translated:"Limpar"},com_ui_import_conversation:{english:"Import",translated:"Importar"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Importe conversas de um arquivo JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Conversas importadas com sucesso"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Houve um erro ao importar suas conversas"},com_ui_confirm_action:{english:"Confirm Action",translated:"Confirmar Ação"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Desconhecido"},com_ui_result:{english:"Result",translated:"Resultado"},com_ui_image_gen:{english:"Image Gen",translated:"Geração de Imagem"},com_ui_assistant:{english:"Assistant",translated:"Assistente"},com_ui_assistants:{english:"Assistants",translated:"Assistentes"},com_ui_attachment:{english:"Attachment",translated:"Anexo"},com_ui_assistants_output:{english:"Assistants Output",translated:"Saída dos Assistentes"},com_ui_delete:{english:"Delete",translated:"Excluir"},com_ui_create:{english:"Create",translated:"Criar"},com_ui_share:{english:"Share",translated:"Share"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Share link to chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"There was an error sharing the chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Your name and any messages you add after sharing stay private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been created. Manage previously shared chats at any time via Settings."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Your name, custom instructions, and any messages you add after sharing stay private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Shared link not found"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Excluir conversa?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Isso excluirá"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Tem certeza de que deseja excluir este Assistente? Esta ação não pode ser desfeita."},com_ui_rename:{english:"Rename",translated:"Renomear"},com_ui_more_options:{english:"More",translated:"Mais"},com_ui_preview:{english:"Preview",translated:"Visualizar"},com_ui_upload:{english:"Upload",translated:"Carregar"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'O envio de "{0}" está levando mais tempo do que o esperado. Aguarde enquanto o arquivo é indexado para recuperação.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Política de privacidade"},com_ui_terms_of_service:{english:"Terms of service",translated:"Termos de serviço"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Não foi possível fazer login com as informações fornecidas. Por favor, verifique suas credenciais e tente novamente."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Muitas tentativas de login em um curto período de tempo. Por favor, tente novamente mais tarde."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Sua conta foi temporariamente banida devido a violações de nosso serviço."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Ocorreu um erro interno do servidor. Aguarde alguns instantes e tente novamente."},com_auth_sign_in:{english:"Login",translated:"Entrar"},com_endpoint_system_message:{english:"System Message",translated:"Mensagem do Sistema"},com_endpoint_message:{english:"Message",translated:"Conversar com"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Edite sua mensagem ou Regenere."},com_endpoint_default_blank:{english:"default: blank",translated:"padrão: em branco"},com_endpoint_default_false:{english:"default: false",translated:"padrão: falso"},com_endpoint_default_creative:{english:"default: creative",translated:"padrão: criativo"},com_endpoint_default_empty:{english:"default: empty",translated:"padrão: vazio"},com_endpoint_default_with_num:{english:"default: {0}",translated:"padrão: {0}"},com_endpoint_context:{english:"Context",translated:"Contexto"},com_endpoint_tone_style:{english:"Tone Style",translated:"Estilo de Tom"},com_endpoint_token_count:{english:"Token count",translated:"Contagem de Tokens"},com_endpoint_output:{english:"Output",translated:"Saída"},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Defina instruções ou contexto personalizados. Ignorado se vazio."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Substitui as instruções do assistente. Isso é útil para modificar o comportamento em uma base por execução."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Defina instruções ou contexto adicionais além das instruções principais do Assistente. Ignorado se vazio."},com_endpoint_custom_name:{english:"Custom Name",translated:"Nome Personalizado"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Instruções Personalizadas"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Instruções Adicionais"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Substituir Instruções"},com_endpoint_temperature:{english:"Temperature",translated:"Temperatura"},com_endpoint_default:{english:"default",translated:"padrão"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Máx. Tokens de Saída"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Valores mais altos = mais aleatório, enquanto valores mais baixos = mais focado e determinístico. Recomendamos alterar este ou o Top P, mas não ambos."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"O máximo de tokens a gerar. O comprimento total de tokens de entrada e tokens gerados é limitado pelo comprimento do contexto do modelo."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Uma alternativa à amostragem com temperatura, chamada amostragem de núcleo, onde o modelo considera os resultados dos tokens com massa de probabilidade top_p. Então, 0,1 significa que apenas os tokens que compõem os 10% superiores da massa de probabilidade são considerados. Recomendamos alterar este ou a temperatura, mas não ambos."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em sua frequência existente no texto até agora, diminuindo a probabilidade do modelo repetir a mesma linha literalmente."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em sua aparição no texto até o momento, aumentando a probabilidade do modelo falar sobre novos tópicos."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Reenviar todos os arquivos anexados anteriormente. Nota: isso aumentará o custo de tokens e você pode encontrar erros com muitos anexos."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'A resolução para solicitações de Visão. "Baixa" é mais barata e rápida, "Alta" é mais detalhada e cara, e "Automática" escolherá automaticamente entre as duas com base na resolução da imagem.'},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Defina um nome personalizado para o ChatGPT"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Defina instruções personalizadas para incluir na Mensagem do Sistema. Padrão: nenhuma"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Penalidade de Frequência"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Penalidade de Presença"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Usar Funções"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Reenviar Arquivos"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Detalhe da Imagem"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Ignorar Conclusão"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Defina instruções personalizadas para incluir na Mensagem do Sistema. Padrão: nenhuma"},com_endpoint_import:{english:"Import",translated:"Importar"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Defina um nome personalizado, caso você encontre esta predefinição"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Tem certeza de que deseja excluir esta predefinição?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Predefinição Importada!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Ocorreu um erro ao importar sua predefinição. Por favor, tente novamente."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Ocorreu um erro ao salvar sua predefinição. Por favor, tente novamente."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Ocorreu um erro ao excluir sua predefinição. Por favor, tente novamente."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"não é mais a predefinição padrão."},com_endpoint_preset_default_item:{english:"Default:",translated:"Padrão:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Nenhuma predefinição padrão ativa."},com_endpoint_preset_title:{english:"Preset",translated:"Predefinição"},com_endpoint_preset_saved:{english:"Saved!",translated:"Salvo!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"é agora a predefinição padrão."},com_endpoint_preset:{english:"preset",translated:"predefinição"},com_endpoint_presets:{english:"presets",translated:"predefinições"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Ativa!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Nome da Predefinição"},com_endpoint:{english:"Endpoint",translated:"Endpoint"},com_endpoint_examples:{english:" Presets",translated:" Predefinições"},com_endpoint_export:{english:"Export",translated:"Exportar"},com_endpoint_assistant:{english:"Assistant",translated:"Assistente"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Usar Assistente Ativo"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Salvar como Predefinição"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Tem certeza de que deseja limpar todas as predefinições? Isso é irreversível."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Nenhuma predefinição ainda, use o botão de configurações para criar uma"},com_endpoint_my_preset:{english:"My Preset",translated:"Minha Predefinição"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Modelo de Agente (Recomendado: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Modelo de Conclusão (Recomendado: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Habilitar o uso de Plugins como Funções OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Habilitar a ignorância da etapa de conclusão, que revisa a resposta final e as etapas geradas"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Por favor, selecione um Assistente no Painel Lateral Direito"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Defina sua Chave no menu Cabeçalho para conversar."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Por favor, Selecione um Assistente"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Como posso ajudar você hoje?"},com_nav_profile_picture:{english:"Profile Picture",translated:"Foto de perfil"},com_nav_change_picture:{english:"Change picture",translated:"Alterar foto"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Mostrar configurações do agente"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Mostrar configurações de conclusão"},com_hide_examples:{english:"Hide Examples",translated:"Ocultar exemplos"},com_show_examples:{english:"Show Examples",translated:"Mostrar exemplos"},com_nav_export_filename:{english:"Filename",translated:"Nome do arquivo"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Definir o nome do arquivo"},com_nav_export_type:{english:"Type",translated:"Tipo"},com_nav_export_conversation:{english:"Export conversation",translated:"Exportar conversa"},com_nav_export:{english:"Export",translated:"Exportar"},com_nav_shared_links:{english:"Shared links",translated:"Links Compartilhados"},com_nav_shared_links_manage:{english:"Manage",translated:"Gerenciar"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Você não tem nenhum link compartilhado."},com_nav_shared_links_name:{english:"Name",translated:"Nome"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Data compartilhada"},com_nav_my_files:{english:"File Manager",translated:"Meus arquivos"},com_nav_admin_center:{english:"Admin Center",translated:"Centro de Administração"},com_nav_theme:{english:"Theme",translated:"Tema"},com_nav_theme_system:{english:"System",translated:"Sistema"},com_nav_theme_dark:{english:"Dark",translated:"Escuro"},com_nav_theme_light:{english:"Light",translated:"Claro"},com_nav_user_name_display:{english:"Display username in messages",translated:"Exibir nome de usuário nas mensagens"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Limpar todas as conversas"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Confirmar Limpeza"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Fechar barra lateral"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Abrir barra lateral"},com_nav_send_message:{english:"Send message",translated:"Enviar mensagem"},com_nav_log_out:{english:"Log out",translated:"Sair"},com_nav_user:{english:"USER",translated:"USUÁRIO"},com_nav_archived_chats:{english:"Archived chats",translated:"Conversas Arquivadas"},com_nav_archived_chats_manage:{english:"Manage",translated:"Gerenciar"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Você não tem nenhuma conversa arquivada."},com_nav_archive_name:{english:"Name",translated:"Nome"},com_nav_archive_created_at:{english:"DateCreated",translated:"CriadoEm"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Limpar conversas"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Tem certeza de que deseja limpar todas as conversas? Isso é irreversível."},com_nav_help:{english:"Help",translated:"Ajuda"},com_nav_settings:{english:"Settings",translated:"Configurações"},com_nav_search_placeholder:{english:"Search messages",translated:"Pesquisar mensagens"},com_nav_setting_general:{english:"General",translated:"Geral"},com_nav_language:{english:"Language",translated:"Idioma"},com_nav_lang_auto:{english:"Auto detect",translated:"Detecção automática"},com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"Parece que o conteúdo enviado foi sinalizado pelo nosso sistema de moderação por não estar alinhado com nossas diretrizes comunitárias. Não podemos prosseguir com este tópico específico. Se tiver outras perguntas ou tópicos que gostaria de explorar, por favor, edite sua mensagem ou crie uma nova conversa."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Nenhuma chave encontrada. Por favor, forneça uma chave e tente novamente."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Nenhuma URL base encontrada. Por favor, forneça uma e tente novamente."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Chave inválida fornecida. Por favor, forneça uma chave e tente novamente."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"A chave fornecida para {0} expirou em {1}. Por favor, forneça uma chave e tente novamente."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"Você atingiu o máximo de tokens para sua licença. Por favor, entre em contato com vendas em {0} para mais assistência."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"Você usou {0}% dos tokens alocados. Por favor, entre em contato com {1} para mais assistência."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Sua licença não está disponível. Por favor, entre em contato com o suporte para mais assistência."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"Endereços IPv6 não são suportados. Por favor, use uma conexão IPv4 ou entre em contato com o suporte para mais assistência."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Ocorreu um erro ao processar sua solicitação. Por favor, tente novamente."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"O arquivo {0} já foi carregado com sucesso"},com_sidepanel_parameters:{english:"Parameters",translated:"Parâmetros"},com_ui_create_assistant:{english:"Create Assistant",translated:"Criar Assistente"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Usuário precisa de permissões de criação para criar um Assistente"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Consentimento"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"Você está prestes a compartilhar este assistente com outros membros da equipe. Antes de compartilhar este assistente, revise os pontos-chave abaixo:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Ao prosseguir, você confirma que entende e aceita estes termos."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Assistente compartilhado não deve conter dados sensíveis ou confidenciais."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Assistentes compartilhados não devem processar dados sensíveis ou confidenciais."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Compartilhar implica responsabilidade pelo conteúdo e acesso."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"Recomenda-se compartilhar com um time específico ou grupo fechado em vez de todos."},com_button_accept:{english:"Accept",translated:"Aceitar"},com_button_decline:{english:"Decline",translated:"Recusar"},com_assistants_file_search:{english:"File Search",translated:"Busca de Arquivos"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Adicione aqui os arquivos que você precisa que seu assistente pesquise ao responder perguntas no chat."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Suportado:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Dica:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Peça ao seu assistente para usar a 'Ferramenta de Busca de Arquivos' sempre que responder aos usuários."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Anexar armazenamentos vetoriais para Busca de Arquivos ainda não é suportado. Você pode anexá-los do Provider Playground ou anexar arquivos às mensagens para busca de arquivos em uma base de thread."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Algo deu errado ao buscar arquivos dos armazenamentos vetoriais."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} de {1} arquivos enviados"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"A busca de arquivos não está habilitada neste modelo. Por favor, selecione outro modelo."},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Exclusão permitida apenas com Assistentes privados"},com_assistants_loading:{english:"Loading assistants...",translated:"Carregando assistentes..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Por favor, forneça um motivo para habilitar PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Configurações e Privacidade"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Redação de PII"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"A redação de PII está habilitada por padrão para as chamadas de modelo deste assistente."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Permitir PII desativa a redação para as chamadas de modelo deste assistente. Você é responsável por cumprir as políticas de dados da sua organização. A atividade é totalmente registrada e monitorada."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Por favor, explique seu motivo para habilitar PII (obrigatório)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"O comprimento mínimo é de {0} caracteres."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"O comprimento máximo é de {0} caracteres."},com_ui_date_today:{english:"Today",translated:"Hoje"},com_ui_date_yesterday:{english:"Yesterday",translated:"Ontem"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Últimos 7 dias"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"Últimos 30 dias"},com_ui_date_january:{english:"January",translated:"Janeiro"},com_ui_date_february:{english:"February",translated:"Fevereiro"},com_ui_date_march:{english:"March",translated:"Março"},com_ui_date_april:{english:"April",translated:"Abril"},com_ui_date_may:{english:"May",translated:"Maio"},com_ui_date_june:{english:"June",translated:"Junho"},com_ui_date_july:{english:"July",translated:"Julho"},com_ui_date_august:{english:"August",translated:"Agosto"},com_ui_date_september:{english:"September",translated:"Setembro"},com_ui_date_october:{english:"October",translated:"Outubro"},com_ui_date_november:{english:"November",translated:"Novembro"},com_ui_date_december:{english:"December",translated:"Dezembro"},com_ui_field_required:{english:"This field is required",translated:"Este campo é obrigatório"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Erro ao baixar o arquivo. O arquivo pode ter sido excluído."},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Não é possível anexar arquivos do Assistente a outros endpoints"},com_ui_kbot_assistants:{english:"Knowledge",translated:"Conhecimento"},com_ui_assistant_default_category:{english:"General",translated:"Geral"},com_ui_assistant_featured:{english:"Featured",translated:"Em destaque"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Nenhum assistente corresponde aos critérios de busca."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Nenhum assistente encontrado."},com_ui_category_placeholder:{english:"Search a category",translated:"Buscar uma categoria"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Buscar uma ferramenta"},com_ui_on:{english:"On",translated:"Ligado"},com_ui_off:{english:"Off",translated:"Desligado"},com_ui_yes:{english:"Yes",translated:"Sim"},com_ui_no:{english:"No",translated:"Não"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Erro ao conectar ao servidor, tente atualizar a página."},com_ui_select_placeholder:{english:"Select options",translated:"Selecione opções"},com_ui_remove:{english:"Remove",translated:"Remover"},com_ui_none_selected:{english:"None selected",translated:"Nenhum selecionado"},com_ui_thinking:{english:"Thinking",translated:"Pensando"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Analisando sua solicitação"},com_ui_processing:{english:"Putting it together",translated:"Processando"},com_ui_working_on_it:{english:"Almost ready",translated:"Trabalhando nisso"},com_ui_read_aloud:{english:"Read aloud",translated:"Ler em voz alta"},com_ui_copied:{english:"Copied!",translated:"Copiado!"},com_ui_copy_code:{english:"Copy code",translated:"Copiar código"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Mencione um endpoint, assistente ou predefinição para alternar rapidamente"},com_ui_nothing_found:{english:"Nothing found",translated:"Nada encontrado"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Ir para a conversa"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Tipo de importação não suportado"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Assistente excluído com sucesso"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Erro ao excluir o assistente"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Arquivo duplicado detectado."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Ocorreu um erro ao enviar o arquivo."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Erro ao enviar o arquivo: Endpoint indefinido"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Arquivos vazios não são permitidos."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Você só pode enviar até {0} arquivos de cada vez."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Você só pode enviar até {0} arquivos nesta seção."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"O limite de upload foi atingido para {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Não foi possível determinar o tipo de arquivo para: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Tipo de arquivo não suportado. Por favor, envie um formato de arquivo compatível."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Falha ao carregar imagem"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Atualmente, apenas arquivos JPEG, JPG, PNG e WEBP são suportados."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"O tamanho do arquivo excede {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"O tamanho total dos arquivos não pode exceder {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Ocorreu um erro ao validar o arquivo."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Ocorreu um erro ao processar o arquivo."},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Assistência de Estúdio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Conhecimento"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Não categorizado"},com_ui_copy_link:{english:"Copy link",translated:"Copiar link"},com_ui_update_link:{english:"Update link",translated:"Atualizar link"},com_ui_create_link:{english:"Create link",translated:"Criar link"},com_ui_use_micrphone:{english:"Use microphone",translated:"Usar microfone"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Não é possível remover mais valores, um mínimo de {0} é necessário."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"O máximo permitido é {0}, usando os valores mais recentes."},com_endpoint_messages:{english:"Messages",translated:"Mensagens"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Máx. de Tokens de Contexto"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`O número máximo de tokens que podem ser usados para contexto. Use isso para controlar quantos tokens são enviados por solicitação.
  Se não especificado, usará os padrões do sistema com base no tamanho de contexto dos modelos conhecidos. Definir valores mais altos pode resultar em erros e/ou custo maior de tokens.`},com_endpoint_stop:{english:"Stop Sequences",translated:"Sequências de Parada"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Separe os valores pressionando `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Campo `max_tokens` opcional, representando o número máximo de tokens que podem ser gerados na conclusão do chat.\n    \n    O comprimento total dos tokens de entrada e dos tokens gerados é limitado pelo comprimento de contexto dos modelos. Você pode experimentar erros se este número exceder o máximo de tokens de contexto."},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Até 4 sequências onde a API irá parar de gerar mais tokens."},com_endpoint_export_share:{english:"Export/Share",translated:"Exportar/Compartilhar"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Texto para Fala"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Reprodução Automática da Última Mensagem"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Fala para Texto"},com_nav_source_chat:{english:"View source chat",translated:"Ver chat de origem"},com_nav_user_guide:{english:"User Guide",translated:"Guia do Usuário"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Enviar texto automaticamente (após 3 seg)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Erro ao reproduzir áudio: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Erro ao processar áudio: {0}"},com_nav_engine:{english:"Engine",translated:"Motor"},com_nav_browser:{english:"Browser",translated:"Navegador"},com_nav_external:{english:"External",translated:"Externo"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Excluir armazenamento de cache"},com_nav_voice_select:{english:"Voice",translated:"Voz"},com_nav_setting_speech:{english:"Speech",translated:"Fala"},com_page_not_found:{english:"Page not found",translated:"Página não encontrada"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Algo deu errado"},com_unauthorized_access:{english:"Unauthorized access",translated:"Acesso não autorizado"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Acesso não autorizado. O acesso é restrito a domínios específicos."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Sua conta foi temporariamente banida devido a violações de nosso serviço"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Você está restrito a acessar o aplicativo fora da rede!"},com_support_ticket_text:{english:"Support Ticket",translated:"Ticket de Suporte"},com_help_dialog_Header:{english:"Need assistance?",translated:"Precisa de ajuda?"},com_help_dialog_text_1_1:{english:"Click",translated:"Clique"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"para instruções detalhadas"},com_help_dialog_text_here:{english:"here",translated:"aqui"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Para problemas, preencha um"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Para problemas, contate"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Encontre os passos"},com_status_ind_none:{english:"Operational",translated:"Operacional"},com_status_ind_minor:{english:"Minor Issues",translated:"Pequenos Problemas"},com_status_ind_major:{english:"Major Issues",translated:"Problemas Maiores"},com_status_ind_critical:{english:"Critical",translated:"Crítico"},com_status_ind_error:{english:"Error Fetching",translated:"Erro ao Buscar"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Observe que ao sair de um chat ou iniciar um novo, você perderá seu histórico de conversas."},com_forbidden_access:{english:"Forbidden access",translated:"Acesso proibido"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Política de Uso Aceitável"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Política de Privacidade"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Contrato de Assinatura"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Antes de usar o iX Hello, você pode revisar a "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Ao se inscrever e/ou entrar, você concorda com os termos acima."},com_login_page_and:{english:"and ",translated:"e "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Nenhum assistente fixado"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Assistentes fixados"},com_ui_loading:{english:"Loading...",translated:"Carregando..."},com_ui_unpin:{english:"Unpin",translated:"Desafixar"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Assistente desafixado com sucesso"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Erro ao desafixar assistente"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Assistente fixado com sucesso"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Erro ao fixar/desafixar assistente"},com_ui_pin:{english:"Pin",translated:"Fixar"},come_create_assistant:{english:"Create Assistant",translated:"Criar Assistente"},come_edit_assistant:{english:"Edit Assistant",translated:"Editar Assistente"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Tem certeza de que deseja continuar? Isso resultará na perda de quaisquer alterações feitas no Assistente que você está editando ou criando. Esta ação não pode ser desfeita."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Assistente com id {0} não foi encontrado."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Navegador não suporta SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Permissão do microfone não concedida"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Erro ao iniciar gravação: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder não está gravando"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder não é suportado neste navegador"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Sua mensagem contém informações pessoais e não pôde ser enviada. Por favor, remova qualquer informação pessoal."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Falha ao renomear conversa"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Você tem {0} dos seus tokens alocados restantes."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello pode cometer erros. Revise todas as saídas para qualidade e precisão. Todas as entradas são registradas para conformidade."},com_ui_assistant_group_by:{english:"Group by",translated:"Agrupar por"},com_ui_assistant_category:{english:"Category",translated:"Categoria"},com_ui_assistant_team:{english:"Team",translated:"Equipe"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Engenharia"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Inteligência"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marketing"},com_ui_assistant_operations:{english:"Operations",translated:"Operações"},com_ui_assistant_sales:{english:"Sales",translated:"Vendas"},com_ui_assistant_strategy:{english:"Strategy",translated:"Estratégia"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Assistentes de Estúdio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Envie uma imagem de avatar (PNG ou JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Pesquisar Online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Navegar no Site"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Gerar Imagens"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Calcular Matemática"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Ferramenta Padrão"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try 