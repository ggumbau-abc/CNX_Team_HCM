ed:"här"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"För problem, fyll i ett"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"För problem, kontakta"},com_help_dialog_text_ticket:{english:"ticket",translated:"ärende"},com_help_dialog_text_3:{english:"Find the steps",translated:"Hitta stegen"},com_status_ind_none:{english:"Operational",translated:"I drift"},com_status_ind_minor:{english:"Minor Issues",translated:"Mindre problem"},com_status_ind_major:{english:"Major Issues",translated:"Större problem"},com_status_ind_critical:{english:"Critical",translated:"Kritiskt"},com_status_ind_error:{english:"Error Fetching",translated:"Fel vid hämtning"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Observera att när du lämnar en chatt eller startar en ny chatt, kommer du att förlora din chattlogg."},com_forbidden_access:{english:"Forbidden access",translated:"Förbjuden åtkomst"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Godtagbar användningspolicy"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Integritetspolicy"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Prenumerationsavtal"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Innan du använder iX Hello, kan du granska Concentrix's "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Genom att registrera dig och/eller logga in, godkänner du ovanstående villkor."},com_login_page_and:{english:"and ",translated:"och "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Inga fästa assistenter"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Fästa assistenter"},com_ui_loading:{english:"Loading...",translated:"Laddar..."},com_ui_unpin:{english:"Unpin",translated:"Ta bort fästning"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Assistenten togs bort från fästa framgångsrikt"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Fel vid borttagning av fästning"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Assistenten fästes framgångsrikt"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Fel vid fästning/borttagning av fästning"},com_ui_pin:{english:"Pin",translated:"Fäst"},come_create_assistant:{english:"Create Assistant",translated:"Skapa Assistent"},come_edit_assistant:{english:"Edit Assistant",translated:"Redigera Assistent"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Är du säker på att du vill fortsätta? Detta kommer att resultera i förlust av alla ändringar gjorda på Assistenten du för närvarande redigerar eller skapar. Denna åtgärd kan inte ångras."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Assistent med id {0} hittades inte."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Webbläsaren stöder inte SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Mikrofontillstånd inte beviljat"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Fel vid start av inspelning: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder spelar inte in"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder stöds inte i denna webbläsare"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Ditt meddelande innehåller personlig information och kunde inte skickas. Vänligen ta bort all personlig information."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Misslyckades med att byta namn på konversation"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Du har {0} av dina tilldelade tokens kvar."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello kan göra misstag. Vänligen granska alla resultat för kvalitet och noggrannhet. Alla inmatningar loggas för efterlevnad."},com_ui_assistant_group_by:{english:"Group by",translated:"Gruppera efter"},com_ui_assistant_category:{english:"Category",translated:"Kategori"},com_ui_assistant_team:{english:"Team",translated:"Team"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Teknik"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Intelligens"},com_ui_assistant_marketing:{english:"Marketing",translated:"Marknadsföring"},com_ui_assistant_operations:{english:"Operations",translated:"Drift"},com_ui_assistant_sales:{english:"Sales",translated:"Försäljning"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategi"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Studioassistenter"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Ladda upp en avatarbild (PNG eller JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Sök online"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Bläddra på webbplats"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Generera bilder"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Beräkna matematik"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Standardverktyg"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Filuppladdningen tar längre tid än väntat. Försök igen."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Fel vid fästning av assistent"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Ett fel uppstod vid radering av den delade länken"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"DAN-mall"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Ingen standardinställning aktiv."},com_ui_drag_drop_title:{english:"Add anything",translated:"Lägg till något"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Släpp en fil här för att lägga till den i konversationen"},com_ui_analyzing:{english:"Analyzing",translated:"Analyserar"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Analys klar"},com_ui_warning:{english:"Warning",translated:"Varning"},com_ui_proceed:{english:"Proceed",translated:"Fortsätt"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Filer som laddas upp till assistenten används endast för konversationsändamål. Användare kan få tillgång till innehållet i dessa filer genom att ställa relevanta frågor, men direkt nedladdning av filerna är inte tillåten."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Ange ett anpassat namn för denna inställning"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Ange exempel på indata. Exempel ignoreras om tomt."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Ange exempel på utdata. Exempel ignoreras om tomt."},com_nav_export_select_type:{english:"Select a file type",translated:"Välj en filtyp"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"skärmdump (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"text (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Inget svar mottogs. Försök att skicka ditt meddelande igen. Om problemet kvarstår efter att du har laddat om sidan och försökt igen, vänligen kontakta support."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Tillbaka till chatt"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Skyddsräcke Moderering"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Skyddsräcke moderering är aktiverad för denna assistent. Innehåll kommer att kontrolleras mot modereringspolicyer."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Att inaktivera skyddsräcke moderering tar bort innehållskontroller för denna assistent. Du är ansvarig för att följa din organisations innehållspolicyer. Aktivitet loggas och övervakas fullt ut."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Vänligen förklara din affärsmotivering för att inaktivera skyddsräcke moderering (obligatoriskt)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Vänligen ange en motivering för att inaktivera skyddsräcke moderering."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Tillåt användare att byta modell i chatten"},com_ui_feedback_good:{english:"Good response",translated:"Bra svar"},com_ui_feedback_bad:{english:"Poor response",translated:"Dåligt svar"},com_ui_feedback_comments:{english:"Comments",translated:"Kommentarer"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Kommentarer (valfritt)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Berätta mer om din upplevelse..."},com_ui_feedback_submit:{english:"Submit",translated:"Skicka"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Vi kunde inte skicka din feedback"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Felaktig"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Inte relevant"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Inaktuell"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Inte tillräckligt med detaljer"},com_ui_feedback_reason_other:{english:"Other",translated:"Övrigt"},com_ui_model_recommended:{english:"Recommended",translated:"Rekommenderad"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Legacy — vänligen uppdatera"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Denna modell stöds inte längre. Vänligen välj en aktuell modell."},com_nav_setting_memory:{english:"Memory",translated:"Minne"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Hantera de personliga fakta assistenten kommer ihåg från dina konversationer."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Lägg till ett nytt minne…"},com_nav_memory_add_button:{english:"Add memory",translated:"Lägg till minne"},com_nav_memory_category:{english:"Category",translated:"Kategori"},com_nav_memory_category_preference:{english:"Preference",translated:"Preferens"},com_nav_memory_category_identity:{english:"Identity",translated:"Identitet"},com_nav_memory_category_context:{english:"Context",translated:"Kontext"},com_nav_memory_category_project:{english:"Project",translated:"Projekt"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Inga minnen ännu"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Minnen du sparar kommer att visas här och hjälpa till att anpassa framtida konversationer."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Kunde inte ladda minnen. Försök igen."},com_nav_memory_retry:{english:"Retry",translated:"Försök igen"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Kunde inte lägga till minne. Försök igen."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Kunde inte uppdatera minne. Försök igen."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Kunde inte ta bort minne. Försök igen."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Ta bort detta minne?"},com_nav_memory_delete_button:{english:"Delete",translated:"Ta bort"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Redigera minne"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Ta bort minne"},com_nav_memory_save:{english:"Save",translated:"Spara"},com_nav_memory_cancel:{english:"Cancel",translated:"Avbryt"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Sparad {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — senaste GPT-5-tänkemodellen med avancerad intelligens."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — kompakt och kostnadseffektiv GPT-5.4-variant."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — senaste GPT-5-generationens modell."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Senaste Opus — banbrytande intelligens för kodningsagenter och företagsarbetsflöden."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Senaste Opus — banbrytande intelligens för kodningsagenter och företagsarbetsflöden."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Förbättrad Sonnet med bättre resonemang och instruktionsefterföljning."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Anthropics mest kraftfulla modell för komplexa, flerstegsuppgifter."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Balanserad intelligens och hastighet för en mängd olika uppgifter."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Snabbaste och mest kompakta Claude-modellen — idealisk för höggenomströmningsuppgifter."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — förbättrat resonemang och multimodala funktioner."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"OpenAIs flaggskeppsmodell för nästa generation."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"Lättvikts GPT-5 — effektiv och snabb för vardagliga uppgifter."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — förbättrad instruktionsefterföljning och resonemang."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"Kompakt GPT-4.1 — snabbare och billigare för enklare uppgifter."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Mest kapabla GPT-4-modellen, optimerad för hastighet och kostnad."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"Lättvikts GPT-4o — snabbare och billigare för enklare uppgifter."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Förhandsvisning) — mest kapabla Gemini-modellen med 1M kontext."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Förhandsvisning) — snabb och effektiv med 1M kontext."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — lättviktsmodell med låg latens och 1M kontext."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Intern röstoptimerad assistentmodell."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto väljer den bästa modellen för din förfrågan baserat på kapacitet och prestanda."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Kommer snart"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Inställningar för automatisk dirigering"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Justera hur den automatiska dirigeringen balanserar avvägningar när en modell väljs för varje tur. Vikterna normaliseras — det relativa förhållandet är det som spelar roll."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Kostnad"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Prioritera billigare modeller med lägre tokenkostnad."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Noggrannhet"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Prioritera starkare modeller för komplexa resonemang."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Hastighet"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Prioritera snabbare modeller med lägre latens."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Återställ till standard"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Filuppladdningen tog för lång tid. Försök igen om några minuter."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Något gick fel. Här är det specifika felmeddelandet vi stötte på: Ett fel uppstod när din begäran behandlades. Assistenten är inte längre tillgänglig. Kontakta administratören."},com_ui_code:{english:"Code",translated:"Kod"},com_ui_assistant_share:{english:"Share",translated:"Dela"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Länk kopierad"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Du har inte åtkomst till den här assistenten"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Det gick inte att kopiera länken till urklipp"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Förhandsvisning ej tillgänglig — innehållsgenerering slutfördes inte."},com_ui_view_code:{english:"View code",translated:"Visa kod"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Förhandsvisning ej tillgänglig – innehållet är ogiltigt."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Telefonnummer"},com_assistants_pii_entity_email:{english:"Email Address",translated:"E-postadress"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Kreditkort"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"Personnummer"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Uppladdningen tar längre tid än väntat – försöker igen ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Anslutningsproblem – försöker igen ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Uppladdningen misslyckades – kontrollera din anslutning och försök igen"},com_assistants_memory_enabled:{english:"Memory",translated:"Minne"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Minne är aktiverat för den här assistenten. Assistenten kan lagra och komma ihåg fakta mellan konversationer."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Minne är inaktiverat för den här assistenten. Inga fakta lagras eller koms ihåg mellan konversationer."},com_assistants_memory_enabled_off_reason_placeho