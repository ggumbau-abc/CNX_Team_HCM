om_ui_assistant_file_processing_error:"Ralat berlaku semasa memproses fail.",com_ui_assistants:"Pembantu",com_ui_assistants_category_ix_customer:"Bantuan Studio",com_ui_assistants_category_kbot:"Pengetahuan",com_ui_assistants_uncategorized:"Tidak Dikategorikan",com_ui_attachment:"Lampiran",com_ui_assistants_output:"Output Pembantu",com_ui_delete:"Padam",com_ui_create:"Cipta",com_ui_share:"Kongsi",com_ui_copy_link:"Salin pautan",com_ui_update_link:"Kemaskini pautan",com_ui_create_link:"Cipta pautan",com_ui_share_link_to_chat:"Kongsi pautan ke sembang",com_ui_share_error:"Terdapat ralat semasa berkongsi pautan sembang",com_ui_share_create_message:"Nama anda dan sebarang mesej yang ditambah selepas berkongsi kekal peribadi.",com_ui_share_created_message:"Pautan awam ke sembang anda telah dicipta. Urus sembang yang dikongsi sebelum ini pada bila-bila masa melalui Tetapan.",com_ui_share_update_message:"Nama anda, arahan tersuai, dan sebarang mesej yang ditambah selepas berkongsi kekal peribadi.",com_ui_share_updated_message:"Pautan awam ke sembang anda telah dikemaskini. Urus sembang yang dikongsi sebelum ini pada bila-bila masa melalui Tetapan.",com_ui_shared_link_not_found:"Pautan yang dikongsi tidak ditemui",com_ui_delete_conversation:"Padam sembang?",com_ui_delete_conversation_confirm:"Ini akan memadam",com_ui_delete_assistant_confirm:"Adakah anda pasti mahu memadam Pembantu ini? Ini tidak boleh dibatalkan.",com_ui_rename:"Namakan semula",com_ui_more_options:"Lagi",com_ui_preview:"Pratonton",com_ui_upload:"Muat naik",com_ui_upload_delay:'Memuat naik "{0}" mengambil masa lebih lama daripada yang dijangka. Sila tunggu sementara fail selesai diindeks untuk pengambilan.',com_ui_privacy_policy:"Dasar privasi",com_ui_terms_of_service:"Terma perkhidmatan",com_ui_use_micrphone:"Guna mikrofon",com_ui_min_tags:"Tidak boleh buang lebih nilai, minimum {0} diperlukan.",com_ui_max_tags:"Maksimum dibenarkan ialah {0}, menggunakan nilai terkini.",com_auth_error_login:"Tidak dapat log masuk dengan maklumat yang diberikan. Sila semak kelayakan anda dan cuba lagi.",com_auth_error_login_rl:"Anda telah melebihi jumlah percubaan log masuk yang dibenarkan. Sila cuba lagi dalam 15 minit.",com_auth_error_login_ban:"Akaun anda telah digantung sementara kerana melanggar perkhidmatan kami.",com_auth_error_login_server:"Terdapat ralat pelayan dalaman. Sila tunggu sebentar dan cuba lagi.",com_auth_sign_in:"Log masuk",com_endpoint_system_message:"Mesej Sistem",com_endpoint_message:"Mesej",com_endpoint_messages:"Mesej-mesej",com_endpoint_message_not_appendable:"Edit mesej anda atau Jana Semula.",com_endpoint_default_blank:"lalai: kosong",com_endpoint_default_false:"lalai: palsu",com_endpoint_default_creative:"lalai: kreatif",com_endpoint_default_empty:"lalai: kosong",com_endpoint_default_with_num:"lalai: {0}",com_endpoint_context:"Konteks",com_endpoint_tone_style:"Gaya Nada",com_endpoint_token_count:"Kiraan token",com_endpoint_output:"Output",com_endpoint_context_tokens:"Maksimum Token Konteks",com_endpoint_context_info:`Jumlah maksimum token yang boleh digunakan untuk konteks. Gunakan ini untuk mengawal berapa banyak token dihantar setiap permintaan.
  Jika tidak dinyatakan, akan menggunakan lalai sistem berdasarkan saiz konteks model yang diketahui. Menetapkan nilai lebih tinggi mungkin menyebabkan ralat dan/atau kos token lebih tinggi.`,com_endpoint_prompt_prefix_placeholder:"Tetapkan arahan atau konteks tersuai. Diabaikan jika kosong.",com_endpoint_instructions_assistants_placeholder:"Menimpa arahan pembantu. Ini berguna untuk mengubah tingkah laku berdasarkan setiap larian.",com_endpoint_prompt_prefix_assistants_placeholder:"Tetapkan arahan atau konteks tambahan di atas arahan utama Pembantu. Diabaikan jika kosong.",com_endpoint_custom_name:"Nama Tersuai",com_endpoint_prompt_prefix:"Arahan Tersuai",com_endpoint_prompt_prefix_assistants:"Arahan Tambahan",com_endpoint_instructions_assistants:"Timpakan Arahan",com_endpoint_temperature:"Suhu",com_endpoint_default:"lalai",com_endpoint_top_p:"Top P",com_endpoint_top_k:"Top K",com_endpoint_max_output_tokens:"Maksimum Token Output",com_endpoint_stop:"Hentikan Urutan",com_endpoint_stop_placeholder:"Pisahkan nilai dengan menekan `Enter`",com_endpoint_openai_max_tokens:"Medan `max_tokens` pilihan, mewakili bilangan maksimum token yang boleh dijana dalam penyelesaian sembang.\n\nPanjang keseluruhan token input dan token yang dijana adalah terhad oleh panjang konteks model. Anda mungkin mengalami ralat jika nombor ini melebihi token konteks maksimum.",com_endpoint_openai_temp:"Nilai lebih tinggi = lebih rawak, manakala nilai lebih rendah = lebih fokus dan deterministik. Kami mengesyorkan mengubah ini atau Top P tetapi bukan kedua-duanya.",com_endpoint_openai_max:"Token maksimum untuk dijana. Panjang keseluruhan token input dan token yang dijana adalah terhad oleh panjang konteks model.",com_endpoint_openai_topp:"Alternatif kepada pensampelan dengan suhu, dipanggil pensampelan nukleus, di mana model mempertimbangkan hasil token dengan jisim kebarangkalian top_p. Jadi 0.1 bermaksud hanya token yang merangkumi jisim kebarangkalian 10% teratas dipertimbangkan. Kami mengesyorkan mengubah ini atau suhu tetapi bukan kedua-duanya.",com_endpoint_openai_freq:"Nombor antara 0 dan 2.0. Nilai positif menghukum token baru berdasarkan kekerapan sedia ada mereka dalam teks setakat ini, mengurangkan kemungkinan model mengulangi baris yang sama secara verbatim.",com_endpoint_openai_pres:"Nombor antara 0 dan 2.0. Nilai positif menghukum token baru berdasarkan sama ada mereka muncul dalam teks setakat ini, meningkatkan kemungkinan model bercakap tentang topik baru.",com_endpoint_openai_resend_files:"Hantar semula semua fail yang dilampirkan sebelum ini. Nota: ini akan meningkatkan kos token dan anda mungkin mengalami ralat dengan banyak lampiran.",com_endpoint_openai_detail:'Resolusi untuk permintaan Vision. "Rendah" lebih murah dan cepat, "Tinggi" lebih terperinci dan mahal, dan "Auto" akan memilih secara automatik antara kedua-duanya berdasarkan resolusi imej.',com_endpoint_openai_stop:"Sehingga 4 urutan di mana API akan berhenti menjana token lanjut.",com_endpoint_openai_custom_name_placeholder:"Tetapkan nama tersuai untuk iXHello",com_endpoint_openai_prompt_prefix_placeholder:"Tetapkan arahan tersuai untuk disertakan dalam Mesej Sistem. Lalai: tiada",com_endpoint_frequency_penalty:"Penalti Kekerapan",com_endpoint_presence_penalty:"Penalti Kehadiran",com_endpoint_plug_use_functions:"Guna Fungsi",com_endpoint_plug_resend_files:"Hantar Semula Fail",com_endpoint_plug_image_detail:"Butiran Imej",com_endpoint_plug_skip_completion:"Langkau Penyelesaian",com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:"Tetapkan arahan khusus untuk disertakan dalam Mesej Sistem. Lalai: tiada",com_endpoint_import:"Import",com_endpoint_set_custom_name:"Tetapkan nama khusus, sekiranya anda boleh mencari pratetap ini",com_endpoint_preset_delete_confirm:"Adakah anda pasti mahu memadam pratetap ini?",com_endpoint_preset_import:"Pratetap Diimport!",com_endpoint_preset_import_error:"Terdapat ralat semasa mengimport pratetap anda. Sila cuba lagi.",com_endpoint_preset_