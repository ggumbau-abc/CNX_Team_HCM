lan."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Sila jelaskan justifikasi perniagaan anda untuk menyahaktifkan memori (diperlukan)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Sila berikan justifikasi untuk menyahaktifkan memori."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Memori dinyahaktifkan untuk pasukan anda. Anda boleh melihat dan memadam memori sedia ada, tetapi tidak boleh menambah atau mengedit yang baharu."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Menjalankan kod anda"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"Mencari pangkalan pengetahuan"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Memproses suara"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"Menyimpan ke memori"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"Membuang daripada memori"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Selesai mencari di web"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Selesai menyemak halaman web"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"Imej dijana"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Selesai mengira"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"Selesai menjalankan kod anda"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"Selesai mencari pangkalan pengetahuan"},com_ui_assistant