ons_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Permetti al tuo Assistente di recuperare informazioni o eseguire azioni tramite API"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Opzionale: Il nome dell'assistente"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Le istruzioni di sistema che l'assistente utilizza"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Opzionale: Descrivi qui il tuo Assistente"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"Devi prima creare un assistente prima di aggiungere azioni."},com_assistants_update_success:{english:"Successfully updated",translated:"Aggiornamento avvenuto con successo"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Si è verificato un errore durante l'aggiornamento del tuo assistente."},com_assistants_create_success:{english:"Successfully created",translated:"Creazione avvenuta con successo"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Si è verificato un errore durante la creazione del tuo assistente."},com_ui_field_required:{english:"This field is required",translated:"Questo campo è obbligatorio"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Errore durante il download del file. Il file potrebbe essere stato eliminato."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Tipo di file non supportato per l'endpoint:"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Limite dimensione file superato per l'endpoint:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Impossibile allegare il file. Crea o seleziona una conversazione, oppure prova a ricaricare la pagina."},com_ui_examples:{english:"Examples",translated:"Esempi"},com_ui_new_chat:{english:"New chat",translated:"Nuova chat"},com_ui_conversations:{english:"Chats",translated:"Conversazioni"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"Inizia una conversazione..."},com_ui_new_conversation:{english:"New Chat",translated:"Nuova conversazione"},com_ui_assistant_library:{english:"Assistant Library",translated:"Biblioteca degli Assistenti"},com_ui_assistant_search:{english:"Search for an assistant",translated:"Cerca un assistente"},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"Spiega l'informatica quantistica in termini semplici"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"Hai qualche idea creativa per il compleanno di un bambino di 10 anni?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"Come faccio a fare una richiesta HTTP in Javascript?"},com_ui_capabilities:{english:"Capabilities",translated:"Capacità"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"Ricorda ciò che l'utente ha detto prima nella conversazione"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Permette all'utente di fornire correzioni successive"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Addestrato a rifiutare richieste inappropriate"},com_ui_limitations:{english:"Limitations",translated:"Limitazioni"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Potrebbe occasionalmente generare informazioni non corrette"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Potrebbe occasionalmente produrre istruzioni dannose o contenuti di parte"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Conoscenza limitata del mondo e degli eventi dopo il 2021"},com_ui_on:{english:"On",translated:"Attivo"},com_ui_off:{english:"Off",translated:"Disattivo"},com_ui_yes:{english:"Yes",translated:"Sì"},com_ui_no:{english:"No",translated:"No"},com_ui_ascending:{english:"Asc",translated:"Crescente"},com_ui_descending:{english:"Desc",translated:"Decrescente"},com_ui_show_all:{english:"Show All",translated:"Mostra Tutto"},com_ui_name:{english:"Name",translated:"Nome"},com_ui_date:{english:"Date",translated:"Data"},com_ui_storage:{english:"Storage",translated:"Archiviazione"},com_ui_context:{english:"Context",translated:"Contesto"},com_ui_size:{english:"Size",translated:"Dimensione"},com_ui_host:{english:"Host",translated:"Host"},com_ui_update:{english:"Update",translated:"Aggiorna"},com_ui_authentication:{english:"Authentication",translated:"Autenticazione"},com_ui_instructions:{english:"Instructions",translated:"Istruzioni"},com_ui_description:{english:"Description",translated:"Descrizione"},com_ui_category:{english:"Category",translated:"---"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Assign a business category to help filter and organize assistants by function."},com_ui_error:{english:"Error",translated:"Errore"},com_ui_select:{english:"Select",translated:"Seleziona"},com_ui_input:{english:"Input",translated:"Input"},com_ui_close:{english:"Close",translated:"Chiudi"},com_ui_model:{english:"Model",translated:"Modello"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Il nome è obbligatorio"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Il prefisso intelligente non può essere vuoto"},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"La descrizione è obbligatoria"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Le istruzioni sono obbligatorie"},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Il campo categoria non può essere vuoto. Si prega di selezionare una categoria"},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Esiste già un assistente con questo nome"},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Condiviso con è obbligatorio"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Il nome contiene linguaggio non appropriato"},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"La descrizione contiene linguaggio non appropriato"},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Le istruzioni contengono linguaggio non appropriato"},com_ui_shared_with:{english:"Shared With",translated:"Condiviso con"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Private – Only you can access and view this assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Share only with Team – This assistant will be visible and accessible to your team members."},com_ui_shared_with_team:{english:"Team",translated:"Condiviso con il team"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Condiviso con il team è obbligatorio"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Questo assistente è bloccato per la modifica perché è condiviso con il team."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Errore nel caricamento dei link condivisi."},com_ui_select_search_model:{english:"Search model by name",translated:"Cerca modello per nome"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Cerca plugin per nome"},com_ui_use_prompt:{english:"Use prompt",translated:"Usa prompt"},com_ui_prev:{english:"Prev",translated:"Prec"},com_ui_next:{english:"Next",translated:"Succ"},com_ui_stop:{english:"Stop",translated:"Ferma"},com_ui_upload_files:{english:"Upload files",translated:"Carica file"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Modelli di prompt"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Nascondi modelli di prompt"},com_ui_showing:{english:"Showing",translated:"Mostrando"},com_ui_of:{english:"of",translated:"di"},com_ui_entries:{english:"Entries",translated:"Voci"},com_ui_none_selected:{english:"None selected",translated:"Nessuna selezionata"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"File caricato con successo"},com_ui_upload_error:{english:"There was 