ror:"Unaweza kupakia hadi faili {0} katika sehemu hii.",com_ui_assistant_file_upload_section_response_error:"Kikomo cha upakiaji kimefikiwa kwa {0}",com_ui_assistant_file_upload_type_unknown:"Haiwezekani kubaini aina ya faili kwa: {0}",com_ui_assistant_file_upload_unsupported_type:"Aina ya faili haijaungwa mkono. Tafadhali pakia umbizo la faili linaloungwa mkono.",com_ui_assistant_image_failed_load:"Imeshindwa kupakia picha",com_ui_assistant_file_upload_supported_type:"Hivi sasa, faili za JPEG, JPG, PNG, na WEBP pekee ndizo zinazoungwa mkono.",com_ui_assistant_file_upload_size_limit:"Ukubwa wa faili unazidi {0} MB.",com_ui_assistant_file_upload_total_size_limit:"Jumla ya ukubwa wa faili haziwezi kuzidi {0} MB.",com_ui_assistant_file_validation_error:"Hitilafu ilitokea wakati wa kuthibitisha faili.",com_ui_assistant_file_processing_error:"Hitilafu ilitokea wakati wa kuchakata faili.",com_ui_assistants:"Wasidizi",com_ui_assistants_category_ix_customer:"Msaada wa Studio",com_ui_assistants_category_kbot:"Maarifa",com_ui_assistants_uncategorized:"Haijapangwa",com_ui_attachment:"Kiambatisho",com_ui_assistants_output:"Matokeo ya Wasaidizi",com_ui_delete:"Futa",com_ui_create:"Unda",com_ui_share:"Shiriki",com_ui_copy_link:"Nakili kiungo",com_ui_update_link:"Sasisha kiungo",com_ui_create_link:"Unda kiungo",com_ui_share_link_to_chat:"Shiriki kiungo kwenye gumzo",com_ui_share_error:"Kulikuwa na hitilafu katika kushiriki kiungo cha gumzo",com_ui_share_create_message:"Jina lako na ujumbe wowote unaoongeza baada ya kushiriki hubaki faragha.",com_ui_share_created_message:"Kiungo cha umma kwa gumzo lako kimeundwa. Dhibiti gumzo zilizoshirikiwa awali wakati wowote kupitia Mipangilio.",com_ui_share_update_message:"Jina lako, maelekezo maalum, na ujumbe wowote unaoongeza baada ya kushiriki hubaki faragha.",com_ui_share_updated_message:"Kiungo cha umma kwa gumzo lako kimesasishwa. Dhibiti gumzo zilizoshirikiwa awali wakati wowote kupitia Mipangilio.",com_ui_shared_link_not_found:"Kiungo kilichoshirikiwa hakijapatikana",com_ui_delete_conversation:"Futa gumzo?",com_ui_delete_conversation_confirm:"Hii itafuta",com_ui_delete_assistant_confirm:"Una uhakika unataka kufuta Msaidizi huyu? Hii haiwezi kubatilishwa.",com_ui_rename:"Badilisha jina",com_ui_more_options:"Zaidi",com_ui_preview:"Onyesha awali",com_ui_upload:"Pakia",com_ui_upload_delay:'Kupakia "{0}" kunachukua muda zaidi ya ilivyotarajiwa. Tafadhali subiri faili ikamilishe kuorodheshwa kwa urejeshaji.',com_ui_privacy_policy:"Sera ya faragha",com_ui_terms_of_service:"Masharti ya huduma",com_ui_use_micrphone:"Tumia kipaza sauti",com_ui_min_tags:"Huwezi kuondoa zaidi, kiwango cha chini ni {0}.",com_ui_max_tags:"Idadi ya juu inayoruhusiwa ni {0}, ukitumia thamani za hivi karibuni.",com_auth_error_login:"Imeshindikana kuingia na taarifa ulizotoa. Tafadhali angalia maelezo yako na ujaribu tena.",com_auth_error_login_rl:"Umezidi idadi ya majaribio ya kuingia. Tafadhali jaribu tena baada ya dakika 15.",com_auth_error_login_ban:"Akaunti yako imezuiwa kwa muda kutokana na uvunjaji wa huduma zetu.",com_auth_error_login_server:"Kulikuwa na hitilafu ya seva ya ndani. Tafadhali subiri kidogo na ujaribu tena.",com_auth_sign_in:"Ingia",com_endpoint_system_message:"Ujumbe wa Mfumo",com_endpoint_message:"Ujumbe",com_endpoint_messages:"Ujumbe",com_endpoint_message_not_appendable:"Hariri ujumbe wako au Tengeneza upya.",com_endpoint_default_blank:"chaguo-msingi: tupu",com_endpoint_default_false:"chaguo-msingi: si kweli",com_endpoint_default_creative:"chaguo-msingi: ubunifu",com_endpoint_default_empty:"chaguo-msingi: tupu",com_endpoint_default_with_num:"chaguo-msingi: {0}",com_endpoint_context:"Muktadha",com_endpoint_tone_style:"Mtindo wa Toni",com_endpoint_token_count:"Idadi ya alama",com_endpoint_output:"Matokeo",com_endpoint_context_tokens:"Alama za Muktadha za Juu",com_endpoint_context_info:`Idadi ya juu ya alama zinazoweza kutumika kwa muktadha. Tumia hii kudhibiti idadi ya alama zinazotumwa kwa ombi.
  Ikiwa haijatajwa, itatumia chaguo-msingi za mfumo kulingana na ukubwa wa muktadha wa mifano inayojulikana. Kuweka thamani za juu kunaweza kusababisha hitilafu na/au gharama ya juu ya alama.`,com_endpoint_prompt_prefix_placeholder:"Weka maagizo au muktadha maalum. Inapuuzwa ikiwa tupu.",com_endpoint_instructions_assistants_placeholder:"Inabadilisha maagizo ya msaidizi. Hii ni muhimu kwa kubadilisha tabia kwa kila mzunguko.",com_endpoint_prompt_prefix_assistants_placeholder:"Weka maagizo ya ziada au muktadha juu ya maagizo kuu ya Msaidizi. Inapuuzwa ikiwa tupu.",com_endpoint_custom_name:"Jina Maalum",com_endpoint_prompt_prefix:"Maagizo Maalum",com_endpoint_prompt_prefix_assistants:"Maagizo ya Ziada",com_endpoint_instructions_assistants:"Badilisha Maagizo",com_endpoint_temperature:"Joto",com_endpoint_default:"chaguo-msingi",com_endpoint_top_p:"Juu P",com_endpoint_top_k:"Juu K",com_endpoint_max_output_tokens:"Tokeni za Juu za Matokeo",com_endpoint_stop:"Mfuatano wa Kusitisha",com_endpoint_stop_placeholder:"Tenganisha thamani kwa kubonyeza `Enter`",com_endpoint_openai_max_tokens:"Sehemu ya hiari ya `max_tokens`, inayowakilisha idadi ya juu ya tokeni ambazo zinaweza kuzalishwa katika kukamilisha mazungumzo.\n\nUrefu wa jumla wa tokeni za ingizo na zilizozalishwa unazuiliwa na urefu wa muktadha wa modeli. Unaweza kupata makosa ikiwa nambari hii inazidi tokeni za muktadha wa juu.",com_endpoint_openai_temp:"Thamani za juu = nasibu zaidi, wakati thamani za chini = makini na za uhakika. Tunapendekeza kubadilisha hii au Juu P lakini si zote mbili.",com_endpoint_openai_max:"Tokeni za juu za kuzalisha. Urefu wa jumla wa tokeni za ingizo na zilizozalishwa unazuiliwa na urefu wa muktadha wa modeli.",com_endpoint_openai_topp:"Njia mbadala ya sampuli na joto, inayoitwa sampuli ya nucleus, ambapo modeli inazingatia matokeo ya tokeni na uwezekano wa juu_p. Kwa hivyo 0.1 inamaanisha tokeni zinazojumuisha 10% ya juu ya uwezekano zinazingatiwa. Tunapendekeza kubadilisha hii au joto lakini si zote mbili.",com_endpoint_openai_freq:"Nambari kati ya 0 na 2.0. Thamani chanya zinadhibiti tokeni mpya kulingana na marudio yao katika maandishi hadi sasa, kupunguza uwezekano wa modeli kurudia mstari huo huo.",com_endpoint_openai_pres:"Nambari kati ya 0 na 2.0. Thamani chanya zinadhibiti tokeni mpya kulingana na kama zinaonekana katika maandishi hadi sasa, kuongeza uwezekano wa modeli kuzungumza juu ya mada mpya.",com_endpoint_openai_resend_files:"Tuma tena faili zote zilizowekwa awali. Kumbuka: hii itaongeza gharama ya tokeni na unaweza kupata makosa na viambatisho vingi.",com_endpoint_openai_detail:'Azimio kwa maombi ya Maono. "Chini" ni nafuu na haraka, "Juu" ni ya kina na ghali, na "Otomatiki" itachagua moja kwa moja kati ya hizo mbili kulingana na azimio la picha.',com_endpoint_openai_stop:"Hadi mfuatano 4 ambapo API itasitisha kuzalisha tokeni zaidi.",com_endpoint_openai_custom_name_placeholder:"Weka jina maalum kwa iXHello",com_endpoint_openai_prompt_prefix_placeholder:"Weka maagizo maalum ya kujumuisha katika Ujumbe wa Mfumo. Chaguo-msingi: hakuna",com_endpoint_frequency_penalty:"Adhabu ya Marudio",com_endpoint_presence_penalty:"Adhabu ya Uwepo",com_endpoint_plug_use_functions:"Tumia Kazi",com_endpoint_plug_resend_files:"Tuma Faili Tena",com_endpoint_plug_image_detail:"Maelezo ya Picha",com_endpoint_plug_skip_completion:"Ruka Kukamilisha",com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:"Weka maagizo maalum ya kujumuisha katika Ujumbe wa Mfumo. Chaguo-msingi: hakuna",com_endpoint_import:"Ingiza",com_endpoint_set_custom_name:"Weka jina maalum, endapo unaweza kupata kiolezo hiki",com_endpoint_preset_delete_confirm:"Una uhakika unataka kufuta kiolezo hiki?",com_endpoint_preset_import:"Kiolezo Kimeingizwa!",com_endpoint_preset_import_error:"Kulikuwa na hitilafu katika kuingiza kiolezo chako. Tafadhali jaribu tena.",com_endpoint_preset_save_error:"Kulikuwa na hitilafu katika kuhifadhi kiolezo chako. Tafadhali jaribu tena.",com_endpoint_preset