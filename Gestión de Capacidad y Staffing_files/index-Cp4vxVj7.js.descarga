i_preview:"Forhåndsvisning",com_ui_upload:"Last opp",com_ui_upload_delay:'Opplasting av "{0}" tar lengre tid enn forventet. Vennligst vent mens filen ferdigstilles for henting.',com_ui_privacy_policy:"Personvernregler",com_ui_terms_of_service:"Vilkår for bruk",com_ui_use_micrphone:"Bruk mikrofon",com_ui_min_tags:"Kan ikke fjerne flere verdier, minst {0} kreves.",com_ui_max_tags:"Maksimalt antall er {0}, bruker siste verdier.",com_auth_error_login:"Kan ikke logge inn med de oppgitte opplysningene. Sjekk legitimasjonen din og prøv igjen.",com_auth_error_login_rl:"Du har overskredet antall tillatte innloggingsforsøk. Prøv igjen om 15 minutter.",com_auth_error_login_ban:"Kontoen din er midlertidig utestengt på grunn av brudd på våre vilkår.",com_auth_error_login_server:"Det oppsto en intern serverfeil. Vent noen øyeblikk og prøv igjen.",com_auth_sign_in:"Logg inn",com_endpoint_system_message:"Systemmelding",com_endpoint_message:"Melding",com_endpoint_messages:"Meldinger",com_endpoint_message_not_appendable:"Rediger meldingen din eller generer på nytt.",com_endpoint_default_blank:"standard: tom",com_endpoint_default_false:"standard: falsk",com_endpoint_default_creative:"standard: kreativ",com_endpoint_default_empty:"standard: tom",com_endpoint_default_with_num:"standard: {0}",com_endpoint_context:"Kontekst",com_endpoint_tone_style:"Tone stil",com_endpoint_token_count:"Antall token",com_endpoint_output:"Utdata",com_endpoint_context_tokens:"Maks konteksttokens",com_endpoint_context_info:`Maksimalt antall tokens som kan brukes for kontekst. Bruk dette for å kontrollere hvor mange tokens som sendes per forespørsel.
  Hvis ikke spesifisert, vil systemstandarder basert på kjente modellers kontekststørrelse brukes. Å sette høyere verdier kan resultere i feil og/eller høyere tokenkostnad.`,com_endpoint_prompt_prefix_placeholder:"Sett tilpassede instruksjoner eller kontekst. Ignoreres hvis tom.",com_endpoint_instructions_assistants_placeholder:"Overstyrer assistentens instruksjoner. Nyttig for å endre oppførsel per kjøring.",com_endpoint_prompt_prefix_assistants_placeholder:"Sett tilleggsinstruksjoner eller kontekst oppå assistentens hovedinstruksjoner. Ignoreres hvis tom.",com_endpoint_custom_name:"Egendefinert navn",com_endpoint_prompt_prefix:"Egendefinerte instruksjoner",com_endpoint_prompt_prefix_assistants:"Tilleggsinstruksjoner",com_endpoint_instructions_assistants:"Overstyr instruksjoner",com_endpoint_temperature:"Temperatur",com_endpoint_default:"standard",com_endpoint_top_p:"Top P",com_endpoint_top_k:"Top K",com_endpoint_max_output_tokens:"Maks utgangstokens",com_endpoint_stop:"Stoppsekvenser",com_endpoint_stop_placeholder:"Skill verdier med `Enter`",com_endpoint_openai_max_tokens:"Valgfelt `max_tokens`, som representerer maksimalt antall tokens som kan genereres i chat fullføringen.\n\nDen totale lengden på inndata-tokens og genererte tokens er begrenset av modellens kontektslengde. Du kan oppleve feil hvis dette tallet overstiger maks kontekts-tokens.",com_endpoint_openai_temp:"Høyere verdier = mer tilfeldig, mens lavere verdier = mer fokusert og deterministisk. Vi anbefaler å endre dette eller Top P, men ikke begge.",com_endpoint_openai_max:"Maks tokens å generere. Den totale lengden på inndata-tokens og genererte tokens er begrenset av modellens kontektslengde.",com_endpoint_openai_topp:"Et alternativ til sampling med temperatur, kalt nucleus sampling, der modellen vurderer resultatene av tokens med top_p sannsynlighetsmasse. Så 0.1 betyr at bare tokens som utgjør de øverste 10% sannsynlighetsmassen vurderes. Vi anbefaler å endre dette eller temperatur, men ikke begge.",com_endpoint_openai_freq:"Nummer mellom 0 og 2.0. Positive verdier straffer nye tokens basert på deres eksisterende frekvens i teksten så langt, noe som reduserer modellens sannsynlighet for å gjenta samme linje ordrett.",com_endpoint_openai_pres:"Nummer mellom 0 og 2.0. Positive verdier straffer nye tokens basert på om de vises i teksten så langt, noe som øker modellens sannsynlighet for å snakke om nye emner.",com_endpoint_openai_resend_files:"Send alle tidligere vedlagte filer på nytt. Merk: dette vil øke token-kostnaden, og du kan oppleve feil med mange vedlegg.",com_endpoint_openai_detail:'Oppløsningen for Vision-forespørsler. "Lav" er billigere og raskere, "Høy" er mer detaljert og kostbar, og "Auto" vil automatisk velge mellom de to basert på bildekvaliteten.',com_endpoint_openai_stop:"Opptil 4 sekvenser der API-en vil stoppe å generere flere tokens.",com_endpoint_openai_custom_name_placeholder:"Sett et egendefinert navn for iXHello",com_endpoint_openai_prompt_prefix_placeholder:"Sett egendefinerte instruksjoner for å inkludere i systemmeldingen. Standard: ingen",com_endpoint_frequency_penalty:"Frekvensstraff",com_endpoint_presence_penalty:"Tilstedeværelsesstraff",com_endpoint_plug_use_functions:"Bruk funksjoner",com_endpoint_plug_resend_files:"Send filer på nytt",com_endpoint_plug_image_detail:"Bildedetalj",com_endpoint_plug_skip_completion:"Hopp over fullføring",com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:"Sett egendefinerte instruksjoner i systemmelding. Standard: ingen",com_endpoint_import:"Importer",com_endpoint_set_custom_name:"Sett et egendefinert navn, i tilfelle du finner denne forhåndsinnstillingen",com_endpoint_preset_delete_confirm:"Er du sikker på at du vil slette denne forhåndsinnstillingen?",com_endpoint_preset_import:"Forhåndsinnstilling importert!",com_endpoint_preset_import_error:"Det oppstod en feil ved import av forhåndsinnstillingen. Vennligst prøv igjen.",com_endpoint_preset_save_error:"Det oppstod en feil ved lagring