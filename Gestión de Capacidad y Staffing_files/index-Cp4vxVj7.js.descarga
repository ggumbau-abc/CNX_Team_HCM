select_placeholder:{english:"Select options",translated:"Zaɓi zaɓuɓɓuka"},com_ui_remove:{english:"Remove",translated:"Cire"},com_ui_input:{english:"Input",translated:"Shigarwa"},com_ui_close:{english:"Close",translated:"Rufe"},com_ui_model:{english:"Model",translated:"Samfuri"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Filin sunan mataimaki ba zai iya zama fanko ba. Da fatan a shigar da sunan da ya dace."},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"An yi amfani da Smart Prefix don Mataimakan Janar, Da fatan a yi amfani da wani suna daban."},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Filin bayanin ba zai iya zama fanko ba. Da fatan a shigar da bayanin da ya dace."},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Filin umarnin ba zai iya zama fanko ba. Da fatan a shigar da umarnin da ya dace."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Filin rukuni ba zai iya zama fanko ba. Da fatan a zaɓi rukuni."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"An gano sunan mataimaki mai maimaituwa. Da fatan a zaɓi sunan musamman."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Filin rabawa ba zai iya zama fanko ba. Da fatan a zaɓi zaɓin rabawa."},com_ui_shared_with:{english:"Shared With",translated:"An Raba Da"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Keɓaɓɓe – Kai kaɗai za ka iya samun dama da ganin wannan mataimaki."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Raba da Ƙungiya kawai – Wannan mataimaki zai kasance a bayyane kuma mai samuwa ga membobin ƙungiyarka."},com_ui_shared_with_team:{english:"Team",translated:"Ƙungiya"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Zaɓi ƙungiyar da wannan mataimaki yake ciki. Ƙungiyoyi da kake ciki kawai za su bayyana a nan."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Fannin ƙungiya ba zai iya zama babu komai ba. Da fatan za a zaɓi ƙungiya."},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"An kulle wannan mataimakin don gyarawa saboda an raba shi da ƙungiyar."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Kuskure wajen loda hanyoyin rabawa."},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Sunan Mataimakinka yana ɗauke da kalmomi masu ɓatanci kuma ba za a iya aikawa ba. Da fatan za a sabunta sunan Mataimakinka."},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Bayaninka yana ɗauke da kalmomi masu ɓatanci kuma ba za a iya aikawa ba. Da fatan za a sabunta bayaninka."},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Umarninka yana ɗauke da kalmomi masu ɓatanci kuma ba za a iya aikawa ba. Da fatan za a sabunta umarninka."},com_ui_select_search_model:{english:"Search model by name",translated:"Nemo samfurin ta suna"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Nemo plugin ta suna"},com_ui_use_prompt:{english:"Use prompt",translated:"Yi amfani da faɗakarwa"},com_ui_prev:{english:"Prev",translated:"Na baya"},com_ui_next:{english:"Next",translated:"Na gaba"},com_ui_stop:{english:"Stop",translated:"Tsaya"},com_ui_upload_files:{english:"Upload files",translated:"Loda fayiloli"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Samfuran Faɗakarwa"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Ɓoye Samfuran Faɗakarwa"},com_ui_showing:{english:"Showing",translated:"Nuna"},com_ui_of:{english:"of",translated:"na"},com_ui_entries:{english:"Entries",translated:"Shigarwa"},com_ui_none_selected:{english:"None selected",translated:"Babu wanda aka zaɓa"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"An samu nasarar loda fayil"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"An samu kuskure wajen loda fayil ɗinka"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Fayil ɗin da aka loda ba daidai ba ne. Dole ne ya zama hoton da bai wuce 2 MB ba"},com_ui_thinking:{english:"Thinking",translated:"Tunanin"},com_ui_analyzing_request:{english:"Understanding your question",translated:"Ana nazarin buƙatarka"},com_ui_processing:{english:"Putting it together",translated:"Ana sarrafawa"},com_ui_working_on_it:{english:"Almost ready",translated:"Ana aiki akai"},com_ui_cancel:{english:"Cancel",translated:"Soke"},com_ui_save:{english:"Save",translated:"Ajiye"},com_user_message:{english:"You",translated:"Kai"},com_ui_read_aloud:{english:"Read aloud",translated:"Karanta da ƙarfi"},com_ui_copied:{english:"Copied!",translated:"An kwafi!"},com_ui_copy_code:{english:"Copy code",translated:"Kwafi lambar"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Kwafi zuwa allo"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"An kwafi zuwa allo"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Ambaci wani wuri, mataimaki, ko saitin da sauri"},com_ui_regenerate:{english:"Regenerate",translated:"Sake haifarwa"},com_ui_edit:{english:"Edit",translated:"Gyara"},com_ui_all:{english:"all",translated:"duk"},com_ui_clear:{english:"Clear",translated:"Share"},com_ui_import_conversation:{english:"Import",translated:"Shigo"},com_ui_nothing_found:{english:"Nothing found",translated:"Babu abin da aka samu"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Je zuwa tattaunawa"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Shigo da tattaunawa daga fayil ɗin JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"An shigo da tattaunawa cikin nasara"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"An samu kuskure wajen shigo da tattaunawarku"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Nau'in shigo mara tallafi"},com_ui_confirm_action:{english:"Confirm Action",translated:"Tabbatar da Aiki"},com_ui_avatar:{english:"Avatar",translated:"Avatar"},com_ui_unknown:{english:"Unknown",translated:"Ba a sani ba"},com_ui_result:{english:"Result",translated:"Sakamako"},com_ui_image_gen:{english:"Image Gen",translated:"Ƙirƙirar Hoto"},com_ui_assistant:{english:"Assistant",translated:"Mataimaki"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"An yi nasarar goge mataimaki"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"An samu kuskure wajen goge mataimaki"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"An gano fayil mai maimaitawa."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"An samu kuskure yayin ɗora fayil."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"An samu kuskure yayin ɗora fayil: Ba a ayyana Endpoint ba"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Ba a yarda da fayiloli marasa komai ba."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Za ka iya ɗora fayiloli har zuwa {0} a lokaci guda."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Za ka iya ɗora fayiloli har zuwa {0} a wannan sashe."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"An kai iyakar ɗora fayiloli don {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Ba za a iya tantance nau'in fayil ba: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Nau'in fayil bai dace ba. Da fatan za a shigar da nau'in fayil da ake goyan baya."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"An kasa ɗora hoto"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"A halin yanzu, JPEG, JPG, PNG, da WEBP kawai ake tallafawa."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Girman fayil ya wuce {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Jimillar girman fayiloli ba zai wuce {0} MB ba."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"An samu kuskure yayin tantance fayil."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"An samu kuskure yayin sarrafa fayil."},com_ui_assistants:{english:"Assistants",translated:"Mataimaka"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Taimakon Studio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Ilmi"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Ba a tsara ba"},com_ui_attachment:{english:"Attachment",translated:"Haɗi"},com_ui_assistants_output:{english:"Assistants Output",translated:"Fitar da Mataimaka"},com_ui_delete:{english:"Delete",translated:"Goge"},com_ui_create:{english:"Create",translated:"Ƙirƙira"},com_ui_share:{english:"Share",translated:"Raba"},com_ui_copy_link:{english:"Copy link",translated:"Kwafi hanyar haɗi"},com_ui_update_link:{english:"Update link",translated:"Sabunta hanyar haɗi"},com_ui_create_link:{english:"Create link",translated:"Ƙirƙiri hanyar haɗi"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Raba hanyar haɗi zuwa hira"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"An samu kuskure wajen raba hanyar haɗin hira"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Sunan ka da duk saƙonnin da ka ƙara bayan rabawa za su kasance masu zaman kansu."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"An ƙirƙiri hanyar haɗi ta jama'a zuwa hirarka. Sarrafa hirarrakin da aka raba a baya a kowane lokaci ta hanyar Saituna."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Sunan ka, umarnin al'ada, da duk saƙonnin da ka ƙara bayan rabawa za su kasance masu zaman kansu."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"An sabunta hanyar haɗi ta jama'a zuwa hirarka. Sarrafa hirarrakin da aka raba a baya a kowane lokaci ta hanyar Saituna."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Ba a sami hanyar haɗin da aka raba ba"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Goge hira?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Wannan zai goge"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Ka tabbata kana son goge wannan Mataimaki? Ba za a iya dawo da shi ba."},com_ui_rename:{english:"Rename",translated:"Sake suna"},com_ui_more_options:{english:"More",translated:"Ƙarin zaɓuɓɓuka"},com_ui_preview:{english:"Preview",translated:"Dubawa"},com_ui_upload:{english:"Upload",translated:"Loda"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Loda "{0}" yana ɗaukar lokaci fiye da yadda aka zata. Da fatan za a jira yayin da fayil ɗin ke kammala ƙididdiga don dawowa.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Manufar sirri"},com_ui_terms_of_service:{english:"Terms of service",translated:"Ka'idojin sabis"},com_ui_use_micrphone:{english:"Use microphone",translated:"Yi amfani da makirufo"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Ba za a iya cire ƙarin ƙima ba, ana buƙatar aƙalla {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Adadin mafi yawa da aka yarda shine {0}, ana amfani da ƙima na baya-bayan nan."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Ba za a iya shiga tare da bayanan da aka bayar ba. Da fatan za a duba bayanan shiga ku sake gwadawa."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"Kun wuce adadin yawan yunkurin shiga da aka yarda. Da fatan za a sake gwadawa a cikin mintuna 15."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"An dakatar da asusunku na ɗan lokaci saboda keta ka'idojin sabis ɗinmu."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"An samu kuskure a cikin uwar garke. Da fatan za a jira 'yan mintuna kaɗan kuma sake gwadawa."},com_auth_sign_in:{english:"Login",translated:"Shiga"},com_endpoint_system_message:{english:"System Message",translated:"Sakon Tsari"},com_endpoint_message:{english:"Message",translated:"Sako"},com_endpoint_messages:{english:"Messages",translated:"Sako-sako"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Gyara sakon ka ko Sake ƙirƙira."},com_endpoint_default_blank:{english:"default: blank",translated:"tsoho: babu"},com_endpoint_default_false:{english:"default: false",translated:"tsoho: ƙarya"},com_endpoint_default_creative:{english:"default: creative",translated:"tsoho: kirkira"},com_endpoint_default_empty:{english:"default: empty",translated:"tsoho: fanko"},com_endpoint_default_with_num:{english:"default: {0}",translated:"tsoho: {0}"},com_endpoint_context:{english:"Context",translated:"Mahallin"},com_endpoint_tone_style:{english:"Tone Style",translated:"Salon Sauti"},com_endpoint_token_count:{english:"Token count",translated:"Adadin Token"},com_endpoint_output:{english:"Output",translated:"Fitarwa"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Mafi Girman Tokens na Mahallin"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Adadin mafi girman tokens da za a iya amfani da su don mahallin. Yi amfani da wannan don sarrafa yawan tokens da ake aikawa kowane buƙata.
  Idan ba a fayyace ba, za a yi amfani da tsoffin tsarin da aka sani bisa girman mahallin samfuran. Saita ƙima mafi girma na iya haifar da kurakurai da/ko tsadar token mai yawa.`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Saita umarnin al'ada ko mahallin. Za a yi watsi idan babu komai."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Ya maye gurbin umarnin mataimaki. Wannan yana da amfani don gyara halayya a kowace gudu."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Sanya karin umarni ko mahallin a saman manyan umarnin Mataimaki. Ana watsi da shi idan babu komai."},com_endpoint_custom_name:{english:"Custom Name",translated:"Sunan Al'ada"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Umarnin Al'ada"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Karin Umarnin"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Maye Gurbin Umarnin"},com_endpoint_temperature:{english:"Temperature",translated:"Zazzabi"},com_endpoint_default:{english:"default",translated:"tsoho"},com_endpoint_top_p:{english:"Top P",translated:"Mafi P"},com_endpoint_top_k:{english:"Top K",translated:"Mafi K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Mafi Yawan Fitar da Alamu"},com_endpoint_stop:{english:"Stop Sequences",translated:"Tsayar da Jerin"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Raba ƙima ta danna `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Filin `max_tokens` na zaɓi, yana wakiltar mafi yawan adadin alamun da za a iya samarwa a cikin cikar tattaunawa.\n\nJimlar tsawon alamun shigarwa da alamun da aka samar yana iyakance da tsawon mahallin samfuran. Kuna iya fuskantar kurakurai idan wannan adadin ya wuce mafi yawan alamun mahallin."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Mafi girma = mafi bazuwar, yayin da ƙananan ƙima = mafi mai da hankali da ƙayyadadden. Muna ba da shawarar canza wannan ko Mafi P amma ba duka ba."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Mafi yawan alamun da za a samar. Jimlar tsawon alamun shigarwa da alamun da aka samar yana iyakance da tsawon mahallin samfurin."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Madadin samfurin tare da zazzabi, wanda ake kira samfurin nucleus, inda samfurin ke la'akari da sakamakon alamun tare da yawan yiwuwar top_p. Don haka 0.1 yana nufin kawai alamun da ke kunshe da mafi yawan yawan yiwuwar 10% ake la'akari da su. Muna ba da shawarar canza wannan ko zazzabi amma ba duka ba."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Lamba tsakanin 0 da 2.0. Kyawawan ƙima suna hukunta sababbin alamun bisa ga yawan su a cikin rubutun har yanzu, suna rage yiwuwar samfurin don maimaita layi ɗaya daidai."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Lamba tsakanin 0 da 2.0. Kyawawan ƙima suna hukunta sababbin alamun bisa ga ko sun bayyana a cikin rubutun har yanzu, suna ƙara yiwuwar samfurin don magana akan sabbin batutuwa."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Sake aika duk fayilolin da aka makala a baya. Lura: wannan zai ƙara farashin alamu kuma kuna iya fuskantar kurakurai tare da da yawa makaloli."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Matsayin warwarewa don buƙatun hangen nesa. "Low" ya fi arha kuma ya fi sauri, "High" ya fi cikakken bayani kuma ya fi tsada, kuma "Auto" zai zaɓi ta atomatik tsakanin biyun bisa ga ƙudurin hoto.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Har zuwa jerin 4 inda API zai daina samar da ƙarin alamun."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Sanya sunan al'ada don iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Sanya umarnin al'ada don haɗawa a cikin Saƙon Tsari. Tsoho: babu"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Hukuncin Maimaitawa"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Hukuncin Kasancewa"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Yi Amfani da Ayyuka"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Sake Tura Fayiloli"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Cikakken Hoton"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Tsallake Cikawa"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Saita umarnin al'ada don haɗawa a cikin Saƙon Tsari. Na asali: babu"},com_endpoint_import:{english:"Import",translated:"Shigo"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Saita suna na al'ada, idan zaka iya samun wannan saitin"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Ka tabbata kana son share wannan saitin?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"An Shigo da Saiti!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"An samu kuskure yayin shigo da saitin ka. Da fatan a sake gwadawa."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"An samu kuskure yayin adana saitin ka. Da fatan a sake gwadawa."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"An samu kuskure yayin share saitin ka. Da fatan a sake gwadawa."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"ba shine saitin asali ba."},com_endpoint_preset_default_item:{english:"Default:",translated:"Asali:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Babu saitin asali mai aiki."},com_endpoint_preset_title:{english:"Preset",translated:"Saiti"},com_endpoint_preset_saved:{english:"Saved!",translated:"An Ajiye!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"yanzu shine saitin asali."},com_endpoint_preset:{english:"preset",translated:"saiti"},com_endpoint_presets:{english:"presets",translated:"saituna"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Aiki!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Sunan Saiti"},com_endpoint:{english:"Endpoint",translated:"Wurin Ƙarshe"},com_endpoint_examples:{english:" Presets",translated:" Saituna"},com_endpoint_export:{english:"Export",translated:"Fitarwa"},com_endpoint_export_share:{english:"Export/Share",translated:"Fitarwa/Raba"},com_endpoint_assistant:{english:"Assistant",translated:"Mataimaki"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Yi Amfani da Mataimaki Mai Aiki"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Ajiye A Matsayin Saiti"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Ka tabbata kana son share duk saituna? Wannan ba zai iya dawowa ba."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Babu saituna tukuna, yi amfani da maɓallin saituna don ƙirƙirar guda"},com_endpoint_my_preset:{english:"My Preset",translated:"Saituna Na"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Samfurin Wakili (Shawara: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Samfurin Cikawa (Shawara: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Bada damar amfani da Plugins a matsayin Ayyukan OpenAI"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Bada damar tsallake matakin cikawa, wanda ke duba amsar ƙarshe da matakan da aka samar"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Da fatan za a zaɓi Mataimaki kuma fara sabon hira"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Saita Maɓallin ka a cikin menu na Header don hira."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Da fatan za a Zaɓi Mataimaki"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Barka da zuwa iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Rubutu zuwa Magana"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Autoplay Saƙon Karshe"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Magana zuwa Rubutu"},com_nav_profile_picture:{english:"Profile Picture",translated:"Hoton Bayani"},com_nav_change_picture:{english:"Change picture",translated:"Canza hoto"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Nuna Saitunan Wakili"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Nuna Saitunan Cikawa"},com_hide_examples:{english:"Hide Examples",translated:"Boye Misalai"},com_show_examples:{english:"Show Examples",translated:"Nuna Misalai"},com_nav_export_filename:{english:"Filename",translated:"Sunan fayil"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Saita sunan fayil"},com_nav_export_type:{english:"Type",translated:"Nau'i"},com_nav_export_conversation:{english:"Export conversation",translated:"Fitar da tattaunawa"},com_nav_export:{english:"Export",translated:"Fitarwa"},com_nav_shared_links:{english:"Shared links",translated:"Hanyoyin da aka raba"},com_nav_shared_links_manage:{english:"Manage",translated:"Sarrafa"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"Babu hanyoyin da aka raba."},com_nav_shared_links_name:{english:"Name",translated:"Suna"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Ranar rabawa"},com_nav_source_chat:{english:"View source chat",translated:"Duba tattaunawar asali"},com_nav_my_files:{english:"File Manager",translated:"Mai sarrafa fayil"},com_nav_admin_center:{english:"Admin Center",translated:"Cibiyar Admin"},com_nav_theme:{english:"Theme",translated:"Jigo"},com_nav_theme_system:{english:"System",translated:"Tsari"},com_nav_theme_dark:{english:"Dark",translated:"Duhu"},com_nav_theme_light:{english:"Light",translated:"Haske"},com_nav_user_name_display:{english:"Display username in messages",translated:"Nuna sunan mai amfani a cikin saƙonni"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Goge duk tattaunawa"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Tabbatar da gogewa"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Rufe gefen shafi"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Buɗe gefen shafi"},com_nav_send_message:{english:"Send message",translated:"Aika saƙo"},com_nav_log_out:{english:"Log out",translated:"Fita"},com_nav_user:{english:"USER",translated:"MAI AMFANI"},com_nav_archived_chats:{english:"Archived chats",translated:"Tattaunawar da aka adana"},com_nav_archived_chats_manage:{english:"Manage",translated:"Sarrafa"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Babu tattaunawar da aka adana."},com_nav_archive_name:{english:"Name",translated:"Suna"},com_nav_archive_created_at:{english:"DateCreated",translated:"Kwanan Wata"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Share tattaunawa"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Ka tabbata kana son share duk tattaunawa? Wannan ba zai iya dawo ba."},com_nav_help:{english:"Help",translated:"Taimako"},com_nav_user_guide:{english:"User Guide",translated:"Jagorar Mai Amfani"},com_nav_settings:{english:"Settings",translated:"Saituna"},com_nav_search_placeholder:{english:"Search messages",translated:"Nemo saƙonni"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Aika saƙo ta atomatik (bayan sakan 3)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Kuskure a lokacin kunna sauti: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Kuskure a lokacin sarrafa sauti: {0}"},com_nav_engine:{english:"Engine",translated:"Inji"},com_nav_browser:{english:"Browser",translated:"Mai lilo"},com_nav_external:{english:"External",translated:"Na waje"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Share ajiyar cache"},com_nav_voice_select:{english:"Voice",translated:"Muryar"},com_nav_setting_general:{english:"General",translated:"Janar"},com_nav_setting_speech:{english:"Speech",translated:"Magana"},com_nav_language:{english:"Language",translated:"Harshe"},com_nav_lang_auto:{english:"Auto detect",translated:"Gano ta atomatik"},com_page_not_found:{english:"Page not found",translated:"Ba a sami shafin ba"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Wani abu ya faru ba daidai ba"},com_unauthorized_access:{english:"Unauthorized access",translated:"Babu izini"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Babu izini. An takaita damar shiga ga takamaiman yankuna."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"An dakatar da asusunka na ɗan lokaci saboda keta dokokinmu"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"An takaita damar shiga app ɗin a wajen cibiyar sadarwa!"},com_support_ticket_text:{english:"Support Ticket",translated:"Tikitin Tallafi"},com_help_dialog_Header:{english:"Need assistance?",translated:"Kuna buƙatar taimako?"},com_help_dialog_text_1_1:{english:"Click",translated:"Danna"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"don samun cikakken umarni"},com_help_dialog_text_here:{english:"here",translated:"nan"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Don matsaloli, cika"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Don matsaloli, tuntubi"},com_help_dialog_text_ticket:{english:"ticket",translated:"tikiti"},com_help_dialog_text_3:{english:"Find the steps",translated:"Nemo matakan"},com_status_ind_none:{english:"Operational",translated:"Aiki"},com_status_ind_minor:{english:"Minor Issues",translated:"Ƙananan Matsaloli"},com_status_ind_major:{english:"Major Issues",translated:"Matsaloli Babba"},com_status_ind_critical:{english:"Critical",translated:"Mai Tsanani"},com_status_ind_error:{english:"Error Fetching",translated:"Kuskure wajen Samowa"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Da fatan za a lura cewa idan ka bar tattaunawa ko ka fara sabuwar tattaunawa, za ka rasa tarihin tattaunawarka."},com_forbidden_access:{english:"Forbidden access",translated:"An hana shiga"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Manufar Amfani da Dacewa"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Manufar Sirri"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Yarjejeniyar Biyan Kuɗi"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Kafin amfani da iX Hello, za ka iya duba na Concentrix"},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Ta hanyar rajista da/ko shiga, ka yarda da sharuɗɗan da ke sama."},com_login_page_and:{english:"and ",translated:"da "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Babu mataimaka da aka ɗaure"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Mataimaka da aka ɗaure"},com_ui_loading:{english:"Loading...",translated:"Ana loda..."},com_ui_unpin:{english:"Unpin",translated:"Cire ɗauri"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"An cire ɗaurin mataimaki cikin nasara"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Kuskure wajen cire ma'aikaci daga kan kari"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"An daure ma'aikaci cikin nasara"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Kuskure wajen daure/cire ma'aikaci daga kan kari"},com_ui_pin:{english:"Pin",translated:"Daure"},come_create_assistant:{english:"Create Assistant",translated:"Ƙirƙiri Ma'aikaci"},come_edit_assistant:{english:"Edit Assistant",translated:"Gyara Ma'aikaci"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Ka tabbata kana son ci gaba? Wannan zai haifar da rasa duk wani canji da aka yi ga Ma'aikacin da kake gyarawa ko ƙirƙirawa a halin yanzu. Wannan aiki ba zai iya dawo da shi ba."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Ba a sami ma'aikaci mai id {0} ba."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Burauzan ba ya goyan bayan Gane Magana"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Ba a bayar da izinin amfani da makirufo ba"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Kuskure wajen fara rikodi: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder ba ya rikodi"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder ba ya goyan baya a wannan burauzan"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Sakonka yana dauke da bayanan sirri kuma ba za a iya aikawa ba. Da fatan za a cire duk wani bayani na sirri."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"An kasa sake suna tattaunawa"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Kana da {0} daga cikin alokacin token dinka da suka rage."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello na iya yin kuskure. Da fatan za a duba dukkan fitarwa don inganci da daidaito. Duk shigarwa ana rikodin su don bin doka."},com_ui_assistant_group_by:{english:"Group by",translated:"Rarraba ta"},com_ui_assistant_category:{english:"Category",translated:"Rukuni"},com_ui_assistant_team:{english:"Team",translated:"Ƙungiya"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Injiniya"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Basira"},com_ui_assistant_marketing:{english:"Marketing",translated:"Kasuwanci"},com_ui_assistant_operations:{english:"Operations",translated:"Ayyuka"},com_ui_assistant_sales:{english:"Sales",translated:"Tallace-tallace"},com_ui_assistant_strategy:{english:"Strategy",translated:"Dabaru"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Taimakon Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Shigar da hoton avatar (PNG ko JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Bincika Kan Layi"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Duba Yanar Gizo"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Ƙirƙiri Hotuna"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Lissafin Lissafi"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Kayan Aiki Na Asali"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Shigar da fayil ya dauki lokaci fiye da yadda aka zata. Da fatan a sake gwadawa."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Kuskure wajen manne mataimaki"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"An samu kuskure wajen goge hanyar da aka raba"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Tsarin DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Babu saitin tsoho da ke aiki."},com_ui_drag_drop_title:{english:"Add anything",translated:"Ƙara komai"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Sauke kowane fayil a nan don ƙara shi cikin tattaunawa"},com_ui_analyzing:{english:"Analyzing",translated:"Ana nazari"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"An gama nazari"},com_ui_warning:{english:"Warning",translated:"Gargadi"},com_ui_proceed:{english:"Proceed",translated:"Ci gaba"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Fayilolin da aka shigar zuwa mataimaki ana amfani da su ne kawai don tattaunawa. Masu amfani na iya samun damar abun cikin wadannan fayiloli ta hanyar tambayar tambayoyi masu dacewa, amma ba a yarda a sauke fayilolin kai tsaye ba."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Saita suna na musamman don wannan saitin"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Saita misalin shigarwa. Ana watsi da misali idan babu komai."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Saita misalin fitarwa. Ana watsi da misali idan babu komai."},com_nav_export_select_type:{english:"Select a file type",translated:"Zaɓi nau'in fayil"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"screenshot (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"rubutu (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Ba a sami amsa ba. Da fatan za a sake aika sakonku. Idan matsalar ta ci gaba bayan sake loda shafin da sake gwadawa, da fatan za a tuntubi tallafi."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Komawa Zuwa Tattaunawa"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Tsarin Kula da Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"An kunna tsarin kula da guardrail don wannan mataimaki. Za a duba abun ciki da manufofin kula."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Kashe tsarin kula da guardrail yana cire duba abun ciki don wannan mataimaki. Kai ke da alhakin bin manufofin abun ciki na ƙungiyar ku. Ana yin cikakken rikodin da sa ido kan ayyuka."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Da fatan a bayyana dalilin kasuwancin ku na kashe tsarin kula da guardrail (ana buƙata)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Da fatan a bayar da dalili na kashe tsarin kula da guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Bada izinin masu amfani su canza samfurin a cikin hira"},com_ui_feedback_good:{english:"Good response",translated:"Amsa mai kyau"},com_ui_feedback_bad:{english:"Poor response",translated:"Amsa mara kyau"},com_ui_feedback_comments:{english:"Comments",translated:"Sharhi"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Sharhi (zabi)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Gaya mana ƙari game da ƙwarewar ka..."},com_ui_feedback_submit:{english:"Submit",translated:"Aika"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Ba mu iya aika ra'ayinka ba"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Ba daidai ba"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Ba da alaƙa ba"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Ya tsufa"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Ba isassun cikakkun bayanai ba"},com_ui_feedback_reason_other:{english:"Other",translated:"Sauran"},com_ui_model_recommended:{english:"Recommended",translated:"Shawarar"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Tsoho — don Allah sabunta"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Ba a tallafawa wannan samfurin ba. Da fatan za a zaɓi sabon samfurin."},com_nav_setting_memory:{english:"Memory",translated:"Ƙwaƙwalwa"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Sarrafa bayanan sirri da mataimaki ke tunawa a cikin tattaunawarku."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Ƙara sabon ƙwaƙwalwa…"},com_nav_memory_add_button:{english:"Add memory",translated:"Ƙara ƙwaƙwalwa"},com_nav_memory_category:{english:"Category",translated:"Rukuni"},com_nav_memory_category_preference:{english:"Preference",translated:"Zaɓi"},com_nav_memory_category_identity:{english:"Identity",translated:"Asali"},com_nav_memory_category_context:{english:"Context",translated:"Yanayi"},com_nav_memory_category_project:{english:"Project",translated:"Aikin"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Babu ƙwaƙwalwa tukuna"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Ƙwaƙwalwar da ka ajiye za ta bayyana a nan kuma ta taimaka wajen keɓance tattaunawa na gaba."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Ba a iya ɗora ƙwaƙwalwa ba. Da fatan a sake gwadawa."},com_nav_memory_retry:{english:"Retry",translated:"Sake gwadawa"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Ba a iya ƙara ƙwaƙwalwa ba. Da fatan a sake gwadawa."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Ba a iya sabunta ƙwaƙwalwa ba. Da fatan a sake gwadawa."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Ba a iya goge ƙwaƙwalwa ba. Da fatan a sake gwadawa."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Goge wannan ƙwaƙwalwa?"},com_nav_memory_delete_button:{english:"Delete",translated:"Goge"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Gyara ƙwaƙwalwa"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Goge ƙwaƙwalwa"},com_nav_memory_save:{english:"Save",translated:"Ajiye"},com_nav_memory_cancel:{english:"Cancel",translated:"Soke"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"An ajiye {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — sabon GPT-5 samfurin tunani tare da hankali na zamani."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — ƙaramar sigar GPT-5.4 mai arha."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — sabon samfurin GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Sabon Opus — basira ta gaba don wakilan lamba da ayyukan kasuwanci."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Sabon Opus — basira ta gaba don wakilan lamba da ayyukan kasuwanci."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet mai ƙarfi tare da ingantaccen tunani da bin umarni."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Mafi ƙarfi samfurin Anthropic don ayyuka masu rikitarwa da yawa."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Daidaitaccen basira da sauri don ayyuka daban-daban."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Mafi sauri kuma mafi ƙanƙanta samfurin Claude — ya dace da ayyuka masu yawa."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — ingantaccen tunani da damar multimodal."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Babban samfurin OpenAI na gaba."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 mai sauƙi — mai inganci da sauri don ayyukan yau da kullum."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — ingantaccen bin umarni da tunani."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"Ƙaramar GPT-4.1 — mai sauri da arha don ayyuka masu sauƙi."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Mafi ƙwarewa samfurin GPT-4, an inganta don sauri da farashi."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o mai sauƙi — mai sauri da arha don ayyuka masu sauƙi."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Preview) — samfurin Gemini mafi ƙarfi tare da mahallin 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Preview) — sauri da inganci tare da mahallin 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — samfurin haske mai ƙarancin jinkiri tare da mahallin 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Samfurin mataimaki mai daidaitawa da murya na ciki."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto yana zaɓar mafi kyawun ƙirar don buƙatar ku bisa ƙarfi da aiki."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Na Tafe Ba Da Jimawa Ba"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Zaɓuɓɓukan jagorantarwa ta atomatik"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Daidaita yadda mai jagorantarwa ta atomatik ke daidaita musayar daidaito wajen zaɓar samfurin kowane juyi. Ana daidaita nauyi — daidaiton dangi ne yake da muhimmanci."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Farashi"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Ba fifiko ga samfura masu rahusa da ƙananan kuɗin token."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Daidaito"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Ba fifiko ga samfura masu ƙarfi don tunani mai rikitarwa."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Sauri"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Ba fifiko ga samfura masu sauri, masu ƙarancin jinkiri."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Mayar da tsoffin saituna"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Lokacin loda fayil ya ƙare. Da fatan a sake gwadawa cikin ƴan mintuna."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Wani abu ya faru ba daidai ba. Ga takamaiman saƙon kuskuren da muka samu: An sami kuskure yayin sarrafa buƙatarku. Mataimakin ba ya samuwa kuma. Da fatan za a tuntuɓi Admin."},com_ui_code:{english:"Code",translated:"Lambar"},com_ui_assistant_share:{english:"Share",translated:"Raba"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"An kwafi hanyar haɗi"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Ba ka da damar shiga wannan mataimaki"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",transla