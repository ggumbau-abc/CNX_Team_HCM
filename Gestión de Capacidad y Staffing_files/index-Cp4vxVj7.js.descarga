n_error:"Aṣiṣe yiyọ aṣoju kuro",com_ui_assistant_pin_success:"Aṣoju ti wa ni pinni ni aṣeyọri",com_ui_assistant_pin_unpin_error:"Aṣiṣe pinni/yiyọ aṣoju kuro",com_ui_pin:"Pinni",come_create_assistant:"Ṣẹda Aṣoju",come_edit_assistant:"Ṣatunkọ Aṣoju",com_ui_edit_assistant_confirm:"Ṣe o da ọ loju pe o fẹ tẹsiwaju? Eyi yoo ja si pipadanu eyikeyi awọn ayipada ti a ṣe si Aṣoju ti o n ṣatunkọ tabi ṣẹda lọwọlọwọ. Iṣe yii ko le yipada.",com_ui_assistant_not_found:"Aṣoju pẹlu id {0} ko ri.",com_ui_speech_recognition_browser_support_error:"Burausa ko ṣe atilẹyin SpeechRecognition",com_ui_microphone_permission_error:"A ko fun ni igbanilaaye gbohungbohun",com_ui_starting_recording_error:"Aṣiṣe ibẹrẹ gbigbasilẹ: {0}",com_ui_media_recorder_error:"MediaRecorder ko n ṣe igbasilẹ",com_ui_media_recorder_browser_support_error:"MediaRecorder ko ṣe atilẹyin ninu burausa yii",com_ui_chat_personal_information_error:"Ifiranṣẹ rẹ ni alaye ti ara ẹni ati pe ko le firanṣẹ. Jọwọ yọ eyikeyi alaye ti ara ẹni.",com_ui_conversation_rename_error:"Ikuna lati tun orukọ ibaraẹnisọrọ",com_ui_remaining_tokens:"O ni {0} ti awọn aami ti a pin silẹ.",com_ui_footer_disclaimer:"iX Hello le ṣe aṣiṣe. Jọwọ ṣe ayẹwo gbogbo awọn abajade fun didara ati deede. Gbogbo awọn igbewọle ni a gbasilẹ fun ibamu.",com_ui_assistant_group_by:"Ẹgbẹ nipasẹ",com_ui_assistant_category:"Ẹka",com_ui_assistant_team:"Ẹgbẹ",com_ui_assistant_CX:"CX",com_ui_assistant_engineering:"Imọ-ẹrọ",com_ui_assistant_intelligence:"Oye",com_ui_assistant_marketing:"Iṣowo",com_ui_assistant_operations:"Awọn iṣẹ",com_ui_assistant_sales:"Tita",com_ui_assistant_strategy:"Ilana",com_ui_assistant_studio_assistance:"Iranlọwọ Studio",com_ui_avatar_upload_instructions:"Po aworan avatar kan (PNG tabi JPG < 2MB)",com_ui_assistant_tools_search_online:"Ṣawari Lori Ayelujara",com_ui_assistant_tools_browse_website:"Ṣàbẹwò Ojúlé Ayélujára",com_ui_assistant_tools_generate_images:"Ṣẹda Aworan",com_ui_assistant_tools_calculate_math:"Ṣe iṣiro Math",com_ui_assistant_tools_default:"Ọpa Aiyipada",com_ui_assistant_file_upload_timeout:"Gbigbe faili n gba akoko ju ti a ti reti lọ. Jọwọ gbiyanju lẹẹkansi.",com_ui_assistant_pin_error:"Aṣiṣe ninu fifi amugbalegbe mọlẹ",com_ui_share_delete_error:"Aṣiṣe kan wa ninu piparẹ ọna asopọ pinpin",com_ui_dan:"DAN",com_ui_dan_template:"Àwòrán DAN",com_endpoint_preset_default_none_HIDDEN:"Ko si eto aiyipada ti nṣiṣe lọwọ.",com_ui_drag_drop_title:"Fi ohunkohun kun",com_ui_drag_drop_description:"Ju faili eyikeyi si ibi lati fi kun si ibaraẹnisọrọ",com_ui_analyzing:"N ṣàlàyé",com_ui_finished_analyzing:"Pari ṣàlàyé",com_ui_warning:"Ikilọ",com_ui_proceed:"Tẹsiwaju",com_ui_file_upload_warning:"Awọn faili ti a gbe si amugbalegbe ni a lo fun awọn idi ibaraẹnisọrọ nikan. Awọn olumulo le wọle si akoonu awọn faili wọnyi nipa beere awọn ibeere ti o yẹ, ṣugbọn gbigba lati ayelujara taara ti awọn faili ko gba laaye.",com_endpoint_preset_name_placeholder:"Ṣeto orukọ aṣa fun eto yii",com_endpoint_example_input_placeholder:"Ṣeto apẹẹrẹ igbewọle. Apẹẹrẹ ni a foju silẹ ti o ba ṣofo.",com_endpoint_example_output_placeholder:"Ṣeto apẹẹrẹ igbewọle. Apẹẹrẹ ni a foju silẹ ti o ba ṣofo.",com_nav_export_select_type:"Yan iru faili kan",com_nav_export_type_screenshot:"sikirinisoti (.png)",com_nav_export_type_text:"ọrọ (.txt)",com_nav_export_type_markdown:"markdown (.md)",com_nav_export_type_json:"json (.json)",com_nav_export_type_csv:"csv (.csv)",com_ui_error_empty_agent_response:"Ko si esi ti a gba. Jọwọ gbiyanju lati fi ifiranṣẹ rẹ ranṣẹ lẹẹkansi. Ti iṣoro naa ba wa lẹhin atunṣe oju-iwe ati igbiyanju lẹẹkansi, jọwọ kan si atilẹyin.",com_ui_back_to_chat:"Padà sí Iwiregbe",com_assistants_guardrail_moderation:"Ìtójú Guardrail",com_assistants_guardrail_moderation_enabled_info:"Ìtójú guardrail ti ṣiṣẹ́ fún iranṣẹ́ yìí. Àkóónú yóò jẹ́ ayẹwo sí ìlànà ìtójú.",com_assistants_guardrail_moderation_disabled_info:"Ìdínà ìtójú guardrail yọ ìtójú àkóónú fún iranṣẹ́ yìí. Ìwọ ni ojuse láti tẹ̀lé ìlànà àkóónú ilé iṣẹ́ rẹ. Àwọn ìṣẹ̀lẹ̀ ni a gbé kalẹ̀ àti ṣàkóso.",com_assistants_guardrail_moderation_off_reason_placeholder:"Jọ̀wọ́ ṣàlàyé ìdáhùn ìṣòwò rẹ fún ìdínà ìtójú guardrail (àìní).",com_assistants_guardrail_moderation_reason_required:"Jọ̀wọ́ pèsè ìdáhùn fún ìdínà ìtójú guardrail.",com_assistants_allow_model_switching:"Gba awọn olumulo laaye lati yi awoṣe pada ninu iwiregbe",com_ui_feedback_good:"Ìdáhùn rere",com_ui_feedback_bad:"Ìdáhùn burúkú",com_ui_feedback_comments:"Àwọn ìwòye",com_ui_feedback_comments_optional:"Àwọn ìwòye (àṣàyàn)",com_ui_feedback_placeholder:"Jẹ́ kí a mọ̀ sí i nípa iriri rẹ...",com_ui_feedback_submit:"Fíránṣẹ́",com_ui_feedback_error:"A kò lè rán àwọn ìmọ̀ rẹ síbẹ̀",com_ui_feedback_reason_incorrect:"Àìṣòótọ́",com_ui_feedback_reason_not_relevant:"Kò ní í ṣe pẹ̀lú ọ̀rọ̀",com_ui_feedback_reason_outdated:"Ti pẹ́ jù",com_ui_feedback_reason_not_enough_detail:"Alaye kò tó",com_ui_feedback_reason_other:"Mìíràn",com_ui_model_recommended:"Àwọn àbá",com_ui_model_legacy:"Ìtàn – jọ̀wọ́ ṣe àtúnṣe",com_ui_model_legacy_invalid:"Akọ́lé yìí kò ṣe àtìlẹ́yìn mọ́. Jọwọ yan akọ́lé tuntun.",com_nav_setting_memory:"Iranti",com_nav_memory_description:"Ṣakoso awọn otitọ ti ara ẹni ti aṣoju ranti kọja awọn ibaraẹnisọrọ rẹ.",com_nav_memory_add_placeholder:"Fi iranti tuntun kun…",com_nav_memory_add_button:"Fi iranti kun",com_nav_memory_category:"Ẹka",com_nav_memory_category_preference:"Ayanfẹ",com_nav_memory_category_identity:"Idanimọ",com_nav_memory_category_context:"Akọkọ",com_nav_memory_category_project:"Ise agbese",com_nav_memory_empty_title:"Ko si awọn iranti sibẹsibẹ",com_nav_memory_empty_description:"Awọn iranti ti o fipamọ yoo han nibi ati ṣe iranlọwọ lati ṣe akanṣe awọn ibaraẹnisọrọ iwaju.",com_nav_memory_load_error:"Ko le gba awọn iranti. Jọwọ gbiyanju lẹẹkansi.",com_nav_memory_retry:"Tun gbiyanju",com_nav_memory_add_error:"Ko le fi iranti kun. Jọwọ gbiyanju lẹẹkansi.",com_nav_memory_update_error:"Ko le ṣe imudojuiwọn iranti. Jọwọ gbiyanju lẹẹkansi.",com_nav_memory_delete_error:"Ko le paarẹ iranti. Jọwọ