xplain your business justification for disabling memory (required).",translated:"Veuillez expliquer la justification professionnelle de la désactivation de la mémoire (obligatoire)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Veuillez fournir une justification pour la désactivation de la mémoire."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"La mémoire est désactivée pour votre équipe. Vous pouvez consulter et supprimer les souvenirs existants, mais vous ne pouvez pas en ajouter ni en modifier."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Exécution de votre code"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"Recherche dans la base de connaissances"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Traitement de la voix"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"Enregistrement dans la mémoire"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"Suppression de la mémoire"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Recherche sur le Web terminée"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Examen de la page Web terminé"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"Image générée"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Calcul terminé"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"Exécution de votre code terminée"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"Recherche dans la base de connaissances terminée"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"Traitement de l’entrée vocale terminé"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"Enregistré dans la mémoire"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"Supprimé de la mémoire"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"Terminé : {0}"},com_ui_still_working:{english:"still working...",translated:"toujours en cours..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} est prêt"},com_ui_file_ready_fallback:{english:"File is ready",translated:"Le fichier est prêt"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"{0} n’a pas pu être traité"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"Le fichier n’a pas pu être traité"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"{0} n’a pas pu être traité. Veuillez téléverser de nouveau le fichier."},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"Le fichier n’a pas pu être traité. Veuillez téléverser de nouveau le fichier."},com_ui_file_processing:{english:"Processing...",translated:"Traitement..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"Échec du traitement"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"Échec - téléversement à nouveau requis"},com_ui_file_retry:{english:"Retry",translated:"Réessayer"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"Réessayer dans {0}s"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"Nouvelle tentative d’indexation du fichier..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"