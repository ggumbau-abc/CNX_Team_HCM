azi ukubuyiselwa emuva."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Umsizi onenombolo ye-ID {0} awutholakalanga."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Isiphequluli asisekeli i-SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Imvume ye-microphone ayinikeziwe"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Iphutha ekuqaleni kokuqopha: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"I-MediaRecorder ayiqophi"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"I-MediaRecorder ayisekelwa kulesi siphequluli"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Umlayezo wakho uqukethe ulwazi lomuntu siqu futhi awuthunyelwanga. Sicela ususe noma yiluphi ulwazi lomuntu siqu."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Yehlulekile ukuvuselela igama lengxoxo"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Usenazo {0} zamathokheni akho anikeziwe asele."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello ingenza amaphutha. Sicela ubuyekeze yonke imiphumela ukuze uqinisekise ikhwalithi nokunemba. Yonke iminikelo iyagcinwa ukuze kuhlangatshezwane nezidingo."},com_ui_assistant_group_by:{english:"Group by",translated:"Hlukanisa ngeqembu"},com_ui_assistant_category:{english:"Category",translated:"Isigaba"},com_ui_assistant_team:{english:"Team",translated:"Ithimba"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_e