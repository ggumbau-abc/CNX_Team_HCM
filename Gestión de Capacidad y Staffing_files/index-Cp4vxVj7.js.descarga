ranslated:"類別"},com_ui_assistant_team:{english:"Team",translated:"團隊"},com_ui_assistant_CX:{english:"CX",translated:"客戶體驗"},com_ui_assistant_engineering:{english:"Engineering",translated:"工程"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"智能"},com_ui_assistant_marketing:{english:"Marketing",translated:"行銷"},com_ui_assistant_operations:{english:"Operations",translated:"運營"},com_ui_assistant_sales:{english:"Sales",translated:"銷售"},com_ui_assistant_strategy:{english:"Strategy",translated:"策略"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"工作室助理"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"上傳頭像圖片（PNG 或 JPG < 2MB）"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"在線搜索"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"瀏覽網站"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"生成圖片"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"計算數學"},com_ui_assistant_tools_default:{english:"Running tool",translated:"默認工具"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"檔案上傳時間超過預期。請再試一次。"},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"固定助手時出錯"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"刪除共享連結時出錯"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"DAN 範本"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"沒有預設的預設值。"},com_ui_drag_drop_title:{english:"Add anything",translated:"添加任何內容"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"將任何檔案拖放到此處以添加到對話中"},com_ui_analyzing:{english:"Analyzing",translated:"分析中"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"分析完成"},com_ui_warning:{english:"Warning",translated:"警告"},com_ui_proceed:{english:"Proceed",translated:"繼續"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"上傳到助手的檔案僅用於對話目的。用戶可以通過提問訪問這些檔案的內容，但不允許直接下載檔案。"},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"為此預設設置自訂名稱"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"設置範例輸入。若為空則忽略範例。"},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"設置範例輸出。若為空則忽略範例。"},com_nav_export_select_type:{english:"Select a file type",translated:"選擇檔案類型"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"截圖 (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"文字 (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"Markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"JSON (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"CSV (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"未收到回應。請重試發送您的訊息。如果重新載入頁面並重試後問題仍然存在，請聯絡支援。"},com_ui_back_to_chat:{english:"Back to Chat",translated:"返回聊天"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"護欄審核"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"此助理已啟用護欄審核。內容將依據審核政策進行檢查。"},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"停用護欄審核將移除此助理的內容審核檢查。您需負責遵守組織的內容政策。所有活動均被完整記錄和監控。"},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"請說明停用護欄審核的業務理由（必填）。"},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"請提供停用護欄審核的理由。"},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"允許用戶在聊天中切換模型"},com_ui_feedback_good:{english:"Good response",translated:"良好回覆"},com_ui_feedback_bad:{english:"Poor response",translated:"不良回覆"},com_ui_feedback_comments:{english:"Comments",translated:"評論"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"評論（可選）"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"請告訴我們您的體驗..."},com_ui_feedback_submit:{english:"Submit",translated:"提交"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"無法傳送您的意見回饋"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"不正確"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"不相關"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"已過時"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"詳情不足"},com_ui_feedback_reason_other:{english:"Other",translated:"其他"},com_ui_model_recommended:{english:"Recommended",translated:"推薦"},com_ui_model_legacy:{english:"Legacy — please update",translated:"舊版 — 請更新"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"此模型不再支援。請選擇當前模型。"},com_nav_setting_memory:{english:"Memory",translated:"記憶"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"管理助理在對話中