art_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Prefixul inteligent a fost folosit pentru Asistenți Generali, vă rugăm să folosiți un alt nume."},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Câmpul descrierii nu poate fi gol. Vă rugăm să introduceți o descriere validă."},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Câmpul instrucțiunilor nu poate fi gol. Vă rugăm să introduceți instrucțiuni valide."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Câmpul categoriei nu poate fi gol. Vă rugăm să selectați o categorie."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"A fost detectat un nume de asistent duplicat. Vă rugăm să alegeți un nume unic."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Câmpul de partajare nu poate fi gol. Vă rugăm să selectați o opțiune de partajare."},com_ui_shared_with:{english:"Shared With",translated:"Partajat cu"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Privat – Doar dumneavoastră puteți accesa și vizualiza acest asistent."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Partajați doar cu echipa – Acest asistent va fi vizibil și accesibil membrilor echipei dumneavoastră."},com_ui_shared_with_team:{english:"Team",translated:"Echipă"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Selectați echipa din care face parte acest asiste