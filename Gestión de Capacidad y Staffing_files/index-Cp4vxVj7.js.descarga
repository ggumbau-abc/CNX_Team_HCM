pload_fallback:"파일을 처리할 수 없습니다. 파일을 다시 업로드하세요.",com_ui_file_processing:"처리 중...",com_ui_file_processing_failed_status:"처리 실패",com_ui_file_processing_failed_reupload_required:"실패 - 다시 업로드 필요",com_ui_file_retry:"다시 시도",com_ui_file_retry_in:"{0}초 후 다시 시도",com_ui_file_indexing_retrying:"파일 인덱싱 다시 시도 중...",com_ui_file_retry_wait:"다시 시도하기 전에 {0}초 기다려 주세요",com_ui_file_retries_exhausted_reupload:"최대 재시도 횟수에 도달했습니다. 파일을 다시 업로드해 주세요.",com_ui_assistant_file_upload_invalid_json:"잘못된 JSON 파일입니다. 파일 내용이 예상 형식과 일치하지 않습니다."},wk={com_ui_examples:{english:"Examples",translated:"예시"},com_ui_new_chat:{english:"New chat",translated:"새 채팅"},com_ui_conversations:{english:"Chats",translated:"대화"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"대화를 시작하다..."},com_ui_new_conversation:{english:"New Chat",translated:"새 대화"},com_ui_assistant_library:{english:"Assistant Library",translated:"도우미 라이브러리"},com_ui_assistant_search:{english:"Search for an assistant",translated:"도우미 검색"},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"양자 컴퓨팅을 간단하게 설명해줄래?"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"10살 아이 생일 파티를 위한 참신한 아이디어 있을까?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"자바스크립트에서 HTTP 요청을 어떻게 만드나요?"},com_ui_capabilities:{english:"Capabilities",translated:"기능"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"대화 중 사용자가 이전에 말한 것을 기억해요."},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"사용자가 수정 사항을 제공할 수 있어요."},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"부적절한 요청을 거부하도록 훈련되었어요."},com_ui_limitations:{english:"Limitations",translated:"제한사항"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"간혹 잘못된 정보를 생성할 수 있습니다."},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"간혹 해로운 지시나 편향된 내용을 제공할 수 있습니다."},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"2021년 이후의 세계 및 이벤트에 대한 지식이 제한적입니다."},com_ui_input:{english:"Input",translated:"입력"},com_ui_close:{english:"Close",translated:"닫기"},com_ui_model:{english:"Model",translated:"모델"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"이름은 필수입니다"},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"스마트 접두사는 100자 이하로 설정하세요"},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"설명은 필수입니다"},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"지침은 필수입니다"},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"카테고리 필드를 비울 수 없습니다. 카테고리를 선택하세요"},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"이미 존재하는 어시스턴트 이름입니다"},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"공유 대상은 필수입니다"},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"이름에 부적절한 언어가 포함되어 있습니다"},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"설명에 부적절한 언어가 포함되어 있습니다"},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"지침에 부적절한 언어가 포함되어 있습니다"},com_ui_shared_with:{english:"Shared With",translated:"공유 대상"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Private – Only you can access and view this assistant."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Share only with Team – This assistant will be visible and accessible to your team members."},com_ui_shared_with_team:{english:"Team",translated:"팀과 공유"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Select the team this assistant belongs to. Only teams you are a member of will appear here."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"팀은 필수입니다"},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"이 어시스턴트는 팀과 공유되어 있어 편집이 잠겨 있습니다."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"공유 링크 로드 오류"},com_ui_use_prompt:{english:"Use prompt",translated:"프롬프트 사용"},com_ui_prev:{english:"Prev",translated:"이전"},com_ui_next:{english:"Next",translated:"다음"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"프롬프트 템플릿"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"프롬프트 템플릿 숨기기"},com_ui_showing:{english:"Showing",translated:"표시 중"},com_ui_of:{english:"of",translated:"/"},com_ui_entries:{english:"Entries",translated:"개"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"파일 업로드 성공"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"잘못된 파일입니다"},com_ui_cancel:{english:"Cancel",translated:"취소"},com_ui_save:{english:"Save",translated:"저장"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"클립보드에 복사"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"클립보드에 복사되었습니다"},com_ui_regenerate:{english:"Regenerate",translated:"재생성"},com_ui_edit:{english:"Edit",translated:"편집"},com_ui_all:{english:"all",translated:"전체"},com_ui_clear:{english:"Clear",translated:"지우기"},com_ui_import_conversation:{english:"Import",translated:"가져오기"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"JSON 파일에서 대화 가져오기"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"대화가 성공적으로 가져와졌습니다"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"대화를 가져오는 동안 오류가 발생했습니다"},com_ui_confirm_action:{english:"Confirm Action",translated:"작업 확인"},com_ui_share:{english:"Share",translated:"Share"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Share link to chat"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"There was an error sharing the chat link"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Your name and any messages you add after sharing stay private."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been created. Manage previously shared chats at any time via Settings."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Your name, custom instructions, and any messages you add after sharing stay private."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Shared link not found"},com_ui_delete:{english:"Delete",translated:"삭제"},com_ui_delete_conversation:{english:"Delete chat?",translated:"채팅을 삭제하시겠습니까?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"이 채팅이 삭제됩니다"},com_ui_rename:{english:"Rename",translated:"이름 바꾸기"},com_ui_more_options:{english:"More",translated:"더 보기"},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"제공된 정보로 로그인할 수 없습니다. 자격 증명을 확인하고 다시 시도하세요."},com_auth_sign_in:{english:"Login",translated:"로그인"},com_endpoint_system_message:{english:"System Message",translated:"시스템 메시지"},com_endpoint_default_blank:{english:"default: blank",translated:"기본값: 공백"},com_endpoint_default_false:{english:"default: false",translated:"기본값: false"},com_endpoint_default_creative:{english:"default: creative",translated:"기본값: 창의적"},com_endpoint_default_empty:{english:"default: empty",translated:"기본값: 비어 있음"},com_endpoint_default_with_num:{english:"default: {0}",translated:"기본값: {0}"},com_endpoint_context:{english:"Context",translated:"컨텍스트"},com_endpoint_tone_style:{english:"Tone Style",translated:"톤 스타일"},com_endpoint_token_count:{english:"Token count",translated:"토큰 수"},com_endpoint_output:{english:"Output",translated:"출력"},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"사용자 정의 지시사항 또는 컨텍스트를 설정하세요. 비어 있으면 무시됩니다."},com_endpoint_custom_name:{english:"Custom Name",translated:"사용자 정의 이름"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"프롬프트 접두사"},com_endpoint_temperature:{english:"Temperature",translated:"온도"},com_endpoint_default:{english:"default",translated:"기본값"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"최대 출력 토큰 수"},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"높은 값 = 더 무작위, 낮은 값 = 더 집중적이고 결정적입니다. 이 값을 변경하거나 Top P 중 하나만 변경하는 것을 권장합니다."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"생성할 최대 토큰 수입니다. 입력 토큰과 생성된 토큰의 총 길이는 모델의 컨텍스트 길이로 제한됩니다."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"온도를 사용한 샘플링 대신, top_p 확률 질량을 고려하는 nucleus 샘플링입니다. 따라서 0.1은 상위 10% 확률 질량을 구성하는 토큰만 고려합니다. 이 값을 변경하거나 온도를 변경하는 것을 권장하지만, 둘 다 변경하지는 마세요."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"텍스트에서 토큰의 빈도수에 따라 새로운 토큰에 패널티를 부여합니다. 이전에 나온 텍스트의 빈도수에 따라 새로운 토큰의 확률이 감소하여 동일한 문장을 반복할 가능성을 줄입니다."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"텍스트에서 토큰이 나타나는지 여부에 따라 새로운 토큰에 패널티를 부여합니다. 이전에 나온 텍스트에 나타나는 토큰에 대한 패널티를 증가시켜 새로운 주제에 대해 이야기할 가능성을 높입니다."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"ChatGPT에 대한 사용자 정의 이름을 설정하세요."},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"시스템 메시지에 포함할 사용자 정의 지시사항을 설정하세요. 기본값: 없음"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"빈도 패널티"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"존재 패널티"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"함수 사용"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"완료 단계 건너뛰기"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"시스템 메시지에 포함할 사용자 정의 지시사항을 설정하세요. 기본값: 없음"},com_endpoint_import:{english:"Import",translated:"가져오기"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"프리셋을 쉽게 찾을 수 있도록 사용자 정의 이름을 설정하세요"},com_endpoint_preset:{english:"preset",translated:"프리셋"},com_endpoint_presets:{english:"presets",translated:"프리셋"},com_endpoint_preset_name:{english:"Preset Name",translated:"프리셋 이름"},com_endpoint:{english:"Endpoint",translated:"엔드포인트"},com_endpoint_examples:{english:" Presets",translated:" 프리셋"},com_endpoint_export:{english:"Export",translated:"내보내기"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"프리셋으로 저장"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"모든 프리셋을 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"아직 프리셋이 없습니다"},com_endpoint_my_preset:{english:"My Preset",translated:"내 프리셋"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"에이전트 모델 (권장: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"완료 모델 (권장: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"플러그인을 OpenAI 함수로 사용할 수 있도록 합니다."},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"완료 단계를 건너뛰도록 합니다. 최종 답변과 생성된 단계를 검토하는 단계입니다."},com_nav_export_filename:{english:"Filename",translated:"파일 이름"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"파일 이름을 설정하세요"},com_nav_export_type:{english:"Type",translated:"유형"},com_nav_export_conversation:{english:"Export conversation",translated:"대화 내보내기"},com_nav_export:{english:"Export",translated:"내보내기"},com_nav_shared_links:{english:"Shared links",translated:"공유 링크"},com_nav_shared_links_manage:{english:"Manage",translated:"관리"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"공유 링크가 없습니다."},com_nav_shared_links_name:{english:"Name",translated:"이름"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"공유 날짜"},com_nav_theme:{english:"Theme",translated:"테마"},com_nav_theme_system:{english:"System",translated:"시스템"},com_nav_theme_dark:{english:"Dark",translated:"다크"},com_nav_theme_light:{english:"Light",translated:"라이트"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"모든 채팅 지우기"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"지우기 확인"},com_nav_close_sidebar:{english:"Close sidebar",translated:"사이드바 닫기"},com_nav_open_sidebar:{english:"Open sidebar",translated:"사이드바 열기"},com_nav_send_message:{english:"Send message",translated:"메시지 보내기"},com_nav_log_out:{english:"Log out",translated:"로그아웃"},com_nav_user:{english:"USER",translated:"사용자"},com_nav_archived_chats:{english:"Archived chats",translated:"아카이브된 채팅"},com_nav_archived_chats_manage:{english:"Manage",translated:"관리"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"아카이브된 채팅이 없습니다"},com_nav_archive_name:{english:"Name",translated:"이름"},com_nav_archive_created_at:{english:"DateCreated",translated:"생성 날짜"},com_nav_clear_conversation:{english:"Clear conversations",translated:"대화 지우기"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"모든 대화를 지우시겠습니까? 이 작업은 되돌릴 수 없습니다."},com_nav_help:{english:"Help",translated:"도움말"},com_nav_settings:{english:"Settings",translated:"설정"},com_nav_search_placeholder:{english:"Search messages",translated:"메시지 검색"},com_nav_setting_general:{english:"General",translated:"일반"},com_assistants_file_search:{english:"File Search",translated:"파일 검색"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"어시스턴트가 파일을 검색할 수 있도록 지원합니다."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"지원되는 파일 유형"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"팁"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"파일 검색은 지원되는 파일 유형에 대해 작동합니다. 파일은 5MB 이하이어야 하며, 파일 이름은 100자 이하여야 합니다."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"파일 검색을 위한 벡터 저장소 연결은 아직 지원되지 않습니다. Provider Playground에서 연결하거나 스레드 기반으로 메시지에 파일을 첨부하여 파일 검색을 할 수 있습니다."},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"이 모델에서는 파일 검색 기능을 사용할 수 없습니다. 다른 모델을 선택하세요."},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"어시스턴트 파일을 다른 엔드포인트에 첨부할 수 없습니다."},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"어시스턴트가 성공적으로 삭제되었습니다"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"어시스턴트 삭제 중 오류가 발생했습니다."},com_ui_copied:{english:"Copied!",translated:"복사됨"},com_ui_copy_code:{english:"Copy code",translated:"코드 복사"},com_ui_copy_link:{english:"Copy link",translated:"링크 복사"},com_ui_update_link:{english:"Update link",translated:"링크 업데이트"},com_ui_create_link:{english:"Create link",translated:"링크 만들기"},com_nav_source_chat:{english:"View source chat",translated:"소스 채팅 보기"},com_ui_date_today:{english:"Today",translated:"오늘"},com_ui_date_yesterday:{english:"Yesterday",translated:"어제"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"지난 7일"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"지난 30일"},com_ui_date_january:{english:"January",translated:"1월"},com_ui_date_february:{english:"February",translated:"2월"},com_ui_date_march:{english:"March",translated:"3월"},com_ui_date_april:{english:"April",translated:"4월"},com_ui_date_may:{english:"May",translated:"5월"},com_ui_date_june:{english:"June",translated:"6월"},com_ui_date_july:{english:"July",translated:"7월"},com_ui_date_august:{english:"August",translated:"8월"},com_ui_date_september:{english:"September",translated:"9월"},com_ui_date_october:{english:"October",translated:"10월"},com_ui_date_november:{english:"November",translated:"11월"},com_ui_date_december:{english:"December",translated:"12월"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"어시스턴트가 {0}에게 이 정보를 보냈습니다"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"어시스턴트에서 작업이 성공적으로 삭제되었습니다"},com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"제출된 내용이 커뮤니티 가이드라인에 부합하지 않는다고 판단되어 모더레이션 시스템에 의해 차단되었습니다. 해당 주제로는 진행할 수 없습니다. 다른 질문이나 탐구하고 싶은 주제가 있다면 메시지를 수정하거나 새 대화를 시작해 주세요."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"키를 찾을 수 없습니다. 키를 제공하고 다시 시도해주세요."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"기본 URL이 없습니다. URL을 제공한 후 다시 시도해 주세요."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"제공된 키가 유효하지 않습니다. 키를 제공하고 다시 시도해주세요."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"{0}에 대한 키가 {1}에 만료되었습니다. 새 키를 제공하고 다시 시도해주세요."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"월간 사용 한도에 도달했습니다. 도움을 받으려면 팀 관리자에게 문의하십시오."},com_files_no_results:{english:"No results.",translated:"결과가 없습니다."},com_files_filter:{english:"Search files by name",translated:"파일을 이름으로 검색"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0}개의 파일({1}개 중)이 선택되었습니다"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"어시스턴트 선택"},com_sidepanel_parameters:{english:"Parameters",translated:"매개변수"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"어시스턴트"},com_sidepanel_attach_files:{english:"File Manager",translated:"파일 첨부"},com_sidepanel_manage_files:{english:"Manage Files",translated:"파일 관리"},com_assistants_capabilities:{english:"Knowledgebase",translated:"기능"},com_assistants_knowledge:{english:"Knowledgebase",translated:"지식"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Knowledge에 파일을 업로드하면 어시스턴트와의 대화에서 파일 내용이 포함될 수 있습니다."},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"지식으로 파일을 업로드하기 전에 Assistant를 생성하고 Code Interpreter 또는 Retrieval을 활성화한 후 저장해야 합니다."},com_assistants_image_vision:{english:"Image Vision",translated:"이미지 인식"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"코드 인터프리터"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"코드 인터프리터는 코드를 실행하고 결과를 반환합니다."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"지원"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"팁"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"코드 인터프리터에서는 파일을 사용할 수 없습니다."},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"코드 인터프리터에서만 다음 파일을 사용할 수 있습니다:"},com_assistants_retrieval:{english:"Retrieval",translated:"검색"},com_assistants_search_name:{english:"Search assistants by name",translated:"이름으로 도우미 검색"},com_assistants_tools:{english:"Tools",translated:"도구"},com_assistants_actions:{english:"Actions",translated:"작업"},com_assistants_add_tools:{english:"Add Tools",translated:"도구 추가"},com_assistants_add_actions:{english:"Add Actions",translated:"작업 추가"},com_assistants_available_actions:{english:"Available Actions",translated:"사용 가능한 작업"},com_assistants_running_action:{english:"Running action",translated:"작업 진행 중"},com_assistants_completed_action:{english:"Talked to {0}",translated:"{0}과 대화했습니다"},com_assistants_completed_function:{english:"Ran {0}",translated:"{0}을(를) 실행했습니다"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"사용된 파일 검색"},com_assistants_function_use:{english:"Assistant used {0}",translated:"어시스턴트는 {0}을(를) 사용했습니다."},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:""}},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:""}},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"액션이 성공적으로 생성 또는 업데이트되었습니다"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"작업을 생성하거나 업데이트하는 중에 오류가 발생했습니다."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"작업 삭제 중 오류가 발생했습니다"},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"어시스턴트가 API를 통해 정보를 검색하거나 작업을 수행할 수 있게 해줍니다."},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"선택 사항: 어시스턴트의 이름"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"보조 지침은 보조가 사용하는 시스템 지침입니다."},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"옵션: 여기에 어시스턴트를 설명하세요"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"어시스턴트를 만들어야 작업을 추가할 수 있습니다."},com_assistants_update_success:{english:"Successfully updated",translated:"업데이트 성공"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"어시스턴트 업데이트 중 오류가 발생했습니다."},com_assistants_create_success:{english:"Successfully created",translated:"계정이 성공적으로 생성되었습니다"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"어시스턴트 생성 중 오류가 발생했습니다."},com_ui_field_required:{english:"This field is required",translated:"이 필드는 필수입니다"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"파일 다운로드 중 오류가 발생했습니다. 파일이 삭제되었을 수 있습니다."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"엔드포인트에서 지원하지 않는 파일 형식입니다."},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"엔드포인트에 대한 파일 크기 제한을 초과했습니다."},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"파일을 첨부할 수 없습니다. 대화를 생성하거나 선택하시거나 페이지를 새로고침해 보세요."},com_ui_on:{english:"On",translated:"켜기"},com_ui_off:{english:"Off",translated:"꺼짐"},com_ui_yes:{english:"Yes",translated:"네"},com_ui_no:{english:"No",translated:"아니요"},com_ui_ascending:{english:"Asc",translated:"오름차순"},com_ui_descending:{english:"Desc",translated:"내림차순"},com_ui_show_all:{english:"Show All",translated:"전체 보기"},com_ui_name:{english:"Name",translated:"이름"},com_ui_date:{english:"Date",translated:"날짜"},com_ui_storage:{english:"Storage",translated:"저장소"},com_ui_context:{english:"Context",translated:"맥락"},com_ui_size:{english:"Size",translated:"크기"},com_ui_host:{english:"Host",translated:"호스트"},com_ui_update:{english:"Update",translated:"업데이트"},com_ui_authentication:{english:"Authentication",translated:"인증"},com_ui_instructions:{english:"Instructions",translated:"설명"},com_ui_description:{english:"Description",translated:"설명"},com_ui_category:{english:"Category",translated:"---"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Assign a business category to help filter and organize assistants by function."},com_ui_error:{english:"Error",translated:"오류"},com_ui_select:{english:"Select",translated:"선택"},com_ui_select_search_model:{english:"Search model by name",translated:"이름으로 모델 검색"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"이름으로 플러그인 검색"},com_ui_stop:{english:"Stop",translated:"중지"},com_ui_upload_files:{english:"Upload files",translated:"파일 업로드"},com_ui_none_selected:{english:"None selected",translated:"선택된 항목 없음"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"파일 업로드 중 오류가 발생했습니다"},com_user_message:{english:"You",translated:"당신"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"엔드포인트, 어시스턴트 또는 프리셋을 언급하여 빠르게 전환하세요"},com_ui_nothing_found:{english:"Nothing found",translated:"찾을 수 없습니다"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"대화로 이동"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"가져올 수 없는 파일 형식입니다"},com_ui_avatar:{english:"Avatar",translated:"프로필 사진"},com_ui_unknown:{english:"Unknown",translated:"알 수 없음"},com_ui_result:{english:"Result",translated:"결과"},com_ui_image_gen:{english:"Image Gen",translated:"이미지 생성"},com_ui_assistant:{english:"Assistant",translated:"어시스턴트"},com_ui_assistants:{english:"Assistants",translated:"어시스턴트"},com_ui_attachment:{english:"Attachment",translated:"첨부 파일"},com_ui_assistants_output:{english:"Assistants Output",translated:"어시스턴트 출력"},com_ui_create:{english:"Create",translated:"만들기"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"이 Assistant를 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."},com_ui_preview:{english:"Preview",translated:"미리보기"},com_ui_upload:{english:"Upload",translated:"업로드"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'"{0}" 파일 업로드에 예상보다 시간이 더 걸리고 있습니다. 파일 인덱싱이 완료될 때까지 기다려 주세요.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"개인정보 보호정책"},com_ui_terms_of_service:{english:"Terms of service",translated:"이용 약관"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"최소 {0}개는 필수로 입력해야 합니다. 더 이상 값을 제거할 수 없습니다."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"최대 {0}개까지만 허용됩니다. 최신 값을 사용 중입니다."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"짧은 시간 동안 너무 많은 로그인 시도가 있었습니다. 잠시 후 다시 시도해 주세요."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"서비스 이용 규정을 위반하여 계정이 일시적으로 제한되었습니다."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"내부 서버 오류가 발생했습니다. 잠시 기다렸다가 다시 시도해 주세요."},com_endpoint_message:{english:"Message",translated:"메시지"},com_endpoint_messages:{english:"Messages",translated:"메시지"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"메시지를 수정하거나 다시 생성하세요."},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"최대 컨텍스트 토큰 수"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:"컨텍스트로 사용할 수 있는 최대 토큰 수입니다. 요청마다 보내는 토큰 수를 제어하는 데 사용할 수 있습니다. 지정하지 않으면 알려진 모델의 컨텍스트 크기를 기반으로 시스템 기본값을 사용합니다. 더 높은 값을 설정하면 오류가 발생하거나 토큰 비용이 더 높아질 수 있습니다."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"어시스턴트의 지침을 재정의합니다. 이를 통해 실행마다 동작을 수정할 수 있습니다."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"추가 지시사항 또는 컨텍스트를 Assistant의 기본 지시사항에 추가합니다. 비어 있으면 무시됩니다."},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"추가 지시사항"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"에이전트 지침 재정의"},com_endpoint_stop:{english:"Stop Sequences",translated:"중지 시퀀스"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Enter 키를 눌러 값을 구분하세요"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"선택적 `max_tokens` 필드로, 채팅 완성에서 생성할 수 있는 최대 토큰 수를 나타냅니다. 입력 토큰과 생성된 토큰의 총 길이는 모델의 컨텍스트 길이로 제한됩니다. 이 숫자가 최대 컨텍스트 토큰 수를 초과하면 오류가 발생할 수 있습니다."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"이전에 첨부한 모든 파일을 다시 보내세요. 참고: 이렇게 하면 토큰 비용이 증가하고 많은 첨부 파일로 인해 오류가 발생할 수 있습니다."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'비전 요청의 해상도입니다. "낮음"은 저렴하고 빠르며, "높음"은 더 상세하지만 비용이 많이 듭니다. "자동"은 이미지 해상도에 따라 두 가지 중 하나를 자동으로 선택합니다.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"API가 추가 토큰 생성을 중지할 최대 4개의 시퀀스입니다."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"파일 재전송"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"이미지 상세 정보"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"이 프리셋을 삭제하시겠습니까?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"프리셋 가져왔습니다!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"프리셋을 가져오는 중에 오류가 발생했습니다. 다시 시도해주세요."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"프리셋을 저장하는 중에 오류가 발생했습니다. 다시 시도해 주세요."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"프리셋을 삭제하는 중에 오류가 발생했습니다. 다시 시도해 주세요."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"더 이상 기본 프리셋이 아닙니다"},com_endpoint_preset_default_item:{english:"Default:",translated:"기본값:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"기본 프리셋이 설정되지 않았습니다."},com_endpoint_preset_title:{english:"Preset",translated:"프리셋"},com_endpoint_preset_saved:{english:"Saved!",translated:"저장되었습니다!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"이제 기본 프리셋입니다."},com_endpoint_preset_selected_title:{english:"Active!",translated:"활성화됨"},com_endpoint_assistant:{english:"Assistant",translated:"어시스턴트"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"활성 에이전트 사용"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"오른쪽 사이드 패널에서 에이전트를 선택하세요"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"헤더 메뉴에서 키를 설정하여 채팅하세요."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"어시스턴트 선택하기"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"오늘 무엇을 도와드릴까요?"},com_nav_profile_picture:{english:"Profile Picture",translated:"프로필 사진"},com_nav_change_picture:{english:"Change picture",translated:"프로필 사진 변경"},com_show_agent_settings:{english:"Show Agent Settings",translated:"에이전트 설정 표시"},com_show_completion_settings:{english:"Show Completion Settings",translated:"완료 설정 표시"},com_hide_examples:{english:"Hide Examples",translated:"예시 숨기기"},com_show_examples:{english:"Show Examples",translated:"예시 보기"},com_nav_my_files:{english:"File Manager",translated:"내 파일"},com_nav_admin_center:{english:"Admin Center",translated:"관리 센터"},com_nav_user_name_display:{english:"Display username in messages",translated:"메시지에서 사용자 이름 표시"},com_nav_language:{english:"Language",translated:"언어"},com_nav_lang_auto:{english:"Auto detect",translated:"자동 감지"},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"라이선스의 최대 토큰 수에 도달했습니다. 추가 지원이 필요하면 {0}으로 영업팀에 문의하세요."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"할당된 토큰의 {0}%를 사용했습니다. 추가 지원이 필요하면 {1}으로 문의하세요."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"라이선스를 사용할 수 없습니다. 추가 지원이 필요하면 지원팀에 문의하세요."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"IPv6 주소는 지원되지 않습니다. IPv4 연결을 사용하거나 지원팀에 문의하세요."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"요청 처리 중 오류가 발생했습니다. 다시 시도하세요."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"파일 {0}이(가) 이미 성공적으로 업로드되었습니다."},com_ui_create_assistant:{english:"Create Assistant",translated:"어시스턴트 생성"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"어시스턴트를 생성하려면 사용자에게 생성 권한이 필요합니다."},com_assistants_shared_with_consent_title:{english:"Consent",translated:"동의"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"이 어시스턴트를 다른 팀원과 공유하려고 합니다. 공유하기 전에 아래의 주요 사항을 검토하세요:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"계속 진행함으로써 이 조건을 이해하고 수락함을 확인합니다."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"공유된 어시스턴트에는 민감하거나 기밀인 데이터가 포함되어서는 안 됩니다."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"공유된 어시스턴트는 민감하거나 기밀인 데이터를 처리해서는 안 됩니다."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"공유는 콘텐츠 및 접근에 대한 책임을 의미합니다."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"모두와 공유하기보다는 특정 팀이나 폐쇄된 그룹과 공유하는 것이 좋습니다."},com_button_accept:{english:"Accept",translated:"수락"},com_button_decline:{english:"Decline",translated:"거절"},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"벡터 저장소에서 파일을 가져오는 중 문제가 발생했습니다."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} / {1} 파일 업로드됨"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"개인 어시스턴트만 삭제할 수 있습니다."},com_assistants_loading:{english:"Loading assistants...",translated:"어시스턴트 로딩 중..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"PII 활성화 이유를 제공하세요."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"설정 및 개인정보"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"PII 수정"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"이 어시스턴트의 모델 호출에 대해 기본적으로 PII 수정이 활성화되어 있습니다."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"PII 허용 시 이 어시스턴트의 모델 호출에 대한 수정이 비활성화됩니다. 귀하의 조직 데이터 정책을 준수할 책임이 있습니다. 활동은 완전히 기록되고 모니터링됩니다."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"PII를 활성화하는 이유를 설명하세요 (필수)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"최소 길이는 {0}자입니다."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"최대 길이는 {0}자입니다."},com_ui_kbot_assistants:{english:"Knowledge",translated:"지식"},com_ui_assistant_default_category:{english:"General",translated:"일반"},com_ui_assistant_featured:{english:"Featured",translated:"추천"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"검색 기준에 맞는 어시스턴트가 없습니다."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"어시스턴트를 찾을 수 없습니다."},com_ui_category_placeholder:{english:"Search a category",translated:"카테고리 검색"},com_ui_tool_placeholder:{english:"Search a tool",translated:"도구 검색"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"서버 연결 오류, 페이지를 새로고침하세요."},com_ui_select_placeholder:{english:"Select options",translated:"옵션 선택"},com_ui_remove:{english:"Remove",translated:"제거"},com_ui_thinking:{english:"Thinking",translated:"생각 중"},com_ui_analyzing_request:{english:"Understanding your question",translated:"요청 분석 중"},com_ui_processing:{english:"Putting it together",translated:"처리 중"},com_ui_working_on_it:{english:"Almost ready",translated:"작업 중"},com_ui_read_aloud:{english:"Read aloud",translated:"소리 내어 읽기"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"중복 파일이 감지되었습니다."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"파일 업로드 중 오류가 발생했습니다."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"파일 업로드 중 오류 발생: 엔드포인트가 정의되지 않았습니다"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"빈 파일은 허용되지 않습니다."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"한 번에 최대 {0}개의 파일만 업로드할 수 있습니다."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"이 섹션에서는 최대 {0}개의 파일만 업로드할 수 있습니다."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"{0}의 업로드 한도에 도달했습니다"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"파일 유형을 확인할 수 없습니다: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"지원되지 않는 파일 형식입니다. 지원되는 파일 형식을 업로드하세요."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"이미지 로드 실패"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"현재 JPEG, JPG, PNG, WEBP 파일만 지원됩니다."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"파일 크기가 {0} MB를 초과합니다."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"파일의 총 크기가 {0} MB를 초과할 수 없습니다."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"파일 검증 중 오류가 발생했습니다."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"파일 처리 중 오류가 발생했습니다."},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"스튜디오 지원"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"지식"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"미분류"},com_ui_use_micrphone:{english:"Use microphone",translated:"마이크 사용"},com_endpoint_export_share:{english:"Export/Share",translated:"내보내기/공유"},com_nav_text_to_speech:{english:"Text to Speech",translated:"텍스트 음성 변환"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"최신 메시지 자동 재생"},com_nav_speech_to_text:{english:"Speech to Text",translated:"음성 텍스트 변환"},com_nav_user_guide:{english:"User Guide",translated:"사용자 가이드"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"자동 텍스트 전송 (3초 후)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"오디오 재생 오류: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"오디오 처리 오류: {0}"},com_nav_engine:{english:"Engine",translated:"엔진"},com_nav_browser:{english:"Browser",translated:"브라우저"},com_nav_external:{english:"External",translated:"외부"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"캐시 저장소 삭제"},com_nav_voice_select:{english:"Voice",translated:"음성"},com_nav_setting_speech:{english:"Speech",translated:"음성 설정"},com_page_not_found:{english:"Page not found",translated:"페이지를 찾을 수 없습니다"},com_something_went_wrong_error:{english:"Something went wrong",translated:"문제가 발생했습니다"},com_unauthorized_access:{english:"Unauthorized access",translated:"권한 없는 접근"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"권한 없는 접근. 특정 도메인에만 접근이 허용됩니다."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"서비스 위반으로 계정이 일시적으로 정지되었습니다"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"네트워크 외부에서 앱 접근이 제한됩니다!"},com_support_ticket_text:{english:"Support Ticket",translated:"지원 티켓"},com_help_dialog_Header:{english:"Need assistance?",translated:"도움이 필요하신가요?"},com_help_dialog_text_1_1:{english:"Click",translated:"자세한 지침은"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"를 클릭하세요"},com_help_dialog_text_here:{english:"here",translated:"여기"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"문제가 있으면"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"문제가 있으면 연락하세요"},com_help_dialog_text_ticket:{english:"ticket",translated:"티켓 작성"},com_help_dialog_text_3:{english:"Find the steps",translated:"단계를 찾으세요"},com_status_ind_none:{english:"Operational",translated:"운영 중"},com_status_ind_minor:{english:"Minor Issues",translated:"경미한 문제"},com_status_ind_major:{english:"Major Issues",translated:"주요 문제"},com_status_ind_critical:{english:"Critical",translated:"심각"},com_status_ind_error:{english:"Error Fetching",translated:"오류 발생"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"채팅을 나가거나 새 채팅을 시작하면 대화 기록이 사라집니다."},com_forbidden_access:{english:"Forbidden access",translated:"접근 금지"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"허용 사용 정책"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"개인정보 보호정책"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"구독 계약"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"iX Hello를 사용하기 전에 Concentrix의 "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"가입 및/또는 입장함으로써 위의 약관에 동의합니다."},com_login_page_and:{english:"and ",translated:"및 "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"고정된 어시스턴트 없음"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"고정된 어시스턴트"},com_ui_loading:{english:"Loading...",translated:"로딩 중..."},com_ui_unpin:{english:"Unpin",translated:"고정 해제"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"어시스턴트 고정 해제 성공"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"어시스턴트 고정 해제 오류"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"어시스턴트 고정 성공"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"어시스턴트 고정/해제 오류"},com_ui_pin:{english:"Pin",translated:"고정"},come_create_assistant:{english:"Create Assistant",translated:"어시스턴트 생성"},come_edit_assistant:{english:"Edit Assistant",translated:"어시스턴트 편집"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"계속하시겠습니까? 현재 편집 중인 어시스턴트의 변경 사항이 손실됩니다. 이 작업은 되돌릴 수 없습니다."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"ID {0}의 어시스턴트를 찾을 수 없습니다."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"브라우저가 음성 인식을 지원하지 않습니다"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"마이크 권한이 부여되지 않았습니다"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"녹음 시작 오류: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder가 녹음 중이 아닙니다"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"이 브라우저에서는 MediaRecorder가 지원되지 않습니다"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"메시지에 개인 정보가 포함되어 전송할 수 없습니다. 개인 정보를 제거해 주세요."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"대화 이름 변경 실패"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"할당된 토큰 중 {0}개가 남아 있습니다."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello는 실수를 할 수 있습니다. 모든 출력을 품질과 정확성을 위해 검토하세요. 모든 입력은 준수를 위해 기록됩니다."},com_ui_assistant_group_by:{english:"Group by",translated:"그룹화 기준"},com_ui_assistant_category:{english:"Category",translated:"카테고리"},com_ui_assistant_team:{english:"Team",translated:"팀"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"엔지니어링"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"인텔리전스"},com_ui_assistant_marketing:{english:"Marketing",translated:"마케팅"},com_ui_assistant_operations:{english:"Operations",translated:"운영"},com_ui_assistant_sales:{english:"Sales",translated:"영업"},com_ui_assistant_strategy:{english:"Strategy",translated:"전략"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"스튜디오 지원"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"아바타 이미지를 업로드하세요 (PNG 또는 JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"온라인 검색"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"웹사이트 탐색"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"이미지 생성"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"수학 계산"},com_ui_assistant_tools_default:{english:"Running tool",translated:"기본 도구"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"파일 업로드가 예상보다 오래 걸리고 있습니다. 다시 시도해주세요."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"어시스턴트 고정 오류"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"공유 링크 삭제 중 오류가 발생했습니다"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"DAN 템플릿"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"활성화된 기본 프리셋이 없습니다."},com_ui_drag_drop_title:{english:"Add anything",translated:"무엇이든 추가하기"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"대화에 추가하려면 여기에 파일을 드롭하세요"},com_ui_analyzing:{english:"Analyzing",translated:"분석 중"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"분석 완료"},com_ui_warning:{english:"Warning",translated:"경고"},com_ui_proceed:{english:"Proceed",translated:"진행"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"어시스턴트에 업로드된 파일은 대화 목적으로만 사용됩니다. 사용자는 관련 질문을 통해 파일 내용을 접근할 수 있지만, 파일의 직접 다운로드는 허용되지 않습니다."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"이 프리셋의 사용자 정의 이름 설정"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"예제 입력 설정. 비어 있으면 예제가 무시됩니다."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"예제 출력 설정. 비어 있으면 예제가 무시됩니다."},com_nav_export_select_type:{english:"Select a file type",translated:"파일 형식 선택"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"스크린샷 (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"텍스트 (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"마크다운 (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"응답이 없습니다. 메시지를 다시 보내보세요. 페이지를 새로고침한 후에도 문제가 계속되면 지원팀에 문의하세요."},com_ui_back_to_chat:{english:"Back to Chat",translated:"채팅으로 돌아가기"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"가드레일 중재"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"이 어시스턴트에 대해 가드레일 중재가 활성화되었습니다. 콘텐츠는 중재 정책에 따라 검토됩니다."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"가드레일 중재를 비활성화하면 이 어시스턴트에 대한 콘텐츠 중재 검토가 제거됩니다. 귀하는 조직의 콘텐츠 정책을 준수할 책임이 있습니다. 활동은 완전히 기록되고 모니터링됩니다."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"가드레일 중재를 비활성화하는 비즈니스 이유를 설명하세요(필수)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"가드레일 중재 비활성화에 대한 이유를 제공하세요."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"사용자가 채팅에서 모델 변경 허용"},com_ui_feedback_good:{english:"Good response",translated:"좋은 응답"},com_ui_feedback_bad:{english:"Poor response",translated:"나쁜 응답"},com_ui_feedback_comments:{english:"Comments",translated:"댓글"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"댓글 (선택사항)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"경험에 대해 더 알려주세요..."},com_ui_feedback_submit:{english:"Submit",translated:"제출"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"피드백을 보낼 수 없었습니다"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"부정확"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"관련 없음"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"오래된 정보"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"세부 정보 부족"},com_ui_feedback_reason_other:{english:"Other",translated:"기타"},com_ui_model_recommended:{english:"Recommended",translated:"추천"},com_ui_model_legacy:{english:"Legacy — please update",translated:"구형 — 업데이트 필요"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"이 모델은 더 이상 지원되지 않습니다. 현재 모델을 선택하세요."},com_nav_setting_memory:{english:"Memory",translated:"메모리"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"어시스턴트가 대화 중 기억하는 개인 정보를 관리합니다."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"새 메모리 추가…"},com_nav_memory_add_button:{english:"Add memory",translated:"메모리 추가"},com_nav_memory_category:{english:"Category",translated:"카테고리"},com_nav_memory_category_preference:{english:"Preference",translated:"선호"},com_nav_memory_category_identity:{english:"Identity",translated:"정체성"},com_nav_memory_category_context:{english:"Context",translated:"맥락"},com_nav_memory_category_project:{english:"Project",translated:"프로젝트"},com_nav_memory_empty_title:{english:"No memories yet",translated:"아직 메모리가 없습니다"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"저장한 메모리가 여기에 나타나며, 향후 대화를 개인화하는 데 도움이 됩니다."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"메모리를 불러올 수 없습니다. 다시 시도하세요."},com_nav_memory_retry:{english:"Retry",translated:"다시 시도"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"메모리를 추가할 수 없습니다. 다시 시도하세요."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"메모리를 업데이트할 수 없습니다. 다시 시도하세요."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"메모리를 삭제할 수 없습니다. 다시 시도하세요."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"이 메모리를 삭제하시겠습니까?"},com_nav_memory_delete_button:{english:"Delete",translated:"삭제"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"메모리 편집"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"메모리 삭제"},com_nav_memory_save:{english:"Save",translated:"저장"},com_nav_memory_cancel:{english:"Cancel",translated:"취소"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"{0}에 저장됨"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — 최신 GPT-5 사고 모델, 첨단 인공지능."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — 컴팩트하고 비용 효율적인 GPT-5.4 변형."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — 최신 GPT-5 세대 모델."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"최신 Opus — 코딩 에이전트 및 기업 워크플로우를 위한 최첨단 지능."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"최신 Opus — 코딩 에이전트 및 기업 워크플로우를 위한 최첨단 지능."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"향상된 추론 및 지시 따르기가 강화된 Sonnet."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"복잡하고 다단계 작업을 위한 Anthropic의 가장 강력한 모델."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"다양한 작업을 위한 균형 잡힌 지능과 속도."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"가장 빠르고 컴팩트한 Claude 모델 — 고처리량 작업에 이상적."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — 향상된 추론 및 멀티모달 기능."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"OpenAI의 주력 차세대 모델."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"경량 GPT-5 — 일상 작업에 효율적이고 빠름."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — 개선된 지시 따르기 및 추론."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"컴팩트한 GPT-4.1 — 더 빠르고 간단한 작업에 저렴함."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"가장 능력 있는 GPT-4 모델, 속도와 비용 최적화."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"경량 GPT-4o — 더 빠르고 간단한 작업에 저렴함."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (미리보기) — 1M 컨텍스트를 갖춘 가장 강력한 Gemini 모델."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (미리보기) — 1M 컨텍스트로 빠르고 효율적."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — 1M 컨텍스트를 갖춘 경량 저지연 모델."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"내부 음성 최적화 보조 모델."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto는 용량과 성능을 기반으로 요청에 가장 적합한 모델을 선택합니다."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"곧 출시"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"자동 라우팅 기본 설정"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"각 턴에 모델을 선택할 때 Auto 라우터가 균형을 맞추는 방식을 조정합니다. 가중치는 정규화되므로 상대적인 균형이 중요합니다."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"비용"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"토큰 비용이 더 낮은 저렴한 모델을 우선합니다."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"정확도"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"복잡한 추론에 더 강한 모델을 우선합니다."},com_assistants_auto_weight_speed:{english:"Speed",translated:"속도"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"더 빠르고 지연 시간이 낮은 모델을 우선합니다."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"기본값으로 재설정"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"파일 업로드 시간이 초과되었습니다. 몇 분 후 다시 시도해 주세요."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"문제가 발생했습니다. 확인된 구체적인 오류 메시지는 다음과 같습니다: 요청을 처리하는 중 오류가 발생했습니다. 이 어시스턴트는 더 이상 사용할 수 없습니다. 관리자에게 문의하세요."},com_ui_code:{english:"Code",translated:"코드"},com_ui_assistant_share:{english:"Share",translated:"공유"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"링크가 복사되었습니다"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"이 어시스턴트에 대한 액세스 권한이 없습니다"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"링크를 클립보드에 복사하지 못했습니다"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"미리보기를 사용할 수 없습니다 - 콘텐츠 생성이 완료되지 않았습니다."},com_ui_view_code:{english:"View code",translated:"코드 보기"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"미리보기를 사용할 수 없습니다 — 콘텐츠가 유효하지 않습니다."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"전화번호"},com_assistants_pii_entity_email:{english:"Email Address",translated:"이메일 주소"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"신용카드"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"사회보장번호"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"업로드가 예상보다 오래 걸리고 있습니다 - 다시 시도 중 ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"연결 문제 - 다시 시도 중 ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"업로드에 실패했습니다 - 연결 상태를 확인한 후 다시 시도해 주세요"},com_assistants_memory_enabled:{english:"Memory",translated:"메모리"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"이 어시스턴트에 메모리가 활성화되어 있습니다. 어시스턴트는 대화 전반에 걸쳐 사실을 저장하고 기억할 수 있습니다."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"이 어시스턴트에 메모리가 비활성화되어 있습니다. 대화 전반에 걸쳐 어떤 사실도 저장되거나 기억되지 않습니다."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"메모리를 비활성화하는 비즈니스 사유를 설명해 주세요(필수)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"메모리를 비활성화하는 사유를 입력해 주세요."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"팀에 메모리가 비활성화되어 있습니다. 기존 메모리는 보고 삭제할 수 있지만, 새 메모리를 추가하거나 수정할 수는 없습니다."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"코드를 실행 중입니다"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"지식 베이스를 검색 중입니다"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"음성을 처리 중입니다"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"메모리에 저장 중입니다"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"메모리에서 제거 중입니다"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"웹 검색을 완료했습니다"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"웹페이지 검토를 완료했습니다"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"이미지를 생성했습니다"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"계산을 완료했습니다"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"코드 실행을 완료했습니다"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"지식 베이스 검색을 완료했습니다"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"음성 입력 처리를 완료했습니다"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"메모리에 저장했습니다"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"메모리에서 제거했습니다"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"완료됨: {0}"},com_ui_still_working:{english:"still working...",translated:"계속 작업 중..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} 준비 완료"},com_ui_file_ready_fallback:{english:"File is ready",translated:"파일 준비 완료"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"{0}을(를) 처리할 수 없습니다"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"파일을 처리할 수 없습니다"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"{0}을(를) 처리할 수 없습니다. 파일을 다시 업로드하세요."},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"파일을 처리할 수 없습니다. 파일을 다시 업로드하세요."},com_ui_file_processing:{english:"Processing...",translated:"처리 중..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"처리 실패"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"실패 - 다시 업로드 필요"},com_ui_file_retry:{english:"Retry",translated:"다시 시도"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"{0}초 후 다시 시도"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"파일 인덱싱 다시 시도 중..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"다시 시도하기 전에 {0}초 기다려 주세요"},com_ui_file_retries_exhausted_reupload:{english:"Maximum retries reached. Please re-upload the file.",translated:"최대 재시도 횟수에 도달했습니다. 파일을 다시 업로드해 주세요."},com_ui_assistant_file_upload_invalid_json:{english:"Invalid JSON file. File content does not match the expected format.",translated:"잘못된 JSON 파일입니다. 파일 내용이 예상 형식과 일치하지 않습니다."}},xk=Object.freeze(Object.defineProperty({__proto__:null,comparisons:wk,default:bk},Symbol.toStringTag,{value:"Module"})),Pk={com_error_moderation:"आपल्या सामग्रीला आमच्या समुदाय मार्गदर्शक तत्त्वांशी जुळत नसल्यामुळे आमच्या मॉडरेशन प्रणालीने चिन्हांकित केले आहे. आम्ही या विशिष्ट विषयावर पुढे जाऊ शकत नाही. आपल्याला इतर कोणतेही प्रश्न किंवा विषय असल्यास, कृपया आपला संदेश संपादित करा किंवा नवीन संभाषण तयार करा.",com_error_no_user_key:"कोणतीही की सापडली नाही. कृपया की द्या आणि पुन्हा प्रयत्न करा.",com_error_no_base_url:"कोणताही बेस URL सापडला नाही. कृपया एक द्या आणि पुन्हा प्रयत्न करा.",com_error_invalid_user_key:"अवैध की प्रदान केली आहे. कृपया की द्या आणि पुन्हा प्रयत्न करा.",com_error_expired_user_key:"{0} साठी प्रदान केलेली की {1} ला कालबाह्य झाली आहे. कृपया की द्या आणि पुन्हा प्रयत्न करा.",com_error_token_balance_exceeded:"आपण आपल्या मासिक वापर मर्यादेपर्यंत पोहोचला आहात. कृपया मदतीसाठी टीम प्रशासकाशी संपर्क साधा.",com_error_token_balance_exceeded_license:"आपण आपल्या परवान्याचे जास्तीत जास्त टोकन वापरले आहेत. कृपया पुढील मदतीसाठी {0} वर विक्रीशी संपर्क साधा.",com_error_token_balance_percent_used:"आपण {0}% टोकन वापरले आहेत. कृपया पुढील मदतीसाठी {1} शी संपर्क साधा.",com_error_license_expired:"आपला परवाना उपलब्ध नाही. कृपया पुढील मदतीसाठी समर्थनाशी संपर्क साधा.",com_restricted_invalid_ip_format:"IPv6 पत्ते समर्थित नाहीत. कृपया IPv4 कनेक्शन वापरा किंवा पुढील मदतीसाठी समर्थनाशी संपर्क साधा.",com_error_tool_run:"आपल्या विनंतीवर प्रक्रिया करताना एक त्रुटी आली. कृपया पुन्हा प्रयत्न करा.",com_files_upload_duplicate_success:"फाइल {0} यशस्वीरित्या आधीच अपलोड केली गेली आहे",com_files_no_results:"कोणतेही परिणाम नाहीत.",com_files_filter:"फाइल नावाने शोधा",com_files_number_selected:"{0} पैकी {1} फाइल(स) निवडल्या",com_sidepanel_select_assistant:"सहायक निवडा",com_sidepanel_parameters:"पॅरामीटर्स",com_ui_create_assistant:"सहायक तयार करा",com_ui_create_assistant_permission_needed:"सहायक तयार करण्यासाठी वापरकर्त्याला परवानगी आवश्यक आहे",com_sidepanel_assistant_builder:"सहायक",com_sidepanel_attach_files:"फाइल व्यवस्थापक",com_sidepanel_manage_files:"फाइल व्यवस्थापित करा",com_assistants_shared_with_consent_title:"संमती",com_assistants_shared_with_consent_description_1:"आपण हा सहायक इतर टीम सदस्यांसह सामायिक करण्यास तयार आहात. हा सहायक सामायिक करण्यापूर्वी, कृपया खालील मुख्य मुद्दे पुनरावलोकन करा:",com_assistants_shared_with_consent_description_2:"पुढे जाण्याने, आपण या अटी समजून घेतल्या आहेत आणि स्वीकारल्या आहेत हे आपण पुष्टी करता.",com_assistants_shared_with_consent_bullet_1:"सामायिक सहाय्यक संवेदनशील किंवा गोपनीय डेटा समाविष्ट करू नये.",com_assistants_shared_with_consent_bullet_2:"सामायिक सहाय्यकांनी संवेदनशील किंवा गोपनीय डेटा प्रक्रिया करू नये.",com_assistants_shared_with_consent_bullet_3:"सामायिकरणामुळे सामग्री आणि प्रवेशासाठी जबाबदारी येते.",com_assistants_shared_with_consent_bullet_4:"सर्वांसोबत सामायिक करण्याऐवजी विशिष्ट टीम किंवा बंद गटासोबत सामायिक करणे शिफारसीय आहे.",com_button_accept:"स्वीकारा",com_button_decline:"नकारा",com_assistants_capabilities:"ज्ञानकोश",com_assistants_file_search:"फाइल शोध",com_assistants_file_search_description:"चॅटमध्ये प्रश्नांना उत्तर देताना सहाय्यकाला शोधण्यासाठी आवश्यक फाइल्स येथे जोडा.",com_assistants_file_search_supported_label:"समर्थित:",com_assistants_file_search_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",com_assistants_file_search_tips_label:"सूचना:",com_assistants_file_search_tips:"प्रत्येक वेळी वापरकर्त्यांना उत्तर देताना 'फाइल शोध साधन' वापरण्यासाठी आपल्या सहाय्यकाला विचारा.",com_assistants_file_search_info:"फाइल शोधासाठी वेक्टर स्टोअर्स जोडणे अद्याप समर्थित नाही. तुम्ही ते प्रोव्हायडर प्लेग्राउंडमधून जोडू शकता किंवा थ्रेड आधारावर फाइल शोधासाठी संदेशांना फाइल्स जोडू शकता.",com_assistants_file_search_fetch_error:"वेक्टर स्टोअर्समधून फाइल्स आणताना काहीतरी चुकले.",com_assistants_knowledge:"ज्ञानकोश",com_assistants_knowledge_info:"तुमच्या सहाय्यकाला फाइल्स अपलोड करा, जेणेकरून ते प्रश्नांना उत्तर देण्यासाठी त्यांचा वापर करू शकेल (उदा. CXNGPT वापरकर्ता मार्गदर्शक)",com_assistants_knowledge_disabled:"तुमचा सहाय्यक जतन करण्यासाठी तयार करा क्लिक करा, नंतर तुमच्या फाइल्स अपलोड करा आणि जतन करा क्लिक करा.",com_assistants_image_vision:"प्रतिमा दृष्टिकोन",com_assistants_code_interpreter:"कोड इंटरप्रिटर",com_assistants_code_interpreter_description:"प्रत्येक चॅटसाठी डेटा विश्लेषण किंवा परिवर्तन करण्यासाठी आवश्यक फाइल्स येथे जोडा.",com_assistants_code_interpreter_supported_label:"समर्थित:",com_assistants_code_interpreter_supported:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",com_assistants_code_interpreter_tips_label:"सूचना:",com_assistants_code_interpreter_tips:"प्रत्येक वेळी वापरकर्त्यांना उत्तर देताना 