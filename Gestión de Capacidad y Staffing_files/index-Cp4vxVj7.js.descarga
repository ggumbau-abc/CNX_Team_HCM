gorized",translated:"未分類"},com_ui_use_micrphone:{english:"Use microphone",translated:"使用麥克風"},com_endpoint_export_share:{english:"Export/Share",translated:"匯出/分享"},com_nav_text_to_speech:{english:"Text to Speech",translated:"文字轉語音"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"自動播放最新訊息"},com_nav_speech_to_text:{english:"Speech to Text",translated:"語音轉文字"},com_nav_user_guide:{english:"User Guide",translated:"使用指南"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"自動發送文字（3 秒後）"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"播放音訊錯誤：{0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"處理音訊錯誤：{0}"},com_nav_engine:{english:"Engine",translated:"引擎"},com_nav_browser:{english:"Browser",translated:"瀏覽器"},com_nav_external:{english:"External",translated:"外部"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"刪除快取儲存"},com_nav_voice_select:{english:"Voice",translated:"語音"},com_nav_setting_speech:{english:"Speech",translated:"語音設置"},com_page_not_found:{english:"Page not found",translated:"找不到頁面"},com_something_went_wrong_error:{english:"Something went wrong",translated:"發生錯誤"},com_unauthorized_access:{english:"Unauthorized access",translated:"未授權的訪問"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"未授權的訪問。訪問僅限於特定域。"},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"由於違反服務條款，您的帳戶已被暫時禁止"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"您被限制在網絡外訪問應用程序！"},com_support_ticket_text:{english:"Support Ticket",translated:"支援票"},com_help_dialog_Header:{english:"Need assistance?",translated:"需要幫助？"},com_help_dialog_text_1_1:{english:"Click",translated:"點擊"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"查看詳細說明"},com_help_dialog_text_here: