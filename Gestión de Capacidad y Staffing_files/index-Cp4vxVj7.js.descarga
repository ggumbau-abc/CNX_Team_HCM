ts_output:"Awọn abajade Iranlọwọ",com_ui_delete:"Paarẹ",com_ui_create:"Ṣẹda",com_ui_share:"Pín",com_ui_copy_link:"Da ọna asopọ",com_ui_update_link:"Ṣe imudojuiwọn ọna asopọ",com_ui_create_link:"Ṣẹda ọna asopọ",com_ui_share_link_to_chat:"Pín ọna asopọ si iwiregbe",com_ui_share_error:"Aṣiṣe kan wa ninu pinpin ọna asopọ iwiregbe",com_ui_share_create_message:"Orukọ rẹ ati awọn ifiranṣẹ ti o fi kun lẹhin pinpin wa ni ikọkọ.",com_ui_share_created_message:"Ọna asopọ gbangba si iwiregbe rẹ ti ṣẹda. Ṣakoso awọn iwiregbe ti a ti pin tẹlẹ nigbakugba nipasẹ Eto.",com_ui_share_update_message:"Orukọ rẹ, awọn ilana aṣa, ati awọn ifiranṣẹ ti o fi kun lẹhin pinpin wa ni ikọkọ.",com_ui_share_updated_message:"Ọna asopọ gbangba si iwiregbe rẹ ti ṣe imudojuiwọn. Ṣakoso awọn iwiregbe ti a ti pin tẹlẹ nigbakugba nipasẹ Eto.",com_ui_shared_link_not_found:"Ọna asopọ ti a pin ko ri",com_ui_delete_conversation:"Paarẹ iwiregbe?",com_ui_delete_conversation_confirm:"Eyi yoo paarẹ",com_ui_delete_assistant_confirm:"Ṣe o da ọ loju pe o fẹ paarẹ Iranlọwọ yii? Eyi ko le yipada.",com_ui_rename:"Tun orukọ",com_ui_more_options:"Diẹ sii",com_ui_preview:"Atunyẹwo",com_ui_upload:"Po si",com_ui_upload_delay:'Fifi "{0}" ranṣẹ n gba akoko diẹ sii ju ti a ti reti lọ. Jọwọ duro de nigba ti faili naa ba pari ifiweranṣẹ fun gbigba.',com_ui_privacy_policy:"Ilana ìpamọ",com_ui_terms_of_service:"Àwọn ìlànà ìṣẹ́ṣẹ",com_ui_use_micrphone:"Lo foonu agbọrọsọ",com_ui_min_tags:"Kò le yọ àwọn iye míràn, o kere ju {0} ni a nilo.",com_ui_max_tags:"Ìyàtọ̀ tó pọ̀ jùlọ ni {0}, lo àwọn iye tuntun.",com_auth_error_login:"Kò le wọlé pẹ̀lú ìwífún tí a pèsè. Jọ̀wọ́ ṣàyẹ̀wò àwọn ìdánimọ̀ rẹ àti gbìyànjú lẹ́ẹ̀kansi.",com_auth_error_login_rl:"O ti kọjá iye ìgbà wọlé tí a gba. Jọ̀wọ́ gbìyànjú lẹ́ẹ̀kansi ní ìṣẹ́jú 15.",com_auth_error_login_ban:"Àkọọlẹ rẹ ti dáwọ́ dúró títí àkókò kan nítorí ìkànsí àwọn ìlànà wa.",com_auth_error_login_server:"Àsìṣe ẹ̀rọ ìṣẹ́lẹ̀ kan wà. Jọ̀wọ́ dúró díẹ̀ káàkiri àti gbìyànjú lẹ́ẹ̀kansi.",com_auth_sign_in:"Wọlé",com_endpoint_system_message:"Ìfiranṣẹ́ Ẹ̀rọ",com_endpoint_message:"Ìfiranṣẹ́",com_endpoint_messages:"Àwọn Ìfiranṣẹ́",com_endpoint_message_not_appendable:"Ṣatunkọ ìfiranṣẹ́ rẹ tàbí Ṣẹ̀dá tuntun.",com_endpoint_default_blank:"aiyipada: òfo",com_endpoint_default_false:"aiyipada: irọ́",com_endpoint_default_creative:"aiyipada: ẹ̀dá",com_endpoint_default_empty:"aiyipada: òfo",com_endpoint_default_with_num:"aiyipada: {0}",com_endpoint_context:"Àkóónú",com_endpoint_tone_style:"Àṣà Ìró",com_endpoint_token_count:"Ìkànsí Àkọsílẹ̀",com_endpoint_output:"Ẹ̀bùn",com_endpoint_context_tokens:"Ìkànsí Àkóónú Tó pọ̀ jùlọ",com_endpoint_context_info:`Ìkànsí tó pọ̀ jùlọ tí a lè lò fún àkóónú. Lo èyí fún ìṣàkóso iye ìkànsí tí a rán ní ìbéèrè kọọkan.
  Bí a kò bá ṣàlàyé, yóò lo aiyipada ẹ̀rọ ní ìbámu pẹ̀lú ìwọn àkóónú àwọn àwòrán tó mọ̀. Ṣíṣe ìṣètò iye tó gíga lè fa àṣìṣe àti/tàbí iye ìkànsí tó pọ̀ jù.`,com_endpoint_prompt_prefix_placeholder:"Ṣètò àwọn ìlànà tàbí àkóónú àdani. A kò ní fojú pa bí ó bá ṣofo.",com_endpoint_instructions_assistants_placeholder:"Yi awọn ilana oluranlọwọ pada. Eyi wulo fun iyipada ihuwasi lori ipilẹ kọọkan.",com_endpoint_prompt_prefix_assistants_placeholder:"Ṣeto awọn ilana afikun tabi konteksti lori awọn ilana akọkọ ti Oluranlọwọ. A foju ti o ba ṣofo.",com_endpoint_custom_name:"Orukọ Aṣa",com_endpoint_prompt_prefix:"Awọn Ilana Aṣa",com_endpoint_prompt_prefix_assistants:"Awọn Ilana Afikun",com_endpoint_instructions_assistants:"Yi Awọn Ilana Pada",com_endpoint_temperature:"Iwọn otutu",com_endpoint_default:"aiyipada",com_endpoint_top_p:"Top P",com_endpoint_top_k:"Top K",com_endpoint_max_output_tokens:"Awọn Token Ijade Max",com_endpoint_stop:"Duro Awọn Sequences",com_endpoint_stop_placeholder:"Ya awọn iye nipa titẹ `Enter`",com_endpoint_openai_max_tokens:"Aṣayan `max_tokens`, ti o nsoju nọmba to pọ julọ ti awọn token ti o le ṣe ni ipari ibaraẹnisọrọ.\n\nGbogbo gigun ti awọn token titẹ sii ati awọn token ti a ṣe ni opin nipasẹ gigun konteksti awoṣe. O le ni iriri awọn aṣiṣe ti nọmba yii ba kọja awọn token konteksti max.",com_endpoint_openai_temp:"Awọn iye ti o ga = diẹ sii laileto, nigba ti awọn iye kekere = diẹ sii idojukọ ati deterministic. A ṣeduro iyipada eyi tabi Top P ṣugbọn kii ṣe mejeeji.",com_endpoint_openai_max:"Awọn token max lati ṣe. Gbogbo gigun ti awọn token titẹ sii ati awọn token ti a ṣe ni opin nipasẹ gigun konteksti awoṣe.",com_endpoint_openai_topp:"Ọna miiran si ayẹwo pẹlu iwọn otutu, ti a pe ni ayẹwo nucleus, nibiti awoṣe ṣe akiyesi awọn abajade ti awọn token pẹlu ibi-iṣowo iṣeeṣe top_p. Nitorinaa 0.1 tumọ si pe awọn token ti o ni 10% iṣeeṣe ti o ga julọ ni a ka. A ṣeduro iyipada eyi tabi iwọn otutu ṣugbọn kii ṣe mejeeji.",com_endpoint_openai_freq:"Nọmba laarin 0 ati 2.0. Awọn iye rere ṣe ijiya awọn token tuntun da lori igbohunsafẹfẹ wọn ti o wa tẹlẹ ninu ọrọ naa, dinku iṣeeṣe awoṣe lati tun ila kanna ṣe.",com_endpoint_openai_pres:"Nọmba laarin 0 ati 2.0. Awọn iye rere ṣe ijiya awọn token tuntun da lori boya wọn han ninu ọrọ naa, mu iṣeeṣe awoṣe lati sọrọ nipa awọn akọle tuntun.",com_endpoint_openai_resend_files:"Tun gbogbo awọn faili ti a ti fi sii tẹlẹ ranṣẹ. Akọsilẹ: eyi yoo mu iye owo token pọ si ati pe o le ni iriri awọn aṣiṣe pẹlu ọpọlọpọ awọn asomọ.",com_endpoint_openai_detail:'Ipinnu fun awọn ibeere Iran. "Kekere" jẹ din owo ati yara, "Ga" jẹ alaye diẹ sii ati gbowolori, ati "Auto" yoo yan laifọwọyi laarin meji da lori ipinnu aworan.',com_endpoint_openai_stop:"Soke si awọn jara 4 nibiti API yoo da ṣiṣe awọn token siwaju.",com_endpoint_openai_custom_name_placeholder:"Ṣeto orukọ aṣa fun iXHello",com_endpoint_openai_prompt_prefix_placeholder:"Ṣeto awọn ilana aṣa lati ṣafikun ni Ifiranṣẹ Eto. Aiyipada: ko si",com_endpoint_frequency_penalty:"Ijiya Igbohunsafẹfẹ",com_endpoint_presence_penalty:"Ìjìya Ìwàláàyè",com_endpoint_plug_use_functions:"Lo Àwọn Ìṣe",com_endpoint_plug_resend_files:"Tun Fíránṣẹ́ Fáìlì",com_endpoint_plug_image_detail:"Àlàyé Àwòrán",com_endpoint_plug_skip_completion:"Fagilé Ìparí",com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:"Ṣètò àṣẹ àdani láti fi sí Ifiranṣẹ Eto. Àyànfẹ́: kò sí",com_endpoint_import:"Gbé wọlé",com_endpoint_set_custom_name:"Ṣètò orúkọ àdani, nígbàtí o bá lè rí ààyè yìí",com_endpoint_preset_delete_confirm:"Ṣé o dájú pé o fẹ́ pa ààyè yìí rẹ?",com_endpoint_preset_import:"Ààyè Ti wọlé!",com_endpoint_preset_import_error:"Àsìṣe kan wà nígbàtí o ń gbé ààyè rẹ wọlé. Jọwọ tún gbìyànjú.",com_endpoint_preset_save_error:"Àsìṣe kan wà nígbàtí o ń fipamọ̀ ààyè rẹ. Jọwọ tún gbìyànjú.",com_endpoint_preset_delete_error:"Àsìṣe kan wà nígbàtí o ń pa ààyè rẹ. Jọwọ tún gbìyànjú.",com_endpoint_preset_default_removed:"kì í ṣe ààyè àyànfẹ́ mọ́.",com_endpoint_preset_default_item:"Àyànfẹ́:",com_endpoint