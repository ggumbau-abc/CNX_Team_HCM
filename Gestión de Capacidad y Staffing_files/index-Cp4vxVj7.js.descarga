lish:"Need assistance?",translated:"Trenger du hjelp?"},com_help_dialog_text_1_1:{english:"Click",translated:"Klikk"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"for detaljerte instruksjoner"},com_help_dialog_text_here:{english:"here",translated:"her"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"For problemer, fyll ut en"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"For problemer, kontakt"},com_help_dialog_text_ticket:{english:"ticket",translated:"ticket"},com_help_dialog_text_3:{english:"Find the steps",translated:"Finn trinnene"},com_status_ind_none:{english:"Operational",translated:"Operativ"},com_status_ind_minor:{english:"Minor Issues",translated:"Mindre problemer"},com_status_ind_major:{english:"Major Issues",translated:"Større problemer"},com_status_ind_critical:{english:"Critical",translated:"Kritisk"},com_status_ind_error:{english:"Error Fetching",translated:"Feil ved henting"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Vær oppmerksom på at når du forlater en chat eller starter en ny chat, vil du miste samtalehistorikken."},com_forbidden_access:{english:"Forbidden access",translated:"Forbudt tilgang"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Akseptabel brukspolicy"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Personvernpolicy"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Abonnementsavtale"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Før du bruker iX Hello, kan du gjennomgå Concentrix's "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Ved å registrere deg og/eller logge inn, godtar du de ovennevnte vilkårene."},com_login_page_and:{english:"and ",translated:"og "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Ingen festede assistenter"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Festede assistenter"},com_ui_loading:{english:"Loading...",translated:"Laster..."},com_ui_unpin:{english:"Unpin",translated:"Løsne"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Assistent løsnet vellykket"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Feil ved frigjøring av assistent"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Assistent festet"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Feil ved festing/frigjøring av assistent"},com_ui_pin:{english:"Pin",translated:"Fest"},come_create_assistant:{english:"Create Assistant",translated:"Opprett assistent"},come_edit_assistant:{english:"Edit Assistant",translated:"Rediger assistent"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Er du sikker på at du vil fortsette? Dette vil føre til tap av endringer gjort på assistenten du redigerer eller oppretter. Denne handlingen kan ikke angres."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Assistent med id {0} ble ikke funnet."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Nettleseren støtter ikke SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Mikrofontillatelse ikke gitt"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Feil ved start av opptak: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder tar ikke opp"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder støttes ikke i denne nettleseren"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Meldingen din inneholder personlig informasjon og kunne ikke sendes. Vennligst fjern personlig informasjon."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Kunne ikke gi samtalen nytt navn"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Du har {0} av dine tildelte tokens igjen."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello kan gjøre feil. Vennligst gjennomgå alle resultater for kvalitet og nøyaktighet. Alle inndata logges for overholdelse."},com_ui_assistant_group_by:{english:"Group by",translated:"Grupper etter"},com_ui_assistant_category:{english:"Category",translated:"Kategori"},com_ui_assistant_team:{english:"Team",translated:"Team"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Ingeniørfag"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Intelligens"},com_ui_assistant_marketing:{english:"Marketing",translated:"Markedsføring"},com_ui_assistant_operations:{english:"Operations",translated:"Operasjoner"},com_ui_assistant_sales:{english:"Sales",translated:"Salg"},com_ui_assistant_strategy:{english:"Strategy",translated:"Strategi"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Studioassistenter"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Last opp et avatarbilde (PNG eller JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Søk på nett"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Bla gjennom nettsted"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Generer bilder"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Beregn matematikk"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Standardverktøy"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Filopplastingen tar lengre tid enn forventet. Prøv igjen."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Feil ved festing av assistent"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Det oppstod en feil ved sletting av den delte lenken"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"DAN-mal"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Ingen standard forhåndsinnstilling aktiv."},com_ui_drag_drop_title:{english:"Add anything",translated:"Legg til noe"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Slipp en fil her for å legge den til i samtalen"},com_ui_analyzing:{english:"Analyzing",translated:"Analyserer"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Ferdig analysert"},com_ui_warning:{english:"Warning",translated:"Advarsel"},com_ui_proceed:{english:"Proceed",translated:"Fortsett"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Filer lastet opp til assistenten brukes kun til samtaleformål. Brukere kan få tilgang til innholdet i disse filene ved å stille relevante spørsmål, men direkte nedlasting av filene er ikke tillatt."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Angi et egendefinert navn for denne forhåndsinnstillingen"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Angi eksempelinnputt. Eksempel ignoreres hvis tomt."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Angi eksempelets output. Eksempel ignoreres hvis tomt."},com_nav_export_select_type:{english:"Select a file type",translated:"Velg en filtype"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"skjermbilde (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"tekst (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Ingen respons ble mottatt. Vennligst prøv å sende meldingen din igjen. Hvis problemet vedvarer etter å ha lastet inn siden på nytt og prøvd igjen, vennligst kontakt support."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Tilbake til Chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Sikkerhetsmoderering"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Sikkerhetsmoderering er aktivert for denne assistenten. Innhold vil bli sjekket mot modereringsregler."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Deaktivering av sikkerhetsmoderering fjerner innholdskontroller for denne assistenten. Du er ansvarlig for å overholde organisasjonens innholdspolicyer. Aktivitet logges og overvåkes fullt ut."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Vennligst forklar din forretningsbegrunnelse for å deaktivere sikkerhetsmoderering (påkrevd)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Vennligst oppgi en begrunnelse for å deaktivere sikkerhetsmoderering."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Tillat brukere å bytte modell i chat"},com_ui_feedback_good:{english:"Good response",translated:"Godt svar"},com_ui_feedback_bad:{english:"Poor response",translated:"Dårlig svar"},com_ui_feedback_comments:{english:"Comments",translated:"Kommentarer"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Kommentarer (valgfritt)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Fortell oss mer om din opplevelse..."},com_ui_feedback_submit:{english:"Submit",translated:"Send inn"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Vi kunne ikke sende tilbakemeldingen din"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Feil"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Ikke relevant"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Utdatert"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Ikke nok detaljer"},com_ui_feedback_reason_other:{english:"Other",translated:"Annet"},com_ui_model_recommended:{english:"Recommended",translated:"Anbefalt"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Legacy — vennligst oppdater"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Denne modellen støttes ikke lenger. Vennligst velg en gjeldende modell."},com_nav_setting_memory:{english:"Memory",translated:"Minne"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Administrer de personlige fakta assistenten husker fra samtalene dine."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Legg til et nytt minne…"},com_nav_memory_add_button:{english:"Add memory",translated:"Legg til minne"},com_nav_memory_category:{english:"Category",translated:"Kategori"},com_nav_memory_category_preference:{english:"Preference",translated:"Preferanse"},com_nav_memory_category_identity:{english:"Identity",translated:"Identitet"},com_nav_memory_category_context:{english:"Context",translated:"Kontekst"},com_nav_memory_category_project:{english:"Project",translated:"Prosjekt"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Ingen minner ennå"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Minner du lagrer vil vises her og bidra til å tilpasse fremtidige samtaler."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Kunne ikke laste minner. Vennligst prøv igjen."},com_nav_memory_retry:{english:"Retry",translated:"Prøv igjen"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Kunne ikke legge til minne. Vennligst prøv igjen."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Kunne ikke oppdatere minne. Vennligst prøv igjen."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Kunne ikke slette minne. Vennligst prøv igjen."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Slette dette minnet?"},com_nav_memory_delete_button:{english:"Delete",translated:"Slett"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Rediger minne"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Slett minne"},com_nav_memory_save:{english:"Save",translated:"Lagre"},com_nav_memory_cancel:{english:"Cancel",translated:"Avbryt"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Lagret {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — siste GPT-5-tenkemodell med avansert intelligens."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — kompakt og kostnadseffektiv GPT-5.4 variant."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — siste GPT-5 generasjonsmodell."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Siste Opus — banebrytende intelligens for kodeagenter og bedriftsarbeidsflyter."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Siste Opus — banebrytende intelligens for kodeagenter og bedriftsarbeidsflyter."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Forbedret Sonnet med bedre resonnering og instruksjonsfølge."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Anthropics kraftigste modell for komplekse, flertrinns oppgaver."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Balansert intelligens og hastighet for et bredt spekter av oppgaver."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Raskeste og mest kompakte Claude-modell — ideell for høy gjennomstrømning."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — forbedret resonnering og multimodale evner."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"OpenAIs flaggskip neste generasjons modell."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"Lettvekts GPT-5 — effektiv og rask for daglige oppgaver."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — forbedret instruksjonsfølge og resonnering."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"Kompakt GPT-4.1 — raskere og billigere for enklere oppgaver."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Mest kapable GPT-4 modell, optimalisert for hastighet og kostnad."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"Lettvekts GPT-4o — raskere og billigere for enklere oppgaver."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Forhåndsvisning) — mest kapable Gemini-modell med 1M kontekst."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Forhåndsvisning) — rask og effektiv med 1M kontekst."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — lett modell med lav forsinkelse og 1M kontekst."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Intern stemmeoptimalisert assistentmodell."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto velger den beste modellen for din forespørsel basert på kapasitet og ytelse."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Kommer snart"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Preferanser for automatisk ruting"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Juster hvordan Auto-ruteren balanserer avveininger når den velger en modell for hver tur. Vektene normaliseres — det er den relative balansen som betyr noe."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Kostnad"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Prioriter rimeligere modeller med lavere tokenkostnad."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Nøyaktighet"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Prioriter sterkere modeller for kompleks resonnering."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Hastighet"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Prioriter raskere modeller med lavere ventetid."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Tilbakestill til standard"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Opplasting av fil tok for lang tid. Prøv igjen om noen minutter."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Noe gikk galt. Her er den spesifikke feilmeldingen vi fikk: Det oppstod en feil under behandlingen av forespørselen din. Assistenten er ikke lenger tilgjengelig. Kontakt administratoren."},com_ui_code:{english:"Code",translated:"Kode"},com_ui_assistant_share:{english:"Share",translated:"Del"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Lenke kopiert"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Du har ikke tilgang til denne a