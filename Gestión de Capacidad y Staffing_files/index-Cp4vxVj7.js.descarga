v)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Nessuna risposta ricevuta. Riprova a inviare il tuo messaggio. Se il problema persiste dopo aver ricaricato la pagina e riprovato, contatta il supporto."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Torna alla chat"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Moderazione Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"La moderazione guardrail è abilitata per questo assistente. Il contenuto sarà verificato rispetto alle politiche di moderazione."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Disabilitare la moderazione guardrail rimuove i controlli di moderazione del contenuto per questo assistente. Sei responsabile del rispetto delle politiche di contenuto della tua organizzazione. L'attività è completamente registrata e monitorata."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Si prega di spiegare la giustificazione aziendale per disabilitare la moderazione guardrail (obbligatorio)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Si prega di fornire una giustificazione per disabilitare la moderazione guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Consenti agli utenti di cambiare modello in chat"},com_ui_feedback_good:{english:"Good response",translated:"Buona risposta"},com_ui_feedback_bad:{english:"Poor response",translated:"Risposta scarsa"},com_ui_feedback_comments:{english:"Comments",translated:"Commenti"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Commenti (opzionale)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Dicci di più sulla tua esperienza..."},com_ui_feedback_submit:{english:"Submit",translated:"Invia"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Non siamo riusciti a inviare il tuo feedback"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Errato"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Non pertinente"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Obsoleto"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Dettagli insufficienti"},com_ui_feedback_reason_other:{english:"Other",translated:"Altro"},com_ui_model_recommended:{english:"Recommended",translated:"Consigliato"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Obsoleto — si prega di aggiornare"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Questo modello non è più supportato. Seleziona un modello attuale."},com_nav_setting_memory:{english:"Memory",translated:"Memoria"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Gestisci i fatti personali che l'assistente ricorda nelle tue conversazioni."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Aggiungi una nuova memoria…"},com_nav_memory_add_button:{english:"Add memory",translated:"Aggiungi memoria"},com_nav_memory_category:{english:"Category",translated:"Categoria"},com_nav_memory_category_preference:{english:"Preference",translated:"Preferenza"},com_nav_memory_category_identity:{english:"Identity",translated:"Identità"},com_nav_memory_category_context:{english:"Context",translated:"Contesto"},com_nav_memory_category_project:{english:"Project",translated:"Progetto"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Nessuna memoria ancora"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Le memorie salvate appariranno qui e aiuteranno a personalizzare le conversazioni future."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Impossibile caricare le memorie. Riprova."},com_nav_memory_retry:{english:"Retry",translated:"Riprova"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Impossibile aggiungere la memoria. Riprova."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Impossibile aggiornare la memoria. Riprova."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Impossibile eliminare la memoria. Riprova."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Eliminare questa memoria?"},com_nav_memory_delete_button:{english:"Delete",translated:"Elimina"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Modifica memoria"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Elimina memoria"},com_nav_memory_save:{english:"Save",translated:"Salva"},com_nav_memory_cancel:{english:"Cancel",translated:"Annulla"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Salvato {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — ultimo modello di ragionamento GPT-5 con intelligenza avanzata."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — variante compatta ed economica di GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — modello di ultima generazione GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Ultimo Opus — intelligenza di frontiera per agenti di codifica e flussi di lavoro aziendali."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Ultimo Opus — intelligenza di frontiera per agenti di codifica e flussi di lavoro aziendali."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet migliorato con ragionamento e seguimento istruzioni avanzati."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Modello più potente di Anthropic per compiti complessi e multi-step."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Intelligenza e velocità bilanciate per una vasta gamma di compiti."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Modello Claude più veloce e compatto — ideale per compiti ad alto rendimento."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — capacità di ragionamento e multimodali migliorate."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Modello di punta di nuova generazione di OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 leggero — efficiente e veloce per compiti quotidiani."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — migliorato nel seguimento istruzioni e ragionamento."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 compatto — più veloce ed economico per compiti semplici."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Modello GPT-4 più capace, ottimizzato per velocità e costo."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o leggero — più veloce ed economico per compiti semplici."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Anteprima) — modello Gemini più capace con contesto 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Anteprima) — rapido ed efficiente con contesto 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — modello leggero a bassa latenza con contesto 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Modello assistente ottimizzato per la voce interno."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto seleziona il modello migliore per la tua richiesta in base alla capacità e alle prestazioni."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Prossimamente"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Preferenze di instradamento automatico"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Regola come il router Auto bilancia i compromessi nella selezione di un modello per ogni turno. I pesi sono normalizzati: conta l'equilibrio relativo."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Costo"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Preferisci modelli più economici con un costo per token inferiore."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Accuratezza"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Preferisci modelli più potenti per ragionamenti complessi."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Velocità"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Preferisci modelli più rapidi, con latenza inferiore."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Ripristina predefiniti"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Timeout durante il caricamento del file. Riprova tra qualche minuto."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Qualcosa è andato storto. Ecco il messaggio di errore specifico che abbiamo riscontrato: Si è verificato un errore durante l'elaborazione della richiesta. L'assistente non è più disponibile. Contatta l'amministratore."},com_ui_code:{english:"Code",translated:"Codice"},com_ui_assistant_share:{english:"Share",translated:"Condividi"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Link copiato"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Non hai accesso a questo assistente"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Impossibile copiare il link negli appunti"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Anteprima non disponibile — generazione del contenuto non completata."},com_ui_view_code:{english:"View code",translated:"Visualizza codice"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Anteprima non disponibile — contenuto non valido."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Numero di telefono"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Indirizzo email"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Carta di credito"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"SSN"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Il caricamento sta richiedendo più tempo del previsto - nuovo tentativo ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Problema di connessione - nuovo tentativo ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Caricamento non riuscito - controlla la connessione e riprova"},com_assistants_memory_enabled:{english:"Memory",translated:"Memoria"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"La memoria è abilitata per questo assistente. L'assistente può memorizzare e richiamare fatti tra una conversazione e l'altra."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"La memoria è disabilitata per questo assistente. Nessun fatto verrà memorizzato o richiamato tra una conversazione e l'altra."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Spiega la motivazione aziendale per disabilitare la memoria (obbligatorio)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Fornisci una motivazione per disabilitare la memoria."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"La memoria è disabilitata per il tuo team. Puoi visualizzare ed elim