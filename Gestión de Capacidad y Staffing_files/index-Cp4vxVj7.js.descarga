ń ṣiṣẹ...",com_assistants_pii_entity_phone:"Nọmba Foonu",com_assistants_pii_entity_email:"Adirẹsi Imeeli",com_assistants_pii_entity_credit_card:"Kaadi Kirẹditi",com_assistants_pii_entity_ssn:"Nọmba Idanimọ Awujọ",com_assistants_memory_enabled:"Ìrántí",com_assistants_memory_enabled_info:"Ìrántí ti ṣiṣẹ fún olùrànlọ́wọ́ yìí. Olùrànlọ́wọ́ lè fi àwọn òtítọ́ pamọ́ kí ó sì rántí wọn kọjá àwọn ìbánisọ̀rọ̀.",com_assistants_memory_disabled_info:"Ìrántí ti wa ni pipa fún olùrànlọ́wọ́ yìí. Kò sí òtítọ́ kankan tí a ó fi pamọ́ tàbí rántí kọjá àwọn ìbánisọ̀rọ̀.",com_assistants_memory_enabled_off_reason_placeholder:"Jọ̀wọ́ ṣàlàyé ìdí iṣẹ́ rẹ fún pípa ìrántí (dandan).",com_assistants_memory_enabled_reason_required:"Jọ̀wọ́ pèsè ìdí fún pípa ìrántí.",com_nav_memory_team_disabled:"Ìrántí ti wa ni pipa fún ẹgbẹ́ rẹ. O lè wo kí o sì pa àwọn ìrántí tó wà tẹ́lẹ̀ rẹ́, ṣùgbọ́n o kò lè fi tuntun kún un tàbí ṣàtúnṣe wọn.",com_ui_file_ready:"{0} ti ṣetan",com_ui_file_ready_fallback:"Faili ti ṣetan",com_ui_file_processing_failed:"A kò lè ṣiṣẹ́ {0}",com_ui_file_processing_failed_fallback:"A kò lè ṣiṣẹ́ faili",com_ui_file_processing_failed_reupload:"A kò lè ṣiṣẹ́ {0}. Jọ̀wọ́ tún faili náà po sí.",com_ui_file_processing_failed_reupload_fallback:"A kò lè ṣiṣẹ́ faili. Jọ̀wọ́ tún faili náà po sí.",com_ui_file_processing:"N ṣiṣẹ...",com_ui_file_processing_failed_status:"Sisẹ kuna",com_ui_file_processing_failed_reupload_required:"Kuna - o nilo lati tun gbe sórí",com_ui_file_retry:"Tun gbìyànjú",com_ui_file_retry_in:"Tun gbìyànjú ní {0}s",com_ui_file_indexing_retrying:"N tun gbìyànjú ìtọ́kasí fáìlì...",com_ui_file_retry_wait:"Jọwọ dúró {0}s kí o tó tún gbìyànjú",com_ui_file_retries_exhausted_reupload:"A ti dé iye ìgbìyànjú tó pọ̀jù. Jọwọ tún gbe fáìlì náà sórí.",com_ui_assistant_file_upload_invalid_json:"Faili JSON ti ko tọ. Akoonu faili ko ba ọna ti a reti mu."},jb={com_error_moderation:{english:"It appears that the content submitted has been flagged by our moderation system for not aligning with our community guidelines. We're unable to proceed with this specific topic. If you have any other questions or topics you'd like to explore, please edit your message, or create a new conversation.",translated:"O dabi pe eto iṣakoso wa ti samisi akoonu ti a fi silẹ fun ko ni ibamu pẹlu awọn ilana agbegbe wa. A ko le tẹsiwaju pẹlu koko-ọrọ pataki yii. Ti o ba ni awọn ibeere miiran tabi awọn akọle ti o fẹ lati ṣawari, jọwọ ṣatunkọ ifiranṣẹ rẹ, tabi ṣẹda ibaraẹnisọrọ tuntun."},com_error_no_user_key:{english:"No key found. Please provide a key and try again.",translated:"Ko si bọtini ti a ri. Jọwọ pese bọtini ki o tun gbiyanju."},com_error_no_base_url:{english:"No base URL found. Please provide one and try again.",translated:"Ko si URL ipilẹ ti a ri. Jọwọ pese ọkan ki o tun gbiyanju."},com_error_invalid_user_key:{english:"Invalid key provided. Please provide a key and try again.",translated:"Bọtini ti a pese ko wulo. Jọwọ pese bọtini ki o tun gbiyanju."},com_error_expired_user_key:{english:"Provided key for {0} expired at {1}. Please provide a key and try again.",translated:"Bọtini ti a pese fun {0} pari ni {1}. Jọwọ pese bọtini ki o tun gbiyanju."},com_error_token_balance_exceeded:{english:"You've reached your monthly usage limit. Please contact the team admin for assistance.",translated:"O ti de opin lilo oṣooṣu rẹ. Jọwọ kan si alakoso ẹgbẹ fun iranlọwọ."},com_error_token_balance_exceeded_license:{english:"You've reached the maximum tokens for your license. Please contact sales at {0} for further assistance.",translated:"O ti de awọn token ti o pọju fun iwe-aṣẹ rẹ. Jọwọ kan si tita ni {0} fun iranlọwọ siwaju."},com_error_token_balance_percent_used:{english:"You have used {0}% of your allotted tokens. Please contact {1} for further assistance.",translated:"O ti lo {0}% ti awọn token ti a fun ọ. Jọwọ kan si {1} fun iranlọwọ siwaju."},com_error_license_expired:{english:"Your License is not available. Please contact support for further assistance.",translated:"Iwe-aṣẹ rẹ ko si. Jọwọ kan si atilẹyin fun iranlọwọ siwaju."},com_restricted_invalid_ip_format:{english:"IPv6 addresses are not supported. Please use an IPv4 connection or contact support for further assistance.",translated:"A ko ṣe atilẹyin awọn adirẹsi IPv6. Jọwọ lo asopọ IPv4 tabi kan si atilẹyin fun iranlọwọ siwaju."},com_error_tool_run:{english:"An error occurred while processing your request. Please try again.",translated:"Aṣiṣe kan waye nigba ṣiṣe ibeere rẹ. Jọwọ tun gbiyanju."},com_files_upload_duplicate_success:{english:"File {0} was already uploaded successfully",translated:"Faili {0} ti tẹlẹ ti wa ni ikojọpọ ni aṣeyọri"},com_files_no_results:{english:"No results.",translated:"Ko si esi."},com_files_filter:{english:"Search files by name",translated:"Ṣawari awọn faili nipasẹ orukọ"},com_files_number_selected:{english:"{0} of {1} file(s) selected",translated:"{0} ninu {1} faili ti a yan"},com_sidepanel_select_assistant:{english:"Select an Assistant",translated:"Yan Iranlọwọ"},com_sidepanel_parameters:{english:"Parameters",translated:"Awọn paramita"},com_ui_create_assistant:{english:"Create Assistant",translated:"Ṣẹda Iranlọwọ"},com_ui_create_assistant_permission_needed:{english:"User needs create permissions to create an Assistant",translated:"Olumulo nilo awọn igbanilaaye lati ṣẹda Iranlọwọ"},com_sidepanel_assistant_builder:{english:"Assistants",translated:"Awọn Iranlọwọ"},com_sidepanel_attach_files:{english:"File Manager",translated:"Oludari Faili"},com_sidepanel_manage_files:{english:"Manage Files",translated:"Ṣakoso Awọn faili"},com_assistants_shared_with_consent_title:{english:"Consent",translated:"Ifọwọsi"},com_assistants_shared_with_consent_description_1:{english:"You are about to share this assistant with other team members. Before sharing this assistant, please review the key points below:",translated:"O n fẹrẹ pin iranlọwọ yii pẹlu awọn ọmọ ẹgbẹ ẹgbẹ miiran. Ṣaaju ki o to pin iranlọwọ yii, jọwọ ṣe atunyẹwo awọn aaye pataki ni isalẹ:"},com_assistants_shared_with_consent_description_2:{english:"By proceeding, you confirm that you understand and accept these terms.",translated:"Nipa tẹsiwaju, o jẹrisi pe o loye ati gba awọn ofin wọnyi."},com_assistants_shared_with_consent_bullet_1:{english:"Shared assistant should not contain sensitive or confidential data.",translated:"Oluranlọwọ ti a pin ko gbọdọ ni data ti o ni ifura tabi aṣiri."},com_assistants_shared_with_consent_bullet_2:{english:"Shared assistants must not process sensitive or confidential data.",translated:"Oluranlọwọ ti a pin ko gbọdọ ṣe ilana data ti o ni ifura tabi aṣiri."},com_assistants_shared_with_consent_bullet_3:{english:"Sharing implies accountability and responsibility for the content and access.",translated:"Pipin tumọ si ojuse ati ojuse fun akoonu ati iraye si."},com_assistants_shared_with_consent_bullet_4:{english:" It is recommended to share with a specific team or closed group instead of everyone.",translated:"A ṣe iṣeduro lati pin pẹlu ẹgbẹ kan pato tabi ẹgbẹ pipade dipo gbogbo eniyan."},com_button_accept:{english:"Accept",translated:"Gba"},com_button_decline:{english:"Decline",translated:"Kọ"},com_assistants_capabilities:{english:"Knowledgebase",translated:"Ibi Imọ"},com_assistants_file_search:{english:"File Search",translated:"Wiwa Faili"},com_assistants_file_search_description:{english:"Add files you need your assistant to search from when responding to questions in chat.",translated:"Fi awọn faili kun nibi ti o nilo oluranlọwọ rẹ lati wa lati dahun awọn ibeere ninu iwiregbe."},com_assistants_file_search_supported_label:{english:"Supported:",translated:"Ti ṣe atilẹyin:"},com_assistants_file_search_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts."},com_assistants_file_search_tips_label:{english:"Tip:",translated:"Imọran:"},com_assistants_file_search_tips:{english:"Ask your assistant to use the 'File Search Tool' every time it responds to users.",translated:"Beere lọwọ oluranlọwọ rẹ lati lo 'Ọpa Wiwa Faili' ni gbogbo igba ti o ba dahun awọn olumulo."},com_assistants_file_search_info:{english:"Attaching vector stores for File Search is not yet supported. You can attach them from the Provider Playground or attach files to messages for file search on a thread basis.",translated:"Fifi awọn ile itaja vector fun Wiwa Faili ko ti ṣe atilẹyin sibẹsibẹ. O le so wọn pọ lati Ile-iṣẹ Olupese tabi so awọn faili pọ si awọn ifiranṣẹ fun wiwa faili lori ipilẹ akọle."},com_assistants_file_search_fetch_error:{english:"Something went wrong when fetching files from the vector stores.",translated:"Ohunkan lọ buru nigbati o n gba awọn faili lati awọn ile itaja vector."},com_assistants_knowledge:{english:"Knowledgebase",translated:"Ibi Imọ"},com_assistants_knowledge_info:{english:"Upload files to your assistant, so it can use them to answer questions (i.e. CXNGPT User Guide)",translated:"Po si awọn faili si oluranlọwọ rẹ, ki o le lo wọn lati dahun awọn ibeere (i.e. Itọsọna Olumulo CXNGPT)"},com_assistants_knowledge_disabled:{english:"Click Create to save your Assistant, then upload your files, and click Save.",translated:"Tẹ Ṣẹda lati fipamọ Oluranlọwọ rẹ, lẹhinna po si awọn faili rẹ, ki o tẹ Fipamọ."},com_assistants_image_vision:{english:"Image Vision",translated:"Iran Aworan"},com_assistants_code_interpreter:{english:"Code Interpreter",translated:"Onitumọ Koodu"},com_assistants_code_interpreter_description:{english:"Add files you need your assistant to use to analyze or transform data for every chat.",translated:"Fi awọn faili kun nibi ti o nilo oluranlọwọ rẹ lati lo lati ṣe itupalẹ tabi yi data pada fun gbogbo iwiregbe."},com_assistants_code_interpreter_supported_label:{english:"Supported:",translated:"Ti ṣe atilẹyin:"},com_assistants_code_interpreter_supported:{english:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip.",translated:"c, cpp, docx, html, java, json, md, pdf, php, pptx, py, rb, tex, txt, css, js, ts, csv, jpeg, jpg, gif, png, tar, xlsx, xml, zip."},com_assistants_code_interpreter_tips_label:{english:"Tips:",translated:"Awọn imọran:"},com_assistants_code_interpreter_tips:{english:"Ask your assistant to use the 'Code Interpreter Tool' every time it responds to users.",translated:"Beere lọwọ oluranlọwọ rẹ lati lo 'Ọpa Onitumọ Koodu' ni gbogbo igba ti o ba dahun awọn olumulo."},com_assistants_code_interpreter_files_counter:{english:"{0} of {1} files uploaded",translated:"{0} ninu {1} awọn faili ti gbe wọle"},com_assistants_code_interpreter_files:{english:"The following files are only available for Code Interpreter:",translated:"Awọn faili wọnyi wa fun Onitumọ Koodu nikan:"},com_assistants_retrieval:{english:"Retrieval",translated:"Gbigba"},com_assistants_search_name:{english:"Search assistants by name",translated:"Wa awọn iranṣẹ nipasẹ orukọ"},com_assistants_tools:{english:"Tools",translated:"Awọn irinṣẹ"},com_assistants_actions:{english:"Actions",translated:"Awọn iṣe"},com_assistants_add_tools:{english:"Add Tools",translated:"Fi Awọn irinṣẹ kun"},com_assistants_add_actions:{english:"Add Actions",translated:"Fi Awọn iṣe kun"},com_assistants_non_retrieval_model:{english:"File search is not enabled on this model. Please select another model.",translated:"Àwárí fáìlì kò ṣiṣẹ lori àwòrán yìí. Jọwọ yan awoṣe miiran."},com_assistants_available_actions:{english:"Available Actions",translated:"Awọn iṣe Ti o Wa"},com_assistants_running_action:{english:"Running action",translated:"Nṣiṣẹ iṣe"},com_assistants_completed_action:{english:"Talked to {0}",translated:"Sọrọ si {0}"},com_assistants_completed_function:{english:"Ran {0}",translated:"Ṣiṣẹ {0}"},com_assistants_completed_with_file_search:{english:"Used File Search",translated:"Lo Àwárí Fáìlì"},com_assistants_function_use:{english:"Assistant used {0}",translated:"Iranṣẹ lo {0}"},com_assistants_function_browsewbsite_error_100:{english:"[error processing tool] Failed to fetch the contents of the given website. [100]",translated:"[aṣiṣe sisẹ irinṣẹ] Ko le gba akoonu oju opo wẹẹbu ti a fun. [100]"},com_assistants_function_browsewbsite_error_101:{english:"[error processing tool] Failed to fetch the contents of the given website. [101]",translated:"[aṣiṣe sisẹ irinṣẹ] Ko le gba akoonu oju opo wẹẹbu ti a fun. [101]"},com_assistants_domain_info:{english:"Assistant sent this info to {0}",translated:"Iranṣẹ ranṣẹ si alaye yii si {0}"},com_assistants_delete_permission_title:{english:"Deleting only allowed with private Assistants",translated:"Paarẹ nikan ni a gba laaye pẹlu Awọn Iranṣẹ aladani"},com_assistants_delete_actions_success:{english:"Successfully deleted Action from Assistant",translated:"Aṣeyọri paarẹ Iṣe lati Iranṣẹ"},com_assistants_update_actions_success:{english:"Successfully created or updated Action",translated:"Aṣeyọri ṣẹda tabi ṣe imudojuiwọn Iṣe"},com_assistants_update_actions_error:{english:"There was an error creating or updating the action.",translated:"Aṣiṣe kan wa ninu ṣiṣẹda tabi imudojuiwọn iṣe naa."},com_assistants_delete_actions_error:{english:"There was an error deleting the action.",translated:"Aṣiṣe kan wa ninu piparẹ iṣe naa."},com_assistants_actions_info:{english:"Let your Assistant retrieve information or take actions via API's",translated:"Jẹ ki Iranṣẹ rẹ gba alaye tabi ṣe awọn iṣe nipasẹ API's"},com_assistants_name_placeholder:{english:"Name your assistant (i.e. Email Generator)",translated:"Fun orukọ si iranṣẹ rẹ (i.e. Ẹda Imeeli)"},com_assistants_instructions_placeholder:{english:"Provide your assistant with specific, detailed, comprehensive guidelines to direct its behavior (i.e. Goal, Role, Actions, Audience, Style, Rules, Task, Template, Example)",translated:"Pese awọn ilana pato, alaye, ati kikun fun iranṣẹ rẹ lati dari ihuwasi rẹ (i.e. Ero, Iṣẹ, Awọn iṣe, Olugbo, Ara, Awọn ofin, Iṣẹ-ṣiṣe, Awoṣe, Apẹẹrẹ)"},com_assistants_description_placeholder:{english:"Describe concisely what your assistant can do (i.e. Generate emails from template)",translated:"Ṣe apejuwe ni ṣoki ohun ti iranṣẹ rẹ le ṣe (i.e. Ṣẹda awọn imeeli lati awoṣe)"},com_assistants_actions_disabled:{english:"You need to create an assistant before adding actions.",translated:"O nilo lati ṣẹda iranṣẹ kan ṣaaju fifi awọn iṣe kun."},com_assistants_update_success:{english:"Successfully updated",translated:"Ṣe imudojuiwọn ni aṣeyọri"},com_assistants_update_error:{english:"There was an error updating your assistant.",translated:"Aṣiṣe kan wa ninu imudojuiwọn iranṣẹ rẹ."},com_assistants_create_success:{english:"Successfully created",translated:"Ṣe ṣẹda ni aṣeyọri"},com_assistants_create_error:{english:"There was an error creating your assistant.",translated:"Aṣiṣe kan wa ninu ṣiṣẹda iranṣẹ rẹ."},com_assistants_loading:{english:"Loading assistants...",translated:"Nṣiṣẹ awọn iranṣẹ..."},com_assistants_pii_redaction_reason_required:{english:"Please provide a reason for enabling PII.",translated:"Jọwọ pese idi fun ṣiṣe PII."},com_assistants_settings_and_privacy:{english:"Settings & Privacy",translated:"Eto & Asiri"},com_assistants_pii_redaction:{english:"PII Redaction",translated:"Pipa PII"},com_assistants_pii_redaction_enabled_info:{english:"PII redaction is enabled for this assistant's model calls by default.",translated:"Pipa PII ti wa ni titan fun awọn ipe awoṣe iranṣẹ yii nipasẹ aiyipada."},com_assistants_pii_redaction_disabled_info:{english:"Allowing PII disables redaction for this assistant’s model calls. You are responsible for complying with your organization’s data policies. Activity is fully logged and monitored.",translated:"Fifaye PII n pa pipa fun awọn ipe awoṣe iranṣẹ yii. O jẹ ojuse rẹ lati ni ibamu pẹlu awọn eto imulo data agbari rẹ. Iṣẹ-ṣiṣe ti wa ni kikọ ni kikun ati abojuto."},com_assistants_pii_redaction_off_reason_placeholder:{english:"Please explain your reason for enabling PII (required).",translated:"Jọwọ ṣalaye idi rẹ fun ṣiṣe PII (o nilo)."},com_ui_min_length_error:{english:"Minimum length is {0} characters.",translated:"Iwọn ti o kere julọ ni {0} awọn ohun kikọ."},com_ui_max_length_error:{english:"Maximum length is {0} characters.",translated:"Iwọn ti o pọ julọ ni {0} awọn ohun kikọ."},com_ui_date_today:{english:"Today",translated:"Loni"},com_ui_date_yesterday:{english:"Yesterday",translated:"Ana"},com_ui_date_previous_7_days:{english:"Previous 7 days",translated:"Awọn ọjọ 7 ti o kọja"},com_ui_date_previous_30_days:{english:"Previous 30 days",translated:"Awọn ọjọ 30 ti o kọja"},com_ui_date_january:{english:"January",translated:"Oṣù Kínní"},com_ui_date_february:{english:"February",translated:"Oṣù Èrèlè"},com_ui_date_march:{english:"March",translated:"Oṣù Ẹrẹ̀nà"},com_ui_date_april:{english:"April",translated:"Oṣù Ìgbé"},com_ui_date_may:{english:"May",translated:"Oṣù Ẹ̀bibi"},com_ui_date_june:{english:"June",translated:"Oṣù Kẹfà"},com_ui_date_july:{english:"July",translated:"Oṣù Keje"},com_ui_date_august:{english:"August",translated:"Oṣù Kẹjọ"},com_ui_date_september:{english:"September",translated:"Oṣù Kẹsan"},com_ui_date_october:{english:"October",translated:"Oṣù Kẹwàá"},com_ui_date_november:{english:"November",translated:"Oṣù Kọkànlá"},com_ui_date_december:{english:"December",translated:"Oṣù Kejìlá"},com_ui_field_required:{english:"This field is required",translated:"A nilo aaye yii"},com_ui_download_error:{english:"Error downloading file. The file may have been deleted.",translated:"Aṣiṣe gbigba faili. Faili le ti paarẹ."},com_ui_attach_error_type:{english:"Unsupported file type for endpoint:",translated:"Iru faili ti a ko ṣe atilẹyin fun opin:"},com_ui_attach_error_openai:{english:"Cannot attach Assistant files to other endpoints",translated:"Ko le so awọn faili Iranlọwọ mọ awọn opin miiran"},com_ui_attach_error_size:{english:"File size limit exceeded for endpoint:",translated:"Iwọn faili ti kọja opin fun opin:"},com_ui_attach_error:{english:"Cannot attach file. Create or select a conversation, or try refreshing the page.",translated:"Ko le so faili pọ. Ṣẹda tabi yan ibaraẹnisọrọ, tabi gbiyanju lati tun oju-iwe naa ṣe."},com_ui_examples:{english:"Examples",translated:"Àpẹẹrẹ"},com_ui_new_chat:{english:"New chat",translated:"Ibaraẹnisọrọ tuntun"},com_ui_conversations:{english:"Chats",translated:"Ibaraẹnisọrọ"},com_ui_conversations_placeholder:{english:"Start a conversation...",translated:"Bẹrẹ ibaraẹnisọrọ..."},com_ui_new_conversation:{english:"New Chat",translated:"Ibaraẹnisọrọ Tuntun"},com_ui_assistant_library:{english:"Assistant Library",translated:"Ile-ikawe Iranlọwọ"},com_ui_kbot_assistants:{english:"Knowledge",translated:"Ìmọ̀"},com_ui_assistant_search:{english:"Search for an assistant",translated:"Wa fun iranlọwọ"},com_ui_assistant_default_category:{english:"General",translated:"Gbogbogbo"},com_ui_assistant_featured:{english:"Featured",translated:"Ifihan"},com_ui_assistant_no_matches:{english:"No assistants match the search criteria.",translated:"Ko si awọn iranlọwọ ti o ba awọn ibeere wiwa mu."},com_ui_assistant_empty_results:{english:"No assistants found.",translated:"Ko si awọn iranlọwọ ti a ri."},com_ui_example_quantum_computing:{english:"Explain quantum computing in simple terms",translated:"Ṣàlàyé ìṣirò quantum ní ìròyìn tó rọrùn"},com_ui_example_10_year_old_b_day:{english:"Got any creative ideas for a 10 year old's birthday?",translated:"Ṣé ó ní èrò àṣàdánwò fún ọjọ́ ìbí ọmọ ọdún mẹ́wàá?"},com_ui_example_http_in_js:{english:"How do I make an HTTP request in Javascript?",translated:"Báwo ni mo ṣe lè ṣe ìbéèrè HTTP nínú Javascript?"},com_ui_category_placeholder:{english:"Search a category",translated:"Wá ẹ̀ka kan"},com_ui_tool_placeholder:{english:"Search a tool",translated:"Wá irinṣẹ́ kan"},com_ui_capabilities:{english:"Capabilities",translated:"Agbara"},com_ui_capability_remember:{english:"Remembers what user said earlier in the conversation",translated:"Rántí ohun tí oníṣe sọ ní ìbáṣepọ̀ ṣáájú"},com_ui_capability_correction:{english:"Allows user to provide follow-up corrections",translated:"Fún oníṣe láàyè láti ṣe àtúnṣe"},com_ui_capability_decline_requests:{english:"Trained to decline inappropriate requests",translated:"Ẹ̀kọ́ láti kọ ìbéèrè tí kò tọ́"},com_ui_limitations:{english:"Limitations",translated:"Ìdínkù"},com_ui_limitation_incorrect_info:{english:"May occasionally generate incorrect information",translated:"Léè ṣe àṣìṣe ní ìgbà díẹ̀"},com_ui_limitation_harmful_biased:{english:"May occasionally produce harmful instructions or biased content",translated:"Léè ṣe ìtóyè tó lè ṣe ipalara tàbí tó ní ìwà ìkà"},com_ui_limitation_limited_2021:{english:"Limited knowledge of world and events after 2021",translated:"Ìmọ̀ díẹ̀ nípa ayé àti ìṣẹ̀lẹ̀ lẹ́yìn 2021"},com_ui_on:{english:"On",translated:"Lórí"},com_ui_off:{english:"Off",translated:"Pàápàá"},com_ui_yes:{english:"Yes",translated:"Bẹ́ẹ̀ni"},com_ui_no:{english:"No",translated:"Rárá"},com_ui_ascending:{english:"Asc",translated:"Ìròkè"},com_ui_descending:{english:"Desc",translated:"Ìròwọ̀"},com_ui_show_all:{english:"Show All",translated:"Fihàn Gbogbo"},com_ui_name:{english:"Name",translated:"Orúkọ"},com_ui_date:{english:"Date",translated:"Ọjọ́"},com_ui_storage:{english:"Storage",translated:"Ìkànsí"},com_ui_context:{english:"Context",translated:"Àkójọpọ̀"},com_ui_size:{english:"Size",translated:"Iwọn"},com_ui_host:{english:"Host",translated:"Alejo"},com_ui_update:{english:"Update",translated:"Imudojuiwọn"},com_ui_authentication:{english:"Authentication",translated:"Ìfàṣẹsí"},com_ui_instructions:{english:"Instructions",translated:"Àwọn ìtọnisọna"},com_ui_description:{english:"Description",translated:"Àpejuwe"},com_ui_category:{english:"Category",translated:"Ẹ̀ka"},com_ui_category_tooltip:{english:"Assign a business category to help filter and organize assistants by function.",translated:"Yan ẹ̀ka ìṣòwò láti ràn lọ́wọ́ láti ṣe àlẹmọ àti ṣètò àwọn olùrànlọ́wọ́ nípa iṣẹ́."},com_ui_error:{english:"Error",translated:"Àṣìṣe"},com_ui_error_connection:{english:"Error connecting to server, try refreshing the page.",translated:"Àṣìṣe nípa ìsopọ̀ sí sẹ́bà, gbìyànjú láti tún ojúewé náà ṣe."},com_ui_select:{english:"Select",translated:"Yan"},com_ui_select_placeholder:{english:"Select options",translated:"Yan àwọn aṣayan"},com_ui_remove:{english:"Remove",translated:"Yọ"},com_ui_input:{english:"Input",translated:"Ìkókọ"},com_ui_close:{english:"Close",translated:"Pa"},com_ui_model:{english:"Model",translated:"Àwòrán"},com_ui_name_empty_error:{english:"The assistant name field cannot be empty. Please enter a valid name.",translated:"Àwọn pápá orúkọ olùrànlọ́wọ́ kò lè ṣofo. Jọ̀wọ́ tẹ orúkọ tó yẹ."},com_ui_smart_prefix_error:{english:"Smart Prefix was used for General Assistants, Please use a different name.",translated:"Smart Prefix ni a lo fún Àwọn Olùrànlọ́wọ́ Gbogbogbo, Jọ̀wọ́ lo orúkọ mìíràn."},com_ui_description_empty_error:{english:"The description field cannot be empty. Please enter a valid description.",translated:"Àwọn pápá àpejuwe kò lè ṣofo. Jọ̀wọ́ tẹ àpejuwe tó yẹ."},com_ui_instructions_empty_error:{english:"The instructions field cannot be empty. Please enter valid instructions.",translated:"Àwọn pápá ìtọnisọna kò lè ṣofo. Jọ̀wọ́ tẹ àwọn ìtọnisọna tó yẹ."},com_ui_category_empty_error:{english:"The category field cannot be empty. Please select a category.",translated:"Àwọn pápá ẹ̀ka kò lè ṣofo. Jọ̀wọ́ yan ẹ̀ka kan."},com_ui_duplicate_assistant_error:{english:"A duplicate assistant name has been detected. Please choose a unique name.",translated:"Orúkọ olùrànlọ́wọ́ tó jọ ara wọn ni a rí. Jọ̀wọ́ yan orúkọ aláìlékọ̀ọ́kan."},com_ui_shared_with_empty_error:{english:"The shared with field cannot be empty. Please select a shared with option.",translated:"Àwọn pápá pínpín pèlu kò lè ṣofo. Jọ̀wọ́ yan aṣayan pínpín pèlu."},com_ui_shared_with:{english:"Shared With",translated:"Pín Pẹ̀lú"},com_ui_shared_with_tooltip_1:{english:"Private – Only you can access and view this assistant.",translated:"Ìkọkọ – Ìwọ nìkan ni o lè wọlé àti wo olùrànlọ́wọ́ yìí."},com_ui_shared_with_tooltip_2:{english:"Share only with Team – This assistant will be visible and accessible to your team members.",translated:"Pín pèlu Ẹgbẹ́ nìkan – Olùrànlọ́wọ́ yìí yóò han àti wọlé fún àwọn ọmọ ẹgbẹ́ rẹ."},com_ui_shared_with_team:{english:"Team",translated:"Ẹgbẹ"},com_ui_shared_with_team_tooltip:{english:"Select the team this assistant belongs to. Only teams you are a member of will appear here.",translated:"Yan ẹgbẹ ti oluranlọwọ yii jẹ ti. Awọn ẹgbẹ ti o jẹ ọmọ ẹgbẹ nikan ni yoo han nibi."},com_ui_shared_with_team_empty_error:{english:"The team field cannot be empty. Please select a team.",translated:"Aaye ẹgbẹ ko le ṣofo. Jọwọ yan ẹgbẹ kan."},com_assistants_team_shared_locked:{english:"This assistant is locked for editing because it is team-shared.",translated:"Olùrànlọ́wọ́ yìí ti tiítì fún títúnṣe nítorí pé wọ́n pín rẹ̀ pẹ̀lú ẹgbẹ́."},com_ui_share_retrieve_error:{english:"Error loading shared links.",translated:"Aṣiṣe gbigba awọn ọna asopọ pinpin."},com_ui_name_profanity_error:{english:"Your Assistant name contains offensive words and could not be sent. Please update your Assistant name.",translated:"Orukọ Oluranlọwọ rẹ ni awọn ọrọ ẹgan ati pe ko le firanṣẹ. Jọwọ ṣe imudojuiwọn orukọ Oluranlọwọ rẹ."},com_ui_description_profanity_error:{english:"Your Description contains offensive words and could not be sent. Please update your Description.",translated:"Apejuwe rẹ ni awọn ọrọ ẹgan ati pe ko le firanṣẹ. Jọwọ ṣe imudojuiwọn Apejuwe rẹ."},com_ui_instructions_profanity_error:{english:"Your Instructions contains offensive words and could not be sent. Please update your Instructions.",translated:"Awọn ilana rẹ ni awọn ọrọ ẹgan ati pe ko le firanṣẹ. Jọwọ ṣe imudojuiwọn Awọn ilana rẹ."},com_ui_select_search_model:{english:"Search model by name",translated:"Wa awoṣe nipasẹ orukọ"},com_ui_select_search_plugin:{english:"Search plugin by name",translated:"Wa afikun nipasẹ orukọ"},com_ui_use_prompt:{english:"Use prompt",translated:"Lo ìkìlọ"},com_ui_prev:{english:"Prev",translated:"Tẹlẹ"},com_ui_next:{english:"Next",translated:"Tókàn"},com_ui_stop:{english:"Stop",translated:"Duro"},com_ui_upload_files:{english:"Upload files",translated:"Gbe awọn faili soke"},com_ui_prompt_templates:{english:"Prompt Templates",translated:"Àwòrán ìkìlọ"},com_ui_hide_prompt_templates:{english:"Hide Prompt Templates",translated:"Tọju Àwòrán ìkìlọ"},com_ui_showing:{english:"Showing",translated:"Nfihan"},com_ui_of:{english:"of",translated:"ti"},com_ui_entries:{english:"Entries",translated:"Awọn titẹsi"},com_ui_none_selected:{english:"None selected",translated:"Ko si ti a yan"},com_ui_upload_success:{english:"Successfully uploaded file",translated:"Faili ti gbe soke ni aṣeyọri"},com_ui_upload_error:{english:"There was an error uploading your file",translated:"Aṣiṣe kan wa ninu gbigba faili rẹ soke"},com_ui_upload_invalid:{english:"Invalid file for upload. Must be an image not exceeding 2 MB",translated:"Faili ti ko wulo fun gbigba soke. Gbọdọ jẹ aworan ti ko ju 2 MB lọ"},com_ui_thinking:{english:"Thinking",translated:"N ronu"},com_ui_analyzing_request:{english:"Understanding your question",translated:"N ṣe itupalẹ ibeere rẹ"},com_ui_processing:{english:"Putting it together",translated:"Nṣiṣẹ"},com_ui_working_on_it:{english:"Almost ready",translated:"N ṣiṣẹ lori rẹ"},com_ui_cancel:{english:"Cancel",translated:"Fagilee"},com_ui_save:{english:"Save",translated:"Fipamọ"},com_user_message:{english:"You",translated:"Iwọ"},com_ui_read_aloud:{english:"Read aloud",translated:"Ka ni gbangba"},com_ui_copied:{english:"Copied!",translated:"Daakọ!"},com_ui_copy_code:{english:"Copy code",translated:"Daakọ koodu"},com_ui_copy_to_clipboard:{english:"Copy to clipboard",translated:"Daakọ si agekuru"},com_ui_copied_to_clipboard:{english:"Copied to clipboard",translated:"Daakọ si agekuru"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Darukọ opin, iranṣẹ, tabi eto lati yara yipada si"},com_ui_regenerate:{english:"Regenerate",translated:"Tun ṣe"},com_ui_edit:{english:"Edit",translated:"Ṣatunkọ"},com_ui_all:{english:"all",translated:"gbogbo"},com_ui_clear:{english:"Clear",translated:"Ko o"},com_ui_import_conversation:{english:"Import",translated:"Gbe wọle"},com_ui_nothing_found:{english:"Nothing found",translated:"Ko si nkan ti a ri"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Lọ si ibaraẹnisọrọ"},com_ui_import_conversation_info:{english:"Import conversations from a JSON file",translated:"Gbe ibaraẹnisọrọ wọle lati faili JSON"},com_ui_import_conversation_success:{english:"Conversations imported successfully",translated:"Ibaraẹnisọrọ ti wọle ni aṣeyọri"},com_ui_import_conversation_error:{english:"There was an error importing your conversations",translated:"Aṣiṣe kan wa ninu gbigbe ibaraẹnisọrọ rẹ wọle"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Iru gbigbe wọle ti ko ni atilẹyin"},com_ui_confirm_action:{english:"Confirm Action",translated:"Jẹrisi Iṣe"},com_ui_avatar:{english:"Avatar",translated:"Aworan ara"},com_ui_unknown:{english:"Unknown",translated:"Aìmọ̀"},com_ui_result:{english:"Result",translated:"Esi"},com_ui_image_gen:{english:"Image Gen",translated:"Ìṣẹ̀dá Àwòrán"},com_ui_assistant:{english:"Assistant",translated:"Oluranlọwọ"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Oluranlọwọ ti paarẹ ni aṣeyọri"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Aṣiṣe kan wa nígbà tí a ń pa oluranlọwọ"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Àwòrán tó jọ ara rẹ̀ rí."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Aṣiṣe kan ṣẹlẹ̀ nígbà tí a ń gbé àwòrán sórí ayélujára."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Aṣiṣe kan ṣẹlẹ̀ nígbà tí a ń gbé àwòrán sórí ayélujára: Ibi ipari kò ṣàlàyé"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Àwòrán tí kò ní nnkan kankan kò jẹ́wọ́."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"O lè gbé àwòrán tó pọ̀ jù {0} lọ nígbà kan."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"O lè gbé àwòrán tó pọ̀ jù {0} lọ nínú apá yìí."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Ìdíye ìgbékalẹ̀ ti dé fún {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Kò lè ṣàlàyé irú àwòrán fún: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Irú fáìlì kò ṣe é ṣe. Jọwọ rán fáìlì ní irú tó ṣe é ṣe."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Ìkúnà láti gbé àwòrán wọlé"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Ní báyìí, JPEG, JPG, PNG, àti WEBP ni a ṣe é gbà."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Ìwọn àwòrán kọjá {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Ìwọn àpapọ̀ àwọn àwòrán kò lè kọjá {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Aṣiṣe kan ṣẹlẹ̀ nígbà tí a ń ṣàyẹ̀wò àwòrán."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Aṣiṣe kan ṣẹlẹ̀ nígbà tí a ń ṣe àwòrán."},com_ui_assistants:{english:"Assistants",translated:"Àwọn Oluranlọwọ"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Ìrànlọ́wọ́ Studio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Ìmọ̀"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Akọkọ"},com_ui_attachment:{english:"Attachment",translated:"Ẹ̀dá"},com_ui_assistants_output:{english:"Assistants Output",translated:"Awọn abajade Iranlọwọ"},com_ui_delete:{english:"Delete",translated:"Paarẹ"},com_ui_create:{english:"Create",translated:"Ṣẹda"},com_ui_share:{english:"Share",translated:"Pín"},com_ui_copy_link:{english:"Copy link",translated:"Da ọna asopọ"},com_ui_update_link:{english:"Update link",translated:"Ṣe imudojuiwọn ọna asopọ"},com_ui_create_link:{english:"Create link",translated:"Ṣẹda ọna asopọ"},com_ui_share_link_to_chat:{english:"Share link to chat",translated:"Pín ọna asopọ si iwiregbe"},com_ui_share_error:{english:"There was an error sharing the chat link",translated:"Aṣiṣe kan wa ninu pinpin ọna asopọ iwiregbe"},com_ui_share_create_message:{english:"Your name and any messages you add after sharing stay private.",translated:"Orukọ rẹ ati awọn ifiranṣẹ ti o fi kun lẹhin pinpin wa ni ikọkọ."},com_ui_share_created_message:{english:"A public link to your chat has been created. Manage previously shared chats at any time via Settings.",translated:"Ọna asopọ gbangba si iwiregbe rẹ ti ṣẹda. Ṣakoso awọn iwiregbe ti a ti pin tẹlẹ nigbakugba nipasẹ Eto."},com_ui_share_update_message:{english:"Your name, custom instructions, and any messages you add after sharing stay private.",translated:"Orukọ rẹ, awọn ilana aṣa, ati awọn ifiranṣẹ ti o fi kun lẹhin pinpin wa ni ikọkọ."},com_ui_share_updated_message:{english:"A public link to your chat has been updated. Manage previously shared chats at any time via Settings.",translated:"Ọna asopọ gbangba si iwiregbe rẹ ti ṣe imudojuiwọn. Ṣakoso awọn iwiregbe ti a ti pin tẹlẹ nigbakugba nipasẹ Eto."},com_ui_shared_link_not_found:{english:"Shared link not found",translated:"Ọna asopọ ti a pin ko ri"},com_ui_delete_conversation:{english:"Delete chat?",translated:"Paarẹ iwiregbe?"},com_ui_delete_conversation_confirm:{english:"This will delete",translated:"Eyi yoo paarẹ"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Ṣe o da ọ loju pe o fẹ paarẹ Iranlọwọ yii? Eyi ko le yipada."},com_ui_rename:{english:"Rename",translated:"Tun orukọ"},com_ui_more_options:{english:"More",translated:"Diẹ sii"},com_ui_preview:{english:"Preview",translated:"Atunyẹwo"},com_ui_upload:{english:"Upload",translated:"Po si"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Fifi "{0}" ranṣẹ n gba akoko diẹ sii ju ti a ti reti lọ. Jọwọ duro de nigba ti faili naa ba pari ifiweranṣẹ fun gbigba.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Ilana ìpamọ"},com_ui_terms_of_service:{english:"Terms of service",translated:"Àwọn ìlànà ìṣẹ́ṣẹ"},com_ui_use_micrphone:{english:"Use microphone",translated:"Lo foonu agbọrọsọ"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Kò le yọ àwọn iye míràn, o kere ju {0} ni a nilo."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Ìyàtọ̀ tó pọ̀ jùlọ ni {0}, lo àwọn iye tuntun."},com_auth_error_login:{english:"Unable to login with the information provided. Please check your credentials and try again.",translated:"Kò le wọlé pẹ̀lú ìwífún tí a pèsè. Jọ̀wọ́ ṣàyẹ̀wò àwọn ìdánimọ̀ rẹ àti gbìyànjú lẹ́ẹ̀kansi."},com_auth_error_login_rl:{english:"You have exceeded the number of allowed login attempts. Please try again in 15 minutes.",translated:"O ti kọjá iye ìgbà wọlé tí a gba. Jọ̀wọ́ gbìyànjú lẹ́ẹ̀kansi ní ìṣẹ́jú 15."},com_auth_error_login_ban:{english:"Your account has been temporarily banned due to violations of our service.",translated:"Àkọọlẹ rẹ ti dáwọ́ dúró títí àkókò kan nítorí ìkànsí àwọn ìlànà wa."},com_auth_error_login_server:{english:"There was an internal server error. Please wait a few moments and try again.",translated:"Àsìṣe ẹ̀rọ ìṣẹ́lẹ̀ kan wà. Jọ̀wọ́ dúró díẹ̀ káàkiri àti gbìyànjú lẹ́ẹ̀kansi."},com_auth_sign_in:{english:"Login",translated:"Wọlé"},com_endpoint_system_message:{english:"System Message",translated:"Ìfiranṣẹ́ Ẹ̀rọ"},com_endpoint_message:{english:"Message",translated:"Ìfiranṣẹ́"},com_endpoint_messages:{english:"Messages",translated:"Àwọn Ìfiranṣẹ́"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Ṣatunkọ ìfiranṣẹ́ rẹ tàbí Ṣẹ̀dá tuntun."},com_endpoint_default_blank:{english:"default: blank",translated:"aiyipada: òfo"},com_endpoint_default_false:{english:"default: false",translated:"aiyipada: irọ́"},com_endpoint_default_creative:{english:"default: creative",translated:"aiyipada: ẹ̀dá"},com_endpoint_default_empty:{english:"default: empty",translated:"aiyipada: òfo"},com_endpoint_default_with_num:{english:"default: {0}",translated:"aiyipada: {0}"},com_endpoint_context:{english:"Context",translated:"Àkóónú"},com_endpoint_tone_style:{english:"Tone Style",translated:"Àṣà Ìró"},com_endpoint_token_count:{english:"Token count",translated:"Ìkànsí Àkọsílẹ̀"},com_endpoint_output:{english:"Output",translated:"Ẹ̀bùn"},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Ìkànsí Àkóónú Tó pọ̀ jùlọ"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Ìkànsí tó pọ̀ jùlọ tí a lè lò fún àkóónú. Lo èyí fún ìṣàkóso iye ìkànsí tí a rán ní ìbéèrè kọọkan.
  Bí a kò bá ṣàlàyé, yóò lo aiyipada ẹ̀rọ ní ìbámu pẹ̀lú ìwọn àkóónú àwọn àwòrán tó mọ̀. Ṣíṣe ìṣètò iye tó gíga lè fa àṣìṣe àti/tàbí iye ìkànsí tó pọ̀ jù.`},com_endpoint_prompt_prefix_placeholder:{english:"Set custom instructions or context. Ignored if empty.",translated:"Ṣètò àwọn ìlànà tàbí àkóónú àdani. A kò ní fojú pa bí ó bá ṣofo."},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Yi awọn ilana oluranlọwọ pada. Eyi wulo fun iyipada ihuwasi lori ipilẹ kọọkan."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Ṣeto awọn ilana afikun tabi konteksti lori awọn ilana akọkọ ti Oluranlọwọ. A foju ti o ba ṣofo."},com_endpoint_custom_name:{english:"Custom Name",translated:"Orukọ Aṣa"},com_endpoint_prompt_prefix:{english:"Custom Instructions",translated:"Awọn Ilana Aṣa"},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Awọn Ilana Afikun"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Yi Awọn Ilana Pada"},com_endpoint_temperature:{english:"Temperature",translated:"Iwọn otutu"},com_endpoint_default:{english:"default",translated:"aiyipada"},com_endpoint_top_p:{english:"Top P",translated:"Top P"},com_endpoint_top_k:{english:"Top K",translated:"Top K"},com_endpoint_max_output_tokens:{english:"Max Output Tokens",translated:"Awọn Token Ijade Max"},com_endpoint_stop:{english:"Stop Sequences",translated:"Duro Awọn Sequences"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Ya awọn iye nipa titẹ `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Aṣayan `max_tokens`, ti o nsoju nọmba to pọ julọ ti awọn token ti o le ṣe ni ipari ibaraẹnisọrọ.\n\nGbogbo gigun ti awọn token titẹ sii ati awọn token ti a ṣe ni opin nipasẹ gigun konteksti awoṣe. O le ni iriri awọn aṣiṣe ti nọmba yii ba kọja awọn token konteksti max."},com_endpoint_openai_temp:{english:"Higher values = more random, while lower values = more focused and deterministic. We recommend altering this or Top P but not both.",translated:"Awọn iye ti o ga = diẹ sii laileto, nigba ti awọn iye kekere = diẹ sii idojukọ ati deterministic. A ṣeduro iyipada eyi tabi Top P ṣugbọn kii ṣe mejeeji."},com_endpoint_openai_max:{english:"The max tokens to generate. The total length of input tokens and generated tokens is limited by the model's context length.",translated:"Awọn token max lati ṣe. Gbogbo gigun ti awọn token titẹ sii ati awọn token ti a ṣe ni opin nipasẹ gigun konteksti awoṣe."},com_endpoint_openai_topp:{english:"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. We recommend altering this or temperature but not both.",translated:"Ọna miiran si ayẹwo pẹlu iwọn otutu, ti a pe ni ayẹwo nucleus, nibiti awoṣe ṣe akiyesi awọn abajade ti awọn token pẹlu ibi-iṣowo iṣeeṣe top_p. Nitorinaa 0.1 tumọ si pe awọn token ti o ni 10% iṣeeṣe ti o ga julọ ni a ka. A ṣeduro iyipada eyi tabi iwọn otutu ṣugbọn kii ṣe mejeeji."},com_endpoint_openai_freq:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.",translated:"Nọmba laarin 0 ati 2.0. Awọn iye rere ṣe ijiya awọn token tuntun da lori igbohunsafẹfẹ wọn ti o wa tẹlẹ ninu ọrọ naa, dinku iṣeeṣe awoṣe lati tun ila kanna ṣe."},com_endpoint_openai_pres:{english:"Number between 0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.",translated:"Nọmba laarin 0 ati 2.0. Awọn iye rere ṣe ijiya awọn token tuntun da lori boya wọn han ninu ọrọ naa, mu iṣeeṣe awoṣe lati sọrọ nipa awọn akọle tuntun."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Tun gbogbo awọn faili ti a ti fi sii tẹlẹ ranṣẹ. Akọsilẹ: eyi yoo mu iye owo token pọ si ati pe o le ni iriri awọn aṣiṣe pẹlu ọpọlọpọ awọn asomọ."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Ipinnu fun awọn ibeere Iran. "Kekere" jẹ din owo ati yara, "Ga" jẹ alaye diẹ sii ati gbowolori, ati "Auto" yoo yan laifọwọyi laarin meji da lori ipinnu aworan.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Soke si awọn jara 4 nibiti API yoo da ṣiṣe awọn token siwaju."},com_endpoint_openai_custom_name_placeholder:{english:"Set a custom name for iXHello",translated:"Ṣeto orukọ aṣa fun iXHello"},com_endpoint_openai_prompt_prefix_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Ṣeto awọn ilana aṣa lati ṣafikun ni Ifiranṣẹ Eto. Aiyipada: ko si"},com_endpoint_frequency_penalty:{english:"Frequency Penalty",translated:"Ijiya Igbohunsafẹfẹ"},com_endpoint_presence_penalty:{english:"Presence Penalty",translated:"Ìjìya Ìwàláàyè"},com_endpoint_plug_use_functions:{english:"Use Functions",translated:"Lo Àwọn Ìṣe"},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Tun Fíránṣẹ́ Fáìlì"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Àlàyé Àwòrán"},com_endpoint_plug_skip_completion:{english:"Skip Completion",translated:"Fagilé Ìparí"},com_endpoint_plug_set_custom_instructions_for_gpt_placeholder:{english:"Set custom instructions to include in System Message. Default: none",translated:"Ṣètò àṣẹ àdani láti fi sí Ifiranṣẹ Eto. Àyànfẹ́: kò sí"},com_endpoint_import:{english:"Import",translated:"Gbé wọlé"},com_endpoint_set_custom_name:{english:"Set a custom name, in case you can find this preset",translated:"Ṣètò orúkọ àdani, nígbàtí o bá lè rí ààyè yìí"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Ṣé o dájú pé o fẹ́ pa ààyè yìí rẹ?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Ààyè Ti wọlé!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Àsìṣe kan wà nígbàtí o ń gbé ààyè rẹ wọlé. Jọwọ tún gbìyànjú."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Àsìṣe kan wà nígbàtí o ń fipamọ̀ ààyè rẹ. Jọwọ tún gbìyànjú."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Àsìṣe kan wà nígbàtí o ń pa ààyè rẹ. Jọwọ tún gbìyànjú."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"kì í ṣe ààyè àyànfẹ́ mọ́."},com_endpoint_preset_default_item:{english:"Default:",translated:"Àyànfẹ́:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Kò sí ààyè àyànfẹ́ tó nṣiṣe."},com_endpoint_preset_title:{english:"Preset",translated:"Ààyè"},com_endpoint_preset_saved:{english:"Saved!",translated:"Ti fipamọ̀!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"ní báyìí jẹ́ ààyè àyànfẹ́."},com_endpoint_preset:{english:"preset",translated:"ààyè"},com_endpoint_presets:{english:"presets",translated:"ààyè"},com_endpoint_preset_selected_title:{english:"Active!",translated:"Níṣiṣe!"},com_endpoint_preset_name:{english:"Preset Name",translated:"Orúkọ Ààyè"},com_endpoint:{english:"Endpoint",translated:"Opopona"},com_endpoint_examples:{english:" Presets",translated:"Ààyè"},com_endpoint_export:{english:"Export",translated:"Gbe jade"},com_endpoint_export_share:{english:"Export/Share",translated:"Gbe jade/Pín"},com_endpoint_assistant:{english:"Assistant",translated:"Iranlọwọ"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Lo Iranlọwọ Ti nṣiṣe lọwọ"},com_endpoint_save_as_preset:{english:"Save As Preset",translated:"Fipamọ Gẹgẹ bi Eto"},com_endpoint_presets_clear_warning:{english:"Are you sure you want to clear all presets? This is irreversible.",translated:"Ṣe o da ọ loju pe o fẹ nu gbogbo awọn eto kuro? Eyi ko le yipada."},com_endpoint_no_presets:{english:"No presets yet, use the settings button to create one",translated:"Ko si eto sibẹsibẹ, lo bọtini eto lati ṣẹda ọkan"},com_endpoint_my_preset:{english:"My Preset",translated:"Eto Mi"},com_endpoint_agent_model:{english:"Agent Model (Recommended: GPT-3.5)",translated:"Awoṣe Aṣoju (Ṣeduro: GPT-3.5)"},com_endpoint_completion_model:{english:"Completion Model (Recommended: GPT-4)",translated:"Awoṣe Ipari (Ṣeduro: GPT-4)"},com_endpoint_func_hover:{english:"Enable use of Plugins as OpenAI Functions",translated:"Mu lilo Awọn afikun bi Awọn iṣẹ OpenAI ṣiṣẹ"},com_endpoint_skip_hover:{english:"Enable skipping the completion step, which reviews the final answer and generated steps",translated:"Mu foju ipari igbesẹ ṣiṣẹ, eyi ti o ṣe atunyẹwo idahun ikẹhin ati awọn igbesẹ ti a ṣe"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Jọwọ yan Iranlọwọ kan ki o bẹrẹ ibaraẹnisọrọ tuntun"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Ṣeto Bọtini rẹ ninu akojọ aṣayan Ori lati ba sọrọ."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Jọwọ Yan Iranlọwọ kan"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Kaabo si iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Ọrọ si Ohùn"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Ṣiṣe Aifọwọyi Ifiranṣẹ Tuntun"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Ohùn si Ọrọ"},com_nav_profile_picture:{english:"Profile Picture",translated:"Aworan Profaili"},com_nav_change_picture:{english:"Change picture",translated:"Yi aworan pada"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Fi Eto Aṣoju Han"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Fi Eto Ipari Han"},com_hide_examples:{english:"Hide Examples",translated:"Tọju Àpẹẹrẹ"},com_show_examples:{english:"Show Examples",translated:"Fi Àpẹẹrẹ Han"},com_nav_export_filename:{english:"Filename",translated:"Orukọ faili"},com_nav_export_filename_placeholder:{english:"Set the filename",translated:"Ṣeto orukọ faili"},com_nav_export_type:{english:"Type",translated:"Iru"},com_nav_export_conversation:{english:"Export conversation",translated:"Gbe ijiroro jade"},com_nav_export:{english:"Export",translated:"Gbe jade"},com_nav_shared_links:{english:"Shared links",translated:"Awọn ọna asopọ pinpin"},com_nav_shared_links_manage:{english:"Manage",translated:"Ṣakoso"},com_nav_shared_links_empty:{english:"You have no shared links.",translated:"O ko ni awọn ọna asopọ pinpin."},com_nav_shared_links_name:{english:"Name",translated:"Orukọ"},com_nav_shared_links_date_shared:{english:"Date shared",translated:"Ọjọ ti a pin"},com_nav_source_chat:{english:"View source chat",translated:"Wo ibaraẹnisọrọ orisun"},com_nav_my_files:{english:"File Manager",translated:"Olùṣàkóso Faili"},com_nav_admin_center:{english:"Admin Center",translated:"Ile-iṣẹ Alakoso"},com_nav_theme:{english:"Theme",translated:"Àkóónú"},com_nav_theme_system:{english:"System",translated:"Eto"},com_nav_theme_dark:{english:"Dark",translated:"Dúdú"},com_nav_theme_light:{english:"Light",translated:"Fẹlẹfẹlẹ"},com_nav_user_name_display:{english:"Display username in messages",translated:"Fi orukọ olumulo han ninu awọn ifiranṣẹ"},com_nav_clear_all_chats:{english:"Clear all chats",translated:"Nu gbogbo awọn ibaraẹnisọrọ"},com_nav_confirm_clear:{english:"Confirm Clear",translated:"Jẹrisi Mimọ"},com_nav_close_sidebar:{english:"Close sidebar",translated:"Pa ẹgbẹ ẹgbẹ"},com_nav_open_sidebar:{english:"Open sidebar",translated:"Ṣii ẹgbẹ ẹgbẹ"},com_nav_send_message:{english:"Send message",translated:"Firanṣẹ ifiranṣẹ"},com_nav_log_out:{english:"Log out",translated:"Jade"},com_nav_user:{english:"USER",translated:"OLÙTỌ́JÚ"},com_nav_archived_chats:{english:"Archived chats",translated:"Awọn iwiregbe ti a fi pamọ"},com_nav_archived_chats_manage:{english:"Manage",translated:"Ṣakoso"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"O ko ni awọn ibaraẹnisọrọ ti a fi pamọ."},com_nav_archive_name:{english:"Name",translated:"Orukọ"},com_nav_archive_created_at:{english:"DateCreated",translated:"ỌjọTi a Da"},com_nav_clear_conversation:{english:"Clear conversations",translated:"Nu awọn ibaraẹnisọrọ"},com_nav_clear_conversation_confirm_message:{english:"Are you sure you want to clear all conversations? This is irreversible.",translated:"Ṣe o da ọ loju pe o fẹ nu gbogbo awọn ibaraẹnisọrọ? Eyi ko le yipada."},com_nav_help:{english:"Help",translated:"Iranlọwọ"},com_nav_user_guide:{english:"User Guide",translated:"Itọsọna Olumulo"},com_nav_settings:{english:"Settings",translated:"Eto"},com_nav_search_placeholder:{english:"Search messages",translated:"Wa awọn ifiranṣẹ"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Firanṣẹ laifọwọyi (lẹhin 3 aaya)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Aṣiṣe ṣiṣere ohun: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Aṣiṣe ilana ohun: {0}"},com_nav_engine:{english:"Engine",translated:"Ẹrọ"},com_nav_browser:{english:"Browser",translated:"Burausa"},com_nav_external:{english:"External",translated:"Lode"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Pa ibi ipamọ kaṣi kuro"},com_nav_voice_select:{english:"Voice",translated:"Ohùn"},com_nav_setting_general:{english:"General",translated:"Gbogbogbo"},com_nav_setting_speech:{english:"Speech",translated:"Ọrọ"},com_nav_language:{english:"Language",translated:"Ede"},com_nav_lang_auto:{english:"Auto detect",translated:"Ṣawari laifọwọyi"},com_page_not_found:{english:"Page not found",translated:"Àkọsílẹ̀ kò rí"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Ohun kan lọ̀rọ̀"},com_unauthorized_access:{english:"Unauthorized access",translated:"Ìwọlé láìfọwọ́sí"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Ìwọlé láìfọwọ́sí. Ìwọlé jẹ́ fún àwọn àgbègbè pàtàkì nìkan."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Àkọọlẹ rẹ ti dáwọ́ dúró títí àkókò kan nítorí ìdálùdálà iṣẹ́ wa"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Ìwọlé rẹ ti dín kù níta nẹ́tíwọ́kì!"},com_support_ticket_text:{english:"Support Ticket",translated:"Tikẹ́ẹ̀tì Àtìlẹ́yìn"},com_help_dialog_Header:{english:"Need assistance?",translated:"Ṣe o nílò ìrànlọ́wọ́?"},com_help_dialog_text_1_1:{english:"Click",translated:"Tẹ"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"fun awọn ilana alaye"},com_help_dialog_text_here:{english:"here",translated:"nibi"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Fun awọn iṣoro, fọwọsi"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Fun awọn iṣoro, kan si"},com_help_dialog_text_ticket:{english:"ticket",translated:"tikeeti"},com_help_dialog_text_3:{english:"Find the steps",translated:"Wa awọn igbesẹ"},com_status_ind_none:{english:"Operational",translated:"Nṣiṣẹ"},com_status_ind_minor:{english:"Minor Issues",translated:"Awọn iṣoro Kekere"},com_status_ind_major:{english:"Major Issues",translated:"Awọn iṣoro Nla"},com_status_ind_critical:{english:"Critical",translated:"Pataki"},com_status_ind_error:{english:"Error Fetching",translated:"Aṣiṣe Gbigba"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Jọwọ ṣe akiyesi pe nigba ti o ba fi iwiregbe silẹ tabi bẹrẹ iwiregbe tuntun, iwọ yoo padanu itan iwiregbe rẹ."},com_forbidden_access:{english:"Forbidden access",translated:"Wiwọle ewọ"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Ilana Lilo Itẹwọgba"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Ilana Asiri"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Adehun Iforukọsilẹ"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Ṣaaju lilo iX Hello, o le ṣe atunyẹwo ti Concentrix's "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Nipa iforukọsilẹ ati/tabi titẹ, o gba awọn ofin loke."},com_login_page_and:{english:"and ",translated:"ati "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Ko si awọn oluranlọwọ ti a fi sii"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Awọn oluranlọwọ ti a fi sii"},com_ui_loading:{english:"Loading...",translated:"Nṣiṣẹ..."},com_ui_unpin:{english:"Unpin",translated:"Yọ kuro"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Oluranlọwọ yọ kuro ni aṣeyọri"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Aṣiṣe yiyọ aṣoju kuro"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Aṣoju ti wa ni pinni ni aṣeyọri"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Aṣiṣe pinni/yiyọ aṣoju kuro"},com_ui_pin:{english:"Pin",translated:"Pinni"},come_create_assistant:{english:"Create Assistant",translated:"Ṣẹda Aṣoju"},come_edit_assistant:{english:"Edit Assistant",translated:"Ṣatunkọ Aṣoju"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Ṣe o da ọ loju pe o fẹ tẹsiwaju? Eyi yoo ja si pipadanu eyikeyi awọn ayipada ti a ṣe si Aṣoju ti o n ṣatunkọ tabi ṣẹda lọwọlọwọ. Iṣe yii ko le yipada."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Aṣoju pẹlu id {0} ko ri."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Burausa ko ṣe atilẹyin SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"A ko fun ni igbanilaaye gbohungbohun"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Aṣiṣe ibẹrẹ gbigbasilẹ: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder ko n ṣe igbasilẹ"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder ko ṣe atilẹyin ninu burausa yii"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Ifiranṣẹ rẹ ni alaye ti ara ẹni ati pe ko le firanṣẹ. Jọwọ yọ eyikeyi alaye ti ara ẹni."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Ikuna lati tun orukọ ibaraẹnisọrọ"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"O ni {0} ti awọn aami ti a pin silẹ."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello le ṣe aṣiṣe. Jọwọ ṣe ayẹwo gbogbo awọn abajade fun didara ati deede. Gbogbo awọn igbewọle ni a gbasilẹ fun ibamu."},com_ui_assistant_group_by:{english:"Group by",translated:"Ẹgbẹ nipasẹ"},com_ui_assistant_category:{english:"Category",translated:"Ẹka"},com_ui_assistant_team:{english:"Team",translated:"Ẹgbẹ"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Imọ-ẹrọ"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Oye"},com_ui_assistant_marketing:{english:"Marketing",translated:"Iṣowo"},com_ui_assistant_operations:{english:"Operations",translated:"Awọn iṣẹ"},com_ui_assistant_sales:{english:"Sales",translated:"Tita"},com_ui_assistant_strategy:{english:"Strategy",translated:"Ilana"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Iranlọwọ Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Po aworan avatar kan (PNG tabi JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Ṣawari Lori Ayelujara"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Ṣàbẹwò Ojúlé Ayélujára"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Ṣẹda Aworan"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Ṣe iṣiro Math"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Ọpa Aiyipada"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Gbigbe faili n gba akoko ju ti a ti reti lọ. Jọwọ gbiyanju lẹẹkansi."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Aṣiṣe ninu fifi amugbalegbe mọlẹ"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Aṣiṣe kan wa ninu piparẹ ọna asopọ pinpin"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Àwòrán DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Ko si eto aiyipada ti nṣiṣe lọwọ."},com_ui_drag_drop_title:{english:"Add anything",translated:"Fi ohunkohun kun"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Ju faili eyikeyi si ibi lati fi kun si ibaraẹnisọrọ"},com_ui_analyzing:{english:"Analyzing",translated:"N ṣàlàyé"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Pari ṣàlàyé"},com_ui_warning:{english:"Warning",translated:"Ikilọ"},com_ui_proceed:{english:"Proceed",translated:"Tẹsiwaju"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Awọn faili ti a gbe si amugbalegbe ni a lo fun awọn idi ibaraẹnisọrọ nikan. Awọn olumulo le wọle si akoonu awọn faili wọnyi nipa beere awọn ibeere ti o yẹ, ṣugbọn gbigba lati ayelujara taara ti awọn faili ko gba laaye."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Ṣeto orukọ aṣa fun eto yii"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Ṣeto apẹẹrẹ igbewọle. Apẹẹrẹ ni a foju silẹ ti o ba ṣofo."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Ṣeto apẹẹrẹ igbewọle. Apẹẹrẹ ni a foju silẹ ti o ba ṣofo."},com_nav_export_select_type:{english:"Select a file type",translated:"Yan iru faili kan"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"sikirinisoti (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"ọrọ (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Ko si esi ti a gba. Jọwọ gbiyanju lati fi ifiranṣẹ rẹ ranṣẹ lẹẹkansi. Ti iṣoro naa ba wa lẹhin atunṣe oju-iwe ati igbiyanju lẹẹkansi, jọwọ kan si atilẹyin."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Padà sí Iwiregbe"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Ìtójú Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Ìtójú guardrail ti ṣiṣẹ́ fún iranṣẹ́ yìí. Àkóónú yóò jẹ́ ayẹwo sí ìlànà ìtójú."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Ìdínà ìtójú guardrail yọ ìtójú àkóónú fún iranṣẹ́ yìí. Ìwọ ni ojuse láti tẹ̀lé ìlànà àkóónú ilé iṣẹ́ rẹ. Àwọn ìṣẹ̀lẹ̀ ni a gbé kalẹ̀ àti ṣàkóso."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Jọ̀wọ́ ṣàlàyé ìdáhùn ìṣòwò rẹ fún ìdínà ìtójú guardrail (àìní)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Jọ̀wọ́ pèsè ìdáhùn fún ìdínà ìtójú guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Gba awọn olumulo laaye lati yi awoṣe pada ninu iwiregbe"},com_ui_feedback_good:{english:"Good response",translated:"Ìdáhùn rere"},com_ui_feedback_bad:{english:"Poor response",translated:"Ìdáhùn burúkú"},com_ui_feedback_comments:{english:"Comments",translated:"Àwọn ìwòye"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Àwọn ìwòye (àṣàyàn)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Jẹ́ kí a mọ̀ sí i nípa iriri rẹ..."},com_ui_feedback_submit:{english:"Submit",translated:"Fíránṣẹ́"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"A kò lè rán àwọn ìmọ̀ rẹ síbẹ̀"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Àìṣòótọ́"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Kò ní í ṣe pẹ̀lú ọ̀rọ̀"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Ti pẹ́ jù"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Alaye kò tó"},com_ui_feedback_reason_other:{english:"Other",translated:"Mìíràn"},com_ui_model_recommended:{english:"Recommended",translated:"Àwọn àbá"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Ìtàn – jọ̀wọ́ ṣe àtúnṣe"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Akọ́lé yìí kò ṣe àtìlẹ́yìn mọ́. Jọwọ yan akọ́lé tuntun."},com_nav_setting_memory:{english:"Memory",translated:"Iranti"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Ṣakoso awọn otitọ ti ara ẹni ti aṣoju ranti kọja awọn ibaraẹnisọrọ rẹ."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Fi iranti tuntun kun…"},com_nav_memory_add_button:{english:"Add memory",translated:"Fi iranti kun"},com_nav_memory_category:{english:"Category",translated:"Ẹka"},com_nav_memory_category_preference:{english:"Preference",translated:"Ayanfẹ"},com_nav_memory_category_identity:{english:"Identity",translated:"Idanimọ"},com_nav_memory_category_context:{english:"Context",translated:"Akọkọ"},com_nav_memory_category_project:{english:"Project",translated:"Ise agbese"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Ko si awọn iranti sibẹsibẹ"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Awọn iranti ti o fipamọ yoo han nibi ati ṣe iranlọwọ lati ṣe akanṣe awọn ibaraẹnisọrọ iwaju."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Ko le gba awọn iranti. Jọwọ gbiyanju lẹẹkansi."},com_nav_memory_retry:{english:"Retry",translated:"Tun gbiyanju"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Ko le fi iranti kun. Jọwọ gbiyanju lẹẹkansi."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Ko le ṣe imudojuiwọn iranti. Jọwọ gbiyanju lẹẹkansi."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Ko le paarẹ iranti. Jọwọ gbiyanju lẹẹkansi."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Paarẹ iranti yii?"},com_nav_memory_delete_button:{english:"Delete",translated:"Paarẹ"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Ṣatunkọ iranti"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Paarẹ iranti"},com_nav_memory_save:{english:"Save",translated:"Fipamọ"},com_nav_memory_cancel:{english:"Cancel",translated:"Fagilee"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Ti fipamọ {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — awoṣe ironu GPT-5 tuntun pẹlu ọgbọn iwaju."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — onírẹ̀lẹ̀ àti iye owo dínkù GPT-5.4."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — awoṣe iran tuntun GPT-5."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus tuntun — ìmọ̀lẹ̀ àkànṣe fún àwọn aṣoju kọ́dìngì àti iṣẹ́ agbari."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus tuntun — ìmọ̀lẹ̀ àkànṣe fún àwọn aṣoju kọ́dìngì àti iṣẹ́ agbari."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet tó dára síi pẹ̀lú ìmúdára ìrònú àti ìtẹ̀lé ìlànà."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Awoṣe tó lágbára jùlọ ti Anthropic fún àwọn iṣẹ́ tó nira, tó ní ìgbésẹ̀ púpọ̀."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Ìmọ̀ àti iyara tó dọ́gba fún àwọn iṣẹ́ tó pọ̀."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Awoṣe Claude tó yara jùlọ àti tó kéré jùlọ — tó peye fún iṣẹ́ tó pọ̀."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — ìmúdára ìrònú àti àgbékalẹ̀ multimodal."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Awoṣe ìran tuntun OpenAI tó ga jùlọ."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 tó fẹẹrẹ́ — tó munadoko àti yara fún iṣẹ́ ojoojúmọ́."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — ìtẹ̀lé ìlànà àti ìrònú tó dára."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 tó kéré — yara àti iye owo dínkù fún iṣẹ́ tó rọrùn."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Awoṣe GPT-4 tó lágbára jùlọ, tó peye fún iyara àti iye owo."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o tó fẹẹrẹ́ — yara àti iye owo dínkù fún iṣẹ́ tó rọrùn."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Awoṣefaaji) — awoṣe Gemini ti o ni agbara julọ pẹlu ìwé-ìpín 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Awoṣefaaji) — yára àti ṣiṣẹ́ pẹlu ìwé-ìpín 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — awoṣe fẹẹrẹ pẹlu idaduro kekere àti ìwé-ìpín 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Awoṣe oluranlọwọ tó peye fún ohùn."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto yan awoṣe ti o dara julọ fun ibeere rẹ da lori agbara ati iṣẹ."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Ó ń bọ̀ láìpẹ́"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Awọn ayanfẹ ipa-ọna aifọwọyi"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Ṣatunṣe bi olulana Aifọwọyi ṣe n dọgbadọgba awọn paṣipaarọ nigba yiyan awoṣe fun iyipo kọọkan. A ṣe deede awọn iwuwo — iwọntunwọnsi ibatan ni o ṣe pataki."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Iye owo"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Fẹran awọn awoṣe ti o din owo pẹlu iye owo token kekere."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Iṣedede"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Fẹran awọn awoṣe to lagbara fun ironu to nira."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Iyara"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Fẹran awọn awoṣe to yara, pẹlu idaduro kekere."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Tun pada si aiyipada"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Akoko gbigbe faili ti pari. Jọwọ gbìyànjú lẹ́ẹ̀kansi ní ìṣẹ́jú díẹ̀."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Nkankan lọ aṣiṣe. Eyi ni ifiranṣẹ aṣiṣe pato ti a pade: Aṣiṣe kan ṣẹlẹ nigba ṣiṣe ibeere rẹ. Oluranlọwọ ko si mọ. Jọwọ kan si Alákóso."},com_ui_code:{english:"Code",translated:"Koodu"},com_ui_assistant_share:{english:"Share",translated:"Pín"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"A da ọna asopọ kọ"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"O kò ní àyè sí olùrànlọ́wọ́ yìí"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Kò lè da ọna asopọ kọ si pátákó ìrántí"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Akopọ ko wa — iṣelọpọ akoonu ko pari."},com_ui_view_code:{english:"View code",translated:"Wo koodu"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Akọwọlẹ ko wa — akoonu ko wulo."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Nọmba Foonu"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Adirẹsi Imeeli"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Kaadi Kirẹditi"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"Nọmba Idanimọ Awujọ"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Ìgbéyọ fáìlì ń gba àkókò ju bí a ti retí lọ - ń tún gbìyànjú ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Ìṣòro asopọ - ń tún gbìyànjú ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Ìgbéyọ fáìlì kùnà - jọ̀wọ́ ṣàyẹ̀wò asopọ rẹ kí o sì tún gbìyànjú"},com_assistants_memory_enabled:{english:"Memory",translated:"Ìrántí"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Ìrántí ti ṣiṣẹ fún olùrànlọ́wọ́ yìí. Olùrànlọ́wọ́ lè fi àwọn òtítọ́ pamọ́ kí ó sì rántí wọn kọjá àwọn ìbánisọ̀rọ̀."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Ìrántí ti wa ni pipa fún olùrànlọ́wọ́ yìí. Kò sí òtítọ́ kankan tí a ó fi pamọ́ tàbí rántí kọjá àwọn ìbánisọ̀rọ̀."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Jọ̀wọ́ ṣàlàyé ìdí iṣẹ́ rẹ fún pípa ìrántí (dandan)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Jọ̀wọ́ pèsè ìdí fún pípa ìrántí."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Ìrántí ti wa ni pipa fún ẹgbẹ́ rẹ. O lè wo kí o sì pa àwọn ìrántí tó wà tẹ́lẹ̀ rẹ́, ṣùgbọ́n o kò lè fi tuntun kún un tàbí ṣàtúnṣe wọn."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Nṣiṣẹ kóòdù rẹ"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"N wa ibi-ipamọ ìmọ̀"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"N ṣiṣẹ ohùn"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"N fipamọ sí ìrántí"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"N yọ kúrò ní ìrántí"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Pari wiwa lórí wẹẹbù"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Pari àyẹ̀wò ojú-òpó wẹẹbù"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"A ti ṣẹda àwòrán"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Pari iṣírò"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"Pari ṣiṣiṣẹ kóòdù rẹ"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"Pari wiwa ibi-ipamọ ìmọ̀"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"Pari ṣiṣiṣẹ ìwọlé ohùn"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"Ti fipamọ sí ìrántí"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"Ti yọ kúrò ní ìrántí"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"Pari: {0}"},com_ui_still_working:{english:"still working...",translated:"ṣì ń ṣiṣẹ..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} ti ṣetan"},com_ui_file_ready_fallback:{english:"File is ready",translated:"Faili ti ṣetan"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"A kò lè ṣiṣẹ́ {0}"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"A kò lè ṣiṣẹ́ faili"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"A kò lè ṣiṣẹ́ {0}. Jọ̀wọ́ tún faili náà po sí."},com_ui_file_processing_failed_reupload_fallback:{english:"File could n