glish:"You",translated:"Bạn"},com_ui_read_aloud:{english:"Read aloud",translated:"Đọc to"},com_ui_copied:{english:"Copied!",translated:"Đã sao chép!"},com_ui_copy_code:{english:"Copy code",translated:"Sao chép mã"},com_ui_mention:{english:"Mention an endpoint, assistant, or preset to quickly switch to it",translated:"Đề cập đến điểm cuối, trợ lý hoặc đặt sẵn để chuyển nhanh"},com_ui_nothing_found:{english:"Nothing found",translated:"Không tìm thấy"},com_ui_go_to_conversation:{english:"Go to conversation",translated:"Đi đến cuộc trò chuyện"},com_ui_import_conversation_file_type_error:{english:"Unsupported import type",translated:"Loại nhập không được hỗ trợ"},com_ui_avatar:{english:"Avatar",translated:"Hình đại diện"},com_ui_unknown:{english:"Unknown",translated:"Không xác định"},com_ui_result:{english:"Result",translated:"Kết quả"},com_ui_image_gen:{english:"Image Gen",translated:"Tạo hình ảnh"},com_ui_assistant:{english:"Assistant",translated:"Trợ lý"},com_ui_assistant_deleted:{english:"Successfully deleted assistant",translated:"Đã xóa trợ lý thành công"},com_ui_assistant_delete_error:{english:"There was an error deleting the assistant",translated:"Có lỗi khi xóa trợ lý"},com_ui_assistant_duplicate_file_upload:{english:"Duplicate file detected.",translated:"Phát hiện tệp trùng lặp."},com_ui_assistant_file_upload_error:{english:"An error occurred while uploading the file.",translated:"Có lỗi khi tải lên tệp."},com_ui_assistant_file_upload_endpoint_undefined:{english:"An error occurred while uploading the file: Endpoint is undefined",translated:"Có lỗi khi tải lên tệp: Điểm cuối không xác định"},com_ui_assistant_file_upload_not_empty:{english:"Empty files are not allowed.",translated:"Không cho phép tệp trống."},com_ui_assistant_file_upload_count_error:{english:"You can only upload up to {0} files at a time.",translated:"Bạn chỉ có thể tải lên tối đa {0} tệp một lần."},com_ui_assistant_file_upload_section_count_error:{english:"You can only upload up to {0} files in this section.",translated:"Bạn chỉ có thể tải lên tối đa {0} tệp trong phần này."},com_ui_assistant_file_upload_section_response_error:{english:"The upload limit has been reached for {0}",translated:"Đã đạt giới hạn tải lên cho {0}"},com_ui_assistant_file_upload_type_unknown:{english:"Unable to determine file type for: {0}",translated:"Không thể xác định loại tệp cho: {0}"},com_ui_assistant_file_upload_unsupported_type:{english:"File type not supported. Please upload a supported file format.",translated:"Loại tệp không được hỗ trợ. Vui lòng tải lên định dạng tệp được hỗ trợ."},com_ui_assistant_image_failed_load:{english:"Failed to load image",translated:"Không tải được hình ảnh"},com_ui_assistant_file_upload_supported_type:{english:"Currently, only JPEG, JPG, PNG, and WEBP files are supported.",translated:"Hiện tại, chỉ hỗ trợ tệp JPEG, JPG, PNG và WEBP."},com_ui_assistant_file_upload_size_limit:{english:"File size exceeds {0} MB.",translated:"Kích thước tệp vượt quá {0} MB."},com_ui_assistant_file_upload_total_size_limit:{english:"The total size of the files cannot exceed {0} MB.",translated:"Tổng kích thước tệp không được vượt quá {0} MB."},com_ui_assistant_file_validation_error:{english:"An error occurred while validating the file.",translated:"Có lỗi xảy ra khi xác thực tệp."},com_ui_assistant_file_processing_error:{english:"An error occurred while processing the file.",translated:"Có lỗi xảy ra khi xử lý tệp."},com_ui_assistants:{english:"Assistants",translated:"Trợ lý"},com_ui_assistants_category_ix_customer:{english:"Studio Assistance",translated:"Hỗ trợ Studio"},com_ui_assistants_category_kbot:{english:"Knowledge",translated:"Kiến thức"},com_ui_assistants_uncategorized:{english:"Uncategorized",translated:"Chưa phân loại"},com_ui_attachment:{english:"Attachment",translated:"Tệp đính kèm"},com_ui_assistants_output:{english:"Assistants Output",translated:"Kết quả trợ lý"},com_ui_create:{english:"Create",translated:"Tạo"},com_ui_copy_link:{english:"Copy link",translated:"Sao chép liên kết"},com_ui_update_link:{english:"Update link",translated:"Cập nhật liên kết"},com_ui_create_link:{english:"Create link",translated:"Tạo liên kết"},com_ui_delete_assistant_confirm:{english:"Are you sure you want to delete this Assistant? This cannot be undone.",translated:"Bạn có chắc chắn muốn xóa Trợ lý này không? Hành động này không thể hoàn tác."},com_ui_preview:{english:"Preview",translated:"Xem trước"},com_ui_upload:{english:"Upload",translated:"Tải lên"},com_ui_upload_delay:{english:'Uploading "{0}" is taking more time than anticipated. Please wait while the file finishes indexing for retrieval.',translated:'Tải lên "{0}" đang mất nhiều thời gian hơn dự kiến. Vui lòng đợi trong khi tệp hoàn tất lập chỉ mục để truy xuất.'},com_ui_privacy_policy:{english:"Privacy policy",translated:"Chính sách bảo mật"},com_ui_terms_of_service:{english:"Terms of service",translated:"Điều khoản dịch vụ"},com_ui_use_micrphone:{english:"Use microphone",translated:"Sử dụng micro"},com_ui_min_tags:{english:"Cannot remove more values, a minimum of {0} are required.",translated:"Không thể xóa thêm giá trị, cần tối thiểu {0}."},com_ui_max_tags:{english:"Maximum number allowed is {0}, using latest values.",translated:"Số lượng tối đa cho phép là {0}, sử dụng các giá trị mới nhất."},com_endpoint_message:{english:"Message",translated:"Tin nhắn"},com_endpoint_messages:{english:"Messages",translated:"Tin nhắn"},com_endpoint_message_not_appendable:{english:"Edit your message or Regenerate.",translated:"Chỉnh sửa tin nhắn hoặc Tạo lại."},com_endpoint_context_tokens:{english:"Max Context Tokens",translated:"Số lượng Token Tối đa"},com_endpoint_context_info:{english:`The maximum number of tokens that can be used for context. Use this for control of how many tokens are sent per request.
  If unspecified, will use system defaults based on known models' context size. Setting higher values may result in errors and/or higher token cost.`,translated:`Số lượng token tối đa có thể sử dụng cho ngữ cảnh. Dùng để kiểm soát số token gửi mỗi yêu cầu.
  Nếu không chỉ định, sẽ dùng mặc định hệ thống dựa trên kích thước ngữ cảnh của các mô hình đã biết. Đặt giá trị cao hơn có thể gây lỗi và/hoặc tăng chi phí token.`},com_endpoint_instructions_assistants_placeholder:{english:"Overrides the instructions of the assistant. This is useful for modifying the behavior on a per-run basis.",translated:"Ghi đè hướng dẫn của trợ lý. Hữu ích để thay đổi hành vi theo từng lần chạy."},com_endpoint_prompt_prefix_assistants_placeholder:{english:"Set additional instructions or context on top of the Assistant's main instructions. Ignored if empty.",translated:"Đặt hướng dẫn hoặc ngữ cảnh bổ sung trên hướng dẫn chính của Trợ lý. Bỏ qua nếu trống."},com_endpoint_prompt_prefix_assistants:{english:"Additional Instructions",translated:"Hướng Dẫn Bổ Sung"},com_endpoint_instructions_assistants:{english:"Override Instructions",translated:"Ghi Đè Hướng Dẫn"},com_endpoint_stop:{english:"Stop Sequences",translated:"Dừng Chuỗi"},com_endpoint_stop_placeholder:{english:"Separate values by pressing `Enter`",translated:"Ngăn cách giá trị bằng cách nhấn `Enter`"},com_endpoint_openai_max_tokens:{english:"Optional `max_tokens` field, representing the maximum number of tokens that can be generated in the chat completion.\n    \n    The total length of input tokens and generated tokens is limited by the models context length. You may experience errors if this number exceeds the max context tokens.",translated:"Trường `max_tokens` tùy chọn, đại diện cho số lượng token tối đa có thể tạo trong hoàn thành trò chuyện.\n    \n    Tổng độ dài của token đầu vào và token tạo ra bị giới hạn bởi độ dài ngữ cảnh của mô hình. Bạn có thể gặp lỗi nếu số này vượt quá số token tối đa của ngữ cảnh."},com_endpoint_openai_resend_files:{english:"Resend all previously attached files. Note: this will increase token cost and you may experience errors with many attachments.",translated:"Gửi lại tất cả các tệp đính kèm trước đó. Lưu ý: điều này sẽ tăng chi phí token và bạn có thể gặp lỗi với nhiều tệp đính kèm."},com_endpoint_openai_detail:{english:'The resolution for Vision requests. "Low" is cheaper and faster, "High" is more detailed and expensive, and "Auto" will automatically choose between the two based on the image resolution.',translated:'Độ phân giải cho yêu cầu Vision. "Thấp" rẻ hơn và nhanh hơn, "Cao" chi tiết hơn và đắt hơn, và "Tự động" sẽ tự động chọn giữa hai dựa trên độ phân giải hình ảnh.'},com_endpoint_openai_stop:{english:"Up to 4 sequences where the API will stop generating further tokens.",translated:"Tối đa 4 chuỗi nơi API sẽ ngừng tạo thêm token."},com_endpoint_plug_resend_files:{english:"Resend Files",translated:"Gửi Lại Tệp"},com_endpoint_plug_image_detail:{english:"Image Detail",translated:"Chi Tiết Hình Ảnh"},com_endpoint_preset_delete_confirm:{english:"Are you sure you want to delete this preset?",translated:"Bạn có chắc chắn muốn xóa đặt sẵn này?"},com_endpoint_preset_import:{english:"Preset Imported!",translated:"Đã Nhập Đặt Sẵn!"},com_endpoint_preset_import_error:{english:"There was an error importing your preset. Please try again.",translated:"Có lỗi khi nhập đặt sẵn của bạn. Vui lòng thử lại."},com_endpoint_preset_save_error:{english:"There was an error saving your preset. Please try again.",translated:"Có lỗi khi lưu đặt sẵn của bạn. Vui lòng thử lại."},com_endpoint_preset_delete_error:{english:"There was an error deleting your preset. Please try again.",translated:"Có lỗi khi xóa đặt sẵn của bạn. Vui lòng thử lại."},com_endpoint_preset_default_removed:{english:"is no longer the default preset.",translated:"không còn là đặt sẵn mặc định."},com_endpoint_preset_default_item:{english:"Default:",translated:"Mặc Định:"},com_endpoint_preset_default_none:{english:"No default preset active.",translated:"Không có đặt sẵn mặc định hoạt động."},com_endpoint_preset_title:{english:"Preset",translated:"Đặt Sẵn"},com_endpoint_preset_saved:{english:"Saved!",translated:"Đã Lưu!"},com_endpoint_preset_default:{english:"is now the default preset.",translated:"đã là đặt sẵn mặc định."},com_endpoint_preset_selected_title:{english:"Active!",translated:"Kích hoạt!"},com_endpoint_export_share:{english:"Export/Share",translated:"Xuất/Chia sẻ"},com_endpoint_assistant:{english:"Assistant",translated:"Trợ lý"},com_endpoint_use_active_assistant:{english:"Use Active Assistant",translated:"Sử dụng Trợ lý đang hoạt động"},com_endpoint_assistant_placeholder:{english:"Please select an Assistant and start a new chat",translated:"Vui lòng chọn Trợ lý và bắt đầu trò chuyện mới"},com_endpoint_config_placeholder:{english:"Set your Key in the Header menu to chat.",translated:"Đặt Khóa của bạn trong menu Header để trò chuyện."},com_nav_welcome_assistant:{english:"Please Select an Assistant",translated:"Vui lòng chọn Trợ lý"},com_nav_welcome_message:{english:"Welcome to iXHello",translated:"Chào mừng đến với iXHello"},com_nav_text_to_speech:{english:"Text to Speech",translated:"Chuyển văn bản thành giọng nói"},com_nav_automatic_playback:{english:"Autoplay Latest Message",translated:"Tự động phát tin nhắn mới nhất"},com_nav_speech_to_text:{english:"Speech to Text",translated:"Chuyển giọng nói thành văn bản"},com_nav_profile_picture:{english:"Profile Picture",translated:"Ảnh đại diện"},com_nav_change_picture:{english:"Change picture",translated:"Thay đổi ảnh"},com_show_agent_settings:{english:"Show Agent Settings",translated:"Hiển thị Cài đặt Đại lý"},com_show_completion_settings:{english:"Show Completion Settings",translated:"Hiển thị Cài đặt Hoàn thành"},com_hide_examples:{english:"Hide Examples",translated:"Ẩn Ví dụ"},com_show_examples:{english:"Show Examples",translated:"Hiển thị Ví dụ"},com_nav_user_name_display:{english:"Display username in messages",translated:"Hiển thị tên người dùng trong tin nhắn"},com_nav_archived_chats:{english:"Archived chats",translated:"Trò chuyện đã lưu trữ"},com_nav_archived_chats_manage:{english:"Manage",translated:"Quản lý"},com_nav_archived_chats_empty:{english:"You have no archived conversations.",translated:"Bạn không có cuộc trò chuyện nào đã lưu trữ."},com_nav_archive_name:{english:"Name",translated:"Tên"},com_nav_archive_created_at:{english:"DateCreated",translated:"Ngày tạo"},com_nav_user_guide:{english:"User Guide",translated:"Hướng dẫn sử dụng"},com_nav_auto_send_text:{english:"Auto send text (after 3 sec)",translated:"Tự động gửi văn bản (sau 3 giây)"},com_nav_audio_play_error:{english:"Error playing audio: {0}",translated:"Lỗi phát âm thanh: {0}"},com_nav_audio_process_error:{english:"Error processing audio: {0}",translated:"Lỗi xử lý âm thanh: {0}"},com_nav_engine:{english:"Engine",translated:"Động cơ"},com_nav_browser:{english:"Browser",translated:"Trình duyệt"},com_nav_external:{english:"External",translated:"Bên ngoài"},com_nav_delete_cache_storage:{english:"Delete cache storage",translated:"Xóa bộ nhớ đệm"},com_nav_voice_select:{english:"Voice",translated:"Giọng nói"},com_nav_setting_speech:{english:"Speech",translated:"Giọng nói"},com_nav_language:{english:"Language",translated:"Ngôn ngữ"},com_nav_lang_auto:{english:"Auto detect",translated:"Tự động phát hiện"},com_page_not_found:{english:"Page not found",translated:"Không tìm thấy trang"},com_something_went_wrong_error:{english:"Something went wrong",translated:"Đã xảy ra lỗi"},com_unauthorized_access:{english:"Unauthorized access",translated:"Truy cập không được phép"},com_domain_restricted_access:{english:"Unauthorized access. Access is restricted to specific domains.",translated:"Truy cập không được phép. Truy cập bị hạn chế đến các miền cụ thể."},com_temporarily_banned:{english:"Your account has been temporarily banned due to violations of our service",translated:"Tài khoản của bạn đã bị cấm tạm thời do vi phạm dịch vụ của chúng tôi"},com_temporarily_restricted:{english:"You are restricted to access the app outside of network!",translated:"Bạn bị hạn chế truy cập ứng dụng ngoài mạng!"},com_support_ticket_text:{english:"Support Ticket",translated:"Phiếu hỗ trợ"},com_help_dialog_Header:{english:"Need assistance?",translated:"Cần hỗ trợ?"},com_help_dialog_text_1_1:{english:"Click",translated:"Nhấp"},com_help_dialog_text_1_2:{english:"for detailed instructions",translated:"để có hướng dẫn chi tiết"},com_help_dialog_text_here:{english:"here",translated:"vào đây"},com_help_dialog_text_2:{english:"For issues, fill out a",translated:"Đối với các vấn đề, điền vào"},com_help_dialog_text_non_concentrix:{english:"For issues, contact",translated:"Đối với các vấn đề, liên hệ"},com_help_dialog_text_ticket:{english:"ticket",translated:"phiếu"},com_help_dialog_text_3:{english:"Find the steps",translated:"Tìm các bước"},com_status_ind_none:{english:"Operational",translated:"Hoạt động"},com_status_ind_minor:{english:"Minor Issues",translated:"Vấn đề nhỏ"},com_status_ind_major:{english:"Major Issues",translated:"Vấn đề lớn"},com_status_ind_critical:{english:"Critical",translated:"Nghiêm trọng"},com_status_ind_error:{english:"Error Fetching",translated:"Lỗi lấy dữ liệu"},com_chat_conversation_history_restricted:{english:"Please note that when you leave a chat or start a new chat, you will lose your conversation history.",translated:"Lưu ý rằng khi bạn rời khỏi trò chuyện hoặc bắt đầu trò chuyện mới, bạn sẽ mất lịch sử trò chuyện."},com_forbidden_access:{english:"Forbidden access",translated:"Truy cập bị cấm"},com_login_page_use_policy:{english:"Acceptable Use Policy",translated:"Chính sách Sử dụng Chấp nhận được"},com_login_page_privacy_policy:{english:"Privacy Policy",translated:"Chính sách Bảo mật"},com_login_page_subscription_agreement:{english:"Subscription Agreement",translated:"Thỏa thuận Đăng ký"},com_login_page_agreement_info_start:{english:"Before using iX Hello, you can review Concentrix's ",translated:"Trước khi sử dụng iX Hello, bạn có thể xem xét "},com_login_page_agreement_info_end:{english:"By signing up and/or entering, you agree to the above terms.",translated:"Bằng cách đăng ký và/hoặc truy cập, bạn đồng ý với các điều khoản trên."},com_login_page_and:{english:"and ",translated:"và "},com_nav_no_pinned_assistants:{english:"No pinned assistants",translated:"Không có trợ lý được ghim"},com_nav_pinned_assistants:{english:"Pinned assistants",translated:"Trợ lý được ghim"},com_ui_loading:{english:"Loading...",translated:"Đang tải..."},com_ui_unpin:{english:"Unpin",translated:"Bỏ ghim"},com_ui_assistant_unpin_success:{english:"Assistant unpinned successfully",translated:"Bỏ ghim trợ lý thành công"},com_ui_assistant_unpin_error:{english:"Error unpinning assistant",translated:"Lỗi khi bỏ ghim trợ lý"},com_ui_assistant_pin_success:{english:"Assistant pinned successfully",translated:"Ghim trợ lý thành công"},com_ui_assistant_pin_unpin_error:{english:"Error pinning/unpinning assistant",translated:"Lỗi khi ghim/bỏ ghim trợ lý"},com_ui_pin:{english:"Pin",translated:"Ghim"},come_create_assistant:{english:"Create Assistant",translated:"Tạo Trợ lý"},come_edit_assistant:{english:"Edit Assistant",translated:"Chỉnh sửa Trợ lý"},com_ui_edit_assistant_confirm:{english:"Are you sure you want to proceed? This will result in the loss of any changes made to the Assistant you are currently editing or creating. This action cannot be undone.",translated:"Bạn có chắc chắn muốn tiếp tục? Điều này sẽ làm mất bất kỳ thay đổi nào đã thực hiện đối với Trợ lý bạn đang chỉnh sửa hoặc tạo. Hành động này không thể hoàn tác."},com_ui_assistant_not_found:{english:"Assistant with id {0} was not found.",translated:"Không tìm thấy trợ lý với id {0}."},com_ui_speech_recognition_browser_support_error:{english:"Browser does not support SpeechRecognition",translated:"Trình duyệt không hỗ trợ SpeechRecognition"},com_ui_microphone_permission_error:{english:"Microphone permission not granted",translated:"Không cấp quyền truy cập micro"},com_ui_starting_recording_error:{english:"Error starting recording: {0}",translated:"Lỗi khi bắt đầu ghi âm: {0}"},com_ui_media_recorder_error:{english:"MediaRecorder is not recording",translated:"MediaRecorder không ghi âm"},com_ui_media_recorder_browser_support_error:{english:"MediaRecorder is not supported in this browser",translated:"MediaRecorder không được hỗ trợ trên trình duyệt này"},com_ui_chat_personal_information_error:{english:"Your message contains personal information and could not be sent. Please remove any personal information.",translated:"Tin nhắn của bạn chứa thông tin cá nhân và không thể gửi được. Vui lòng xóa mọi thông tin cá nhân."},com_ui_conversation_rename_error:{english:"Failed to rename conversation",translated:"Không thể đổi tên cuộc trò chuyện"},com_ui_remaining_tokens:{english:"You have {0} of your allocated tokens remaining.",translated:"Bạn còn {0} token được phân bổ."},com_ui_footer_disclaimer:{english:"iX Hello can make mistakes. Please review all outputs for quality and accuracy. All inputs are logged for compliance.",translated:"iX Hello có thể mắc lỗi. Vui lòng xem xét tất cả đầu ra để đảm bảo chất lượng và độ chính xác. Tất cả đầu vào đều được ghi lại để tuân thủ."},com_ui_assistant_group_by:{english:"Group by",translated:"Nhóm theo"},com_ui_assistant_category:{english:"Category",translated:"Danh mục"},com_ui_assistant_team:{english:"Team",translated:"Nhóm"},com_ui_assistant_CX:{english:"CX",translated:"CX"},com_ui_assistant_engineering:{english:"Engineering",translated:"Kỹ thuật"},com_ui_assistant_intelligence:{english:"Intelligence",translated:"Trí tuệ"},com_ui_assistant_marketing:{english:"Marketing",translated:"Tiếp thị"},com_ui_assistant_operations:{english:"Operations",translated:"Vận hành"},com_ui_assistant_sales:{english:"Sales",translated:"Bán hàng"},com_ui_assistant_strategy:{english:"Strategy",translated:"Chiến lược"},com_ui_assistant_studio_assistance:{english:"Studio Assistants",translated:"Trợ lý Studio"},com_ui_avatar_upload_instructions:{english:"Upload an avatar image (PNG or JPG < 2MB)",translated:"Tải lên ảnh đại diện (PNG hoặc JPG < 2MB)"},com_ui_assistant_tools_search_online:{english:"Searching the web",translated:"Tìm kiếm trực tuyến"},com_ui_assistant_tools_browse_website:{english:"Browsing website",translated:"Duyệt trang web"},com_ui_assistant_tools_generate_images:{english:"Generating images",translated:"Tạo hình ảnh"},com_ui_assistant_tools_calculate_math:{english:"Calculating",translated:"Tính toán"},com_ui_assistant_tools_default:{english:"Running tool",translated:"Công cụ mặc định"},com_ui_assistant_file_upload_timeout:{english:"The file upload is taking longer than expected. Please try again.",translated:"Tải lên tệp mất nhiều thời gian hơn dự kiến. Vui lòng thử lại."},com_ui_assistant_pin_error:{english:"Error pinning assistant",translated:"Lỗi ghim trợ lý"},com_ui_share_delete_error:{english:"There was an error deleting the shared link",translated:"Có lỗi khi xóa liên kết chia sẻ"},com_ui_dan:{english:"DAN",translated:"DAN"},com_ui_dan_template:{english:"DAN Template",translated:"Mẫu DAN"},com_endpoint_preset_default_none_HIDDEN:{english:"No default preset active.",translated:"Không có thiết lập mặc định nào đang hoạt động."},com_ui_drag_drop_title:{english:"Add anything",translated:"Thêm bất cứ thứ gì"},com_ui_drag_drop_description:{english:"Drop any file here to add it to the conversation",translated:"Thả bất kỳ tệp nào vào đây để thêm vào cuộc trò chuyện"},com_ui_analyzing:{english:"Analyzing",translated:"Đang phân tích"},com_ui_finished_analyzing:{english:"Finished analyzing",translated:"Đã hoàn tất phân tích"},com_ui_warning:{english:"Warning",translated:"Cảnh báo"},com_ui_proceed:{english:"Proceed",translated:"Tiếp tục"},com_ui_file_upload_warning:{english:"Files uploaded to the assistant are used for conversational purposes only. Users can access the content of these files by asking relevant questions, but direct download of the files are not permitted.",translated:"Các tệp tải lên trợ lý chỉ được sử dụng cho mục đích trò chuyện. Người dùng có thể truy cập nội dung của các tệp này bằng cách đặt câu hỏi liên quan, nhưng không được phép tải xuống trực tiếp các tệp."},com_endpoint_preset_name_placeholder:{english:"Set a custom name for this preset",translated:"Đặt tên tùy chỉnh cho thiết lập này"},com_endpoint_example_input_placeholder:{english:"Set example input. Example is ignored if empty.",translated:"Đặt ví dụ đầu vào. Ví dụ sẽ bị bỏ qua nếu để trống."},com_endpoint_example_output_placeholder:{english:"Set example output. Example is ignored if empty.",translated:"Đặt ví dụ đầu ra. Ví dụ sẽ bị bỏ qua nếu để trống."},com_nav_export_select_type:{english:"Select a file type",translated:"Chọn loại tệp"},com_nav_export_type_screenshot:{english:"screenshot (.png)",translated:"ảnh chụp màn hình (.png)"},com_nav_export_type_text:{english:"text (.txt)",translated:"văn bản (.txt)"},com_nav_export_type_markdown:{english:"markdown (.md)",translated:"markdown (.md)"},com_nav_export_type_json:{english:"json (.json)",translated:"json (.json)"},com_nav_export_type_csv:{english:"csv (.csv)",translated:"csv (.csv)"},com_ui_error_empty_agent_response:{english:"No response was received. Please try sending your message again. If the issue persists after reloading the page and retrying, please contact support.",translated:"Không nhận được phản hồi. Vui lòng thử gửi lại tin nhắn của bạn. Nếu sự cố vẫn tiếp diễn sau khi tải lại trang và thử lại, vui lòng liên hệ hỗ trợ."},com_ui_back_to_chat:{english:"Back to Chat",translated:"Quay lại Trò chuyện"},com_assistants_guardrail_moderation:{english:"Guardrail Moderation",translated:"Điều tiết Guardrail"},com_assistants_guardrail_moderation_enabled_info:{english:"Guardrail moderation is enabled for this assistant. Content will be checked against moderation policies.",translated:"Điều tiết guardrail được bật cho trợ lý này. Nội dung sẽ được kiểm tra theo chính sách điều tiết."},com_assistants_guardrail_moderation_disabled_info:{english:"Disabling guardrail moderation removes content moderation checks for this assistant. You are responsible for complying with your organization’s content policies. Activity is fully logged and monitored.",translated:"Tắt điều tiết guardrail sẽ loại bỏ kiểm tra điều tiết nội dung cho trợ lý này. Bạn chịu trách nhiệm tuân thủ chính sách nội dung của tổ chức. Hoạt động được ghi lại và giám sát đầy đủ."},com_assistants_guardrail_moderation_off_reason_placeholder:{english:"Please explain your business justification for disabling guardrail moderation (required).",translated:"Vui lòng giải thích lý do kinh doanh của bạn khi tắt điều tiết guardrail (bắt buộc)."},com_assistants_guardrail_moderation_reason_required:{english:"Please provide a justification for disabling guardrail moderation.",translated:"Vui lòng cung cấp lý do để tắt điều tiết guardrail."},com_assistants_allow_model_switching:{english:"Allow users to change model in chat",translated:"Cho phép người dùng thay đổi mô hình trong trò chuyện"},com_ui_feedback_good:{english:"Good response",translated:"Phản hồi tốt"},com_ui_feedback_bad:{english:"Poor response",translated:"Phản hồi kém"},com_ui_feedback_comments:{english:"Comments",translated:"Bình luận"},com_ui_feedback_comments_optional:{english:"Comments (optional)",translated:"Bình luận (tùy chọn)"},com_ui_feedback_placeholder:{english:"Tell us more about your experience...",translated:"Hãy cho chúng tôi biết thêm về trải nghiệm của bạn..."},com_ui_feedback_submit:{english:"Submit",translated:"Gửi"},com_ui_feedback_error:{english:"We couldn't send your feedback",translated:"Chúng tôi không thể gửi phản hồi của bạn"},com_ui_feedback_reason_incorrect:{english:"Incorrect",translated:"Không chính xác"},com_ui_feedback_reason_not_relevant:{english:"Not relevant",translated:"Không liên quan"},com_ui_feedback_reason_outdated:{english:"Outdated",translated:"Lỗi thời"},com_ui_feedback_reason_not_enough_detail:{english:"Not enough detail",translated:"Không đủ chi tiết"},com_ui_feedback_reason_other:{english:"Other",translated:"Khác"},com_ui_model_recommended:{english:"Recommended",translated:"Được khuyến nghị"},com_ui_model_legacy:{english:"Legacy — please update",translated:"Di sản — vui lòng cập nhật"},com_ui_model_legacy_invalid:{english:"This model is no longer supported. Please select a current model.",translated:"Mô hình này không còn được hỗ trợ. Vui lòng chọn mô hình hiện tại."},com_nav_setting_memory:{english:"Memory",translated:"Bộ nhớ"},com_nav_memory_description:{english:"Manage the personal facts the assistant remembers across your conversations.",translated:"Quản lý các thông tin cá nhân mà trợ lý ghi nhớ trong các cuộc trò chuyện của bạn."},com_nav_memory_add_placeholder:{english:"Add a new memory…",translated:"Thêm bộ nhớ mới…"},com_nav_memory_add_button:{english:"Add memory",translated:"Thêm bộ nhớ"},com_nav_memory_category:{english:"Category",translated:"Danh mục"},com_nav_memory_category_preference:{english:"Preference",translated:"Sở thích"},com_nav_memory_category_identity:{english:"Identity",translated:"Danh tính"},com_nav_memory_category_context:{english:"Context",translated:"Ngữ cảnh"},com_nav_memory_category_project:{english:"Project",translated:"Dự án"},com_nav_memory_empty_title:{english:"No memories yet",translated:"Chưa có bộ nhớ"},com_nav_memory_empty_description:{english:"Memories you save will appear here and help personalize future conversations.",translated:"Bộ nhớ bạn lưu sẽ xuất hiện ở đây và giúp cá nhân hóa các cuộc trò chuyện sau này."},com_nav_memory_load_error:{english:"Could not load memories. Please try again.",translated:"Không thể tải bộ nhớ. Vui lòng thử lại."},com_nav_memory_retry:{english:"Retry",translated:"Thử lại"},com_nav_memory_add_error:{english:"Could not add memory. Please try again.",translated:"Không thể thêm bộ nhớ. Vui lòng thử lại."},com_nav_memory_update_error:{english:"Could not update memory. Please try again.",translated:"Không thể cập nhật bộ nhớ. Vui lòng thử lại."},com_nav_memory_delete_error:{english:"Could not delete memory. Please try again.",translated:"Không thể xóa bộ nhớ. Vui lòng thử lại."},com_nav_memory_delete_confirm:{english:"Delete this memory?",translated:"Xóa bộ nhớ này?"},com_nav_memory_delete_button:{english:"Delete",translated:"Xóa"},com_nav_memory_edit_aria:{english:"Edit memory",translated:"Chỉnh sửa bộ nhớ"},com_nav_memory_delete_aria:{english:"Delete memory",translated:"Xóa bộ nhớ"},com_nav_memory_save:{english:"Save",translated:"Lưu"},com_nav_memory_cancel:{english:"Cancel",translated:"Hủy"},com_nav_memory_saved_at:{english:"Saved {0}",translated:"Đã lưu {0}"},"modelConfig.gpt55.description":{english:"GPT-5.5 — latest GPT-5 thinking model with frontier intelligence.",translated:"GPT-5.5 — mô hình tư duy GPT-5 mới nhất với trí tuệ tiên tiến."},"modelConfig.gpt54Mini.description":{english:"GPT-5.4 Mini — compact and cost-efficient GPT-5.4 variant.",translated:"GPT-5.4 Mini — biến thể GPT-5.4 nhỏ gọn và tiết kiệm chi phí."},"modelConfig.gpt54.description":{english:"GPT-5.4 — latest GPT-5 generation model.",translated:"GPT-5.4 — mô hình thế hệ GPT-5 mới nhất."},"modelConfig.claudeOpus46.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus mới nhất — trí tuệ tiên phong cho các tác nhân mã hóa và quy trình doanh nghiệp."},"modelConfig.claudeOpus47.description":{english:"Latest Opus — frontier intelligence for coding agents and enterprise workflows.",translated:"Opus mới nhất — trí tuệ tiên phong cho các tác nhân mã hóa và quy trình doanh nghiệp."},"modelConfig.claudeSonnet46.description":{english:"Enhanced Sonnet with improved reasoning and instruction following.",translated:"Sonnet nâng cao với khả năng suy luận và theo dõi hướng dẫn cải thiện."},"modelConfig.claudeOpus45.description":{english:"Anthropic's most powerful model for complex, multi-step tasks.",translated:"Mô hình mạnh mẽ nhất của Anthropic cho các nhiệm vụ phức tạp, nhiều bước."},"modelConfig.claudeSonnet45.description":{english:"Balanced intelligence and speed for a wide range of tasks.",translated:"Trí tuệ và tốc độ cân bằng cho nhiều loại nhiệm vụ."},"modelConfig.claudeHaiku45.description":{english:"Fastest and most compact Claude model — ideal for high-throughput tasks.",translated:"Mô hình Claude nhanh nhất và nhỏ gọn nhất — lý tưởng cho các nhiệm vụ thông lượng cao."},"modelConfig.gpt53Chat.description":{english:"GPT-5.3 — enhanced reasoning and multimodal capabilities.",translated:"GPT-5.3 — khả năng suy luận và đa phương tiện nâng cao."},"modelConfig.gpt5.description":{english:"OpenAI's flagship next-generation model.",translated:"Mô hình thế hệ tiếp theo hàng đầu của OpenAI."},"modelConfig.gpt5Mini.description":{english:"Lightweight GPT-5 — efficient and fast for everyday tasks.",translated:"GPT-5 nhẹ — hiệu quả và nhanh chóng cho các nhiệm vụ hàng ngày."},"modelConfig.gpt41.description":{english:"OpenAI GPT-4.1 — improved instruction following and reasoning.",translated:"OpenAI GPT-4.1 — cải thiện theo dõi hướng dẫn và suy luận."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"GPT-4.1 nhỏ gọn — nhanh hơn và rẻ hơn cho các nhiệm vụ đơn giản."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Mô hình GPT-4 mạnh nhất, tối ưu hóa cho tốc độ và chi phí."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"GPT-4o nhẹ — nhanh hơn và rẻ hơn cho các nhiệm vụ đơn giản."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Xem trước) — mô hình Gemini mạnh nhất với ngữ cảnh 1M."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Xem trước) — nhanh và hiệu quả với ngữ cảnh 1M."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — mô hình nhẹ, độ trễ thấp với ngữ cảnh 1M."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Mô hình trợ lý tối ưu hóa giọng nói nội bộ."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"Auto chọn mô hình tốt nhất cho yêu cầu của bạn dựa trên công suất và hiệu suất."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Sắp ra mắt"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Tùy chọn định tuyến tự động"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Điều chỉnh cách bộ định tuyến Tự động cân bằng các yếu tố khi chọn mô hình cho mỗi lượt. Các trọng số được chuẩn hóa — điều quan trọng là mức cân bằng tương đối."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Chi phí"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Ưu tiên mô hình rẻ hơn với chi phí token thấp hơn."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Độ chính xác"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Ưu tiên mô hình mạnh hơn cho suy luận phức tạp."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Tốc độ"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Ưu tiên mô hình nhanh hơn, độ trễ thấp hơn."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Đặt lại mặc định"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Tải tệp lên đã hết thời gian chờ. Vui lòng thử lại sau vài phút."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Đã xảy ra sự cố. Đây là thông báo lỗi cụ thể mà chúng tôi gặp phải: Đã xảy ra lỗi khi xử lý yêu cầu của bạn. Trợ lý không còn khả dụng. Vui lòng liên hệ Quản trị viên."},com_ui_code:{english:"Code",translated:"Mã"},com_ui_assistant_share:{english:"Share",translated:"Chia sẻ"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Đã sao chép liên kết"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Bạn không có quyền truy cập trợ lý này"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Không thể sao chép liên kết vào bảng tạm"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Không có bản xem trước — tạo nội dung chưa hoàn tất."},com_ui_view_code:{english:"View code",translated:"Xem mã"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Không thể xem trước — nội dung không hợp lệ."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Số điện thoại"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Địa chỉ email"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Thẻ tín dụng"},com_assistants_pii_entity_ssn:{english:"SSN",translated:"SSN"},com_ui_assistant_file_upload_timeout_retrying:{english:"Upload is taking longer than expected - retrying ({0}/{1})...",translated:"Tải lên đang mất nhiều thời gian hơn dự kiến - đang thử lại ({0}/{1})..."},com_ui_assistant_file_upload_connection_retrying:{english:"Connection issue - retrying ({0}/{1})...",translated:"Sự cố kết nối - đang thử lại ({0}/{1})..."},com_ui_assistant_file_upload_connection_failed:{english:"Upload failed - please check your connection and try again",translated:"Tải lên thất bại - vui lòng kiểm tra kết nối của bạn và thử lại"},com_assistants_memory_enabled:{english:"Memory",translated:"Bộ nhớ"},com_assistants_memory_enabled_info:{english:"Memory is enabled for this assistant. The assistant can store and recall facts across conversations.",translated:"Bộ nhớ đã được bật cho trợ lý này. Trợ lý có thể lưu trữ và ghi nhớ thông tin qua các cuộc trò chuyện."},com_assistants_memory_disabled_info:{english:"Memory is disabled for this assistant. No facts will be stored or recalled across conversations.",translated:"Bộ nhớ đã được tắt cho trợ lý này. Sẽ không có thông tin nào được lưu trữ hoặc ghi nhớ qua các cuộc trò chuyện."},com_assistants_memory_enabled_off_reason_placeholder:{english:"Please explain your business justification for disabling memory (required).",translated:"Vui lòng giải thích lý do nghiệp vụ của bạn khi tắt bộ nhớ (bắt buộc)."},com_assistants_memory_enabled_reason_required:{english:"Please provide a justification for disabling memory.",translated:"Vui lòng cung cấp lý do khi tắt bộ nhớ."},com_nav_memory_team_disabled:{english:"Memory is disabled for your team. You can view and delete existing memories, but cannot add or edit new ones.",translated:"Bộ nhớ đã bị tắt cho nhóm của bạn. Bạn có thể xem và xóa các bộ nhớ hiện có, nhưng không thể thêm hoặc chỉnh sửa bộ nhớ mới."},com_ui_assistant_tools_codeexecutor:{english:"Running your code",translated:"Đang chạy mã của bạn"},com_ui_assistant_tools_rag_query:{english:"Searching the knowledge base",translated:"Đang tìm kiếm trong cơ sở kiến thức"},com_ui_assistant_tools_voiceworx:{english:"Processing voice",translated:"Đang xử lý giọng nói"},com_ui_assistant_tools_memory_store:{english:"Saving to memory",translated:"Đang lưu vào bộ nhớ"},com_ui_assistant_tools_memory_delete:{english:"Removing from memory",translated:"Đang xóa khỏi bộ nhớ"},com_ui_assistant_tools_completed_search_online:{english:"Finished searching the web",translated:"Đã tìm kiếm web xong"},com_ui_assistant_tools_completed_browse_website:{english:"Finished reviewing the webpage",translated:"Đã xem xét trang web xong"},com_ui_assistant_tools_completed_generate_image:{english:"Image generated",translated:"Đã tạo hình ảnh"},com_ui_assistant_tools_completed_calculate_math:{english:"Finished calculating",translated:"Đã tính toán xong"},com_ui_assistant_tools_completed_codeexecutor:{english:"Finished running your code",translated:"Đã chạy mã của bạn xong"},com_ui_assistant_tools_completed_rag_query:{english:"Finished searching the knowledge base",translated:"Đã tìm kiếm trong cơ sở kiến thức xong"},com_ui_assistant_tools_completed_voiceworx:{english:"Finished processing voice input",translated:"Đã xử lý đầu vào giọng nói xong"},com_ui_assistant_tools_completed_memory_store:{english:"Saved to memory",translated:"Đã lưu vào bộ nhớ"},com_ui_assistant_tools_completed_memory_delete:{english:"Removed from memory",translated:"Đã xóa khỏi bộ nhớ"},com_ui_assistant_tools_completed_fallback:{english:"Finished: {0}",translated:"Đã hoàn tất: {0}"},com_ui_still_working:{english:"still working...",translated:"vẫn đang xử lý..."},com_ui_file_ready:{english:"{0} is ready",translated:"{0} đã sẵn sàng"},com_ui_file_ready_fallback:{english:"File is ready",translated:"Tệp đã sẵn sàng"},com_ui_file_processing_failed:{english:"{0} could not be processed",translated:"Không thể xử lý {0}"},com_ui_file_processing_failed_fallback:{english:"File could not be processed",translated:"Không thể xử lý tệp"},com_ui_file_processing_failed_reupload:{english:"{0} could not be processed. Please re-upload the file.",translated:"Không thể xử lý {0}. Vui lòng tải lại tệp."},com_ui_file_processing_failed_reupload_fallback:{english:"File could not be processed. Please re-upload the file.",translated:"Không thể xử lý tệp. Vui lòng tải lại tệp."},com_ui_file_processing:{english:"Processing...",translated:"Đang xử lý..."},com_ui_file_processing_failed_status:{english:"Processing failed",translated:"Xử lý thất bại"},com_ui_file_processing_failed_reupload_required:{english:"Failed - re-upload required",translated:"Thất bại - cần tải lên lại"},com_ui_file_retry:{english:"Retry",translated:"Thử lại"},com_ui_file_retry_in:{english:"Retry in {0}s",translated:"Thử lại sau {0} giây"},com_ui_file_indexing_retrying:{english:"Retrying file indexing...",translated:"Đang thử lại lập chỉ mục tệp..."},com_ui_file_retry_wait:{english:"Please wait {0}s before retrying",translated:"Vui lòng đợi {0} giây trước khi thử lại"},com_ui_file_retries_exhausted_reupload:{english:"Maximum retries reached. Please re-upload the file.",translated:"Đã đạt số lần thử lại tối đa. Vui lòng tải lên lại tệp."},com_ui_assistant_file_upload_invalid_json:{english:"Invalid JSON file. File content does not match the expected format.",translated:"Tệp JSON không hợp l