uthuthukisiwe."},"modelConfig.gpt41Mini.description":{english:"Compact GPT-4.1 — faster and cheaper for simpler tasks.",translated:"I-GPT-4.1 encane — esheshayo futhi eshibhile yemisebenzi elula."},"modelConfig.gpt4o.description":{english:"Most capable GPT-4 model, optimised for speed and cost.",translated:"Imodeli ye-GPT-4 ekwazi kakhulu, eyenziwe kahle ngesivinini nezindleko."},"modelConfig.gpt4oMini.description":{english:"Lightweight GPT-4o — faster and cheaper for simpler tasks.",translated:"I-GPT-4o elula — esheshayo futhi eshibhile yemisebenzi elula."},"modelConfig.gemini31Pro.description":{english:"Google Gemini 3.1 Pro (Preview) — most capable Gemini model with 1M context.",translated:"Google Gemini 3.1 Pro (Ukubona Kwangaphambilini) — imodeli ye-Gemini enamandla kakhulu nge-1M context."},"modelConfig.gemini3Flash.description":{english:"Google Gemini 3 Flash (Preview) — fast and efficient with 1M context.",translated:"Google Gemini 3 Flash (Ukubona Kwangaphambilini) — isheshayo futhi isebenza kahle nge-1M context."},"modelConfig.gemini31FlashLite.description":{english:"Google Gemini 3.1 Flash-Lite — lightweight, low-latency model with 1M context.",translated:"Google Gemini 3.1 Flash-Lite — imodeli elula enokuconsa okuncane nge-1M context."},"modelConfig.voiceworx.description":{english:"Internal voice-optimised assistant model.",translated:"Imodeli yomxhumanisi yangaphakathi eyenziwe kahle ngezwi."},"modelConfig.auto.description":{english:"Auto selects the best model for your request based on capacity and performance.",translated:"I-Auto ikhetha imodeli engcono kakhulu yesicelo sakho ngokusekelwe kwizinga namandla."},com_ui_model_coming_soon:{english:"Coming Soon",translated:"Kuyeza maduze"},com_assistants_owners:{english:"Owners",translated:"Owners"},com_assistants_owner_added:{english:"Owner added successfully",translated:"Owner added successfully"},com_assistants_owner_removed:{english:"Owner removed successfully",translated:"Owner removed successfully"},com_assistants_owner_last_owner_error:{english:"Cannot remove the last owner of an assistant",translated:"Cannot remove the last owner of an assistant"},com_assistants_owner_email_placeholder:{english:"Add owner by email",translated:"Add owner by email"},com_ui_add:{english:"Add",translated:"Add"},com_ui_you:{english:"you",translated:"you"},com_assistants_owner_discard_warning:{english:"You have unsaved owner changes. Are you sure you want to discard them?",translated:"Unsaved changes will be discarded. Are you sure?"},com_ui_discard:{english:"Discard",translated:"Discard"},com_ui_keep_editing:{english:"Keep editing",translated:"Keep editing"},com_assistants_auto_weight_title:{english:"Auto routing preferences",translated:"Okuncanyelwayo komzila ozenzakalelayo"},com_assistants_auto_weight_description:{english:"Tune how the Auto router balances cost, accuracy, and speed when picking a model for each turn. A higher slider value means a stronger preference for that factor — for example, raising Cost selects cheaper models more often. Sliders are relative; values do not need to sum to 100.",translated:"Lungisa indlela umzila ozenzakalelayo olinganisa ngayo ukuhwebelana lapho ukhetha imodeli emjikelezweni ngamunye. Izisindo ziyalinganiswa — okubalulekile ibhalansi ehlobene."},com_assistants_auto_weight_cost:{english:"Cost / token usage",translated:"Izindleko"},com_assistants_auto_weight_cost_helper:{english:"Favor cheaper models with lower token cost. Move higher to prioritize cost over capability and latency.",translated:"Ncika kumamodeli ashibhile anezindleko eziphansi zamathokheni."},com_assistants_auto_weight_accuracy:{english:"Accuracy",translated:"Ukunemba"},com_assistants_auto_weight_accuracy_helper:{english:"Favor stronger models for complex reasoning.",translated:"Ncika kumamodeli anamandla okucabanga okuyinkimbinkimbi."},com_assistants_auto_weight_speed:{english:"Speed",translated:"Isivinini"},com_assistants_auto_weight_speed_helper:{english:"Favor faster, lower-latency models.",translated:"Ncika kumamodeli asheshayo anokubambezeleka okuphansi."},com_assistants_auto_weight_reset:{english:"Reset to defaults",translated:"Setha kabusha kokumisiwe"},com_ui_assistant_file_upload_timeout_error:{english:"File upload timed out. Please try again in a few minutes.",translated:"Ukulayishwa kwefayela kuphelelwe isikhathi. Sicela uzame futhi emizuzwini embalwa."},com_error_assistant_not_available:{english:"Something went wrong. Here's the specific error message we encountered: An error occurred while processing your request. The assistant is no longer available. Please contact the Admin.",translated:"Kukhona okungahambanga kahle. Nawu umlayezo wephutha othile esihlangabezane nawo: Kube nephutha ngenkathi kucutshungulwa isicelo sakho. Umsizi akasatholakali. Sicela uxhumane noMlawuli."},com_ui_code:{english:"Code",translated:"Ikhodi"},com_ui_assistant_share:{english:"Share",translated:"Yabelana"},com_ui_assistant_share_link_copied:{english:"Link copied",translated:"Isixhumanisi sikopishiwe"},com_ui_assistant_no_access:{english:"You don't have access to this assistant",translated:"Awunakho ukufinyelela kulo msizi"},com_ui_copy_to_clipboard_error:{english:"Failed to copy link to clipboard",translated:"Kwehlulekile ukukopisha isixhumanisi ebhodini lokunamathisela"},com_ui_preview_incomplete:{english:"Preview not available — content generation was not completed.",translated:"Ukubuka kuqala akutholakali — ukudalwa kokuqukethwe akuphelanga."},com_ui_view_code:{english:"View code",translated:"Buka ikhodi"},com_ui_preview_invalid:{english:"Preview not available — content is invalid.",translated:"Ukubuka kuqala akutholakali — okuqukethwe akuvumelekile."},com_assistants_pii_entity_phone:{english:"Phone Number",translated:"Inombolo Yocingo"},com_assistants_pii_entity_email:{english:"Email Address",translated:"Ikheli Le-imeyili"},com_assistants_pii_entity_credit_card:{english:"Credit Card",translated:"Ikhadi Lesikweletu"},com_assistants_pii_entity_s